adata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":2277,"bankPath":"banks/hard-cases-canonical.json","bankSha256":"438c176897a41d3b7f212435e5945bd524c3f0ba5a62931eb5e85843c93d8730","topLevelQuestionId":"cs_asthma_01","embeddedQuestionId":"cs_asthma_01_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.4.caseStudy.questions.3","itemType":"matrix","category":"Pharmacological and Parenteral Therapies","topic":"Medication Safety & Admin","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.4.caseStudy.questions.3.stem.en","stemPathZh":"questions.4.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,59],"terminalOffsetsZh":[0,15],"fullStemEn":"Specify the correct medication for each clinical situation.","fullStemZh":"为每种临床情况指定正确的药物。","terminalSentenceEn":"Specify the correct medication for each clinical situation.","terminalSentenceZh":"为每种临床情况指定正确的药物。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"15 minutes before soccer practice","zh":"足球训练前 15 分钟"},{"id":"r2","en":"Daily morning and evening dose","zh":"每日早晚剂量"},{"id":"r3","en":"During an acute episode of wheezing","zh":"急性哮鸣发作期间"}],"columns":[{"id":"c2","en":"Fluticasone (Controller)","zh":"氟替卡松（控制）"},{"id":"c1","en":"Albuterol (Rescue)","zh":"沙丁胺醇（急救）"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]}]},"rationaleCorrectEn":"Albuterol is a short-acting beta-agonist (SABA) and is the fast-acting reliever for both acute symptoms and pre-exercise prophylaxis. Fluticasone is an inhaled corticosteroid (ICS) used for daily long-term control; because of its slow onset it has no role as a rescue inhaler. (Note: modern GINA SMART regimens use ICS-formoterol as both controller and reliever, but formoterol is a different drug from plain fluticasone and is not interchangeable with it here.)","rationaleCorrectZh":"沙丁胺醇是一种短效β受体激动剂（SABA），是用于缓解急性症状和运动前预防的速效缓解药物。氟替卡松是一种吸入型糖皮质激素（ICS），用于每日长期控制；由于起效缓慢，它不能作为急救吸入剂使用。（注意：当前的 GINA SMART 方案使用 ICS-福莫特罗同时作为控制和缓解药物，但福莫特罗与单纯的氟替卡松是不同的药物，在此不可互换。）","testTakingStrategyEn":"Distinguish between 'rescue' (fast-acting bronchodilator, e.g., albuterol) and 'controller' (daily steroid, e.g., fluticasone) medications. A plain ICS like fluticasone is never the reliever for acute symptoms.","testTakingStrategyZh":"区分“急救”（速效支气管扩张剂，如沙丁胺醇）和“控制”（每日类固醇，如氟替卡松）药物。像氟替卡松这样的单纯 ICS 绝不能作为急性症状的缓解药物。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":2278,"bankPath":"banks/hard-cases-canonical.json","bankSha256":"438c176897a41d3b7f212435e5945bd524c3f0ba5a62931eb5e85843c93d8730","topLevelQuestionId":"cs_asthma_01","embeddedQuestionId":"cs_asthma_01_q5","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.4.caseStudy.questions.4","itemType":"multiple_choice","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"hard","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.4.caseStudy.questions.4.stem.en","stemPathZh":"questions.4.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[46,92],"terminalOffsetsZh":[13,24],"fullStemEn":"The nurse observes the child using their MDI. Which action indicates teaching was effective?","fullStemZh":"护士观察孩子使用 MDI。哪项动作表明教学有效？","terminalSentenceEn":"Which action indicates teaching was effective?","terminalSentenceZh":"哪项动作表明教学有效？","penultimateSentenceEn":"The nurse observes the child using their MDI.","penultimateSentenceZh":"护士观察孩子使用 MDI。","responseContext":{"type":"multiple_choice","options":[{"id":"C","en":"Rinses their mouth with water before using the inhaler.","zh":"使用吸入器前用水漱口。"},{"id":"B","en":"Holds their breath for 10 seconds after inhalation.","zh":"吸入后屏气 10 秒。"},{"id":"A","en":"Takes a quick, shallow breath during inhalation.","zh":"吸入时进行快速、表浅的呼吸。"},{"id":"D","en":"Exhales immediately after pressing the canister.","zh":"按下药罐后立即呼气。"}],"correct":["B"]},"rationaleCorrectEn":"Holding the breath for 10 seconds allows the medication to settle in the lower airways. Rinsing should occur *after* using inhaled steroids (like fluticasone) to prevent oral candidiasis.","rationaleCorrectZh":"屏气 10 秒可让药物沉积在下呼吸道。使用吸入型类固醇（如氟替卡松）*后*应漱口，以预防口腔念珠菌病。","testTakingStrategyEn":"Recall the steps of MDI use: shake, exhale, inhale while pressing, hold breath.","testTakingStrategyZh":"回忆 MDI 使用步骤：摇匀、呼气、按压时吸气、屏气。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":2279,"bankPath":"banks/hard-cases-canonical.json","bankSha256":"438c176897a41d3b7f212435e5945bd524c3f0ba5a62931eb5e85843c93d8730","topLevelQuestionId":"cs_schiz_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.5","itemType":"case_study","category":"Psychosocial Integrity","topic":"Mental Health Disorders","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.5.stem.en","stemPathZh":"questions.5.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,137],"terminalOffsetsZh":[0,43],"fullStemEn":"Acute Psychosis in Schizophrenia A 22-year-old male is admitted to the psychiatric unit with a diagnosis of Schizophrenia, Paranoid type.","fullStemZh":"精神分裂症急性精神病发作 一名22岁男性因诊断为精神分裂症（偏执型）收治于精神科病房。","terminalSentenceEn":"Acute Psychosis in Schizophrenia A 22-year-old male is admitted to the psychiatric unit with a diagnosis of Schizophrenia, Paranoid type.","terminalSentenceZh":"精神分裂症急性精神病发作 一名22岁男性因诊断为精神分裂症（偏执型）收治于精神科病房。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"Psychiatric nursing for schizophrenia focuses on safety, therapeutic communication, and monitoring for dangerous side effects of antipsychotic medications.","rationaleCorrectZh":"针对精神分裂症的精神科护理重点在于安全、治疗性沟通以及监测抗精神病药物的危险副作用。","testTakingStrategyEn":"Address the emotional component of delusions while maintaining reality.","testTakingStrategyZh":"在维持现实的同时处理妄想中的情感成分。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":2280,"bankPath":"banks/hard-cases-canonical.json","bankSha256":"438c176897a41d3b7f212435e5945bd524c3f0ba5a62931eb5e85843c93d8730","topLevelQuestionId":"cs_schiz_01","embeddedQuestionId":"cs_schiz_01_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.5.caseStudy.questions.0","itemType":"select_all","category":"Psychosocial Integrity","topic":"Mental Health Disorders","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.5.caseStudy.questions.0.stem.en","stemPathZh":"questions.5.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[81,103],"terminalOffsetsZh":[24,29],"fullStemEn":"Which findings in the assessment represent 'positive symptoms' of schizophrenia? Select all that apply.","fullStemZh":"评估中的哪些发现代表精神分裂症的“阳性症状”？（多项选择）","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"多项选择）","penultimateSentenceEn":"Which findings in the assessment represent 'positive symptoms' of schizophrenia?","penultimateSentenceZh":"评估中的哪些发现代表精神分裂症的“阳性症状”？（","responseContext":{"type":"select_all","options":[{"id":"B","en":"Auditory hallucinations","zh":"听幻觉"},{"id":"D","en":"Social withdrawal","zh":"社交退缩"},{"id":"A","en":"Delusions of persecution","zh":"被害妄想"},{"id":"F","en":"Anhedonia","zh":"快感缺失"},{"id":"C","en":"Flat affect","zh":"情感淡漠"},{"id":"E","en":"Pacing and agitated behavior","zh":"踱步和焦虑行为"}],"correct":["A","B","E"]},"rationaleCorrectEn":"Positive symptoms are 'add-ons' to normal behavior (delusions, hallucinations, agitation). Negative symptoms are 'deficits' (flat affect, social withdrawal, anhedonia).","rationaleCorrectZh":"阳性症状是正常行为之外“增加”的（妄想、幻觉、烦躁）。阴性症状是行为的“缺失”（情感淡漠、社交退缩、快感缺失）。","testTakingStrategyEn":"Differentiate between symptoms that add to behavior vs. those that take away.","testTakingStrategyZh":"区分增加行为的症状和减少行为的症状。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":2281,"bankPath":"banks/hard-cases-canonical.json","bankSha256":"438c176897a41d3b7f212435e5945bd524c3f0ba5a62931eb5e85843c93d8730","topLevelQuestionId":"cs_schiz_01","embeddedQuestionId":"cs_schiz_01_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.5.caseStudy.questions.1","itemType":"multiple_choice","category":"Psychosocial Integrity","topic":"Mental Health Disorders","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.5.caseStudy.questions.1.stem.en","stemPathZh":"questions.5.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,56],"terminalOffsetsZh":[0,17],"fullStemEn":"What is the nurse's priority assessment for this client?","fullStemZh":"护士对该患者优先进行的评估是什么？","terminalSentenceEn":"What is the nurse's priority assessment for this client?","terminalSentenceZh":"护士对该患者优先进行的评估是什么？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Presence of command hallucinations","zh":"是否存在命令性幻觉"},{"id":"D","en":"Compliance with outpatient medications","zh":"门诊用药的依从性"},{"id":"C","en":"Nutritional intake and hydration status","zh":"营养摄入和饮水状态"},{"id":"B","en":"Sleep patterns and circadian rhythm","zh":"睡眠模式和昼夜节律"}],"correct":["A"]},"rationaleCorrectEn":"Command hallucinations (voices telling the client to do something) are a major safety risk for self-harm or violence. While nutrition is important, safety is the immediate priority.","rationaleCorrectZh":"命令性幻觉（声音告诉患者去做某事）是自残或暴力的重大安全风险。虽然营养很重要，但安全是紧迫的优先事项。","testTakingStrategyEn":"Always prioritize safety and 'command' symptoms in psychiatric emergencies.","testTakingStrategyZh":"在精神科急症中，始终优先考虑安全和“命令”症状。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":2282,"bankPath":"banks/hard-cases-canonical.json","bankSha256":"438c176897a41d3b7f212435e5945bd524c3f0ba5a62931eb5e85843c93d8730","topLevelQuestionId":"cs_schiz_01","embeddedQuestionId":"cs_schiz_01_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.5.caseStudy.questions.2","itemType":"dropdown_cloze","category":"Psychosocial Integrity","topic":"Mental Health Disorders","difficulty":"hard","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.5.caseStudy.questions.2.stem.en","stemPathZh":"questions.5.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,52],"terminalOffsetsZh":[0,12],"fullStemEn":"Identify the primary risk for the client's behavior.","fullStemZh":"识别患者行为的主要风险。","terminalSentenceEn":"Identify the primary risk for the client's behavior.","terminalSentenceZh":"识别患者行为的主要风险。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The client's refusal to eat is most likely due to {{1}}, which poses a risk for {{2}}.","zh":"患者拒绝进食最可能是由于 {{1}}，这带来了 {{2}} 的风险。"},"dropdowns":[{"id":"1","options":[{"id":"o3","en":"loss of appetite","zh":"食欲不振"},{"id":"o2","en":"gastric distress","zh":"胃部不适"},{"id":"o1","en":"paranoid delusions","zh":"偏执妄想"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"imbalanced nutrition","zh":"营养失衡"},{"id":"o3","en":"allergic reaction","zh":"过敏反应"},{"id":"o2","en":"abdominal pain","zh":"腹痛"}],"correct":"o1"}]},"rationaleCorrectEn":"Believing food is poisoned is a paranoid delusion, leading to refusal to eat and subsequent nutritional deficits.","rationaleCorrectZh":"认为食物有毒是偏执妄想，导致拒绝进食及随后的营养缺失。","testTakingStrategyEn":"Connect psychiatric symptoms to physiological outcomes.","testTakingStrategyZh":"将精神症状与生理结果联系起来。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":2283,"bankPath":"banks/hard-cases-canonical.json","bankSha256":"438c176897a41d3b7f212435e5945bd524c3f0ba5a62931eb5e85843c93d8730","topLevelQuestionId":"cs_schiz_01","embeddedQuestionId":"cs_schiz_01_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.5.caseStudy.questions.3","itemType":"multiple_choice","category":"Psychosocial Integrity","topic":"Therapeutic Communication","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.5.caseStudy.questions.3.stem.en","stemPathZh":"questions.5.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[77,115],"terminalOffsetsZh":[27,41],"fullStemEn":"The client states, 'Do you see them? The spies are in the vent watching us!' What is the most therapeutic response?","fullStemZh":"患者说：“你看到他们了吗？间谍就在通风口里盯着我们！”最具有治疗意义的回应是什么？","terminalSentenceEn":"What is the most therapeutic response?","terminalSentenceZh":"最具有治疗意义的回应是什么？","penultimateSentenceEn":"The spies are in the vent watching us!'","penultimateSentenceZh":"间谍就在通风口里盯着我们！”","responseContext":{"type":"multiple_choice","options":[{"id":"B","en":"There are no spies in the vent; you are imagining things.","zh":"通风口里没有间谍，那是你的幻觉。"},{"id":"C","en":"I don't see any spies, but I understand that it is frightening for you to feel watched.","zh":"我没有看到任何间谍，但我理解被监视的感觉让你很害怕。"},{"id":"D","en":"Why do you think the government wants to watch you specifically?","zh":"你为什么认为政府特别想监视你？"},{"id":"A","en":"Let's go look in the vent together so I can prove you are safe.","zh":"我们一起去看看通风口吧，这样我可以证明你是安全的。"}],"correct":["C"]},"rationaleCorrectEn":"This response acknowledges the client's feelings (validation) without agreeing with the delusion (presenting reality). Arguing or participating in the delusion is non-therapeutic.","rationaleCorrectZh":"这种回应在不认同妄想（呈现现实）的情况下承认了患者的感受（共情）。争论或参与妄想都是非治疗性的。","testTakingStrategyEn":"Look for responses that address feelings and present reality without argument.","testTakingStrategyZh":"寻找那些在不争论的情况下处理感受并呈现现实的回应。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"The spies are in the vent watching us!'","controlSentenceZh":"间谍就在通风口里盯着我们！”"}
