FollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":979,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_mobility_07","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.764","itemType":"case_study","category":"Basic Care and Comfort","topic":"Mobility & Immobility","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.764.stem.en","stemPathZh":"questions.764.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,117],"terminalOffsetsZh":[0,33],"fullStemEn":"Medical-Surgical Unit An 82-year-old male is recovering from a severe respiratory infection and generalized weakness.","fullStemZh":"内外科病房 一名82岁男性正在从严重的呼吸道感染和全身无力中康复。","terminalSentenceEn":"Medical-Surgical Unit An 82-year-old male is recovering from a severe respiratory infection and generalized weakness.","terminalSentenceZh":"内外科病房 一名82岁男性正在从严重的呼吸道感染和全身无力中康复。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"Safe mobility requires assessing fall risks, preventing orthostatic hypotension, and teaching correct usage of assistive devices.","rationaleCorrectZh":"安全的活动需要评估跌倒风险、预防体位性低血压，并指导正确使用辅助设备。","testTakingStrategyEn":"Focus on the mechanics of safety and fall prevention.","testTakingStrategyZh":"关注安全和预防跌倒的机制。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":980,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_mobility_07","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_mobility_07_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.764.caseStudy.questions.0","itemType":"select_all","category":"Basic Care and Comfort","topic":"Mobility & Immobility","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.764.caseStudy.questions.0.stem.en","stemPathZh":"questions.764.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[58,80],"terminalOffsetsZh":[18,27],"fullStemEn":"Which factors place this client at a high risk for falls? Select all that apply.","fullStemZh":"哪些因素使该患者处于跌倒的高风险中？请选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"请选择所有适用项。","penultimateSentenceEn":"Which factors place this client at a high risk for falls?","penultimateSentenceZh":"哪些因素使该患者处于跌倒的高风险中？","responseContext":{"type":"select_all","options":[{"id":"o2","en":"Prolonged bed rest","zh":"长期卧床"},{"id":"o3","en":"Alert and cooperative cognitive status","zh":"意识清醒且配合的认知状态"},{"id":"o5","en":"First time out of bed after illness","zh":"生病后首次下床"},{"id":"o1","en":"Advanced age (82 years)","zh":"高龄（82岁）"},{"id":"o4","en":"Self-reported leg weakness","zh":"自述腿部无力"}],"correct":["o1","o2","o4","o5"]},"rationaleCorrectEn":"Age, deconditioning from bed rest, muscle weakness, and orthostatic hypotension risk (first time up) are major fall hazards.","rationaleCorrectZh":"年龄、卧床休息导致的体能下降、肌肉无力以及体位性低血压风险（首次起床）是主要的跌倒隐患。","testTakingStrategyEn":"Identify physiologic changes associated with immobility.","testTakingStrategyZh":"识别与缺乏活动相关的生理变化。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":true,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":981,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_mobility_07","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_mobility_07_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.764.caseStudy.questions.1","itemType":"ordered_response","category":"Basic Care and Comfort","topic":"Mobility & Immobility","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.764.caseStudy.questions.1.stem.en","stemPathZh":"questions.764.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[73,105],"terminalOffsetsZh":[18,26],"fullStemEn":"The nurse is preparing to transfer the client from the bed to the chair. Order the steps of the transfer.","fullStemZh":"护士正准备将患者从床上转移到椅子上。请排列转移步骤。","terminalSentenceEn":"Order the steps of the transfer.","terminalSentenceZh":"请排列转移步骤。","penultimateSentenceEn":"The nurse is preparing to transfer the client from the bed to the chair.","penultimateSentenceZh":"护士正准备将患者从床上转移到椅子上。","responseContext":{"type":"ordered_response","options":[{"id":"o1","en":"Apply a gait belt around the client's waist.","zh":"将步态带（约束带）系在患者腰部。"},{"id":"o4","en":"Position the chair parallel to the bed and lock the wheels.","zh":"将椅子平行放置在床边并锁定轮子。"},{"id":"o2","en":"Assist the client to dangle legs on the side of the bed for 1-2 minutes.","zh":"协助患者在床边双腿下垂坐立1-2分钟。"},{"id":"o5","en":"Instruct the client to pivot and grasp the chair armrests.","zh":"指导患者转体并抓住椅子扶手。"},{"id":"o3","en":"Ensure non-slip footwear is on the client.","zh":"确保患者穿上防滑鞋。"}],"correct":["o4","o3","o2","o1","o5"]},"rationaleCorrectEn":"Safety requires preparing the environment first (lock chair), preparing the client (footwear, dangling to prevent orthostatic hypotension), applying safety equipment (gait belt), and executing the transfer safely.","rationaleCorrectZh":"为了安全起见，需要先准备环境（锁定椅子），准备患者（穿鞋、床边坐立以防体位性低血压），使用安全设备（步态带），然后安全地执行转移。","testTakingStrategyEn":"Visualize the procedure safely: Environment -> Client prep -> Safety gear -> Movement.","testTakingStrategyZh":"在脑海中安全地模拟操作过程：环境 -> 患者准备 -> 安全装备 -> 移动。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"The nurse is preparing to transfer the client from the bed to the chair.","controlSentenceZh":"护士正准备将患者从床上转移到椅子上。"}
{"queueIndex":982,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_mobility_07","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_mobility_07_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.764.caseStudy.questions.2","itemType":"matrix","category":"Basic Care and Comfort","topic":"Mobility & Immobility","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.764.caseStudy.questions.2.stem.en","stemPathZh":"questions.764.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[65,131],"terminalOffsetsZh":[17,32],"fullStemEn":"The nurse is teaching the client how to use the standard walker. Click to specify whether each instruction is correct or incorrect.","fullStemZh":"护士正在教患者如何使用标准助行器。点击指出以下各项指导是否正确。","terminalSentenceEn":"Click to specify whether each instruction is correct or incorrect.","terminalSentenceZh":"点击指出以下各项指导是否正确。","penultimateSentenceEn":"The nurse is teaching the client how to use the standard walker.","penultimateSentenceZh":"护士正在教患者如何使用标准助行器。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Adjust the walker height so the handgrips are at the level of the wrist crease.","zh":"调整助行器高度，使握把位于手腕横纹水平。"},{"id":"r2","en":"Move the walker forward 6-8 inches, then step forward into it.","zh":"将助行器向前移动6-8英寸，然后向前迈入其中。"},{"id":"r3","en":"Look down at your feet while walking to ensure placement.","zh":"走路时低头看脚以确保位置正确。"},{"id":"r4","en":"When rising from a chair, pull yourself up using the walker handles.","zh":"从椅子上站起时，利用助行器的把手把自己拉起来。"}],"columns":[{"id":"c1","en":"Correct","zh":"正确"},{"id":"c2","en":"Incorrect","zh":"不正确"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c2"]}]},"rationaleCorrectEn":"Walker height should allow a slight elbow bend (wrist crease level). The walker moves first, then the client steps in. Looking down alters balance. Pulling up on a walker can tip it over.","rationaleCorrectZh":"助行器的高度应允许肘部轻微弯曲（手腕横纹水平）。助行器先移动，然后患者迈入。低头会改变平衡。拉住助行器站起可能会导致其翻倒。","testTakingStrategyEn":"Recall safety principles for assistive devices: fit, sequence, and stability.","testTakingStrategyZh":"回想辅助设备的安全原则：尺寸、顺序和稳定性。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":983,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_mobility_07","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_mobility_07_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.764.caseStudy.questions.3","itemType":"dropdown_cloze","category":"Basic Care and Comfort","topic":"Mobility & Immobility","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.764.caseStudy.questions.3.stem.en","stemPathZh":"questions.764.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,71],"terminalOffsetsZh":[0,17],"fullStemEn":"The client successfully ambulates with the walker to the door and back.","fullStemZh":"患者成功使用助行器走到门口并返回。","terminalSentenceEn":"The client successfully ambulates with the walker to the door and back.","terminalSentenceZh":"患者成功使用助行器走到门口并返回。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse evaluates that the client is demonstrating a safe gait if the client advances the walker first, then steps with the {{1}} leg into it, and maintains a {{2}} posture.","zh":"如果患者先向前移动助行器，然后迈出 {{1}} 跟进，并保持 {{2}} 姿势，护士可评估患者步态安全。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"weaker","zh":"较弱的腿"},{"id":"o2","en":"stronger","zh":"较强的腿"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"hunched","zh":"弯腰"},{"id":"o1","en":"upright","zh":"直立"}],"correct":"o1"}]},"rationaleCorrectEn":"The standard walker sequence is: advance the walker 6–8 inches, step the weaker leg into it, then bring the stronger leg forward. This allows the arms to bear weight through the device during the weaker leg's step. An upright posture maintains the center of gravity over the base of support.","rationaleCorrectZh":"标准助行器使用顺序为：先将助行器向前移动15–20厘米，再迈出较弱的腿跟进，最后迈出较强的腿。这样在较弱腿迈步时，手臂可通过助行器承担体重。保持直立姿势有助于维持重心在支撑面上方。","testTakingStrategyEn":"Remember the standard walker sequence: advance walker → step weak leg in → follow with strong leg.","testTakingStrategyZh":"记住标准助行器使用顺序：先移助行器→弱腿迈入→强腿跟进。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":984,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_caregiver_08","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.765","itemType":"case_study","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.765.stem.en","stemPathZh":"questions.765.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[107,153],"terminalOffsetsZh":[38,53],"fullStemEn":"Home Health Visit A home health nurse is visiting a 65-year-old male with early-stage Alzheimer's disease. His 60-year-old wife is the primary caregiver.","fullStemZh":"家庭健康随访 一名家庭保健护士正在探访一名患有早期阿尔茨海默病的65岁男性。他60岁的妻子是主要的照顾者。","terminalSentenceEn":"His 60-year-old wife is the primary caregiver.","terminalSentenceZh":"他60岁的妻子是主要的照顾者。","penultimateSentenceEn":"Home Health Visit A home health nurse is visiting a 65-year-old male with early-stage Alzheimer's disease.","penultimateSentenceZh":"家庭健康随访 一名家庭保健护士正在探访一名患有早期阿尔茨海默病的65岁男性。","responseContext":{},"rationaleCorrectEn":"Caregiver role strain is a serious risk. Nurses must assess the caregiver's health, provide respite options, and facilitate support group involvement.","rationaleCorrectZh":"照顾者角色紧张是一种严重的风险。护士必须评估照顾者的健康状况，提供喘息的选项，并促进其参与支持小组。","testTakingStrategyEn":"Treat the caregiver as a secondary patient needing holistic care.","testTakingStrategyZh":"将照顾者视为需要整体护理的第二类患者。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":985,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_caregiver_08","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_caregiver_08_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.765.caseStudy.questions.0","itemType":"select_all","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.765.caseStudy.questions.0.stem.en","stemPathZh":"questions.765.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[68,90],"terminalOffsetsZh":[20,29],"fullStemEn":"Which cues indicate the wife is experiencing caregiver role strain? Select all that apply.","fullStemZh":"哪些线索表明妻子正在经历照顾者角色紧张？请选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"请选择所有适用项。","penultimateSentenceEn":"Which cues indicate the wife is experiencing caregiver role strain?","penultimateSentenceZh":"哪些线索表明妻子正在经历照顾者角色紧张？","responseContext":{"type":"select_all","options":[{"id":"o2","en":"Sleep deprivation","zh":"睡眠被剥夺"},{"id":"o3","en":"Neglect of personal health needs","zh":"忽视个人健康需求"},{"id":"o5","en":"Living in the same home as the client","zh":"与患者住在同一个家中"},{"id":"o1","en":"Constant fatigue","zh":"持续的疲劳"},{"id":"o4","en":"Emotional lability (crying)","zh":"情绪不稳定（哭泣）"}],"correct":["o1","o2","o3","o4"]},"rationaleCorrectEn":"Caregiver strain manifests as physical (fatigue, sleep loss), emotional (crying), and behavioral (neglecting own meds/appointments) changes.","rationaleCorrectZh":"照顾者紧张表现为身体上（疲劳、睡眠不足）、情感上（哭泣）和行为上（忽视自己的药物/预约）的改变。","testTakingStrategyEn":"Differentiate between symptoms of a problem and the baseline living situation.","testTakingStrategyZh":"区分问题的症状和基线生活状况。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":986,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_caregiver_08","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_caregiver_08_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.765.caseStudy.questions.1","itemType":"matrix","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.765.caseStudy.questions.1.stem.en","stemPathZh":"questions.765.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,106],"terminalOffsetsZh":[0,25],"fullStemEn":"Click to specify if each intervention is an appropriate or inappropriate recommendation for the caregiver.","fullStemZh":"点击指出以下各项干预措施对照顾者是否是合适的建议。","terminalSentenceEn":"Click to specify if each intervention is an appropriate or inappropriate recommendation for the caregiver.","terminalSentenceZh":"点击指出以下各项干预措施对照顾者是否是合适的建议。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Suggesting the wife ask adult children to sit with the husband one afternoon a week.","zh":"建议妻子请成年子女每周抽一个下午来陪伴丈夫。"},{"id":"r2","en":"Advising the wife to focus harder on the husband's needs to prevent his wandering.","zh":"建议妻子更专注于丈夫的需求，以防止他游荡。"},{"id":"r3","en":"Recommending an adult day care program for the husband.","zh":"建议为丈夫报名成人日间照料项目。"},{"id":"r4","en":"Providing information on Alzheimer's caregiver support groups.","zh":"提供关于阿尔茨海默病照顾者支持小组的信息。"}],"columns":[{"id":"c2","en":"Inappropriate","zh":"不合适"},{"id":"c1","en":"Appropriate","zh":"合适"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c1"]}]},"rationaleCorrectEn":"Interventions must focus on respite (relief) for the caregiver and peer support. Telling her to try harder exacerbates the guilt and burnout.","rationaleCorrectZh":"干预措施必须侧重于为照顾者提供喘息（缓解）机会和同伴支持。告诉她要更努力只会加重内疚感和倦怠感。","testTakingStrategyEn":"Prioritize interventions that provide 'respite' (temporary relief) for the burned-out caregiver.","testTakingStrategyZh":"优先考虑为筋疲力尽的照顾者提供“喘息”（暂时缓解）机会的干预措施。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":987,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_caregiver_08","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_caregiver_08_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.765.caseStudy.questions.2","itemType":"multiple_choice","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.765.caseStudy.questions.2.stem.en","stemPathZh":"questions.765.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,64],"terminalOffsetsZh":[0,19],"fullStemEn":"What is the nurse's priority action regarding the wife's health?","fullStemZh":"关于妻子的健康，护士的首要行动是什么？","terminalSentenceEn":"What is the nurse's priority action regarding the wife's health?","terminalSentenceZh":"关于妻子的健康，护士的首要行动是什么？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"o3","en":"Educate her on the pathophysiology of Alzheimer's disease.","zh":"对她进行有关阿尔茨海默病病理生理学的教育。"},{"id":"o4","en":"Discuss long-term nursing home placement for her husband.","zh":"讨论将她丈夫长期安置在养老院的事宜。"},{"id":"o1","en":"Tell her to immediately schedule a doctor's appointment.","zh":"告诉她立即预约看医生。"},{"id":"o2","en":"Assess her current blood pressure.","zh":"评估她当前的血压。"}],"correct":["o2"]},"rationaleCorrectEn":"Because she admitted to missing her blood pressure medication, the nurse must assess her current physiological status (blood pressure) first before taking other actions.","rationaleCorrectZh":"因为她承认漏服了降压药，护士必须在采取其他行动之前，首先评估她当前的生理状态（血压）。","testTakingStrategyEn":"Use the nursing process: Assessment comes before Implementation. Address physiological needs first.","testTakingStrategyZh":"运用护理程序：评估先于实施。首先解决生理需求。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":988,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_caregiver_08","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_caregiver_08_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.765.caseStudy.questions.3","itemType":"dropdown_cloze","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.765.caseStudy.questions.3.stem.en","stemPathZh":"questions.765.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,56],"terminalOffsetsZh":[0,15],"fullStemEn":"The nurse returns two weeks later for a follow-up visit.","fullStemZh":"两周后，护士再次进行家庭随访。","terminalSentenceEn":"The nurse returns two weeks later for a follow-up visit.","terminalSentenceZh":"两周后，护士再次进行家庭随访。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse evaluates that the caregiver's coping has improved if she states she has attended a {{1}} and has scheduled a {{2}}.","zh":"如果照顾者表示她已经参加了 {{1}} 并已预约了 {{2}}，护士可评估照顾者的应对能力有所改善。"},"dropdowns":[{"id":"1","options":[{"id":"o2","en":"financial planning seminar","zh":"财务规划研讨会"},{"id":"o1","en":"support group meeting","zh":"支持小组会议"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"routine checkup with her own doctor","zh":"她自己的医生的常规体检"},{"id":"o2","en":"meeting to sell their house","zh":"卖房的会议"}],"correct":"o1"}]},"rationaleCorrectEn":"Attending a support group indicates active coping and seeking emotional help. Seeing her own doctor addresses her neglected physical health.","rationaleCorrectZh":"参加支持小组表明积极应对和寻求情感帮助。看她自己的医生解决了她被忽视的身体健康问题。","testTakingStrategyEn":"Match the evaluation criteria directly to the previously identified problems (isolation, neglected health).","testTakingStrategyZh":"将评估标准直接与之前发现的问题（孤立、忽视健康）相匹配。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":989,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_grief_09","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.766","itemType":"case_study","category":"Psychosocial Integrity","topic":"Mental Health Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.766.stem.en","stemPathZh":"questions.766.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[71,117],"terminalOffsetsZh":[21,39],"fullStemEn":"Primary Care Clinic A 75-year-old male presents for a routine checkup. His wife of 50 years passed away 2 months ago.","fullStemZh":"初级保健诊所 一名75岁男性前来常规体检。与他结婚50年的妻子在2个月前去世。","terminalSentenceEn":"His wife of 50 years passed away 2 months ago.","terminalSentenceZh":"与他结婚50年的妻子在2个月前去世。","penultimateSentenceEn":"Primary Care Clinic A 75-year-old male presents for a routine checkup.","penultimateSentenceZh":"初级保健诊所 一名75岁男性前来常规体检。","responseContext":{},"rationaleCorrectEn":"Normal grief involves somatic and emotional symptoms that gradually resolve. The nurse's role is to facilitate the grieving process, validate feelings, and monitor for complicated grief or depression.","rationaleCorrectZh":"正常的悲伤包括躯体和情感症状，这些症状会逐渐缓解。护士的作用是促进悲伤过程、肯定感受，并监测是否有复杂性悲伤或抑郁症。","testTakingStrategyEn":"Use therapeutic communication techniques focused on exploring feelings.","testTakingStrategyZh":"使用侧重于探索感受的治疗性沟通技巧。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"Primary Care Clinic A 75-year-old male presents for a routine checkup.","controlSentenceZh":"初级保健诊所 一名75岁男性前来常规体检。"}
{"queueIndex":990,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_grief_09","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_grief_09_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.766.caseStudy.questions.0","itemType":"multiple_choice","category":"Psychosocial Integrity","topic":"Mental Health Disorders","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.766.caseStudy.questions.0.stem.en","stemPathZh":"questions.766.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,57],"terminalOffsetsZh":[0,13],"fullStemEn":"How should the nurse interpret the client's presentation?","fullStemZh":"护士应如何理解患者的表现？","terminalSentenceEn":"How should the nurse interpret the client's presentation?","terminalSentenceZh":"护士应如何理解患者的表现？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"o3","en":"He is experiencing disenfranchised grief.","zh":"他正在经历被剥夺权利的悲伤 (disenfranchised grief)。"},{"id":"o4","en":"He is in the denial stage of grief.","zh":"他正处于悲伤的否认阶段。"},{"id":"o1","en":"He is experiencing normal, uncomplicated grief.","zh":"他正在经历正常的、非复杂性的悲伤。"},{"id":"o2","en":"He is experiencing complicated grief requiring psychiatric intervention.","zh":"他正在经历需要精神科干预的复杂性悲伤。"}],"correct":["o1"]},"rationaleCorrectEn":"At 2 months post-loss, sadness, mild weight loss, and temporary social withdrawal are normal grieving behaviors. His ability to find meaning ('she is in a better place') indicates healthy processing.","rationaleCorrectZh":"在失去亲人2个月后，悲伤、轻微的体重减轻和暂时的社交退缩都是正常的悲伤行为。他能找到意义（“她在更好的地方”）表明他正在健康地处理情绪。","testTakingStrategyEn":"Distinguish between normal timeline grieving and pathological/complicated grief.","testTakingStrategyZh":"区分正常时间线的悲伤和病态/复杂性悲伤。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":991,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_grief_09","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_grief_09_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.766.caseStudy.questions.1","itemType":"matrix","category":"Psychosocial Integrity","topic":"Mental Health Disorders","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.766.caseStudy.questions.1.stem.en","stemPathZh":"questions.766.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[85,180],"terminalOffsetsZh":[22,54],"fullStemEn":"Which findings would indicate a transition from normal grief to clinical depression? Click to specify if each finding is expected in normal grief or indicates potential depression.","fullStemZh":"哪些发现表明从正常的悲伤过渡到了临床抑郁症？点击指出以下各项发现是正常悲伤的预期表现，还是表明潜在的抑郁症。","terminalSentenceEn":"Click to specify if each finding is expected in normal grief or indicates potential depression.","terminalSentenceZh":"点击指出以下各项发现是正常悲伤的预期表现，还是表明潜在的抑郁症。","penultimateSentenceEn":"Which findings would indicate a transition from normal grief to clinical depression?","penultimateSentenceZh":"哪些发现表明从正常的悲伤过渡到了临床抑郁症？","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Expressing feelings of worthlessness","zh":"表达出毫无价值的感觉"},{"id":"r2","en":"Crying when looking at old photos","zh":"看旧照片时哭泣"},{"id":"r3","en":"Active suicidal ideation","zh":"活跃的自杀意念"},{"id":"r4","en":"Occasional difficulty falling asleep","zh":"偶尔难以入睡"}],"columns":[{"id":"c1","en":"Normal Grief","zh":"正常悲伤"},{"id":"c2","en":"Potential Depression","zh":"潜在抑郁症"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c2"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c1"]}]},"rationaleCorrectEn":"Grief involves waves of sadness, but self-esteem usually remains intact. Feelings of profound worthlessness and suicidal ideation cross the line into clinical depression.","rationaleCorrectZh":"悲伤包含一阵阵的难过，但自尊通常保持完好。极度缺乏价值感和自杀意念则越界进入了临床抑郁症的范畴。","testTakingStrategyEn":"Identify red flags that distinguish depression (worthlessness, suicide) from grief (sadness, missing the deceased).","testTakingStrategyZh":"识别区分抑郁症（无价值感、自杀）与悲伤（难过、思念死者）的危险信号。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"Which findings would indicate a transition from normal grief to clinical depression?","controlSentenceZh":"哪些发现表明从正常的悲伤过渡到了临床抑郁症？"}
{"queueIndex":992,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_grief_09","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_grief_09_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.766.caseStudy.questions.2","itemType":"multiple_choice","category":"Psychosocial Integrity","topic":"Therapeutic Communication","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.766.caseStudy.questions.2.stem.en","stemPathZh":"questions.766.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,100],"terminalOffsetsZh":[0,33],"fullStemEn":"What is the nurse's most therapeutic response to the client's statement, 'The house feels so empty'?","fullStemZh":"针对患者所说的“房子感觉空荡荡的”，护士最具治疗意义的回应是什么？","terminalSentenceEn":"What is the nurse's most therapeutic response to the client's statement, 'The house feels so empty'?","terminalSentenceZh":"针对患者所说的“房子感觉空荡荡的”，护士最具治疗意义的回应是什么？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"o2","en":"'Perhaps you should consider downsizing to a smaller apartment.'","zh":"“也许您应该考虑换一个更小一点的公寓。”"},{"id":"o4","en":"'You should force yourself to go to your card game to take your mind off it.'","zh":"“您应该强迫自己去参加纸牌游戏，以分散您的注意力。”"},{"id":"o3","en":"'It sounds like you are feeling very lonely without her here.'","zh":"“听起来没有她在这里，您感到非常孤独。”"},{"id":"o1","en":"'It will get easier as time passes; you just need to stay busy.'","zh":"“随着时间的推移，情况会好转的；您只需要让自己忙碌起来。”"}],"correct":["o3"]},"rationaleCorrectEn":"Reflecting feelings (validating) encourages the client to explore their emotions. Giving advice or offering false reassurance shuts down communication.","rationaleCorrectZh":"反映情感（肯定）鼓励患者探索自己的情绪。提出建议或提供虚假的安慰会阻断沟通。","testTakingStrategyEn":"Choose the communication technique that validates the client's feelings and invites further sharing.","testTakingStrategyZh":"选择能够肯定患者感受并邀请其进一步分享的沟通技巧。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
