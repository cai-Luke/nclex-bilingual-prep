ontrolSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1312,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_2026_06_10_case04_pressure_injury_rehab","embeddedQuestionId":"gpt_case_premium_2026_06_10_case04_matrix_risk_01","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.145.caseStudy.questions.0","itemType":"matrix","category":"Basic Care and Comfort","topic":"Elimination & Comfort","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.145.caseStudy.questions.0.stem.en","stemPathZh":"questions.145.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,43],"terminalOffsetsZh":[0,15],"fullStemEn":"Classify each rehabilitation admission cue.","fullStemZh":"对康复入院时每项线索进行分类。","terminalSentenceEn":"Classify each rehabilitation admission cue.","terminalSentenceZh":"对康复入院时每项线索进行分类。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Decreased sensation over sacrum and heels","zh":"骶尾部和足跟感觉减退"},{"id":"r2","en":"Braden score of 13","zh":"Braden评分13分"},{"id":"r3","en":"Blanchable coccyx redness after prolonged sitting","zh":"长时间坐位后尾骨处可压白发红"},{"id":"r4","en":"Skin intact with no open areas on admission","zh":"入院时皮肤完整，无开放区域"},{"id":"r5","en":"Occasional urinary leakage","zh":"偶尔尿失禁"}],"columns":[{"id":"c1","en":"Increases pressure injury risk","zh":"增加压力性损伤风险"},{"id":"c2","en":"Current protective or reassuring cue","zh":"当前保护性或较安心线索"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c2"]},{"rowId":"r5","columnIds":["c1"]}]},"rationaleCorrectEn":"Decreased sensation, moderate risk score, redness after sitting, and moisture exposure increase risk; intact skin is reassuring but does not remove risk.","rationaleCorrectZh":"感觉减退、中等风险评分、坐位后发红和潮湿暴露会增加风险；皮肤完整较安心，但不消除风险。","testTakingStrategyEn":"Pressure injury prevention starts before skin opens. Risk cues matter even when the skin is intact.","testTakingStrategyZh":"压力性损伤预防应在皮肤破损前开始。即使皮肤完整，风险线索也重要。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1313,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_2026_06_10_case04_pressure_injury_rehab","embeddedQuestionId":"gpt_case_premium_2026_06_10_case04_cloze_stage1_02","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.145.caseStudy.questions.1","itemType":"dropdown_cloze","category":"Basic Care and Comfort","topic":"Skin & Wound Care","difficulty":"hard","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.145.caseStudy.questions.1.stem.en","stemPathZh":"questions.145.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,57],"terminalOffsetsZh":[0,14],"fullStemEn":"Complete the nurse's interpretation of the day-3 finding.","fullStemZh":"完成护士对第3天发现的解读。","terminalSentenceEn":"Complete the nurse's interpretation of the day-3 finding.","terminalSentenceZh":"完成护士对第3天发现的解读。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The sacral finding is most consistent with {{1}}, so the nurse should first {{2}}.","zh":"骶骨处发现最符合 {{1}}，因此护士应首先 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"a stage 1 pressure injury","zh":"1期压力性损伤"},{"id":"o3","en":"a full-thickness pressure injury","zh":"全层压力性损伤"},{"id":"o2","en":"normal skin color variation","zh":"正常肤色差异"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"offload pressure and update the prevention plan","zh":"减压并更新预防计划"},{"id":"o2","en":"massage the reddened area to improve circulation","zh":"按摩发红区域以促进循环"},{"id":"o3","en":"continue the same sitting schedule because the skin is intact","zh":"因皮肤完整而继续相同坐位安排"}],"correct":"o1"}]},"rationaleCorrectEn":"Intact, nonblanchable redness over a pressure point is consistent with stage 1 pressure injury and requires pressure relief, not massage.","rationaleCorrectZh":"受压点上皮肤完整但不可压白发红，符合1期压力性损伤，需要减压而不是按摩。","testTakingStrategyEn":"For skin findings, match the depth and blanching response to the action; do not massage pressure injuries.","testTakingStrategyZh":"皮肤题要把深度和压白反应与措施对应；不要按摩压力性损伤。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1314,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_2026_06_10_case04_pressure_injury_rehab","embeddedQuestionId":"gpt_case_premium_2026_06_10_case04_mc_first_action_03","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.145.caseStudy.questions.2","itemType":"multiple_choice","category":"Basic Care and Comfort","topic":"Skin & Wound Care","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.145.caseStudy.questions.2.stem.en","stemPathZh":"questions.145.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,84],"terminalOffsetsZh":[0,21],"fullStemEn":"Which nursing action is the priority after finding the nonblanchable sacral redness?","fullStemZh":"发现骶骨不可压白发红后，哪项护理措施优先？","terminalSentenceEn":"Which nursing action is the priority after finding the nonblanchable sacral redness?","terminalSentenceZh":"发现骶骨不可压白发红后，哪项护理措施优先？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"B","en":"Keep the client on bedrest for the rest of the rehabilitation stay.","zh":"让患者在康复余下期间一直卧床休息。"},{"id":"C","en":"Relieve pressure from the sacrum and request an appropriate pressure-redistribution surface.","zh":"解除骶骨压力，并申请合适的减压/压力再分布支撑面。"},{"id":"D","en":"Rub lotion firmly over the sacrum every shift.","zh":"每班用力在骶骨处涂抹乳液。"},{"id":"A","en":"Place the client back on the donut cushion because it feels comfortable.","zh":"因甜甜圈垫感觉舒适，让患者继续使用。"}],"correct":["C"]},"rationaleCorrectEn":"The priority is to remove pressure and use pressure redistribution; donut cushions and massage can worsen tissue injury.","rationaleCorrectZh":"优先措施是解除压力并使用压力再分布支撑；甜甜圈垫和按摩可能加重组织损伤。","testTakingStrategyEn":"When an intervention feels comfortable but increases pressure, choose tissue protection over preference.","testTakingStrategyZh":"当某措施感觉舒适但增加压力时，选择保护组织而不是迎合偏好。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1315,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_2026_06_10_case04_pressure_injury_rehab","embeddedQuestionId":"gpt_case_premium_2026_06_10_case04_sata_prevention_04","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.145.caseStudy.questions.3","itemType":"select_all","category":"Basic Care and Comfort","topic":"Mobility & Immobility","difficulty":"hard","ngnSkill":"generate_solutions","stemPathEn":"questions.145.caseStudy.questions.3.stem.en","stemPathZh":"questions.145.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[71,93],"terminalOffsetsZh":[16,24],"fullStemEn":"Which interventions should be included in the revised prevention plan? Select all that apply.","fullStemZh":"修订后的预防计划应包括哪些干预？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which interventions should be included in the revised prevention plan?","penultimateSentenceZh":"修订后的预防计划应包括哪些干预？","responseContext":{"type":"select_all","options":[{"id":"A","en":"Schedule pressure relief while in the wheelchair and repositioning while in bed.","zh":"安排轮椅上减压和卧床时翻身。"},{"id":"D","en":"Keep moist skin clean and dry and use a moisture barrier as needed.","zh":"保持潮湿皮肤清洁干燥，并按需使用防潮屏障。"},{"id":"E","en":"Limit protein and fluids to prevent urinary leakage.","zh":"限制蛋白质和液体以防尿失禁。"},{"id":"F","en":"Teach the client that absence of pain does not mean absence of injury.","zh":"教育患者没有疼痛不代表没有损伤。"},{"id":"C","en":"Inspect sacrum, heels, and other pressure points at least daily.","zh":"至少每日检查骶骨、足跟和其他受压部位。"},{"id":"B","en":"Use a pressure-redistribution wheelchair cushion instead of a donut cushion.","zh":"使用压力再分布轮椅坐垫，而不是甜甜圈垫。"}],"correct":["A","B","C","D","F"]},"rationaleCorrectEn":"The plan should reduce pressure, manage moisture, inspect high-risk areas, and teach around decreased sensation.","rationaleCorrectZh":"计划应减少压力、管理潮湿、检查高风险部位，并围绕感觉减退进行教学。","testTakingStrategyEn":"A good pressure-injury plan combines surface, schedule, skin, moisture, nutrition, and teaching.","testTakingStrategyZh":"良好的压力性损伤计划结合支撑面、时间表、皮肤、潮湿、营养和教学。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1316,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_2026_06_10_case04_pressure_injury_rehab","embeddedQuestionId":"gpt_case_premium_2026_06_10_case04_or_heel_action_05","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.145.caseStudy.questions.4","itemType":"ordered_response","category":"Basic Care and Comfort","topic":"Sleep & Rest","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.145.caseStudy.questions.4.stem.en","stemPathZh":"questions.145.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[41,85],"terminalOffsetsZh":[12,25],"fullStemEn":"The client's heels are boggy but intact. Place the nurse's actions in the best order.","fullStemZh":"患者足跟触感松软但完整。将护士措施按最佳顺序排列。","terminalSentenceEn":"Place the nurse's actions in the best order.","terminalSentenceZh":"将护士措施按最佳顺序排列。","penultimateSentenceEn":"The client's heels are boggy but intact.","penultimateSentenceZh":"患者足跟触感松软但完整。","responseContext":{"type":"ordered_response","options":[{"id":"D","en":"Document the assessment and the pressure-relief intervention.","zh":"记录评估和减压干预。"},{"id":"A","en":"Float the heels or use ordered heel offloading boots.","zh":"悬空足跟或使用医嘱/机构流程允许的足跟减压靴。"},{"id":"C","en":"Update the care plan and communicate the finding to the rehabilitation team.","zh":"更新照护计划并把发现告知康复团队。"},{"id":"B","en":"Assess heel color, temperature, blanching response, and surrounding skin.","zh":"评估足跟颜色、温度、压白反应和周围皮肤。"},{"id":"E","en":"Teach the client and family to avoid resting heels directly on the bed surface.","zh":"教育患者和家属避免让足跟直接压在床面。"}],"correct":["B","A","C","E","D"]},"rationaleCorrectEn":"Assess first, immediately offload pressure, update the team plan, teach prevention, and document what was found and done.","rationaleCorrectZh":"先评估，立即减压，更新团队计划，进行预防教学，并记录发现和措施。","testTakingStrategyEn":"For new skin-risk findings, assess, relieve pressure, coordinate, teach, document.","testTakingStrategyZh":"对新的皮肤风险发现，顺序是评估、减压、协作、教学、记录。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1317,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_2026_06_10_case05_health_literacy_adherence","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.146","itemType":"case_study","category":"Psychosocial Integrity","topic":"Therapeutic Communication","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.146.stem.en","stemPathZh":"questions.146.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,241],"terminalOffsetsZh":[0,72],"fullStemEn":"Health literacy and adherence support for hypothyroidism self-management A client with low health literacy and inconsistent medication adherence needs accessible teaching, teach-back, refill planning, and client-directed support involvement.","fullStemZh":"甲状腺功能减退自我管理中的健康素养与依从性支持 一名健康素养较低且用药不规律的患者，需要可理解教学、回授法、续药计划以及由患者主导的支持者参与。","terminalSentenceEn":"Health literacy and adherence support for hypothyroidism self-management A client with low health literacy and inconsistent medication adherence needs accessible teaching, teach-back, refill planning, and client-directed support involvement.","terminalSentenceZh":"甲状腺功能减退自我管理中的健康素养与依从性支持 一名健康素养较低且用药不规律的患者，需要可理解教学、回授法、续药计划以及由患者主导的支持者参与。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"The embedded questions evaluate clinical judgment across the unfolding case.","rationaleCorrectZh":"嵌入问题用于评估在病例进展中的临床判断。","testTakingStrategyEn":"Track what changed over time and connect each cue to the safest nursing action.","testTakingStrategyZh":"追踪随时间变化的线索，并把每个线索与最安全的护理措施联系起来。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
