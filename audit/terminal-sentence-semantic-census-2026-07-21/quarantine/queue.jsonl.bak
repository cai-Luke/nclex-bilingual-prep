lan fits the work schedule, protects feet, uses chosen support, and reinforces data the client already collects.","rationaleCorrectZh":"最佳计划适合工作时间、保护足部、使用患者选择的支持者，并强化患者已收集的数据。","testTakingStrategyEn":"Choose collaborative, behavior-specific interventions rather than shame-based advice.","testTakingStrategyZh":"选择合作性、具体行为的干预，而不是基于羞耻的建议。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1309,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_2026_06_10_case03_chronic_self_management","embeddedQuestionId":"gpt_case_premium_2026_06_10_case03_mc_understanding_04","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.144.caseStudy.questions.3","itemType":"multiple_choice","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"hard","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.144.caseStudy.questions.3.stem.en","stemPathZh":"questions.144.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,57],"terminalOffsetsZh":[0,15],"fullStemEn":"Which client statement best indicates effective teaching?","fullStemZh":"哪句患者陈述最能说明教学有效？","terminalSentenceEn":"Which client statement best indicates effective teaching?","terminalSentenceZh":"哪句患者陈述最能说明教学有效？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"C","en":"I should walk only on days when my blood glucose is exactly normal.","zh":"只有血糖完全正常的日子我才应该走路。"},{"id":"D","en":"My daughter should decide which goals I follow because she is helping me.","zh":"因为女儿在帮我，所以她应该决定我遵循哪些目标。"},{"id":"A","en":"If my feet looked fine last week, I can skip checks when I am tired.","zh":"如果上周脚看起来没问题，我累的时候可以跳过检查。"},{"id":"B","en":"I will inspect my feet every day and report any open area, blister, or redness that does not go away.","zh":"我会每天检查双脚，并报告任何开放区域、水疱或不消退的发红。"}],"correct":["B"]},"rationaleCorrectEn":"Daily inspection with reporting of skin changes shows understanding of foot protection with decreased sensation.","rationaleCorrectZh":"每天检查并报告皮肤变化，表明理解感觉减退时的足部保护。","testTakingStrategyEn":"Evaluation questions ask for the statement that proves the client can act safely after teaching.","testTakingStrategyZh":"评价类题目要求选择能证明患者教学后可安全行动的陈述。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
