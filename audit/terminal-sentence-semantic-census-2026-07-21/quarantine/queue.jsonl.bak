{"queueIndex":976,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_bowel_06","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_bowel_06_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.763.caseStudy.questions.1","itemType":"matrix","category":"Basic Care and Comfort","topic":"Elimination & Comfort","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.763.caseStudy.questions.1.stem.en","stemPathZh":"questions.763.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,82],"terminalOffsetsZh":[0,25],"fullStemEn":"Click to specify whether the nurse should implement or question each intervention.","fullStemZh":"点击指出护士应执行还是对以下各项干预措施提出质疑。","terminalSentenceEn":"Click to specify whether the nurse should implement or question each intervention.","terminalSentenceZh":"点击指出护士应执行还是对以下各项干预措施提出质疑。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Encourage fluid intake of 2000-3000 mL/day (if not contraindicated).","zh":"鼓励每天摄入2000-3000毫升液体（如无禁忌）。"},{"id":"r2","en":"Administer a prescribed daily stimulant laxative long-term.","zh":"长期给予处方的每日刺激性泻药。"},{"id":"r3","en":"Provide high-fiber snacks like prunes or bran.","zh":"提供高纤维零食，如西梅干或麸皮。"},{"id":"r4","en":"Administer docusate sodium daily as prescribed.","zh":"按医嘱每天给予多库酯钠(docusate sodium)。"}],"columns":[{"id":"c2","en":"Question","zh":"质疑"},{"id":"c1","en":"Implement","zh":"执行"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c1"]}]},"rationaleCorrectEn":"Hydration, fiber, and stool softeners (docusate) are first-line treatments. Long-term use of stimulant laxatives causes bowel dependence and should be questioned.","rationaleCorrectZh":"补水、纤维和粪便软化剂（多库酯钠）是一线治疗方案。长期使用刺激性泻药会导致肠道依赖，应该提出质疑。","testTakingStrategyEn":"Distinguish between safe, routine bowel regimens and those with long-term risks.","testTakingStrategyZh":"区分安全、常规的排便方案和具有长期风险的排便方案。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":977,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_bowel_06","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_bowel_06_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.763.caseStudy.questions.2","itemType":"multiple_choice","category":"Basic Care and Comfort","topic":"Elimination & Comfort","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.763.caseStudy.questions.2.stem.en","stemPathZh":"questions.763.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[60,93],"terminalOffsetsZh":[21,32],"fullStemEn":"The client states, 'I feel like I need to go, but I can't.' What is the nurse's first action?","fullStemZh":"患者说：“我觉得我想排便，但是排不出来。”护士的首要行动是什么？","terminalSentenceEn":"What is the nurse's first action?","terminalSentenceZh":"护士的首要行动是什么？","penultimateSentenceEn":"The client states, 'I feel like I need to go, but I can't.'","penultimateSentenceZh":"患者说：“我觉得我想排便，但是排不出来。”","responseContext":{"type":"multiple_choice","options":[{"id":"o2","en":"Perform a digital rectal examination to check for impaction.","zh":"进行直肠指检以检查是否有粪便嵌塞。"},{"id":"o4","en":"Tell the client to strain harder.","zh":"告诉患者更用力地屏气排便。"},{"id":"o1","en":"Administer an enema immediately.","zh":"立即灌肠。"},{"id":"o3","en":"Provide privacy and assist the client to the bedside commode.","zh":"提供隐私保护，并协助患者到床边便桶排便。"}],"correct":["o3"]},"rationaleCorrectEn":"Positioning and privacy are critical. A commode allows for a natural sitting position which uses gravity to aid defecation, unlike a bedpan.","rationaleCorrectZh":"体位和隐私至关重要。与便盆不同，便桶允许患者采取自然的坐姿，利用重力帮助排便。","testTakingStrategyEn":"Select the least invasive, most physiological nursing intervention first.","testTakingStrategyZh":"首先选择侵入性最小、最符合生理规律的护理干预措施。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
