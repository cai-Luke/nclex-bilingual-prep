ntrolSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1446,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_pancreatitis_03","embeddedQuestionId":"gpt_case_gap_2026_06_11_panc_matrix_01","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.186.caseStudy.questions.0","itemType":"matrix","category":"Reduction of Risk Potential","topic":"Laboratory & Diagnostic Tests","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.186.caseStudy.questions.0.stem.en","stemPathZh":"questions.186.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,42],"terminalOffsetsZh":[0,16],"fullStemEn":"Classify each finding in the initial data.","fullStemZh":"对初始资料中的每项发现进行分类。","terminalSentenceEn":"Classify each finding in the initial data.","terminalSentenceZh":"对初始资料中的每项发现进行分类。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Hematocrit 49% with vomiting and tachycardia","zh":"呕吐和心动过速伴血细胞比容49%"},{"id":"r2","en":"Calcium 7.4 mg/dL","zh":"钙7.4 mg/dL"},{"id":"r3","en":"Lipase 1,860 U/L","zh":"脂肪酶1,860 U/L"},{"id":"r4","en":"Common bile duct mildly dilated with gallstones","zh":"胆结石伴总胆管轻度扩张"},{"id":"r5","en":"Pain radiating to the back","zh":"疼痛向背部放射"}],"columns":[{"id":"c2","en":"Expected pancreatitis cue","zh":"胰腺炎预期线索"},{"id":"c1","en":"Complication or high-risk cue","zh":"并发症或高风险线索"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c1"]},{"rowId":"r5","columnIds":["c2"]}]},"rationaleCorrectEn":"Hemoconcentration, hypocalcemia, and possible biliary obstruction signal complications or higher severity. Elevated lipase and back-radiating epigastric pain support the diagnosis but are expected cues.","rationaleCorrectZh":"血液浓缩、低钙和可能的胆道梗阻提示并发症或严重程度较高。脂肪酶升高和向背部放射的上腹痛支持诊断，但属于预期线索。","testTakingStrategyEn":"Separate diagnostic cues from severity cues; hard cases often test the complication hidden inside expected disease features.","testTakingStrategyZh":"区分诊断线索和严重程度线索；难题常考隐藏在预期疾病表现中的并发症。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1447,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_pancreatitis_03","embeddedQuestionId":"gpt_case_gap_2026_06_11_panc_cloze_02","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.186.caseStudy.questions.1","itemType":"dropdown_cloze","category":"Reduction of Risk Potential","topic":"Laboratory & Diagnostic Tests","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.186.caseStudy.questions.1.stem.en","stemPathZh":"questions.186.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,63],"terminalOffsetsZh":[0,15],"fullStemEn":"Complete the clinical judgment statement for the deterioration.","fullStemZh":"完成对病情恶化的临床判断陈述。","terminalSentenceEn":"Complete the clinical judgment statement for the deterioration.","terminalSentenceZh":"完成对病情恶化的临床判断陈述。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The client's findings are most concerning for {{1}} related to {{2}}.","zh":"该患者的表现最令人担心{{1}}，其相关原因是{{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"hypovolemic shock","zh":"低血容量性休克"},{"id":"o2","en":"uncomplicated pain response","zh":"单纯疼痛反应"},{"id":"o3","en":"stable recovery after analgesia","zh":"镇痛后的稳定恢复"}],"correct":"o1"},{"id":"2","options":[{"id":"o3","en":"NPO status and opioid administration only","zh":"仅因禁食和阿片给药"},{"id":"o1","en":"third spacing, hemoconcentration, hypotension, and falling urine output","zh":"第三间隙液体转移、血液浓缩、低血压和尿量下降"},{"id":"o2","en":"lipase elevation alone","zh":"单纯脂肪酶升高"}],"correct":"o1"}]},"rationaleCorrectEn":"Severe pancreatitis can shift large volumes out of the vascular space. Hypotension, tachycardia, oliguria, rising hematocrit, and rising BUN indicate poor perfusion.","rationaleCorrectZh":"重症胰腺炎可使大量液体移出血管腔。低血压、心动过速、少尿、血细胞比容和BUN升高提示灌注不良。","testTakingStrategyEn":"In pancreatitis, worsening BUN/hematocrit plus oliguria should make you think vascular depletion even when the abdomen looks fluid-filled.","testTakingStrategyZh":"胰腺炎中，BUN/血细胞比容恶化加少尿应提示血管内容量不足，即使腹部看似有液体。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1448,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_pancreatitis_03","embeddedQuestionId":"gpt_case_gap_2026_06_11_panc_or_03","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.186.caseStudy.questions.2","itemType":"ordered_response","category":"Management of Care","topic":"Prioritization & Delegation","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.186.caseStudy.questions.2.stem.en","stemPathZh":"questions.186.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,44],"terminalOffsetsZh":[0,12],"fullStemEn":"Place the nursing actions in priority order.","fullStemZh":"按优先顺序排列护理措施。","terminalSentenceEn":"Place the nursing actions in priority order.","terminalSentenceZh":"按优先顺序排列护理措施。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"ordered_response","options":[{"id":"D","en":"Prepare large-bore IV access and administer prescribed isotonic fluid resuscitation.","zh":"准备大口径静脉通路并遵医嘱给予等渗液体复苏。"},{"id":"E","en":"Monitor response: blood pressure, lung sounds, oxygenation, urine output, BUN/hematocrit, and calcium.","zh":"监测反应：血压、肺音、氧合、尿量、BUN/血细胞比容和钙。"},{"id":"A","en":"Apply oxygen and raise the head of the bed while reassessing respiratory effort.","zh":"给予氧气并抬高床头，同时复评呼吸用力。"},{"id":"C","en":"Assess airway, breathing, circulation, pain, abdomen, mental status, and urine output trend.","zh":"评估气道、呼吸、循环、疼痛、腹部、意识状态和尿量趋势。"},{"id":"B","en":"Activate rapid response/provider notification for hypotension, hypoxemia, and oliguria.","zh":"因低血压、低氧和少尿启动快速反应/通知医嘱提供者。"}],"correct":["C","A","B","D","E"]},"rationaleCorrectEn":"The nurse first verifies ABC and perfusion status, supports breathing, escalates for shock, implements prescribed resuscitation, and evaluates for both improved perfusion and fluid overload/electrolyte complications.","rationaleCorrectZh":"护士先确认ABC和灌注状态，支持呼吸，因休克升级处理，执行医嘱复苏，并评价灌注改善及液体过负荷/电解质并发症。","testTakingStrategyEn":"Do not let abdominal pain distract from shock cues; stabilize oxygenation and perfusion first.","testTakingStrategyZh":"不要让腹痛分散对休克线索的注意；先稳定氧合和灌注。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1449,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_pancreatitis_03","embeddedQuestionId":"gpt_case_gap_2026_06_11_panc_fib_04","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.186.caseStudy.questions.3","itemType":"fill_in_blank","category":"Reduction of Risk Potential","topic":"Laboratory & Diagnostic Tests","difficulty":"hard","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.186.caseStudy.questions.3.stem.en","stemPathZh":"questions.186.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[96,130],"terminalOffsetsZh":[41,49],"fullStemEn":"The client weighs 76 kg. What is the minimum expected urine output in mL/hr using 0.5 mL/kg/hr? Round to the nearest whole number.","fullStemZh":"患者体重76 kg。按0.5 mL/kg/hr计算，最低预期尿量是多少mL/hr？四舍五入到整数。","terminalSentenceEn":"Round to the nearest whole number.","terminalSentenceZh":"四舍五入到整数。","penultimateSentenceEn":"What is the minimum expected urine output in mL/hr using 0.5 mL/kg/hr?","penultimateSentenceZh":"按0.5 mL/kg/hr计算，最低预期尿量是多少mL/hr？","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"mL/hr","zh":"mL/hr"},"acceptable":["38","38 mL/hr"],"numeric":{"value":38,"tolerance":0,"unit":"mL/hr"}}]},"rationaleCorrectEn":"Minimum expected urine output is 76 kg × 0.5 mL/kg/hr = 38 mL/hr. The current 38 mL/hr is just at the minimum and requires continued trending.","rationaleCorrectZh":"最低预期尿量=76 kg × 0.5 mL/kg/hr = 38 mL/hr。当前38 mL/hr仅达到最低值，需要继续观察趋势。","testTakingStrategyEn":"When an outcome barely meets a minimum threshold, keep monitoring rather than assuming stability.","testTakingStrategyZh":"当结果只是勉强达到最低阈值时，应继续监测而不是认为已经稳定。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"What is the minimum expected urine output in mL/hr using 0.5 mL/kg/hr?","controlSentenceZh":"按0.5 mL/kg/hr计算，最低预期尿量是多少mL/hr？"}
{"queueIndex":1450,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_adrenal_crisis_04","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.187","itemType":"case_study","category":"Physiological Adaptation","topic":"Endocrine & Neurological Disorders","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.187.stem.en","stemPathZh":"questions.187.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,200],"terminalOffsetsZh":[0,56],"fullStemEn":"Adrenal crisis after missed stress-dose steroids A client with known adrenal insufficiency cannot tolerate oral steroids during illness and develops shock, hypoglycemia, and electrolyte abnormalities.","fullStemZh":"漏用应激剂量激素后的肾上腺危象 已知肾上腺功能不全患者患病期间无法耐受口服激素，进展为休克、低血糖和电解质异常。","terminalSentenceEn":"Adrenal crisis after missed stress-dose steroids A client with known adrenal insufficiency cannot tolerate oral steroids during illness and develops shock, hypoglycemia, and electrolyte abnormalities.","terminalSentenceZh":"漏用应激剂量激素后的肾上腺危象 已知肾上腺功能不全患者患病期间无法耐受口服激素，进展为休克、低血糖和电解质异常。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This case study requires recognizing deterioration across serial assessment data and choosing nursing actions that reduce risk.","rationaleCorrectZh":"本病例要求根据连续评估资料识别病情恶化，并选择降低风险的护理措施。","testTakingStrategyEn":"In an unfolding case, compare the newest data with baseline and act first on unstable airway, breathing, circulation, perfusion, and safety cues.","testTakingStrategyZh":"处理展开式病例时，先把最新资料与基线比较，并优先处理气道、呼吸、循环、灌注和安全方面的不稳定线索。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1451,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_adrenal_crisis_04","embeddedQuestionId":"gpt_case_gap_2026_06_11_adrenal_matrix_01","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.187.caseStudy.questions.0","itemType":"matrix","category":"Reduction of Risk Potential","topic":"Laboratory & Diagnostic Tests","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.187.caseStudy.questions.0.stem.en","stemPathZh":"questions.187.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,126],"terminalOffsetsZh":[0,38],"fullStemEn":"For each finding, indicate whether it supports adrenal crisis requiring immediate follow-up or is less urgent in this context.","fullStemZh":"对于每项发现，判断其是否支持需要立即跟进的肾上腺危象，或在此情境下较不紧急。","terminalSentenceEn":"For each finding, indicate whether it supports adrenal crisis requiring immediate follow-up or is less urgent in this context.","terminalSentenceZh":"对于每项发现，判断其是否支持需要立即跟进的肾上腺危象，或在此情境下较不紧急。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Could not keep hydrocortisone down for two days","zh":"两天无法保留口服氢化可的松"},{"id":"r2","en":"BP 84/46 mm Hg with mottled skin","zh":"BP 84/46 mm Hg伴皮肤花斑"},{"id":"r3","en":"Glucose 52 mg/dL","zh":"血糖52 mg/dL"},{"id":"r4","en":"Potassium 5.9 mEq/L and sodium 126 mEq/L","zh":"钾5.9 mEq/L且钠126 mEq/L"},{"id":"r5","en":"Abdominal pain after gastroenteritis","zh":"胃肠炎后腹痛"}],"columns":[{"id":"c1","en":"Adrenal crisis cue","zh":"肾上腺危象线索"},{"id":"c2","en":"Less urgent/less specific","zh":"较不紧急/较不特异"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c1"]},{"rowId":"r5","columnIds":["c2"]}]},"rationaleCorrectEn":"Missed steroid replacement during illness plus shock, hypoglycemia, hyponatremia, and hyperkalemia strongly supports adrenal crisis. Abdominal pain can occur but is less specific than the instability cues.","rationaleCorrectZh":"疾病期间未能补充激素，加上休克、低血糖、低钠和高钾，强烈支持肾上腺危象。腹痛可出现，但不如不稳定线索特异。","testTakingStrategyEn":"In endocrine emergencies, connect the missing hormone to the vital-sign and lab pattern.","testTakingStrategyZh":"处理内分泌急症时，把缺失激素与生命体征和实验室模式联系起来。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1452,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_adrenal_crisis_04","embeddedQuestionId":"gpt_case_gap_2026_06_11_adrenal_cloze_02","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.187.caseStudy.questions.1","itemType":"dropdown_cloze","category":"Reduction of Risk Potential","topic":"Laboratory & Diagnostic Tests","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.187.caseStudy.questions.1.stem.en","stemPathZh":"questions.187.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,32],"terminalOffsetsZh":[0,9],"fullStemEn":"Complete the priority statement.","fullStemZh":"完成优先判断陈述。","terminalSentenceEn":"Complete the priority statement.","terminalSentenceZh":"完成优先判断陈述。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The client is at highest risk for {{1}} because of {{2}}.","zh":"由于{{2}}，该患者最高风险是{{1}}。"},"dropdowns":[{"id":"1","options":[{"id":"o2","en":"fluid overload from excessive steroids","zh":"激素过量导致容量过负荷"},{"id":"o1","en":"circulatory collapse with neuroglycopenia","zh":"循环衰竭伴脑部低糖供能不足"},{"id":"o3","en":"stable viral illness without endocrine emergency","zh":"无内分泌急症的稳定病毒感染"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"refractory hypotension, altered arousal, and glucose 48 mg/dL","zh":"持续低血压、觉醒度改变和血糖48 mg/dL"},{"id":"o3","en":"sodium 126 mEq/L alone","zh":"单纯钠126 mEq/L"},{"id":"o2","en":"mild abdominal pain with normal perfusion","zh":"轻度腹痛且灌注正常"}],"correct":"o1"}]},"rationaleCorrectEn":"The combination of shock-level hypotension and severe hypoglycemia threatens both perfusion and brain glucose delivery.","rationaleCorrectZh":"休克水平低血压和严重低血糖同时威胁灌注和脑部葡萄糖供应。","testTakingStrategyEn":"When hypotension and altered mental status occur with low glucose, treat the situation as unstable even before all endocrine labs return.","testTakingStrategyZh":"低血压和意识改变伴低血糖时，即使内分泌化验未全回报，也应按不稳定处理。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1453,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_adrenal_crisis_04","embeddedQuestionId":"gpt_case_gap_2026_06_11_adrenal_or_03","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.187.caseStudy.questions.2","itemType":"ordered_response","category":"Management of Care","topic":"Prioritization & Delegation","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.187.caseStudy.questions.2.stem.en","stemPathZh":"questions.187.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,45],"terminalOffsetsZh":[0,13],"fullStemEn":"Place the emergency nursing actions in order.","fullStemZh":"将急救护理措施按顺序排列。","terminalSentenceEn":"Place the emergency nursing actions in order.","terminalSentenceZh":"将急救护理措施按顺序排列。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"ordered_response","options":[{"id":"C","en":"Activate rapid response/provider notification for suspected adrenal crisis with shock.","zh":"因疑似肾上腺危象伴休克启动快速反应/通知医嘱提供者。"},{"id":"D","en":"Administer prescribed IV hydrocortisone, isotonic saline, and dextrose without delaying for cortisol results.","zh":"遵医嘱给予静脉氢化可的松、等渗盐水和葡萄糖，不因等待皮质醇结果而延误。"},{"id":"A","en":"Assess airway, breathing, circulation, mental status, and bedside glucose.","zh":"评估气道、呼吸、循环、意识状态和床旁血糖。"},{"id":"B","en":"Maintain IV access, apply cardiac monitoring, and place the client supine with legs elevated if tolerated.","zh":"维持静脉通路，应用心电监护，并在可耐受时让患者仰卧抬腿。"},{"id":"E","en":"Reassess blood pressure, mental status, glucose, potassium, sodium, and urine output.","zh":"复评血压、意识状态、血糖、钾、钠和尿量。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"Immediate assessment identifies shock and hypoglycemia, supportive measures reduce collapse risk, urgent escalation obtains emergency therapy, and treatment should not wait for confirmatory cortisol testing when crisis is suspected.","rationaleCorrectZh":"立即评估可识别休克和低血糖，支持措施降低循环衰竭风险，紧急升级以获得急救治疗；疑似危象时不应等待皮质醇确证结果才治疗。","testTakingStrategyEn":"For adrenal crisis, the lifesaving pattern is steroid, saline, and sugar after rapid ABC/glucose assessment and escalation.","testTakingStrategyZh":"肾上腺危象的救命模式是在快速ABC/血糖评估和升级后给予激素、盐水和糖。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1454,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_adrenal_crisis_04","embeddedQuestionId":"gpt_case_gap_2026_06_11_adrenal_fib_04","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.187.caseStudy.questions.3","itemType":"fill_in_blank","category":"Physiological Adaptation","topic":"Cardiovascular Disorders","difficulty":"hard","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.187.caseStudy.questions.3.stem.en","stemPathZh":"questions.187.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[92,126],"terminalOffsetsZh":[0,56],"fullStemEn":"Calculate the mean arterial pressure (MAP) for BP 78/40 mm Hg using MAP = (SBP + 2DBP) / 3. Round to the nearest whole number.","fullStemZh":"使用MAP = (收缩压 + 2×舒张压) / 3计算BP 78/40 mm Hg的平均动脉压，四舍五入到整数。","terminalSentenceEn":"Round to the nearest whole number.","terminalSentenceZh":"使用MAP = (收缩压 + 2×舒张压) / 3计算BP 78/40 mm Hg的平均动脉压，四舍五入到整数。","penultimateSentenceEn":"Calculate the mean arterial pressure (MAP) for BP 78/40 mm Hg using MAP = (SBP + 2DBP) / 3.","penultimateSentenceZh":null,"responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"MAP in mm Hg","zh":"MAP，mm Hg"},"acceptable":["53","53 mm Hg"],"numeric":{"value":53,"tolerance":1,"unit":"mm Hg"}}]},"rationaleCorrectEn":"MAP = (78 + 2[40]) / 3 = 158 / 3 = 52.7, rounded to 53 mm Hg. This is below the usual perfusion target and supports shock-level urgency.","rationaleCorrectZh":"MAP = (78 + 2[40]) / 3 = 158 / 3 = 52.7，四舍五入为53 mm Hg。该值低于常用灌注目标，支持休克级紧急性。","testTakingStrategyEn":"After calculating a hemodynamic value, interpret whether it changes urgency.","testTakingStrategyZh":"计算血流动力学数值后，要判断其是否改变紧急程度。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":true,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1455,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_urosepsis_05","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.188","itemType":"case_study","category":"Physiological Adaptation","topic":"Sepsis & Septic Shock","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.188.stem.en","stemPathZh":"questions.188.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,189],"terminalOffsetsZh":[0,50],"fullStemEn":"Sepsis from obstructed urinary source An older adult with diabetes develops sepsis from an obstructing ureteral stone and urinary infection, with worsening perfusion despite initial fluids.","fullStemZh":"梗阻性泌尿源脓毒症 一名糖尿病老年患者因输尿管梗阻性结石和尿路感染发生脓毒症，初始补液后灌注仍恶化。","terminalSentenceEn":"Sepsis from obstructed urinary source An older adult with diabetes develops sepsis from an obstructing ureteral stone and urinary infection, with worsening perfusion despite initial fluids.","terminalSentenceZh":"梗阻性泌尿源脓毒症 一名糖尿病老年患者因输尿管梗阻性结石和尿路感染发生脓毒症，初始补液后灌注仍恶化。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This case study requires recognizing deterioration across serial assessment data and choosing nursing actions that reduce risk.","rationaleCorrectZh":"本病例要求根据连续评估资料识别病情恶化，并选择降低风险的护理措施。","testTakingStrategyEn":"In an unfolding case, compare the newest data with baseline and act first on unstable airway, breathing, circulation, perfusion, and safety cues.","testTakingStrategyZh":"处理展开式病例时，先把最新资料与基线比较，并优先处理气道、呼吸、循环、灌注和安全方面的不稳定线索。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
