{"queueIndex":2366,"bankPath":"banks/hard-cases-canonical.json","bankSha256":"438c176897a41d3b7f212435e5945bd524c3f0ba5a62931eb5e85843c93d8730","topLevelQuestionId":"cs_ngn_010_ad","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.27","itemType":"case_study","category":"Physiological Adaptation","topic":"Endocrine & Neurological Disorders","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.27.stem.en","stemPathZh":"questions.27.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[196,227],"terminalOffsetsZh":[55,72],"fullStemEn":"Autonomic Dysreflexia Crisis A client with a T4 spinal cord injury reports a sudden pounding headache and nasal congestion. Their face is flushed and sweating, while their legs are pale and cool. Blood pressure is 210/110 mmHg.","fullStemZh":"自主神经反射亢进危机 一名 T4 脊髓损伤患者自述突然出现剧烈头痛和鼻塞。他们的面部潮红流汗，而腿部苍白冰冷。血压为 210/110 mmHg。","terminalSentenceEn":"Blood pressure is 210/110 mmHg.","terminalSentenceZh":"血压为 210/110 mmHg。","penultimateSentenceEn":"Their face is flushed and sweating, while their legs are pale and cool.","penultimateSentenceZh":"他们的面部潮红流汗，而腿部苍白冰冷。","responseContext":{},"rationaleCorrectEn":"Autonomic dysreflexia is a hypertensive emergency in spinal cord injury patients.","rationaleCorrectZh":"自主神经反射亢进是脊髓损伤患者的一种高血压急症。","testTakingStrategyEn":"Focus on safety and priority interventions.","testTakingStrategyZh":"关注安全和优先干预措施。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
