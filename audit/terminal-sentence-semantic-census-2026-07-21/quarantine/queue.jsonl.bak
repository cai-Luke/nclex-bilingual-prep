exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1547,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_case_delirium_family_04","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_case_delirium_family_04_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.244.caseStudy.questions.0","itemType":"matrix","category":"Psychosocial Integrity","topic":"Mental Health Disorders","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.244.caseStudy.questions.0.stem.en","stemPathZh":"questions.244.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,92],"terminalOffsetsZh":[0,31],"fullStemEn":"Using Stage 1 data, classify each cue as increasing delirium risk or supporting orientation.","fullStemZh":"根据第 1 阶段资料，将每项线索分类为增加谵妄风险或支持定向。","terminalSentenceEn":"Using Stage 1 data, classify each cue as increasing delirium risk or supporting orientation.","terminalSentenceZh":"根据第 1 阶段资料，将每项线索分类为增加谵妄风险或支持定向。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Hearing aids were left at home","zh":"助听器留在家中"},{"id":"r2","en":"Large clock and calendar are visible from bed","zh":"床上可看到大时钟和日历"},{"id":"r3","en":"Slept less than 3 hours because of nighttime interruptions","zh":"因夜间干扰睡眠不足 3 小时"},{"id":"r4","en":"Daughter brings familiar family photos","zh":"女儿带来熟悉的家庭照片"},{"id":"r5","en":"Diphenhydramine ordered as needed for sleep","zh":"医嘱苯海拉明按需用于睡眠"}],"columns":[{"id":"c2","en":"Supports orientation","zh":"支持定向"},{"id":"c1","en":"Increases delirium risk","zh":"增加谵妄风险"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c2"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c1"]},{"rowId":"r5","columnIds":["c2"]}]},"rationaleCorrectEn":"Older age, sleep disruption, sensory impairment, infection recovery, dehydration risk, and anticholinergic medications increase delirium risk. Familiar glasses, hearing aids, clocks, and family presence support orientation.","rationaleCorrectZh":"高龄、睡眠中断、感觉障碍、感染恢复期、脱水风险和抗胆碱药会增加谵妄风险。熟悉的眼镜、助听器、时钟和家属陪伴有助于定向。","testTakingStrategyEn":"Delirium prevention often begins by restoring sleep, senses, hydration, mobility, and orientation cues.","testTakingStrategyZh":"谵妄预防通常从恢复睡眠、感觉输入、水分、活动和定向线索开始。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1548,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_case_delirium_family_04","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_case_delirium_family_04_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.244.caseStudy.questions.1","itemType":"dropdown_cloze","category":"Psychosocial Integrity","topic":"Mental Health Disorders","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.244.caseStudy.questions.1.stem.en","stemPathZh":"questions.244.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,61],"terminalOffsetsZh":[0,20],"fullStemEn":"Stage 2 describes an acute change in attention and awareness.","fullStemZh":"第 2 阶段描述注意力和意识的急性改变。","terminalSentenceEn":"Stage 2 describes an acute change in attention and awareness.","terminalSentenceZh":"第 2 阶段描述注意力和意识的急性改变。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The pattern is most consistent with {{1}}, so the nurse should {{2}}.","zh":"这种表现最符合 {{1}}，因此护士应 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o3","en":"fixed dementia progression","zh":"固定性痴呆进展"},{"id":"o2","en":"expected aging","zh":"正常老化"},{"id":"o1","en":"delirium","zh":"谵妄"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"avoid reorientation because it increases agitation","zh":"避免重新定向，因为会增加激动"},{"id":"o1","en":"assess reversible causes and implement safety measures","zh":"评估可逆原因并实施安全措施"},{"id":"o3","en":"ask family not to visit until confusion resolves","zh":"要求家属在意识混乱好转前不要探视"}],"correct":"o1"}]},"rationaleCorrectEn":"The abrupt, fluctuating confusion with inattention is most consistent with delirium. The nursing response is to assess and address reversible causes while maintaining safety, rather than assuming permanent dementia progression.","rationaleCorrectZh":"突然发生、波动性意识混乱并伴注意力不集中最符合谵妄。护理反应应评估并处理可逆原因，同时维持安全，而不是假设为永久性痴呆进展。","testTakingStrategyEn":"Acute onset and fluctuating attention are key clues for delirium, even when a client has mild baseline memory problems.","testTakingStrategyZh":"急性起病和波动性注意力是谵妄的关键线索，即使患者本来有轻度记忆问题。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1549,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_case_delirium_family_04","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_case_delirium_family_04_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.244.caseStudy.questions.2","itemType":"ordered_response","category":"Psychosocial Integrity","topic":"Mental Health Disorders","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.244.caseStudy.questions.2.stem.en","stemPathZh":"questions.244.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[76,128],"terminalOffsetsZh":[25,40],"fullStemEn":"The client is restless at 0200 but is not pulling at lines and denies pain. Place the nurse's nonpharmacologic actions in order.","fullStemZh":"患者 0200 烦躁不安，但未拉扯管路且否认疼痛。请按顺序排列护士的非药物措施。","terminalSentenceEn":"Place the nurse's nonpharmacologic actions in order.","terminalSentenceZh":"请按顺序排列护士的非药物措施。","penultimateSentenceEn":"The client is restless at 0200 but is not pulling at lines and denies pain.","penultimateSentenceZh":"患者 0200 烦躁不安，但未拉扯管路且否认疼痛。","responseContext":{"type":"ordered_response","options":[{"id":"B","en":"Speak calmly, reorient to place and time, and provide glasses or hearing aids","zh":"平静说话，重新定向地点和时间，并提供眼镜或助听器"},{"id":"C","en":"Dim lights, reduce noise, cluster care, and promote sleep","zh":"调暗灯光、降低噪音、集中护理并促进睡眠"},{"id":"D","en":"Reassess agitation, attention, and ability to rest","zh":"复评烦躁、注意力和休息能力"},{"id":"A","en":"Check safety, toileting need, hydration, hunger, and discomfort","zh":"检查安全、如厕需求、水分、饥饿和不适"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"First assess immediate safety and basic needs, then provide calm reorientation and sensory aids, reduce stimulation and promote sleep, and reassess the response before requesting additional interventions.","rationaleCorrectZh":"先评估即时安全和基本需求，再平静地重新定向并提供感觉辅助，随后减少刺激并促进睡眠，最后复评反应后再请求其他干预。","testTakingStrategyEn":"For mild restlessness, start with safety, unmet needs, orientation, sensory support, and sleep protection before medication-focused thinking.","testTakingStrategyZh":"对轻度烦躁，先考虑安全、未满足需求、定向、感觉支持和保护睡眠，再考虑药物。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1550,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_case_delirium_family_04","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_case_delirium_family_04_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.244.caseStudy.questions.3","itemType":"select_all","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.244.caseStudy.questions.3.stem.en","stemPathZh":"questions.244.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[84,106],"terminalOffsetsZh":[24,32],"fullStemEn":"Which family actions should the nurse encourage to help prevent or reduce delirium? Select all that apply.","fullStemZh":"护士应鼓励家属采取哪些行动以帮助预防或减轻谵妄？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which family actions should the nurse encourage to help prevent or reduce delirium?","penultimateSentenceZh":"护士应鼓励家属采取哪些行动以帮助预防或减轻谵妄？","responseContext":{"type":"select_all","options":[{"id":"A","en":"Bring the client's glasses and hearing aids","zh":"带来患者的眼镜和助听器"},{"id":"D","en":"Place familiar family photos where the client can see them","zh":"将熟悉的家庭照片放在患者能看到的地方"},{"id":"F","en":"Stop all visits because family presence always worsens confusion","zh":"停止所有探视，因为家属在场总会加重意识混乱"},{"id":"B","en":"Gently remind the client of the date, place, and reason for hospitalization","zh":"温和提醒患者日期、地点和住院原因"},{"id":"C","en":"Argue until the client accepts that the hallucination is not real","zh":"争辩到患者承认幻觉不是真的"},{"id":"E","en":"Tell staff what the client is normally able to remember and do","zh":"告诉工作人员患者平时能记住和完成的事情"}],"correct":["A","B","D","E"]},"rationaleCorrectEn":"Helpful family actions include bringing sensory aids, calmly reorienting, providing familiar items, encouraging daytime wakefulness and safe mobility, and reporting baseline changes. Arguing with the client or restricting all visits is not therapeutic.","rationaleCorrectZh":"有帮助的家属行动包括带来感觉辅助用品、平静重新定向、提供熟悉物品、鼓励白天清醒和安全活动，以及报告基线变化。与患者争辩或完全限制探视不是治疗性做法。","testTakingStrategyEn":"Family can be part of delirium prevention when their actions orient, reassure, and communicate baseline function.","testTakingStrategyZh":"当家属的行动能帮助定向、安抚并沟通基线功能时，他们就是谵妄预防的一部分。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1551,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_case_delirium_family_04","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_case_delirium_family_04_q5","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.244.caseStudy.questions.4","itemType":"multiple_choice","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.244.caseStudy.questions.4.stem.en","stemPathZh":"questions.244.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[40,131],"terminalOffsetsZh":[13,33],"fullStemEn":"Stage 3 discharge teaching is complete. Which finding best indicates that the family understands when to seek help after discharge?","fullStemZh":"第 3 阶段出院宣教完成。哪项发现最能说明家属理解出院后何时求助？","terminalSentenceEn":"Which finding best indicates that the family understands when to seek help after discharge?","terminalSentenceZh":"哪项发现最能说明家属理解出院后何时求助？","penultimateSentenceEn":"Stage 3 discharge teaching is complete.","penultimateSentenceZh":"第 3 阶段出院宣教完成。","responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"We will wait a few days because confusion is expected after any hospitalization.","zh":"我们会等几天，因为任何住院后意识混乱都是预期的。"},{"id":"D","en":"We can give extra sleep medicine at home if he is awake at night.","zh":"如果他晚上醒着，我们可以在家多给助眠药。"},{"id":"C","en":"We should avoid mentioning hallucinations because that may embarrass him.","zh":"我们应避免提到幻觉，因为可能让他尴尬。"},{"id":"B","en":"We will call if confusion starts suddenly, attention worsens, or behavior becomes unsafe.","zh":"如果意识混乱突然出现、注意力变差或行为变得不安全，我们会打电话。"}],"correct":["B"]},"rationaleCorrectEn":"Family should seek help for acute confusion, new inattention, hallucinations, unsafe behavior, fever, dehydration, medication concerns, or sudden decline because delirium can signal an acute illness or medication problem.","rationaleCorrectZh":"家属应在出现急性意识混乱、新发注意力不集中、幻觉、不安全行为、发热、脱水、用药问题或突然下降时求助，因为谵妄可能提示急性疾病或药物问题。","testTakingStrategyEn":"The best teach-back statement includes specific warning signs and an action to get help.","testTakingStrategyZh":"最佳回示陈述应包含具体警示信号和求助行动。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":true,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1552,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_matrix_opioid_sedation_05","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.245","itemType":"matrix","category":"Pharmacological and Parenteral Therapies","topic":"Dosage Calculations","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.245.stem.en","stemPathZh":"questions.245.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[190,249],"terminalOffsetsZh":[90,110],"fullStemEn":"A postoperative adult has hydromorphone 0.4 mg IV every 3 hours as needed for severe pain. At 1000, pain is 8/10, RR 16/min, SpO2 96% on room air, and sedation score is 1 (awake and alert). At 1030 after the dose, classify each reassessment finding.","fullStemZh":"一名术后成人患者医嘱氢吗啡酮 0.4 mg IV 每 3 小时按需用于重度疼痛。1000 疼痛 8/10，呼吸 16 次/分，室内空气 SpO2 96%，镇静评分 1（清醒警觉）。给药后 1030，请将每项复评发现分类。","terminalSentenceEn":"At 1030 after the dose, classify each reassessment finding.","terminalSentenceZh":"给药后 1030，请将每项复评发现分类。","penultimateSentenceEn":"At 1000, pain is 8/10, RR 16/min, SpO2 96% on room air, and sedation score is 1 (awake and alert).","penultimateSentenceZh":"1000 疼痛 8/10，呼吸 16 次/分，室内空气 SpO2 96%，镇静评分 1（清醒警觉）。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Pain 3/10, RR 14/min, awake and talking","zh":"疼痛 3/10，呼吸 14 次/分，清醒交谈"},{"id":"r2","en":"Sedation score 3: frequently drowsy, drifts off during conversation","zh":"镇静评分 3：经常嗜睡，谈话中入睡"},{"id":"r3","en":"RR 8/min with shallow breathing","zh":"呼吸 8 次/分且浅"},{"id":"r4","en":"Reports nausea without vomiting, RR 16/min, awake","zh":"诉恶心无呕吐，呼吸 16 次/分，清醒"},{"id":"r5","en":"SpO2 88% on room air and difficult to keep awake","zh":"室内空气 SpO2 88%，难以保持清醒"}],"columns":[{"id":"c1","en":"Expected/continue monitoring","zh":"预期/继续监测"},{"id":"c2","en":"Requires immediate follow-up","zh":"需要立即跟进"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c1"]},{"rowId":"r5","columnIds":["c2"]}]},"rationaleCorrectEn":"After IV opioid administration, the nurse reassesses pain, sedation, and respiratory status. Improved pain with alertness and stable respirations is expected; increasing sedation, low respiratory rate, low oxygen saturation, or inability to stay awake requires immediate follow-up.","rationaleCorrectZh":"IV 阿片给药后，护士应复评疼痛、镇静和呼吸状态。疼痛改善且清醒、呼吸稳定为预期；镇静加重、呼吸频率低、血氧下降或无法保持清醒需要立即跟进。","testTakingStrategyEn":"Opioid safety is not just pain relief; reassess sedation and respirations after giving the medication.","testTakingStrategyZh":"阿片安全不只是缓解疼痛；给药后还要复评镇静程度和呼吸。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1553,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_or_interpreter_discharge_06","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.246","itemType":"ordered_response","category":"Management of Care","topic":"Legal & Ethical Principles","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.246.stem.en","stemPathZh":"questions.246.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[199,243],"terminalOffsetsZh":[53,67],"fullStemEn":"A client with limited English proficiency is scheduled for a procedure and discharge teaching. The adult daughter has been interpreting, but the client looks confused and has not signed the consent. Place the nurse's actions in the best order.","fullStemZh":"一名英语能力有限的患者计划接受操作并进行出院宣教。成年女儿一直在翻译，但患者看起来困惑且尚未签署知情同意。请按最佳顺序排列护士的行动。","terminalSentenceEn":"Place the nurse's actions in the best order.","terminalSentenceZh":"请按最佳顺序排列护士的行动。","penultimateSentenceEn":"The adult daughter has been interpreting, but the client looks confused and has not signed the consent.","penultimateSentenceZh":"成年女儿一直在翻译，但患者看起来困惑且尚未签署知情同意。","responseContext":{"type":"ordered_response","options":[{"id":"B","en":"Arrange a qualified medical interpreter by phone, video, or in person","zh":"安排电话、视频或现场合格医疗口译员"},{"id":"A","en":"Stop the consent signature and discharge teaching until communication is adequate","zh":"暂停同意签署和出院宣教，直到沟通充分"},{"id":"C","en":"Use the interpreter to assess the client's understanding, questions, and teach-back","zh":"通过口译员评估患者理解、问题和回示"},{"id":"D","en":"Notify the procedural team if informed consent or discharge readiness is still incomplete","zh":"如果知情同意或出院准备仍不完整，通知操作团队"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"The nurse first pauses the consent/teaching process to prevent uninformed agreement, obtains a qualified medical interpreter, reassesses understanding and questions through the interpreter, then notifies the procedural team if readiness or consent remains incomplete.","rationaleCorrectZh":"护士应先暂停同意/宣教流程以防患者在未充分知情下同意，随后取得合格医疗口译员，通过口译员重新评估理解和问题；如果准备情况或同意仍不完整，再通知操作团队。","testTakingStrategyEn":"For language barriers, protect autonomy by using a qualified interpreter before consent or critical discharge teaching.","testTakingStrategyZh":"遇到语言障碍时，应先使用合格口译员再进行同意或关键出院宣教，以保护自主权。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1554,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_fib_pediatric_ors_07","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.247","itemType":"fill_in_blank","category":"Health Promotion and Maintenance","topic":"Pediatric & Toddler Safety","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.247.stem.en","stemPathZh":"questions.247.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[142,203],"terminalOffsetsZh":[46,63],"fullStemEn":"A toddler with mild dehydration weighs 12 kg. The discharge plan states to give oral rehydration solution at 75 mL/kg over the first 4 hours. How many mL should the caregiver give over the first 4 hours?","fullStemZh":"一名轻度脱水幼儿体重 12 kg。出院计划写明前 4 小时给予口服补液盐 75 mL/kg。照护者前 4 小时应给予多少毫升？","terminalSentenceEn":"How many mL should the caregiver give over the first 4 hours?","terminalSentenceZh":"照护者前 4 小时应给予多少毫升？","penultimateSentenceEn":"The discharge plan states to give oral rehydration solution at 75 mL/kg over the first 4 hours.","penultimateSentenceZh":"出院计划写明前 4 小时给予口服补液盐 75 mL/kg。","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"mL over first 4 hours","zh":"前 4 小时毫升数"},"acceptable":["900","900 mL"],"numeric":{"value":900,"tolerance":0,"unit":"mL"}}]},"rationaleCorrectEn":"Use the formula provided in the stem: 75 mL/kg × 12 kg = 900 mL over 4 hours.","rationaleCorrectZh":"使用题干给出的公式：75 mL/kg × 12 kg = 900 mL，需在 4 小时内给予。","testTakingStrategyEn":"When a pediatric fluid formula is provided, multiply by weight and keep the time frame in mind.","testTakingStrategyZh":"儿科补液公式已给出时，用体重相乘，并注意给药时间范围。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1555,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_cloze_food_med_access_08","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.248","itemType":"dropdown_cloze","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.248.stem.en","stemPathZh":"questions.248.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[159,208],"terminalOffsetsZh":[43,55],"fullStemEn":"A client with diabetes says, 'I skip meals near the end of the month, and I cut my pills in half so they last longer.' Blood glucose logs show wide variation. The nurse is planning referrals before discharge.","fullStemZh":"一名糖尿病患者说：“月底我会少吃饭，还把药片掰半，这样能多撑几天。”血糖记录波动很大。护士正在出院前计划转介。","terminalSentenceEn":"The nurse is planning referrals before discharge.","terminalSentenceZh":"护士正在出院前计划转介。","penultimateSentenceEn":"Blood glucose logs show wide variation.","penultimateSentenceZh":"血糖记录波动很大。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse should identify {{1}} and refer the client to {{2}}.","zh":"护士应识别 {{1}}，并将患者转介给 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"food insecurity and medication-access barriers","zh":"食物不安全和药物可及性障碍"},{"id":"o3","en":"need for a high-protein diet only","zh":"仅需要高蛋白饮食"},{"id":"o2","en":"intentional refusal of all diabetes care","zh":"故意拒绝所有糖尿病护理"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"respiratory therapy for inhaler assessment","zh":"呼吸治疗师评估吸入器"},{"id":"o1","en":"social work or case management for resource linkage","zh":"社工或个案管理以连接资源"},{"id":"o3","en":"security staff for medication monitoring","zh":"保安人员监督用药"}],"correct":"o1"}]},"rationaleCorrectEn":"Food insecurity and medication cost barriers threaten safe chronic illness management. Social work/case management can connect the client with food assistance, medication-assistance options, and affordable follow-up resources.","rationaleCorrectZh":"食物不足和药物费用障碍会威胁慢性病安全管理。社工/个案管理可帮助患者连接食物援助、药物援助选择和可负担随访资源。","testTakingStrategyEn":"When a client cannot obtain food or medications, choose a resource-connection response, not a blame-based adherence response.","testTakingStrategyZh":"当患者无法获得食物或药物时，应选择连接资源的回应，而不是责备依从性。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"Blood glucose logs show wide variation.","controlSentenceZh":"血糖记录波动很大。"}
{"queueIndex":1556,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_or_contact_precautions_diarrhea_09","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.249","itemType":"ordered_response","category":"Safety and Infection Prevention and Control","topic":"Transmission-Based Precautions","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.249.stem.en","stemPathZh":"questions.249.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[174,228],"terminalOffsetsZh":[43,59],"fullStemEn":"A hospitalized client develops frequent watery diarrhea and abdominal cramping. The provider orders stool testing and contact precautions while the cause is being evaluated. Place the nurse's infection-control workflow in order.","fullStemZh":"一名住院患者出现频繁水样腹泻和腹部绞痛。医护人员在评估原因期间医嘱粪便检测和接触隔离。请按顺序排列护士的感染控制流程。","terminalSentenceEn":"Place the nurse's infection-control workflow in order.","terminalSentenceZh":"请按顺序排列护士的感染控制流程。","penultimateSentenceEn":"The provider orders stool testing and contact precautions while the cause is being evaluated.","penultimateSentenceZh":"医护人员在评估原因期间医嘱粪便检测和接触隔离。","responseContext":{"type":"ordered_response","options":[{"id":"E","en":"Perform hand hygiene and communicate cleaning needs for high-touch surfaces","zh":"手卫生，并沟通高频接触表面的清洁需求"},{"id":"A","en":"Place contact-precaution signage and gather dedicated equipment for the room","zh":"张贴接触隔离标识，并为房间准备专用设备"},{"id":"D","en":"Remove gown and gloves before leaving without contaminating clothing or hands","zh":"离开前脱隔离衣和手套，避免污染衣物或手"},{"id":"B","en":"Perform hand hygiene and don gown and gloves before entering","zh":"手卫生，并在进入前穿隔离衣、戴手套"},{"id":"C","en":"Collect the ordered stool specimen using PPE and a leak-resistant container","zh":"穿戴 PPE，使用防漏容器采集医嘱粪便标本"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"The nurse first initiates room/signage and dedicated equipment, performs hand hygiene and dons PPE before entry, collects the ordered stool specimen with PPE, removes PPE before leaving according to sequence, and then performs hand hygiene and environmental communication.","rationaleCorrectZh":"护士应先启动房间/标识和专用设备，进入前手卫生并穿戴 PPE，穿戴 PPE 时采集医嘱粪便标本，离开前按顺序脱 PPE，随后手卫生并沟通环境清洁需求。","testTakingStrategyEn":"For infection-control sequences, think: isolate and equip, protect yourself before entry, perform care, remove contamination safely, then clean hands and environment.","testTakingStrategyZh":"感染控制顺序可按：隔离并备设备、进入前保护自己、执行护理、安全脱污染物、随后清洁手和环境来思考。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1557,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_matrix_stroke_aspiration_rehab_10","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.250","itemType":"matrix","category":"Basic Care and Comfort","topic":"Mobility & Immobility","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.250.stem.en","stemPathZh":"questions.250.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[209,236],"terminalOffsetsZh":[53,62],"fullStemEn":"A client recovering from ischemic stroke has right-sided weakness, mild dysarthria, and coughing with thin liquids during breakfast. The nurse is planning rehabilitation activities and aspiration precautions. Classify each intervention.","fullStemZh":"一名缺血性卒中恢复期患者有右侧无力、轻度构音障碍，早餐喝稀液体时咳嗽。护士正在计划康复活动和误吸预防措施。请将每项干预分类。","terminalSentenceEn":"Classify each intervention.","terminalSentenceZh":"请将每项干预分类。","penultimateSentenceEn":"The nurse is planning rehabilitation activities and aspiration precautions.","penultimateSentenceZh":"护士正在计划康复活动和误吸预防措施。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Hold thin liquids and request swallow evaluation before advancing diet","zh":"暂停稀液体，并在推进饮食前申请吞咽评估"},{"id":"r2","en":"Position upright for meals and keep upright after eating as tolerated","zh":"进食时直立，进食后按耐受保持直立"},{"id":"r3","en":"Encourage independent hallway walking to build confidence","zh":"鼓励独自在走廊行走以建立信心"},{"id":"r4","en":"Coordinate transfer training with PT/OT using gait belt and stronger side","zh":"与 PT/OT 协调使用步态带和较强侧进行转移训练"},{"id":"r5","en":"Provide oral care and check for pocketing after meals","zh":"进行口腔护理并餐后检查食物滞留"}],"columns":[{"id":"c2","en":"Unsafe or premature","zh":"不安全或过早"},{"id":"c1","en":"Appropriate plan","zh":"恰当计划"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c1"]},{"rowId":"r5","columnIds":["c1"]}]},"rationaleCorrectEn":"Appropriate care includes swallow screening or speech-language pathology evaluation before oral intake is advanced, upright positioning, supervised mobility with therapy guidance, oral care, and using the stronger side in transfers. Thin liquids should not be encouraged after coughing until swallowing is evaluated.","rationaleCorrectZh":"恰当护理包括在推进口服摄入前进行吞咽筛查或言语语言病理评估、直立体位、在治疗指导下监督活动、口腔护理以及转移时利用较强侧。喝稀液体时咳嗽后，在吞咽评估前不应鼓励继续喝稀液体。","testTakingStrategyEn":"Stroke rehab balances progression with safety: mobility should advance with support, and swallowing concerns pause diet advancement.","testTakingStrategyZh":"卒中康复需要在进展和安全之间平衡：活动应在支持下推进，吞咽疑虑则暂停饮食推进。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1558,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_cloze_palliative_coping_11","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.251","itemType":"dropdown_cloze","category":"Psychosocial Integrity","topic":"Therapeutic Communication","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.251.stem.en","stemPathZh":"questions.251.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[195,249],"terminalOffsetsZh":[66,84],"fullStemEn":"A client receiving palliative care for advanced cancer reports pain 7/10 and dyspnea at rest. The spouse says, 'I am afraid morphine means we are giving up, and I do not know how to watch this.' The client is awake and asks for comfort-focused care.","fullStemZh":"一名因晚期癌症接受姑息护理的患者报告疼痛 7/10，静息时气促。配偶说：“我害怕吗啡意味着我们放弃了，我也不知道该如何看着这一切。”患者清醒，并要求以舒适为目标的护理。","terminalSentenceEn":"The client is awake and asks for comfort-focused care.","terminalSentenceZh":"患者清醒，并要求以舒适为目标的护理。","penultimateSentenceEn":"The spouse says, 'I am afraid morphine means we are giving up, and I do not know how to watch this.'","penultimateSentenceZh":"配偶说：“我害怕吗啡意味着我们放弃了，我也不知道该如何看着这一切。”","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse should prioritize {{1}} while responding to the spouse by {{2}}.","zh":"护士应优先 {{1}}，同时通过 {{2}} 回应配偶。"},"dropdowns":[{"id":"1","options":[{"id":"o3","en":"teaching that dyspnea should be ignored if oxygen saturation is normal","zh":"宣教如果血氧正常就应忽略气促"},{"id":"o2","en":"withholding opioids until the spouse agrees they are not harmful","zh":"在配偶同意阿片无害前暂停阿片"},{"id":"o1","en":"administering prescribed comfort medications for pain and dyspnea","zh":"按医嘱给予缓解疼痛和气促的舒适用药"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"telling the spouse not to discuss fear in front of the client","zh":"告诉配偶不要在患者面前谈论恐惧"},{"id":"o3","en":"promising that morphine will not cause any adverse effects","zh":"保证吗啡不会有任何不良反应"},{"id":"o1","en":"acknowledging the fear and explaining the goal of relieving suffering","zh":"承认其恐惧并解释目标是减轻痛苦"}],"correct":"o1"}]},"rationaleCorrectEn":"Palliative care prioritizes relief of distressing symptoms while supporting family coping. The nurse should treat pain and dyspnea as ordered, explain the comfort goal, and invite the spouse's fears and support needs.","rationaleCorrectZh":"姑息护理优先缓解令人痛苦的症状，同时支持家属应对。护士应按医嘱处理疼痛和气促，解释舒适目标，并了解配偶的担忧和支持需求。","testTakingStrategyEn":"Palliative questions often pair symptom relief with communication that validates family distress.","testTakingStrategyZh":"姑息护理题常将症状缓解与认可家属痛苦的沟通结合。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1559,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_fib_wound_teachback_12","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.252","itemType":"fill_in_blank","category":"Basic Care and Comfort","topic":"Skin & Wound Care","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.252.stem.en","stemPathZh":"questions.252.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[209,246],"terminalOffsetsZh":[82,99],"fullStemEn":"During a home health visit, the nurse reviews a wound-care log. Last visit, the wound measured 3.5 cm by 2.0 cm. Today it measures 4.5 cm by 2.4 cm. By how many square centimeters did the wound area increase? Round to the nearest tenth if needed.","fullStemZh":"在一次居家护理访视中，护士查看伤口护理记录。上次访视伤口测量为 3.5 cm × 2.0 cm。今天为 4.5 cm × 2.4 cm。伤口面积增加了多少平方厘米？如有需要四舍五入到最接近的十分位。","terminalSentenceEn":"Round to the nearest tenth if needed.","terminalSentenceZh":"如有需要四舍五入到最接近的十分位。","penultimateSentenceEn":"By how many square centimeters did the wound area increase?","penultimateSentenceZh":"伤口面积增加了多少平方厘米？","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"cm² increase","zh":"平方厘米增加量"},"acceptable":["3.8","3.8 cm2","3.8 cm²"],"numeric":{"value":3.8,"tolerance":0,"unit":"cm²"}}]},"rationaleCorrectEn":"Last area: 3.5 × 2.0 = 7.0 cm². Today's area: 4.5 × 2.4 = 10.8 cm². Increase: 10.8 − 7.0 = 3.8 cm².","rationaleCorrectZh":"上次面积：3.5 × 2.0 = 7.0 cm²。今天面积：4.5 × 2.4 = 10.8 cm²。增加量：10.8 − 7.0 = 3.8 cm²。","testTakingStrategyEn":"Objective wound measurements can reveal a failed home-care plan even before the client reports a problem.","testTakingStrategyZh":"客观伤口测量可在患者报告问题之前提示居家护理计划失败。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1560,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_opioid_safety_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.253","itemType":"case_study","category":"Pharmacological and Parenteral Therapies","topic":"Medication Safety & Admin","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.253.stem.en","stemPathZh":"questions.253.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,178],"terminalOffsetsZh":[0,61],"fullStemEn":"Unfolding case: IV opioid safety after surgery A postoperative older adult with sleep apnea receives PRN IV opioid medication for severe pain and then develops oversedation cues.","fullStemZh":"展开病例：术后静脉阿片类药物安全 一名有睡眠呼吸暂停的术后老年患者因重度疼痛接受按需静脉阿片类药物，随后出现过度镇静线索。","terminalSentenceEn":"Unfolding case: IV opioid safety after surgery A postoperative older adult with sleep apnea receives PRN IV opioid medication for severe pain and then develops oversedation cues.","terminalSentenceZh":"展开病例：术后静脉阿片类药物安全 一名有睡眠呼吸暂停的术后老年患者因重度疼痛接受按需静脉阿片类药物，随后出现过度镇静线索。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"The case emphasizes balancing pain control with respiratory safety: assess baseline risk, reassess after IV opioids, respond to oversedation promptly, teach PCA safety, and apply the stated reassessment interval.","rationaleCorrectZh":"本病例强调在镇痛和呼吸安全之间取得平衡：评估基础风险、静脉使用阿片类后复查、及时处理过度镇静、宣教 PCA 安全，并应用题干给出的复查间隔。","testTakingStrategyEn":"When pain medicine helps pain but worsens breathing or alertness, prioritize airway and breathing over additional analgesia.","testTakingStrategyZh":"当止痛药缓解疼痛但使呼吸或清醒程度恶化时，应优先处理气道和呼吸，而不是继续加药。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1561,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_opioid_safety_01","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_opioid_safety_01_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.253.caseStudy.questions.0","itemType":"matrix","category":"Reduction of Risk Potential","topic":"Perioperative Care","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.253.caseStudy.questions.0.stem.en","stemPathZh":"questions.253.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,148],"terminalOffsetsZh":[0,43],"fullStemEn":"Using Stage 1 data, classify each finding as increasing risk for opioid-related respiratory depression or supporting safe PRN opioid administration.","fullStemZh":"根据第 1 阶段资料，将每项发现分类为增加阿片类相关呼吸抑制风险，或支持安全按需给药。","terminalSentenceEn":"Using Stage 1 data, classify each finding as increasing risk for opioid-related respiratory depression or supporting safe PRN opioid administration.","terminalSentenceZh":"根据第 1 阶段资料，将每项发现分类为增加阿片类相关呼吸抑制风险，或支持安全按需给药。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Opioid-naive older adult","zh":"未长期使用阿片类药物的老年患者"},{"id":"r2","en":"History of obstructive sleep apnea","zh":"有阻塞性睡眠呼吸暂停病史"},{"id":"r3","en":"Respiratory rate 16/min and sedation score 1","zh":"呼吸频率 16 次/分且镇静评分 1"},{"id":"r4","en":"Pain 8/10 with guarding during turning","zh":"翻身时保护动作且疼痛 8/10"},{"id":"r5","en":"CPAP available at bedside","zh":"CPAP 在床旁可用"}],"columns":[{"id":"c1","en":"Increases respiratory-depression risk","zh":"增加呼吸抑制风险"},{"id":"c2","en":"Supports safe administration with monitoring","zh":"在监测下支持安全给药"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c2"]},{"rowId":"r5","columnIds":["c2"]}]},"rationaleCorrectEn":"Opioid-naive status and sleep apnea increase risk, while an acceptable baseline respiratory rate, alert sedation score, severe pain report, and available CPAP support giving the ordered PRN opioid with close reassessment.","rationaleCorrectZh":"未长期使用阿片类药物和睡眠呼吸暂停会增加风险；基础呼吸频率可接受、镇静评分清醒、重度疼痛以及 CPAP 可用，支持在密切复评下给予按需阿片类药物。","testTakingStrategyEn":"Separate risk factors from current instability; risk calls for closer monitoring, while instability calls for holding and escalating.","testTakingStrategyZh":"区分风险因素和当前不稳定。风险提示加强监测；不稳定则需要暂停并升级处理。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1562,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_opioid_safety_01","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_opioid_safety_01_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.253.caseStudy.questions.1","itemType":"dropdown_cloze","category":"Pharmacological and Parenteral Therapies","topic":"Medication Safety & Admin","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.253.caseStudy.questions.1.stem.en","stemPathZh":"questions.253.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,70],"terminalOffsetsZh":[0,26],"fullStemEn":"Stage 2 describes the client's condition 30 minutes after IV morphine.","fullStemZh":"第 2 阶段描述静脉给吗啡 30 分钟后的患者情况。","terminalSentenceEn":"Stage 2 describes the client's condition 30 minutes after IV morphine.","terminalSentenceZh":"第 2 阶段描述静脉给吗啡 30 分钟后的患者情况。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse should interpret the findings as {{1}} and should {{2}}.","zh":"护士应将这些发现判断为 {{1}}，并应 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o2","en":"possible opioid-related oversedation and hypoventilation","zh":"可能为阿片类相关过度镇静和低通气"},{"id":"o3","en":"acute withdrawal from inadequate analgesia","zh":"镇痛不足导致急性戒断"},{"id":"o1","en":"expected pain relief only","zh":"仅为预期镇痛效果"}],"correct":"o2"},{"id":"2","options":[{"id":"o1","en":"hold additional opioid doses and stimulate the client while initiating ordered oxygen and escalation","zh":"暂停追加阿片类药物，刺激患者，同时开始医嘱氧疗并升级处理"},{"id":"o3","en":"give the next PRN dose early because pain remains 4/10","zh":"因疼痛仍为 4/10 而提前给予下一次 PRN 剂量"},{"id":"o2","en":"allow the client to sleep because pain improved","zh":"因疼痛改善而让患者继续睡眠"}],"correct":"o1"}]},"rationaleCorrectEn":"A respiratory rate of 10/min, oxygen saturation of 90%, and sedation score 3 after IV opioid indicate oversedation and hypoventilation requiring holding further opioids, stimulation, oxygen per order, and escalation.","rationaleCorrectZh":"静脉使用阿片类后呼吸频率 10 次/分、氧饱和度 90%、镇静评分 3，提示过度镇静和低通气，需要暂停继续使用阿片类、刺激患者、按医嘱给氧并升级处理。","testTakingStrategyEn":"After IV opioids, compare pain relief with respiratory and sedation findings; improved pain does not override respiratory compromise.","testTakingStrategyZh":"静脉使用阿片类后，要同时比较镇痛效果、呼吸和镇静情况；疼痛改善不能掩盖呼吸受损。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1563,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_opioid_safety_01","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_opioid_safety_01_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.253.caseStudy.questions.2","itemType":"ordered_response","category":"Reduction of Risk Potential","topic":"Perioperative Care","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.253.caseStudy.questions.2.stem.en","stemPathZh":"questions.253.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,70],"terminalOffsetsZh":[0,24],"fullStemEn":"Place the nursing actions for the Stage 2 change in the correct order.","fullStemZh":"将针对第 2 阶段变化的护理行动按正确顺序排列。","terminalSentenceEn":"Place the nursing actions for the Stage 2 change in the correct order.","terminalSentenceZh":"将针对第 2 阶段变化的护理行动按正确顺序排列。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"ordered_response","options":[{"id":"B","en":"Stop additional opioid administration and call for immediate assistance.","zh":"停止追加阿片类药物并立即呼叫协助。"},{"id":"E","en":"Document the reassessment findings and the client's response after stabilization.","zh":"病情稳定后记录复评结果和患者反应。"},{"id":"A","en":"Stimulate the client, raise the head of the bed, and assess airway and breathing.","zh":"刺激患者，抬高床头，并评估气道和呼吸。"},{"id":"D","en":"Notify the provider or rapid-response resource and prepare naloxone if prescribed or protocol-directed.","zh":"通知医护提供者或快速反应资源，并在有医嘱或流程要求时准备纳洛酮。"},{"id":"C","en":"Apply oxygen as ordered and attach continuous pulse oximetry.","zh":"按医嘱给氧并连接连续脉搏血氧监测。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"The sequence starts with immediate airway/breathing support and stopping further opioid exposure, then oxygen and monitoring, escalation and possible reversal, and documentation after the client is stabilized.","rationaleCorrectZh":"顺序应从立即支持气道/呼吸和停止继续使用阿片类开始，然后给氧和监测，升级处理并可能使用拮抗剂，最后在患者稳定后记录。","testTakingStrategyEn":"For medication-related respiratory compromise, stabilize breathing before paperwork or routine education.","testTakingStrategyZh":"遇到药物相关呼吸受损时，先稳定呼吸，再做文书或常规宣教。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1564,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_opioid_safety_01","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_opioid_safety_01_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.253.caseStudy.questions.3","itemType":"select_all","category":"Pharmacological and Parenteral Therapies","topic":"Medication Safety & Admin","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.253.caseStudy.questions.3.stem.en","stemPathZh":"questions.253.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[122,144],"terminalOffsetsZh":[29,37],"fullStemEn":"The adult child asks about pressing a pain-control button for the client. Which teaching points should the nurse include? Select all that apply.","fullStemZh":"成年子女询问是否可以替患者按止痛按钮。护士应包括哪些宣教？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which teaching points should the nurse include?","penultimateSentenceZh":"护士应包括哪些宣教？","responseContext":{"type":"select_all","options":[{"id":"E","en":"A lower pain score means sedation and breathing no longer need monitoring.","zh":"疼痛评分降低表示不再需要监测镇静和呼吸。"},{"id":"A","en":"Only the client should press a patient-controlled analgesia button when awake enough to do so.","zh":"只有患者本人在足够清醒时才应按患者自控镇痛按钮。"},{"id":"C","en":"Call the nurse if the client becomes hard to wake, breathes slowly, or snores unusually.","zh":"如果患者难以叫醒、呼吸变慢或打鼾异常，应呼叫护士。"},{"id":"B","en":"Family members may press the button while the client sleeps to prevent pain.","zh":"家属可在患者睡觉时按按钮以预防疼痛。"},{"id":"D","en":"Use repositioning, splinting, ice if ordered, and relaxation along with medication.","zh":"配合药物使用体位调整、支托、按医嘱冰敷和放松技巧。"}],"correct":["A","C","D"]},"rationaleCorrectEn":"PCA safety requires that only the alert client activates dosing; family should report oversedation signs and support nonpharmacologic pain relief. Pain improvement does not eliminate respiratory monitoring.","rationaleCorrectZh":"PCA 安全要求只有清醒的患者本人触发给药；家属应报告过度镇静迹象，并支持非药物镇痛。疼痛改善并不取消呼吸监测。","testTakingStrategyEn":"For PCA questions, protect the lockout concept: the client must be awake enough to press the button personally.","testTakingStrategyZh":"遇到 PCA 题，抓住安全锁定概念：患者必须足够清醒并亲自按压。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1565,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_opioid_safety_01","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_opioid_safety_01_q5","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.253.caseStudy.questions.4","itemType":"fill_in_blank","category":"Reduction of Risk Potential","topic":"Perioperative Care","difficulty":"easy","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.253.caseStudy.questions.4.stem.en","stemPathZh":"questions.253.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[211,228],"terminalOffsetsZh":[76,88],"fullStemEn":"Unit protocol in Stage 3 requires respiratory rate and sedation reassessment 15 minutes after each IV opioid dose. If an IV opioid dose is given at 1110, at what time should the nurse complete the reassessment? Use 24-hour time.","fullStemZh":"第 3 阶段的科室流程要求每次静脉使用阿片类药物后 15 分钟复查呼吸频率和镇静情况。如果 1110 给予一次静脉阿片类药物，护士应在什么时间完成复查？请使用 24 小时时间。","terminalSentenceEn":"Use 24-hour time.","terminalSentenceZh":"请使用 24 小时时间。","penultimateSentenceEn":"If an IV opioid dose is given at 1110, at what time should the nurse complete the reassessment?","penultimateSentenceZh":"如果 1110 给予一次静脉阿片类药物，护士应在什么时间完成复查？","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"reassessment time","zh":"复查时间"},"acceptable":["1125","11:25","1125 hours","11:25 AM"],"numeric":{"value":1125,"tolerance":0,"unit":"time"}}]},"rationaleCorrectEn":"1110 plus 15 minutes equals 1125.","rationaleCorrectZh":"1110 加 15 分钟等于 1125。","testTakingStrategyEn":"When a timing rule is supplied in the stem, use that rule rather than memorizing a facility-specific policy.","testTakingStrategyZh":"题干给出时间规则时，应使用该规则，而不是依赖某个机构政策记忆。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":true,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1566,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_interpreter_consent_02","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.254","itemType":"case_study","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.254.stem.en","stemPathZh":"questions.254.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,188],"terminalOffsetsZh":[0,52],"fullStemEn":"Unfolding case: language access and safe discharge A Mandarin-speaking client with limited English needs informed consent and safe discharge teaching around a sedated outpatient procedure.","fullStemZh":"展开病例：语言服务与安全出院 一名英语有限、讲普通话的患者在门诊镇静操作前后需要知情同意和安全出院宣教。","terminalSentenceEn":"Unfolding case: language access and safe discharge A Mandarin-speaking client with limited English needs informed consent and safe discharge teaching around a sedated outpatient procedure.","terminalSentenceZh":"展开病例：语言服务与安全出院 一名英语有限、讲普通话的患者在门诊镇静操作前后需要知情同意和安全出院宣教。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"The case focuses on using certified interpretation for consent, recognizing failed teach-back, delaying unsafe discharge, and resolving language and supervision barriers.","rationaleCorrectZh":"本病例重点是使用认证口译完成知情同意、识别回示失败、延迟不安全出院，并解决语言和监督障碍。","testTakingStrategyEn":"When communication barriers affect consent or discharge, choose language access plus teach-back rather than family-only translation.","testTakingStrategyZh":"当沟通障碍影响同意或出院时，应选择语言服务加回示法，而不是仅靠家属翻译。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1567,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_interpreter_consent_02","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_interpreter_consent_02_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.254.caseStudy.questions.0","itemType":"multiple_choice","category":"Management of Care","topic":"Legal & Ethical Principles","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.254.caseStudy.questions.0.stem.en","stemPathZh":"questions.254.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,91],"terminalOffsetsZh":[0,30],"fullStemEn":"Based on Stage 1, what is the nurse's best action before the client signs the consent form?","fullStemZh":"根据第 1 阶段，在患者签署同意书前，护士的最佳行动是什么？","terminalSentenceEn":"Based on Stage 1, what is the nurse's best action before the client signs the consent form?","terminalSentenceZh":"根据第 1 阶段，在患者签署同意书前，护士的最佳行动是什么？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Ask the daughter to translate because she is present and willing.","zh":"请女儿翻译，因为她在场且愿意。"},{"id":"B","en":"Obtain a certified medical interpreter and notify the provider that the consent discussion must occur in the client's language.","zh":"安排认证医疗口译员，并通知提供者必须用患者语言进行知情同意讨论。"},{"id":"D","en":"Document refusal of consent because the client cannot answer in English.","zh":"记录拒绝同意，因为患者无法用英语回答。"},{"id":"C","en":"Have the client sign because nodding indicates agreement.","zh":"让患者签字，因为点头表示同意。"}],"correct":["B"]},"rationaleCorrectEn":"Informed consent requires meaningful communication with the provider using language access services. A family member should not replace a certified interpreter for consent when accurate, unbiased interpretation is needed.","rationaleCorrectZh":"知情同意需要提供者借助语言服务与患者进行有意义沟通。需要准确、客观口译时，家属不应替代认证口译员完成同意讨论。","testTakingStrategyEn":"When language barriers affect consent, choose certified interpretation and provider explanation before signing.","testTakingStrategyZh":"语言障碍影响同意时，应先选择认证口译和提供者解释，再签署。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1568,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_interpreter_consent_02","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_interpreter_consent_02_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.254.caseStudy.questions.1","itemType":"matrix","category":"Reduction of Risk Potential","topic":"Perioperative Care","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.254.caseStudy.questions.1.stem.en","stemPathZh":"questions.254.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,116],"terminalOffsetsZh":[0,37],"fullStemEn":"Using Stage 2 data, classify each finding as supporting discharge readiness or requiring follow-up before discharge.","fullStemZh":"根据第 2 阶段资料，将每项发现分类为支持出院准备就绪，或出院前需要跟进。","terminalSentenceEn":"Using Stage 2 data, classify each finding as supporting discharge readiness or requiring follow-up before discharge.","terminalSentenceZh":"根据第 2 阶段资料，将每项发现分类为支持出院准备就绪，或出院前需要跟进。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Written instructions are available only in English.","zh":"书面说明只有英文版。"},{"id":"r2","en":"Client correctly uses a phone interpreter for the teach-back question.","zh":"患者通过电话口译员参与回示问题。"},{"id":"r3","en":"Client says to take extra aspirin for heavy bleeding.","zh":"患者说大量出血时多吃阿司匹林。"},{"id":"r4","en":"No responsible adult is confirmed to stay tonight.","zh":"尚未确认今晚有负责成人陪伴。"},{"id":"r5","en":"Client is alert but drowsy after moderate sedation.","zh":"中度镇静后患者清醒但嗜睡。"}],"columns":[{"id":"c2","en":"Requires follow-up before discharge","zh":"出院前需要跟进"},{"id":"c1","en":"Supports discharge readiness","zh":"支持出院准备就绪"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c1"]},{"rowId":"r5","columnIds":["c1"]}]},"rationaleCorrectEn":"Interpreter use supports communication, but untranslated instructions, unsafe teach-back, lack of a responsible adult, and post-sedation drowsiness require follow-up before discharge.","rationaleCorrectZh":"使用口译员有助于沟通；但未翻译的说明、不安全回示、缺少负责成人陪伴以及镇静后嗜睡，都需要在出院前跟进。","testTakingStrategyEn":"Discharge readiness requires safe teach-back and a safe home plan, not just completion of a procedure.","testTakingStrategyZh":"出院准备就绪需要安全回示和安全居家计划，而不只是操作完成。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1569,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_interpreter_consent_02","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_interpreter_consent_02_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.254.caseStudy.questions.2","itemType":"dropdown_cloze","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"medium","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.254.caseStudy.questions.2.stem.en","stemPathZh":"questions.254.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,61],"terminalOffsetsZh":[0,19],"fullStemEn":"Stage 2 includes a failed teach-back response after sedation.","fullStemZh":"第 2 阶段包含镇静后的失败回示反应。","terminalSentenceEn":"Stage 2 includes a failed teach-back response after sedation.","terminalSentenceZh":"第 2 阶段包含镇静后的失败回示反应。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The discharge delay is primarily due to {{1}}, and the nurse should first coordinate {{2}}.","zh":"出院延迟主要是因为 {{1}}，护士首先应协调 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"a safety and comprehension barrier","zh":"安全与理解障碍"},{"id":"o3","en":"a need for physician diagnosis selection","zh":"需要选择医生诊断"},{"id":"o2","en":"a routine preference for paper instructions","zh":"对纸质说明的常规偏好"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"interpreter-supported re-teaching and responsible-adult discharge planning","zh":"口译支持下重新宣教并安排负责成人陪伴的出院计划"},{"id":"o3","en":"a billing consultation before any clinical teaching","zh":"任何临床宣教前先进行账单咨询"},{"id":"o2","en":"immediate discharge with daughter-only translation","zh":"仅由女儿翻译后立即出院"}],"correct":"o1"}]},"rationaleCorrectEn":"The unsafe bleeding response and lack of an adult escort are discharge-safety barriers. The nurse should coordinate interpreter-supported re-teaching and a safe discharge plan.","rationaleCorrectZh":"对出血的不安全回答和缺少成人陪伴是出院安全障碍。护士应协调口译支持下重新宣教，并制定安全出院计划。","testTakingStrategyEn":"When teach-back fails, treat it as data requiring re-teaching and barrier resolution.","testTakingStrategyZh":"回示失败时，应把它视为需要重新宣教和解决障碍的数据。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1570,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_interpreter_consent_02","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_interpreter_consent_02_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.254.caseStudy.questions.3","itemType":"ordered_response","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.254.caseStudy.questions.3.stem.en","stemPathZh":"questions.254.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,81],"terminalOffsetsZh":[0,26],"fullStemEn":"Place the nurse's actions for the Stage 2 discharge barrier in the correct order.","fullStemZh":"将护士处理第 2 阶段出院障碍的行动按正确顺序排列。","terminalSentenceEn":"Place the nurse's actions for the Stage 2 discharge barrier in the correct order.","terminalSentenceZh":"将护士处理第 2 阶段出院障碍的行动按正确顺序排列。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"ordered_response","options":[{"id":"D","en":"Coordinate translated instructions and a responsible adult escort or overnight support.","zh":"协调翻译后的说明以及负责成人接送或夜间陪伴。"},{"id":"B","en":"Use a certified interpreter to clarify the client's understanding and specific learning gaps.","zh":"使用认证口译员澄清患者理解情况和具体学习缺口。"},{"id":"C","en":"Notify the provider or charge nurse that discharge criteria are not yet met.","zh":"通知提供者或 charge nurse，说明尚未达到出院条件。"},{"id":"E","en":"Document the failed teach-back, actions taken, revised teaching, and final safe plan.","zh":"记录回示失败、已采取行动、修订宣教和最终安全计划。"},{"id":"A","en":"Pause discharge and maintain supervision because the client is post-sedation and teach-back is unsafe.","zh":"暂停出院并保持监督，因为患者处于镇静后状态且回示不安全。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"The nurse first prevents an unsafe discharge, then clarifies the gap with an interpreter, escalates that criteria are unmet, coordinates resources, and documents the outcome.","rationaleCorrectZh":"护士首先防止不安全出院，然后用口译员澄清缺口，升级说明未达出院条件，协调资源，最后记录结果。","testTakingStrategyEn":"A discharge barrier sequence should first stop the unsafe transition, then identify and fix the barrier.","testTakingStrategyZh":"出院障碍处理顺序应先停止不安全过渡，再识别并解决障碍。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1571,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_interpreter_consent_02","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_interpreter_consent_02_q5","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.254.caseStudy.questions.4","itemType":"matrix","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.254.caseStudy.questions.4.stem.en","stemPathZh":"questions.254.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,105],"terminalOffsetsZh":[0,33],"fullStemEn":"After Stage 3 teaching, classify each client statement as showing understanding or needing more teaching.","fullStemZh":"第 3 阶段宣教后，将每句患者陈述分类为显示理解或需要进一步宣教。","terminalSentenceEn":"After Stage 3 teaching, classify each client statement as showing understanding or needing more teaching.","terminalSentenceZh":"第 3 阶段宣教后，将每句患者陈述分类为显示理解或需要进一步宣教。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"I will call for help if I have heavy bleeding or trouble breathing.","zh":"如果我大量出血或呼吸困难，我会求助。"},{"id":"r2","en":"I can drive myself tomorrow morning if I feel fully awake.","zh":"如果我明早觉得完全清醒，就可以自己开车。"},{"id":"r3","en":"I should not drink alcohol or take sedatives tonight.","zh":"今晚我不应饮酒或服用镇静药。"},{"id":"r4","en":"The translated paper tells me when to call the clinic.","zh":"翻译后的纸质说明告诉我何时联系诊所。"}],"columns":[{"id":"c1","en":"Shows understanding","zh":"显示理解"},{"id":"c2","en":"Needs more teaching","zh":"需要进一步宣教"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c1"]}]},"rationaleCorrectEn":"Warning-sign reporting, avoiding alcohol/sedatives, and using translated instructions show understanding. Driving after recent sedation requires following the discharge restriction, not self-clearance based on feeling awake.","rationaleCorrectZh":"能报告警示症状、避免酒精/镇静药并使用翻译说明，表示理解。近期镇静后能否开车应遵循出院限制，而不能仅凭自觉清醒自行决定。","testTakingStrategyEn":"Evaluate discharge teaching by the client's own words, not by nodding or family reassurance.","testTakingStrategyZh":"评估出院宣教应依据患者自己的表述，而不是点头或家属保证。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1572,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_peds_dehydration_03","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.255","itemType":"case_study","category":"Health Promotion and Maintenance","topic":"Pediatric & Adolescent Health","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.255.stem.en","stemPathZh":"questions.255.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,178],"terminalOffsetsZh":[0,47],"fullStemEn":"Unfolding case: pediatric oral rehydration A toddler with vomiting and diarrhea is assessed for dehydration and the parent needs oral rehydration teaching and return precautions.","fullStemZh":"展开病例：儿童口服补液 一名幼儿出现呕吐和腹泻，需要评估脱水，家长需要口服补液宣教和返诊警示。","terminalSentenceEn":"Unfolding case: pediatric oral rehydration A toddler with vomiting and diarrhea is assessed for dehydration and the parent needs oral rehydration teaching and return precautions.","terminalSentenceZh":"展开病例：儿童口服补液 一名幼儿出现呕吐和腹泻，需要评估脱水，家长需要口服补液宣教和返诊警示。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"The case emphasizes recognizing dehydration severity cues, calculating a protocol-defined ORS volume, teaching small frequent ORS after vomiting, and identifying urgent return precautions.","rationaleCorrectZh":"本病例强调识别脱水严重程度线索、计算流程规定的口服补液盐总量、宣教呕吐后少量多次补液，并识别紧急返诊警示。","testTakingStrategyEn":"For pediatric dehydration, first decide whether the child has red flags; if not, focus on clear oral rehydration instructions.","testTakingStrategyZh":"儿童脱水题先判断是否有危险信号；若没有，则重点提供清楚的口服补液指导。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1573,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_peds_dehydration_03","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_peds_dehydration_03_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.255.caseStudy.questions.0","itemType":"matrix","category":"Reduction of Risk Potential","topic":"Laboratory & Diagnostic Tests","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.255.caseStudy.questions.0.stem.en","stemPathZh":"questions.255.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,153],"terminalOffsetsZh":[0,48],"fullStemEn":"Using Stage 1 data, classify each cue as consistent with mild/moderate dehydration suitable for oral rehydration teaching or requiring urgent escalation.","fullStemZh":"根据第 1 阶段资料，将每项线索分类为符合可进行口服补液宣教的轻/中度脱水，或需要紧急升级处理。","terminalSentenceEn":"Using Stage 1 data, classify each cue as consistent with mild/moderate dehydration suitable for oral rehydration teaching or requiring urgent escalation.","terminalSentenceZh":"根据第 1 阶段资料，将每项线索分类为符合可进行口服补液宣教的轻/中度脱水，或需要紧急升级处理。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Alert and interested in a toy","zh":"清醒且对玩具感兴趣"},{"id":"r2","en":"One wet diaper in 6 hours","zh":"6 小时内 1 次湿尿布"},{"id":"r3","en":"No tears when crying","zh":"哭时无泪"},{"id":"r4","en":"Bilious vomiting","zh":"胆汁性呕吐"},{"id":"r5","en":"Mildly dry mucous membranes","zh":"黏膜轻度干燥"}],"columns":[{"id":"c1","en":"Consistent with oral rehydration teaching","zh":"符合口服补液宣教"},{"id":"c2","en":"Requires urgent escalation","zh":"需要紧急升级处理"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c2"]},{"rowId":"r5","columnIds":["c1"]}]},"rationaleCorrectEn":"Alert behavior, some urine output, and mild dryness fit oral rehydration teaching. No tears and bilious vomiting are more concerning cues that require escalation.","rationaleCorrectZh":"清醒、有一定尿量和轻度干燥符合口服补液宣教。哭时无泪和胆汁性呕吐是更令人担忧的线索，需要升级处理。","testTakingStrategyEn":"Look for red flags that move a dehydration item from teaching to urgent evaluation.","testTakingStrategyZh":"寻找把脱水题从宣教转为紧急评估的危险信号。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1574,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_peds_dehydration_03","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_peds_dehydration_03_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.255.caseStudy.questions.1","itemType":"fill_in_blank","category":"Health Promotion and Maintenance","topic":"Pediatric & Adolescent Health","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.255.caseStudy.questions.1.stem.en","stemPathZh":"questions.255.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[120,188],"terminalOffsetsZh":[45,65],"fullStemEn":"The clinic protocol in the baseline note is 75 mL/kg of oral rehydration solution over 4 hours. The child weighs 11 kg. How many mL should the nurse teach the parent to offer over 4 hours?","fullStemZh":"基础记录中的门诊流程为 4 小时内给予口服补液盐 75 mL/kg。患儿体重 11 kg。护士应教家长 4 小时内给予多少 mL？","terminalSentenceEn":"How many mL should the nurse teach the parent to offer over 4 hours?","terminalSentenceZh":"护士应教家长 4 小时内给予多少 mL？","penultimateSentenceEn":"The child weighs 11 kg.","penultimateSentenceZh":"患儿体重 11 kg。","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"mL over 4 hours","zh":"4 小时总毫升数"},"acceptable":["825","825 mL"],"numeric":{"value":825,"tolerance":0,"unit":"mL"}}]},"rationaleCorrectEn":"75 mL/kg × 11 kg = 825 mL over 4 hours.","rationaleCorrectZh":"75 mL/kg × 11 kg = 4 小时 825 mL。","testTakingStrategyEn":"For pediatric fluid calculations, write the formula with units before multiplying.","testTakingStrategyZh":"儿童补液计算应先写出带单位的公式，再相乘。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1575,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_peds_dehydration_03","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_peds_dehydration_03_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.255.caseStudy.questions.2","itemType":"dropdown_cloze","category":"Health Promotion and Maintenance","topic":"Pediatric & Adolescent Health","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.255.caseStudy.questions.2.stem.en","stemPathZh":"questions.255.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,64],"terminalOffsetsZh":[0,22],"fullStemEn":"Stage 2 describes vomiting after a large amount of sports drink.","fullStemZh":"第 2 阶段描述一次大量饮用运动饮料后呕吐。","terminalSentenceEn":"Stage 2 describes vomiting after a large amount of sports drink.","terminalSentenceZh":"第 2 阶段描述一次大量饮用运动饮料后呕吐。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse should teach the parent to use {{1}} and give it {{2}}.","zh":"护士应教家长使用 {{1}}，并 {{2}} 给予。"},"dropdowns":[{"id":"1","options":[{"id":"o2","en":"undiluted fruit juice","zh":"未稀释果汁"},{"id":"o3","en":"only plain water for the rest of the day","zh":"当天剩余时间只喝白水"},{"id":"o1","en":"oral rehydration solution","zh":"口服补液盐"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"as one full cup every hour to finish quickly","zh":"每小时一整杯以尽快完成"},{"id":"o3","en":"only after 24 hours without vomiting","zh":"仅在 24 小时不再呕吐后给予"},{"id":"o1","en":"in small frequent amounts, such as 5 to 10 mL every few minutes after a brief pause","zh":"短暂停顿后少量多次给予，例如每隔几分钟 5–10 mL"}],"correct":"o1"}]},"rationaleCorrectEn":"Oral rehydration solution is preferred because it has appropriate electrolytes and glucose. Small frequent amounts are better tolerated after vomiting than large boluses or withholding fluids for a full day.","rationaleCorrectZh":"口服补液盐含适当电解质和葡萄糖，因此优先使用。呕吐后少量多次比一次大量或整天禁液更容易耐受。","testTakingStrategyEn":"If vomiting occurs during ORS, reduce the amount per offer rather than stopping all fluids.","testTakingStrategyZh":"口服补液过程中呕吐时，应减少每次给予量，而不是停止所有液体。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1576,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_peds_dehydration_03","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_peds_dehydration_03_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.255.caseStudy.questions.3","itemType":"ordered_response","category":"Health Promotion and Maintenance","topic":"Pediatric & Adolescent Health","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.255.caseStudy.questions.3.stem.en","stemPathZh":"questions.255.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,102],"terminalOffsetsZh":[0,28],"fullStemEn":"Place the home oral rehydration steps in the order the nurse should teach after the child vomits once.","fullStemZh":"将患儿呕吐一次后护士应宣教的居家口服补液步骤按顺序排列。","terminalSentenceEn":"Place the home oral rehydration steps in the order the nurse should teach after the child vomits once.","terminalSentenceZh":"将患儿呕吐一次后护士应宣教的居家口服补液步骤按顺序排列。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"ordered_response","options":[{"id":"A","en":"Pause fluids briefly and keep the child upright or positioned safely.","zh":"短暂停止液体，并让患儿保持直立或安全体位。"},{"id":"C","en":"Increase the amount gradually as vomiting decreases.","zh":"呕吐减少后逐渐增加每次给予量。"},{"id":"E","en":"Seek care if red-flag symptoms or inability to keep down fluids develops.","zh":"如出现危险信号或无法保留液体，应就医。"},{"id":"B","en":"Restart oral rehydration solution in very small amounts.","zh":"重新以很少量给予口服补液盐。"},{"id":"D","en":"Resume age-appropriate foods as tolerated while continuing fluids.","zh":"在耐受情况下恢复适龄食物，同时继续补液。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"After vomiting, the parent should pause briefly, restart ORS in small amounts, increase as tolerated, resume appropriate foods, and seek care for red flags or failed oral intake.","rationaleCorrectZh":"呕吐后应短暂停顿，再以少量重启口服补液，按耐受逐渐增加，恢复适当食物，并在危险信号或无法口服时就医。","testTakingStrategyEn":"Teaching sequences often move from immediate tolerance, to gradual progression, to clear return precautions.","testTakingStrategyZh":"宣教顺序常从立即耐受处理，到逐渐推进，再到明确返诊警示。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1577,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_peds_dehydration_03","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_peds_dehydration_03_q5","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.255.caseStudy.questions.4","itemType":"select_all","category":"Health Promotion and Maintenance","topic":"Pediatric & Adolescent Health","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.255.caseStudy.questions.4.stem.en","stemPathZh":"questions.255.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[102,124],"terminalOffsetsZh":[31,39],"fullStemEn":"Which parent statements from Stage 3 require the nurse to tell the parent to call or return urgently? Select all that apply.","fullStemZh":"第 3 阶段中，哪些家长陈述需要护士告知其应打电话或紧急返回？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which parent statements from Stage 3 require the nurse to tell the parent to call or return urgently?","penultimateSentenceZh":"第 3 阶段中，哪些家长陈述需要护士告知其应打电话或紧急返回？","responseContext":{"type":"select_all","options":[{"id":"D","en":"There is blood in the stool.","zh":"大便里有血。"},{"id":"C","en":"His vomit is green.","zh":"他的呕吐物是绿色的。"},{"id":"A","en":"He has no wet diaper for 8 hours.","zh":"他 8 小时没有湿尿布。"},{"id":"B","en":"He is playful after small sips.","zh":"少量喝水后他能玩耍。"},{"id":"E","en":"He wants bland food and keeps it down.","zh":"他想吃清淡食物且能保留。"}],"correct":["A","C","D"]},"rationaleCorrectEn":"No urine for a prolonged period, green/bilious vomiting, and bloody stool are red flags. Playfulness and tolerating food are reassuring signs.","rationaleCorrectZh":"长时间无尿、绿色/胆汁性呕吐和血便是危险信号。能玩耍并能耐受食物是较令人放心的表现。","testTakingStrategyEn":"Return-precaution options should distinguish worsening hydration or red flags from expected recovery signs.","testTakingStrategyZh":"返诊警示题要区分脱水恶化/危险信号和预期恢复表现。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1578,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_wound_teachback_04","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.256","itemType":"case_study","category":"Reduction of Risk Potential","topic":"Skin & Wound Care","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.256.stem.en","stemPathZh":"questions.256.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,191],"terminalOffsetsZh":[0,55],"fullStemEn":"Unfolding case: home wound care and teach-back A client with diabetes and a foot ulcer receives home health teaching, but the caregiver initially demonstrates unsafe wound-care understanding.","fullStemZh":"展开病例：居家伤口护理与回示 一名糖尿病足部溃疡患者接受居家护理宣教，但照护者最初显示出不安全的伤口护理理解。","terminalSentenceEn":"Unfolding case: home wound care and teach-back A client with diabetes and a foot ulcer receives home health teaching, but the caregiver initially demonstrates unsafe wound-care understanding.","terminalSentenceZh":"展开病例：居家伤口护理与回示 一名糖尿病足部溃疡患者接受居家护理宣教，但照护者最初显示出不安全的伤口护理理解。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"The case emphasizes safe home setup, recognition of infection cues, use of teach-back and return demonstration, offloading and glucose-management barriers, and wound measurement trend evaluation.","rationaleCorrectZh":"本病例强调安全居家操作环境、识别感染线索、使用回示法和操作回示、处理减压与血糖管理障碍，以及评估伤口测量趋势。","testTakingStrategyEn":"In home care, a caregiver's incorrect demonstration is a cue to re-teach and verify, not a reason to assume noncompliance.","testTakingStrategyZh":"在居家护理中，照护者错误示范提示需要重新宣教并确认，而不是简单认定不依从。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1579,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_wound_teachback_04","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_wound_teachback_04_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.256.caseStudy.questions.0","itemType":"matrix","category":"Safety and Infection Prevention and Control","topic":"Skin & Wound Care","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.256.caseStudy.questions.0.stem.en","stemPathZh":"questions.256.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,98],"terminalOffsetsZh":[0,33],"fullStemEn":"Using Stage 1 data, classify each observation as safe wound-care practice or requiring correction.","fullStemZh":"根据第 1 阶段资料，将每项观察分类为安全伤口护理做法或需要纠正。","terminalSentenceEn":"Using Stage 1 data, classify each observation as safe wound-care practice or requiring correction.","terminalSentenceZh":"根据第 1 阶段资料，将每项观察分类为安全伤口护理做法或需要纠正。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Opening sterile gauze before hand hygiene","zh":"未进行手卫生就打开无菌纱布"},{"id":"r2","en":"Keeping dressing supplies next to pet food","zh":"将换药用品放在宠物食物旁边"},{"id":"r3","en":"Planning for a caregiver to perform daily dressing changes after teaching","zh":"计划由照护者在宣教后每日换药"},{"id":"r4","en":"Walking without the offloading boot despite neuropathy","zh":"有神经病变仍未穿减压靴行走"},{"id":"r5","en":"Blood glucose log not checked for 3 days","zh":"血糖记录 3 天未查看"}],"columns":[{"id":"c1","en":"Safe practice","zh":"安全做法"},{"id":"c2","en":"Requires correction","zh":"需要纠正"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c2"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c2"]},{"rowId":"r5","columnIds":["c2"]}]},"rationaleCorrectEn":"Caregiver participation can be safe after teaching, but poor hand hygiene, contaminated setup, lack of offloading, and missing glucose monitoring increase infection and delayed-healing risk.","rationaleCorrectZh":"照护者经过宣教后参与换药可以安全；但手卫生差、操作区污染、未减压和缺少血糖监测会增加感染和愈合延迟风险。","testTakingStrategyEn":"Home-care questions often test whether the environment and return demonstration match the plan, not just whether supplies exist.","testTakingStrategyZh":"居家护理题常考环境和回示是否符合计划，而不只是有没有用品。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1580,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_wound_teachback_04","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_wound_teachback_04_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.256.caseStudy.questions.1","itemType":"dropdown_cloze","category":"Basic Care and Comfort","topic":"Skin & Wound Care","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.256.caseStudy.questions.1.stem.en","stemPathZh":"questions.256.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,52],"terminalOffsetsZh":[0,18],"fullStemEn":"Stage 2 includes the spouse's wound-care teach-back.","fullStemZh":"第 2 阶段包含配偶的伤口护理回示。","terminalSentenceEn":"Stage 2 includes the spouse's wound-care teach-back.","terminalSentenceZh":"第 2 阶段包含配偶的伤口护理回示。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The spouse's response shows {{1}}, so the nurse should {{2}}.","zh":"配偶的回答显示 {{1}}，因此护士应 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"teach-back failure with unsafe wound-care steps","zh":"回示失败且存在不安全伤口护理步骤"},{"id":"o3","en":"a harmless preference for different supplies","zh":"只是对不同用品的无害偏好"},{"id":"o2","en":"readiness to independently change the dressing","zh":"已准备好独立换药"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"stop independent return demonstration, re-teach using the ordered supplies, and coach another return demonstration","zh":"停止独立回示，使用医嘱用品重新宣教，并指导再次回示"},{"id":"o3","en":"skip further teaching and leave written instructions only","zh":"跳过进一步宣教，只留下书面说明"},{"id":"o2","en":"tell the spouse to continue because tight packing speeds healing","zh":"告诉配偶继续，因为塞紧纱布可加速愈合"}],"correct":"o1"}]},"rationaleCorrectEn":"Hydrogen peroxide and tight packing are not the ordered wound-care method and can harm tissue or impair drainage. Failed teach-back requires re-teaching and coached return demonstration.","rationaleCorrectZh":"双氧水和塞紧纱布并非医嘱伤口护理方法，可能损伤组织或影响引流。回示失败需要重新宣教并指导再次回示。","testTakingStrategyEn":"A failed teach-back is not a learner failure; it is a signal to change the teaching method and verify again.","testTakingStrategyZh":"回示失败不是学习者的失败，而是提示需要改变宣教方式并再次确认。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1581,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_wound_teachback_04","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_wound_teachback_04_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.256.caseStudy.questions.2","itemType":"multiple_choice","category":"Reduction of Risk Potential","topic":"Perioperative Care","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.256.caseStudy.questions.2.stem.en","stemPathZh":"questions.256.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,131],"terminalOffsetsZh":[0,33],"fullStemEn":"Which Stage 2 finding is the strongest reason for the home health nurse to contact the wound-care provider before leaving the home?","fullStemZh":"第 2 阶段中哪项发现最能说明居家护士离开前应联系伤口护理提供者？","terminalSentenceEn":"Which Stage 2 finding is the strongest reason for the home health nurse to contact the wound-care provider before leaving the home?","terminalSentenceZh":"第 2 阶段中哪项发现最能说明居家护士离开前应联系伤口护理提供者？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"B","en":"The spouse needs coaching on normal-saline cleansing.","zh":"配偶需要生理盐水清洁方面的指导。"},{"id":"D","en":"The offloading boot is uncomfortable.","zh":"减压靴不舒服。"},{"id":"A","en":"The client asks whether walking barefoot indoors is acceptable.","zh":"患者询问室内赤脚走路是否可以。"},{"id":"C","en":"The wound has a new foul odor, increased yellow drainage, and warm periwound skin.","zh":"伤口出现新的恶臭、黄色渗液增多且周围皮肤发热。"}],"correct":["C"]},"rationaleCorrectEn":"New odor, increased drainage, warmth, and low-grade temperature suggest possible wound infection or deterioration and require provider notification. Teaching and comfort issues still need intervention but are less urgent.","rationaleCorrectZh":"新的恶臭、渗液增多、发热和低热提示可能伤口感染或恶化，需要通知提供者。宣教和舒适问题也需处理，但紧急性较低。","testTakingStrategyEn":"When several home-care issues exist, prioritize new objective deterioration over routine teaching needs.","testTakingStrategyZh":"居家护理有多个问题时，优先处理新的客观恶化，而不是常规宣教需求。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1582,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_wound_teachback_04","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_wound_teachback_04_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.256.caseStudy.questions.3","itemType":"fill_in_blank","category":"Reduction of Risk Potential","topic":"Laboratory & Diagnostic Tests","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.256.caseStudy.questions.3.stem.en","stemPathZh":"questions.256.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[180,221],"terminalOffsetsZh":[71,84],"fullStemEn":"The baseline wound area was length 2.8 cm × width 1.8 cm. Stage 3 measurement is length 3.2 cm × width 2.1 cm. By how many square centimeters has the wound surface area increased? Round to the nearest hundredth if needed.","fullStemZh":"基础伤口面积为长 2.8 cm × 宽 1.8 cm。第 3 阶段测量为长 3.2 cm × 宽 2.1 cm。伤口表面积增加了多少平方厘米？如需要，四舍五入到百分位。","terminalSentenceEn":"Round to the nearest hundredth if needed.","terminalSentenceZh":"如需要，四舍五入到百分位。","penultimateSentenceEn":"By how many square centimeters has the wound surface area increased?","penultimateSentenceZh":"伤口表面积增加了多少平方厘米？","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"increase in cm²","zh":"增加的平方厘米数"},"acceptable":["1.68","1.68 cm2","1.68 cm²"],"numeric":{"value":1.68,"tolerance":0.01,"unit":"cm²"}}]},"rationaleCorrectEn":"Baseline area is 2.8 × 1.8 = 5.04 cm². Current area is 3.2 × 2.1 = 6.72 cm². Increase = 6.72 − 5.04 = 1.68 cm².","rationaleCorrectZh":"基础面积为 2.8 × 1.8 = 5.04 cm²。当前面积为 3.2 × 2.1 = 6.72 cm²。增加量 = 6.72 − 5.04 = 1.68 cm²。","testTakingStrategyEn":"For trend calculations, compute each measurement first and then compare; do not subtract length and width separately.","testTakingStrategyZh":"趋势计算应先分别计算每次测量结果再比较；不要分别相减长和宽。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1583,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_wound_teachback_04","embeddedQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_case_wound_teachback_04_q5","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.256.caseStudy.questions.4","itemType":"ordered_response","category":"Management of Care","topic":"Prioritization & Delegation","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.256.caseStudy.questions.4.stem.en","stemPathZh":"questions.256.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,83],"terminalOffsetsZh":[0,27],"fullStemEn":"Place the nurse's teaching actions in the best order during the Stage 3 home visit.","fullStemZh":"将第 3 阶段居家访视中的护士宣教行动按最佳顺序排列。","terminalSentenceEn":"Place the nurse's teaching actions in the best order during the Stage 3 home visit.","terminalSentenceZh":"将第 3 阶段居家访视中的护士宣教行动按最佳顺序排列。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"ordered_response","options":[{"id":"C","en":"Have the spouse perform a return demonstration using the actual supplies.","zh":"让配偶使用实际用品进行回示操作。"},{"id":"E","en":"Confirm when to call the wound clinic and arrange the next follow-up contact.","zh":"确认何时联系伤口门诊并安排下一次随访联系。"},{"id":"D","en":"Address barriers to offloading boot use and glucose-log checks.","zh":"处理减压靴使用和血糖记录检查的障碍。"},{"id":"B","en":"Demonstrate cleansing with normal saline and applying the prescribed dressing.","zh":"示范用生理盐水清洁并放置处方敷料。"},{"id":"A","en":"Set up a clean work area away from pets and food and perform hand hygiene.","zh":"在远离宠物和食物处建立清洁操作区并进行手卫生。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"The nurse begins by creating a safe setup, then demonstrates ordered care, verifies skill with return demonstration, addresses ongoing adherence barriers, and confirms escalation and follow-up.","rationaleCorrectZh":"护士先建立安全操作环境，然后示范医嘱护理，通过回示确认技能，处理持续执行障碍，最后确认升级时机和随访。","testTakingStrategyEn":"Skill teaching usually moves from safe setup, to demonstration, to return demonstration, to barrier planning.","testTakingStrategyZh":"技能宣教通常从安全准备，到示范，再到回示，最后处理执行障碍。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1584,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_fib_io_balance_05","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.257","itemType":"fill_in_blank","category":"Reduction of Risk Potential","topic":"Perioperative Care","difficulty":"easy","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.257.stem.en","stemPathZh":"questions.257.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[207,270],"terminalOffsetsZh":[98,114],"fullStemEn":"A client on strict intake and output has the following 12-hour totals: oral fluids 1,200 mL; IV fluids 650 mL; urine 1,050 mL; emesis 250 mL; wound drain 90 mL. What is the client's net fluid balance in mL? Enter a positive number for gain or a negative number for loss.","fullStemZh":"一名患者需严格记录出入量，12 小时合计如下：口服液体 1,200 mL；静脉液体 650 mL；尿量 1,050 mL；呕吐物 250 mL；伤口引流 90 mL。该患者净液体平衡为多少 mL？增加请输入正数，减少请输入负数。","terminalSentenceEn":"Enter a positive number for gain or a negative number for loss.","terminalSentenceZh":"增加请输入正数，减少请输入负数。","penultimateSentenceEn":"What is the client's net fluid balance in mL?","penultimateSentenceZh":"该患者净液体平衡为多少 mL？","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"net mL","zh":"净毫升数"},"acceptable":["460","+460","460 mL","+460 mL"],"numeric":{"value":460,"tolerance":0,"unit":"mL"}}]},"rationaleCorrectEn":"Intake is 1,200 + 650 = 1,850 mL. Output is 1,050 + 250 + 90 = 1,390 mL. Net balance is 1,850 − 1,390 = +460 mL.","rationaleCorrectZh":"入量为 1,200 + 650 = 1,850 mL。出量为 1,050 + 250 + 90 = 1,390 mL。净平衡为 1,850 − 1,390 = +460 mL。","testTakingStrategyEn":"For I/O questions, classify each value as intake or output before calculating.","testTakingStrategyZh":"出入量题应先把每个数值归类为入量或出量，再计算。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1585,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_fib_pressure_area_trend_06","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.258","itemType":"fill_in_blank","category":"Basic Care and Comfort","topic":"Sleep & Rest","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.258.stem.en","stemPathZh":"questions.258.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[160,187],"terminalOffsetsZh":[67,76],"fullStemEn":"A sacral pressure injury measured 4.0 cm by 3.5 cm last week. Today it measures 3.2 cm by 3.0 cm. By how many square centimeters did the surface area decrease? Round to the nearest tenth.","fullStemZh":"一处骶尾部压力性损伤上周测量为 4.0 cm × 3.5 cm。今天测量为 3.2 cm × 3.0 cm。表面积减少了多少平方厘米？四舍五入到十分位。","terminalSentenceEn":"Round to the nearest tenth.","terminalSentenceZh":"四舍五入到十分位。","penultimateSentenceEn":"By how many square centimeters did the surface area decrease?","penultimateSentenceZh":"表面积减少了多少平方厘米？","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"decrease in cm²","zh":"减少的平方厘米数"},"acceptable":["4.4","4.4 cm2","4.4 cm²"],"numeric":{"value":4.4,"tolerance":0.1,"unit":"cm²"}}]},"rationaleCorrectEn":"Last week's area was 4.0 × 3.5 = 14.0 cm². Today's area is 3.2 × 3.0 = 9.6 cm². The decrease is 14.0 − 9.6 = 4.4 cm².","rationaleCorrectZh":"上周面积为 4.0 × 3.5 = 14.0 cm²。今天面积为 3.2 × 3.0 = 9.6 cm²。减少量为 14.0 − 9.6 = 4.4 cm²。","testTakingStrategyEn":"Use the same area method for both measurements before interpreting improvement or worsening.","testTakingStrategyZh":"在判断改善或恶化前，两次测量都应使用相同的面积计算方法。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1586,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_cloze_food_med_access_07","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.259","itemType":"dropdown_cloze","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.259.stem.en","stemPathZh":"questions.259.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[161,226],"terminalOffsetsZh":[47,69],"fullStemEn":"A client with heart failure says, 'I take my diuretic every other day because I cannot afford refills, and I eat canned soup when my disability check runs low.' The client has had two admissions for fluid overload in 3 months.","fullStemZh":"一名心力衰竭患者说：“因为买不起续药，我隔天才吃一次利尿剂；残障补助快用完时，我就吃罐头汤。”该患者 3 个月内因液体超负荷住院 2 次。","terminalSentenceEn":"The client has had two admissions for fluid overload in 3 months.","terminalSentenceZh":"该患者 3 个月内因液体超负荷住院 2 次。","penultimateSentenceEn":"A client with heart failure says, 'I take my diuretic every other day because I cannot afford refills, and I eat canned soup when my disability check runs low.'","penultimateSentenceZh":"一名心力衰竭患者说：“因为买不起续药，我隔天才吃一次利尿剂；残障补助快用完时，我就吃罐头汤。”","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse should identify {{1}} and request {{2}} before discharge.","zh":"护士应识别 {{1}}，并在出院前请求 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o3","en":"a need for stricter scolding about diet","zh":"需要更严厉地责备饮食"},{"id":"o1","en":"resource-related barriers to the treatment plan","zh":"与资源不足相关的治疗计划障碍"},{"id":"o2","en":"intentional refusal of all medical advice","zh":"故意拒绝所有医疗建议"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"social work or case management support for medication assistance and food resources","zh":"社工或个案管理协助药物援助和食物资源"},{"id":"o3","en":"automatic discharge without follow-up because the issue is personal choice","zh":"因属于个人选择而无需随访直接出院"},{"id":"o2","en":"only a printed low-sodium diet sheet","zh":"仅提供一张低钠饮食单"}],"correct":"o1"}]},"rationaleCorrectEn":"Skipping diuretics because of cost and relying on high-sodium canned foods due to limited money are resource barriers. Social work or case management can connect the client with medication assistance, food resources, and follow-up support.","rationaleCorrectZh":"因费用隔天服用利尿剂、因经济限制依赖高钠罐头食品，都是资源障碍。社工或个案管理可帮助患者连接药物援助、食物资源和随访支持。","testTakingStrategyEn":"When the barrier is affordability or food access, the best nursing action links resources rather than repeats generic teaching alone.","testTakingStrategyZh":"当障碍是支付能力或食物可及性时，最佳护理行动是连接资源，而不只是重复一般宣教。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1587,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_cloze_palliative_coping_08","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.260","itemType":"dropdown_cloze","category":"Psychosocial Integrity","topic":"Therapeutic Communication","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.260.stem.en","stemPathZh":"questions.260.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[250,306],"terminalOffsetsZh":[65,80],"fullStemEn":"A client with advanced lung disease receiving palliative care has worsening dyspnea despite oxygen. The client says, 'I am scared of suffocating.' The spouse says, 'Please do everything, but don't give morphine because that means you are giving up.' An order is available for low-dose morphine for dyspnea.","fullStemZh":"一名接受姑息护理的晚期肺病患者尽管吸氧仍气促加重。患者说：“我害怕窒息。”配偶说：“请做一切努力，但不要给吗啡，因为那代表放弃。”已有用于气促的低剂量吗啡医嘱。","terminalSentenceEn":"An order is available for low-dose morphine for dyspnea.","terminalSentenceZh":"已有用于气促的低剂量吗啡医嘱。","penultimateSentenceEn":"The spouse says, 'Please do everything, but don't give morphine because that means you are giving up.'","penultimateSentenceZh":"配偶说：“请做一切努力，但不要给吗啡，因为那代表放弃。”","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse's priority is to {{1}} and explain that ordered low-dose morphine is used to {{2}}.","zh":"护士的优先行动是 {{1}}，并解释医嘱低剂量吗啡用于 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"acknowledge the fear and assess the client's goals for comfort","zh":"承认恐惧并评估患者的舒适目标"},{"id":"o3","en":"avoid discussing dyspnea because it may increase anxiety","zh":"避免讨论气促，因为可能增加焦虑"},{"id":"o2","en":"tell the spouse that family opinions do not matter","zh":"告诉配偶家属意见不重要"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"relieve the sensation of breathlessness when prescribed and monitored","zh":"在有医嘱并监测时缓解气促感"},{"id":"o2","en":"hasten death in all palliative clients","zh":"加速所有姑息患者死亡"},{"id":"o3","en":"replace all other comfort measures permanently","zh":"永久替代所有其他舒适措施"}],"correct":"o1"}]},"rationaleCorrectEn":"Therapeutic communication validates the client's fear and centers the client's goals. Low-dose morphine may be prescribed and monitored in palliative care to relieve dyspnea; it is not equivalent to giving up or intentionally hastening death.","rationaleCorrectZh":"治疗性沟通应接纳患者恐惧并以患者目标为中心。姑息护理中可按医嘱并在监测下使用低剂量吗啡缓解气促；这不等同于放弃或故意加速死亡。","testTakingStrategyEn":"Palliative-care questions often ask whether an intervention supports comfort goals, not whether the team is abandoning care.","testTakingStrategyZh":"姑息护理题常考干预是否支持舒适目标，而不是团队是否放弃治疗。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1588,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_matrix_contact_diarrhea_09","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.261","itemType":"matrix","category":"Safety and Infection Prevention and Control","topic":"Transmission-Based Precautions","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.261.stem.en","stemPathZh":"questions.261.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[105,134],"terminalOffsetsZh":[29,39],"fullStemEn":"A client with acute infectious diarrhea is placed on contact precautions while stool testing is pending. Classify each nursing action.","fullStemZh":"一名急性感染性腹泻患者在粪便检测待出结果期间实施接触隔离。将每项护理行动分类。","terminalSentenceEn":"Classify each nursing action.","terminalSentenceZh":"将每项护理行动分类。","penultimateSentenceEn":"A client with acute infectious diarrhea is placed on contact precautions while stool testing is pending.","penultimateSentenceZh":"一名急性感染性腹泻患者在粪便检测待出结果期间实施接触隔离。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Put on gown and gloves before anticipated contact with the client or contaminated surfaces.","zh":"预期接触患者或污染表面前穿隔离衣并戴手套。"},{"id":"r2","en":"Use the same stethoscope for the client and then the next client without cleaning.","zh":"用同一个听诊器听诊该患者后，不清洁就给下一名患者使用。"},{"id":"r3","en":"Remove gown and gloves before leaving the room and perform hand hygiene.","zh":"离开房间前脱去隔离衣和手套并进行手卫生。"},{"id":"r4","en":"Wear a surgical mask for every routine interaction even without splash risk.","zh":"即使没有飞溅风险，每次常规互动都戴外科口罩。"},{"id":"r5","en":"Clean and disinfect high-touch surfaces and shared equipment according to protocol.","zh":"按流程清洁和消毒高频接触表面及共用设备。"}],"columns":[{"id":"c2","en":"Needs correction","zh":"需要纠正"},{"id":"c1","en":"Appropriate contact-precautions action","zh":"适当的接触隔离措施"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c2"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c1"]},{"rowId":"r5","columnIds":["c2"]}]},"rationaleCorrectEn":"Contact precautions focus on gown and gloves for contact, preventing equipment transmission, PPE removal before exit, hand hygiene, and environmental cleaning. A mask is not required for every routine contact unless splash or another indication exists.","rationaleCorrectZh":"接触隔离重点是接触时穿隔离衣戴手套、防止设备传播、出门前脱 PPE、手卫生和环境清洁。除非有飞溅风险或其他指征，常规接触不需要每次都戴口罩。","testTakingStrategyEn":"Match the precaution type to the transmission route; do not add extra PPE unless the clinical situation calls for it.","testTakingStrategyZh":"将隔离类型与传播途径匹配；除非临床情境需要，不要随意增加 PPE。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":true,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1589,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_matrix_stroke_rehab_10","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.262","itemType":"matrix","category":"Basic Care and Comfort","topic":"Mobility & Immobility","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.262.stem.en","stemPathZh":"questions.262.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[206,237],"terminalOffsetsZh":[54,66],"fullStemEn":"A client recovering from an ischemic stroke has right-sided weakness and mild dysphagia. Speech therapy recommends nectar-thick liquids, upright positioning for meals, and supervised swallowing strategies. Classify each care-plan action.","fullStemZh":"一名缺血性卒中恢复期患者有右侧无力和轻度吞咽困难。言语治疗建议使用蜜稠液体、进餐时直立体位，并监督吞咽策略。将每项护理计划行动分类。","terminalSentenceEn":"Classify each care-plan action.","terminalSentenceZh":"将每项护理计划行动分类。","penultimateSentenceEn":"Speech therapy recommends nectar-thick liquids, upright positioning for meals, and supervised swallowing strategies.","penultimateSentenceZh":"言语治疗建议使用蜜稠液体、进餐时直立体位，并监督吞咽策略。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Seat the client upright at 90 degrees for meals and keep upright after eating as directed.","zh":"进餐时让患者 90 度直立坐位，并按指示餐后保持直立。"},{"id":"r2","en":"Offer thin water through a straw to encourage independence.","zh":"用吸管提供清水以鼓励独立。"},{"id":"r3","en":"Check for pocketing of food on the weak side of the mouth.","zh":"检查口腔无力侧是否有食物残留。"},{"id":"r4","en":"Use a gait belt and assistive device during supervised transfer practice.","zh":"监督转移训练时使用步态带和辅助装置。"},{"id":"r5","en":"Rush meals to prevent fatigue.","zh":"加快进餐速度以防疲劳。"}],"columns":[{"id":"c2","en":"Requires follow-up before implementation","zh":"实施前需要跟进"},{"id":"c1","en":"Supports safe rehabilitation progression","zh":"支持安全康复推进"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c2"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c2"]},{"rowId":"r5","columnIds":["c1"]}]},"rationaleCorrectEn":"Upright positioning, checking for pocketing, and supervised mobility support safe progression. Thin liquids through a straw and rushing meals increase aspiration risk and need correction.","rationaleCorrectZh":"直立体位、检查食物残留和监督移动有助于安全推进康复。用吸管喝稀水和催促进餐会增加误吸风险，需要纠正。","testTakingStrategyEn":"Rehabilitation progression should increase independence without ignoring speech and safety restrictions.","testTakingStrategyZh":"康复推进应提高独立性，但不能忽视言语治疗和安全限制。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1590,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_or_home_oxygen_setup_11","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.263","itemType":"ordered_response","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.263.stem.en","stemPathZh":"questions.263.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[91,146],"terminalOffsetsZh":[24,40],"fullStemEn":"A nurse is teaching a client and spouse how to start using a new home oxygen concentrator. Place the teaching and setup actions in the best order.","fullStemZh":"护士正在教患者和配偶如何开始使用新的居家制氧机。将宣教和设置行动按最佳顺序排列。","terminalSentenceEn":"Place the teaching and setup actions in the best order.","terminalSentenceZh":"将宣教和设置行动按最佳顺序排列。","penultimateSentenceEn":"A nurse is teaching a client and spouse how to start using a new home oxygen concentrator.","penultimateSentenceZh":"护士正在教患者和配偶如何开始使用新的居家制氧机。","responseContext":{"type":"ordered_response","options":[{"id":"B","en":"Check the area for smoking materials, flames, heat sources, and tripping hazards.","zh":"检查周围是否有吸烟物品、明火、热源和绊倒风险。"},{"id":"C","en":"Place the concentrator where airflow is unobstructed and tubing does not cross walking paths.","zh":"将制氧机放在通风不受阻且管路不横跨行走路径的位置。"},{"id":"D","en":"Attach the nasal cannula and set the flow to the prescribed rate.","zh":"连接鼻导管并将流量设为处方速率。"},{"id":"A","en":"Verify the prescription, including delivery device, flow rate, and when oxygen is to be used.","zh":"核对处方，包括给氧装置、流量以及何时使用氧气。"},{"id":"E","en":"Have the client and spouse teach back oxygen safety rules and when to call for help.","zh":"让患者和配偶回示氧气安全规则以及何时求助。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"The sequence verifies the order first, removes environmental hazards, positions equipment safely, starts oxygen at the prescribed rate, and confirms understanding through teach-back.","rationaleCorrectZh":"顺序应先核对医嘱，移除环境危险，安全放置设备，按处方流量开始给氧，最后通过回示确认理解。","testTakingStrategyEn":"Equipment teaching starts with the order, then environment, then operation, then verification of learning.","testTakingStrategyZh":"设备宣教从医嘱开始，然后是环境、操作，最后确认学习效果。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1591,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_12_nonmcq_balanced_b_or_stool_specimen_contact_12","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.264","itemType":"ordered_response","category":"Safety and Infection Prevention and Control","topic":"Transmission-Based Precautions","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.264.stem.en","stemPathZh":"questions.264.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[103,154],"terminalOffsetsZh":[28,41],"fullStemEn":"A stool specimen is ordered for a client with acute infectious diarrhea who is on contact precautions. Place the collection workflow in the correct order.","fullStemZh":"一名急性感染性腹泻且实施接触隔离的患者需要采集粪便标本。将采集流程按正确顺序排列。","terminalSentenceEn":"Place the collection workflow in the correct order.","terminalSentenceZh":"将采集流程按正确顺序排列。","penultimateSentenceEn":"A stool specimen is ordered for a client with acute infectious diarrhea who is on contact precautions.","penultimateSentenceZh":"一名急性感染性腹泻且实施接触隔离的患者需要采集粪便标本。","responseContext":{"type":"ordered_response","options":[{"id":"E","en":"Remove PPE in the correct sequence, perform hand hygiene, and send the specimen promptly.","zh":"按正确顺序脱 PPE，进行手卫生，并及时送检标本。"},{"id":"D","en":"Place the sealed specimen in the designated transport bag according to protocol.","zh":"按流程将密封标本放入指定运输袋。"},{"id":"C","en":"Collect the stool specimen without contaminating the outside of the container.","zh":"采集粪便标本，避免污染容器外部。"},{"id":"B","en":"Perform hand hygiene and don gown and gloves before contact with the client or environment.","zh":"接触患者或环境前进行手卫生并穿隔离衣、戴手套。"},{"id":"A","en":"Verify the order, label requirements, and specimen container before entering the room.","zh":"进入房间前核对医嘱、标签要求和标本容器。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"The nurse prepares and verifies supplies before room entry, uses contact-precaution PPE, collects without contaminating the container, bags the specimen per protocol, and removes PPE with hand hygiene before transport.","rationaleCorrectZh":"护士进入房间前准备并核对用品，按接触隔离使用 PPE，采集时避免污染容器，按流程装袋，并在运输前脱 PPE 和手卫生。","testTakingStrategyEn":"For specimen workflows, think: verify supplies, protect yourself, collect cleanly, contain, then remove PPE and transport.","testTakingStrategyZh":"标本流程可按：核对用品、自我防护、清洁采集、封闭装袋、脱 PPE 并运输。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1592,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_2026_06_13_case_delirium_uti_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.265","itemType":"case_study","category":"Physiological Adaptation","topic":"Endocrine & Neurological Disorders","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.265.stem.en","stemPathZh":"questions.265.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[287,346],"terminalOffsetsZh":[75,92],"fullStemEn":"Unfolding case: hyperactive delirium with urinary tract infection An 82-year-old woman with mild Alzheimer-type dementia has an abrupt 36-hour change from baseline, including visual hallucinations, agitation, poor intake, new urinary incontinence, and failure to recognize her daughter. The daughter states this is not her usual dementia pattern.","fullStemZh":"展开案例：尿路感染伴活动过度型谵妄 一名82岁女性有轻度阿尔茨海默型痴呆，36小时内突然偏离基线，出现视幻觉、躁动、进食差、新发尿失禁，并认不出女儿。女儿说明这并不是她平时的痴呆表现。","terminalSentenceEn":"The daughter states this is not her usual dementia pattern.","terminalSentenceZh":"女儿说明这并不是她平时的痴呆表现。","penultimateSentenceEn":"Unfolding case: hyperactive delirium with urinary tract infection An 82-year-old woman with mild Alzheimer-type dementia has an abrupt 36-hour change from baseline, including visual hallucinations, agitation, poor intake, new urinary incontinence, and failure to recognize her daughter.","penultimateSentenceZh":"展开案例：尿路感染伴活动过度型谵妄 一名82岁女性有轻度阿尔茨海默型痴呆，36小时内突然偏离基线，出现视幻觉、躁动、进食差、新发尿失禁，并认不出女儿。","responseContext":{},"rationaleCorrectEn":"The case shows acute hyperactive delirium superimposed on baseline dementia, precipitated by symptomatic urinary tract infection with dehydration and prerenal kidney injury. The priority nursing judgments are to recognize the abrupt fluctuating change from baseline, protect the client from falls and injury using least-restrictive non-pharmacologic delirium measures, treat reversible contributors, use antipsychotic medication only for imminent safety threats after non-pharmacologic measures fail and required safety checks are completed, trend renal and infection markers to evaluate response, and communicate realistic recovery expectations to the family.","rationaleCorrectZh":"本案例显示患者在基线痴呆基础上发生急性活动过度型谵妄，诱因是伴有脱水和肾前性肾损伤的有症状尿路感染。护理判断重点包括：识别与基线相比突然且波动的改变；用限制性最小的非药物谵妄护理措施保护患者避免跌倒和伤害；处理可逆诱因；只有在存在即刻安全威胁、非药物措施失败并完成必要安全核查后才使用抗精神病药；通过肾功能和感染指标趋势评估疗效；并向家属说明现实的恢复预期。","testTakingStrategyEn":"For unfolding cases, first separate baseline from acute change, then ask what threatens safety now and what trend shows whether the intervention is working.","testTakingStrategyZh":"做展开案例时，先区分基线和急性改变，再判断当前最威胁安全的因素，以及哪些趋势能说明干预是否有效。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1593,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_2026_06_13_case_delirium_uti_01","embeddedQuestionId":"gpt_2026_06_13_case_delirium_uti_01_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.265.caseStudy.questions.0","itemType":"matrix","category":"Physiological Adaptation","topic":"Renal & Gastrointestinal Disorders","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.265.caseStudy.questions.0.stem.en","stemPathZh":"questions.265.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,159],"terminalOffsetsZh":[0,44],"fullStemEn":"Stage 1: For each cue, identify whether it most strongly supports acute delirium from an infection/dehydration process or the client's known baseline dementia.","fullStemZh":"阶段1：对每个线索，判断其最能支持感染/脱水过程导致的急性谵妄，还是患者已知的基线痴呆。","terminalSentenceEn":"Stage 1: For each cue, identify whether it most strongly supports acute delirium from an infection/dehydration process or the client's known baseline dementia.","terminalSentenceZh":"阶段1：对每个线索，判断其最能支持感染/脱水过程导致的急性谵妄，还是患者已知的基线痴呆。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Abrupt change over 36 hr from usual cognition and behavior","zh":"36小时内认知和行为突然偏离平时状态"},{"id":"r2","en":"CAM positive with inattention, disorganized thinking, and fluctuating level of consciousness","zh":"CAM阳性，伴注意力不集中、思维紊乱和意识水平波动"},{"id":"r3","en":"Baseline word-finding pauses with orientation to person and place","zh":"基线表现为偶有找词困难，但能定向到本人和地点"},{"id":"r4","en":"Fever, leukocytosis with bands, suprapubic tenderness, and nitrite-positive pyuric urine","zh":"发热、白细胞升高伴杆状核、耻骨上压痛以及亚硝酸盐阳性且脓尿"},{"id":"r5","en":"Mild Alzheimer-type dementia documented 6 months ago","zh":"6个月前记录有轻度阿尔茨海默型痴呆"}],"columns":[{"id":"c2","en":"Supports baseline dementia","zh":"支持基线痴呆"},{"id":"c1","en":"Supports acute delirium","zh":"支持急性谵妄"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c2"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c2"]},{"rowId":"r5","columnIds":["c1"]}]},"rationaleCorrectEn":"The acute 36-hour change, fluctuating attention and consciousness, positive CAM, fever, inflammatory markers, suprapubic tenderness, and abnormal urinalysis support delirium triggered by symptomatic infection and dehydration. Her documented mild Alzheimer-type dementia explains chronic baseline memory and word-finding limitations but does not explain the abrupt febrile fluctuating presentation.","rationaleCorrectZh":"36小时内急性改变、注意力和意识水平波动、CAM阳性、发热、炎症指标、耻骨上压痛和异常尿检，支持由有症状感染和脱水诱发的谵妄。既往记录的轻度阿尔茨海默型痴呆可解释慢性的记忆和找词困难，但不能解释这种突然、发热且波动的表现。","testTakingStrategyEn":"When dementia is in the history, do not stop there. Compare the current presentation with baseline and look for acute fluctuation, inattention, and reversible triggers.","testTakingStrategyZh":"病史中有痴呆时，不要就此停止判断。要把当前表现与基线比较，并寻找急性波动、注意力不集中和可逆诱因。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1594,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_2026_06_13_case_delirium_uti_01","embeddedQuestionId":"gpt_2026_06_13_case_delirium_uti_01_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.265.caseStudy.questions.1","itemType":"multiple_choice","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.265.caseStudy.questions.1.stem.en","stemPathZh":"questions.265.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[93,139],"terminalOffsetsZh":[29,41],"fullStemEn":"Stage 1: The client attempts to stand on the stretcher and swings at staff during transport. Which nursing action has the highest priority?","fullStemZh":"阶段1：患者在转运途中试图从担架上站起，并挥手打工作人员。哪项护理措施优先级最高？","terminalSentenceEn":"Which nursing action has the highest priority?","terminalSentenceZh":"哪项护理措施优先级最高？","penultimateSentenceEn":"Stage 1: The client attempts to stand on the stretcher and swings at staff during transport.","penultimateSentenceZh":"阶段1：患者在转运途中试图从担架上站起，并挥手打工作人员。","responseContext":{"type":"multiple_choice","options":[{"id":"C","en":"Request a benzodiazepine before attempting environmental or sensory interventions.","zh":"在尝试环境或感官干预之前，先要求使用苯二氮䓬类药物。"},{"id":"A","en":"Stay with the client, lower the bed, use a calm voice, and redirect her while protecting her from falling.","zh":"留在患者身边，降低床位，用平静语气交流，并在防止跌倒的同时重新引导她。"},{"id":"D","en":"Tell the daughter that the behavior is expected progression of dementia and ask her to leave so the client can rest.","zh":"告诉女儿这是痴呆进展的预期表现，并请她离开以便患者休息。"},{"id":"B","en":"Apply bilateral wrist restraints immediately because the client is combative.","zh":"因患者有攻击性，立即使用双侧腕部约束。"}],"correct":["A"]},"rationaleCorrectEn":"Immediate physical safety is the priority. Hyperactive delirium creates high fall and injury risk, so the nurse should remain with the client, keep the bed low, use calm de-escalation, and redirect or reorient while preserving least-restrictive care.","rationaleCorrectZh":"当前优先是立即保障身体安全。活动过度型谵妄会显著增加跌倒和受伤风险，因此护士应留在患者身边，保持床位低，用平静方式降级处理，并在限制性最小的前提下重新引导或再定向。","testTakingStrategyEn":"For an agitated client, choose the option that prevents immediate harm while using the least restrictive effective intervention.","testTakingStrategyZh":"面对躁动患者，选择既能防止即刻伤害、又采用有效且限制性最小措施的选项。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1595,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_2026_06_13_case_delirium_uti_01","embeddedQuestionId":"gpt_2026_06_13_case_delirium_uti_01_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.265.caseStudy.questions.2","itemType":"select_all","category":"Pharmacological and Parenteral Therapies","topic":"Psychotropic Medications","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.265.caseStudy.questions.2.stem.en","stemPathZh":"questions.265.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[229,251],"terminalOffsetsZh":[52,60],"fullStemEn":"Stage 2: The PRN haloperidol order may be used only for severe agitation that creates an imminent safety threat after non-pharmacologic measures fail. Which nursing actions are appropriate before or after giving this medication? Select all that apply.","fullStemZh":"阶段2：按需氟哌啶醇医嘱仅可用于非药物措施失败后、造成即刻安全威胁的严重躁动。给药前后哪些护理措施合适？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which nursing actions are appropriate before or after giving this medication?","penultimateSentenceZh":"给药前后哪些护理措施合适？","responseContext":{"type":"select_all","options":[{"id":"B","en":"Review ECG/QTc status, potassium/magnesium status, and other QT-prolonging medications per facility protocol.","zh":"按机构流程查看心电图/QTc、钾/镁状态以及其他延长QT的药物。"},{"id":"A","en":"Document the specific safety threat and the non-pharmacologic measures attempted before giving the dose.","zh":"给药前记录具体安全威胁以及已尝试的非药物措施。"},{"id":"E","en":"After administration, reassess agitation, level of sedation, blood pressure, and extrapyramidal symptoms.","zh":"给药后复评躁动、镇静程度、血压和锥体外系反应。"},{"id":"F","en":"Use physical restraints automatically after the medication takes effect to keep the client in bed.","zh":"药物起效后自动使用身体约束，使患者留在床上。"},{"id":"C","en":"Screen for Parkinson disease or dementia with Lewy bodies before using haloperidol.","zh":"使用氟哌啶醇前筛查帕金森病或路易体痴呆。"},{"id":"D","en":"Give the medication routinely at bedtime to prevent all nighttime confusion.","zh":"每晚睡前常规给药，以预防所有夜间意识混乱。"}],"correct":["A","B","C","E"]},"rationaleCorrectEn":"For delirium-related agitation in a frail older adult, antipsychotic medication is reserved for an imminent safety threat after least-restrictive measures fail. The nurse should document the indication and failed alternatives, complete ordered or protocol-based cardiac/electrolyte and contraindication checks, and monitor effectiveness and adverse effects after administration.","rationaleCorrectZh":"对于体弱老年人谵妄相关躁动，抗精神病药仅限于限制性较小措施失败且存在即刻安全威胁时使用。护士应记录适应证和失败的替代措施，完成医嘱或流程要求的心脏/电解质及禁忌证核查，并在给药后监测疗效和不良反应。","testTakingStrategyEn":"When a PRN psychotropic is ordered for delirium, look for the triad: clear safety indication, failed non-drug measures, and monitoring for high-risk adverse effects.","testTakingStrategyZh":"谵妄患者有按需精神类药物医嘱时，寻找三要素：明确安全适应证、非药物措施失败，以及高风险不良反应监测。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1596,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_2026_06_13_case_delirium_uti_01","embeddedQuestionId":"gpt_2026_06_13_case_delirium_uti_01_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.265.caseStudy.questions.3","itemType":"matrix","category":"Reduction of Risk Potential","topic":"Laboratory & Diagnostic Tests","difficulty":"hard","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.265.caseStudy.questions.3.stem.en","stemPathZh":"questions.265.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[56,225],"terminalOffsetsZh":[17,56],"fullStemEn":"Stage 3: Compare the client's findings across the case. For each finding, indicate whether it shows the current interventions are working or whether it requires continued monitoring because the problem has not fully resolved.","fullStemZh":"阶段3：比较整个案例中的患者资料。对每项发现，判断其显示当前干预正在奏效，还是因问题尚未完全解决而需要继续监测。","terminalSentenceEn":"For each finding, indicate whether it shows the current interventions are working or whether it requires continued monitoring because the problem has not fully resolved.","terminalSentenceZh":"对每项发现，判断其显示当前干预正在奏效，还是因问题尚未完全解决而需要继续监测。","penultimateSentenceEn":"Stage 3: Compare the client's findings across the case.","penultimateSentenceZh":"阶段3：比较整个案例中的患者资料。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Creatinine improves from 1.3 mg/dL to 1.0 mg/dL and BUN decreases from 32 mg/dL to 24 mg/dL","zh":"肌酐从1.3 mg/dL改善到1.0 mg/dL，BUN从32 mg/dL降至24 mg/dL"},{"id":"r2","en":"Urine output improves from 40 mL in 2 hr to 320 mL in 8 hr with pale-yellow urine","zh":"尿量从2小时40 mL改善为8小时320 mL，尿色淡黄"},{"id":"r3","en":"Temperature normalizes and WBC decreases from 14.2 ×10³/µL to 10.4 ×10³/µL","zh":"体温恢复正常，白细胞从14.2 ×10³/µL降至10.4 ×10³/µL"},{"id":"r4","en":"CAM remains positive and the client is still disoriented to place and year","zh":"CAM仍阳性，患者仍不能定向到地点和年份"},{"id":"r5","en":"The client eats half of a soft breakfast with cueing but has not yet tolerated a full meal","zh":"患者在提示下吃了半份软食早餐，但尚未能耐受完整一餐"}],"columns":[{"id":"c2","en":"Continue monitoring / not fully resolved","zh":"继续监测/尚未完全解决"},{"id":"c1","en":"Interventions are working","zh":"干预正在奏效"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c2"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c1"]},{"rowId":"r5","columnIds":["c1"]}]},"rationaleCorrectEn":"Improving creatinine, BUN, sodium, urine output, fever, and WBC trend show that fluids and antibiotic therapy are addressing dehydration, prerenal kidney injury, and infection. However, a positive CAM, ongoing disorientation, and incomplete oral intake mean delirium and functional recovery are not complete and discharge planning still requires supervision and reassessment.","rationaleCorrectZh":"肌酐、BUN、钠、尿量、体温和白细胞趋势改善，说明补液和抗生素治疗正在处理脱水、肾前性肾损伤和感染。但是CAM仍阳性、仍有定向障碍且口服摄入不完整，说明谵妄和功能恢复尚未完成，出院计划仍需监督和复评。","testTakingStrategyEn":"Trend questions are not solved by one value. Compare direction over time and separate physiologic improvement from unresolved safety or functional problems.","testTakingStrategyZh":"趋势题不能只看单个数值。要比较随时间变化的方向，并区分生理改善与尚未解决的安全或功能问题。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1597,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_2026_06_13_case_delirium_uti_01","embeddedQuestionId":"gpt_2026_06_13_case_delirium_uti_01_q5","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.265.caseStudy.questions.4","itemType":"multiple_choice","category":"Psychosocial Integrity","topic":"Mental Health Disorders","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.265.caseStudy.questions.4.stem.en","stemPathZh":"questions.265.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[100,148],"terminalOffsetsZh":[34,44],"fullStemEn":"Stage 3: The daughter asks, \"She's better but still not herself — when will she be back to normal?\" Which response by the nurse is most appropriate?","fullStemZh":"阶段3：女儿问：“她好多了，但还不像自己——什么时候才能恢复正常？”护士哪项回应最合适？","terminalSentenceEn":"Which response by the nurse is most appropriate?","terminalSentenceZh":"护士哪项回应最合适？","penultimateSentenceEn":"Stage 3: The daughter asks, \"She's better but still not herself — when will she be back to normal?\"","penultimateSentenceZh":"阶段3：女儿问：“她好多了，但还不像自己——什么时候才能恢复正常？”","responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"\"The improvement is encouraging. Delirium often clears gradually over days to weeks, sometimes longer in someone with dementia. Our goal is return to her usual baseline, and the facility will need to know what supervision she still needs.\"","zh":"“她的改善令人鼓舞。谵妄通常会在数天到数周内逐渐缓解，有痴呆的人有时需要更久。我们的目标是让她回到平时基线，协助生活机构也需要了解她仍需要哪些监督。”"},{"id":"C","en":"\"This behavior means her dementia has permanently advanced, so you should arrange memory-care placement now.\"","zh":"“这种行为说明她的痴呆已经永久进展，所以你现在就应该安排记忆照护机构。”"},{"id":"B","en":"\"Since the antibiotic is working, she should be completely back to normal by tomorrow.\"","zh":"“既然抗生素有效，她明天应该就能完全恢复正常。”"},{"id":"D","en":"\"Try not to ask about the timeline; talking about it can make her confusion worse.\"","zh":"“尽量不要问恢复时间；谈这个会让她更混乱。”"}],"correct":["A"]},"rationaleCorrectEn":"This response validates the daughter's concern, recognizes that improvement is real, sets realistic expectations that delirium may resolve more slowly than infection markers, and frames the goal as return to the client's baseline rather than immediate full orientation. It also connects persistent delirium to safe discharge planning.","rationaleCorrectZh":"该回应肯定女儿的担忧，承认改善是真实的，并说明谵妄的缓解可能比感染指标改善更慢；同时把目标设定为恢复到患者原有基线，而不是立即完全定向，并将持续谵妄与安全出院计划联系起来。","testTakingStrategyEn":"Therapeutic communication answers usually acknowledge feelings, give accurate information, and avoid false reassurance or premature conclusions.","testTakingStrategyZh":"治疗性沟通选项通常会承认感受、提供准确信息，并避免虚假安慰或过早下结论。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1598,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_2026_06_13_case_delirium_uti_01","embeddedQuestionId":"gpt_2026_06_13_case_delirium_uti_01_q6","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.265.caseStudy.questions.5","itemType":"select_all","category":"Basic Care and Comfort","topic":"Elimination & Comfort","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.265.caseStudy.questions.5.stem.en","stemPathZh":"questions.265.caseStudy.questions.5.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[215,237],"terminalOffsetsZh":[63,71],"fullStemEn":"Stage 2: The client has a Braden Scale score of 14, high fall risk, poor intake, urinary incontinence, disrupted sleep, and ongoing confusion. Which nursing interventions reduce hospital-acquired complication risk? Select all that apply.","fullStemZh":"阶段2：患者Braden评分14分、跌倒风险高、摄入差、尿失禁、睡眠中断且仍意识混乱。哪些护理措施能降低医院获得性并发症风险？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which nursing interventions reduce hospital-acquired complication risk?","penultimateSentenceZh":"哪些护理措施能降低医院获得性并发症风险？","responseContext":{"type":"select_all","options":[{"id":"D","en":"Cluster nighttime care, reduce noise and light at night, and maintain daytime orientation cues.","zh":"夜间集中护理操作、减少噪声和光线，并在白天保持定向线索。"},{"id":"B","en":"Reposition at least every 2 hr, use pressure redistribution as indicated, keep skin clean and dry, and apply moisture barrier to the perineum.","zh":"至少每2小时翻身，按需使用减压/压力再分布措施，保持皮肤清洁干燥，并在会阴部使用防潮屏障。"},{"id":"E","en":"Turn off the bed alarm because alarms can be annoying for confused clients.","zh":"关闭床报警，因为报警声会让意识混乱的患者烦躁。"},{"id":"A","en":"Maintain fall precautions such as bed in lowest position, bed alarm, non-skid footwear, clear pathways, and purposeful rounding.","zh":"维持跌倒预防措施，如床置最低位、床报警、防滑鞋、通道清理和有目的巡视。"},{"id":"C","en":"Offer small frequent meals, fluids, and cueing; escalate nutrition support if intake does not improve.","zh":"提供少量多餐、液体和提示；若摄入未改善，升级营养支持。"},{"id":"F","en":"Keep the client in bed with restraints so she does not remove the IV or fall.","zh":"用约束让患者留在床上，以免拔除静脉通路或跌倒。"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"Delirium, immobility, incontinence, poor intake, sleep disruption, and Braden score 14 create overlapping risks for falls, pressure injury, dehydration, malnutrition, and prolonged delirium. Prevention requires a bundle: fall precautions, skin and moisture care, nutrition/hydration support, and sleep-preserving delirium care.","rationaleCorrectZh":"谵妄、活动受限、尿失禁、摄入差、睡眠中断和Braden评分14分共同增加跌倒、压力性损伤、脱水、营养不良和谵妄延长的风险。预防需要成套措施：跌倒预防、皮肤与潮湿管理、营养/水合支持，以及保护睡眠的谵妄护理。","testTakingStrategyEn":"When several geriatric risks converge, choose bundled prevention measures that address mobility, skin, nutrition, hydration, sleep, and safety together.","testTakingStrategyZh":"当多个老年风险同时存在时，选择成套预防措施，同时处理活动、皮肤、营养、水合、睡眠和安全。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1599,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_opus23_nat_toddler_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.266","itemType":"case_study","category":"Management of Care","topic":"Legal & Ethical Principles","difficulty":"hard","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.266.stem.en","stemPathZh":"questions.266.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[221,377],"terminalOffsetsZh":[52,97],"fullStemEn":"Suspected nonaccidental trauma in a toddler with occult fractures and inconsistent caregiver history A 22-month-old boy is brought to the emergency department by his mother's boyfriend after a reported fall from a couch. The child has left arm pain, patterned bruising in concerning locations, and later imaging reveals occult healing fractures in addition to the acute injury.","fullStemZh":"幼儿疑似非意外性创伤：隐匿性骨折伴照护者病史不一致 一名22个月男童由母亲男友带至急诊，据称从沙发跌落。患儿左臂疼痛，并有位于可疑部位的图案性瘀伤；后续影像除急性损伤外，还发现隐匿的愈合期骨折。","terminalSentenceEn":"The child has left arm pain, patterned bruising in concerning locations, and later imaging reveals occult healing fractures in addition to the acute injury.","terminalSentenceZh":"患儿左臂疼痛，并有位于可疑部位的图案性瘀伤；后续影像除急性损伤外，还发现隐匿的愈合期骨折。","penultimateSentenceEn":"Suspected nonaccidental trauma in a toddler with occult fractures and inconsistent caregiver history A 22-month-old boy is brought to the emergency department by his mother's boyfriend after a reported fall from a couch.","penultimateSentenceZh":"幼儿疑似非意外性创伤：隐匿性骨折伴照护者病史不一致 一名22个月男童由母亲男友带至急诊，据称从沙发跌落。","responseContext":{},"rationaleCorrectEn":"This case requires the nurse to integrate patterned bruising, injuries in different stages of healing, inconsistent caregiver explanations, caregiver behavior, and the child's responses to caregivers. The priority hypothesis is suspected nonaccidental trauma with a need for immediate safety actions, objective documentation, mandatory reporting through proper channels, pain and neurovascular care for the acute fracture, confidentiality-sensitive support for the mother, and coordinated discharge planning with CPS, social work, orthopedics, and the child abuse team. The nurse must not decide legal guilt, confront or interrogate the alleged perpetrator, or let reassuring findings such as a negative head CT erase the concern created by the overall injury pattern.","rationaleCorrectZh":"本病例要求护士综合图案性瘀伤、不同愈合阶段的损伤、照护者解释不一致、照护者行为以及患儿对不同照护者的反应。优先判断是假设存在疑似非意外性创伤，需要立即采取安全行动、客观记录、通过正确渠道强制报告、为急性骨折提供疼痛和神经血管护理、以保护保密性的方式支持母亲，并与CPS、社工、骨科和儿童虐待团队协调出院计划。护士不应判定法律责任、对质或审问疑似施害者，也不应让头颅CT阴性等安慰性发现抵消整体损伤模式带来的疑虑。","testTakingStrategyEn":"In unfolding child-safety cases, prioritize safety and reporting once reasonable suspicion is present, document objective facts, maintain clinical care for injuries, and stay within the nursing role rather than acting as an investigator.","testTakingStrategyZh":"在儿童安全类展开病例中，一旦存在合理怀疑，应优先考虑安全和报告，客观记录事实，继续处理临床损伤，并保持在护理职责范围内，而不是充当调查人员。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1600,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_opus23_nat_toddler_01","embeddedQuestionId":"gpt_case_opus23_nat_toddler_01_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.266.caseStudy.questions.0","itemType":"select_all","category":"Management of Care","topic":"Legal & Ethical Principles","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.266.caseStudy.questions.0.stem.en","stemPathZh":"questions.266.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[102,124],"terminalOffsetsZh":[29,37],"fullStemEn":"At initial presentation, before imaging results are available, which nursing actions are appropriate? Select all that apply.","fullStemZh":"在初始就诊时、影像结果出来之前，护士采取哪些行动是合适的？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"At initial presentation, before imaging results are available, which nursing actions are appropriate?","penultimateSentenceZh":"在初始就诊时、影像结果出来之前，护士采取哪些行动是合适的？","responseContext":{"type":"select_all","options":[{"id":"C","en":"Continue pain assessment and neurovascular checks of the injured left arm while avoiding unnecessary manipulation.","zh":"继续评估疼痛并检查受伤左臂的神经血管状态，同时避免不必要的搬动或牵拉。"},{"id":"E","en":"Tell the boyfriend that the bruises prove child abuse and that he caused the injuries.","zh":"告诉男友这些瘀伤证明存在虐待，并且就是他造成了损伤。"},{"id":"B","en":"Communicate to the ED physician that the patterned bruising and locations are inconsistent with the reported short fall.","zh":"告知急诊医生：这些图案性瘀伤及其部位与所述短距离跌落不一致。"},{"id":"F","en":"Delay documentation until the skeletal survey confirms whether fractures are present.","zh":"等骨骼系统筛查X线确认是否有骨折后，再记录瘀伤情况。"},{"id":"A","en":"Document each bruise objectively, including size, shape, color, and exact anatomic location, using a body map if available.","zh":"客观记录每处瘀伤，包括大小、形状、颜色和精确解剖位置；如有身体图，应使用身体图。"},{"id":"D","en":"Accept the caregiver's explanation because toddlers commonly fall and bruise during play.","zh":"接受照护者解释，因为幼儿在玩耍时经常摔倒并出现瘀伤。"}],"correct":["A","B","C"]},"rationaleCorrectEn":"The initial bruising pattern is a safety and reporting cue even before imaging. Objective documentation, prompt communication to the provider, and ongoing pain/neurovascular assessment protect the child and preserve a clear record without assigning legal guilt.","rationaleCorrectZh":"即使影像尚未出来，初始瘀伤模式已是安全和报告线索。客观记录、及时告知医师，并持续进行疼痛和神经血管评估，有助于保护患儿并保留清晰记录，同时不作法律定责。","testTakingStrategyEn":"For suspected abuse, separate objective nursing actions from legal conclusions: document, report concerns through proper channels, maintain safety, and continue clinical assessment.","testTakingStrategyZh":"遇到疑似虐待时，要区分客观护理行动和法律结论：记录、通过正确渠道报告疑虑、维持安全，并继续临床评估。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"At initial presentation, before imaging results are available, which nursing actions are appropriate?","controlSentenceZh":"在初始就诊时、影像结果出来之前，护士采取哪些行动是合适的？"}
{"queueIndex":1601,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_opus23_nat_toddler_01","embeddedQuestionId":"gpt_case_opus23_nat_toddler_01_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.266.caseStudy.questions.1","itemType":"matrix","category":"Reduction of Risk Potential","topic":"Laboratory & Diagnostic Tests","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.266.caseStudy.questions.1.stem.en","stemPathZh":"questions.266.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[39,134],"terminalOffsetsZh":[11,35],"fullStemEn":"Stage 1 imaging results are available. For each finding, classify how it should affect the nurse's concern about nonaccidental trauma.","fullStemZh":"第1阶段影像结果已出。请判断每项发现对护士关于非意外性创伤疑虑的影响。","terminalSentenceEn":"For each finding, classify how it should affect the nurse's concern about nonaccidental trauma.","terminalSentenceZh":"请判断每项发现对护士关于非意外性创伤疑虑的影响。","penultimateSentenceEn":"Stage 1 imaging results are available.","penultimateSentenceZh":"第1阶段影像结果已出。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Healing posterior left 8th rib fracture with callus formation","zh":"左第8后肋愈合期骨折并有骨痂形成"},{"id":"r2","en":"Healing classic metaphyseal lesion of the right distal tibia","zh":"右胫骨远端愈合期典型干骺端损伤"},{"id":"r3","en":"Multiple fractures in different stages of healing with vague, shifting explanations","zh":"不同愈合阶段的多处骨折，且解释含糊、前后变化"},{"id":"r4","en":"Negative CT head for intracranial hemorrhage or skull fracture","zh":"头颅CT未见颅内出血或颅骨骨折"},{"id":"r5","en":"Normal PT/INR/PTT and normal serum calcium","zh":"PT/INR/PTT正常，血钙正常"}],"columns":[{"id":"c2","en":"Does not explain away the concern or justify delaying the report","zh":"不能解释掉疑虑，也不能作为延迟报告的理由"},{"id":"c1","en":"Supports reasonable suspicion and need for safety/reporting actions","zh":"支持合理怀疑，需要采取安全和报告行动"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c2"]},{"rowId":"r5","columnIds":["c2"]}]},"rationaleCorrectEn":"Posterior rib fracture, classic metaphyseal lesion, multiple injuries in different healing stages, and inconsistent explanations together support reasonable suspicion and safety/reporting actions. A negative head CT and normal coagulation/calcium results do not erase the concern created by the skeletal findings and history.","rationaleCorrectZh":"后肋骨折、典型干骺端损伤、不同愈合阶段的多处损伤以及不一致解释，共同支持合理怀疑并需要采取安全和报告行动。头颅CT阴性以及凝血/钙正常，不能消除骨骼发现和病史所造成的疑虑。","testTakingStrategyEn":"Do not let one reassuring result cancel out multiple high-concern cues. Weigh the pattern, timing, developmental plausibility, and consistency of the history.","testTakingStrategyZh":"不要让一个看似安慰的结果抵消多个高度可疑线索。要综合损伤模式、时间、发育阶段合理性以及病史一致性。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"Stage 1 imaging results are available.","controlSentenceZh":"第1阶段影像结果已出。"}
{"queueIndex":1602,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_opus23_nat_toddler_01","embeddedQuestionId":"gpt_case_opus23_nat_toddler_01_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.266.caseStudy.questions.2","itemType":"select_all","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"hard","ngnSkill":"generate_solutions","stemPathEn":"questions.266.caseStudy.questions.2.stem.en","stemPathZh":"questions.266.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[150,172],"terminalOffsetsZh":[42,50],"fullStemEn":"During Stage 2, the mother discloses fear of the boyfriend and asks the nurse not to tell him what she said. Which nursing responses are appropriate? Select all that apply.","fullStemZh":"第2阶段，母亲透露自己害怕男友，并请护士不要把她的话告诉男友。哪些护理回应是合适的？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which nursing responses are appropriate?","penultimateSentenceZh":"哪些护理回应是合适的？","responseContext":{"type":"select_all","options":[{"id":"E","en":"Tell the boyfriend what the mother disclosed so he can respond to the allegation directly.","zh":"把母亲透露的内容告诉男友，让他直接回应指控。"},{"id":"B","en":"Explain that the team will protect her confidentiality to the greatest extent possible and will not share her specific statements with the boyfriend.","zh":"说明团队会在最大可能范围内保护她的保密性，不会把她的具体陈述告诉男友。"},{"id":"A","en":"Acknowledge her fear and validate that it was important to disclose safety concerns.","zh":"承认她的害怕，并肯定她说出安全担忧是重要的。"},{"id":"D","en":"Offer domestic violence resources and continue safety-focused, nonjudgmental support.","zh":"提供家庭暴力相关资源，并继续给予以安全为重点、非评判性的支持。"},{"id":"F","en":"Advise the mother to confront the boyfriend in the hospital while security is nearby.","zh":"建议母亲趁安保在附近时，在医院里当面对质男友。"},{"id":"C","en":"Ensure the social worker and CPS investigator know about the domestic violence concern so the safety plan addresses both the child and the mother.","zh":"确保社工和CPS调查员了解家庭暴力担忧，使安全计划同时涵盖患儿和母亲。"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"The mother may be a protective caregiver and a victim at risk. The nurse should respond therapeutically, protect confidentiality from the alleged perpetrator as much as possible, involve the appropriate safety-planning team, and provide resources. Confrontation or disclosure to the boyfriend can increase danger.","rationaleCorrectZh":"母亲可能既是保护性照护者，也可能是处于危险中的受害者。护士应以治疗性沟通回应，尽可能避免向疑似施害者透露她的具体陈述，联系适当的安全计划团队，并提供资源。对质或向男友透露内容可能增加危险。","testTakingStrategyEn":"When a client or caregiver discloses interpersonal violence, prioritize safety, confidentiality from the alleged perpetrator, validation, and referral to trained resources.","testTakingStrategyZh":"当患者或照护者披露人际暴力时，优先考虑安全、避免向疑似施害者泄密、给予肯定，并转介到受过训练的资源。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1603,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_opus23_nat_toddler_01","embeddedQuestionId":"gpt_case_opus23_nat_toddler_01_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.266.caseStudy.questions.3","itemType":"dropdown_cloze","category":"Management of Care","topic":"Legal & Ethical Principles","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.266.caseStudy.questions.3.stem.en","stemPathZh":"questions.266.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,93],"terminalOffsetsZh":[0,23],"fullStemEn":"Complete the statement describing the nurse's appropriate response to the agitated caregiver.","fullStemZh":"完成下列语句，说明护士对激动照护者的恰当回应。","terminalSentenceEn":"Complete the statement describing the nurse's appropriate response to the agitated caregiver.","terminalSentenceZh":"完成下列语句，说明护士对激动照护者的恰当回应。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse should explain that the CPS report is based on {{1}}, and should avoid {{2}}.","zh":"护士应说明，向CPS报告是基于 {{1}}，并应避免 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"reasonable suspicion and a legal reporting obligation, not a hospital determination of guilt","zh":"合理怀疑和法定报告义务，而不是医院对责任的判定"},{"id":"o3","en":"the mother's permission to involve protective services","zh":"母亲同意联系保护服务机构"},{"id":"o2","en":"definitive proof that the caregiver intentionally injured the child","zh":"照护者故意伤害患儿的确凿证明"}],"correct":"o1"},{"id":"2","options":[{"id":"o3","en":"asking security for assistance if behavior threatens safety","zh":"如果其行为威胁安全，向安保请求协助"},{"id":"o1","en":"debating guilt, confronting him with accusations, or attempting a forensic interview","zh":"辩论责任、以指控方式对质，或试图进行法医式访谈"},{"id":"o2","en":"documenting his statements verbatim in the medical record","zh":"在病历中逐字记录他的陈述"}],"correct":"o1"}]},"rationaleCorrectEn":"Mandatory reporting is triggered by reasonable suspicion and safety concerns; it is not the nurse's role to prove abuse, determine guilt, or conduct an interrogation. The nurse should remain calm, explain the duty to report, document objectively, and preserve safety.","rationaleCorrectZh":"强制报告由合理怀疑和安全担忧触发；护士的职责不是证明虐待、判定责任或进行审问。护士应保持冷静，解释报告义务，客观记录，并维护安全。","testTakingStrategyEn":"For legal/ethical nursing questions, identify the nurse's actual role: report reasonable suspicion, document facts, maintain safety, and leave investigation or guilt determination to the appropriate agencies.","testTakingStrategyZh":"处理法律/伦理类护理题时，要明确护士的实际职责：报告合理怀疑、记录事实、维护安全，把调查或责任判定交给相应机构。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1604,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_opus23_nat_toddler_01","embeddedQuestionId":"gpt_case_opus23_nat_toddler_01_q5","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.266.caseStudy.questions.4","itemType":"select_all","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"hard","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.266.caseStudy.questions.4.stem.en","stemPathZh":"questions.266.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[162,184],"terminalOffsetsZh":[43,51],"fullStemEn":"At Stage 3, the child is stable and a temporary safety plan is in place. Which nursing actions should be included in discharge planning and psychosocial support? Select all that apply.","fullStemZh":"第3阶段，患儿情况稳定，临时安全计划已建立。出院计划和心理社会支持应包括哪些护理行动？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which nursing actions should be included in discharge planning and psychosocial support?","penultimateSentenceZh":"出院计划和心理社会支持应包括哪些护理行动？","responseContext":{"type":"select_all","options":[{"id":"B","en":"Teach the mother the need for the follow-up skeletal survey in 2 weeks and orthopedic follow-up for the humeral fracture.","zh":"向母亲说明2周后复查骨骼系统筛查X线以及肱骨骨折骨科随访的必要性。"},{"id":"A","en":"Give honest, supportive information that CPS's goal is child safety and reinforce the mother's protective actions.","zh":"诚实而支持性地说明CPS的目标是儿童安全，并强化母亲正在采取的保护性行动。"},{"id":"F","en":"Limit discharge teaching to splint care because CPS is responsible for all safety and psychosocial issues.","zh":"将出院教育仅限于夹板护理，因为所有安全和心理社会问题都由CPS负责。"},{"id":"D","en":"Document the mother's emotional state, her statements, and the child's behavioral responses to visitors.","zh":"记录母亲的情绪状态、她的陈述，以及患儿对访客的行为反应。"},{"id":"C","en":"Coordinate with social work and CPS so community resources and the safety plan are confirmed before discharge.","zh":"与社工和CPS协调，确保出院前社区资源和安全计划已确认。"},{"id":"E","en":"Reassure the mother that CPS will not remove the child as long as she cooperates with the plan.","zh":"安慰母亲：只要她配合计划，CPS就不会带走孩子。"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"Discharge planning must address the medical injury, scheduled reevaluation for occult fractures, psychosocial support, objective documentation, and the safety plan. The nurse should support the mother without making promises about CPS decisions and should not narrow teaching to orthopedic care alone.","rationaleCorrectZh":"出院计划必须涵盖医疗损伤、隐匿骨折复查、心理社会支持、客观记录和安全计划。护士应支持母亲，但不能承诺CPS的决定，也不能把教育只缩小到骨科护理。","testTakingStrategyEn":"For discharge after suspected abuse, think beyond the physical injury: safety plan, follow-up, resources, caregiver support, and objective documentation all matter.","testTakingStrategyZh":"疑似虐待后的出院计划不能只看身体损伤：安全计划、随访、资源、照护者支持和客观记录都很重要。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1605,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_opus21_case_colostomy_lep_discharge_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.267","itemType":"case_study","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.267.stem.en","stemPathZh":"questions.267.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[443,773],"terminalOffsetsZh":[122,214],"fullStemEn":"Safe discharge teaching for a limited-English-proficient patient with a new colostomy A 62-year-old Spanish-speaking woman is on postoperative day 3 after open sigmoid colectomy with end colostomy for perforated diverticulitis. She speaks and reads only Spanish. Her adult daughter speaks English and Spanish and has been interpreting at the bedside, but the chart contains no documentation of qualified interpreter use or patient teach-back. The surgeon's conditional discharge order requires the patient to demonstrate pouch emptying and wafer changing, identify concerning stoma findings, and explain when to call; caregiver participation may supplement but does not replace patient teach-back unless caregiver-dependent discharge planning is documented by the provider.","fullStemZh":"英语能力有限的新结肠造口患者安全出院宣教 一名62岁西班牙语患者因穿孔性憩室炎接受开放乙状结肠切除和末端结肠造口术后第3天。她只会说和读西班牙语。成年女儿会英语和西班牙语，并一直在床旁口译，但病历没有记录使用合格口译员，也没有记录患者本人回教。外科医生的有条件出院医嘱要求患者能演示造口袋排空和底盘更换、识别需担心的造口表现，并说明何时联系医生；照护者可参与补充，但除非医生记录为依赖照护者的出院计划，否则不能替代患者本人回教。","terminalSentenceEn":"The surgeon's conditional discharge order requires the patient to demonstrate pouch emptying and wafer changing, identify concerning stoma findings, and explain when to call; caregiver participation may supplement but does not replace patient teach-back unless caregiver-dependent discharge planning is documented by the provider.","terminalSentenceZh":"外科医生的有条件出院医嘱要求患者能演示造口袋排空和底盘更换、识别需担心的造口表现，并说明何时联系医生；照护者可参与补充，但除非医生记录为依赖照护者的出院计划，否则不能替代患者本人回教。","penultimateSentenceEn":"Her adult daughter speaks English and Spanish and has been interpreting at the bedside, but the chart contains no documentation of qualified interpreter use or patient teach-back.","penultimateSentenceZh":"成年女儿会英语和西班牙语，并一直在床旁口译，但病历没有记录使用合格口译员，也没有记录患者本人回教。","responseContext":{},"rationaleCorrectEn":"This case turns on distinguishing apparent family-supported discharge readiness from verified patient readiness. The priority cues are limited English proficiency, lack of qualified interpreter documentation, no WOC teaching, no patient teach-back, and daughter-directed answers and hand guidance. Safe care requires qualified interpreter use, WOC-led teaching, attention to the patient's fear of viewing the stoma, return demonstration, warning-sign teach-back, medication reconciliation within the existing diabetes plan, adequate supplies, follow-up, and complete documentation. The patient becomes discharge-ready only after she personally demonstrates pouch care and explains warning signs and the home plan through the interpreter.","rationaleCorrectZh":"本病例的核心是区分“看似有家属支持的出院准备”与“已验证的患者本人出院准备”。关键线索包括英语能力有限、无合格口译记录、无造口伤口护理护士宣教、无患者本人回教，以及女儿代答和手把手引导。安全护理需要使用合格口译员、由造口伤口护理护士进行宣教、处理患者害怕看造口的情绪、完成回示演示、回教警示表现、在既有糖尿病计划内进行用药核对、确认用品和随访，并完整记录。只有当患者本人通过口译员演示造口袋护理并说明警示表现和居家计划后，才达到出院准备。","testTakingStrategyEn":"In unfolding discharge cases, track the exact criteria that must be met before discharge and evaluate whether the patient, not only the caregiver, has demonstrated comprehension and skill.","testTakingStrategyZh":"在展开式出院病例中，要追踪出院前必须达到的具体标准，并评估患者本人而不仅是照护者是否已展示理解和技能。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1606,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_opus21_case_colostomy_lep_discharge_01","embeddedQuestionId":"gpt_opus21_case_colostomy_lep_discharge_01_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.267.caseStudy.questions.0","itemType":"multiple_choice","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.267.caseStudy.questions.0.stem.en","stemPathZh":"questions.267.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[174,205],"terminalOffsetsZh":[62,71],"fullStemEn":"Stage 1: The daughter offers to interpret the ostomy discharge teaching. The chart shows no prior qualified interpreter use, no WOC nurse note, and no documented teach-back. What should the nurse do first?","fullStemZh":"第1阶段：患者女儿主动提出为造口出院宣教做口译。病历显示此前没有使用合格口译员、没有造口伤口护理护士记录，也没有记录回教法。护士首先应怎么做？","terminalSentenceEn":"What should the nurse do first?","terminalSentenceZh":"护士首先应怎么做？","penultimateSentenceEn":"The chart shows no prior qualified interpreter use, no WOC nurse note, and no documented teach-back.","penultimateSentenceZh":"病历显示此前没有使用合格口译员、没有造口伤口护理护士记录，也没有记录回教法。","responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Proceed with teaching through the daughter because she is bilingual and will live with the patient.","zh":"通过女儿继续宣教，因为她会说两种语言并将与患者同住。"},{"id":"D","en":"Ask the daughter to sign the discharge instructions because she has been doing the pouch care.","zh":"让女儿签署出院说明，因为一直是她在照护造口袋。"},{"id":"C","en":"Give the Spanish written instructions and document that written teaching was provided.","zh":"提供西班牙语书面说明，并记录已给予书面宣教。"},{"id":"B","en":"Arrange a qualified Spanish medical interpreter before formal discharge teaching and keep the daughter present for support if the patient wants.","zh":"在正式出院宣教前安排合格的西班牙语医疗口译员；若患者愿意，可让女儿在场提供支持。"}],"correct":["B"]},"rationaleCorrectEn":"Formal discharge teaching for a patient with limited English proficiency requires direct communication with the patient through qualified language assistance. The daughter may support the patient, but the case cues show she has been answering for the patient and guiding the skill rather than confirming the patient's own understanding.","rationaleCorrectZh":"英语能力有限患者的正式出院宣教需要通过合格语言协助直接与患者沟通。女儿可以支持患者，但病例线索显示她一直代替患者回答并指导操作，而不是确认患者本人的理解。","testTakingStrategyEn":"When a patient has limited English proficiency, do not equate family support with qualified interpretation. Ask who is demonstrating understanding: the patient or someone speaking for the patient.","testTakingStrategyZh":"遇到英语能力有限的患者时，不要把家属支持等同于合格口译。要判断是谁在表现理解：是患者本人，还是代替患者说话的人。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1607,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_opus21_case_colostomy_lep_discharge_01","embeddedQuestionId":"gpt_opus21_case_colostomy_lep_discharge_01_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.267.caseStudy.questions.1","itemType":"select_all","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.267.caseStudy.questions.1.stem.en","stemPathZh":"questions.267.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[96,118],"terminalOffsetsZh":[29,37],"fullStemEn":"Stage 1: Which findings show that the patient has not yet met the surgeon's discharge criteria? Select all that apply.","fullStemZh":"第1阶段：哪些发现表明患者尚未达到外科医生规定的出院标准？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Stage 1: Which findings show that the patient has not yet met the surgeon's discharge criteria?","penultimateSentenceZh":"第1阶段：哪些发现表明患者尚未达到外科医生规定的出院标准？","responseContext":{"type":"select_all","options":[{"id":"C","en":"The daughter answers the normal-stoma question for the patient.","zh":"女儿代替患者回答正常造口表现的问题。"},{"id":"A","en":"The only documented education was done through the daughter, with no qualified interpreter documented.","zh":"唯一记录的宣教是通过女儿完成，且没有记录合格口译员。"},{"id":"B","en":"The patient nods and says brief English words that do not clearly match the questions.","zh":"患者点头并说简短英语词语，但这些反应与问题内容不明确匹配。"},{"id":"D","en":"The daughter begins guiding the patient's hands during the pouch-emptying demonstration.","zh":"在造口袋排空演示时，女儿开始引导患者的双手。"},{"id":"E","en":"The stoma is beefy red, moist, and protrudes about 1 cm above the skin.","zh":"造口呈鲜红湿润，突出皮肤约1厘米。"},{"id":"F","en":"The patient is afebrile, hemodynamically stable, and ambulatory to the bathroom.","zh":"患者无发热，血流动力学稳定，并能步行至卫生间。"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"The discharge order requires the patient's own demonstration of pouch emptying and wafer changing, identification of concerning stoma findings, and explanation of when to call. Lack of qualified interpreter use, unclear acquiescent responses, family-member answering, and hands-on guidance all prevent the nurse from confirming that the patient herself meets those criteria.","rationaleCorrectZh":"出院医嘱要求患者本人演示造口袋排空和底盘更换、识别需担心的造口表现，并说明何时联系医生。未使用合格口译、反应含糊的附和、家属代答以及手把手引导，都使护士无法确认患者本人已达到这些标准。","testTakingStrategyEn":"For discharge-readiness items, separate physiologic stability from required teaching criteria. Stable vitals do not replace a required patient return demonstration.","testTakingStrategyZh":"做出院准备题时，要区分生理稳定与规定的宣教标准。生命体征稳定不能替代患者必须完成的回示演示。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1608,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_opus21_case_colostomy_lep_discharge_01","embeddedQuestionId":"gpt_opus21_case_colostomy_lep_discharge_01_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.267.caseStudy.questions.2","itemType":"multiple_choice","category":"Psychosocial Integrity","topic":"Mental Health Disorders","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.267.caseStudy.questions.2.stem.en","stemPathZh":"questions.267.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[155,226],"terminalOffsetsZh":[40,58],"fullStemEn":"Stage 2: Using the qualified interpreter, the patient says she has been afraid to look at the stoma and has allowed her daughter to handle all pouch care. What is the priority nursing response before continuing skill teaching?","fullStemZh":"第2阶段：通过合格口译员，患者表示她一直害怕看造口，并让女儿处理所有造口袋护理。继续技能宣教前，护士优先应如何回应？","terminalSentenceEn":"What is the priority nursing response before continuing skill teaching?","terminalSentenceZh":"继续技能宣教前，护士优先应如何回应？","penultimateSentenceEn":"Stage 2: Using the qualified interpreter, the patient says she has been afraid to look at the stoma and has allowed her daughter to handle all pouch care.","penultimateSentenceZh":"第2阶段：通过合格口译员，患者表示她一直害怕看造口，并让女儿处理所有造口袋护理。","responseContext":{"type":"multiple_choice","options":[{"id":"B","en":"Ask the daughter to complete the wafer change while the patient watches from bed.","zh":"请女儿完成底盘更换，患者在床上观看即可。"},{"id":"D","en":"Tell the patient that the stoma looks healthy and move directly to the return demonstration.","zh":"告诉患者造口看起来健康，然后直接进入回示演示。"},{"id":"A","en":"Acknowledge the fear, invite the patient to describe her concerns, and guide a gradual first look at the stoma with interpreter support.","zh":"承认患者的害怕感受，请她描述担忧，并在口译员协助下循序渐进地第一次观察造口。"},{"id":"C","en":"Postpone all teaching until the outpatient WOC visit in two weeks.","zh":"把所有宣教推迟到两周后的门诊造口护理随访。"}],"correct":["A"]},"rationaleCorrectEn":"The patient's avoidance is a psychosocial barrier to self-care. Brief supportive counseling and a gradual, interpreter-facilitated first look address readiness so the later pouch-emptying and wafer-change teaching can be effective.","rationaleCorrectZh":"患者回避造口是自我护理的心理社会障碍。简短支持性沟通和在口译员协助下循序渐进观察造口，有助于建立准备度，使后续排空造口袋和更换底盘的教学有效。","testTakingStrategyEn":"When a patient avoids a new body change, address readiness and coping before expecting independent technical performance.","testTakingStrategyZh":"当患者回避新的身体改变时，应先处理准备度和应对，再要求其独立完成技术操作。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1609,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_opus21_case_colostomy_lep_discharge_01","embeddedQuestionId":"gpt_opus21_case_colostomy_lep_discharge_01_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.267.caseStudy.questions.3","itemType":"matrix","category":"Reduction of Risk Potential","topic":"Perioperative Care","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.267.caseStudy.questions.3.stem.en","stemPathZh":"questions.267.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,135],"terminalOffsetsZh":[0,47],"fullStemEn":"Stage 2: Classify each colostomy finding as expected for this patient's current postoperative course or requiring follow-up/escalation.","fullStemZh":"第2阶段：判断每个结肠造口相关发现对该患者当前术后过程而言是预期表现，还是需要跟进/升级处理。","terminalSentenceEn":"Stage 2: Classify each colostomy finding as expected for this patient's current postoperative course or requiring follow-up/escalation.","terminalSentenceZh":"第2阶段：判断每个结肠造口相关发现对该患者当前术后过程而言是预期表现，还是需要跟进/升级处理。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Stoma is beefy red and moist.","zh":"造口鲜红且湿润。"},{"id":"r2","en":"Peristomal skin remains intact without redness or breakdown.","zh":"造口周围皮肤完整，无发红或破损。"},{"id":"r3","en":"Output is thinner and more yellow-green, and the pouch was emptied twice in two hours; vital signs are stable.","zh":"排出物变稀、偏黄绿色，2小时内排空造口袋两次；生命体征稳定。"},{"id":"r4","en":"Stoma becomes dark purple or black.","zh":"造口变成深紫色或黑色。"},{"id":"r5","en":"No stoma output for more than 6 hours with cramping or abdominal distension.","zh":"超过6小时无造口排出，并伴腹部绞痛或腹胀。"},{"id":"r6","en":"Peristomal skin develops redness and breakdown.","zh":"造口周围皮肤出现发红和破损。"}],"columns":[{"id":"c2","en":"Requires follow-up or escalation","zh":"需要跟进或升级处理"},{"id":"c1","en":"Expected / monitor routinely","zh":"预期表现/常规观察"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c2"]},{"rowId":"r5","columnIds":["c2"]},{"rowId":"r6","columnIds":["c2"]}]},"rationaleCorrectEn":"The patient's red, moist stoma, intact peristomal skin, stable vital signs, and looser early postoperative output are appropriate for continued monitoring. Color change to dark purple or black, absent output with cramping or distension, or skin breakdown are warning signs that require follow-up.","rationaleCorrectZh":"患者造口红润湿润、造口周围皮肤完整、生命体征稳定，以及术后早期排出物较稀，均适合继续常规观察。造口变深紫或黑色、无排出伴绞痛或腹胀、皮肤破损则是需要跟进的警示表现。","testTakingStrategyEn":"Compare the finding with the whole trend. Stable vitals and functioning output make a mild output change less concerning, but color change, no output with symptoms, or skin breakdown are red flags.","testTakingStrategyZh":"将单个发现放到整体趋势中判断。生命体征稳定且造口有功能时，轻度排出物变化较不令人担心；但颜色改变、无排出伴症状或皮肤破损是危险信号。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1610,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_opus21_case_colostomy_lep_discharge_01","embeddedQuestionId":"gpt_opus21_case_colostomy_lep_discharge_01_q5","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.267.caseStudy.questions.4","itemType":"dropdown_cloze","category":"Pharmacological and Parenteral Therapies","topic":"Cardiovascular & Endocrine Medications","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.267.caseStudy.questions.4.stem.en","stemPathZh":"questions.267.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[146,176],"terminalOffsetsZh":[40,48],"fullStemEn":"Stage 3: During medication reconciliation, the patient asks whether she should check blood glucose at home now that metformin has been restarted. Complete the nurse's response.","fullStemZh":"第3阶段：用药核对时，患者询问现在已重新开始服用二甲双胍，回家后是否应监测血糖。完成护士的回应。","terminalSentenceEn":"Complete the nurse's response.","terminalSentenceZh":"完成护士的回应。","penultimateSentenceEn":"Stage 3: During medication reconciliation, the patient asks whether she should check blood glucose at home now that metformin has been restarted.","penultimateSentenceZh":"第3阶段：用药核对时，患者询问现在已重新开始服用二甲双胍，回家后是否应监测血糖。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse should first {{1}} and teach that metformin used alone has a {{2}}.","zh":"护士应首先 {{1}}，并说明单独使用二甲双胍时 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o3","en":"tell the daughter to monitor and report the glucose values instead of asking the patient","zh":"告诉女儿代替患者监测并报告血糖值"},{"id":"o1","en":"confirm the patient's existing home glucose-monitoring plan and supplies","zh":"确认患者原有的家庭血糖监测计划和用品是否齐备"},{"id":"o2","en":"instruct the patient to stop home monitoring because creatinine is normal","zh":"因为肌酐正常，指导患者停止家庭血糖监测"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"low risk of hypoglycemia compared with insulin or insulin secretagogues","zh":"与胰岛素或促胰岛素分泌药相比，低血糖风险较低"},{"id":"o2","en":"high risk of sudden hypoglycemia that requires juice at the bedside","zh":"突然低血糖风险很高，需要在床边备果汁"},{"id":"o3","en":"requirement to hold lisinopril whenever fasting glucose is above target","zh":"只要空腹血糖高于目标值就必须停用赖诺普利"}],"correct":"o1"}]},"rationaleCorrectEn":"The nurse can reinforce the patient's existing diabetes plan by confirming that the glucometer and supplies are available and reviewing the provider's target range. Metformin alone is not primarily associated with hypoglycemia; the teaching should not overstate low-glucose risk or shift responsibility away from the patient.","rationaleCorrectZh":"护士可以通过确认血糖仪和耗材是否可用，并复习医嘱中的目标范围来强化患者既有糖尿病管理计划。单独使用二甲双胍通常不是低血糖的主要原因；宣教不应夸大低血糖风险，也不应把责任从患者本人转移走。","testTakingStrategyEn":"Medication-reconciliation teaching should reinforce the current plan and correct the specific misconception. Do not add unrelated hold parameters or delegate the patient's self-management without need.","testTakingStrategyZh":"用药核对宣教应强化现有计划，并纠正具体误解。不要添加无关的停药参数，也不要无必要地把患者自我管理交给他人。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1611,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_opus21_case_colostomy_lep_discharge_01","embeddedQuestionId":"gpt_opus21_case_colostomy_lep_discharge_01_q6","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.267.caseStudy.questions.5","itemType":"select_all","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.267.caseStudy.questions.5.stem.en","stemPathZh":"questions.267.caseStudy.questions.5.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[121,143],"terminalOffsetsZh":[30,38],"fullStemEn":"Stage 3: Which findings best support that discharge teaching has been effective and that the patient is safe to go home? Select all that apply.","fullStemZh":"第3阶段：哪些发现最能支持出院宣教有效，且患者可以安全回家？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Stage 3: Which findings best support that discharge teaching has been effective and that the patient is safe to go home?","penultimateSentenceZh":"第3阶段：哪些发现最能支持出院宣教有效，且患者可以安全回家？","responseContext":{"type":"select_all","options":[{"id":"F","en":"The nurse documents interpreter use, return demonstration, teach-back responses, supplies, and follow-up arrangements.","zh":"护士记录口译员使用、回示演示、回教回答、用品和随访安排。"},{"id":"B","en":"The patient completed pouch emptying and wafer application with verbal coaching only during the WOC session.","zh":"在造口伤口护理护士教学中，患者仅在口头提示下完成造口袋排空和底盘粘贴。"},{"id":"E","en":"The patient verbalizes the medication schedule and follow-up plan through the interpreter.","zh":"患者通过口译员说出用药时间表和随访计划。"},{"id":"C","en":"The daughter says she understands the instructions and will take care of the pouch at home.","zh":"女儿说她理解说明，并会在家照顾造口袋。"},{"id":"A","en":"Through the interpreter, the patient states the stoma warning signs in her own words.","zh":"通过口译员，患者用自己的话说出造口警示表现。"},{"id":"D","en":"The patient receives written ostomy instructions in Spanish and a supply/vendor plan.","zh":"患者获得西班牙语书面造口护理说明以及用品/供应商计划。"}],"correct":["A","B","D","E","F"]},"rationaleCorrectEn":"Effective discharge evaluation combines patient-centered teach-back through a qualified interpreter, return demonstration of psychomotor skills, written language-concordant reinforcement, supplies, follow-up, and complete documentation. The daughter's understanding is helpful support but does not by itself prove the patient's readiness under the stated discharge criteria.","rationaleCorrectZh":"有效的出院评估应结合通过合格口译员完成的以患者为中心的回教、心理运动技能回示演示、语言相符的书面强化、用品、随访以及完整记录。女儿理解说明可作为支持，但根据本病例出院标准，单靠女儿理解不能证明患者本人已准备好。","testTakingStrategyEn":"For evaluation questions, look for objective evidence that the learner or patient actually performed or explained the required skill, not just that teaching was delivered.","testTakingStrategyZh":"做评估题时，要寻找学习者或患者确实完成或说明所需技能的客观证据，而不仅是“已经宣教”。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1612,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"hl_smoke_2026_06_14_aki_hyperkalemia_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.268","itemType":"highlight","category":"Physiological Adaptation","topic":"Electrolyte Imbalances","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.268.stem.en","stemPathZh":"questions.268.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,56],"terminalOffsetsZh":[0,12],"fullStemEn":"Highlight the findings that require immediate follow-up.","fullStemZh":"标出需要立即跟进的发现。","terminalSentenceEn":"Highlight the findings that require immediate follow-up.","terminalSentenceZh":"标出需要立即跟进的发现。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"0900 progress note:","zh":"0900 病程记录："},{"id":"s2","en":"Blood pressure 134/78 mm Hg.","zh":"血压 134/78 mmHg。","selectable":true},{"id":"s3","en":"Urine output 18 mL over 4 hours.","zh":"4 小时尿量 18 毫升。","selectable":true},{"id":"s4","en":"Potassium 6.7 mEq/L.","zh":"血钾 6.7 mEq/L。","selectable":true},{"id":"s5","en":"Telemetry strip shows tall, peaked T waves.","zh":"遥测心电图显示高尖 T 波。","selectable":true},{"id":"s6","en":"Incisional pain is 3/10 after coughing.","zh":"咳嗽后切口疼痛为 3/10。","selectable":true}],"correct":["s3","s4","s5"]}},"rationaleCorrectEn":"Severely decreased urine output, potassium 6.7 mEq/L, and peaked T waves suggest clinically important hyperkalemia in the setting of acute kidney injury and require immediate escalation. The stable blood pressure and mild incisional pain are not the priority cues.","rationaleCorrectZh":"尿量明显减少、血钾 6.7 mEq/L 以及高尖 T 波提示急性肾损伤背景下具有临床意义的高钾血症，需要立即上报和处理。血压稳定和轻度切口疼痛不是优先线索。","testTakingStrategyEn":"In highlight items, select only cues that match the stated criterion. Do not highlight every abnormal-sounding word; extra selections subtract points.","testTakingStrategyZh":"做标注题时，只选择符合题干标准的线索。不要把所有听起来异常的内容都标出；多选会扣分。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1613,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"hl_smoke_2026_06_14_opioid_sedation_02","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.269","itemType":"highlight","category":"Pharmacological and Parenteral Therapies","topic":"Medication Safety & Admin","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.269.stem.en","stemPathZh":"questions.269.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,91],"terminalOffsetsZh":[0,23],"fullStemEn":"Highlight the findings that require the nurse to hold the opioid and intervene immediately.","fullStemZh":"标出提示护士应暂停阿片类药物并立即干预的发现。","terminalSentenceEn":"Highlight the findings that require the nurse to hold the opioid and intervene immediately.","terminalSentenceZh":"标出提示护士应暂停阿片类药物并立即干预的发现。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"1430 postoperative assessment:","zh":"1430 术后评估："},{"id":"s2","en":"Hydromorphone PCA is running at the prescribed settings.","zh":"氢吗啡酮 PCA 正按医嘱设置运行。","selectable":true},{"id":"s3","en":"Respiratory rate is 8/min.","zh":"呼吸频率为 8 次/分。","selectable":true},{"id":"s4","en":"Client is difficult to arouse to voice.","zh":"呼唤后患者不易唤醒。","selectable":true},{"id":"s5","en":"Oxygen saturation is 88% on 2 L/min nasal cannula.","zh":"鼻导管 2 L/分吸氧下血氧饱和度为 88%。","selectable":true},{"id":"s6","en":"Pain score is 7/10 at the incision.","zh":"切口疼痛评分为 7/10。","selectable":true}],"correct":["s3","s4","s5"]}},"rationaleCorrectEn":"A respiratory rate of 8/min, decreased arousability, and oxygen saturation of 88% indicate possible opioid-induced respiratory depression. The opioid should be held while the nurse supports airway and breathing, stimulates the client, notifies the provider or rapid response team per policy, and anticipates naloxone if prescribed or protocolized.","rationaleCorrectZh":"呼吸频率 8 次/分、不易唤醒以及血氧饱和度 88% 提示可能发生阿片类药物导致的呼吸抑制。护士应暂停阿片类药物，同时支持气道和呼吸、刺激患者、按流程通知医师或快速反应团队，并预期根据医嘱或流程使用纳洛酮。","testTakingStrategyEn":"When an analgesic item includes sedation and breathing data, prioritize respiratory safety over pain-score treatment.","testTakingStrategyZh":"镇痛药题目若同时出现镇静和呼吸资料，应优先考虑呼吸安全，而不是先处理疼痛评分。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1614,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_injection_smoke_2026_06_15_mc_intradermal_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.270","itemType":"multiple_choice","category":"Pharmacological and Parenteral Therapies","topic":"Medication Safety & Admin","difficulty":"easy","ngnSkill":"recognize_cues","stemPathEn":"questions.270.stem.en","stemPathZh":"questions.270.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[52,119],"terminalOffsetsZh":[13,29],"fullStemEn":"The nurse reviews the injection-site cross-section. Which medication route is represented by the needle position shown?","fullStemZh":"护士查看注射部位横截面图。图中针头位置表示哪一种给药途径？","terminalSentenceEn":"Which medication route is represented by the needle position shown?","terminalSentenceZh":"图中针头位置表示哪一种给药途径？","penultimateSentenceEn":"The nurse reviews the injection-site cross-section.","penultimateSentenceZh":"护士查看注射部位横截面图。","responseContext":{"type":"multiple_choice","options":[{"id":"C","en":"Intramuscular","zh":"肌内注射"},{"id":"D","en":"Intravenous","zh":"静脉给药"},{"id":"A","en":"Intradermal","zh":"皮内注射"},{"id":"B","en":"Subcutaneous","zh":"皮下注射"}],"correct":["A"]},"rationaleCorrectEn":"A shallow needle angle with the tip in the dermis and a small bleb is consistent with intradermal administration.","rationaleCorrectZh":"针头角度很浅，针尖位于真皮层，并出现小皮丘，符合皮内给药。","testTakingStrategyEn":"First identify the layer reached by the needle tip; then match the layer to the route.","testTakingStrategyZh":"先判断针尖到达的组织层，再把该组织层与给药途径对应。","sourceMetadata":"Parenteral route angle/depth reference.","mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
