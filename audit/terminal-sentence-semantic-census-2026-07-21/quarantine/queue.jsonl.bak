insRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":994,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_adapt_10","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.767","itemType":"case_study","category":"Psychosocial Integrity","topic":"Therapeutic Communication","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.767.stem.en","stemPathZh":"questions.767.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,99],"terminalOffsetsZh":[0,36],"fullStemEn":"Rheumatology Clinic A 40-year-old female was diagnosed with rheumatoid arthritis (RA) 3 months ago.","fullStemZh":"风湿病诊所 一名40岁女性在3个月前被诊断出患有类风湿关节炎 (RA)。","terminalSentenceEn":"Rheumatology Clinic A 40-year-old female was diagnosed with rheumatoid arthritis (RA) 3 months ago.","terminalSentenceZh":"风湿病诊所 一名40岁女性在3个月前被诊断出患有类风湿关节炎 (RA)。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"Adapting to a chronic illness requires moving past denial to acceptance, often requiring grief work for the loss of a prior healthy self-image. Providing resources empowers the client.","rationaleCorrectZh":"适应慢性疾病需要克服否认走向接受，通常需要对失去以前健康的自我形象进行悲伤处理。提供资源能赋予患者力量。","testTakingStrategyEn":"Focus on empowerment and integration of the illness into the client's self-concept.","testTakingStrategyZh":"专注于赋权以及将疾病融入患者的自我概念中。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":995,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_adapt_10","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_adapt_10_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.767.caseStudy.questions.0","itemType":"select_all","category":"Psychosocial Integrity","topic":"Therapeutic Communication","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.767.caseStudy.questions.0.stem.en","stemPathZh":"questions.767.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[88,110],"terminalOffsetsZh":[23,32],"fullStemEn":"Which statements accurately describe the psychosocial challenges this client is facing? Select all that apply.","fullStemZh":"哪些描述准确地反映了该患者面临的社会心理挑战？请选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"请选择所有适用项。","penultimateSentenceEn":"Which statements accurately describe the psychosocial challenges this client is facing?","penultimateSentenceZh":"哪些描述准确地反映了该患者面临的社会心理挑战？","responseContext":{"type":"select_all","options":[{"id":"o4","en":"Acceptance of the chronic illness","zh":"接受了慢性疾病"},{"id":"o1","en":"Fear of altered body image","zh":"害怕身体形象改变"},{"id":"o3","en":"Use of denial as a coping mechanism","zh":"使用否认作为应对机制"},{"id":"o2","en":"Threat to occupational role","zh":"职业角色受到威胁"},{"id":"o5","en":"Anxiety regarding future disability","zh":"对未来残疾感到焦虑"}],"correct":["o1","o2","o3","o5"]},"rationaleCorrectEn":"The client expresses fear of deformity (body image), fear of losing her job (role), anxiety about the future, and explicitly states she sometimes 'pretends' it isn't real (denial).","rationaleCorrectZh":"患者表达了对畸形的恐惧（身体形象）、对失业的恐惧（角色）、对未来的焦虑，并明确表示她有时“假装”这不是真的（否认）。","testTakingStrategyEn":"Link the client's quotes to formal psychosocial concepts.","testTakingStrategyZh":"将患者的话语与正式的社会心理学概念联系起来。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":996,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_adapt_10","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_adapt_10_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.767.caseStudy.questions.1","itemType":"matrix","category":"Psychosocial Integrity","topic":"Therapeutic Communication","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.767.caseStudy.questions.1.stem.en","stemPathZh":"questions.767.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,102],"terminalOffsetsZh":[0,23],"fullStemEn":"Click to specify whether each nursing action is appropriate or inappropriate to facilitate adaptation.","fullStemZh":"点击指出以下各项护理措施对于促进适应是否合适。","terminalSentenceEn":"Click to specify whether each nursing action is appropriate or inappropriate to facilitate adaptation.","terminalSentenceZh":"点击指出以下各项护理措施对于促进适应是否合适。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Tell the client that new medications prevent all deformities now.","zh":"告诉患者现在的新药可以防止所有畸形。"},{"id":"r2","en":"Provide a referral to an occupational therapist.","zh":"提供转介给职业治疗师。"},{"id":"r3","en":"Encourage the client to express her fears about her career.","zh":"鼓励患者表达她对职业的恐惧。"},{"id":"r4","en":"Teach joint protection techniques.","zh":"教授关节保护技术。"}],"columns":[{"id":"c2","en":"Inappropriate","zh":"不合适"},{"id":"c1","en":"Appropriate","zh":"合适"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c2"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c1"]}]},"rationaleCorrectEn":"Validating fears, providing practical tools (joint protection), and involving specialists (occupational therapy) empower the client. False reassurance about medications preventing *all* deformities is inappropriate.","rationaleCorrectZh":"肯定恐惧、提供实用工具（关节保护）和邀请专家（职业治疗）能赋予患者力量。关于药物能防止*所有*畸形的虚假安慰是不合适的。","testTakingStrategyEn":"Focus on empowerment and realistic goal setting rather than false hope.","testTakingStrategyZh":"专注于赋权和设定现实的目标，而不是虚假的希望。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":997,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_adapt_10","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_adapt_10_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.767.caseStudy.questions.2","itemType":"multiple_choice","category":"Psychosocial Integrity","topic":"Therapeutic Communication","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.767.caseStudy.questions.2.stem.en","stemPathZh":"questions.767.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,71],"terminalOffsetsZh":[0,23],"fullStemEn":"Which statement by the nurse best addresses the client's use of denial?","fullStemZh":"护士的哪句话能最好地应对患者对否认机制的使用？","terminalSentenceEn":"Which statement by the nurse best addresses the client's use of denial?","terminalSentenceZh":"护士的哪句话能最好地应对患者对否认机制的使用？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"o2","en":"'Denial is a normal first step, but you need to move past it now.'","zh":"“否认是一个正常的第一步，但您现在需要克服它。”"},{"id":"o1","en":"'If you keep pretending you don't have RA, your joints will get worse.'","zh":"“如果您继续假装没有RA，您的关节会变得更糟。”"},{"id":"o3","en":"'It is common to want to ignore a new diagnosis. Let's talk about what makes it hardest to accept.'","zh":"“想要忽视一个新的诊断是很常见的。我们来谈谈是什么让它最难被接受。”"},{"id":"o4","en":"'You have a mild case, so there is no need to worry right now.'","zh":"“您的病情很轻微，所以现在没有必要担心。”"}],"correct":["o3"]},"rationaleCorrectEn":"This response normalizes the feeling (validates) while gently inviting the client to explore the underlying fears preventing acceptance.","rationaleCorrectZh":"这种回应将感受正常化（肯定），同时温和地邀请患者探索阻碍其接受的深层恐惧。","testTakingStrategyEn":"Select therapeutic communication that neither confronts denial aggressively nor supports it, but explores it.","testTakingStrategyZh":"选择不激进对抗也不支持否认，而是去探索否认的治疗性沟通方式。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":998,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_adapt_10","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_adapt_10_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.767.caseStudy.questions.3","itemType":"dropdown_cloze","category":"Psychosocial Integrity","topic":"Therapeutic Communication","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.767.caseStudy.questions.3.stem.en","stemPathZh":"questions.767.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,42],"terminalOffsetsZh":[0,7],"fullStemEn":"The client attends follow-up appointments.","fullStemZh":"患者按时复诊。","terminalSentenceEn":"The client attends follow-up appointments.","terminalSentenceZh":"患者按时复诊。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse evaluates successful adaptation to the illness if the client is observed {{1}} and states she has {{2}}.","zh":"如果观察到患者 {{1}} 并表示她已经 {{2}}，护士可评估其成功适应了疾病。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"using adaptive computer equipment for work","zh":"在工作中使用自适应电脑设备"},{"id":"o2","en":"wearing gloves to hide her hands","zh":"戴着手套以隐藏她的手"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"decided to quit her job as a designer","zh":"决定辞去设计师的工作"},{"id":"o1","en":"taken her prescribed medications every day","zh":"每天按时服用处方药"}],"correct":"o1"}]},"rationaleCorrectEn":"Adaptation means integrating the illness into life (taking meds) and modifying routines to maintain function (using adaptive equipment).","rationaleCorrectZh":"适应意味着将疾病融入生活（服药）并改变日常习惯以保持功能（使用辅助设备）。","testTakingStrategyEn":"Look for behaviors that indicate proactive coping, problem-solving, and adherence to treatment.","testTakingStrategyZh":"寻找表明积极应对、解决问题和遵守治疗的行为。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":999,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"opus_agvd_case_agvhd_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.768","itemType":"case_study","category":"Physiological Adaptation","topic":"Oncology & Immunotherapy Complications","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.768.stem.en","stemPathZh":"questions.768.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[1135,1287],"terminalOffsetsZh":[317,350],"fullStemEn":"Acute graft-versus-host disease following allogeneic hematopoietic stem cell transplantation A 52-year-old woman with a history of acute myeloid leukemia in first complete remission underwent a matched unrelated donor allogeneic hematopoietic stem cell transplant twenty-six days ago. Her conditioning regimen was myeloablative with busulfan and cyclophosphamide. Her graft-versus-host disease prophylaxis consists of tacrolimus administered as a continuous intravenous infusion, titrated to a target trough of 10 to 15 ng/mL, and methotrexate, which was completed per protocol on days one, three, six, and eleven post-transplant. She achieved neutrophil engraftment on day fourteen. She has a triple-lumen central venous catheter in the right internal jugular vein. Current orders include tacrolimus continuous infusion, acyclovir for viral prophylaxis, fluconazole for antifungal prophylaxis, trimethoprim-sulfamethoxazole on weekends for Pneumocystis prophylaxis, and a platelet transfusion threshold of 10 ×10³/µL. She is on a regular diet, ambulating on the unit, and has been tolerating oral intake well until the current shift. She is readmitted to the bone marrow transplant unit from the outpatient transplant clinic after reporting new symptoms over the past forty-eight hours.","fullStemZh":"异基因造血干细胞移植后急性移植物抗宿主病 患者为52岁女性，有急性髓系白血病（首次完全缓解）病史，于26天前接受了非血缘供者异基因造血干细胞移植。其预处理方案为白消安联合环磷酰胺的清髓性方案。预防移植物抗宿主病的方案包括：他克莫司持续静脉泵入（目标谷浓度为10至15 ng/mL），以及甲氨蝶呤（已按方案在移植后第1、3、6和11天完成给药）。患者于移植后第14天实现中性粒细胞植入。右侧颈内静脉置有三腔中心静脉导管。当前医嘱包括：他克莫司持续泵入，阿昔洛韦预防病毒感染，氟康唑预防真菌感染，周末口服复方磺胺甲噁唑预防肺孢子菌，以及血小板输注阈值为 10 ×10³/µL。患者进食普食，可在病房内活动，在此次交班前对经口进食耐受良好。因过去48小时内出现新发症状，患者从移植门诊再次收入骨髓移植病房。","terminalSentenceEn":"She is readmitted to the bone marrow transplant unit from the outpatient transplant clinic after reporting new symptoms over the past forty-eight hours.","terminalSentenceZh":"因过去48小时内出现新发症状，患者从移植门诊再次收入骨髓移植病房。","penultimateSentenceEn":"She is on a regular diet, ambulating on the unit, and has been tolerating oral intake well until the current shift.","penultimateSentenceZh":"患者进食普食，可在病房内活动，在此次交班前对经口进食耐受良好。","responseContext":{},"rationaleCorrectEn":"This case requires recognizing the triad of acute graft-versus-host disease (rash, diarrhea, liver involvement), prioritizing hemodynamic stability, and managing medication toxicities in the post-transplant period.","rationaleCorrectZh":"本案例要求识别急性移植物抗宿主病的三联征（皮疹、腹泻、肝脏受累），优先考虑血流动力学稳定性，并在移植后期间管理药物毒性。","testTakingStrategyEn":"For unfolding complications, differentiate between primary disease progression and iatrogenic medication side effects to determine the correct nursing priority.","testTakingStrategyZh":"对于不断发展的并发症，需区分原发病进展和医源性药物副作用，以确定正确的护理优先级。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1000,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"opus_agvd_case_agvhd_01","embeddedQuestionId":"opus_agvd_case_agvhd_01_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.768.caseStudy.questions.0","itemType":"multiple_choice","category":"Physiological Adaptation","topic":"Sepsis & Septic Shock","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.768.caseStudy.questions.0.stem.en","stemPathZh":"questions.768.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[341,399],"terminalOffsetsZh":[95,111],"fullStemEn":"At Stage 1, after infectious stool studies and viral PCRs return negative and the tacrolimus trough is found to be subtherapeutic, the nurse must analyze the cluster of findings (new maculopapular rash on acral surfaces, high-volume watery diarrhea, mildly elevated bilirubin with rising liver enzymes, and onset at day 26 post-transplant). Which conclusion is best supported by these clinical data?","fullStemZh":"在阶段 1，感染性粪便检查和病毒PCR结果呈阴性，且他克莫司谷浓度低于治疗水平后，护士必须分析这一系列发现（肢端新发斑丘疹、大量水样泻、胆红素轻度升高伴肝酶升高，以及在移植后第26天发病）。以下哪项结论最符合这些临床数据？","terminalSentenceEn":"Which conclusion is best supported by these clinical data?","terminalSentenceZh":"以下哪项结论最符合这些临床数据？","penultimateSentenceEn":"At Stage 1, after infectious stool studies and viral PCRs return negative and the tacrolimus trough is found to be subtherapeutic, the nurse must analyze the cluster of findings (new maculopapular rash on acral surfaces, high-volume watery diarrhea, mildly elevated bilirubin with rising liver enzymes, and onset at day 26 post-transplant).","penultimateSentenceZh":"在阶段 1，感染性粪便检查和病毒PCR结果呈阴性，且他克莫司谷浓度低于治疗水平后，护士必须分析这一系列发现（肢端新发斑丘疹、大量水样泻、胆红素轻度升高伴肝酶升高，以及在移植后第26天发病）。","responseContext":{"type":"multiple_choice","options":[{"id":"q1_opt_b","en":"The patient has developed a delayed Clostridioides difficile infection that requires empiric antibiotic therapy until repeat testing.","zh":"患者发生了迟发性艰难梭菌感染，在复查确认前需要经验性抗生素治疗。"},{"id":"q1_opt_c","en":"The presentation represents a severe allergic drug reaction to prophylactic medications requiring their immediate discontinuation.","zh":"该表现代表了对预防性药物的严重过敏性药物反应，需要立即停药。"},{"id":"q1_opt_d","en":"The symptoms indicate engraftment syndrome, expected during the first month following allogeneic transplantation.","zh":"症状提示植入综合征，这在异基因移植后第一个月内属于预期现象。"},{"id":"q1_opt_a","en":"The patient is experiencing acute graft-versus-host disease (aGVHD) involving the skin, gastrointestinal tract, and liver.","zh":"患者正经历累及皮肤、胃肠道和肝脏的急性移植物抗宿主病（aGVHD）。"}],"correct":["q1_opt_a"]},"rationaleCorrectEn":"The nurse recognizes that the constellation of rash predominantly on palms, soles, and ears, combined with voluminous watery diarrhea and cholestatic liver enzyme elevation, arising in the third to fourth week after allogeneic transplant with a subtherapeutic immunosuppressant level, is the classic triad of acute graft-versus-host disease (aGVHD) involving skin, gastrointestinal tract, and liver. The negative infectious workup further supports this conclusion.","rationaleCorrectZh":"护士应认识到，主要分布在手掌、足底和耳朵的皮疹，加上大量水样泻和胆汁淤积性肝酶升高，且发生在异基因移植后第三到第四周，伴随免疫抑制剂浓度低于治疗水平，这是累及皮肤、胃肠道和肝脏的急性移植物抗宿主病（aGVHD）的典型三联征。感染性检查阴性进一步支持了这一结论。","testTakingStrategyEn":"When analyzing symptom clusters, look for the unifying diagnosis that explains all findings. Only aGVHD explains the specific combination of acral rash, secretory diarrhea, and hepatic involvement in a patient with a subtherapeutic tacrolimus level.","testTakingStrategyZh":"在分析症状群时，寻找能解释所有发现的统一诊断。在一名他克莫司浓度低于治疗水平的患者中，只有aGVHD能解释肢端皮疹、分泌性腹泻和肝脏受累的特定组合。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1001,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"opus_agvd_case_agvhd_01","embeddedQuestionId":"opus_agvd_case_agvhd_01_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.768.caseStudy.questions.1","itemType":"multiple_choice","category":"Physiological Adaptation","topic":"Electrolyte Imbalances","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.768.caseStudy.questions.1.stem.en","stemPathZh":"questions.768.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[155,231],"terminalOffsetsZh":[58,80],"fullStemEn":"At Stage 1, before high-dose corticosteroids are administered, the nurse reviews the repeat electrolyte values (potassium 3.1 mEq/L, magnesium 1.4 mg/dL). Which action is the highest priority for the nurse regarding these findings?","fullStemZh":"在阶段 1，在给予大剂量皮质类固醇之前，护士查看了复查的电解质值（钾 3.1 mEq/L，镁 1.4 mg/dL）。针对这些发现，护士最优先采取的操作是哪一项？","terminalSentenceEn":"Which action is the highest priority for the nurse regarding these findings?","terminalSentenceZh":"针对这些发现，护士最优先采取的操作是哪一项？","penultimateSentenceEn":"At Stage 1, before high-dose corticosteroids are administered, the nurse reviews the repeat electrolyte values (potassium 3.1 mEq/L, magnesium 1.4 mg/dL).","penultimateSentenceZh":"在阶段 1，在给予大剂量皮质类固醇之前，护士查看了复查的电解质值（钾 3.1 mEq/L，镁 1.4 mg/dL）。","responseContext":{"type":"multiple_choice","options":[{"id":"q2_opt_b","en":"Document the findings and plan to address the mildly low potassium with dietary supplementation.","zh":"记录这些发现，并计划通过饮食补充来纠正轻度偏低的血钾。"},{"id":"q2_opt_d","en":"Administer the methylprednisolone as ordered and monitor the next scheduled metabolic panel.","zh":"按医嘱给予甲泼尼龙，并监测下一次预定的代谢盘检查结果。"},{"id":"q2_opt_c","en":"Hold the ordered methylprednisolone until the electrolyte imbalances spontaneously correct.","zh":"暂停已开具的甲泼尼龙，直至电解质失衡自行纠正。"},{"id":"q2_opt_a","en":"Promptly communicate the findings to the provider to obtain orders for intravenous electrolyte replacement.","zh":"及时将结果告知医生，以获取静脉补充电解质的医嘱。"}],"correct":["q2_opt_a"]},"rationaleCorrectEn":"The nurse recognizes that hypokalemia and hypomagnesemia in the setting of ongoing diarrheal losses require prompt intravenous or protocol-based replacement, especially because impending high-dose corticosteroids will further exacerbate renal potassium wasting. Magnesium repletion is also necessary to correct the potassium deficit effectively.","rationaleCorrectZh":"护士应认识到，在持续腹泻流失的背景下，低钾血症和低镁血症需要及时进行静脉或基于方案的补充，特别是因为即将使用的大剂量皮质类固醇将进一步加剧肾脏钾的流失。补充镁也是有效纠正缺钾所必需的。","testTakingStrategyEn":"Recognize the compounding effect of medications. Corticosteroids lower potassium. A borderline low potassium will drop further once steroids are started, making proactive IV replacement an urgent priority.","testTakingStrategyZh":"认识药物的叠加效应。皮质类固醇会降低血钾。一旦开始使用类固醇，临界偏低的血钾将进一步下降，因此主动的静脉补充成为紧急的优先事项。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1002,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"opus_agvd_case_agvhd_01","embeddedQuestionId":"opus_agvd_case_agvhd_01_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.768.caseStudy.questions.2","itemType":"multiple_choice","category":"Management of Care","topic":"Prioritization & Delegation","difficulty":"hard","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.768.caseStudy.questions.2.stem.en","stemPathZh":"questions.768.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[313,382],"terminalOffsetsZh":[109,128],"fullStemEn":"At Stage 2, the nurse assesses worsening vital signs (heart rate 118, blood pressure 92/56, reduced urine output of 180 mL over 8 hours) alongside escalating stool output with visible blood, a rising creatinine, supratherapeutic tacrolimus level, hyperglycemia, worsening bilirubin, and a hemoglobin of 7.9 g/dL. Which problem is the highest priority for the nurse to address first?","fullStemZh":"在阶段 2，护士评估发现生命体征恶化（心率118，血压92/56，过去8小时尿量减少至180 mL），同时粪便量增加且肉眼可见血液、肌酐升高、他克莫司浓度高于治疗水平、高血糖、胆红素恶化，以及血红蛋白7.9 g/dL。护士应优先解决的最高级别问题是哪一项？","terminalSentenceEn":"Which problem is the highest priority for the nurse to address first?","terminalSentenceZh":"护士应优先解决的最高级别问题是哪一项？","penultimateSentenceEn":"At Stage 2, the nurse assesses worsening vital signs (heart rate 118, blood pressure 92/56, reduced urine output of 180 mL over 8 hours) alongside escalating stool output with visible blood, a rising creatinine, supratherapeutic tacrolimus level, hyperglycemia, worsening bilirubin, and a hemoglobin of 7.9 g/dL.","penultimateSentenceZh":"在阶段 2，护士评估发现生命体征恶化（心率118，血压92/56，过去8小时尿量减少至180 mL），同时粪便量增加且肉眼可见血液、肌酐升高、他克莫司浓度高于治疗水平、高血糖、胆红素恶化，以及血红蛋白7.9 g/dL。","responseContext":{"type":"multiple_choice","options":[{"id":"q3_opt_d","en":"Decreased tissue perfusion related to dropping hemoglobin.","zh":"与血红蛋白下降相关的组织灌注减少。"},{"id":"q3_opt_a","en":"Hemodynamic instability from hypovolemia.","zh":"低血容量导致的血流动力学不稳定。"},{"id":"q3_opt_c","en":"Steroid-induced hyperglycemia.","zh":"类固醇诱导的高血糖。"},{"id":"q3_opt_b","en":"Supratherapeutic tacrolimus level with nephrotoxicity.","zh":"他克莫司浓度高于治疗水平并伴有肾毒性。"}],"correct":["q3_opt_a"]},"rationaleCorrectEn":"The nurse prioritizes the hemodynamic instability from hypovolemia as the most immediately life-threatening problem. The tachycardia, hypotension, oliguria, dry mucous membranes, and decreased skin turgor indicate significant intravascular volume depletion requiring immediate intervention.","rationaleCorrectZh":"护士应将低血容量引起的血流动力学不稳定作为最直接危及生命的问题优先处理。心动过速、低血压、少尿、黏膜干燥和皮肤弹性下降表明存在显著的血管内容量不足，需要立即干预。","testTakingStrategyEn":"Apply the ABCs (Airway, Breathing, Circulation) and prioritize unstable over stable. Tachycardia and hypotension indicate a Circulation problem (hypovolemia) that is actively threatening end-organ perfusion and requires immediate rescue.","testTakingStrategyZh":"应用 ABC 原则（气道、呼吸、循环），并优先处理不稳定状况而非稳定状况。心动过速和低血压表明存在循环问题（低血容量），这正严重威胁终末器官灌注，需要立即抢救。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1003,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"opus_agvd_case_agvhd_01","embeddedQuestionId":"opus_agvd_case_agvhd_01_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.768.caseStudy.questions.3","itemType":"multiple_choice","category":"Pharmacological and Parenteral Therapies","topic":"Medication Safety & Admin","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.768.caseStudy.questions.3.stem.en","stemPathZh":"questions.768.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[179,203],"terminalOffsetsZh":[63,74],"fullStemEn":"At Stage 2, with the tacrolimus trough of 18.4 ng/mL and a creatinine rising from 1.0 to 1.6 mg/dL, the nurse determines the appropriate action regarding the tacrolimus infusion. Which action is correct?","fullStemZh":"在阶段 2，他克莫司谷浓度为18.4 ng/mL，且肌酐从1.0升至1.6 mg/dL，护士需确定针对他克莫司输注的适当操作。以下哪项操作是正确的？","terminalSentenceEn":"Which action is correct?","terminalSentenceZh":"以下哪项操作是正确的？","penultimateSentenceEn":"At Stage 2, with the tacrolimus trough of 18.4 ng/mL and a creatinine rising from 1.0 to 1.6 mg/dL, the nurse determines the appropriate action regarding the tacrolimus infusion.","penultimateSentenceZh":"在阶段 2，他克莫司谷浓度为18.4 ng/mL，且肌酐从1.0升至1.6 mg/dL，护士需确定针对他克莫司输注的适当操作。","responseContext":{"type":"multiple_choice","options":[{"id":"q4_opt_b","en":"Independently discontinue the tacrolimus infusion to prevent permanent renal damage.","zh":"自行停止他克莫司输注，以防止永久性肾脏损伤。"},{"id":"q4_opt_c","en":"Maintain the current tacrolimus infusion rate, as the rising creatinine is solely due to hypovolemia.","zh":"维持当前的他克莫司输注速率，因为肌酐升高完全是由于低血容量引起的。"},{"id":"q4_opt_a","en":"Reduce the tacrolimus infusion rate per the provider order and closely monitor urine output.","zh":"按照医生医嘱降低他克莫司的输注速率，并密切监测尿量。"},{"id":"q4_opt_d","en":"Administer a loop diuretic to counteract the tacrolimus-induced nephrotoxicity.","zh":"给予袢利尿剂以对抗他克莫司诱导的肾毒性。"}],"correct":["q4_opt_a"]},"rationaleCorrectEn":"The nurse should reduce the tacrolimus infusion rate per the provider order, monitor urine output and fluid balance, and anticipate repeat trough levels. Tacrolimus is a narrow-therapeutic-index calcineurin inhibitor; its supratherapeutic level contributes to acute kidney injury through renal vasoconstriction. Risk factors here are multifactorial, including hypovolemia from diarrhea, the recent rate increase, hepatic dysfunction impairing metabolism, and concomitant fluconazole prophylaxis. The medication must not be independently discontinued due to the high risk of triggering an aGVHD flare.","rationaleCorrectZh":"护士应按医生医嘱降低他克莫司输注速率，监测尿量和液体平衡，并预期复查谷浓度。他克莫司是一种治疗指数狭窄的钙调磷酸酶抑制剂；其超治疗水平的浓度会通过肾血管收缩加剧急性肾损伤。此处的风险因素是多方面的，包括腹泻引起的低血容量、近期的输注速率增加、肝功能不全导致代谢减慢，以及同时预防性使用氟康唑。由于存在引发aGVHD发作的高风险，绝不能擅自停用该药物。","testTakingStrategyEn":"Remember nursing scope of practice. Nurses do not independently discontinue critical immunosuppressants without an order. A dose reduction addresses the toxicity while adhering to prescribed protocols.","testTakingStrategyZh":"牢记护理执业范围。护士不能在没有医嘱的情况下自行停用关键的免疫抑制剂。减少剂量既处理了毒性，又遵循了既定方案。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1004,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"opus_agvd_case_agvhd_01","embeddedQuestionId":"opus_agvd_case_agvhd_01_q5","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.768.caseStudy.questions.4","itemType":"multiple_choice","category":"Management of Care","topic":"Prioritization & Delegation","difficulty":"hard","ngnSkill":"generate_solutions","stemPathEn":"questions.768.caseStudy.questions.4.stem.en","stemPathZh":"questions.768.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[75,163],"terminalOffsetsZh":[24,49],"fullStemEn":"At Stage 2, the nurse must coordinate multiple simultaneous interventions. Which action should the nurse initiate first among the concurrent interventions ordered?","fullStemZh":"在阶段 2，护士必须协调多项同时进行的干预措施。在已开具的各项并行医嘱中，护士应首先启动哪项操作？","terminalSentenceEn":"Which action should the nurse initiate first among the concurrent interventions ordered?","terminalSentenceZh":"在已开具的各项并行医嘱中，护士应首先启动哪项操作？","penultimateSentenceEn":"At Stage 2, the nurse must coordinate multiple simultaneous interventions.","penultimateSentenceZh":"在阶段 2，护士必须协调多项同时进行的干预措施。","responseContext":{"type":"multiple_choice","options":[{"id":"q5_opt_a","en":"Initiate the intravenous fluid bolus and place the patient on continuous cardiac monitoring.","zh":"开始静脉推注液体，并将患者置于持续心电监护下。"},{"id":"q5_opt_b","en":"Begin the potassium replacement infusion via a peripheral line.","zh":"通过外周静脉管路开始输注补充钾。"},{"id":"q5_opt_c","en":"Start the red blood cell transfusion.","zh":"开始红细胞输注。"},{"id":"q5_opt_d","en":"Check blood glucose and administer insulin per the sliding scale.","zh":"检查血糖并根据滑动标尺给予胰岛素。"}],"correct":["q5_opt_a"]},"rationaleCorrectEn":"The nurse should first initiate the intravenous fluid bolus and place the patient on continuous cardiac monitoring, as volume resuscitation and arrhythmia surveillance are the immediate safety priorities.","rationaleCorrectZh":"护士应首先开始静脉推注液体并将患者置于持续心电监护下，因为容量复苏和心律失常监测是当务之急的安全优先事项。","testTakingStrategyEn":"When prioritizing multiple critical actions, choose the one that stabilizes the cardiovascular system first. Fluid resuscitation restores the circulating volume needed for all other medications to safely reach their targets.","testTakingStrategyZh":"在对多项关键操作进行优先级排序时，首先选择能稳定心血管系统的操作。液体复苏能恢复循环容量，这是所有其他药物安全到达目标器官的必要条件。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1005,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"opus_agvd_case_agvhd_01","embeddedQuestionId":"opus_agvd_case_agvhd_01_q6","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.768.caseStudy.questions.5","itemType":"matrix","category":"Physiological Adaptation","topic":"Oncology & Immunotherapy Complications","difficulty":"hard","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.768.caseStudy.questions.5.stem.en","stemPathZh":"questions.768.caseStudy.questions.5.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[120,242],"terminalOffsetsZh":[38,74],"fullStemEn":"At Stage 3, after 48 hours of ruxolitinib and continued methylprednisolone, the nurse evaluates the patient's response. For each clinical finding, specify whether it indicates a therapeutic response or a finding requiring continued vigilance.","fullStemZh":"在阶段 3，在使用芦可替尼48小时并继续甲泼尼龙治疗后，护士评估患者的反应。对于下列各项临床发现，请指出其是表明有治疗反应，还是需要继续警惕的发现。","terminalSentenceEn":"For each clinical finding, specify whether it indicates a therapeutic response or a finding requiring continued vigilance.","terminalSentenceZh":"对于下列各项临床发现，请指出其是表明有治疗反应，还是需要继续警惕的发现。","penultimateSentenceEn":"At Stage 3, after 48 hours of ruxolitinib and continued methylprednisolone, the nurse evaluates the patient's response.","penultimateSentenceZh":"在阶段 3，在使用芦可替尼48小时并继续甲泼尼龙治疗后，护士评估患者的反应。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"row_stool","en":"Stool volume decreased to 900 mL/24h with no visible blood","zh":"24小时粪便量减少至900 mL，未见肉眼血液"},{"id":"row_rash","en":"Stabilization and fading of rash on upper chest and ears","zh":"上胸部和耳朵的皮疹稳定并消退"},{"id":"row_glucose","en":"Blood glucose of 162 mg/dL","zh":"血糖 162 mg/dL"},{"id":"row_bili","en":"Total bilirubin decreased to 2.4 mg/dL","zh":"总胆红素降至 2.4 mg/dL"},{"id":"row_immuno","en":"Absence of fever while on ruxolitinib and high-dose corticosteroids","zh":"在使用芦可替尼和大剂量皮质类固醇期间无发热"}],"columns":[{"id":"col_vigilance","en":"Requires Continued Vigilance","zh":"需要继续警惕"},{"id":"col_response","en":"Indicates Therapeutic Response","zh":"表明有治疗反应"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"row_stool","columnIds":["col_response"]},{"rowId":"row_rash","columnIds":["col_response"]},{"rowId":"row_glucose","columnIds":["col_vigilance"]},{"rowId":"row_bili","columnIds":["col_response"]},{"rowId":"row_immuno","columnIds":["col_vigilance"]}]},"rationaleCorrectEn":"The nurse correctly identifies that improvements in stool volume, rash extent, and bilirubin levels directly reflect resolution of the aGVHD. However, the nurse must remain vigilant about iatrogenic complications, such as steroid-induced hyperglycemia and the profound immunosuppression masked by the lack of a febrile response.","rationaleCorrectZh":"护士应正确识别粪便量、皮疹范围和胆红素水平的改善直接反映了aGVHD的缓解。然而，护士必须对医源性并发症保持警惕，如类固醇引起的高血糖，以及被无发热反应所掩盖的严重免疫抑制。","testTakingStrategyEn":"Separate the primary disease markers from the treatment side effects. Improvements in the main targets of aGVHD (skin, GI, liver) show therapeutic response. Any remaining abnormalities related to the harsh treatments (steroids, intense immunosuppressants) require vigilance.","testTakingStrategyZh":"将主要疾病标志物与治疗副作用区分开来。aGVHD主要靶向器官（皮肤、胃肠道、肝脏）的改善表明有治疗反应。而任何与强烈治疗（类固醇、强效免疫抑制剂）相关的遗留异常都需要保持警惕。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1006,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"fhr_gemini_smoke_2026_06_13_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.769","itemType":"multiple_choice","category":"Reduction of Risk Potential","topic":"Intrapartum Fetal Monitoring","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.769.stem.en","stemPathZh":"questions.769.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[125,205],"terminalOffsetsZh":[41,62],"fullStemEn":"The nurse is monitoring a client in active labor. Maternal vital signs are stable, and oxygen saturation is 99% on room air. Based on the fetal monitoring tracing below, which action should the nurse take?","fullStemZh":"护士正在监测一名处于活跃期的产妇。产妇生命体征平稳，室内空气下血氧饱和度为99%。根据下面的胎儿监护图，护士应采取哪项措施？","terminalSentenceEn":"Based on the fetal monitoring tracing below, which action should the nurse take?","terminalSentenceZh":"根据下面的胎儿监护图，护士应采取哪项措施？","penultimateSentenceEn":"Maternal vital signs are stable, and oxygen saturation is 99% on room air.","penultimateSentenceZh":"产妇生命体征平稳，室内空气下血氧饱和度为99%。","responseContext":{"type":"multiple_choice","options":[{"id":"B","en":"Administer oxygen by nonrebreather mask.","zh":"通过非重复呼吸面罩给氧。"},{"id":"D","en":"Prepare the client for an amnioinfusion.","zh":"为患者准备羊膜腔灌注。"},{"id":"A","en":"Continue routine monitoring.","zh":"继续常规监测。"},{"id":"C","en":"Notify the healthcare provider immediately.","zh":"立即通知医疗保健提供者。"}],"correct":["A"]},"rationaleCorrectEn":"The tracing shows a baseline of 140 bpm with moderate variability, accelerations, and no late or variable decelerations. This is a Category I, reassuring tracing. The correct action is to continue routine monitoring.","rationaleCorrectZh":"图形显示基线为140 bpm，具有中等变异和加速，无晚期或变异减速。这是I类（安心型）图形。正确的措施是继续常规监测。","testTakingStrategyEn":"Identify moderate variability and accelerations, which are reassuring signs and make clinically significant fetal acidemia unlikely.","testTakingStrategyZh":"识别中等变异和加速，这些是令人安心的迹象，使具有临床意义的胎儿酸血症的可能性降低。","sourceMetadata":"NICHD 2008 standardized fetal monitoring nomenclature; ACOG intrapartum fetal heart rate monitoring guidance; AWHONN Fetal Heart Monitoring Principles and Practices, 6th ed.","mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1007,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"fhr_gemini_smoke_2026_06_13_02","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.770","itemType":"multiple_choice","category":"Reduction of Risk Potential","topic":"Intrapartum Fetal Monitoring","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.770.stem.en","stemPathZh":"questions.770.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[95,149],"terminalOffsetsZh":[31,46],"fullStemEn":"A client in active labor is being monitored continuously. The nurse reviews the tracing below. Which interpretation of this finding is most accurate?","fullStemZh":"一名处于活跃期的产妇正在接受持续监测。护士查看了下面的监护图。对这一发现最准确的解释是什么？","terminalSentenceEn":"Which interpretation of this finding is most accurate?","terminalSentenceZh":"对这一发现最准确的解释是什么？","penultimateSentenceEn":"The nurse reviews the tracing below.","penultimateSentenceZh":"护士查看了下面的监护图。","responseContext":{"type":"multiple_choice","options":[{"id":"D","en":"This pattern requires immediate intrauterine resuscitation.","zh":"这种模式需要立即进行宫内复苏。"},{"id":"B","en":"This pattern indicates uteroplacental insufficiency.","zh":"这种模式提示子宫胎盘功能不全。"},{"id":"C","en":"This pattern is caused by umbilical cord compression.","zh":"这种模式是由脐带受压引起的。"},{"id":"A","en":"This is a benign pattern caused by fetal head compression.","zh":"这是一种由胎头受压引起的良性模式。"}],"correct":["A"]},"rationaleCorrectEn":"The tracing shows decelerations that have a gradual onset and mirror the contraction, with the nadir aligning with the contraction peak. These are early decelerations, which are a benign finding caused by fetal head compression.","rationaleCorrectZh":"图形显示减速的发生是逐渐的，且与宫缩同步，其最低点与宫缩峰值对齐。这是早期减速，是由胎头受压引起的一种良性发现。","testTakingStrategyEn":"Look at the timing of the lowest point (nadir) of the deceleration relative to the contraction peak.","testTakingStrategyZh":"观察减速最低点与宫缩峰值的相对时间关系。","sourceMetadata":"NICHD 2008 standardized fetal monitoring nomenclature; ACOG intrapartum fetal heart rate monitoring guidance; AWHONN Fetal Heart Monitoring Principles and Practices, 6th ed.","mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1008,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"fhr_gemini_smoke_2026_06_13_03","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.771","itemType":"multiple_choice","category":"Reduction of Risk Potential","topic":"Intrapartum Fetal Monitoring","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.771.stem.en","stemPathZh":"questions.771.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[124,210],"terminalOffsetsZh":[41,64],"fullStemEn":"A client at 40 weeks' gestation is receiving a continuous oxytocin infusion. Maternal oxygen saturation is 98% on room air. Based on the fetal monitoring tracing below, which action should the nurse take first?","fullStemZh":"一名妊娠40周的患者正在持续静脉输注缩宫素。产妇在室内空气下的血氧饱和度为98%。根据下面的胎儿监护图，护士应首先采取哪项措施？","terminalSentenceEn":"Based on the fetal monitoring tracing below, which action should the nurse take first?","terminalSentenceZh":"根据下面的胎儿监护图，护士应首先采取哪项措施？","penultimateSentenceEn":"Maternal oxygen saturation is 98% on room air.","penultimateSentenceZh":"产妇在室内空气下的血氧饱和度为98%。","responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Discontinue the oxytocin infusion and assist the client to a lateral position.","zh":"停止缩宫素输注并协助患者采取侧卧位。"},{"id":"C","en":"Prepare the client for immediate cesarean birth.","zh":"为患者准备立即剖宫产。"},{"id":"D","en":"Document the findings and reevaluate in 15 minutes.","zh":"记录结果并在15分钟后重新评估。"},{"id":"B","en":"Apply oxygen by nonrebreather mask at 10 L/minute.","zh":"通过非重复呼吸面罩以10升/分钟给氧。"}],"correct":["A"]},"rationaleCorrectEn":"The tracing demonstrates recurrent late decelerations with minimal variability. The priority intervention is intrauterine resuscitation to improve placental perfusion, which includes stopping the oxytocin infusion (the stressor) and repositioning the client laterally.","rationaleCorrectZh":"图形显示伴有微小变异的反复晚期减速。首要干预措施是进行宫内复苏以改善胎盘灌注，包括停止缩宫素输注（应激源）并协助患者转为侧卧位。","testTakingStrategyEn":"When oxytocin is infusing and late decelerations appear, first remove that uterine stressor and reposition the client.","testTakingStrategyZh":"当缩宫素正在输注且出现晚期减速时，首先去除该子宫应激源并为患者重新摆位。","sourceMetadata":"NICHD 2008 standardized fetal monitoring nomenclature; ACOG intrapartum fetal heart rate monitoring guidance; AWHONN Fetal Heart Monitoring Principles and Practices, 6th ed.","mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1009,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"fhr_gemini_smoke_2026_06_13_04","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.772","itemType":"select_all","category":"Reduction of Risk Potential","topic":"Intrapartum Fetal Monitoring","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.772.stem.en","stemPathZh":"questions.772.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[238,260],"terminalOffsetsZh":[68,77],"fullStemEn":"Immediately after spontaneous rupture of membranes, the nurse reviews the fetal monitoring tracing of a client in active labor. The client's oxygen saturation is 99% on room air. Which interventions are appropriate based on the findings? Select all that apply.","fullStemZh":"在胎膜自然破裂后，护士立即查看了一名处于活跃期产妇的胎儿监护图。该患者在室内空气下的血氧饱和度为99%。根据发现，哪些干预措施是合适的？请选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"请选择所有适用项。","penultimateSentenceEn":"Which interventions are appropriate based on the findings?","penultimateSentenceZh":"根据发现，哪些干预措施是合适的？","responseContext":{"type":"select_all","options":[{"id":"D","en":"Evaluate for umbilical cord prolapse.","zh":"评估是否发生脐带脱垂。"},{"id":"E","en":"Prepare for an immediate cesarean birth without attempting other measures.","zh":"准备立即进行剖宫产，不尝试其他措施。"},{"id":"A","en":"Assist the client into a knee-chest or lateral position.","zh":"协助患者采取胸膝卧位或侧卧位。"},{"id":"C","en":"Administer oxygen via nonrebreather mask.","zh":"通过非重复呼吸面罩给氧。"},{"id":"B","en":"Notify the healthcare provider.","zh":"通知医疗保健提供者。"}],"correct":["A","B","D"]},"rationaleCorrectEn":"The tracing shows variable decelerations, which are abrupt drops in the fetal heart rate caused by umbilical cord compression. Appropriate initial interventions include maternal repositioning to relieve pressure on the cord, evaluating for cord prolapse, and notifying the provider.","rationaleCorrectZh":"图形显示变异减速，即由脐带受压引起的胎心率突然下降。合适的初始干预措施包括改变产妇体位以减轻脐带压力、评估脐带脱垂情况并通知提供者。","testTakingStrategyEn":"Variable decelerations are abrupt and 'V' or 'W' shaped. They indicate cord compression. Focus on actions that relieve pressure on the umbilical cord.","testTakingStrategyZh":"变异减速是突然发生的，呈“V”形或“W”形，提示脐带受压。重点关注能减轻脐带压力的措施。","sourceMetadata":"NICHD 2008 standardized fetal monitoring nomenclature; ACOG intrapartum fetal heart rate monitoring guidance; AWHONN Fetal Heart Monitoring Principles and Practices, 6th ed.","mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"Which interventions are appropriate based on the findings?","controlSentenceZh":"根据发现，哪些干预措施是合适的？"}
{"queueIndex":1010,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"fhr_gemini_smoke_2026_06_13_05","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.773","itemType":"matrix","category":"Reduction of Risk Potential","topic":"Intrapartum Fetal Monitoring","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.773.stem.en","stemPathZh":"questions.773.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[252,337],"terminalOffsetsZh":[71,91],"fullStemEn":"Fifteen minutes after epidural placement, the nurse is caring for a laboring client. The client's blood pressure has decreased slightly from baseline, and oxygen saturation is 99% on room air. The nurse observes the following fetal monitoring tracing. For each potential intervention, indicate whether it is appropriate or inappropriate.","fullStemZh":"硬膜外麻醉置管15分钟后，护士正在护理一名处于产程中的患者。患者的血压较基线轻微下降，室内空气下血氧饱和度为99%。护士观察到以下胎儿监护图。对于每项潜在干预措施，请指出其是否合适。","terminalSentenceEn":"For each potential intervention, indicate whether it is appropriate or inappropriate.","terminalSentenceZh":"对于每项潜在干预措施，请指出其是否合适。","penultimateSentenceEn":"The nurse observes the following fetal monitoring tracing.","penultimateSentenceZh":"护士观察到以下胎儿监护图。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Administering an IV fluid bolus","zh":"静脉快速输液"},{"id":"r2","en":"Administering oxygen via nonrebreather mask","zh":"通过非重复呼吸面罩给氧"},{"id":"r3","en":"Repositioning the client","zh":"为患者重新摆位"},{"id":"r4","en":"Continuing routine monitoring without intervention","zh":"继续常规监测而不采取干预"}],"columns":[{"id":"c1","en":"Appropriate","zh":"合适"},{"id":"c2","en":"Inappropriate","zh":"不合适"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c2"]}]},"rationaleCorrectEn":"The tracing shows a prolonged deceleration (a drop in FHR of ≥15 bpm lasting ≥2 minutes but <10 minutes). This requires immediate intrauterine resuscitation to improve fetal oxygenation and uteroplacental perfusion. Appropriate actions include repositioning the client and administering an IV fluid bolus. Routine oxygen is not recommended for a normoxic mother, and doing nothing is inappropriate.","rationaleCorrectZh":"图形显示延长减速（胎心率下降≥15 bpm，持续时间≥2分钟但<10分钟）。这需要立即进行宫内复苏，以改善胎儿氧合和子宫胎盘灌注。合适的措施包括为患者重新摆位和静脉快速输液。对于血氧正常的产妇，不推荐常规给氧，不采取任何措施是不合适的。","testTakingStrategyEn":"Recognize that a deceleration lasting more than 2 minutes is prolonged. Intervention is mandatory. Focus on core resuscitation measures while avoiding unnecessary oxygen in a stable, normoxic mother.","testTakingStrategyZh":"认识到持续超过2分钟的减速属于延长减速。必须进行干预。重点关注核心复苏措施，同时避免在生命体征平稳、血氧正常的产妇身上进行不必要的给氧。","sourceMetadata":"NICHD 2008 standardized fetal monitoring nomenclature; ACOG intrapartum fetal heart rate monitoring guidance; AWHONN Fetal Heart Monitoring Principles and Practices, 6th ed.","mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1011,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"fhr_gemini_smoke_2026_06_13_06","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.774","itemType":"matrix","category":"Reduction of Risk Potential","topic":"Intrapartum Fetal Monitoring","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.774.stem.en","stemPathZh":"questions.774.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[69,132],"terminalOffsetsZh":[19,40],"fullStemEn":"The nurse reviews the fetal monitoring tracing of a client in labor. Determine if each statement about the tracing is true or false.","fullStemZh":"护士查看了一名产程中患者的胎儿监护图。判断关于该图形的每一项陈述是正确还是错误。","terminalSentenceEn":"Determine if each statement about the tracing is true or false.","terminalSentenceZh":"判断关于该图形的每一项陈述是正确还是错误。","penultimateSentenceEn":"The nurse reviews the fetal monitoring tracing of a client in labor.","penultimateSentenceZh":"护士查看了一名产程中患者的胎儿监护图。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Fetal heart rate variability is absent.","zh":"胎心率变异消失。"},{"id":"r2","en":"The baseline fetal heart rate is within the expected normal range.","zh":"基线胎心率在预期的正常范围内。"},{"id":"r3","en":"This tracing is predictive of normal fetal acid-base status.","zh":"该图形预示正常的胎儿酸碱状态。"},{"id":"r4","en":"This pattern requires immediate intrauterine resuscitation.","zh":"这种模式需要立即进行宫内复苏。"}],"columns":[{"id":"c2","en":"False","zh":"错误"},{"id":"c1","en":"True","zh":"正确"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c1"]}]},"rationaleCorrectEn":"The tracing demonstrates bradycardia (baseline ~95 bpm) and absent variability. This is a Category III tracing, which is predictive of abnormal fetal acid-base status and requires immediate intrauterine resuscitation and potential expedited delivery.","rationaleCorrectZh":"图形显示心动过缓（基线约95 bpm）和变异消失。这是III类图形，预示胎儿酸碱状态异常，需要立即进行宫内复苏并可能需要紧急分娩。","testTakingStrategyEn":"Systematically assess the baseline rate and variability. A baseline under 110 bpm is bradycardia. When combined with absent variability, it is a severe emergency.","testTakingStrategyZh":"系统评估基线心率和变异。低于110 bpm的基线是心动过缓。当与变异消失结合时，这是一种严重的紧急情况。","sourceMetadata":"NICHD 2008 standardized fetal monitoring nomenclature; ACOG intrapartum fetal heart rate monitoring guidance; AWHONN Fetal Heart Monitoring Principles and Practices, 6th ed.","mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1012,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hl_moc_prioritization_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.775","itemType":"highlight","category":"Management of Care","topic":"Prioritization & Delegation","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.775.stem.en","stemPathZh":"questions.775.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,128],"terminalOffsetsZh":[0,33],"fullStemEn":"Highlight the assignment that is inappropriate for a float nurse from the maternity unit and requires charge nurse intervention.","fullStemZh":"标出对于从产科病房调配来的护士不合适的、需要护士长干预的工作分配。","terminalSentenceEn":"Highlight the assignment that is inappropriate for a float nurse from the maternity unit and requires charge nurse intervention.","terminalSentenceZh":"标出对于从产科病房调配来的护士不合适的、需要护士长干预的工作分配。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"The charge nurse assigns a nurse floated from the maternity unit to care for four clients. ","zh":"护士长安排一名从产科病房调配来的护士照顾四名患者。"},{"id":"s2","en":"Client A is 1 day post-appendectomy with a patient-controlled analgesia (PCA) pump. ","zh":"患者 A 是阑尾切除术后第 1 天，使用患者自控镇痛（PCA）泵。","selectable":true},{"id":"s3","en":"Client B has chronic heart failure and requires daily morning weights. ","zh":"患者 B 患有慢性心力衰竭，需要每天早晨称重。","selectable":true},{"id":"s4","en":"Client C is receiving a continuous vasoactive infusion for cardiogenic shock. ","zh":"患者 C 因心源性休克正在持续静脉输注血管活性药物。","selectable":true},{"id":"s5","en":"Client D has resolving pneumonia and is receiving scheduled IV antibiotics.","zh":"患者 D 的肺炎正在好转，并按计划接受静脉注射抗生素。","selectable":true}],"correct":["s4"]}},"rationaleCorrectEn":"A client with cardiogenic shock requiring a continuous vasoactive infusion is highly unstable and requires specialized critical care knowledge, hemodynamic monitoring, and frequent titration. This assignment is entirely outside the scope and experience of a maternity float nurse and poses a severe safety risk.","rationaleCorrectZh":"需要持续静脉输注血管活性药物的心源性休克患者极不稳定，需要专门的重症监护知识、血流动力学监测和频繁的剂量滴定。这项分配完全超出了产科调配护士的范围和经验，构成严重的安全风险。","testTakingStrategyEn":"For float nurse assignments, prioritize clients who are stable, have predictable outcomes, and require standard nursing care similar to the float nurse's home unit. Avoid assigning clients requiring specialized critical care or complex pathophysiology management.","testTakingStrategyZh":"对于调配护士的工作分配，优先考虑病情稳定、结果可预测且需要与调配护士原科室相似的标准护理的患者。避免分配需要专门的重症监护或复杂病理生理学管理的患者。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1013,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hl_moc_delegation_02","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.776","itemType":"highlight","category":"Management of Care","topic":"Prioritization & Delegation","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.776.stem.en","stemPathZh":"questions.776.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,159],"terminalOffsetsZh":[0,41],"fullStemEn":"Highlight the task in the nursing care plan that must be assigned to the registered nurse (RN) and cannot be delegated to unlicensed assistive personnel (UAP).","fullStemZh":"标出护理计划中必须分配给注册护士（RN）且不能委派给无证辅助人员（UAP）的任务。","terminalSentenceEn":"Highlight the task in the nursing care plan that must be assigned to the registered nurse (RN) and cannot be delegated to unlicensed assistive personnel (UAP).","terminalSentenceZh":"标出护理计划中必须分配给注册护士（RN）且不能委派给无证辅助人员（UAP）的任务。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"The nurse delegates tasks for a client recovering from a stroke. ","zh":"护士为一名中风康复期的患者委派任务。"},{"id":"s2","en":"Assist the client with bathing and oral care. ","zh":"协助患者进行沐浴和口腔护理。","selectable":true},{"id":"s3","en":"Reposition the client in bed every 2 hours. ","zh":"每 2 小时为患者在床上翻身。","selectable":true},{"id":"s4","en":"Evaluate the client's swallowing ability during the first meal. ","zh":"在第一餐期间评估患者的吞咽能力。","selectable":true},{"id":"s5","en":"Record oral intake and urinary output.","zh":"记录口腔摄入量和尿量。","selectable":true}],"correct":["s4"]}},"rationaleCorrectEn":"Evaluating a client's swallowing ability requires nursing judgment, assessment, and critical thinking, which are exclusively within the RN's scope of practice. Bathing, repositioning, and recording I&O are routine, stable tasks suitable for UAP.","rationaleCorrectZh":"评估患者的吞咽能力需要护理判断、评估和批判性思维，这完全属于 RN 的执业范围。沐浴、翻身和记录出入量是适合 UAP 的常规、稳定的任务。","testTakingStrategyEn":"Remember the principles of delegation: RNs do not delegate evaluation, assessment, or teaching (EAT).","testTakingStrategyZh":"记住委派原则：RN 不委派评估、评定或教学（EAT）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1014,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hl_moc_hipaa_03","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.777","itemType":"highlight","category":"Management of Care","topic":"Confidentiality & HIPAA","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.777.stem.en","stemPathZh":"questions.777.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,107],"terminalOffsetsZh":[0,30],"fullStemEn":"Highlight the nurse's action that violates the Health Insurance Portability and Accountability Act (HIPAA).","fullStemZh":"标出护士违反《健康保险流通与责任法案》（HIPAA）的行为。","terminalSentenceEn":"Highlight the nurse's action that violates the Health Insurance Portability and Accountability Act (HIPAA).","terminalSentenceZh":"标出护士违反《健康保险流通与责任法案》（HIPAA）的行为。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"A nurse is caring for a high-profile client in the ICU. ","zh":"一名护士正在 ICU 照顾一位知名患者。"},{"id":"s2","en":"The nurse logs off the electronic health record (EHR) before leaving the workstation. ","zh":"护士在离开工作站前退出了电子健康记录（EHR）系统。","selectable":true},{"id":"s3","en":"The nurse discusses the client's prognosis with the healthcare team during clinical rounds. ","zh":"护士在临床查房期间与医疗团队讨论患者的预后。","selectable":true},{"id":"s4","en":"The nurse confirms the client's room number to a reporter over the phone. ","zh":"护士在电话中向记者确认了患者的病房号。","selectable":true},{"id":"s5","en":"The nurse provides an update to the client's designated health care proxy.","zh":"护士向患者指定的医疗保健代理人提供了最新情况。","selectable":true}],"correct":["s4"]}},"rationaleCorrectEn":"Confirming a client's presence or location in the facility to an unauthorized individual, such as a reporter, is a breach of HIPAA. Information may only be shared with those directly involved in care or authorized by the client.","rationaleCorrectZh":"向未经授权的个人（如记者）确认患者在医疗机构的存在或位置，违反了 HIPAA。信息只能与直接参与护理或经患者授权的人共享。","testTakingStrategyEn":"Identify actions that release protected health information (PHI) to individuals outside the direct care team or without explicit patient consent.","testTakingStrategyZh":"识别将受保护的健康信息（PHI）发布给直接护理团队之外的个人或未经患者明确同意的行为。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1015,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hl_moc_advocacy_04","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.778","itemType":"highlight","category":"Management of Care","topic":"Client Advocacy","difficulty":"hard","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.778.stem.en","stemPathZh":"questions.778.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,141],"terminalOffsetsZh":[0,34],"fullStemEn":"Highlight the statement by the client that indicates a need for the nurse to advocate for clarification from the surgeon/anesthesia provider.","fullStemZh":"标出患者表明护士需要作为倡导者向外科医生/麻醉提供者寻求澄清的陈述。","terminalSentenceEn":"Highlight the statement by the client that indicates a need for the nurse to advocate for clarification from the surgeon/anesthesia provider.","terminalSentenceZh":"标出患者表明护士需要作为倡导者向外科医生/麻醉提供者寻求澄清的陈述。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"A client is preparing for a scheduled open cholecystectomy. The nurse is verifying informed consent. ","zh":"一名患者正在准备进行计划中的开腹胆囊切除术。护士正在核实知情同意。"},{"id":"s2","en":"The client states, \"I know I will have a large incision on my abdomen.\" ","zh":"患者说：“我知道我的腹部会有一个大伤口。”","selectable":true},{"id":"s3","en":"\"The doctor explained that there is a risk of bleeding and infection.\" ","zh":"“医生解释说有出血和感染的风险。”","selectable":true},{"id":"s4","en":"\"My surgeon told me I will be completely awake during the entire surgery.\" ","zh":"“我的外科医生告诉我，在整个手术过程中我将完全清醒。”","selectable":true},{"id":"s5","en":"\"I understand I will need to stay in the hospital for a few days to recover.\"","zh":"“我明白我需要在医院住几天才能恢复。”","selectable":true}],"correct":["s4"]}},"rationaleCorrectEn":"An open cholecystectomy is performed under general anesthesia. The client's belief that they will be \"completely awake\" indicates a fundamental misunderstanding of the procedure. The nurse must advocate for the client by notifying the surgeon/anesthesia provider to clarify the anesthesia and procedure before consent is signed.","rationaleCorrectZh":"开腹胆囊切除术在全身麻醉下进行。患者认为他们将“完全清醒”，这表明对该手术存在根本性的误解。护士必须在签署同意书之前，通过通知外科医生/麻醉提供者澄清麻醉和手术程序来维护患者权益。","testTakingStrategyEn":"Look for the statement that contains clinically incorrect information regarding the planned procedure, indicating invalid informed consent.","testTakingStrategyZh":"寻找包含关于计划手术的临床错误信息的陈述，这表明知情同意无效。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1016,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hl_moc_discharge_05","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.779","itemType":"highlight","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.779.stem.en","stemPathZh":"questions.779.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,102],"terminalOffsetsZh":[0,26],"fullStemEn":"Highlight the finding that indicates an unsafe discharge plan requiring intervention before discharge.","fullStemZh":"标出表明出院计划不安全、需要在出院前进行干预的发现。","terminalSentenceEn":"Highlight the finding that indicates an unsafe discharge plan requiring intervention before discharge.","terminalSentenceZh":"标出表明出院计划不安全、需要在出院前进行干预的发现。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"Discharge planning note for an older adult client with a new walker: ","zh":"一位使用新助行器的老年患者的出院计划记录："},{"id":"s2","en":"The client lives in a single-story home with no external stairs. ","zh":"患者居住在没有外部楼梯的单层平房中。","selectable":true},{"id":"s3","en":"A home health nurse is scheduled to visit twice a week. ","zh":"安排了家庭保健护士每周探访两次。","selectable":true},{"id":"s4","en":"The bathroom has loose throw rugs on the tile floor. ","zh":"浴室瓷砖地板上有松散的活动小地毯。","selectable":true},{"id":"s5","en":"The client's adult child will assist with grocery shopping weekly.","zh":"患者的成年子女将每周协助购买杂货。","selectable":true}],"correct":["s4"]}},"rationaleCorrectEn":"Loose throw rugs present a severe fall hazard, particularly for an older adult adjusting to a new walker. The environment must be modified (rugs removed) before a safe discharge can occur.","rationaleCorrectZh":"松散的防滑小地毯构成严重的跌倒危险，特别是对于正在适应新助行器的老年人。在安全出院之前必须修改环境（移除地毯）。","testTakingStrategyEn":"Focus on environmental safety risks. Throw rugs are a classic NCLEX fall hazard.","testTakingStrategyZh":"重点关注环境安全风险。防滑小地毯是经典的 NCLEX 跌倒隐患。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1017,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hl_sic_precautions_06","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.780","itemType":"highlight","category":"Safety and Infection Prevention and Control","topic":"Transmission-Based Precautions","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.780.stem.en","stemPathZh":"questions.780.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,107],"terminalOffsetsZh":[0,25],"fullStemEn":"Highlight the action by the unlicensed assistive personnel (UAP) that breaches infection control protocols.","fullStemZh":"标出无证辅助人员（UAP）违反感染控制规程的行为。","terminalSentenceEn":"Highlight the action by the unlicensed assistive personnel (UAP) that breaches infection control protocols.","terminalSentenceZh":"标出无证辅助人员（UAP）违反感染控制规程的行为。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"The RN observes the UAP caring for a client with active Clostridioides difficile. ","zh":"RN 观察 UAP 护理一名活动性艰难梭菌感染的患者。"},{"id":"s2","en":"The UAP dons a disposable gown and gloves before entering the room. ","zh":"UAP 在进入病房前穿戴了一次性隔离衣和手套。","selectable":true},{"id":"s3","en":"The UAP uses dedicated disposable equipment for the client. ","zh":"UAP 为患者使用了专用的一次性设备。","selectable":true},{"id":"s4","en":"After care, the UAP removes gloves and cleans hands with an alcohol-based hand rub. ","zh":"护理结束后，UAP 脱下手套并使用含酒精的洗手液清洁双手。","selectable":true},{"id":"s5","en":"The UAP places soiled linens in a designated leak-resistant linen bag.","zh":"UAP 将脏布草放入指定的防渗漏布草袋中。","selectable":true}],"correct":["s4"]}},"rationaleCorrectEn":"Clostridioides difficile spores are not killed by alcohol-based hand rubs. Staff must wash hands with soap and water after caring for a client with C. diff. Using hand sanitizer breaches infection control protocol.","rationaleCorrectZh":"含酒精的洗手液无法杀死艰难梭菌孢子。工作人员在护理完 C. diff 患者后必须用肥皂和水洗手。使用洗手液违反了感染控制规程。","testTakingStrategyEn":"Identify the specific pathogen exception. C. difficile requires soap and water because it forms alcohol-resistant spores.","testTakingStrategyZh":"识别特定的病原体例外情况。艰难梭菌会形成抗酒精的孢子，因此需要用肥皂和水洗手。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1018,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hl_sic_safety_07","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.781","itemType":"highlight","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.781.stem.en","stemPathZh":"questions.781.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,99],"terminalOffsetsZh":[0,20],"fullStemEn":"Highlight the finding in the client's profile that most significantly increases the risk for falls.","fullStemZh":"标出患者资料中最显著增加跌倒风险的发现。","terminalSentenceEn":"Highlight the finding in the client's profile that most significantly increases the risk for falls.","terminalSentenceZh":"标出患者资料中最显著增加跌倒风险的发现。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"Admission assessment for a 75-year-old client: ","zh":"75 岁患者的入院评估："},{"id":"s2","en":"The client has a history of well-controlled hypertension. ","zh":"患者有控制良好的高血压病史。","selectable":true},{"id":"s3","en":"The client wears hearing aids in both ears. ","zh":"患者双耳均佩戴助听器。","selectable":true},{"id":"s4","en":"The client takes zolpidem for sleep at night and lisinopril in the morning. ","zh":"患者晚上服用唑吡坦帮助睡眠，早晨服用赖诺普利。","selectable":true},{"id":"s5","en":"The client uses reading glasses for close-up tasks.","zh":"患者在进行近距离工作时使用老花镜。","selectable":true}],"correct":["s4"]}},"rationaleCorrectEn":"Zolpidem is a sedative-hypnotic that causes drowsiness, dizziness, and impaired coordination, severely increasing fall risk, especially in older adults when they get up during the night. The combination with an antihypertensive further raises the risk of orthostatic hypotension.","rationaleCorrectZh":"唑吡坦是一种镇静催眠药，会引起嗜睡、头晕和协调能力受损，极大地增加了跌倒风险，特别是老年人夜间起床时。加上抗高血压药，进一步增加了体位性低血压的风险。","testTakingStrategyEn":"Evaluate medications as a primary source of fall risk. Sedatives, narcotics, and antihypertensives are major contributors to orthostatic hypotension and instability.","testTakingStrategyZh":"将药物评估为跌倒风险的主要来源。镇静剂、麻醉剂和抗高血压药是体位性低血压和不稳定的主要因素。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1019,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hl_sic_medsafety_08","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.782","itemType":"highlight","category":"Safety and Infection Prevention and Control","topic":"Medication Safety & Admin","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.782.stem.en","stemPathZh":"questions.782.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,97],"terminalOffsetsZh":[0,18],"fullStemEn":"Highlight the clinical finding that requires the nurse to immediately stop the blood transfusion.","fullStemZh":"标出要求护士立即停止输血的临床发现。","terminalSentenceEn":"Highlight the clinical finding that requires the nurse to immediately stop the blood transfusion.","terminalSentenceZh":"标出要求护士立即停止输血的临床发现。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"Fifteen minutes after initiating a packed red blood cell (PRBC) transfusion, the nurse assesses the client. ","zh":"开始输注浓缩红细胞（PRBC）十五分钟后，护士评估了患者。"},{"id":"s2","en":"The client's temperature increased from 98.6 °F (37 °C) to 99.1 °F (37.3 °C). ","zh":"患者体温从 98.6 °F (37 °C) 升至 99.1 °F (37.3 °C)。","selectable":true},{"id":"s3","en":"The client reports a new onset of lower back pain and feeling apprehensive. ","zh":"患者主诉新出现下腰痛和感到恐惧。","selectable":true},{"id":"s4","en":"The client complains that the room feels slightly chilly. ","zh":"患者抱怨房间感觉有点冷。","selectable":true},{"id":"s5","en":"The IV site is intact with no swelling or redness.","zh":"静脉注射部位完好，无肿胀或发红。","selectable":true}],"correct":["s3"]}},"rationaleCorrectEn":"Lower back pain and apprehension are classic, early signs of an acute hemolytic transfusion reaction, a life-threatening emergency caused by ABO incompatibility. The transfusion must be stopped immediately to prevent renal failure and shock.","rationaleCorrectZh":"下腰痛和恐惧是由 ABO 血型不合引起的一种危及生命的急症——急性溶血性输血反应的典型早期征兆。必须立即停止输血，以防止肾功能衰竭和休克。","testTakingStrategyEn":"Recognize the cardinal signs of a hemolytic reaction: flank/low back pain, apprehension, tachycardia, hypotension, and hematuria.","testTakingStrategyZh":"识别溶血反应的主要体征：腰腹/下背痛、恐惧、心动过速、低血压和血尿。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1020,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hl_pharm_cardio_09","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.783","itemType":"highlight","category":"Pharmacological and Parenteral Therapies","topic":"Cardiovascular & Endocrine Medications","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.783.stem.en","stemPathZh":"questions.783.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,86],"terminalOffsetsZh":[0,20],"fullStemEn":"Highlight the cue in the nursing assessment that indicates potential digoxin toxicity.","fullStemZh":"标出护理评估中表明潜在地高辛中毒的线索。","terminalSentenceEn":"Highlight the cue in the nursing assessment that indicates potential digoxin toxicity.","terminalSentenceZh":"标出护理评估中表明潜在地高辛中毒的线索。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"The nurse assesses a client taking digoxin and furosemide for heart failure. ","zh":"护士评估了一名正在服用地高辛和呋塞米治疗心力衰竭的患者。"},{"id":"s2","en":"The client's apical pulse is 72 beats/min and regular. ","zh":"患者的心尖脉为 72 次/分且规则。","selectable":true},{"id":"s3","en":"The client reports a loss of appetite and feeling nauseous since yesterday. ","zh":"患者主诉自昨天起食欲不振且感到恶心。","selectable":true},{"id":"s4","en":"Blood pressure is 118/76 mm Hg. ","zh":"血压为 118/76 mm Hg。","selectable":true},{"id":"s5","en":"Urine output was 1,500 mL over the last 24 hours.","zh":"过去 24 小时尿量为 1,500 毫升。","selectable":true}],"correct":["s3"]}},"rationaleCorrectEn":"Gastrointestinal symptoms (anorexia, nausea, vomiting) are frequently the earliest signs of digoxin toxicity. Because the client is also taking furosemide (a potassium-depleting diuretic), the risk for digoxin toxicity is elevated due to potential hypokalemia.","rationaleCorrectZh":"胃肠道症状（厌食、恶心、呕吐）通常是地高辛中毒的最早体征。由于患者还在服用呋塞米（一种排钾利尿剂），潜在的低钾血症使地高辛中毒的风险升高。","testTakingStrategyEn":"Digoxin toxicity early signs are GI (anorexia, nausea), followed by neurologic (vision changes, confusion), and cardiac (arrhythmias).","testTakingStrategyZh":"地高辛中毒的早期体征是胃肠道症状（厌食、恶心），其次是神经系统症状（视力改变、意识模糊）和心脏症状（心律失常）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1021,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hl_pharm_anticoag_10","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.784","itemType":"highlight","category":"Pharmacological and Parenteral Therapies","topic":"Anticoagulant Therapy","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.784.stem.en","stemPathZh":"questions.784.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,109],"terminalOffsetsZh":[0,28],"fullStemEn":"Highlight the finding that requires the nurse to hold the prescribed enoxaparin dose and notify the provider.","fullStemZh":"标出要求护士暂停执行医嘱中依诺肝素剂量并通知医生的发现。","terminalSentenceEn":"Highlight the finding that requires the nurse to hold the prescribed enoxaparin dose and notify the provider.","terminalSentenceZh":"标出要求护士暂停执行医嘱中依诺肝素剂量并通知医生的发现。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"The nurse reviews the chart before administering subcutaneous enoxaparin. ","zh":"护士在皮下注射依诺肝素前查阅病历。"},{"id":"s2","en":"The client had a total knee replacement 3 days ago. ","zh":"患者 3 天前进行了全膝关节置换术。","selectable":true},{"id":"s3","en":"Current platelet count is 60 ×10³/µL. ","zh":"当前血小板计数为 60 ×10³/µL。","selectable":true},{"id":"s4","en":"Hemoglobin is 11.5 g/dL (115 g/L). ","zh":"血红蛋白为 11.5 g/dL (115 g/L)。","selectable":true},{"id":"s5","en":"The client reports mild bruising around the injection sites.","zh":"患者主诉注射部位周围有轻微瘀斑。","selectable":true}],"correct":["s3"]}},"rationaleCorrectEn":"A platelet count of 60 ×10³/µL indicates severe thrombocytopenia (normal 150-400 ×10³/µL). Administering enoxaparin, a low-molecular-weight heparin, could precipitate catastrophic bleeding or indicate heparin-induced thrombocytopenia (HIT). The dose must be held.","rationaleCorrectZh":"60 ×10³/µL 的血小板计数表明严重的血小板减少症（正常值为 150-400 ×10³/µL）。使用依诺肝素（一种低分子量肝素）可能会引发灾难性出血或表明肝素诱导的血小板减少症（HIT）。必须暂停给药。","testTakingStrategyEn":"Prioritize assessing platelet counts before administering any heparin product. Normal is 150,000 to 400,000. Less than 100,000 is a red flag.","testTakingStrategyZh":"在给予任何肝素产品之前，优先评估血小板计数。正常值为 150,000 至 400,000。低于 100,000 是一个危险信号。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1022,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hl_psy_suicide_11","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.785","itemType":"highlight","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.785.stem.en","stemPathZh":"questions.785.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,113],"terminalOffsetsZh":[0,25],"fullStemEn":"Highlight the client's statement that suggests an immediate risk for self-harm, requiring one-to-one observation.","fullStemZh":"标出暗示患者有立即自残风险、需要一对一观察的陈述。","terminalSentenceEn":"Highlight the client's statement that suggests an immediate risk for self-harm, requiring one-to-one observation.","terminalSentenceZh":"标出暗示患者有立即自残风险、需要一对一观察的陈述。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"A client with severe depression is admitted to the psychiatric unit. ","zh":"一名患有重度抑郁症的患者被收入精神科病房。"},{"id":"s2","en":"\"I just feel so tired all the time, no matter how much I sleep.\" ","zh":"“无论我睡多久，我总是觉得很累。”","selectable":true},{"id":"s3","en":"\"My family would be so much better off without the burden of caring for me.\" ","zh":"“如果没有照顾我的负担，我的家人会过得更好。”","selectable":true},{"id":"s4","en":"\"I have finally figured out exactly how I am going to end the pain tonight.\" ","zh":"“我终于想好今晚要如何结束这痛苦了。”","selectable":true},{"id":"s5","en":"\"I don't enjoy watching television or reading books anymore.\"","zh":"“我不再喜欢看电视或看书了。”","selectable":true}],"correct":["s4"]}},"rationaleCorrectEn":"Having a specific plan and a timeframe (\"tonight\") indicates an imminent risk of suicide. This requires immediate implementation of strict safety protocols, such as one-to-one continuous observation.","rationaleCorrectZh":"有具体的计划和时间表（“今晚”）表明存在迫在眉睫的自杀风险。这需要立即实施严格的安全规程，例如一对一持续观察。","testTakingStrategyEn":"In psychiatric emergencies, a statement detailing a specific plan, method, or timeframe for suicide is the highest priority cue.","testTakingStrategyZh":"在精神科急症中，详细说明自杀的具体计划、方法或时间表的陈述是最高优先级的线索。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1023,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hl_psy_coping_12","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.786","itemType":"highlight","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.786.stem.en","stemPathZh":"questions.786.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,96],"terminalOffsetsZh":[0,24],"fullStemEn":"Highlight the finding in the physical assessment that is most highly suspicious for elder abuse.","fullStemZh":"标出身体评估中最令人高度怀疑存在虐待老人的发现。","terminalSentenceEn":"Highlight the finding in the physical assessment that is most highly suspicious for elder abuse.","terminalSentenceZh":"标出身体评估中最令人高度怀疑存在虐待老人的发现。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"The nurse assesses an 82-year-old client brought to the ED by their primary caregiver. ","zh":"护士评估了一名由主要照顾者带到急诊室的 82 岁患者。"},{"id":"s2","en":"The client has dry, transparent skin on the dorsal surfaces of the hands. ","zh":"患者手背的皮肤干燥、透明。","selectable":true},{"id":"s3","en":"There are bilateral, symmetric bruising patterns resembling handprints on the upper arms. ","zh":"上臂有双侧、对称的类似手印的瘀伤模式。","selectable":true},{"id":"s4","en":"A 1-cm healing skin tear is present on the right forearm. ","zh":"右前臂有一处 1 厘米的正在愈合的皮肤撕裂伤。","selectable":true},{"id":"s5","en":"The client appears slightly confused about the date but knows their name.","zh":"患者对日期似乎有些困惑，但知道自己的名字。","selectable":true}],"correct":["s3"]}},"rationaleCorrectEn":"Bilateral, symmetric bruising, especially in the shape of handprints or on areas normally covered by clothing (like upper arms, torso), strongly suggests intentional trauma (e.g., being grabbed forcefully). This requires mandatory reporting.","rationaleCorrectZh":"双侧对称瘀伤，尤其是手印形状的瘀伤或位于通常被衣服遮盖的部位（如上臂、躯干）的瘀伤，强烈暗示故意伤害（例如，被用力抓住）。这需要强制性报告。","testTakingStrategyEn":"Differentiate between normal age-related physiological changes (fragile skin, isolated tears on extremities) and non-accidental trauma patterns (symmetric bruising, patterned marks).","testTakingStrategyZh":"区分正常的年龄相关的生理变化（皮肤脆弱、四肢上的孤立撕裂伤）和非意外创伤模式（对称性瘀伤、有图案的印记）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1024,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_backfill_or_cardio_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.787","itemType":"ordered_response","category":"Physiological Adaptation","topic":"Cardiovascular Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.787.stem.en","stemPathZh":"questions.787.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[193,263],"terminalOffsetsZh":[54,72],"fullStemEn":"A client on a telemetry unit is found unresponsive in bed. The monitor shows ventricular fibrillation. The nurse is initiating emergency cardiopulmonary resuscitation (CPR) and defibrillation. Arrange the nursing actions in the correct order of clinical priority.","fullStemZh":"一名远测监护病房的患者在床上被发现无反应。监护仪显示心室颤动。护士正在启动紧急心肺复苏 (CPR) 和除颤。按临床优先级的正确顺序排列护理措施。","terminalSentenceEn":"Arrange the nursing actions in the correct order of clinical priority.","terminalSentenceZh":"按临床优先级的正确顺序排列护理措施。","penultimateSentenceEn":"The nurse is initiating emergency cardiopulmonary resuscitation (CPR) and defibrillation.","penultimateSentenceZh":"护士正在启动紧急心肺复苏 (CPR) 和除颤。","responseContext":{"type":"ordered_response","options":[{"id":"E","en":"Immediately resume high-quality chest compressions starting with compressions.","zh":"立即重新开始胸外按压以恢复高质量心肺复苏。"},{"id":"B","en":"Assess the carotid pulse and breathing simultaneously for 5 to 10 seconds.","zh":"同时评估颈动脉搏动和呼吸 5 至 10 秒。"},{"id":"A","en":"Verify the client is unresponsive and shout for help to activate the emergency response team.","zh":"核实患者无反应并大声呼救以启动紧急响应团队。"},{"id":"D","en":"Apply the defibrillator pads to the client's bare chest and deliver a shock once the device analyzes a shockable rhythm.","zh":"将除颤器电极贴片贴在患者裸露的胸部，并在设备分析出可除颤心律后释放电击。"},{"id":"C","en":"Initiate high-quality chest compressions at a rate of 100 to 120 compressions per minute.","zh":"开始进行每分钟 100 至 120 次的高质量胸外按压。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"According to the American Heart Association (AHA) Basic Life Support (BLS) and Advanced Cardiovascular Life Support (ACLS) guidelines, the priority sequence of actions for an unresponsive client in ventricular fibrillation (VF) is designed to optimize coronary perfusion and deliver rapid defibrillation. First, the nurse must verify responsiveness and call for help/defibrillator immediately. Second, the nurse assesses for a pulse and breathing simultaneously for 5 to 10 seconds to confirm cardiac arrest. Third, if no pulse is felt, the nurse initiates high-quality chest compressions immediately to maintain perfusion. Fourth, once the defibrillator arrives, pads are applied, the rhythm is analyzed, and a shock is delivered for the shockable VF rhythm. Fifth, immediately after the shock is delivered, the nurse must resume chest compressions starting with compressions; the nurse should NOT pause to check the pulse or re-analyze the rhythm immediately after a shock, as the heart is stunned and compressions are vital to support circulation.","rationaleCorrectZh":"根据美国心脏协会 (AHA) 基础生命支持 (BLS) 和高级心血管生命支持 (ACLS) 指南，针对心室颤动 (VF) 无反应患者的优先处理程序旨在优化冠状动脉灌注并进行快速除颤。首先，护士必须核实无反应并立即呼救以获取除颤器。其次，护士同时评估搏动和呼吸 5 至 10 秒以确认心脏骤停。第三，若未触及搏动，护士立即开始高质量胸外按压以维持灌注。第四，一旦除颤器送达，贴上电极片，分析心律，并对可除颤的室颤心律释放电击。第五，电击释放后，护士必须立即恢复胸外按压；在电击后不应停下来检查脉搏或重新分析心律，因为此时心脏处于电击后顿抑状态，胸外按压对于维持循环至关重要。","testTakingStrategyEn":"Recall the AHA BLS and ACLS cardiac arrest guidelines. Remember the order: Verify unresponsiveness/call for help → assess pulse/breathing (5-10s) → compressions → defibrillate shock → immediate chest compressions post-shock without pulse checks.","testTakingStrategyZh":"回忆 AHA BLS 和 ACLS 心脏骤停指南。记住顺序：核实无反应/呼救 → 评估脉搏/呼吸（5-10秒） → 胸外按压 → 实施电击除颤 → 电击后立即进行按压而不核对脉搏。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1025,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_backfill_hl_cardio_02","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.788","itemType":"highlight","category":"Reduction of Risk Potential","topic":"Procedural Complications & Dialysis","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.788.stem.en","stemPathZh":"questions.788.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,137],"terminalOffsetsZh":[0,30],"fullStemEn":"Highlight the assessment findings that suggest the client is developing a vascular complication requiring immediate nursing intervention.","fullStemZh":"标出提示患者正在发生需要立即护理干预的血管并发症的评估发现。","terminalSentenceEn":"Highlight the assessment findings that suggest the client is developing a vascular complication requiring immediate nursing intervention.","terminalSentenceZh":"标出提示患者正在发生需要立即护理干预的血管并发症的评估发现。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"Progress Note: The client is 4 hours post-left femoral artery cardiac catheterization.","zh":"病程记录：患者处于左股动脉心脏导管介入术后4小时。"},{"id":"s2","en":"The pressure dressing over the puncture site is clean, dry, and intact.","zh":"穿刺部位的加压敷料干净、干燥且完整。","selectable":true},{"id":"s3","en":"The client reports severe, dull left flank and back pain.","zh":"患者主诉左侧侧腹和背部严重钝痛。","selectable":true},{"id":"s4","en":"The left pedal pulse is faint (1+) and the foot is cooler to the touch than the right foot.","zh":"左侧足背动脉搏动微弱 (1+)，且左脚触之较右脚凉。","selectable":true},{"id":"s5","en":"The client's blood pressure is 86/48 mmHg with a heart rate of 116 bpm.","zh":"患者的血压为 86/48 mmHg，心率为 116次/分。","selectable":true},{"id":"s6","en":"The client reports mild, localized soreness in the left groin.","zh":"患者主诉左侧腹股沟有轻微的局限性酸痛。","selectable":true}],"correct":["s3","s4","s5"]}},"rationaleCorrectEn":"The client is exhibiting clinical cues indicating retroperitoneal hemorrhage and arterial occlusion, which are severe vascular complications of femoral artery catheterization. Severe flank and back pain (s3) suggest concealed bleeding into the retroperitoneal cavity. Hypotension and tachycardia (s5) indicate hypovolemic shock secondary to internal hemorrhage. A faint pedal pulse and cool extremity on the accessed side (s4) suggest compromised arterial perfusion, potentially due to local thrombosis, arterial occlusion, or a compressing hematoma. A clean, dry dressing (s2) and mild localized groin soreness (s6) are expected post-procedure findings that do not represent active complications.","rationaleCorrectZh":"患者表现出提示腹膜后出血和动脉闭塞的临床征象，这些是股动脉导管插入术后的严重血管并发症。严重的侧腹和背部疼痛 (s3) 提示腹膜后腔隐蔽性出血。低血压和心动过速 (s5) 提示继发于内出血的低血容量性休克。穿刺侧足背动脉搏动微弱和肢体发凉 (s4) 提示动脉灌注受损，可能是由于局部血栓形成、动脉闭塞或压迫性血肿引起。干净、干燥的敷料 (s2) 和局限性轻度腹股沟酸痛 (s6) 是术后预期表现，不代表活动性并发症。","testTakingStrategyEn":"Focus on the indicators of internal bleeding and arterial occlusion following femoral access procedures. Differentiate between expected localized soreness/dry dressing and systemic signs of hemorrhage (hypotension, tachycardia), concealed blood collection (back/flank pain), and distal ischemia (cold limb, weak pulse).","testTakingStrategyZh":"专注于股动脉穿刺操作后内出血和动脉闭塞的指标。区分局部预期的酸痛/干燥敷料与出血的全身症状（低血压、心动过速）、隐蔽性积血（背部/侧腹疼痛）以及远端缺血（肢体发凉、脉搏微弱）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1026,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_backfill_hl_psych_03","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.789","itemType":"highlight","category":"Psychosocial Integrity","topic":"Mental Health Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.789.stem.en","stemPathZh":"questions.789.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,118],"terminalOffsetsZh":[0,25],"fullStemEn":"Highlight the client's statements during the follow-up visit that indicate an immediate risk for suicide or self-harm.","fullStemZh":"标出随访期间患者表明存在立即自杀或自伤风险的陈述。","terminalSentenceEn":"Highlight the client's statements during the follow-up visit that indicate an immediate risk for suicide or self-harm.","terminalSentenceZh":"标出随访期间患者表明存在立即自杀或自伤风险的陈述。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"Nurse's Note: The client is a 32-year-old female with major depressive disorder who was started on sertraline 2 weeks ago. She presents for a follow-up visit and shares the following details:","zh":"护士记录：患者为32岁女性，患有重度抑郁症，2周前开始服用舍曲林。她来院随访并分享了以下细节："},{"id":"s2","en":"\"I feel like I finally have the energy to do things now.\"","zh":"“我觉得我现在终于有精力去做事情了。”","selectable":true},{"id":"s3","en":"\"I still have a dry mouth all the time since starting the pill.\"","zh":"“自从开始吃这药以来，我仍然一直觉得口干。”","selectable":true},{"id":"s4","en":"\"I gave my grandmother's wedding ring to my sister yesterday so she could keep it.\"","zh":"“我昨天把外祖母的结婚戒指送给了我妹妹，好让他收下。”","selectable":true},{"id":"s5","en":"\"My sleep is slightly better, but I still wake up once during the night.\"","zh":"“我的睡眠稍有改善，但夜里仍然会醒来一次。”","selectable":true},{"id":"s6","en":"\"Don't worry about me, everything will be resolved soon, and I won't be a burden to anyone anymore.\"","zh":"“别担心我，一切很快就会解决的，我不会再成为任何人的负担了。”","selectable":true}],"correct":["s2","s4","s6"]}},"rationaleCorrectEn":"The client is exhibiting three critical indicators of immediate suicidal risk. First, a sudden surge in energy shortly after starting an SSRI (s2) is a dangerous warning sign; antidepressants can improve physical energy and resolve psychomotor retardation before relieving emotional despair, giving the client the energy needed to execute a suicide plan. Second, giving away prized personal possessions (s4) is a behavioral indicator of preparing for death. Third, verbal cues like 'everything will be resolved soon' and 'I won't be a burden' (s6) indicate hopelessness and covert suicide planning. Dry mouth (s3) is a common side effect of sertraline, and mild sleep changes (s5) reflect expected pharmacological adjustment; neither indicates self-harm.","rationaleCorrectZh":"该患者表现出三项关键的立即自杀风险指标。首先，在开始使用 SSRI 药物后不久精力突然激增 (s2) 是一个危险的警告信号；抗抑郁药可以在缓解情感绝望之前，先改善身体精力并消除精神运动性迟缓，从而给予患者执行自杀计划所需的精力。其次，赠送珍贵的个人财产 (s4) 是为死亡做准备的行为指标。第三，诸如“一切很快就会解决”和“我不会再成为负担”之类的言语暗示 (s6) 表明存在无助感和隐蔽的自杀计划。口干 (s3) 是舍曲林的常见副作用，睡眠轻度改善 (s5) 反映了预期的药物调整；两者均不指示自伤。","testTakingStrategyEn":"Focus on the warning signs of suicide in clients recently prescribed antidepressants. Look for the combination of sudden energy surge (ability to act), behavioral preparation (giving away possessions), and hopeless verbalizations. Exclude expected physiological drug side effects.","testTakingStrategyZh":"专注于新开抗抑郁药处方的患者的自杀警告信号。寻找精力突然激增（行动能力）、行为准备（赠送财产）和无望言语表达的结合。排除预期的生理药物副作用。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1027,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_backfill_bt_psych_04","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.790","itemType":"bowtie","category":"Psychosocial Integrity","topic":"Mental Health Disorders","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.790.stem.en","stemPathZh":"questions.790.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[398,545],"terminalOffsetsZh":[138,176],"fullStemEn":"A 48-year-old male with a history of chronic alcohol use disorder was admitted to the medical unit 24 hours ago. On assessment, the client is highly agitated, diaphoretic, and exhibits coarse tremors in both hands. Vital signs are: blood pressure 162/98 mmHg, heart rate 118 bpm, and temperature 100.8 °F (38.2 °C). He is disoriented to time and place and reports seeing bugs crawling on the wall. Complete the diagram by selecting the most likely clinical condition, the two priority nursing actions, and the two clinical parameters to monitor.","fullStemZh":"一名有慢性酒精使用障碍史的48岁男性于24小时前收入内科病房。评估时，患者高度烦躁、大汗淋漓，且双侧手部出现粗大震颤。生命体征为：血压 162/98 mmHg，心率 118次/分，体温 100.8 °F (38.2 °C)。他对时间和地点定向力障碍，并主诉看到墙上有虫子爬行。通过选择最可能的临床情况、两项优先护理措施和两个要监测的临床参数来完成图示。","terminalSentenceEn":"Complete the diagram by selecting the most likely clinical condition, the two priority nursing actions, and the two clinical parameters to monitor.","terminalSentenceZh":"通过选择最可能的临床情况、两项优先护理措施和两个要监测的临床参数来完成图示。","penultimateSentenceEn":"He is disoriented to time and place and reports seeing bugs crawling on the wall.","penultimateSentenceZh":"他对时间和地点定向力障碍，并主诉看到墙上有虫子爬行。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Most likely condition","zh":"最可能的疾病"},"tokens":[{"id":"c1","en":"Alcohol withdrawal delirium","zh":"酒精戒断性谵妄"},{"id":"c2","en":"Wernicke-Korsakoff syndrome","zh":"韦尼克-科萨科夫综合征"},{"id":"c3","en":"Acute hepatic encephalopathy","zh":"急性肝性脑病"}],"correct":"c1"},"actions":{"prompt":{"en":"Actions to take","zh":"应采取的措施"},"tokens":[{"id":"a1","en":"Administer prescribed intravenous lorazepam","zh":"给予医嘱静脉注射劳拉西泮"},{"id":"a3","en":"Place the client in a brightly lit, high-stimulation room","zh":"将患者安置在光线充足、高刺激的病房中"},{"id":"a2","en":"Implement seizure precautions with padded side rails","zh":"实施带软垫床栏的癫痫预防措施"},{"id":"a4","en":"Apply continuous mechanical wrist restraints immediately","zh":"立即使用连续机械性手腕约束"}],"correct":["a1","a2"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"应监测的指标"},"tokens":[{"id":"p4","en":"Daily urine specific gravity","zh":"每日尿比重"},{"id":"p2","en":"Blood pressure and heart rate","zh":"血压和心率"},{"id":"p1","en":"Clinical Institute Withdrawal Assessment (CIWA-Ar) scores","zh":"临床研究所酒精戒断评估 (CIWA-Ar) 评分"},{"id":"p3","en":"Serum lipase and amylase levels","zh":"血清脂肪酶和淀粉酶水平"}],"correct":["p1","p2"]}}},"rationaleCorrectEn":"The client is demonstrating signs of alcohol withdrawal delirium (delirium tremens), which typically develops 48 to 72 hours after the cessation of heavy drinking but can begin within 24 hours. Classic signs include severe agitation, disorientation, tactile/visual hallucinations (bugs crawling), tremors, and autonomic hyperactivity (tachycardia, severe hypertension, low-grade fever). This is a medical emergency. The priority nursing actions are to administer prescribed benzodiazepines (intravenous lorazepam) to calm the hyperactive nervous system and prevent seizures, and to implement seizure precautions (padded side rails) for safety. A quiet, low-stimulation environment is essential; high stimulation will worsen delirium. Restraints should only be used as a last resort. Key monitoring parameters include using the CIWA-Ar tool to grade withdrawal and titrate medications, and assessing vital signs (blood pressure/heart rate) to monitor autonomic instability. Lipase/amylase and urine specific gravity are not the primary monitoring metrics for acute withdrawal delirium.","rationaleCorrectZh":"患者表现出酒精戒断性谵妄（震颤谵妄）的征象，该病通常在停止大量饮酒后 48 至 72 小时内发生，但也可能在 24 小时内开始。典型特征包括严重烦躁、定向力障碍、触觉/视觉幻觉（虫子爬行）、震颤和自主神经功能亢进（心动过速、严重高血压、低热）。这属于医疗紧急情况。优先的护理措施是给予医嘱苯二氮䓬类药物（静脉注射劳拉西泮）以镇静亢进的神经系统并预防癫痫发作，并实施癫痫预防措施（加垫床栏）以保障安全。安静、低刺激的环境至关重要；高刺激会加重谵妄。约束只能作为最后的手段。关键的监测参数包括使用 CIWA-Ar 工具对戒断严重程度进行分级并滴定药物，以及评估生命体征（血压/心率）以监测自主神经系统的不稳定性。胰淀粉酶和脂肪酶以及尿比重不是急性戒断谵妄管理的主要监测指标。","testTakingStrategyEn":"Focus on the acute signs of withdrawal delirium (severe agitation, hallucinations, tachycardia, hypertension, fever). Prioritize benzodiazepines to calm central nervous system hyperactivity and implement seizure precautions. Monitor autonomic stability using vital signs and CIWA-Ar.","testTakingStrategyZh":"专注于戒断性谵妄的急性征象（严重烦躁、幻觉、心动过速、高血压、发热）。优先使用苯二氮䓬类药物以镇静中枢神经系统过度兴奋，并实施癫痫预防措施。使用生命体征和 CIWA-Ar 监测自主神经稳定性。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":true,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1028,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_backfill_bt_medsafe_05","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.791","itemType":"bowtie","category":"Pharmacological and Parenteral Therapies","topic":"Medication Safety & Admin","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.791.stem.en","stemPathZh":"questions.791.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[311,458],"terminalOffsetsZh":[106,144],"fullStemEn":"A client who was started on a continuous intravenous heparin infusion 5 days ago for a deep vein thrombosis (DVT) is assessed by the nurse. The client's platelet count has decreased from a baseline of 280 ×10³/µL to 92 ×10³/µL. The client reports a mild headache and has new petechiae on the lower extremities. Complete the diagram by selecting the most likely clinical condition, the two priority nursing actions, and the two clinical parameters to monitor.","fullStemZh":"护士对一名因深静脉血栓 (DVT) 于 5 天前开始接受连续静脉注射肝素输注的患者进行评估。患者的血小板计数已从 280 ×10³/µL 的基线值降至 92 ×10³/µL。患者主诉轻度头痛，且下肢出现新发瘀点。通过选择最可能的临床情况、两项优先护理措施和两个要监测的临床参数来完成图示。","terminalSentenceEn":"Complete the diagram by selecting the most likely clinical condition, the two priority nursing actions, and the two clinical parameters to monitor.","terminalSentenceZh":"通过选择最可能的临床情况、两项优先护理措施和两个要监测的临床参数来完成图示。","penultimateSentenceEn":"The client reports a mild headache and has new petechiae on the lower extremities.","penultimateSentenceZh":"患者主诉轻度头痛，且下肢出现新发瘀点。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Most likely condition","zh":"最可能的疾病"},"tokens":[{"id":"c3","en":"Idiopathic thrombocytopenic purpura","zh":"特发性血小板减少性紫癜"},{"id":"c1","en":"Heparin-induced thrombocytopenia","zh":"肝素诱导的血小板减少症"},{"id":"c2","en":"Disseminated intravascular coagulation","zh":"弥散性血管内凝血"}],"correct":"c1"},"actions":{"prompt":{"en":"Actions to take","zh":"应采取的措施"},"tokens":[{"id":"a4","en":"Initiate oral warfarin therapy immediately","zh":"立即启动口服华法林治疗"},{"id":"a2","en":"Discontinue heparin flushes and remove heparin-coated lines","zh":"停用肝素冲管液并移除含肝素涂层的管道"},{"id":"a1","en":"Stop the intravenous heparin infusion immediately","zh":"立即停止静脉注射肝素输注"},{"id":"a3","en":"Administer a transfusion of pooled platelets immediately","zh":"立即给予混合血小板输注"}],"correct":["a1","a2"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"应监测的指标"},"tokens":[{"id":"p2","en":"Signs of new venous or arterial thromboembolism","zh":"新发静脉或动脉血栓栓塞的征象"},{"id":"p3","en":"Activated partial thromboplastin time (aPTT) every 6 hours","zh":"每 6 小时监测活化部分凝血活酶时间 (aPTT)"},{"id":"p1","en":"Platelet count","zh":"血小板计数"},{"id":"p4","en":"Serum potassium levels","zh":"血清钾水平"}],"correct":["p1","p2"]}}},"rationaleCorrectEn":"The client is demonstrating features of heparin-induced thrombocytopenia (HIT), a serious immune-mediated reaction that typically occurs 5 to 10 days after starting heparin therapy. It is characterized by a >50% drop in platelet count from baseline. Despite the low platelet count, HIT is a paradoxically highly prothrombotic state. The priority actions are to immediately stop the heparin infusion (a1) and eliminate all exposure to heparin, including heparin flushes and heparin-coated lines (a2), to halt the immunological process. Transfusing platelets (a3) is contraindicated because it can cause severe thrombotic events by fuel to the active immune complexes. Initiating warfarin (a4) in the acute phase is also contraindicated because it rapidly depletes protein C, risking skin necrosis and gangrene. Non-heparin anticoagulants (e.g., argatroban) must be used. Monitoring parameters include daily platelet counts (p1) to track recovery, and close clinical monitoring for signs of new arterial or venous thrombosis (p2). Monitoring aPTT (p3) is no longer the primary indicator once heparin is stopped.","rationaleCorrectZh":"该患者表现出肝素诱导的血小板减少症 (HIT) 的特征，这是一种严重的免疫介导反应，通常在开始肝素治疗后 5 至 10 天发生。其特点是血小板计数较基线值下降 >50%。尽管血小板计数较低，但反常的是，HIT 处于一种高度促血栓状态。优先的措施是立即停止肝素输注 (a1) 并消除所有肝素暴露，包括肝素冲洗液和含肝素涂层的管路 (a2)，以阻止免疫病理过程。在 HIT 中禁用血小板输注 (a3)，因为输入血小板会加剧活动性免疫复合物反应并引起严重的血栓事件。在急性期也禁用启动华法林治疗 (a4)，因为它会迅速耗竭蛋白 C，存在皮肤坏死和坏疽的风险。必须使用非肝素类抗凝剂（如阿加曲班）。监测的参数包括每日血小板计数 (p1) 以追踪恢复情况，以及密切监测新发动脉或静脉血栓形成 (p2) 的临床征象。一旦停止使用肝素，监测 aPTT (p3) 便不再是首要监测指标。","testTakingStrategyEn":"Associate heparin therapy + platelet count drop >50% on day 5 with HIT. Remember the clinical rule: eliminate all heparin sources (actions), avoid platelet transfusions and warfarin, and monitor for thrombotic complications and platelet recovery.","testTakingStrategyZh":"将肝素治疗 + 第5天血小板计数下降 >50% 与 HIT 联系起来。记住临床规则：消除所有肝素来源（措施），避免输注血小板和使用华法林，并监测血栓并发症和血小板恢复情况。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"The client reports a mild headache and has new petechiae on the lower extremities.","controlSentenceZh":"患者主诉轻度头痛，且下肢出现新发瘀点。"}
{"queueIndex":1029,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_backfill_mx_medsafe_06","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.792","itemType":"matrix","category":"Safety and Infection Prevention and Control","topic":"Medication Safety & Admin","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.792.stem.en","stemPathZh":"questions.792.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[97,263],"terminalOffsetsZh":[25,60],"fullStemEn":"The registered nurse (RN) is preparing and administering medications on a medical-surgical unit. For each nursing action listed in the table, indicate whether it represents a safe medication administration practice or an unsafe medication administration practice.","fullStemZh":"注册护士 (RN) 正在内外科病房准备并给予药物。对于表中列出的每项护理措施，指出其代表安全给药操作还是不安全给药操作。","terminalSentenceEn":"For each nursing action listed in the table, indicate whether it represents a safe medication administration practice or an unsafe medication administration practice.","terminalSentenceZh":"对于表中列出的每项护理措施，指出其代表安全给药操作还是不安全给药操作。","penultimateSentenceEn":"The registered nurse (RN) is preparing and administering medications on a medical-surgical unit.","penultimateSentenceZh":"注册护士 (RN) 正在内外科病房准备并给予药物。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Crushing an extended-release potassium chloride tablet to administer it to a client with dysphagia.","zh":"将缓释型氯化钾片粉碎，以给予吞咽困难的患者服用。"},{"id":"r2","en":"Verifying the client's identity using the full name and date of birth on the wristband against the medication administration record (MAR) prior to administration.","zh":"在给药前，使用腕带上的全名和出生日期与药物给药记录 (MAR) 对照，核实患者的身份。"},{"id":"r3","en":"Administering a scheduled intravenous push medication through an active infusion line with an incompatible primary fluid, without flushing before and after.","zh":"通过输注不相容主要液体的活动性输液管线，给予计划的静脉推注药物，且在推注前后均未进行冲管。"},{"id":"r4","en":"Drawing up NPH insulin and Regular insulin in a single syringe, ensuring the Regular insulin is drawn into the syringe first.","zh":"将 NPH 胰岛素和普通 (Regular) 胰岛素吸入同一个注射器中，确保先将普通胰岛素吸入注射器。"},{"id":"r5","en":"Leaving a scheduled oral medication at the client's bedside table because the client is currently in the bathroom.","zh":"将计划口服的药物留在患者的床头柜上，因为患者目前正在洗手间。"}],"columns":[{"id":"c1","en":"Safe Practice","zh":"安全操作"},{"id":"c2","en":"Unsafe Practice","zh":"不安全操作"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c2"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c1"]},{"rowId":"r5","columnIds":["c2"]}]},"rationaleCorrectEn":"Safe and unsafe medication practices are guided by standard medication safety rules (the 'Rights' of medication administration). 1) Crushing extended-release tablets (r1) is unsafe because it destroys the time-release mechanism, causing the entire dose to absorb rapidly, risking toxicity or mucosal irritation. 2) Using two unique identifiers (name/DOB) (r2) is a standard safe practice to prevent patient identification errors. 3) Administering incompatible IV medications without flushing before and after (r3) is unsafe because chemical precipitation can form in the tubing, risking line occlusion or venous emboli. 4) Drawing up Regular (clear) insulin before NPH (cloudy) (r4) is a safe practice ('clear before cloudy') that prevents contaminating the Regular insulin vial with NPH. 5) Leaving medications unattended at the bedside (r5) is unsafe because the nurse cannot verify administration, and it poses an accidental ingestion safety risk to visitors or other clients.","rationaleCorrectZh":"安全和不安全的给药操作由标准的用药安全规则（给药的“正确原则”）指导。1) 粉碎缓释片 (r1) 是不安全的，因为它破坏了定时释放机制，导致整个剂量迅速吸收，存在毒性或黏膜刺激风险。2) 使用两个唯一的标识符（姓名/出生日期）(r2) 是防止患者身份识别错误的标准安全操作。3) 在给药前后不冲洗的情况下给予不相容的静脉药物 (r3) 是不安全的，因为管路中会形成化学沉淀，从而存在管线堵塞或静脉栓塞的风险。4) 在 NPH（浑浊）胰岛素之前吸入普通（清亮）胰岛素 (r4) 是一种安全的操作（“先清后浊”），可防止普通胰岛素瓶受到 NPH 的污染。5) 将药物无人看管地留在床边 (r5) 是不安全的，因为护士无法核实给药情况，且这会对访客或其他患者构成意外误服的安全风险。","testTakingStrategyEn":"Evaluate each action against core nursing safety principles. Classify crushing extended-release medications, leaving medications unattended, and administering incompatible drugs without flushes as unsafe. Classify checking two patient identifiers and the 'clear before cloudy' insulin drawing technique as safe.","testTakingStrategyZh":"根据核心护理安全原则评估每项行动。将粉碎缓释药物、将药物无人看管留置以及在不冲洗的情况下给予不相容药物归类为不安全操作。将核对两个患者标识符和“先清后浊”胰岛素抽取技术归类为安全操作。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1030,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_backfill_dc_wellness_07","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.793","itemType":"dropdown_cloze","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.793.stem.en","stemPathZh":"questions.793.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[152,217],"terminalOffsetsZh":[40,53],"fullStemEn":"The nurse at a family wellness clinic is discussing preventive health screening with a 50-year-old client who has an average risk of colorectal cancer. Complete the clinical recommendations using the dropdown choices.","fullStemZh":"家庭健康诊所的护士正在与一名结直肠癌风险平均的 50 岁患者讨论预防性健康筛查。使用下拉选项完成临床建议。","terminalSentenceEn":"Complete the clinical recommendations using the dropdown choices.","terminalSentenceZh":"使用下拉选项完成临床建议。","penultimateSentenceEn":"The nurse at a family wellness clinic is discussing preventive health screening with a 50-year-old client who has an average risk of colorectal cancer.","penultimateSentenceZh":"家庭健康诊所的护士正在与一名结直肠癌风险平均的 50 岁患者讨论预防性健康筛查。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse should advise the client that routine screening with a screening colonoscopy should begin at age {{1}} and be repeated every {{2}} years if findings remain normal.","zh":"护士应建议患者，如果检查结果保持正常，使用筛查性结肠镜检查进行的常规筛查应从 {{1}} 岁开始，并且每 {{2}} 年重复一次。"},"dropdowns":[{"id":"1","options":[{"id":"o2","en":"45","zh":"45"},{"id":"o1","en":"40","zh":"40"},{"id":"o3","en":"50","zh":"50"}],"correct":"o2"},{"id":"2","options":[{"id":"o2","en":"10","zh":"10"},{"id":"o3","en":"15","zh":"15"},{"id":"o1","en":"5","zh":"5"}],"correct":"o2"}]},"rationaleCorrectEn":"According to the updated U.S. Preventive Services Task Force (USPSTF) guidelines, routine screening for colorectal cancer in average-risk individuals should begin at age 45 (1). This guideline was revised from age 50 in 2021 to address the rising incidence of early-onset colorectal cancer. For screening colonoscopy, if the initial results are normal and there are no high-risk factors (such as personal/family history of colorectal cancer or polyps), the recommended screening interval is every 10 years (2). Starting at age 40 (o1) is not recommended for average-risk individuals. Waiting until age 50 (o3) is outdated and misses the window for early detection. A 5-year interval (o1) is used for other modalities (e.g., flexible sigmoidoscopy or CT colonography) or for high-risk surveillance, but not for normal screening colonoscopy. A 15-year interval (o3) is too long to safely detect adenomas.","rationaleCorrectZh":"根据美国预防服务工作组 (USPSTF) 最新指南，对平均风险个体的常规结直肠癌筛查应从 45 岁开始 (1)。该指南于 2021 年从 50 岁进行了修订，以应对早发性结直肠癌发病率上升的问题。对于筛查性结肠镜检查，如果初始结果正常且无高危因素（例如结直肠癌或息肉的个人/家族史），推荐的筛查间隔为每 10 年一次 (2)。对于平均风险个体，不推荐从 40 岁 (o1) 开始。等到 50 岁 (o3) 已过时，会遗漏早期发现的窗口。5年间隔 (o1) 用于其他方式（例如乙状结肠镜检查或 CT 结肠造影）或高风险监测，但不适用于正常的筛查性结肠镜检查。15年间隔 (o3) 时间过长，无法安全地发现腺瘤。","testTakingStrategyEn":"Recall current USPSTF guidelines for health maintenance. Identify age 45 as the recommended starting age for average-risk colorectal cancer screening and 10 years as the correct screening interval for a normal colonoscopy.","testTakingStrategyZh":"回想当前的 USPSTF 健康维护指南。将 45 岁确定为推荐的平均风险结直肠癌筛查起始年龄，将 10 年确定为正常结肠镜检查的正确筛查间隔。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1031,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_backfill_hl_wellness_08","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.794","itemType":"highlight","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.794.stem.en","stemPathZh":"questions.794.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,166],"terminalOffsetsZh":[0,40],"fullStemEn":"Highlight the statements by the client that indicate a misunderstanding of diabetes self-management or represent a health literacy barrier requiring further teaching.","fullStemZh":"标出患者表明对糖尿病自我管理存在误解，或代表需要进一步指导的健康素养障碍的陈述。","terminalSentenceEn":"Highlight the statements by the client that indicate a misunderstanding of diabetes self-management or represent a health literacy barrier requiring further teaching.","terminalSentenceZh":"标出患者表明对糖尿病自我管理存在误解，或代表需要进一步指导的健康素养障碍的陈述。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"Clinic Interview Record: The nurse is reviewing the home self-care plan with a client who was recently diagnosed with type 2 diabetes. The client states:","zh":"诊所访谈记录：护士正在与一名新近诊断为 2 型糖尿病的患者审查家庭自我护理计划。患者陈述："},{"id":"s2","en":"\"I will check my feet every night using a hand mirror to look at my soles.\"","zh":"“我每天晚上都会用手镜检查我的脚，看看我的脚底。”","selectable":true},{"id":"s3","en":"\"I plan to stop taking my metformin once my fasting blood glucose stays under 100 mg/dL.\"","zh":"“一旦我的空腹血糖保持在 100 mg/dL 以下，我就打算停止服用二甲双胍。”","selectable":true},{"id":"s4","en":"\"I will cut my toenails in a rounded shape close to the skin to keep them neat.\"","zh":"“我会把趾甲剪成圆形并贴近皮肤，以保持整洁。”","selectable":true},{"id":"s5","en":"\"I will carry some hard candies with me at all times in case I feel shaky or sweaty.\"","zh":"“我会一直随身携带一些硬糖，以防我感到颤抖或出汗。”","selectable":true},{"id":"s6","en":"\"I don't need to read the medication bottles because my spouse manages and sets up my weekly pill organizer.\"","zh":"“我不需要阅读药瓶，因为我配偶管理并帮我准备每周的药盒。”","selectable":true}],"correct":["s3","s4","s6"]}},"rationaleCorrectEn":"The client makes three statements that demonstrate unsafe self-care or self-management barriers. First, planning to stop metformin once blood glucose is controlled (s3) shows a misunderstanding of chronic disease management; type 2 diabetes is chronic, and oral hypoglycemics are taken long-term to maintain glycemic control, not discontinued when targets are met. Second, cutting toenails rounded and close to the skin (s4) is incorrect; diabetic clients must cut toenails straight across and file the edges to avoid micro-injuries and ingrown toenails, which can lead to non-healing ulcers. Third, refusing to read prescription bottles because a spouse manages the pill organizer (s6) represents a significant health literacy and safety barrier, placing the client at high risk for medication errors if the spouse is unavailable. Daily foot inspection using a mirror (s2) and carrying fast-acting glucose (s5) are correct self-care actions.","rationaleCorrectZh":"患者做出了三处表现出不安全自我护理或自我管理障碍的陈述。首先，计划在血糖控制后停止服用二甲双胍 (s3) 表现出对慢性病管理的误解；2型糖尿病是慢性的，口服降糖药需要长期服用以维持血糖控制，而不是在达到目标后就停药。其次，将趾甲剪成圆形并贴近皮肤 (s4) 是错误的；糖尿病患者必须横向平剪趾甲并用锉刀修平边缘，以避免微小损伤和趾甲内生，否则会导致难愈性溃疡。第三，因为配偶管理药盒而拒绝阅读处方药瓶 (s6) 代表了显着的健康素养和安全障碍，这会在配偶不在时使患者面临高用药错误风险。每天使用镜子检查脚部 (s2) 和携带快速释放葡萄糖 (s5) 是正确的自我护理行为。","testTakingStrategyEn":"Identify errors in diabetic self-management (improper toenail cutting, stopping chronic medication based on blood sugar improvement) and cues indicating a lack of basic medication literacy/independence. Exclude correct health promotion actions.","testTakingStrategyZh":"识别糖尿病自我管理中的错误（不正确的趾甲修剪、根据血糖改善情况停用慢性药物）以及提示缺乏基本用药素养/独立性的线索。排除正确的健康促进措施。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1032,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_backfill_bt_wellness_09","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.795","itemType":"bowtie","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.795.stem.en","stemPathZh":"questions.795.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[356,503],"terminalOffsetsZh":[112,150],"fullStemEn":"A 68-year-old female client with a history of moderate chronic obstructive pulmonary disease (COPD) presents for a wellness exam. She reports smoking 6 cigarettes daily, has no record of receiving any prior pneumococcal conjugate vaccines (history unknown), and demonstrates incorrect inhalation technique during her metered-dose inhaler (MDI) assessment. Complete the diagram by selecting the most likely clinical condition, the two priority nursing actions, and the two clinical parameters to monitor.","fullStemZh":"一名患有中度慢性阻塞性肺疾病 (COPD) 病史的 68 岁女性患者来诊所进行健康检查。她报告每日吸烟 6 支，没有接种过任何肺炎球菌结合疫苗的记录（接种史未知），并且在定量吸入器 (MDI) 评估中表现出不正确的吸入技术。通过选择最可能的临床情况、两项优先护理措施和两个要监测的临床参数来完成图示。","terminalSentenceEn":"Complete the diagram by selecting the most likely clinical condition, the two priority nursing actions, and the two clinical parameters to monitor.","terminalSentenceZh":"通过选择最可能的临床情况、两项优先护理措施和两个要监测的临床参数来完成图示。","penultimateSentenceEn":"She reports smoking 6 cigarettes daily, has no record of receiving any prior pneumococcal conjugate vaccines (history unknown), and demonstrates incorrect inhalation technique during her metered-dose inhaler (MDI) assessment.","penultimateSentenceZh":"她报告每日吸烟 6 支，没有接种过任何肺炎球菌结合疫苗的记录（接种史未知），并且在定量吸入器 (MDI) 评估中表现出不正确的吸入技术。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Most likely condition","zh":"最可能的疾病"},"tokens":[{"id":"c3","en":"Deficient knowledge of respiratory physiology","zh":"对呼吸生理学知识缺乏"},{"id":"c2","en":"Impaired gas exchange","zh":"气体交换受损"},{"id":"c1","en":"Ineffective health maintenance","zh":"低效健康维护"}],"correct":"c1"},"actions":{"prompt":{"en":"Actions to take","zh":"应采取的措施"},"tokens":[{"id":"a1","en":"Provide education and return-demonstration training on MDI use with a spacer","zh":"提供关于使用储雾罐配合 MDI 吸入器的指导和回示示范培训"},{"id":"a2","en":"Administer the pneumococcal conjugate vaccine (PCV20) and annual influenza vaccine per immunization history guidelines","zh":"根据免疫接种指南给予符合条件的肺炎球菌结合疫苗 (PCV20) 和年度流感疫苗"},{"id":"a4","en":"Advise the client to use her rescue albuterol inhaler on a fixed, scheduled daily regimen","zh":"建议患者按每日固定时间计划使用沙丁胺醇急救吸入器"},{"id":"a3","en":"Instruct the client to immediately discontinue smoking without nicotine replacement or behavioral support","zh":"指导患者在没有尼古丁替代或行为支持的情况下立即戒烟"}],"correct":["a1","a2"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"应监测的指标"},"tokens":[{"id":"p2","en":"Uptake and compliance with smoking cessation strategies","zh":"吸烟戒断策略的采纳和依从性"},{"id":"p4","en":"Sputum culture results every 3 months","zh":"每 3 个月监测一次痰培养结果"},{"id":"p1","en":"MDI and spacer inhalation technique during return-demonstration","zh":"回示示范期间 MDI 和储雾罐的吸入技术"},{"id":"p3","en":"Arterial blood gas (ABG) values at each visit","zh":"每次就诊时的动脉血气 (ABG) 值"}],"correct":["p1","p2"]}}},"rationaleCorrectEn":"The client has multiple lifestyle, immunization, and pharmacological coordination gaps, which fit the diagnosis of Ineffective health maintenance (c1). Impaired gas exchange (c2) is a physiological nursing diagnosis, which is not the primary focus of a routine wellness screening. Deficient knowledge (c3) is too narrow and doesn't fully capture the clinical need for preventative immunizations and lifestyle modifications. The priority nursing actions are: 1) Provide education on using a spacer with the MDI (a1) to ensure the medication is deposited in the lungs instead of the oropharynx, improving drug absorption. 2) Administer recommended preventative immunizations (PCV20 and influenza vaccine) (a2) to protect this high-risk COPD client from respiratory infections. Instructing the client to quit cold turkey without cessation support (a3) is ineffective. Rescue albuterol should only be used as-needed (PRN) for acute symptoms, not scheduled daily (a4). Key monitoring parameters include direct observation of MDI/spacer technique (p1) to confirm learning, and tracking smoking cessation progress (p2). ABGs (p3) and sputum cultures (p4) are not indicated for baseline wellness screening in a stable client.","rationaleCorrectZh":"患者在生活方式、疫苗接种和药物协调方面存在多项差距，这符合低效健康维护 (c1) 的诊断。气体交换受损 (c2) 属于生理性护理诊断，并非常规健康筛查的主要焦点。知识缺乏 (c3) 过于局限，不能完全涵盖对预防性免疫接种和生活方式调整的临床需求。优先的护理措施是：1) 提供使用储雾罐配合 MDI 的教育 (a1)，以确保药物沉积在肺部而非口咽部，从而改善药物吸收。2) 给予推荐的预防性疫苗（PCV20 和流感疫苗）(a2)，以保护这名高危 COPD 患者免受呼吸道感染。指导患者在没有任何戒烟支持的情况下硬性戒烟 (a3) 是无效的。急救用沙丁胺醇应仅在急性症状发作时按需使用（PRN），不能每日定时计划使用 (a4)。关键的监测参数包括直接观察 MDI/储雾罐使用技术 (p1) 以确认学习效果，以及追踪戒烟进展 (p2)。动脉血气分析 (p3) 和痰培养 (p4) 不适用于稳定患者的基线健康维护监测。","testTakingStrategyEn":"Differentiate between preventative wellness needs and acute physiological issues. Select the health maintenance category, prioritize educational (spacer technique) and preventative interventions (pneumococcal/flu vaccines), and choose monitoring parameters that evaluate compliance rather than diagnostic tests.","testTakingStrategyZh":"区分预防性健康维护需求与急性生理问题。选择健康维护诊断，优先选择教育性（储雾罐技术）和预防性干预措施（肺炎球菌/流感疫苗），并选择评估依从性的监测参数而非诊断性检查。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1033,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_backfill_hl_legal_10","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.796","itemType":"highlight","category":"Management of Care","topic":"Legal & Ethical Principles","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.796.stem.en","stemPathZh":"questions.796.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,113],"terminalOffsetsZh":[0,26],"fullStemEn":"Highlight the documented actions by the nurse that constitute a violation of legal or ethical nursing principles.","fullStemZh":"标出记录在案的护士构成违反法律或伦理护理原则的行动。","terminalSentenceEn":"Highlight the documented actions by the nurse that constitute a violation of legal or ethical nursing principles.","terminalSentenceZh":"标出记录在案的护士构成违反法律或伦理护理原则的行动。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"Shift Audit Record: The nursing supervisor reviews the documentation and event logs of the medical-surgical unit:","zh":"班次审计记录：护理主管审查内外科病房的病历记录和事件日志："},{"id":"s2","en":"A nurse accepts a $200 cash gift from a client's family member as appreciation for attentive care.","zh":"一名护士接受了患者家属赠送的 200 美元现金，作为对其细心照护的感谢。","selectable":true},{"id":"s3","en":"A nurse accesses the electronic health record of an acquaintance hospitalized on another unit to check their diagnostic test results.","zh":"一名护士访问了在另一个病房住院的熟人的电子健康记录，以查看其诊断检查结果。","selectable":true},{"id":"s4","en":"A nurse witnesses a client's signature on a surgical consent form after confirming the surgeon explained the procedure.","zh":"一名护士在确认外科医生已解释手术操作后，在手术知情同意书上见证了患者的签字。","selectable":true},{"id":"s5","en":"A nurse delegates the insertion of a new indwelling urinary catheter to an unlicensed assistive personnel (UAP).","zh":"一名护士将插入新留置导尿管的任务分配给无证辅助人员 (UAP)。","selectable":true},{"id":"s6","en":"A nurse obtains a telephone consent for emergency surgery from a designated healthcare proxy, with a second nurse listening on the line to verify.","zh":"一名护士从指定的医疗代理人处获取紧急手术的电话同意书，并由第二名护士在电话线旁听以进行核实。","selectable":true}],"correct":["s2","s3","s5"]}},"rationaleCorrectEn":"The nurse performs three actions that violate legal or ethical nursing guidelines. First, accepting a cash gift (s2) is an ethical boundary violation; nurses must refuse monetary gifts to maintain professional relationships and avoid conflicts of interest. Second, accessing the record of an acquaintance on another unit (s3) without a clinical 'need-to-know' is a direct HIPAA violation of client confidentiality and privacy. Third, delegating the insertion of an indwelling catheter (s5)—which is an invasive sterile procedure requiring clinical judgment—to a UAP violates legal delegation rules, as this task is outside the UAP's legal scope of practice. Witnessing consent (s4) and obtaining verified telephone proxy consent (s6) are compliant, standard legal practices.","rationaleCorrectZh":"护士执行了三项违反法律或伦理护理指南的行动。首先，接受现金赠礼 (s2) 违反了伦理界限；护士必须拒绝货币性礼物，以维持专业关系并避免利益冲突。其次，在没有临床“工作需要”的情况下访问另一个病房熟人的病历 (s3)，直接违反了 HIPAA 关于患者机密和隐私的规定。第三，将插入留置导尿管 (s5)——这是一种需要临床判断的侵入性无菌操作——分配给 UAP，违反了法律分配规则，因为这项任务超出了 UAP 的法律执业范围。见证同意书签字 (s4) 以及获取核实的电话代理人同意书 (s6) 属于合规、标准的法律实践。","testTakingStrategyEn":"Recall the legal boundaries of delegation (UAPs cannot perform invasive sterile procedures), HIPAA limits (access is only allowed for directly assigned clients with clinical need), and professional ethical boundaries (no cash gifts). Identify these violations and exclude standard legal consent actions.","testTakingStrategyZh":"回想任务分配的法律界限（UAP 不能执行侵入性无菌操作）、HIPAA 限制（仅允许在有临床需要时访问直接分配的患者）以及专业伦理界限（不能收受现金礼物）。识别这些违规行为并排除标准的合法同意书签署行为。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1034,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_backfill_bt_legal_11","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.797","itemType":"bowtie","category":"Management of Care","topic":"Legal & Ethical Principles","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.797.stem.en","stemPathZh":"questions.797.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[315,462],"terminalOffsetsZh":[85,123],"fullStemEn":"A 45-year-old male client is admitted with active gastrointestinal bleeding. The client is alert, oriented, and competent, and he explicitly refuses a blood transfusion due to his religious beliefs. His family members are extremely angry and demand that the nurse administer the blood when the client falls asleep. Complete the diagram by selecting the most likely clinical condition, the two priority nursing actions, and the two clinical parameters to monitor.","fullStemZh":"一名 45 岁男性患者因活动性消化道出血入院。患者意识清醒、定向力正常、具有行为能力，并且由于宗教信仰，他明确拒绝输血。他的家属非常生气，并要求护士在患者睡着时给其输血。通过选择最可能的临床情况、两项优先护理措施和两个要监测的临床参数来完成图示。","terminalSentenceEn":"Complete the diagram by selecting the most likely clinical condition, the two priority nursing actions, and the two clinical parameters to monitor.","terminalSentenceZh":"通过选择最可能的临床情况、两项优先护理措施和两个要监测的临床参数来完成图示。","penultimateSentenceEn":"His family members are extremely angry and demand that the nurse administer the blood when the client falls asleep.","penultimateSentenceZh":"他的家属非常生气，并要求护士在患者睡着时给其输血。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Most likely condition","zh":"最可能的疾病"},"tokens":[{"id":"c1","en":"Right to refuse treatment (autonomy)","zh":"拒绝治疗的权利（自主权）"},{"id":"c2","en":"Implied consent in emergency situations","zh":"紧急情况下的默示同意"},{"id":"c3","en":"Substituted decision-making by family","zh":"家庭替代决策"}],"correct":"c1"},"actions":{"prompt":{"en":"Actions to take","zh":"应采取的措施"},"tokens":[{"id":"a2","en":"Document the client's refusal and discussion of risks in the record","zh":"在病历中记录患者的拒绝以及风险告知讨论"},{"id":"a4","en":"Obtain written consent from the family to override the client's refusal","zh":"获取家属的书面同意以推翻患者的拒绝"},{"id":"a3","en":"Administer the blood transfusion covertly once the client falls asleep","zh":"一旦患者入睡，暗中给予输血"},{"id":"a1","en":"Respect the client's decision and withhold the blood transfusion","zh":"尊重患者的决定并扣留输血"}],"correct":["a1","a2"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"应监测的指标"},"tokens":[{"id":"p4","en":"Hospital financial liability calculations","zh":"医院财务责任计算"},{"id":"p2","en":"Signs of tissue hypoxia and active bleeding (vital signs, hemoglobin)","zh":"组织缺氧和活动性出血的征象（生命体征、血红蛋白）"},{"id":"p3","en":"Family satisfaction scores regarding the clinical decision","zh":"家属对临床决定的满意度评分"},{"id":"p1","en":"Client's ongoing decision-making capacity and voluntariness","zh":"患者持续的决策能力和自愿性"}],"correct":["p1","p2"]}}},"rationaleCorrectEn":"An alert, oriented, and competent adult has the legal right to refuse any medical treatment, including life-saving therapies (blood transfusions), under the ethical principle of Autonomy (c1). Implied consent (c2) does not apply because the client is competent and has explicitly expressed refusal. The family cannot provide substituted consent (c3) because the client currently possesses decisional capacity. The priority nursing actions are to respect the competent client's choice and withhold the transfusion (a1), and document the refusal process, including the risk education (e.g., potential death) and provider notification (a2). Giving blood against the client's competent refusal constitutes battery (a3) and is illegal. Family members have no legal authority to override a competent client's decision (a4). Key parameters to monitor are the client's ongoing decisional capacity and freedom from family coercion (p1), and physiological signs of hypoxia/bleeding (p2) to manage the patient's condition supportively. Family satisfaction (p3) and financial liability (p4) do not override the client's legal rights.","rationaleCorrectZh":"根据自主权 (c1) 的伦理原则，意识清醒、定向力正常且具有行为能力的成年人有权拒绝任何医疗处理，包括挽救生命的疗法（输血）。默示同意 (c2) 不适用，因为患者具有行为能力且已明确表示拒绝。家属不能提供替代同意书 (c3)，因为患者目前具备决策能力。优先的护理措施是尊重具有行为能力的患者的选择并扣留输血 (a1)，记录拒绝过程，包括风险教育（例如潜在的死亡）和医生通知 (a2)。违背患者意愿给予输血构成殴打蓄意伤害 (a3) 且属于违法行为。家属无权推翻具有行为能力的患者的决定 (a4)。要监测的关键参数包括患者持续的决策能力和免受家庭胁迫 (p1)，以及缺氧/出血的生理征象 (p2) 以支持性地管理患者的病情。家属满意度 (p3) 和财务责任 (p4) 不能逾越患者的法律权利。","testTakingStrategyEn":"Understand patient rights and ethics. A competent client's right of autonomy is superior to family demands and physician wishes. Identify withholding transfusion and documenting risks/refusal as correct actions. Choose monitoring parameters that evaluate cognitive capacity and bleeding symptoms. Reject family override or covert administration.","testTakingStrategyZh":"理解患者权利和伦理。有能力患者的自主权高于家属的要求和医生的意愿。确定扣留输血并记录风险/拒绝是正确的措施。选择评估认知能力和出血症状的监测参数。拒绝家属推翻决定或暗中给药。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1035,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_backfill_hl_physadapt_12","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.798","itemType":"highlight","category":"Physiological Adaptation","topic":"Endocrine & Neurological Disorders","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.798.stem.en","stemPathZh":"questions.798.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,203],"terminalOffsetsZh":[0,51],"fullStemEn":"Highlight the clinical findings that represent acute, life-threatening physiological decompensation requiring immediate emergency stabilization (such as mechanical ventilation or intensive care support).","fullStemZh":"标出代表需要立即进行紧急稳定治疗（例如机械通气或重症监护支持）的急性、危及生命的生理失代偿的临床发现。","terminalSentenceEn":"Highlight the clinical findings that represent acute, life-threatening physiological decompensation requiring immediate emergency stabilization (such as mechanical ventilation or intensive care support).","terminalSentenceZh":"标出代表需要立即进行紧急稳定治疗（例如机械通气或重症监护支持）的急性、危及生命的生理失代偿的临床发现。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"Admission Record: A 68-year-old female with a history of hypothyroidism is brought to the emergency department by her family.","zh":"入院记录：一名有甲状腺功能减退症病史的 68 岁女性由家属送至急诊科。"},{"id":"s2","en":"The client is obtunded, responding only to painful stimuli.","zh":"患者处于嗜睡/昏迷状态，仅对疼痛刺激有反应。","selectable":true},{"id":"s3","en":"Her body temperature is 93.8 °F (34.3 °C), and skin is cold and dry.","zh":"她的体温为 93.8 °F (34.3 °C)，皮肤冰冷干燥。","selectable":true},{"id":"s4","en":"Blood pressure is 82/44 mmHg, and heart rate is 38 bpm.","zh":"血压为 82/44 mmHg，心率为 38次/分。","selectable":true},{"id":"s5","en":"Respirations are 8 breaths/min, shallow, with an SpO2 of 85% on room air.","zh":"呼吸为 8次/分，表浅，室内空气下 SpO2 为 85%。","selectable":true},{"id":"s6","en":"The client has non-pitting edema of the face and hands.","zh":"患者面部和手部有非凹陷性水肿。","selectable":true},{"id":"s7","en":"A small scar is noted on the anterior neck from a prior thyroid surgery.","zh":"颈前部可见既往甲状腺手术留下的微小瘢痕。","selectable":true}],"correct":["s2","s3","s4","s5"]}},"rationaleCorrectEn":"The client is exhibiting clinical cues indicating myxedema coma, a life-threatening crisis of severe hypothyroidism. Key signs of this emergency include: 1) Altered mental status (s2: obtundation), indicating severe neurological slowdown. 2) Profound hypothermia (s3: 93.8 °F (34.3 °C)), indicating failed thermoregulation. 3) Cardiovascular collapse (s4: hypotension and bradycardia), indicating severe myocardial depression. 4) Respiratory failure (s5: bradypnea and hypoxia), which requires immediate supportive mechanical ventilation. Generalized non-pitting edema (s6: myxedema) is a classic finding of chronic hypothyroidism, but is not a life-threatening crisis indicator itself. The thyroidectomy scar (s7) is an expected chronic post-surgical finding that confirms the history but is not a clinical manifestation of acute crisis.","rationaleCorrectZh":"该患者表现出指示粘液性水肿昏迷的临床征象，这是一种由严重甲状腺功能减退症引起的危及生命的危机。此项紧急情况的关键征象包括：1) 精神状态改变（s2：嗜睡/昏迷），表明严重的神经系统减缓。2) 严重低温（s3：93.8 °F (34.3 °C)），表明温控功能失效。3) 心血管崩溃（s4：低血压和心动过缓），表明心肌受抑制严重。4) 呼吸衰竭（s5：呼吸过缓和缺氧），这需要立即进行辅助性机械通气。全身非凹陷性水肿（s6：粘液性水肿）是慢性甲状腺功能减退症的经典表现，但其本身并不是危及生命的危象指标。甲状腺切除术瘢痕（s7）是预期的慢性术后发现，可证实病史，但不是急性危象的临床表现。","testTakingStrategyEn":"Differentiate between chronic baseline features of severe hypothyroidism (like non-pitting edema and a surgical scar) and acute, life-threatening symptoms of myxedema coma requiring emergency stabilization (obtunded mental status, profound hypothermia, cardiovascular collapse, and respiratory failure/hypoventilation).","testTakingStrategyZh":"区分严重甲状腺功能减退症的慢性基线特征（如非凹陷性水肿和手术瘢痕）与需要紧急稳定治疗的粘液性水肿昏迷急性、危及生命的症状（嗜睡/昏迷状态、严重低温、心血管崩溃和呼吸衰竭/呼吸过缓）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1036,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_lead_poisoning_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.799","itemType":"case_study","category":"Health Promotion and Maintenance","topic":"Pediatric & Toddler Safety","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.799.stem.en","stemPathZh":"questions.799.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[164,223],"terminalOffsetsZh":[50,73],"fullStemEn":"Unfolding Case: 18-Month-Old Toddler and Lead Exposure Risk An 18-month-old female is brought to the pediatric clinic by her father for a routine well-child visit. The family recently moved into a rental home built in 1950.","fullStemZh":"展开式案例：18个月龄幼儿与铅暴露风险 一名18个月大的女婴由父亲带到儿科诊所进行常规儿童保健随访。该家庭最近搬进了一栋建于1950年的出租屋中。","terminalSentenceEn":"The family recently moved into a rental home built in 1950.","terminalSentenceZh":"该家庭最近搬进了一栋建于1950年的出租屋中。","penultimateSentenceEn":"Unfolding Case: 18-Month-Old Toddler and Lead Exposure Risk An 18-month-old female is brought to the pediatric clinic by her father for a routine well-child visit.","penultimateSentenceZh":"展开式案例：18个月龄幼儿与铅暴露风险 一名18个月大的女婴由父亲带到儿科诊所进行常规儿童保健随访。","responseContext":{},"rationaleCorrectEn":"This case study focuses on pediatric lead exposure, assessing risk factors, interpreting blood lead levels, explaining dietary choices that compete with lead absorption, and providing correct environmental safety actions.","rationaleCorrectZh":"该案例研究重点关注儿童铅暴露，评估风险因素、评估血铅水平、阐明与铅吸收竞争的饮食选择以及提供正确的环境安全操作。","testTakingStrategyEn":"Focus on pediatric environmental health risks, heavy metal safety limits, and dietary absorption mechanics.","testTakingStrategyZh":"重点关注小儿环境健康风险、重金属安全限值以及膳食吸收机制。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1037,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_lead_poisoning_01","embeddedQuestionId":"gemini_gap_case_lead_poisoning_01_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.799.caseStudy.questions.0","itemType":"select_all","category":"Health Promotion and Maintenance","topic":"Pediatric & Toddler Safety","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.799.caseStudy.questions.0.stem.en","stemPathZh":"questions.799.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[98,120],"terminalOffsetsZh":[27,35],"fullStemEn":"Which findings from the well-child note represent risk factors for lead exposure in this toddler? Select all that apply.","fullStemZh":"儿童保健记录中的哪些发现代表了该幼儿铅暴露的风险因素？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which findings from the well-child note represent risk factors for lead exposure in this toddler?","penultimateSentenceZh":"儿童保健记录中的哪些发现代表了该幼儿铅暴露的风险因素？","responseContext":{"type":"select_all","options":[{"id":"E","en":"Normal stack of 3 blocks","zh":"正常叠放3个积木"},{"id":"A","en":"Home built in 1950","zh":"房屋建于1950年"},{"id":"D","en":"Weight at the 50th percentile","zh":"体重处于第50百分位数"},{"id":"B","en":"Peeling paint visible on playroom windowsills","zh":"游戏室窗台上可见油漆剥落"},{"id":"C","en":"Toddler's frequent hand-to-mouth behavior","zh":"幼儿频繁的手-口行为"}],"correct":["A","B","C"]},"rationaleCorrectEn":"Houses built before 1978 commonly contain lead-based paint. Peeling or chipping paint on windowsills is a major hazard as lead dust accumulates there. Toddlers are at high risk due to normal developmental hand-to-mouth behaviors, leading to ingestion of lead dust or paint chips. Normal physical growth (50th percentile) and milestone achievement (stacking 3 blocks) are expected findings and not risk factors.","rationaleCorrectZh":"1978年以前建造的房屋通常含有铅基涂料。窗台上油漆剥落或剥离是一项主要危害，因为铅尘会在那里积聚。由于正常发育阶段的手-口行为，幼儿处于高风险之中，这会导致吸入铅尘或漆屑。正常体格发育（第50百分位数）和里程碑达成（叠放3个积木）是预期的正常发现，而不是风险因素。","testTakingStrategyEn":"Connect environmental epidemiology (pre-1978 homes, lead paint) with developmental pediatric risks (hand-to-mouth stage) to isolate risk factors from normal growth indicators.","testTakingStrategyZh":"将环境流行病学（1978年前的房屋、铅漆）与儿科发育风险（手-口阶段）联系起来，以从正常生长指标中分离出风险因素。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1038,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_lead_poisoning_01","embeddedQuestionId":"gemini_gap_case_lead_poisoning_01_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.799.caseStudy.questions.1","itemType":"multiple_choice","category":"Health Promotion and Maintenance","topic":"Pediatric & Toddler Safety","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.799.caseStudy.questions.1.stem.en","stemPathZh":"questions.799.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[66,126],"terminalOffsetsZh":[27,39],"fullStemEn":"The nurse interprets the toddler's blood lead level of 18 mcg/dL. Which action is most appropriate for the nurse to implement?","fullStemZh":"护士对该幼儿 18 mcg/dL 的血铅水平进行评估。护士采取哪项行动最合适？","terminalSentenceEn":"Which action is most appropriate for the nurse to implement?","terminalSentenceZh":"护士采取哪项行动最合适？","penultimateSentenceEn":"The nurse interprets the toddler's blood lead level of 18 mcg/dL.","penultimateSentenceZh":"护士对该幼儿 18 mcg/dL 的血铅水平进行评估。","responseContext":{"type":"multiple_choice","options":[{"id":"B","en":"Prepare the client for immediate inpatient intravenous chelation therapy","zh":"准备患者立即住院接受静脉注射螯合疗法"},{"id":"A","en":"Provide education on environmental control and schedule a repeat venous blood lead test in 1 to 3 months","zh":"提供环境控制方面的教育，并安排在1至3个月内复查静脉血铅"},{"id":"D","en":"Instruct the parents to administer oral activated charcoal immediately","zh":"指导家长立即给予口服活性炭"},{"id":"C","en":"Reassure the family that this level is normal and requires no follow-up","zh":"向家属保证该水平正常，不需要跟进"}],"correct":["A"]},"rationaleCorrectEn":"A blood lead level (BLL) of 18 mcg/dL is elevated (elevated is defined by CDC as ≥3.5 mcg/dL). It requires parent education on environmental lead sources, nutritional adjustments to lower absorption, and follow-up venous testing (typically within 1-3 months). Inpatient chelation therapy is indicated only for severe lead poisoning (BLL ≥45 mcg/dL). It is not a normal level. Activated charcoal is ineffective because lead is not absorbed by charcoal.","rationaleCorrectZh":"血铅水平 (BLL) 为 18 mcg/dL 属于升高（CDC 将升高定义为 ≥3.5 mcg/dL）。这需要向家长提供关于环境中铅来源的教育、降低吸收的营养调整以及随访静脉血测试（通常在1-3个月内）。住院螯合治疗仅适用于重度铅中毒 (BLL ≥45 mcg/dL)。这不是正常水平。活性炭是无效的，因为活性炭不吸收铅。","testTakingStrategyEn":"Recall lead toxicity guidelines. Identify the threshold for chelation therapy (BLL ≥45 mcg/dL) and the reference value (BLL ≥3.5 mcg/dL). Choose the non-invasive monitoring and educational option for intermediate elevations.","testTakingStrategyZh":"回忆铅中毒指南。确定螯合治疗的阈值 (BLL ≥45 mcg/dL) 和参考值 (BLL ≥3.5 mcg/dL)。对于中度升高，选择无创监测和教育选项。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1039,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_lead_poisoning_01","embeddedQuestionId":"gemini_gap_case_lead_poisoning_01_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.799.caseStudy.questions.2","itemType":"matrix","category":"Health Promotion and Maintenance","topic":"Pediatric & Toddler Safety","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.799.caseStudy.questions.2.stem.en","stemPathZh":"questions.799.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[81,198],"terminalOffsetsZh":[23,56],"fullStemEn":"The nurse is planning dietary teaching to reduce lead absorption in the toddler. For each dietary component, click to specify if it is indicated or contraindicated to reduce lead uptake in the body.","fullStemZh":"护士正准备进行饮食指导以减少幼儿体内的铅吸收。对于每种饮食成分，点击以指定它是适用于减少体内铅吸收还是属于禁忌。","terminalSentenceEn":"For each dietary component, click to specify if it is indicated or contraindicated to reduce lead uptake in the body.","terminalSentenceZh":"对于每种饮食成分，点击以指定它是适用于减少体内铅吸收还是属于禁忌。","penultimateSentenceEn":"The nurse is planning dietary teaching to reduce lead absorption in the toddler.","penultimateSentenceZh":"护士正准备进行饮食指导以减少幼儿体内的铅吸收。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Ensure adequate daily intake of dietary iron and calcium","zh":"确保每日摄入充足的膳食铁和钙"},{"id":"r2","en":"Encourage the child to eat frequent small meals rather than empty stomach","zh":"鼓励孩子频繁进食少量食物，避免空腹"},{"id":"r3","en":"Provide a high-fat diet containing abundant saturated oils","zh":"提供富含饱和油脂的高脂饮食"}],"columns":[{"id":"c1","en":"Indicated","zh":"适用"},{"id":"c2","en":"Contraindicated","zh":"禁用"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]}]},"rationaleCorrectEn":"Dietary iron, calcium, and vitamin C are indicated because they compete with lead for absorption sites in the GI tract; adequate intake reduces lead absorption. Lead is absorbed more rapidly on an empty stomach, so frequent small meals are indicated. High-fat diets are contraindicated because fat increases lead absorption.","rationaleCorrectZh":"适用膳食铁、钙和维生素C，因为它们与铅竞争胃肠道中的吸收部位；充足的摄入可以减少铅的吸收。空腹时铅吸收更快，因此适用少量多餐。高脂饮食是禁忌的，因为脂肪会增加铅的吸收。","testTakingStrategyEn":"Apply nutritional principles of heavy-metal binding. Saturated fat increases lead uptake, while iron/calcium deficiency increases lead absorption by upregulating shared gut transporters.","testTakingStrategyZh":"应用重金属结合的营养学原理。饱和脂肪会增加铅的摄入，而铁/钙缺乏会通过上调共享的肠道转运蛋白来增加铅的吸收。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1040,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_lead_poisoning_01","embeddedQuestionId":"gemini_gap_case_lead_poisoning_01_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.799.caseStudy.questions.3","itemType":"dropdown_cloze","category":"Health Promotion and Maintenance","topic":"Pediatric & Toddler Safety","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.799.caseStudy.questions.3.stem.en","stemPathZh":"questions.799.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[71,165],"terminalOffsetsZh":[14,35],"fullStemEn":"The nurse provides environmental cleaning instructions to the parents. Select the appropriate options from the dropdown menus to complete the educational guidelines.","fullStemZh":"护士向家长提供环境清洁指导。从下拉菜单中选择合适的选项以完成教育指南。","terminalSentenceEn":"Select the appropriate options from the dropdown menus to complete the educational guidelines.","terminalSentenceZh":"从下拉菜单中选择合适的选项以完成教育指南。","penultimateSentenceEn":"The nurse provides environmental cleaning instructions to the parents.","penultimateSentenceZh":"护士向家长提供环境清洁指导。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"To reduce lead dust inhalation and ingestion, the parents should clean hard surfaces using a {{1}} and prepare infant formula using {{2}}.","zh":"为减少铅尘吸入和摄入，家长应使用 {{1}} 清洁硬表面，并使用 {{2}} 冲调婴儿配方奶。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"wet mop or damp cloth","zh":"湿拖把或湿布"},{"id":"o2","en":"dry broom or feather duster","zh":"干扫帚或羽毛掸"},{"id":"o3","en":"standard upright vacuum cleaner","zh":"标准立式吸尘器"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"hot tap water straight from the faucet","zh":"直接从龙头接的热自来水"},{"id":"o1","en":"cold tap water run for 1 to 2 minutes","zh":"放水1至2分钟后的冷自来水"},{"id":"o3","en":"unfiltered well water","zh":"未经过滤的井水"}],"correct":"o1"}]},"rationaleCorrectEn":"Dry sweeping or dusting spreads lead-laden dust into the air, causing inhalation risks; wet cleaning methods (wet mop, damp cloths) trap dust and are indicated. Hot tap water dissolves lead from plumbing pipes more readily than cold water, so only cold tap water (run for 1-2 minutes to flush pipes) should be used for drinking, cooking, or formula reconstitution (and then heated if needed). Unfiltered well water is not recommended.","rationaleCorrectZh":"干扫或除尘会将含铅粉尘扬入空气中，引起吸入风险；湿式清洁方法（湿拖把、湿布）可滞留粉尘，是适用的。热自来水比冷水更容易溶解管道中的铅，因此只能使用冷自来水（放水1-2分钟以冲洗管道）用于饮用、烹饪或冲调配方奶（然后根据需要加热）。不推荐使用未经处理的井水。","testTakingStrategyEn":"Focus on mechanical containment of lead. Damp/wet cleaning prevents lead aerosolization. Cold water minimizes lead leaching from pipes, unlike hot water.","testTakingStrategyZh":"侧重于铅的机械防护。潮湿/湿式清洁可防止铅悬浮于空气中。与热水不同，冷水能最大程度减少铅从管道中滤出。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1041,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_hypertension_lifestyle_02","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.800","itemType":"case_study","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.800.stem.en","stemPathZh":"questions.800.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,200],"terminalOffsetsZh":[0,47],"fullStemEn":"Unfolding Case: Outpatient Lifestyle Management for Stage 1 Hypertension A 45-year-old male is seen in the outpatient clinic for follow-up of elevated blood pressure readings over the last two visits.","fullStemZh":"展开式案例：门诊1期高血压生活方式管理 一名45岁男性因过去两次随访中血压读数升高在门诊就诊。","terminalSentenceEn":"Unfolding Case: Outpatient Lifestyle Management for Stage 1 Hypertension A 45-year-old male is seen in the outpatient clinic for follow-up of elevated blood pressure readings over the last two visits.","terminalSentenceZh":"展开式案例：门诊1期高血压生活方式管理 一名45岁男性因过去两次随访中血压读数升高在门诊就诊。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This case study reviews stage 1 hypertension management, focusing on DASH diet mechanism of action, dietary food choices, cardiovascular exercise guidelines (150 min limit and isometric contraindication), and clinical follow-up evaluation.","rationaleCorrectZh":"该案例研究审查了1期高血压的管理，重点关注DASH饮食的作用机制、膳食食物选择、心血管运动指南（150分钟限制和等长运动禁忌证）以及临床随访评估。","testTakingStrategyEn":"Focus on diet modifications, minerals affecting blood pressure, and safe exercise guidelines.","testTakingStrategyZh":"重点关注饮食调整、影响血压的矿物质以及安全运动指南。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1042,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_hypertension_lifestyle_02","embeddedQuestionId":"gemini_gap_case_htn_lifestyle_02_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.800.caseStudy.questions.0","itemType":"multiple_choice","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.800.caseStudy.questions.0.stem.en","stemPathZh":"questions.800.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[89,197],"terminalOffsetsZh":[25,51],"fullStemEn":"The nurse provides education on the DASH (Dietary Approaches to Stop Hypertension) diet. Which statement by the client indicates a correct understanding of the primary dietary goal of this program?","fullStemZh":"护士提供关于DASH（饮食防治高血压）饮食的指导。患者的哪项陈述表明对该方案的主要饮食目标有正确理解？","terminalSentenceEn":"Which statement by the client indicates a correct understanding of the primary dietary goal of this program?","terminalSentenceZh":"患者的哪项陈述表明对该方案的主要饮食目标有正确理解？","penultimateSentenceEn":"The nurse provides education on the DASH (Dietary Approaches to Stop Hypertension) diet.","penultimateSentenceZh":"护士提供关于DASH（饮食防治高血压）饮食的指导。","responseContext":{"type":"multiple_choice","options":[{"id":"D","en":"I should substitute table salt with potassium chloride supplements without consulting my doctor.","zh":"我应该在不咨询医生的情况下用氯化钾补充剂代替食盐。"},{"id":"A","en":"I should eat foods high in potassium, calcium, and magnesium, and restrict my sodium intake.","zh":"我应该吃富含钾、钙和镁的食物，并限制钠的摄入。"},{"id":"C","en":"I need to restrict my fluid intake to less than 1 liter per day to reduce my blood volume.","zh":"我需要将每日液体摄入量限制在1升以下，以减少血容量。"},{"id":"B","en":"I must completely eliminate all carbohydrates and focus on eating a high-protein diet.","zh":"我必须完全不吃碳水化合物，并以高蛋白饮食为主。"}],"correct":["A"]},"rationaleCorrectEn":"The DASH diet focuses on increasing intake of minerals that naturally lower blood pressure (potassium, calcium, magnesium) through whole foods (fruits, vegetables, low-fat dairy), while restricting sodium. It is not a low-carbohydrate or high-protein diet. Fluid restriction is not indicated for stage 1 HTN (it is used in heart failure or ESRD). Substituting salt with potassium supplements without medical approval is unsafe, especially if renal function or concurrent drug use is unknown.","rationaleCorrectZh":"DASH饮食的重点是通过天然食物（水果、蔬菜、低脂乳制品）增加具有自然降低血压作用的矿物质（钾、钙、镁）的摄入，同时限制钠。它不是低碳水化合物或高蛋白饮食。1期高血压不需要限制液体（限水用于心力衰竭或ESRD）。在没有医生批准的情况下用钾补充剂代替盐是不安全的，尤其是在肾功能或合并用药未知的情况下。","testTakingStrategyEn":"Recall the dietary principles of the DASH diet. Choose the option that emphasizes sodium reduction along with blood-pressure-lowering minerals (K, Ca, Mg) from dietary sources.","testTakingStrategyZh":"回忆DASH饮食的膳食原则。选择强调减少钠摄入以及从食物中摄取降压矿物质（K、Ca、Mg）的选项。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1043,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_hypertension_lifestyle_02","embeddedQuestionId":"gemini_gap_case_htn_lifestyle_02_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.800.caseStudy.questions.1","itemType":"select_all","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.800.caseStudy.questions.1.stem.en","stemPathZh":"questions.800.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[125,147],"terminalOffsetsZh":[34,42],"fullStemEn":"The nurse assists the client in planning DASH-compliant meals. Which foods should the nurse encourage the client to include? Select all that apply.","fullStemZh":"护士协助患者计划符合DASH要求的膳食。护士应鼓励患者包含哪些食物？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which foods should the nurse encourage the client to include?","penultimateSentenceZh":"护士应鼓励患者包含哪些食物？","responseContext":{"type":"select_all","options":[{"id":"C","en":"Whole-wheat bread and brown rice","zh":"全麦面包和糙米"},{"id":"A","en":"Fresh bananas and spinach","zh":"新鲜香蕉和菠菜"},{"id":"E","en":"Baked salmon and skinless chicken breast","zh":"烤三文鱼和去皮鸡胸肉"},{"id":"D","en":"Canned soups and processed deli meats","zh":"罐装汤和加工熟肉制品"},{"id":"B","en":"Low-fat yogurt and skim milk","zh":"低脂酸奶和脱脂牛奶"}],"correct":["A","B","C","E"]},"rationaleCorrectEn":"Fresh fruits/vegetables (bananas, spinach) provide potassium and magnesium. Low-fat dairy (yogurt, skim milk) provides calcium. Whole grains (whole wheat, brown rice) and lean proteins (salmon, chicken) are core DASH components. Canned soups and deli meats are extremely high in sodium and must be avoided.","rationaleCorrectZh":"新鲜水果/蔬菜（香蕉、菠菜）提供钾和镁。低脂乳制品（酸奶、脱脂奶）提供钙。全谷物（全麦、糙米）和优质蛋白质（三文鱼、鸡肉）是DASH的核心成分。罐头汤和熟肉制品的钠含量极高，必须避免食用。","testTakingStrategyEn":"Select unprocessed, whole foods rich in key minerals and low in sodium. Avoid packaged, processed foods known for high sodium content.","testTakingStrategyZh":"选择富含关键矿物质且低钠的未加工天然食品。避免已知钠含量高的包装加工食品。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1044,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_hypertension_lifestyle_02","embeddedQuestionId":"gemini_gap_case_htn_lifestyle_02_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.800.caseStudy.questions.2","itemType":"dropdown_cloze","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.800.caseStudy.questions.2.stem.en","stemPathZh":"questions.800.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[66,162],"terminalOffsetsZh":[14,35],"fullStemEn":"The nurse discusses physical activity guidelines with the client. Select the appropriate options from the dropdown menus to complete the exercise recommendations.","fullStemZh":"护士与患者讨论体育活动指南。从下拉菜单中选择合适的选项以完成运动建议。","terminalSentenceEn":"Select the appropriate options from the dropdown menus to complete the exercise recommendations.","terminalSentenceZh":"从下拉菜单中选择合适的选项以完成运动建议。","penultimateSentenceEn":"The nurse discusses physical activity guidelines with the client.","penultimateSentenceZh":"护士与患者讨论体育活动指南。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"To lower blood pressure, the client should engage in at least {{1}} of moderate-intensity aerobic physical activity weekly, and should avoid {{2}}.","zh":"为了降低血压，患者每周应进行至少 {{1}} 的中等强度有氧运动，并应避免 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"150 minutes","zh":"150分钟"},{"id":"o2","en":"30 minutes","zh":"30分钟"},{"id":"o3","en":"600 minutes","zh":"600分钟"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"isotonic exercises like brisk walking","zh":"等张运动，如快步走"},{"id":"o1","en":"heavy straining or Valsalva-style lifting unless cleared by the provider","zh":"重度屏气或瓦氏呼吸式举重（除非经医生批准）"},{"id":"o3","en":"stretching and flexibility exercises","zh":"伸展和柔韧性运动"}],"correct":"o1"}]},"rationaleCorrectEn":"AHA guidelines recommend at least 150 minutes of moderate-intensity aerobic exercise (such as brisk walking) per week. Heavy straining or lifting against extreme resistance (especially involving the Valsalva maneuver, which causes breath-holding/straining) triggers sudden, dangerous spikes in blood pressure and should be avoided unless cleared by a provider. Isotonic aerobic walking and stretching are safe and encouraged.","rationaleCorrectZh":"AHA 指南建议每周至少进行 150 分钟的中等强度有氧运动（如快步走）。重度屏气或在极端阻力下举重（特别是涉及瓦萨瓦动作，会导致憋气/屏气）会引发血压突然且危险地剧烈上升，除非得到医生的批准，否则应予以避免。等张有氧步行和伸展运动是安全的，值得鼓励。","testTakingStrategyEn":"Recall cardiovascular exercise guidelines (150 min/week). Identify that heavy straining or breath-holding lifts cause a dangerous pressure response (Valsalva), making them unsafe without clearance compared to isotonic aerobic activities (walking).","testTakingStrategyZh":"回忆心血管运动指南（150分钟/周）。确定重度屏气或憋气举重会引起危险的压力反应（瓦氏动作），在未获得医生批准的情况下是不安全的，而等张有氧运动（步行）是安全的。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1045,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_hypertension_lifestyle_02","embeddedQuestionId":"gemini_gap_case_htn_lifestyle_02_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.800.caseStudy.questions.3","itemType":"matrix","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.800.caseStudy.questions.3.stem.en","stemPathZh":"questions.800.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[67,195],"terminalOffsetsZh":[17,53],"fullStemEn":"The nurse evaluates the clinical results at the 3-month follow-up. For each clinical outcome, click to specify if it indicates progress toward hypertension management goals or a lack of progress.","fullStemZh":"护士评估了3个月随访时的临床结果。对于每项临床结果，点击以指定它是表明高血压管理目标取得进展还是缺乏进展。","terminalSentenceEn":"For each clinical outcome, click to specify if it indicates progress toward hypertension management goals or a lack of progress.","terminalSentenceZh":"对于每项临床结果，点击以指定它是表明高血压管理目标取得进展还是缺乏进展。","penultimateSentenceEn":"The nurse evaluates the clinical results at the 3-month follow-up.","penultimateSentenceZh":"护士评估了3个月随访时的临床结果。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Blood pressure 128/82 mmHg (seated)","zh":"血压 128/82 mmHg（坐位）"},{"id":"r2","en":"Body weight decreased from 202 lbs to 194 lbs","zh":"体重从202磅减至194磅"},{"id":"r3","en":"Physical activity level remains at 1 day per week of walking","zh":"体育活动水平仍保持在每周步行1天"}],"columns":[{"id":"c2","en":"Lack of progress","zh":"缺乏进展"},{"id":"c1","en":"Progress toward goals","zh":"朝着目标取得进展"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]}]},"rationaleCorrectEn":"Blood pressure of 128/82 shows progress (approaching the <120/<80 normal target and significantly down from baseline). Weight loss of 8 lbs (about 4% of body weight) indicates progress in BMI reduction, which directly lowers BP. Physical activity of only 1 day per week represents a lack of progress, as the target is at least 150 minutes weekly spread over 3-5 days.","rationaleCorrectZh":"血压 128/82 mmHg 显示出进展（接近 <120/<80 的正常目标，且较基线显著下降）。体重减轻8磅（约占体重的4%）表明在降低 BMI 方面取得进展，这可直接降低血压。每周仅步行1天的体育活动代表缺乏进展，因为目标是每周至少 150 分钟，并分布在3-5天内进行。","testTakingStrategyEn":"Compare the 3-month follow-up data with clinical hypertension guidelines. Weight reduction and blood pressure decline represent positive outcomes, while low exercise frequency is an unmet goal.","testTakingStrategyZh":"将3个月的随访数据与高血压临床指南进行对比。体重减轻和血压下降代表积极结果，而低运动频率是未达到的目标。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1046,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_palliative_care_03","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.801","itemType":"case_study","category":"Basic Care and Comfort","topic":"Palliative & Supportive Care","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.801.stem.en","stemPathZh":"questions.801.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,185],"terminalOffsetsZh":[0,59],"fullStemEn":"Unfolding Case: Palliative Dyspnea Management in Hospice Care A 78-year-old male with end-stage heart failure is admitted to inpatient hospice care due to worsening dyspnea and fatigue.","fullStemZh":"展开式案例：安宁疗护中的缓和性呼吸困难管理 一名患有终末期心力衰竭的78岁男性因呼吸困难和疲劳加重收治入安宁疗护病房。","terminalSentenceEn":"Unfolding Case: Palliative Dyspnea Management in Hospice Care A 78-year-old male with end-stage heart failure is admitted to inpatient hospice care due to worsening dyspnea and fatigue.","terminalSentenceZh":"展开式案例：安宁疗护中的缓和性呼吸困难管理 一名患有终末期心力衰竭的78岁男性因呼吸困难和疲劳加重收治入安宁疗护病房。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This case study reviews basic comfort and palliative support, testing the role of low-dose morphine in air hunger, its central and systemic mechanism of action, cooling fan and positioning interventions, and clinical reassessment indicators of comfortable breathing.","rationaleCorrectZh":"该案例研究审查了基本舒适和缓和支持，测试了低剂量吗啡在气饥中的作用、其中枢和全身作用机制、冷却风扇和体位干预，以及舒适呼吸的临床重新评估指标。","testTakingStrategyEn":"Focus on palliative and comfort goals, avoiding aggressive ICU-level curative measures.","testTakingStrategyZh":"关注缓和和舒适目标，避免采取积极的ICU级别治愈性措施。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1047,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_palliative_care_03","embeddedQuestionId":"gemini_gap_case_palliative_care_03_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.801.caseStudy.questions.0","itemType":"multiple_choice","category":"Basic Care and Comfort","topic":"Palliative & Supportive Care","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.801.caseStudy.questions.0.stem.en","stemPathZh":"questions.801.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,130],"terminalOffsetsZh":[0,31],"fullStemEn":"Which medication should the nurse expect to administer as the priority pharmacologic intervention to relieve the client's dyspnea?","fullStemZh":"护士应预料到将哪种药物作为缓解患者呼吸困难的首选药物干预措施？","terminalSentenceEn":"Which medication should the nurse expect to administer as the priority pharmacologic intervention to relieve the client's dyspnea?","terminalSentenceZh":"护士应预料到将哪种药物作为缓解患者呼吸困难的首选药物干预措施？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Prescribed low-dose oral or sublingual liquid morphine","zh":"医嘱的低剂量口服或舌下含服吗啡液"},{"id":"B","en":"High-dose intravenous furosemide","zh":"大剂量静脉注射呋塞米"},{"id":"D","en":"Intravenous lorazepam bolus","zh":"静脉注射劳拉西泮"},{"id":"C","en":"Prescribed albuterol nebulizer therapy","zh":"医嘱的沙丁胺醇雾化吸入治疗"}],"correct":["A"]},"rationaleCorrectEn":"In palliative and hospice care, low-dose opioids (especially oral/sublingual liquid morphine) are the gold standard and priority drug for managing severe dyspnea ('air hunger'). Morphine reduces respiratory rate, decreases the perception of breathlessness, dilates pulmonary vessels, and reduces heart failure preload, without causing significant respiratory depression in these carefully titrated doses. While furosemide treats fluid overload, morphine directly targets the symptom of air hunger. Albuterol is for bronchospasm, not cardiac congestion. Lorazepam reduces anxiety but is secondary to morphine for dyspnea.","rationaleCorrectZh":"在姑息治疗和安宁疗护中，低剂量阿片类药物（尤其是口服/舌下吗啡液）是管理严重呼吸困难（“气饥”）的金标准和首选药物。吗啡可减慢呼吸频率，减轻呼吸困难的主观感受，扩张肺血管并降低心力衰竭前负荷，且在这些仔细调整的剂量下不会引起明显的呼吸抑制。虽然呋塞米可治疗液体超负荷，但吗啡直接针对气饥的症状。沙丁胺醇适用于支气管痉挛，而非心脏性淤血。劳拉西泮可减轻焦虑，但在缓解呼吸困难方面其次于吗啡。","testTakingStrategyEn":"Associate hospice dyspnea (air hunger) with low-dose morphine as the primary comfort intervention. Distinguish this symptomatic palliative practice from acute clinical curing strategies (high-dose diuretics).","testTakingStrategyZh":"将安宁疗护的呼吸困难（气饥）与低剂量吗啡联系起来作为首要舒适干预。将这种症状性缓和医疗实践与急性的临床治愈策略（大剂量利尿剂）区分开来。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1048,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_palliative_care_03","embeddedQuestionId":"gemini_gap_case_palliative_care_03_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.801.caseStudy.questions.1","itemType":"dropdown_cloze","category":"Basic Care and Comfort","topic":"Palliative & Supportive Care","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.801.caseStudy.questions.1.stem.en","stemPathZh":"questions.801.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[54,177],"terminalOffsetsZh":[13,45],"fullStemEn":"The nurse monitors the client's response to morphine. Select the appropriate options from the dropdown menus to complete the explanation of the drug's action in palliative care.","fullStemZh":"护士监测患者对吗啡的反应。从下拉菜单中选择合适的选项，以完成对吗啡在缓和医疗中作用的解释。","terminalSentenceEn":"Select the appropriate options from the dropdown menus to complete the explanation of the drug's action in palliative care.","terminalSentenceZh":"从下拉菜单中选择合适的选项，以完成对吗啡在缓和医疗中作用的解释。","penultimateSentenceEn":"The nurse monitors the client's response to morphine.","penultimateSentenceZh":"护士监测患者对吗啡的反应。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"In a hospice client with dyspnea, morphine relieves breathlessness by reducing the brain's sensitivity to {{1}} and by causing {{2}} to decrease cardiac workload.","zh":"在有呼吸困难的安宁疗护患者中，吗啡通过降低大脑对 {{1}} 的敏感性以及通过引起 {{2}} 来减轻心脏负荷，从而缓解呼吸困难。"},"dropdowns":[{"id":"1","options":[{"id":"o3","en":"bicarbonate levels","zh":"碳酸氢盐水平"},{"id":"o2","en":"decreased oxygen levels","zh":"氧气水平降低"},{"id":"o1","en":"elevated carbon dioxide levels","zh":"二氧化碳水平升高"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"peripheral vasoconstriction and arterial narrowing","zh":"外周血管收缩和动脉变窄"},{"id":"o1","en":"systemic vasodilation and pooling of blood","zh":"全身血管舒张和血液淤积"},{"id":"o3","en":"bronchial constriction","zh":"支气管收缩"}],"correct":"o1"}]},"rationaleCorrectEn":"In dyspnea, morphine blunts the respiratory center's response to hypercapnia (elevated carbon dioxide) and hypoxia, reducing the frantic drive to breathe. Hemodynamically, morphine causes systemic vasodilation (venodilation), which pools blood in the periphery, reducing venous return (preload) to the heart and easing pulmonary congestion. It does not cause vasoconstriction or bronchoconstriction.","rationaleCorrectZh":"在呼吸困难中，吗啡减弱了呼吸中枢对高碳酸血症（二氧化碳升高）和缺氧的反应，减少了惊慌的呼吸驱动。血流动力学上，吗啡引起全身血管舒张（静脉舒张），使血液淤积在外周，减少回心血量（前负荷）并缓解肺淤血。它不引起血管收缩或支气管收缩。","testTakingStrategyEn":"Recall the dual action of morphine in dyspnea: blunting hypercapnic chemoreceptor drive (central) and promoting venodilation to reduce venous return (hemodynamic).","testTakingStrategyZh":"记住吗啡在呼吸困难中的双重作用：减弱高碳酸血症化学感受器驱动（中枢）和促进静脉舒张以减少回心血量（血流动力学）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1049,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_palliative_care_03","embeddedQuestionId":"gemini_gap_case_palliative_care_03_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.801.caseStudy.questions.2","itemType":"matrix","category":"Basic Care and Comfort","topic":"Palliative & Supportive Care","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.801.caseStudy.questions.2.stem.en","stemPathZh":"questions.801.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[74,170],"terminalOffsetsZh":[17,46],"fullStemEn":"The nurse implements non-pharmacological comfort measures for the client. For each nursing action, click to specify if it is indicated or contraindicated for this client.","fullStemZh":"护士为患者实施非药物舒适护理措施。对于每项护理操作，点击以指定它是适用于该患者还是属于禁忌。","terminalSentenceEn":"For each nursing action, click to specify if it is indicated or contraindicated for this client.","terminalSentenceZh":"对于每项护理操作，点击以指定它是适用于该患者还是属于禁忌。","penultimateSentenceEn":"The nurse implements non-pharmacological comfort measures for the client.","penultimateSentenceZh":"护士为患者实施非药物舒适护理措施。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Position a fan to blow cool air directly across the client's face","zh":"将风扇对准患者面部轻轻吹冷风"},{"id":"r2","en":"Maintain the client in a flat supine position","zh":"保持患者处于平卧仰卧位"},{"id":"r3","en":"Apply low-flow oxygen via nasal cannula only if symptomatic and hypoxic","zh":"仅在有症状且缺氧时通过鼻导管给予低流量氧气"}],"columns":[{"id":"c2","en":"Contraindicated","zh":"禁用"},{"id":"c1","en":"Indicated","zh":"适用"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]}]},"rationaleCorrectEn":"Blowing cool air across the face stimulates the trigeminal nerve (V2/V3 branches), which centrally decreases the sensation of dyspnea; this is highly indicated. Flat supine positioning is contraindicated as it increases venous return, worsening pulmonary congestion and dyspnea. Oxygen therapy in palliative care is indicated for documented hypoxemia with symptomatic distress; if oxygen saturation is normal, air/fan therapy is just as effective and causes less mucosal drying.","rationaleCorrectZh":"将冷风吹拂面部可刺激三叉神经（V2/V3分支），从而在中枢减轻呼吸困难感；这非常适用。平卧位属于禁忌，因为它会增加回心血量，加重肺淤血和呼吸困难。缓和医疗中的氧气治疗适用于有临床表现且有记录的缺氧；如果氧饱和度正常，空气/风扇治疗同样有效，且引起黏膜干燥较少。","testTakingStrategyEn":"Understand hospice-specific comfort protocols. Support sensory triggers that reduce dyspnea (cool air fan) and elevation to ease breathing, while avoiding flat positioning.","testTakingStrategyZh":"理解安宁疗护特异性的舒适方案。支持减少呼吸困难的感觉触发因素（冷风扇）和抬高体位以促进呼吸，同时避免平卧位。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1050,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_palliative_care_03","embeddedQuestionId":"gemini_gap_case_palliative_care_03_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.801.caseStudy.questions.3","itemType":"select_all","category":"Basic Care and Comfort","topic":"Palliative & Supportive Care","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.801.caseStudy.questions.3.stem.en","stemPathZh":"questions.801.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[143,165],"terminalOffsetsZh":[39,47],"fullStemEn":"The nurse reassesses the client 4 hours later. Which findings indicate a successful therapeutic response to the palliative dyspnea management? Select all that apply.","fullStemZh":"护士在4小时后重新评估患者。哪些发现表明对缓和性呼吸困难管理有成功的治疗反应？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which findings indicate a successful therapeutic response to the palliative dyspnea management?","penultimateSentenceZh":"哪些发现表明对缓和性呼吸困难管理有成功的治疗反应？","responseContext":{"type":"select_all","options":[{"id":"E","en":"Oxygen saturation increased to 100% on high-flow face mask","zh":"使用高流量面罩时氧饱和度升至100%"},{"id":"D","en":"Absence of intercostal accessory muscle use","zh":"无肋间辅助肌使用"},{"id":"C","en":"Client statement that breathing feels much easier","zh":"患者主诉呼吸感觉轻松了许多"},{"id":"A","en":"Respiratory rate of 18 breaths/min, deep and regular","zh":"呼吸频率为 18 次/分，深而规律"},{"id":"B","en":"Relaxed facial expression and sleeping occasionally","zh":"表情放松，偶尔入睡"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"Signs of successful relief of dyspnea include normalization of respiratory rate (18/min), relaxed facial features (no grimacing or nasal flaring), occasional restful sleep, subjective reports of comfort, and resolved accessory muscle use. High-flow oxygen to achieve 100% saturation is not a goal in palliative end-stage heart failure; it is unnecessary, drying, invasive, and can cause discomfort.","rationaleCorrectZh":"成功缓解呼吸困难的体征包括呼吸频率恢复正常 (18次/分)、面部表情放松（无痛苦表情或鼻翼扇动）、偶尔安静入睡、主观舒适的主诉以及辅助肌使用消失。在缓和期终末期心力衰竭中，使用高流量氧气以达到100%的饱和度不是目标；这是不必要的、干燥的、有创的，并且可能引起不适。","testTakingStrategyEn":"Identify indicators of patient comfort and reduced breathing effort. Avoid interventions that focus on aggressive lab parameters (100% saturation) over comfort goals.","testTakingStrategyZh":"确定患者舒适和呼吸做功减少的指标。避免选择偏向于积极的实验室指标（100%饱和度）而不是舒适目标的干预措施。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1051,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_postpartum_depression_04","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.802","itemType":"case_study","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.802.stem.en","stemPathZh":"questions.802.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[170,216],"terminalOffsetsZh":[38,49],"fullStemEn":"Unfolding Case: 4-Week Postpartum Depression Screening A 28-year-old female is seen in the outpatient obstetric clinic for her routine 4-week postpartum follow-up visit. She is accompanied by her husband and newborn.","fullStemZh":"展开式案例：产后4周抑郁筛查 一名28岁女性在门诊产科接受常规产后4周随访。她由丈夫和新生儿陪同。","terminalSentenceEn":"She is accompanied by her husband and newborn.","terminalSentenceZh":"她由丈夫和新生儿陪同。","penultimateSentenceEn":"Unfolding Case: 4-Week Postpartum Depression Screening A 28-year-old female is seen in the outpatient obstetric clinic for her routine 4-week postpartum follow-up visit.","penultimateSentenceZh":"展开式案例：产后4周抑郁筛查 一名28岁女性在门诊产科接受常规产后4周随访。","responseContext":{},"rationaleCorrectEn":"This case study reviews postpartum depression screening, assessing key symptoms and EPDS score interpretation, prioritizing suicide safety risk assessment, distinguishing clinical depression from baby blues, and planning supportive psychosocial care.","rationaleCorrectZh":"该案例研究审查了产后抑郁症筛查，评估关键症状和 EPDS 评分解释、优先考虑自杀安全风险评估、区分临床抑郁症与产后忧郁，以及计划支持性心理社会照护。","testTakingStrategyEn":"Focus on therapeutic communication, suicide screening, and distinguishing postpartum mood disorders.","testTakingStrategyZh":"重点关注治疗性沟通、自杀筛查以及产后心境障碍的区分。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1052,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_postpartum_depression_04","embeddedQuestionId":"gemini_gap_case_postpartum_depression_04_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.802.caseStudy.questions.0","itemType":"select_all","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.802.caseStudy.questions.0.stem.en","stemPathZh":"questions.802.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[114,136],"terminalOffsetsZh":[26,34],"fullStemEn":"Which findings in the clinic record support the assessment that the client is experiencing postpartum depression? Select all that apply.","fullStemZh":"门诊记录中的哪些发现支持患者正在经历产后抑郁的评估？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which findings in the clinic record support the assessment that the client is experiencing postpartum depression?","penultimateSentenceZh":"门诊记录中的哪些发现支持患者正在经历产后抑郁的评估？","responseContext":{"type":"select_all","options":[{"id":"A","en":"EPDS score of 15","zh":"EPDS 评分为 15"},{"id":"E","en":"Mild fatigue resolving with a single night of sleep","zh":"通过一夜睡眠即可缓解的轻度疲劳"},{"id":"C","en":"Feelings of inadequacy and guilt about mothering abilities","zh":"对作母亲能力的无能感和内疚感"},{"id":"D","en":"Frequent tearfulness and social withdrawal","zh":"频繁流泪和社交退缩"},{"id":"B","en":"Difficulty sleeping even when the newborn is sleeping","zh":"即使新生儿入睡时也难以入睡"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"An EPDS score of 15 (exceeding the threshold of 10-13), sleep disturbance unrelated to the infant's schedule, feelings of worthlessness/guilt, persistent tearfulness, and social withdrawal are classic manifestations of postpartum depression. Mild, transient fatigue that resolves with rest is characteristic of normal postpartum fatigue, whereas the client's exhaustion is persistent and coupled with cognitive-affective depressive symptoms.","rationaleCorrectZh":"EPDS 评分为 15（超过 10-13 的阈值）、与婴儿作息无关的睡眠障碍、无价值感/内疚感、持续流泪和社交退缩是产后抑郁的典型表现。休息后可缓解的轻度、暂时性疲劳是正常产后疲劳的特征，而该患者的疲劳是持续存在的，并伴有认知-情感性抑郁症状。","testTakingStrategyEn":"Distinguish between expected transient postpartum fatigue ('baby blues') and clinical postpartum depression cues (high EPDS, persistent crying, guilt, inability to sleep when opportunity exists).","testTakingStrategyZh":"区分预期的暂时性产后疲劳（“产后忧郁”）和临床产后抑郁体征（高 EPDS、持续哭泣、内疚、有条件时仍无法入睡）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1053,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_postpartum_depression_04","embeddedQuestionId":"gemini_gap_case_postpartum_depression_04_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.802.caseStudy.questions.1","itemType":"multiple_choice","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.802.caseStudy.questions.1.stem.en","stemPathZh":"questions.802.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,101],"terminalOffsetsZh":[0,20],"fullStemEn":"Based on the nursing safety interview, which action is the priority for the nurse to implement first?","fullStemZh":"根据护理安全访谈，护士首要采取哪项行动？","terminalSentenceEn":"Based on the nursing safety interview, which action is the priority for the nurse to implement first?","terminalSentenceZh":"根据护理安全访谈，护士首要采取哪项行动？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"D","en":"Initiate an emergency involuntary psychiatric admission","zh":"启动紧急非自愿精神科入院程序"},{"id":"B","en":"Instruct the husband to take the baby home to prevent harm to the infant","zh":"指导丈夫带婴儿回家以防止对婴儿造成伤害"},{"id":"C","en":"Reassure the client that these feelings are normal and will pass in a few days","zh":"向患者保证这些感觉是正常的，过几天就会过去"},{"id":"A","en":"Perform a detailed safety assessment, directly asking the client about suicidal plans and intent","zh":"进行详细的安全评估，直接询问患者自杀计划和意图"}],"correct":["A"]},"rationaleCorrectEn":"The client's statement that her husband and baby 'would be better off without me' is a passive expression of suicidal ideation and hopelessness. The immediate priority is a thorough safety assessment, directly asking about suicidal thoughts, plans, and intent. Separating the baby is premature as she denied intent to harm the infant and did not show postpartum psychosis. Dismissing her feelings as normal is false reassurance and dangerous. Involuntary admission requires documented danger to self or others that cannot be managed voluntarily; assessment must precede this.","rationaleCorrectZh":"患者关于她的丈夫和孩子“没有我会过得更好”的言论是对自杀意念和绝望感的被动表达。当务之急是进行彻底的安全评估，直接询问自杀想法、计划和意图。将婴儿带走为时过早，因为她否认有伤害婴儿的意图，并且没有表现出产后精神病。将她的感受视为正常是不真实的保证，也是危险的。非自愿入院需要证实有无法通过自愿管理的方式来应对的自杀或伤人危险；评估必须在这一步之前进行。","testTakingStrategyEn":"Use clinical prioritization for safety. Passive expressions of death ('better off without me') require direct, active investigation of suicidal ideation and plans.","testTakingStrategyZh":"对安全性使用临床优先级判断。关于死亡的被动表达（“没有我会更好”）需要直接、积极地调查自杀意念和计划。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1054,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_postpartum_depression_04","embeddedQuestionId":"gemini_gap_case_postpartum_depression_04_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.802.caseStudy.questions.2","itemType":"dropdown_cloze","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.802.caseStudy.questions.2.stem.en","stemPathZh":"questions.802.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[95,177],"terminalOffsetsZh":[24,43],"fullStemEn":"The nurse compares transient postpartum emotional changes with clinical postpartum depression. Select the appropriate options from the dropdown menus to complete the comparison.","fullStemZh":"护士对暂时性产后情绪变化与临床产后抑郁进行对比。从下拉菜单中选择合适的选项以完成对比。","terminalSentenceEn":"Select the appropriate options from the dropdown menus to complete the comparison.","terminalSentenceZh":"从下拉菜单中选择合适的选项以完成对比。","penultimateSentenceEn":"The nurse compares transient postpartum emotional changes with clinical postpartum depression.","penultimateSentenceZh":"护士对暂时性产后情绪变化与临床产后抑郁进行对比。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse should recognize that postpartum 'baby blues' typically onset within a few days of birth, are mild, and resolve within {{1}}, whereas postpartum depression is persistent, severe, and requires {{2}}.","zh":"护士应认识到，产后“忧郁”通常在分娩后几天内出现，症状轻微，并在 {{1}} 内消退，而产后抑郁是持续的、严重的，并且需要 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o2","en":"6 to 12 months","zh":"6至12个月"},{"id":"o1","en":"10 to 14 days","zh":"10至14天"},{"id":"o3","en":"2 to 3 days","zh":"2至3天"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"medical evaluation, psychotherapy, and pharmacotherapy","zh":"医疗评估、心理治疗和药物治疗"},{"id":"o2","en":"supportive home monitoring and rest alone","zh":"仅进行支持性家庭监测和休息"},{"id":"o3","en":"immediate shock therapy (ECT) and isolation","zh":"立即进行电抽搐治疗（ECT）和隔离"}],"correct":"o1"}]},"rationaleCorrectEn":"Postpartum 'baby blues' affect up to 80% of new mothers, peak around day 5, and resolve spontaneously within 10-14 days. Postpartum depression (PPD) is a clinical depressive disorder that affects 10-15% of mothers, lasts beyond 2 weeks, and requires medical assessment, counseling/psychotherapy, and often antidepressants. Rest alone is insufficient for PPD. ECT is reserved for refractory, psychotic cases, not first-line therapy.","rationaleCorrectZh":"产后“忧郁”影响高达80%的新手妈妈，在第5天左右达到高峰，并在10-14天内自行消退。产后抑郁症 (PPD) 是一种临床抑郁障碍，影响10-15%的母亲，持续时间超过2周，需要医疗评估、咨询/心理治疗，通常还需要抗抑郁药。仅靠休息对PPD是不够的。ECT预留用于难治性、精神病性病例，不是一线治疗。","testTakingStrategyEn":"Identify duration and severity differences in postpartum mood disorders. 'Baby blues' is short-lived (<2 weeks) and self-limiting; postpartum depression is chronic and requires professional intervention.","testTakingStrategyZh":"确定产后心境障碍的持续时间和严重程度差异。“产后忧郁”是短暂的（<2周）且属自限性；产后抑郁是慢性的，需要专业干预。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1055,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_postpartum_depression_04","embeddedQuestionId":"gemini_gap_case_postpartum_depression_04_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.802.caseStudy.questions.3","itemType":"matrix","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.802.caseStudy.questions.3.stem.en","stemPathZh":"questions.802.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[67,178],"terminalOffsetsZh":[16,48],"fullStemEn":"The nurse discusses care planning with the client and her husband. For each intervention, click to specify if it is indicated or contraindicated to support the client's recovery.","fullStemZh":"护士与患者及其丈夫讨论护理计划。对于每项干预措施，点击以指定它是适用于支持患者康复还是属于禁忌。","terminalSentenceEn":"For each intervention, click to specify if it is indicated or contraindicated to support the client's recovery.","terminalSentenceZh":"对于每项干预措施，点击以指定它是适用于支持患者康复还是属于禁忌。","penultimateSentenceEn":"The nurse discusses care planning with the client and her husband.","penultimateSentenceZh":"护士与患者及其丈夫讨论护理计划。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Validate the client's feelings and reassure her that postpartum depression is a treatable medical condition, not a personal failure","zh":"接纳患者的感受，并向她保证产后抑郁症是一种可治疗的医疗状况，而不是个人的失败"},{"id":"r2","en":"Coordinate a support network of family and friends to assist with infant care and household tasks","zh":"协调家人和朋友的支持网络以协助婴儿护理和家务活"},{"id":"r3","en":"Advise the client to avoid talking about her negative thoughts to prevent worsening her mood","zh":"建议患者避免谈论她的消极想法，以防心情变差"}],"columns":[{"id":"c1","en":"Indicated","zh":"适用"},{"id":"c2","en":"Contraindicated","zh":"禁用"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]}]},"rationaleCorrectEn":"Validating the mother's feelings (r1) reduces guilt and promotes treatment adherence. Coordinating support (r2) ensures safety, reduces exhaustion, and provides rest. Advising the client to avoid talking about negative thoughts (r3) is contraindicated; expressing feelings is therapeutic, while suppression increases isolation and prevents safety monitoring.","rationaleCorrectZh":"认可母亲的感受 (r1) 可减少内疚感并促进治疗依从性。协调支持 (r2) 可确保安全、减轻疲劳并提供休息。建议患者避免谈论消极想法 (r3) 是禁忌的；表达感受具有治疗作用，而压抑则会增加孤立感并防碍安全监测。","testTakingStrategyEn":"Apply therapeutic communication and support planning concepts. Encourage open emotional expression and support mobilization, while rejecting avoidance of discussing feelings.","testTakingStrategyZh":"应用治疗性沟通和支持计划概念。鼓励公开表达情感和动员支持，同时拒绝避免讨论感受的操作。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1056,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_disaster_triage_05","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.803","itemType":"case_study","category":"Safety and Infection Prevention and Control","topic":"Disaster & Emergency Preparedness","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.803.stem.en","stemPathZh":"questions.803.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[131,249],"terminalOffsetsZh":[44,87],"fullStemEn":"Unfolding Case: Mass Casualty Disaster Triage A multi-vehicle collision involving a passenger bus has occurred on a local highway. A nurse arrives at the scene to assist as a triage officer using the START (Simple Triage and Rapid Treatment) method.","fullStemZh":"展开式案例：大规模伤亡灾害分诊 当地高速公路上发生了一起涉及一辆客运巴士的多车相撞事故。一名护士到达现场，协助作为分诊人员使用 START（简单分诊和快速治疗）方法进行分诊。","terminalSentenceEn":"A nurse arrives at the scene to assist as a triage officer using the START (Simple Triage and Rapid Treatment) method.","terminalSentenceZh":"一名护士到达现场，协助作为分诊人员使用 START（简单分诊和快速治疗）方法进行分诊。","penultimateSentenceEn":"Unfolding Case: Mass Casualty Disaster Triage A multi-vehicle collision involving a passenger bus has occurred on a local highway.","penultimateSentenceZh":"展开式案例：大规模伤亡灾害分诊 当地高速公路上发生了一起涉及一辆客运巴士的多车相撞事故。","responseContext":{},"rationaleCorrectEn":"This case study reviews disaster and emergency preparedness, testing the application of START triage physiological criteria, assigning triage color tags based on RR, perfusion, and commands, and identifying core mass-casualty triage principles.","rationaleCorrectZh":"该案例研究审查了灾害和应急准备，测试了 START 分诊生理标准的应用、根据呼吸频率、灌注和指令分配分诊颜色标签，以及确定核心的大规模伤亡分诊原则。","testTakingStrategyEn":"Focus on START triage categories (RPM), rapid assessment rules, and minimizing on-scene treatment.","testTakingStrategyZh":"重点关注 START 分诊类别 (RPM)、快速评估规则以及最大程度减少现场治疗。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1057,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_disaster_triage_05","embeddedQuestionId":"gemini_gap_case_disaster_triage_05_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.803.caseStudy.questions.0","itemType":"multiple_choice","category":"Safety and Infection Prevention and Control","topic":"Disaster & Emergency Preparedness","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.803.caseStudy.questions.0.stem.en","stemPathZh":"questions.803.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,117],"terminalOffsetsZh":[0,40],"fullStemEn":"According to the START triage algorithm, which finding is assessed first and assigns Victim D an immediate (RED) tag?","fullStemZh":"根据 START 分诊算法，哪项发现最先被评估并使伤员D被分配紧急（红色）标签？","terminalSentenceEn":"According to the START triage algorithm, which finding is assessed first and assigns Victim D an immediate (RED) tag?","terminalSentenceZh":"根据 START 分诊算法，哪项发现最先被评估并使伤员D被分配紧急（红色）标签？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Respiratory rate of 34 breaths/min","zh":"呼吸频率为 34次/分"},{"id":"B","en":"Radial pulse present","zh":"桡动脉搏动存在"},{"id":"C","en":"Severe head injury","zh":"严重的头部外伤"},{"id":"D","en":"Inability to follow simple commands","zh":"无法听从简单指令"}],"correct":["A"]},"rationaleCorrectEn":"Using the START triage method, a respiratory rate of >30 breaths/min is a primary indicator for a RED (Immediate) tag. If the breathing rate is >30 breaths/min, the assessment stops and the victim is tagged RED immediately. An inability to follow commands (altered mental status) also flags a RED tag, but the breathing rate is assessed first in the START algorithm and independently dictates the RED tag. Pulse present is not a red indicator (absent radial pulse is). The severity of the head injury is an anatomical description, but triage is based on physiological parameters (RPM: Respiration, Perfusion, Mental status).","rationaleCorrectZh":"使用 START 分诊方法，呼吸频率 >30次/分是红色（立即治疗）标签的首要指标。如果呼吸频率 >30次/分，则评估停止并立即将伤员标记为红色。无法听从指令（意识状态改变）也指示红色标签，但在 START 算法中首先评估呼吸频率，并独立决定了红色标签。桡动脉搏动存在不是红色指标（搏动消失才是）。头部伤势严重是一项解剖学描述，但分诊基于生理参数（RPM：呼吸、灌注、精神状态）。","testTakingStrategyEn":"Remember the START algorithm hierarchy: Respiration first, then Perfusion, then Mental status (RPM). If RR > 30, the client is Red immediately.","testTakingStrategyZh":"记住 START 算法的等级：首先是呼吸，然后是灌注，然后是精神状态 (RPM)。如果呼吸频率 > 30，该伤员立即被标为红色。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1058,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_disaster_triage_05","embeddedQuestionId":"gemini_gap_case_disaster_triage_05_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.803.caseStudy.questions.1","itemType":"dropdown_cloze","category":"Safety and Infection Prevention and Control","topic":"Disaster & Emergency Preparedness","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.803.caseStudy.questions.1.stem.en","stemPathZh":"questions.803.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[65,159],"terminalOffsetsZh":[21,42],"fullStemEn":"The nurse assigns START triage tags to the victims on the scene. Select the appropriate options from the dropdown menus to complete the triage classifications.","fullStemZh":"护士对现场伤员进行 START 分诊标记。从下拉菜单中选择合适的选项以完成分诊分类。","terminalSentenceEn":"Select the appropriate options from the dropdown menus to complete the triage classifications.","terminalSentenceZh":"从下拉菜单中选择合适的选项以完成分诊分类。","penultimateSentenceEn":"The nurse assigns START triage tags to the victims on the scene.","penultimateSentenceZh":"护士对现场伤员进行 START 分诊标记。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse should tag Victim A as {{1}} because he has no breathing after airway opening, and should tag Victim C as {{2}}.","zh":"护士应将伤员A标记为 {{1}}，因为他在气道打开后仍无呼吸，而应将伤员C标记为 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o2","en":"RED (Immediate)","zh":"红色（立即治疗）"},{"id":"o1","en":"BLACK (Expectant / Deceased)","zh":"黑色（濒死/已死亡）"},{"id":"o3","en":"YELLOW (Delayed)","zh":"黄色（延迟治疗）"}],"correct":"o1"},{"id":"2","options":[{"id":"o3","en":"RED (Immediate)","zh":"红色（立即治疗）"},{"id":"o2","en":"YELLOW (Delayed)","zh":"黄色（延迟治疗）"},{"id":"o1","en":"GREEN (Minor / Walking wounded)","zh":"绿色（轻伤/可行走的伤员）"}],"correct":"o1"}]},"rationaleCorrectEn":"Victim A is apneic even after repositioning the airway, which indicates he is deceased or expectant, requiring a BLACK tag in mass casualty situations to preserve resources for viable clients. Victim C is a 'walking wounded' client who can walk and follow commands, which defines a GREEN (Minor) tag. Minor victims are triaged as Green and directed to a designated safe area.","rationaleCorrectZh":"伤员A即使在重新调整气道后仍无呼吸，这表明他已死亡或濒死，在大量伤亡情况下需要使用黑色标签，以留出资源给有生存希望的患者。伤员C是一名“可行走的伤员”，能够行走和听从指令，这符合绿色（轻伤）标签。轻度受害者被分诊为绿色并引导到指定的安全区域。","testTakingStrategyEn":"Apply the START sorting rules: walking wounded = Green; non-breathing after opening airway = Black.","testTakingStrategyZh":"应用 START 分类规则：行走伤员 = 绿色；打开气道后无呼吸 = 黑色。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1059,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_disaster_triage_05","embeddedQuestionId":"gemini_gap_case_disaster_triage_05_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.803.caseStudy.questions.2","itemType":"matrix","category":"Safety and Infection Prevention and Control","topic":"Disaster & Emergency Preparedness","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.803.caseStudy.questions.2.stem.en","stemPathZh":"questions.803.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[78,170],"terminalOffsetsZh":[18,49],"fullStemEn":"The nurse classifies the remaining victims based on physiological parameters. For each victim, click to specify the correct triage category according to the START method.","fullStemZh":"护士根据生理参数对剩余伤员进行分类。对于每个伤员，点击以指定符合 START 方法的正确分诊类别。","terminalSentenceEn":"For each victim, click to specify the correct triage category according to the START method.","terminalSentenceZh":"对于每个伤员，点击以指定符合 START 方法的正确分诊类别。","penultimateSentenceEn":"The nurse classifies the remaining victims based on physiological parameters.","penultimateSentenceZh":"护士根据生理参数对剩余伤员进行分类。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Victim B (femur fracture, severe bleeding, RR 24, HR 110, follows commands)","zh":"伤员B（股骨骨折、严重出血、呼吸24次/分、心率110次/分、能听从指令）"},{"id":"r2","en":"Victim D (head injury, conscious, RR 34, rapid pulse, does not follow commands)","zh":"伤员D（脑外伤、有意识、呼吸34次/分、脉搏快、不能听从指令）"}],"columns":[{"id":"c1","en":"RED (Immediate)","zh":"红色（立即治疗）"},{"id":"c2","en":"YELLOW (Delayed)","zh":"黄色（延迟治疗）"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c2"]},{"rowId":"r2","columnIds":["c1"]}]},"rationaleCorrectEn":"Victim B has serious injuries (femur fracture, severe bleeding) but is physiologically stable: RR is <30/min, radial pulse is present, and she follows commands (mental status is intact). Therefore, she is tagged YELLOW (Delayed). While bleeding requires a tourniquet or pressure, she does not meet Red physiological criteria. Victim D has RR of 34 (exceeding 30) and cannot follow commands (altered mental status), meeting multiple RED (Immediate) criteria.","rationaleCorrectZh":"伤员B伤势严重（股骨骨折、严重出血），但生理指标稳定：呼吸频率 <30次/分、存在桡动脉搏动，且能听从指令（精神状态完整）。因此，她被贴上黄色（延迟）标签。虽然出血需要使用止血带或加压止血，但她不符合红色的生理标准。伤员D的呼吸频率为34（超过30次/分）且不能听从指令（意识状态改变），符合多项红色（立即治疗）标准。","testTakingStrategyEn":"Apply START criteria. Yellow means serious injuries but hemodynamically and neurologically stable (RR <30, pulse present, follows commands). Red means failure in one of these categories (RR >30, absent radial pulse, or unable to follow commands).","testTakingStrategyZh":"应用 START 标准。黄色意味着伤势严重但血流动力学和神经系统稳定（呼吸 <30、脉搏存在、能听从指令）。红色意味着其中一个类别出现异常（呼吸 >30、桡动脉搏动消失或无法听从指令）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1060,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_disaster_triage_05","embeddedQuestionId":"gemini_gap_case_disaster_triage_05_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.803.caseStudy.questions.3","itemType":"select_all","category":"Safety and Infection Prevention and Control","topic":"Disaster & Emergency Preparedness","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.803.caseStudy.questions.3.stem.en","stemPathZh":"questions.803.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[115,137],"terminalOffsetsZh":[33,41],"fullStemEn":"The nurse is training other staff on mass casualty triage principles. Which guidelines should the nurse emphasize? Select all that apply.","fullStemZh":"护士正在培训其他员工关于大规模伤亡分诊的原则。护士应强调哪些指南？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which guidelines should the nurse emphasize?","penultimateSentenceZh":"护士应强调哪些指南？","responseContext":{"type":"select_all","options":[{"id":"E","en":"Ensure Green (minor) victims are directed to walk to a designated treatment area to clear the immediate scene.","zh":"确保绿色（轻伤）伤员被引导走到指定治疗区域，以清理现场。"},{"id":"B","en":"Spend no more than 1 minute assessing each victim to facilitate rapid sorting.","zh":"评估每个伤员的时间不超过1分钟，以促进快速分类。"},{"id":"C","en":"Triage decisions are based on physiological parameters (RPM) rather than specific anatomical injuries.","zh":"分诊决策基于生理参数 (RPM) 而非具体的解剖学损伤。"},{"id":"A","en":"Perform only immediate life-saving interventions (such as opening airway and controlling hemorrhage) during triage.","zh":"在分诊期间仅执行紧急挽救生命的干预措施（如打开气道和控制出血）。"},{"id":"D","en":"Spend as much time as needed to fully clean and suture minor wounds on the field.","zh":"在现场花费足够的时间彻底清洗和缝合轻微伤口。"}],"correct":["A","B","C","E"]},"rationaleCorrectEn":"During a mass casualty incident, the goal is to do the greatest good for the greatest number. Interventions are limited to opening the airway and applying direct pressure/tourniquets to control life-threatening hemorrhage. Assessment must be rapid (<1 min per client). Sorting is based on RPM (Respiration, Perfusion, Mental status) physiological criteria. Green clients are directed to walk away, which clears the area for immediate focus on red and yellow clients. Suture work and detailed wound care are contraindicated on-scene during triage.","rationaleCorrectZh":"在大规模伤亡事件期间，目标是为最多的人谋求最大的利益。干预措施仅限于打开气道和使用直接压迫/止血带来控制危及生命的出血。评估必须迅速（每个患者 <1分钟）。分类基于 RPM（呼吸、灌注、精神状态）生理标准。绿色伤员被引导走开，这可以清理该区域，以便立即关注红色和黄色伤员。分诊期间禁止在现场进行缝合和详细的伤口护理。","testTakingStrategyEn":"Apply the principles of disaster medicine: preserve resources, maximize lives saved, limit treatment to immediate airway/hemorrhage control, and perform rapid screening (<60s per client).","testTakingStrategyZh":"应用灾害医学原则：保留资源、最大程度挽救生命、限制治疗至立即进行的气道/出血控制，并进行快速筛查（每位患者 <60秒）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1061,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_bt_delegation_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.804","itemType":"bowtie","category":"Management of Care","topic":"Prioritization & Delegation","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.804.stem.en","stemPathZh":"questions.804.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[208,252],"terminalOffsetsZh":[70,82],"fullStemEn":"The registered nurse (RN) is planning the daily shift assignments for a medical-surgical unit. The care team includes one RN, one Licensed Practical Nurse (LPN), and one Unlicensed Assistive Personnel (UAP). The nurse is delegating tasks for the shift.","fullStemZh":"注册护士 (RN) 正在制定内外科病房的每日班次分配。护理团队包括一名 RN、一名执业助理护士 (LPN) 和一名无证辅助人员 (UAP)。护士正在分配本班的任务。","terminalSentenceEn":"The nurse is delegating tasks for the shift.","terminalSentenceZh":"护士正在分配本班的任务。","penultimateSentenceEn":"The care team includes one RN, one Licensed Practical Nurse (LPN), and one Unlicensed Assistive Personnel (UAP).","penultimateSentenceZh":"护理团队包括一名 RN、一名执业助理护士 (LPN) 和一名无证辅助人员 (UAP)。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Most likely assignment priority","zh":"最可能的分配优先级"},"tokens":[{"id":"c1","en":"Appropriate delegation of care","zh":"适当的照护分配"},{"id":"c3","en":"Overdelegation of nursing process","zh":"过度分配护理程序"},{"id":"c2","en":"Unsafe delegation of assessment","zh":"不安全的评估分配"}],"correct":"c1"},"actions":{"prompt":{"en":"Actions to delegate","zh":"应分配的措施"},"tokens":[{"id":"a4","en":"Delegate evaluating the client's response to pain teaching to the UAP","zh":"分配 UAP 评估患者对疼痛指导的反应"},{"id":"a2","en":"Delegate administering scheduled oral medications to the LPN","zh":"分配 LPN 给予计划的口服药物"},{"id":"a1","en":"Delegate obtaining scheduled blood glucose measurements to the UAP","zh":"分配 UAP 获取计划的血糖测量值"},{"id":"a3","en":"Delegate performing an initial admission assessment to the LPN","zh":"分配 LPN 执行首次入院评估"}],"correct":["a1","a2"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"应监测的指标"},"tokens":[{"id":"p1","en":"Clinical stability of the assigned clients","zh":"所分配患者的临床稳定性"},{"id":"p4","en":"Hospital financial performance and billing codes","zh":"医院财务业绩和计费代码"},{"id":"p2","en":"Scope of practice and competency of each team member","zh":"每位团队成员的执业范围和能力"},{"id":"p3","en":"Personal preferences of the team members","zh":"团队成员的个人偏好"}],"correct":["p1","p2"]}}},"rationaleCorrectEn":"Appropriate delegation of care requires matching the task with the right person based on their legal scope of practice and clinical competency. UAPs can perform standardized, non-invasive tasks like obtaining fingerstick blood glucose measurements. LPNs can administer scheduled oral and subcutaneous medications. However, LPNs and UAPs cannot perform initial assessments, clinical evaluations, or patient teaching, which are exclusive RN responsibilities (EAT: Evaluate, Assess, Teach). Key parameters to monitor include client clinical stability (only stable, predictable clients should be delegated to LPNs/UAPs) and the team members' scopes/competencies. Personal preference and billing codes are not clinical safety parameters.","rationaleCorrectZh":"适当的照护分配需要根据法律执业范围和临床能力将任务与合适的人员相匹配。UAP 可以执行标准化、无创任务，例如获取指尖血血糖测量值。LPN 可以给予计划的口服和皮下注射药物。然而，LPN 和 UAP 不能执行首次评估、临床评估或患者教学，这些是 RN 的专属职责（EAT：评估、估量、教学）。要监测的关键参数包括患者的临床稳定性（只有稳定、可预测的患者才能分配给 LPN/UAP）以及团队成员的执业范围/能力。个人偏好和计费代码不是临床安全参数。","testTakingStrategyEn":"Remember the delegation mnemonic 'TAPE' (Teaching, Assessment, Planning, Evaluation cannot be delegated). Match standard tasks to UAPs and oral medications to LPNs, while monitoring stability and legal scopes.","testTakingStrategyZh":"记住分配助记词“TAPE”（教学、评估、计划、评价不能被分配）。将标准任务与 UAP 相匹配，将口服药物与 LPN 相匹配，同时监测稳定性和法律范围。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"The care team includes one RN, one Licensed Practical Nurse (LPN), and one Unlicensed Assistive Personnel (UAP).","controlSentenceZh":"护理团队包括一名 RN、一名执业助理护士 (LPN) 和一名无证辅助人员 (UAP)。"}
{"queueIndex":1062,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_hl_advocacy_02","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.805","itemType":"highlight","category":"Management of Care","topic":"Client Advocacy","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.805.stem.en","stemPathZh":"questions.805.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,78],"terminalOffsetsZh":[0,16],"fullStemEn":"Highlight the actions by the nurse that represent appropriate client advocacy.","fullStemZh":"标出护士代表合适患者代言的行动。","terminalSentenceEn":"Highlight the actions by the nurse that represent appropriate client advocacy.","terminalSentenceZh":"标出护士代表合适患者代言的行动。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"Nursing Progress Note: The client is scheduled for a diagnostic cardiac catheterization in two hours. The nurse performs an assessment.","zh":"护理病程记录：患者定于两小时后进行诊断性心脏导管插入术。护士进行评估。"},{"id":"s2","en":"The client states he does not understand the risks of the procedure but is ready to sign the form anyway, and the nurse witnesses his signature.","zh":"患者表示他不了解该操作的风险，但仍准备签字，护士见证了他的签字。","selectable":true},{"id":"s3","en":"The nurse holds the consent form and contacts the healthcare provider to explain the risks to the client.","zh":"护士留置同意书并联系医疗服务提供者向患者解释风险。","selectable":true},{"id":"s4","en":"The nurse documents the client's questions and the notification of the provider in the medical record.","zh":"护士在医疗记录中记录患者的问题以及通知医生的事情。","selectable":true},{"id":"s5","en":"The nurse explains the detailed surgical complications of the procedure to the client to save time.","zh":"护士向患者详细解释了该手术的并发症以节省时间。","selectable":true},{"id":"s6","en":"The nurse verifies the client's understanding before allowing the client to sign the consent form once the provider returns.","zh":"一旦医生返回，护士在允许患者签署同意书之前核实患者的理解。","selectable":true}],"correct":["s3","s4","s6"]}},"rationaleCorrectEn":"Appropriate client advocacy regarding informed consent requires ensuring the client has a full understanding of the procedure before signing. If the client expresses lack of understanding, the nurse must withhold the form and contact the provider (who has the legal responsibility to explain the procedure). The nurse must document the client's questions and provider notification, and verify the client's understanding before witnessing the signature. Witnessing the signature of a client who openly admits lack of understanding is a violation of advocacy. Explaining detailed surgical complications is outside the nurse's legal scope (the provider must do it).","rationaleCorrectZh":"在知情同意方面，合适的患者代言要求确保患者在签字前对操作有充分的了解。如果患者表示不理解，护士必须扣留同意书并联系医生（医生有法律责任解释操作）。护士必须记录患者的问题和通知医生的事情，并在见证签字前核实患者的理解。在患者公开承认不理解的情况下见证签字违反了代言原则。详细解释手术并发症超出了护士的法律执业范围（必须由医生来做）。","testTakingStrategyEn":"Recall the legal boundaries of informed consent. The nurse's role is to witness the signature and advocate for client understanding. The provider must explain the procedure. Never allow a client who expresses confusion to sign.","testTakingStrategyZh":"回忆知情同意的法律界限。护士的角色是见证签字并支持患者的理解。医生必须解释操作。绝不允许表示困惑的患者签字。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1063,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_hl_hipaa_03","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.806","itemType":"highlight","category":"Management of Care","topic":"Confidentiality & HIPAA","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.806.stem.en","stemPathZh":"questions.806.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,92],"terminalOffsetsZh":[0,25],"fullStemEn":"Highlight the actions by the nurse that violate client confidentiality or HIPAA regulations.","fullStemZh":"标出护士违反患者机密性或 HIPAA 法规的行动。","terminalSentenceEn":"Highlight the actions by the nurse that violate client confidentiality or HIPAA regulations.","terminalSentenceZh":"标出护士违反患者机密性或 HIPAA 法规的行动。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"Nursing Log: During a busy day-shift on a telemetry unit, the nurse implements several activities:","zh":"护理记录：在心电监护病房繁忙的白班期间，护士执行了以下活动："},{"id":"s2","en":"Discusses a client's psychiatric history with a colleague in the public staff elevator.","zh":"在公共员工电梯里与同事讨论患者的精神病史。","selectable":true},{"id":"s3","en":"Logs off from the computer electronic health record terminal before walking into a client's room.","zh":"在走进患者病房前退出电子健康记录电脑终端。","selectable":true},{"id":"s4","en":"Disposes of a paper client medication list in the regular trash can next to the nurses' station.","zh":"将一张纸质患者药物清单扔进护士站旁边的普通垃圾桶里。","selectable":true},{"id":"s5","en":"Shares a client's diagnostic results with a telephone caller who claims to be the client's cousin, without verifying client permission.","zh":"在未核实患者许可的情况下，与自称是患者表亲的电话来电者分享患者的诊断结果。","selectable":true},{"id":"s6","en":"Accesses the electronic record of a client assigned to the nurse's care team to check laboratory values.","zh":"访问分配给该护士护理团队的患者的电子记录以查看实验室值。","selectable":true}],"correct":["s2","s4","s5"]}},"rationaleCorrectEn":"Discussing patient history in a public elevator (s2) is a HIPAA violation due to the risk of public eavesdropping. Disposing of papers containing Protected Health Information (PHI) in a regular trash can (s4) violates security rules; PHI must be shredded or disposed of in locked shred bins. Sharing patient results with an unverified caller without explicit client permission (s5) is a direct confidentiality breach. Logging off terminals (s3) and accessing records of assigned patients (s6) are compliant, correct actions.","rationaleCorrectZh":"在公共电梯中讨论患者病史 (s2) 违反了 HIPAA，因为存在公共窃听的风险。将包含受保护健康信息 (PHI) 的纸张丢弃在普通垃圾桶中 (s4) 违反了安全规则；PHI 必须粉碎或弃置于锁定的粉碎箱中。在没有患者明确许可的情况下与未核实的来电者分享患者结果 (s5) 是直接的泄密行为。退出终端 (s3) 和访问分配患者的记录 (s6) 是合规、正确的行动。","testTakingStrategyEn":"Identify actions that expose Protected Health Information (PHI) to unauthorized persons or public view. Choose discussions in public spaces, improper paper disposal, and sharing info without consent.","testTakingStrategyZh":"识别将受保护健康信息 (PHI) 暴露给未经授权人员或公众视线的行动。选择在公共空间讨论、纸张处置不当以及未经同意共享信息。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1064,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_bt_discharge_04","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.807","itemType":"bowtie","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.807.stem.en","stemPathZh":"questions.807.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[195,244],"terminalOffsetsZh":[48,59],"fullStemEn":"An 82-year-old female living alone is ready for discharge following recovery from a hip fracture. She has new prescriptions for oral anticoagulants and requires assistive devices for ambulation. The nurse is planning the discharge coordination.","fullStemZh":"一名独自居住的82岁女性在股骨折康复后准备出院。她有新开的口服抗凝剂处方，且需要辅助设备来行走。护士正在规划出院协调。","terminalSentenceEn":"The nurse is planning the discharge coordination.","terminalSentenceZh":"护士正在规划出院协调。","penultimateSentenceEn":"She has new prescriptions for oral anticoagulants and requires assistive devices for ambulation.","penultimateSentenceZh":"她有新开的口服抗凝剂处方，且需要辅助设备来行走。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Most likely discharge action","zh":"最合适的出院行动"},"tokens":[{"id":"c2","en":"Immediate nursing home placement","zh":"立即入住养老院"},{"id":"c1","en":"Interdisciplinary discharge coordination","zh":"跨学科出院协调"},{"id":"c3","en":"Refusal of discharge on safety grounds","zh":"以安全为由拒绝出院"}],"correct":"c1"},"actions":{"prompt":{"en":"Actions to take","zh":"应采取的措施"},"tokens":[{"id":"a1","en":"Coordinate a home health safety assessment","zh":"协调家庭健康安全评估"},{"id":"a3","en":"Instruct the client to resume all pre-injury activities immediately","zh":"指导患者立即恢复所有伤前活动"},{"id":"a4","en":"Discontinue the use of all mobility assistive devices","zh":"停止使用所有活动辅助设备"},{"id":"a2","en":"Arrange a medication reconciliation and teaching session","zh":"安排药物重整和指导课"}],"correct":["a1","a2"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"应监测的指标"},"tokens":[{"id":"p1","en":"Client's mobility and safety in the home environment","zh":"患者在家庭环境中的活动能力和安全性"},{"id":"p3","en":"The client's financial bank statements","zh":"患者的银行财务账单"},{"id":"p4","en":"The number of visitors the client receives daily","zh":"患者每日接纳的访客人数"},{"id":"p2","en":"Adherence and understanding of anticoagulant therapy","zh":"抗凝治疗的依从性和理解程度"}],"correct":["p1","p2"]}}},"rationaleCorrectEn":"Discharge planning for an elderly client living alone after a hip fracture requires interdisciplinary coordination. Key actions include coordinating home health care for safety assessments and arranging medication reconciliation and teaching for the new oral anticoagulant (high-risk medication). Critical parameters to monitor are home safety/mobility and adherence to the anticoagulant regimen to prevent hemorrhage or thromboembolism. Forcing nursing home placement is inappropriate if home support is viable. Resuming all activities immediately and stopping assistive devices are unsafe. Financial statements and visitors are not nursing clinical parameters.","rationaleCorrectZh":"对于有股骨折病史且独居的老年患者，出院计划需要跨学科协调。关键措施包括协调家庭健康照护以进行安全评估，并针对新开的口服抗凝药（高风险药物）安排药物重整和指导。要监测的关键指标是家庭安全/活动能力以及抗凝方案的依从性，以防止出血或血栓栓塞。如果家庭支持可行，强行安置在养老院是不合适的。立即恢复所有活动和停止辅助设备是不安全的。财务账单和访客人数不是护理临床参数。","testTakingStrategyEn":"Focus on transitional care principles. Choose options that provide home safety resources and medication education for high-alert drugs (anticoagulants), while monitoring safety and compliance parameters.","testTakingStrategyZh":"专注于过渡照护原则。选择为高危药物（抗凝剂）提供家庭安全资源和药物指导的选项，同时监测安全和依从性参数。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1065,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_hl_legal_ethics_05","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.808","itemType":"highlight","category":"Management of Care","topic":"Legal & Ethical Principles","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.808.stem.en","stemPathZh":"questions.808.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,97],"terminalOffsetsZh":[0,21],"fullStemEn":"Highlight the nurse's actions that constitute a violation of legal or ethical nursing principles.","fullStemZh":"标出护士构成违反法律或伦理护理原则的行动。","terminalSentenceEn":"Highlight the nurse's actions that constitute a violation of legal or ethical nursing principles.","terminalSentenceZh":"标出护士构成违反法律或伦理护理原则的行动。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"Incident Report Record: The nursing supervisor reviews a report detailing several events on the unit during the shift:","zh":"事件报告记录：护理主管审查了记录本班病房内发生的一些事件报告："},{"id":"s2","en":"Administers a sedative to an agitated client who is refusing the medication, by hiding it in their applesauce without a prescription.","zh":"通过在未经开具处方的情况下将镇静剂藏在苹果酱中，给予拒绝服药的烦躁患者服用。","selectable":true},{"id":"s3","en":"Places bed rails up (2 side rails) for a client who is identified as a high fall risk.","zh":"为被确定为跌倒高危的患者拉起双侧床栏（2个侧栏）。","selectable":true},{"id":"s4","en":"Tells a client that they will be placed in mechanical restraints if they do not stop pressing the call light.","zh":"告知患者，如果他们不停止按呼叫灯，他们将被实施机械性约束。","selectable":true},{"id":"s5","en":"Withholds a dose of digoxin because the client's apical pulse is 52 bpm, and documents the rationale.","zh":"由于患者心尖率为 52次/分而暂停给予一剂地高辛，并记录了理由。","selectable":true},{"id":"s6","en":"Fails to document that a client fell during the shift because the client did not sustain any visible injuries.","zh":"未记录患者在本班期间跌倒的事情，因为患者没有受到任何可见的伤害。","selectable":true}],"correct":["s2","s4","s6"]}},"rationaleCorrectEn":"Hiding medication in applesauce without consent or a prescription (s2) is battery and chemical restraint, which violates patient rights. Threatening a client with restraints to control their behavior (s4) is assault (causing apprehension of harmful contact). Failing to document a client's fall (s6) is negligence and falsification of medical records, which compromises safety. Placing two bed rails up for safety (s3) is a standard fall prevention measure and is not a restraint (four rails would be). Withholding digoxin based on parameters and documenting it (s5) is correct nursing practice.","rationaleCorrectZh":"在没有同意或处方的情况下将药物藏在苹果酱中 (s2) 是殴打（蓄意伤害）和化学约束，这侵犯了患者的权利。威胁患者使用约束以控制其行为 (s4) 是威胁（引起对有害接触的恐惧）。未能记录患者的跌倒 (s6) 是疏忽和伪造医疗记录，这危害了安全。拉起两个床栏进行安全防护 (s3) 是标准的跌倒预防措施，不属于约束（四个栏才属于）。根据参数暂停使用地高辛并予以记录 (s5) 是正确的护理操作。","testTakingStrategyEn":"Understand definitions of legal torts: Assault is a threat of contact; Battery is unauthorized physical contact (like covert drugging); Negligence is failure to perform duty (like undocumented falls). Select these tort violations.","testTakingStrategyZh":"理解法律侵权行为的定义：威胁 (Assault) 是对接触的威胁；伤害 (Battery) 是未经授权的身体接触（如隐蔽给药）；疏忽 (Negligence) 是未能履行职责（如未记录跌倒）。选择这些侵权行为。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1066,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_bt_hepatic_encephalopathy_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.809","itemType":"bowtie","category":"Physiological Adaptation","topic":"Renal & Gastrointestinal Disorders","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.809.stem.en","stemPathZh":"questions.809.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[206,233],"terminalOffsetsZh":[67,78],"fullStemEn":"A 58-year-old male with a history of liver cirrhosis is admitted with worsening confusion, slurred speech, and flapping hand tremors (asterixis). The laboratory reports a serum ammonia level of 142 mcg/dL. The nurse is planning care.","fullStemZh":"一名有肝硬化病史的58岁男性因意识模糊加重、言语含糊和手部扑翼样震颤（扑翼样震颤）入院。实验室报告血清氨水平为 142 mcg/dL。护士正在制定护理计划。","terminalSentenceEn":"The nurse is planning care.","terminalSentenceZh":"护士正在制定护理计划。","penultimateSentenceEn":"The laboratory reports a serum ammonia level of 142 mcg/dL.","penultimateSentenceZh":"实验室报告血清氨水平为 142 mcg/dL。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Most likely condition","zh":"最可能的疾病"},"tokens":[{"id":"c2","en":"Acute pancreatitis","zh":"急性胰腺炎"},{"id":"c3","en":"Hepatorenal syndrome","zh":"肝肾综合征"},{"id":"c1","en":"Hepatic encephalopathy","zh":"肝性脑病"}],"correct":"c1"},"actions":{"prompt":{"en":"Actions to take","zh":"应采取的措施"},"tokens":[{"id":"a1","en":"Administer lactulose orally as prescribed","zh":"按医嘱口服乳果糖"},{"id":"a2","en":"Administer rifaximin orally as prescribed","zh":"按医嘱口服利福昔明"},{"id":"a3","en":"Initiate a high-protein diet","zh":"开始高蛋白饮食"},{"id":"a4","en":"Encourage high dietary sodium intake","zh":"鼓励高钠膳食摄入"}],"correct":["a1","a2"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"应监测的指标"},"tokens":[{"id":"p3","en":"Serum amylase and lipase levels","zh":"血清淀粉酶和脂肪酶水平"},{"id":"p4","en":"Hourly urine output via catheter","zh":"通过导尿管监测每小时尿量"},{"id":"p1","en":"Asterixis and mental status","zh":"扑翼样震颤和意识状态"},{"id":"p2","en":"Number of bowel movements daily","zh":"每日排便次数"}],"correct":["p1","p2"]}}},"rationaleCorrectEn":"The client is presenting with classic signs of hepatic encephalopathy, including confusion, asterixis, and elevated ammonia level, secondary to liver cirrhosis. Primary actions involve reducing ammonia levels using lactulose (which promotes excretion of ammonia via stool) and rifaximin (an antibiotic that reduces ammonia-producing gut bacteria). The nurse must monitor the client's mental status/asterixis and the number of daily stools (titrating lactulose to achieve 2-3 soft stools per day). A high-protein diet should be avoided during an acute episode of hepatic encephalopathy, as protein breakdown increases ammonia production (though chronic restriction is avoided to prevent malnutrition). Sodium restriction is typically indicated for cirrhosis patients with ascites, not sodium loading.","rationaleCorrectZh":"患者出现由于肝硬化继发的脑病典型体征，包括意识模糊、扑翼样震颤和血氨水平升高。主要处理措施包括使用乳果糖（促进氨通过粪便排出）和利福昔明（减少产生氨的肠道细菌的抗生素）来降低血氨水平。护士必须监测患者的意识状态/扑翼样震颤以及每日排便次数（调整乳果糖剂量以达到每天2-3次软便）。在急性肝性脑病发作期间应避免高蛋白饮食，因为蛋白质分解会增加氨的产生（但应避免长期限制以防止营养不良）。对于伴有腹水的肝硬化患者，通常需要限制钠摄入，而不是增加钠摄入。","testTakingStrategyEn":"Focus on the pathopharmacology of liver disease. Connect elevated ammonia and neurological changes to hepatic encephalopathy, then choose actions that eliminate ammonia and parameters that monitor this elimination (mental status and stool frequency).","testTakingStrategyZh":"关注肝脏疾病的病理药理学。将血氨升高和神经系统变化与肝性脑病联系起来，然后选择能清除氨的措施以及监测该清除过程的指标（意识状态和排便频率）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1067,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_bt_thyroid_storm_02","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.810","itemType":"bowtie","category":"Physiological Adaptation","topic":"Endocrine & Neurological Disorders","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.810.stem.en","stemPathZh":"questions.810.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[233,260],"terminalOffsetsZh":[99,110],"fullStemEn":"A 32-year-old female with Graves' disease is admitted to the intensive care unit with hyperpyrexia (104.2 °F (40.1 °C)), extreme tachycardia (152 bpm), agitation, and diaphoresis shortly after undergoing emergency abdominal surgery. The nurse is planning care.","fullStemZh":"一名患有格雷夫斯病（Graves' disease）的32岁女性在接受急诊腹部手术后不久，因高热（104.2 °F (40.1 °C)）、极度心动过速（152次/分）、烦躁和出汗入院进入重症监护室。护士正在制定护理计划。","terminalSentenceEn":"The nurse is planning care.","terminalSentenceZh":"护士正在制定护理计划。","penultimateSentenceEn":"A 32-year-old female with Graves' disease is admitted to the intensive care unit with hyperpyrexia (104.2 °F (40.1 °C)), extreme tachycardia (152 bpm), agitation, and diaphoresis shortly after undergoing emergency abdominal surgery.","penultimateSentenceZh":"一名患有格雷夫斯病（Graves' disease）的32岁女性在接受急诊腹部手术后不久，因高热（104.2 °F (40.1 °C)）、极度心动过速（152次/分）、烦躁和出汗入院进入重症监护室。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Most likely condition","zh":"最可能的疾病"},"tokens":[{"id":"c2","en":"Myxedema coma","zh":"黏液性水肿昏迷"},{"id":"c3","en":"Malignant hyperthermia","zh":"恶性高热"},{"id":"c1","en":"Thyroid storm","zh":"甲状腺风暴"}],"correct":"c1"},"actions":{"prompt":{"en":"Actions to take","zh":"应采取的措施"},"tokens":[{"id":"a2","en":"Administer prescribed intravenous propranolol","zh":"静脉注射医嘱的普萘洛尔"},{"id":"a3","en":"Administer prescribed aspirin for hyperpyrexia","zh":"给予医嘱的阿司匹林治疗高热"},{"id":"a4","en":"Administer prescribed intravenous levothyroxine","zh":"静脉注射医嘱的左旋甲状腺素"},{"id":"a1","en":"Administer prescribed propylthiouracil (PTU)","zh":"给予医嘱的丙基硫氧嘧啶 (PTU)"}],"correct":["a1","a2"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"应监测的指标"},"tokens":[{"id":"p2","en":"Heart rate and cardiac rhythm","zh":"心率和心律"},{"id":"p1","en":"Core body temperature","zh":"核心体温"},{"id":"p3","en":"Deep tendon reflexes","zh":"深腱反射"},{"id":"p4","en":"Hourly fluid drainage from incision","zh":"切口每小时引流液量"}],"correct":["p1","p2"]}}},"rationaleCorrectEn":"The client is experiencing a thyroid storm (thyrotoxic crisis), a life-threatening acute exacerbation of hyperthyroidism triggered by stressors like surgery. Symptoms include hyperpyrexia, severe tachycardia, agitation, and diaphoresis. Essential actions include administering propylthiouracil (PTU) to block thyroid hormone synthesis, and beta-blockers like propranolol to control cardiac hyperactivity and peripheral T4 to T3 conversion. Monitoring core body temperature and cardiac activity is critical to prevent hyperpyretic brain injury and cardiovascular collapse. Aspirin is strictly contraindicated because it displaces thyroid hormone from carrier proteins, worsening the thyrotoxicosis. Levothyroxine would be fatal in this state.","rationaleCorrectZh":"患者正在经历甲状腺风暴（甲状腺毒症危象），这是一种由手术等应激因素触发的甲状腺功能亢进的危及生命的急性恶化。症状包括高热、严重的心动过速、烦躁和出汗。必不可少的措施包括给予丙基硫氧嘧啶 (PTU) 以阻断甲状腺激素合成，以及使用β受体阻滞剂（如普萘洛尔）控制心脏过度兴奋并阻断外周T4向T3的转化。监测核心体温和心脏活动对于防止高热性脑损伤和心血管崩溃至关重要。阿司匹林是绝对禁忌的，因为它会从载体蛋白上置换甲状腺激素，加重甲状腺毒症。在此状态下使用左旋甲状腺素将是致命的。","testTakingStrategyEn":"Note the client's history of Graves' disease and hyperdynamic symptoms (fever, tachycardia). Recall that aspirin is contraindicated in thyroid storm due to thyroid hormone displacement, which leaves PTU and beta-blockers as the correct pharmacologic actions.","testTakingStrategyZh":"注意患者的格雷夫斯病史和高动力学症状（发热、心动过速）。记住阿司匹林因置换甲状腺激素而在甲状腺风暴中属于禁忌，从而确定PTU和β受体阻滞剂为正确的药物措施。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1068,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_bt_infective_endocarditis_03","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.811","itemType":"bowtie","category":"Physiological Adaptation","topic":"Cardiovascular Disorders","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.811.stem.en","stemPathZh":"questions.811.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[236,263],"terminalOffsetsZh":[85,96],"fullStemEn":"A 45-year-old male with a history of intravenous drug use presents to the emergency department with a fever of 102.5 °F (39.2 °C), fatigue, a new loud systolic murmur, and painful, tender, red nodules on his fingertips (Osler's nodes). The nurse is planning care.","fullStemZh":"一名有静脉注射毒品病史的45岁男性因发热102.5 °F (39.2 °C)、疲劳、新出现的心脏收缩期杂音以及手指尖上出现疼痛、压痛的红色结节（奥斯勒结节）就诊于急诊科。护士正在制定护理计划。","terminalSentenceEn":"The nurse is planning care.","terminalSentenceZh":"护士正在制定护理计划。","penultimateSentenceEn":"A 45-year-old male with a history of intravenous drug use presents to the emergency department with a fever of 102.5 °F (39.2 °C), fatigue, a new loud systolic murmur, and painful, tender, red nodules on his fingertips (Osler's nodes).","penultimateSentenceZh":"一名有静脉注射毒品病史的45岁男性因发热102.5 °F (39.2 °C)、疲劳、新出现的心脏收缩期杂音以及手指尖上出现疼痛、压痛的红色结节（奥斯勒结节）就诊于急诊科。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Most likely condition","zh":"最可能的疾病"},"tokens":[{"id":"c1","en":"Infective endocarditis","zh":"感染性心内膜炎"},{"id":"c3","en":"Dilated cardiomyopathy","zh":"扩张型心肌病"},{"id":"c2","en":"Acute pericarditis","zh":"急性心包炎"}],"correct":"c1"},"actions":{"prompt":{"en":"Actions to take","zh":"应采取的措施"},"tokens":[{"id":"a3","en":"Administer prescribed systemic anticoagulants","zh":"给予医嘱的全身性抗凝剂"},{"id":"a4","en":"Prepare the client for an immediate exercise stress test","zh":"准备患者立即进行运动负荷试验"},{"id":"a2","en":"Initiate broad-spectrum IV antibiotics after blood cultures","zh":"在采集血培养后开始广谱静脉抗生素"},{"id":"a1","en":"Obtain blood cultures from two separate sites","zh":"从两个独立部位采集血培养"}],"correct":["a1","a2"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"应监测的指标"},"tokens":[{"id":"p2","en":"Core body temperature","zh":"核心体温"},{"id":"p1","en":"Neurological status","zh":"神经系统状态"},{"id":"p4","en":"Hourly output from chest tube","zh":"胸腔引流管每小时引流量"},{"id":"p3","en":"Serum creatinine and renal function","zh":"血清肌酐和肾功能"}],"correct":["p1","p2"]}}},"rationaleCorrectEn":"The client presents with classic features of infective endocarditis (IE), including a history of IV drug use, fever, new murmur, and Osler's nodes. Priority actions are to obtain blood cultures from at least two separate sites to identify the causative organism, followed by initiating prescribed broad-spectrum IV antibiotics. Key parameters to monitor include body temperature (to assess response to therapy) and neurological status. Neurological assessment is vital because vegetations on the heart valves can break off and embolize, causing an ischemic stroke. Systemic anticoagulation is not routinely recommended for native valve IE and can increase the risk of hemorrhagic transformation of embolic strokes. An exercise stress test is contraindicated due to the risk of valvular dysfunction and embolization.","rationaleCorrectZh":"该患者表现出感染性心内膜炎 (IE) 的典型特征，包括静脉注射毒品史、发热、新发杂音和奥斯勒结节。优先处理措施是从至少两个不同部位获取血培养以鉴定病原微生物，然后开始使用医嘱的广谱静脉抗生素。要监测的关键指标包括体温（评估治疗效果）和神经系统状态。神经系统评估至关重要，因为心瓣膜上的赘生物可能会脱落并导致栓塞，从而引起缺血性脑卒中。不常规推荐对自体瓣膜IE进行全身抗凝，因为这会增加栓塞性脑卒中出血性转化的风险。由于存在瓣膜功能障碍和栓塞的风险，禁止进行运动负荷试验。","testTakingStrategyEn":"Associate IV drug use and fever with infective endocarditis. Recognize that embolic stroke is a major risk, requiring close neurological monitoring, and blood culture collection must precede antibiotic therapy.","testTakingStrategyZh":"将静脉注射毒品和发热与感染性心内膜炎联系起来。认识到栓塞性脑卒中是一个主要风险，需要密切的神经系统监测，且在给予抗生素治疗前必须先采集血培养。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1069,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_bt_tension_pneumothorax_04","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.812","itemType":"bowtie","category":"Physiological Adaptation","topic":"Respiratory & Infectious Disorders","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.812.stem.en","stemPathZh":"questions.812.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[255,282],"terminalOffsetsZh":[68,79],"fullStemEn":"A 28-year-old male is brought to the emergency department after a motor vehicle collision. The nurse notes tracheal deviation to the left, absent breath sounds on the right, hypotension (82/50 mmHg), distended neck veins, and severe respiratory distress. The nurse is planning care.","fullStemZh":"一名28岁男性在车祸后被送入急诊科。护士注意到气管向左偏斜、右侧呼吸音消失、低血压 (82/50 mmHg)、颈静脉怒张和严重呼吸困难。护士正在制定护理计划。","terminalSentenceEn":"The nurse is planning care.","terminalSentenceZh":"护士正在制定护理计划。","penultimateSentenceEn":"The nurse notes tracheal deviation to the left, absent breath sounds on the right, hypotension (82/50 mmHg), distended neck veins, and severe respiratory distress.","penultimateSentenceZh":"护士注意到气管向左偏斜、右侧呼吸音消失、低血压 (82/50 mmHg)、颈静脉怒张和严重呼吸困难。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Most likely condition","zh":"最可能的疾病"},"tokens":[{"id":"c2","en":"Cardiac tamponade","zh":"心包填塞"},{"id":"c3","en":"Flail chest","zh":"连枷胸"},{"id":"c1","en":"Tension pneumothorax","zh":"张力性气胸"}],"correct":"c1"},"actions":{"prompt":{"en":"Actions to take","zh":"应采取的措施"},"tokens":[{"id":"a3","en":"Position the client in the prone position","zh":"将患者置于俯卧位"},{"id":"a4","en":"Perform chest physiotherapy and postural drainage","zh":"进行胸部物理治疗和体位引流"},{"id":"a2","en":"Prepare for chest tube insertion","zh":"准备胸腔引流管置入"},{"id":"a1","en":"Assist with immediate needle decompression on the right side","zh":"协助在右侧立即进行针头减压"}],"correct":["a1","a2"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"应监测的指标"},"tokens":[{"id":"p4","en":"Urine specific gravity","zh":"尿比重"},{"id":"p2","en":"Blood pressure and heart rate","zh":"血压和心率"},{"id":"p3","en":"Pupillary light reflex","zh":"瞳孔对光反射"},{"id":"p1","en":"Breath sounds on the right side","zh":"右侧呼吸音"}],"correct":["p1","p2"]}}},"rationaleCorrectEn":"The client is presenting with tension pneumothorax on the right side, characterized by severe respiratory distress, absent breath sounds on the affected side, tracheal deviation to the contralateral side (left), and signs of obstructive shock (hypotension, neck vein distention). Immediate life-saving action is needle decompression on the right side to release trapped air, followed by chest tube insertion to re-expand the lung. Critical parameters to monitor are breath sounds (to confirm lung re-expansion) and blood pressure/heart rate (to ensure recovery from obstructive shock). Prone positioning is contraindicated as it worsens respiratory distress. Chest physiotherapy is inappropriate and dangerous in this acute stage.","rationaleCorrectZh":"患者出现右侧张力性气胸，其特征是严重的呼吸困难、患侧呼吸音消失、气管向对侧（左侧）偏斜以及梗阻性休克体征（低血压、颈静脉怒张）。紧急挽救生命的措施是在右侧进行针头减压以释放积聚的气体，然后置入胸腔引流管以复张肺部。要监测的关键指标是呼吸音（以确认肺部复张）和血压/心率（以确保梗阻性休克得到缓解）。俯卧位是禁忌的，因为它会加重呼吸困难。在此急性阶段进行胸部物理治疗是不恰当且危险的。","testTakingStrategyEn":"Identify key clinical indicators of tension pneumothorax: unilateral absent breath sounds, tracheal deviation, and obstructive shock. Prioritize immediate air evacuation (needle decompression, chest tube) and monitoring parameters that check ventilation and perfusion.","testTakingStrategyZh":"确定张力性气胸的关键临床指标：单侧呼吸音消失、气管偏斜和梗阻性休克。优先考虑立即排出气体（针头减压、胸腔引流管）以及监测检查通气和灌注的指标。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1070,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_bt_severe_hyperkalemia_05","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.813","itemType":"bowtie","category":"Physiological Adaptation","topic":"Electrolyte Imbalances","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.813.stem.en","stemPathZh":"questions.813.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[291,318],"terminalOffsetsZh":[99,110],"fullStemEn":"A 72-year-old female with end-stage renal disease (ESRD) is admitted with generalized weakness, palpitations, and bradycardia. The laboratory reports a serum potassium level of 7.2 mEq/L. The electrocardiogram (ECG) shows peaked T waves, a prolonged PR interval, and widening QRS complexes. The nurse is planning care.","fullStemZh":"一名患有终末期肾脏病 (ESRD) 的72岁女性因全身无力、心悸和心动过缓入院。实验室报告血清钾水平为 7.2 mEq/L。心电图 (ECG) 显示 T 波高尖、PR 间期延长和 QRS 波群增宽。护士正在制定护理计划。","terminalSentenceEn":"The nurse is planning care.","terminalSentenceZh":"护士正在制定护理计划。","penultimateSentenceEn":"The electrocardiogram (ECG) shows peaked T waves, a prolonged PR interval, and widening QRS complexes.","penultimateSentenceZh":"心电图 (ECG) 显示 T 波高尖、PR 间期延长和 QRS 波群增宽。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Most likely condition","zh":"最可能的疾病"},"tokens":[{"id":"c1","en":"Severe hyperkalemia","zh":"严重高钾血症"},{"id":"c3","en":"Severe hypercalcemia","zh":"严重高钙血症"},{"id":"c2","en":"Severe hypokalemia","zh":"严重低钾血症"}],"correct":"c1"},"actions":{"prompt":{"en":"Actions to take","zh":"应采取的措施"},"tokens":[{"id":"a4","en":"Infuse prescribed potassium chloride intravenously","zh":"静脉滴注医嘱的氯化钾"},{"id":"a3","en":"Administer prescribed oral spironolactone daily","zh":"每日给予医嘱的口服螺内酯"},{"id":"a1","en":"Administer prescribed intravenous calcium gluconate","zh":"给予医嘱的静脉注射葡萄糖酸钙"},{"id":"a2","en":"Administer prescribed intravenous regular insulin with dextrose","zh":"给予医嘱的静脉注射普通胰岛素加葡萄糖"}],"correct":["a1","a2"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"应监测的指标"},"tokens":[{"id":"p3","en":"Hourly urine output from catheter","zh":"通过导尿管监测每小时尿量"},{"id":"p1","en":"Continuous cardiac rhythm via telemetry","zh":"通过心电监护持续监测心律"},{"id":"p2","en":"Follow-up serum potassium level","zh":"跟进血清钾水平"},{"id":"p4","en":"Serum sodium level","zh":"血清钠水平"}],"correct":["p1","p2"]}}},"rationaleCorrectEn":"The client is experiencing severe hyperkalemia (potassium 7.2 mEq/L) with ECG modifications (peaked T waves, wide QRS), which is a cardiovascular emergency. The immediate priority is cardioprotection via intravenous calcium gluconate to stabilize the myocardial cell membrane and prevent lethal dysrhythmias. The second priority is shifting potassium into cells, achieved by administering regular insulin with dextrose. Key parameters to monitor are the continuous cardiac rhythm (telemetry) to catch dysrhythmias, and follow-up potassium levels to evaluate treatment efficacy. Spironolactone is a potassium-sparing diuretic and is contraindicated. Adding potassium chloride would be lethal. Hourly urine output is not a useful parameter for potassium reduction monitoring in this anuric ESRD client.","rationaleCorrectZh":"患者正经历严重的高钾血症（血清钾为 7.2 mEq/L），并伴有心电图改变（T波高尖、QRS波增宽），这属于心血管急症。当务之急是通过静脉注射葡萄糖酸钙来进行心脏保护，以稳定心肌细胞膜，防止致命性心律失常。第二个优先事项是将钾转移到细胞内，这可以通过给予普通胰岛素和葡萄糖来实现。要监测的关键指标是持续心律（心电监护）以发现心律失常，以及跟进血钾水平以评估治疗效果。螺内酯是一种保钾利尿剂，属于禁忌证。加入氯化钾将是致命的。对于此无尿的ESRD患者，每小时尿量对于监测钾降低并非有用指标。","testTakingStrategyEn":"Recognize the critical ECG signs of severe hyperkalemia. Select the stabilizing agent (calcium gluconate) and the shift agent (insulin with dextrose), and monitor cardiac electrical activity (telemetry) and potassium levels.","testTakingStrategyZh":"认识严重高钾血症的关键心电图体征。选择稳定剂（葡萄糖酸钙）和转移剂（胰岛素加葡萄糖），并监测心脏电活动（心电监护）和血钾水平。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1071,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_pyloric_stenosis_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.814","itemType":"case_study","category":"Physiological Adaptation","topic":"Renal & Gastrointestinal Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.814.stem.en","stemPathZh":"questions.814.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,194],"terminalOffsetsZh":[0,52],"fullStemEn":"Unfolding Case: 6-Week-Old Infant with Projectile Vomiting A 6-week-old male infant is brought to the pediatric clinic by his mother due to persistent vomiting after feeding for the past 5 days.","fullStemZh":"展开式案例：伴有喷射性呕吐的6周龄婴儿 一名6周龄的男婴因过去5天进食后持续呕吐被母亲带到儿科诊所就诊。","terminalSentenceEn":"Unfolding Case: 6-Week-Old Infant with Projectile Vomiting A 6-week-old male infant is brought to the pediatric clinic by his mother due to persistent vomiting after feeding for the past 5 days.","terminalSentenceZh":"展开式案例：伴有喷射性呕吐的6周龄婴儿 一名6周龄的男婴因过去5天进食后持续呕吐被母亲带到儿科诊所就诊。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This unfolding case study guides the learner through the care of an infant with hypertrophic pyloric stenosis, assessing baseline cues, recognizing chemical alterations (hypokalemic, hypochloremic metabolic alkalosis), prioritizing preoperative fluid and electrolyte resuscitation, and implementing the postoperative feeding protocol.","rationaleCorrectZh":"此展开式案例研究指导学习者护理患有肥厚性幽门狭窄的婴儿，包括评估基线迹象、识别化学改变（低钾低氯性代谢性碱中毒）、优先考虑术前液体和电解质复苏以及执行术后喂养方案。","testTakingStrategyEn":"Focus on identifying fluid and electrolyte disturbances in pediatric GI obstruction cases and postoperative pediatric care principles.","testTakingStrategyZh":"重点识别儿科胃肠道梗阻病例中的液体和电解质紊乱以及术后儿科护理原则。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1072,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_pyloric_stenosis_01","embeddedQuestionId":"gemini_gap_case_pyloric_stenosis_01_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.814.caseStudy.questions.0","itemType":"select_all","category":"Physiological Adaptation","topic":"Renal & Gastrointestinal Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.814.caseStudy.questions.0.stem.en","stemPathZh":"questions.814.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[113,135],"terminalOffsetsZh":[25,33],"fullStemEn":"Based on the triage assessment, which clinical findings support a diagnosis of pyloric stenosis and dehydration? Select all that apply.","fullStemZh":"根据分诊评估，哪些临床发现支持幽门狭窄和脱水诊断？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Based on the triage assessment, which clinical findings support a diagnosis of pyloric stenosis and dehydration?","penultimateSentenceZh":"根据分诊评估，哪些临床发现支持幽门狭窄和脱水诊断？","responseContext":{"type":"select_all","options":[{"id":"D","en":"Constant hunger immediately after vomiting","zh":"呕吐后立即出现持续饥饿感"},{"id":"B","en":"Palpable olive-shaped epigastric mass","zh":"上腹部触及橄榄样肿块"},{"id":"E","en":"Weight gain from birth weight","zh":"体重较出生体重增加"},{"id":"A","en":"Projectile, non-bilious vomiting after feeding","zh":"喂食后喷射性、非胆汁性呕吐"},{"id":"C","en":"Depressed fontanelle and dry mucous membranes","zh":"前囟凹陷和黏膜干燥"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"Projectile non-bilious vomiting, a palpable olive-shaped mass in the epigastric region, and hunger immediately after vomiting are classic signs of hypertrophic pyloric stenosis. Depressed fontanelles and dry mucous membranes are signs of moderate-to-severe dehydration resulting from excessive vomiting. Weight loss (not weight gain) is expected due to the inability to retain nutrients.","rationaleCorrectZh":"喷射性非胆汁性呕吐、上腹部触及橄榄样肿块以及呕吐后立即出现饥饿感是肥厚性幽门狭窄的典型体征。前囟凹陷和黏膜干燥是过度呕吐导致的中重度脱水征象。由于无法保留营养，预期会出现体重减轻（而非增加）。","testTakingStrategyEn":"Identify characteristics unique to pyloric stenosis (projectile, non-bilious vomiting, olive-shaped mass) and signs of dehydration (depressed fontanelle, dry membranes) while rejecting clinical anomalies (weight gain in a vomiting infant).","testTakingStrategyZh":"识别幽门狭窄独有的特征（喷射性非胆汁性呕吐、橄榄样肿块）和脱水体征（前囟凹陷、黏膜干燥），同时排除临床异常表现（呕吐婴儿体重增加）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1073,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_pyloric_stenosis_01","embeddedQuestionId":"gemini_gap_case_pyloric_stenosis_01_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.814.caseStudy.questions.1","itemType":"matrix","category":"Physiological Adaptation","topic":"Renal & Gastrointestinal Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.814.caseStudy.questions.1.stem.en","stemPathZh":"questions.814.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[103,253],"terminalOffsetsZh":[24,63],"fullStemEn":"The nurse considers the acid-base and electrolyte changes that occur with severe, persistent vomiting. For each laboratory value below, click to specify whether it would be an expected finding or an unexpected finding in an infant with pyloric stenosis.","fullStemZh":"护士考虑严重、持续呕吐时发生的酸碱和电解质变化。对于下列每项实验室数值，点击以指定它在幽门狭窄婴儿中是预期表现还是非预期表现。","terminalSentenceEn":"For each laboratory value below, click to specify whether it would be an expected finding or an unexpected finding in an infant with pyloric stenosis.","terminalSentenceZh":"对于下列每项实验室数值，点击以指定它在幽门狭窄婴儿中是预期表现还是非预期表现。","penultimateSentenceEn":"The nurse considers the acid-base and electrolyte changes that occur with severe, persistent vomiting.","penultimateSentenceZh":"护士考虑严重、持续呕吐时发生的酸碱和电解质变化。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"pH 7.25","zh":"pH 7.25"},{"id":"r2","en":"Potassium 3.1 mEq/L","zh":"血清钾 3.1 mEq/L"},{"id":"r3","en":"Chloride 88 mEq/L","zh":"血清氯 88 mEq/L"}],"columns":[{"id":"c1","en":"Expected finding for severe vomiting","zh":"严重呕吐的预期表现"},{"id":"c2","en":"Unexpected finding","zh":"非预期表现"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c2"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c1"]}]},"rationaleCorrectEn":"A pH of 7.25 indicates acidosis, which is an unexpected finding in pyloric stenosis (infants with severe, persistent vomiting typically present with hypokalemic, hypochloremic metabolic alkalosis, with a pH >7.45). Potassium of 3.1 mEq/L (hypokalemia) and Chloride of 88 mEq/L (hypochloremia) are expected findings due to the loss of potassium, hydrogen, and chloride ions in gastric secretions.","rationaleCorrectZh":"pH 7.25 提示酸中毒，这在幽门狭窄中是非预期表现（有严重、持续呕吐的婴儿通常表现为低钾、低氯性代谢性碱中毒，pH >7.45）。血清钾 3.1 mEq/L（低钾血症）和血清氯 88 mEq/L（低氯血症）由于胃液中钾、氢和氯离子的流失，是符合预期的表现。","testTakingStrategyEn":"Recall the classic acid-base and electrolyte abnormalities of vomiting (hypokalemic, hypochloremic metabolic alkalosis). Relate these to the chemistry values shown in Stage 2.","testTakingStrategyZh":"回忆呕吐经典的酸碱和电解质异常（低钾、低氯性代谢性碱中毒）。将这些与阶段2中显示的化学值联系起来。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1074,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_pyloric_stenosis_01","embeddedQuestionId":"gemini_gap_case_pyloric_stenosis_01_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.814.caseStudy.questions.2","itemType":"dropdown_cloze","category":"Physiological Adaptation","topic":"Renal & Gastrointestinal Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.814.caseStudy.questions.2.stem.en","stemPathZh":"questions.814.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[64,149],"terminalOffsetsZh":[18,39],"fullStemEn":"The nurse is preparing the client for a surgical pyloromyotomy. Select the appropriate options from the dropdown menus to complete the clinical plan.","fullStemZh":"护士正准备协助患者进行幽门肌切开术。从下拉菜单中选择合适的选项以完成临床计划。","terminalSentenceEn":"Select the appropriate options from the dropdown menus to complete the clinical plan.","terminalSentenceZh":"从下拉菜单中选择合适的选项以完成临床计划。","penultimateSentenceEn":"The nurse is preparing the client for a surgical pyloromyotomy.","penultimateSentenceZh":"护士正准备协助患者进行幽门肌切开术。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"To prepare the client for surgery, the nurse should prioritize administering {{1}} and maintaining {{2}} status.","zh":"为了使患者做好手术准备，护士应优先给予 {{1}} 并维持 {{2}} 状态。"},"dropdowns":[{"id":"1","options":[{"id":"o2","en":"oral rehydration therapy","zh":"口服补液疗法"},{"id":"o1","en":"intravenous fluids containing potassium","zh":"含钾的静脉补液"},{"id":"o3","en":"bolus dose of potassium chloride IV push","zh":"静脉直接推注靶剂量的氯化钾"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"nothing by mouth (NPO)","zh":"禁食水 (NPO)"},{"id":"o2","en":"frequent, small volume breast milk feed","zh":"频繁、小量的母乳喂养"},{"id":"o3","en":"clear liquid diet","zh":"流质饮食"}],"correct":"o1"}]},"rationaleCorrectEn":"Preoperative management of pyloric stenosis focuses on correcting dehydration and electrolyte imbalances (specifically hypokalemia and hypochloremia) and maintaining NPO status to prevent further vomiting and aspiration risk. IV fluids with potassium chloride are key, but potassium must never be given IV push as it is lethal. Oral intake is contraindicated once the diagnosis is made.","rationaleCorrectZh":"幽门狭窄的术前处理重点是纠正脱水和电解质紊乱（特别是低钾血症和低氯血症），并保持禁食（NPO）状态以防止进一步呕吐和误吸风险。使用含有氯化钾的静脉液体是关键，但绝不能静脉推注钾，因为这是致命的。一旦确诊，禁止口服摄入。","testTakingStrategyEn":"Recognize that surgery (pyloromyotomy) requires the patient to have stable electrolytes and an empty stomach. Select IV fluid resuscitation over oral options, and NPO status over feeding options.","testTakingStrategyZh":"认识到手术（幽门肌切开术）要求患者电解质稳定且胃排空。选择静脉补液而非口服选项，选择禁食 (NPO) 状态而非喂食选项。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1075,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_pyloric_stenosis_01","embeddedQuestionId":"gemini_gap_case_pyloric_stenosis_01_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.814.caseStudy.questions.3","itemType":"multiple_choice","category":"Physiological Adaptation","topic":"Renal & Gastrointestinal Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.814.caseStudy.questions.3.stem.en","stemPathZh":"questions.814.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[81,127],"terminalOffsetsZh":[19,31],"fullStemEn":"The nurse is reviewing orders for postoperative feedings on Postoperative Day 1. Which action should the nurse implement first?","fullStemZh":"护士正在审查术后第1天术后喂养的医嘱。护士应首先执行哪项操作？","terminalSentenceEn":"Which action should the nurse implement first?","terminalSentenceZh":"护士应首先执行哪项操作？","penultimateSentenceEn":"The nurse is reviewing orders for postoperative feedings on Postoperative Day 1.","penultimateSentenceZh":"护士正在审查术后第1天术后喂养的医嘱。","responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Initiate feedings with small amounts of clear liquids or oral rehydration solution","zh":"从少量流质或口服补液开始喂食"},{"id":"D","en":"Administer prescribed antiemetics and delay feeding","zh":"给予医嘱的止吐药并延迟喂食"},{"id":"B","en":"Administer a full bottle of standard infant formula","zh":"喂食一整瓶标准婴儿配方奶"},{"id":"C","en":"Keep the infant strictly NPO for another 24 hours","zh":"使婴儿继续严格禁食24小时"}],"correct":["A"]},"rationaleCorrectEn":"Postoperative feedings following a pyloromyotomy typically begin 12 to 24 hours after surgery. Feeding is introduced gradually, starting with small amounts of clear liquids (such as sterile water or electrolyte solution) or diluted formula/breast milk. If tolerated, the volume and concentration are gradually increased. Spitting up is common initially but feeding is not discontinued. Full feeds immediately are contraindicated. Strict NPO is unnecessary unless complications occur.","rationaleCorrectZh":"幽门肌切开术后的术后喂养通常在术后 12 至 24 小时开始。喂养是逐步引入的，从少量流质（如无菌水或电解质溶液）或稀释的配方奶/母乳开始。如果耐受良好，则逐渐增加量和浓度。开始时吐奶很常见，但不需要停止喂养。立即进行全量喂养是禁忌的。除非出现并发症，否则没有必要严格禁食。","testTakingStrategyEn":"Focus on nursing care guidelines for postoperative gastrointestinal recovery. Select the gradual feeding protocol (clear liquids, small amounts) as the safest initial action.","testTakingStrategyZh":"关注术后胃肠道恢复的护理指南。选择逐步喂养方案（清流质、少量）作为最安全的初始操作。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"The nurse is reviewing orders for postoperative feedings on Postoperative Day 1.","controlSentenceZh":"护士正在审查术后第1天术后喂养的医嘱。"}
{"queueIndex":1076,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_pediatric_croup_02","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.815","itemType":"case_study","category":"Physiological Adaptation","topic":"Respiratory & Infectious Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.815.stem.en","stemPathZh":"questions.815.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,208],"terminalOffsetsZh":[0,66],"fullStemEn":"Unfolding Case: 14-Month-Old Toddler with a Barking Cough A 14-month-old male is brought to the emergency department at 0200 by his parents due to a sudden onset of a harsh, barking cough and noisy breathing.","fullStemZh":"展开式案例：伴有犬吠样咳嗽的14个月龄幼儿 一名14个月大的男婴因突然出现剧烈的犬吠样咳嗽和呼吸有杂音，于0200被父母送入急诊科。","terminalSentenceEn":"Unfolding Case: 14-Month-Old Toddler with a Barking Cough A 14-month-old male is brought to the emergency department at 0200 by his parents due to a sudden onset of a harsh, barking cough and noisy breathing.","terminalSentenceZh":"展开式案例：伴有犬吠样咳嗽的14个月龄幼儿 一名14个月大的男婴因突然出现剧烈的犬吠样咳嗽和呼吸有杂音，于0200被父母送入急诊科。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This case study focuses on croup, testing airway prioritization, contraindicated invasive procedures (throat cultures/tongue blade), pharmacology of racemic epinephrine (duration and rebound monitoring), and parent teaching regarding supportive respiratory care.","rationaleCorrectZh":"该案例研究关注哮吼，测试气道优先顺序、禁忌的侵入性操作（咽培养/压舌板）、外消旋肾上腺素的药理学（持续时间和反弹监测）以及关于支持性呼吸护理的家长指导。","testTakingStrategyEn":"Focus on the ABCs and avoiding actions that can cause complete airway closure in pediatric upper respiratory infections.","testTakingStrategyZh":"重点关注ABCs并避免在小儿上呼吸道感染中采取可能导致气道完全关闭的操作。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1077,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_pediatric_croup_02","embeddedQuestionId":"gemini_gap_case_pediatric_croup_02_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.815.caseStudy.questions.0","itemType":"multiple_choice","category":"Physiological Adaptation","topic":"Respiratory & Infectious Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.815.caseStudy.questions.0.stem.en","stemPathZh":"questions.815.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,95],"terminalOffsetsZh":[0,25],"fullStemEn":"Which clinical finding in the triage note is the priority indicator of upper airway compromise?","fullStemZh":"分诊记录中的哪项临床发现是上呼吸道受损的优先指标？","terminalSentenceEn":"Which clinical finding in the triage note is the priority indicator of upper airway compromise?","terminalSentenceZh":"分诊记录中的哪项临床发现是上呼吸道受损的优先指标？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Inspiratory stridor at rest","zh":"静息时吸气性喉鸣"},{"id":"B","en":"Temperature of 101.1 °F (38.4 °C)","zh":"体温 101.1 °F (38.4 °C)"},{"id":"C","en":"Oxygen saturation of 94% on room air","zh":"室内空气下氧饱和度为 94%"},{"id":"D","en":"Heart rate of 138 bpm","zh":"心率 138次/分"}],"correct":["A"]},"rationaleCorrectEn":"Inspiratory stridor at rest indicates significant swelling and narrowing of the larynx and subglottic airway (croup). While stridor only during agitation is moderate, stridor at rest signifies impending airway obstruction and is the priority finding. Tachycardia and mild desaturation (94%) are consequences of the respiratory distress, but airway obstruction is the primary pathology. Fever is expected with viral croup.","rationaleCorrectZh":"静息时吸气性喉鸣提示喉部和声门下气道显著肿胀和狭窄（哮吼）。虽然仅在烦躁时出现喉鸣为中度，但静息时喉鸣标志着即将发生气道梗阻，属于优先发现。心动过速和轻度氧饱和度下降 (94%) 是呼吸困难的结果，但气道梗阻是主要病理改变。病毒性哮吼发热是符合预期的。","testTakingStrategyEn":"Prioritize using the Airway-Breathing-Circulation (ABC) framework. Stridor is a direct indicator of airway swelling and potential closure.","testTakingStrategyZh":"优先使用气道-呼吸-循环 (ABC) 框架。喉鸣是气道肿胀和潜在关闭的直接指标。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1078,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_pediatric_croup_02","embeddedQuestionId":"gemini_gap_case_pediatric_croup_02_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.815.caseStudy.questions.1","itemType":"matrix","category":"Physiological Adaptation","topic":"Respiratory & Infectious Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.815.caseStudy.questions.1.stem.en","stemPathZh":"questions.815.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[76,177],"terminalOffsetsZh":[16,48],"fullStemEn":"The nurse is preparing to care for the toddler in the emergency department. For each intervention, click to specify if it is indicated or contraindicated for this client's care.","fullStemZh":"护士正准备在急诊科护理这名幼儿。对于每项干预措施，点击以指定它是适用于该患者的护理还是属于禁忌。","terminalSentenceEn":"For each intervention, click to specify if it is indicated or contraindicated for this client's care.","terminalSentenceZh":"对于每项干预措施，点击以指定它是适用于该患者的护理还是属于禁忌。","penultimateSentenceEn":"The nurse is preparing to care for the toddler in the emergency department.","penultimateSentenceZh":"护士正准备在急诊科护理这名幼儿。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Administer nebulized racemic epinephrine as prescribed","zh":"按医嘱给予雾化吸入外消旋肾上腺素"},{"id":"r2","en":"Administer oral or intramuscular dexamethasone as prescribed","zh":"按医嘱口服或肌内注射地塞米松"},{"id":"r3","en":"Perform a throat culture using a tongue depressor to rule out strep throat","zh":"使用压舌板进行咽拭子培养以排除链球菌性咽炎"}],"columns":[{"id":"c2","en":"Contraindicated","zh":"禁用"},{"id":"c1","en":"Indicated","zh":"适用"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]}]},"rationaleCorrectEn":"Nebulized racemic epinephrine is indicated to quickly reduce subglottic mucosal edema via mucosal vasoconstriction. Dexamethasone is a corticosteroid indicated to decrease airway inflammation (with a longer-lasting effect). Performing a throat culture or using a tongue depressor is strictly contraindicated in kids with croup or suspected epiglottitis, as inserting an object into the posterior pharynx can trigger severe laryngospasm and complete airway obstruction.","rationaleCorrectZh":"适用雾化吸入外消旋肾上腺素，以通过黏膜血管收缩快速减轻声门下黏膜水肿。地塞米松是一种皮质类固醇，适用于减轻气道炎症（具有更持久的效果）。对于患有哮吼或疑似会厌炎的儿童，进行咽培养或使用压舌板是绝对禁忌的，因为将物体插入后咽部会触发严重的喉痉挛和完全的气道梗阻。","testTakingStrategyEn":"Recall safety rules for pediatric respiratory emergencies. Avoid invasive throat examinations (tongue depressors, throat swabs) when upper airway swelling/stridor is present.","testTakingStrategyZh":"记住儿科呼吸急症的安全规则。当存在上气道肿胀/喉鸣时，避免进行侵入性咽部检查（压舌板、咽拭子）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1079,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_pediatric_croup_02","embeddedQuestionId":"gemini_gap_case_pediatric_croup_02_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.815.caseStudy.questions.2","itemType":"dropdown_cloze","category":"Physiological Adaptation","topic":"Respiratory & Infectious Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.815.caseStudy.questions.2.stem.en","stemPathZh":"questions.815.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[69,196],"terminalOffsetsZh":[20,52],"fullStemEn":"The nurse is administering nebulized racemic epinephrine as ordered. Select the appropriate options from the dropdown menus to complete the statement regarding clinical monitoring and drug action.","fullStemZh":"护士正在按照医嘱给予雾化外消旋肾上腺素。从下拉菜单中选择合适的选项，以完成关于临床监测和药物作用的陈述。","terminalSentenceEn":"Select the appropriate options from the dropdown menus to complete the statement regarding clinical monitoring and drug action.","terminalSentenceZh":"从下拉菜单中选择合适的选项，以完成关于临床监测和药物作用的陈述。","penultimateSentenceEn":"The nurse is administering nebulized racemic epinephrine as ordered.","penultimateSentenceZh":"护士正在按照医嘱给予雾化外消旋肾上腺素。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"When administering nebulized racemic epinephrine, the nurse must monitor the client closely for {{1}} because the drug's therapeutic effect has a duration of {{2}}.","zh":"在给予雾化吸入外消旋肾上腺素时，护士必须密切监测患者是否出现 {{1}}，因为该药治疗效果的持续时间为 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"rebound stridor and respiratory distress","zh":"反弹性的喉鸣和呼吸困难"},{"id":"o2","en":"prolonged hypotension and bradycardia","zh":"持续的低血压和心动过缓"},{"id":"o3","en":"decreased level of consciousness and pupillary changes","zh":"意识水平下降和瞳孔改变"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"approximately 12 to 24 hours","zh":"大约12至24小时"},{"id":"o3","en":"up to 3 to 5 days","zh":"长达3至5天"},{"id":"o1","en":"approximately 1 to 2 hours","zh":"大约1至2小时"}],"correct":"o1"}]},"rationaleCorrectEn":"Racemic epinephrine has a rapid onset (within minutes) but a short duration of action (about 1 to 2 hours). As the medication wears off, the subglottic edema can recur, causing rebound stridor and severe respiratory distress. The nurse must monitor the child in the ED or hospital for at least 2 to 3 hours after administration to ensure symptoms do not rebound.","rationaleCorrectZh":"外消旋肾上腺素起效迅速（数分钟内），但作用持续时间短（约1至2小时）。随着药效消失，声门下水肿可能会复发，导致反弹性的喉鸣和严重的呼吸困难。给药后，护士必须在急诊科或医院监测孩子至少 2 至 3 小时，以确保症状不会反弹。","testTakingStrategyEn":"Remember that epinephrine is a sympathomimetic with a rapid but short-lived action. Anticipate the recurrence of mucosal edema (rebound effect) when the drug wears off.","testTakingStrategyZh":"记住肾上腺素是一种起效快但作用短的拟交感神经药。预期药物消退时黏膜水肿会复发（反弹效应）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1080,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_pediatric_croup_02","embeddedQuestionId":"gemini_gap_case_pediatric_croup_02_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.815.caseStudy.questions.3","itemType":"select_all","category":"Physiological Adaptation","topic":"Respiratory & Infectious Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.815.caseStudy.questions.3.stem.en","stemPathZh":"questions.815.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[103,125],"terminalOffsetsZh":[24,32],"fullStemEn":"The child is preparing for discharge. Which discharge instructions should the nurse teach the parents? Select all that apply.","fullStemZh":"孩子正准备出院。护士应该向家长传授哪些出院指导？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which discharge instructions should the nurse teach the parents?","penultimateSentenceZh":"护士应该向家长传授哪些出院指导？","responseContext":{"type":"select_all","options":[{"id":"E","en":"Administer prescribed oral dexamethasone only when the child has a barking cough.","zh":"仅在孩子出现犬吠样咳嗽时才给予医嘱的口服地塞米松。"},{"id":"D","en":"Keep the child upright or in a comfortable position when coughing.","zh":"孩子咳嗽时保持直立位或舒适体位。"},{"id":"B","en":"Take the child outside into the cool night air if a coughing spasm occurs.","zh":"如果孩子咳嗽痉挛，带他到室外呼吸冷夜空气。"},{"id":"A","en":"Use a cool-mist humidifier in the child's bedroom.","zh":"在孩子的卧室里使用冷雾加湿器。"},{"id":"C","en":"Monitor for retractions, noisy breathing, or blue discoloration around the lips.","zh":"监测是否有呼吸凹陷、呼吸杂音或口唇周围青紫。"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"Cool mist humidifier and breathing in cool night air or steam from a hot shower help reduce mucosal swelling and relieve spasm. Staying upright prevents airway compression. Parents must monitor for severe distress signs (retractions, stridor, cyanosis) and seek immediate care. Dexamethasone is a scheduled, one-time or short-course medication, not given PRN for coughing spells.","rationaleCorrectZh":"冷雾加湿器和吸入冷夜空气或热水淋浴产生的蒸汽有助于减轻黏膜肿胀并缓解痉挛。保持直立位可以防止气道受压。家长必须监测严重困难体征（凹陷、喉鸣、发绀）并立即就医。地塞米松是一种按计划、一次性或短程使用的药物，不能在咳嗽发作时临时（PRN）给予。","testTakingStrategyEn":"Select non-pharmacological, supportive interventions that help soothe upper airway tissues (moisture, cold temperature) and safety parameters for worsening respiratory distress. Exclude improper medication scheduling.","testTakingStrategyZh":"选择有助于舒缓上呼吸道组织的非药物、支持性干预措施（水分、低温）以及针对呼吸困难加重的安全指标。排除不当的给药时间安排。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1081,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_pediatric_diabetes_03","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.816","itemType":"case_study","category":"Physiological Adaptation","topic":"Endocrine & Neurological Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.816.stem.en","stemPathZh":"questions.816.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[172,287],"terminalOffsetsZh":[46,83],"fullStemEn":"Unfolding Case: 8-Year-Old Newly Diagnosed with Type 1 Diabetes An 8-year-old male is admitted to the pediatric unit following a new diagnosis of type 1 diabetes mellitus. He is currently stable, alert, has no ketones in his urine, and is starting insulin therapy and diabetes education.","fullStemZh":"展开式案例：新诊断为1型糖尿病的8岁儿童 一名8岁男孩在新诊断为1型糖尿病后收治于儿科病房。他目前病情平稳、意识清楚、尿酮体阴性，正在开始接受胰岛素治疗和糖尿病教育。","terminalSentenceEn":"He is currently stable, alert, has no ketones in his urine, and is starting insulin therapy and diabetes education.","terminalSentenceZh":"他目前病情平稳、意识清楚、尿酮体阴性，正在开始接受胰岛素治疗和糖尿病教育。","penultimateSentenceEn":"Unfolding Case: 8-Year-Old Newly Diagnosed with Type 1 Diabetes An 8-year-old male is admitted to the pediatric unit following a new diagnosis of type 1 diabetes mellitus.","penultimateSentenceZh":"展开式案例：新诊断为1型糖尿病的8岁儿童 一名8岁男孩在新诊断为1型糖尿病后收治于儿科病房。","responseContext":{},"rationaleCorrectEn":"This case study focuses on the education and safety of pediatric type 1 diabetes, reviewing symptoms of hypoglycemia vs. hyperglycemia, immediate oral glucose treatment guidelines, subQ insulin injection techniques, and safety protocols for physical exercise.","rationaleCorrectZh":"该案例研究重点关注小儿1型糖尿病的教育和安全，审查低血糖与高血糖的症状、立即口服葡萄糖的治疗指南、皮下注射胰岛素的技术以及体育锻炼的安全方案。","testTakingStrategyEn":"Focus on the differentiation of glucose complications and safety protocols during active childhood conditions.","testTakingStrategyZh":"重点关注儿童期活动状态下血糖并发症的区分和安全方案。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1082,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_pediatric_diabetes_03","embeddedQuestionId":"gemini_gap_case_pediatric_diabetes_03_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.816.caseStudy.questions.0","itemType":"select_all","category":"Physiological Adaptation","topic":"Endocrine & Neurological Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.816.caseStudy.questions.0.stem.en","stemPathZh":"questions.816.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[125,147],"terminalOffsetsZh":[28,36],"fullStemEn":"The nurse is teaching the parents about signs of hypoglycemia. Which findings should the parents be instructed to watch for? Select all that apply.","fullStemZh":"护士正在向家长讲解低血糖的体征。应指导家长注意哪些发现？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which findings should the parents be instructed to watch for?","penultimateSentenceZh":"应指导家长注意哪些发现？","responseContext":{"type":"select_all","options":[{"id":"C","en":"Irritability and confusion","zh":"易怒和意识模糊"},{"id":"D","en":"Warm, dry, flushed skin","zh":"皮肤温暖、干燥、潮红"},{"id":"A","en":"Shakiness and trembling","zh":"发抖和震颤"},{"id":"E","en":"Increased urination (polyuria)","zh":"排尿增加（多尿）"},{"id":"B","en":"Diaphoresis (sweating)","zh":"多汗（出汗）"}],"correct":["A","B","C"]},"rationaleCorrectEn":"Shakiness, diaphoresis, irritability, confusion, tachycardia, and headache are classic autonomic and neuroglycopenic signs of hypoglycemia. Warm, dry, flushed skin and polyuria (along with polydipsia and polyphagia) are classic indicators of hyperglycemia, caused by osmotic diuresis and cell dehydration.","rationaleCorrectZh":"发抖、多汗、易怒、意识模糊、心动过速和头痛是低血糖的经典自主神经和脑细胞缺糖体征。皮肤温暖、干燥、潮红和多尿（伴有烦渴和多食）是高血糖的典型指标，由渗透性利尿和细胞脱水引起。","testTakingStrategyEn":"Classify the symptoms of blood sugar fluctuations. Group cold, clammy, and shaky indicators under hypoglycemia; group hot, dry, and frequent urination indicators under hyperglycemia.","testTakingStrategyZh":"对血糖波动的症状进行分类。将湿冷、多汗和发抖指标归入低血糖；将潮红、干燥和多尿指标归入高血糖。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1083,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_pediatric_diabetes_03","embeddedQuestionId":"gemini_gap_case_pediatric_diabetes_03_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.816.caseStudy.questions.1","itemType":"multiple_choice","category":"Physiological Adaptation","topic":"Endocrine & Neurological Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.816.caseStudy.questions.1.stem.en","stemPathZh":"questions.816.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[116,164],"terminalOffsetsZh":[37,51],"fullStemEn":"During a class, the child complains of feeling shaky and lightheaded. His blood glucose is checked and is 62 mg/dL. Which action should the school nurse take first?","fullStemZh":"在上课期间，孩子抱怨感觉发抖和头晕。经检查，他的血糖为 62 mg/dL。学校护士应首先采取哪项措施？","terminalSentenceEn":"Which action should the school nurse take first?","terminalSentenceZh":"学校护士应首先采取哪项措施？","penultimateSentenceEn":"His blood glucose is checked and is 62 mg/dL.","penultimateSentenceZh":"经检查，他的血糖为 62 mg/dL。","responseContext":{"type":"multiple_choice","options":[{"id":"B","en":"Administer the prescribed dose of subcutaneous glucagon","zh":"皮下注射医嘱剂量的胰高血糖素"},{"id":"C","en":"Administer his scheduled bedtime dose of glargine insulin early","zh":"提早给予他计划于睡前使用的甘精胰岛素"},{"id":"A","en":"Give the child 4 ounces (120 mL) of fruit juice or regular soda","zh":"给孩子喝4盎司 (120 mL) 的果汁或普通汽水"},{"id":"D","en":"Instruct the child to lie down and recheck in 30 minutes","zh":"指导孩子躺下并在30分钟后复查"}],"correct":["A"]},"rationaleCorrectEn":"The client is experiencing mild-to-moderate hypoglycemia (defined as blood glucose <70 mg/dL). If the client is conscious and able to swallow, the 'Rule of 15' should be implemented: administer 15 grams of fast-acting simple carbohydrates (such as 4 oz of juice or soda, 3-4 glucose tablets). Subcutaneous glucagon is indicated only for unconscious or non-swallowing clients. Insulin is contraindicated as it would lower blood glucose further. Rechecking should occur in 15 minutes, not 30 minutes, and simple carbs must not be delayed.","rationaleCorrectZh":"该患者正在经历轻中度低血糖（定义为血糖 <70 mg/dL）。如果患者神志清楚且能够吞咽，应执行“15法则”：给予15克快速起效的简单碳水化合物（如4盎司果汁或苏打水，3-4片葡萄糖片）。皮下注射胰高血糖素仅适用于无意识或无法吞咽的患者。胰岛素是禁忌的，因为它会进一步降低血糖。应在15分钟后（而非30分钟）复查，且不可延迟给予简单碳水化合物。","testTakingStrategyEn":"Recognize the 'Rule of 15' for hypoglycemia management. Choose the immediate oral carbohydrate source over delayed checks or invasive emergency injections when the patient is awake and cooperative.","testTakingStrategyZh":"记住治疗低血糖的“15法则”。当患者清醒且配合时，选择立即口服碳水化合物，而不是延迟复查或侵入性紧急注射。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1084,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_pediatric_diabetes_03","embeddedQuestionId":"gemini_gap_case_pediatric_diabetes_03_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.816.caseStudy.questions.2","itemType":"matrix","category":"Physiological Adaptation","topic":"Endocrine & Neurological Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.816.caseStudy.questions.2.stem.en","stemPathZh":"questions.816.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[83,168],"terminalOffsetsZh":[19,46],"fullStemEn":"The nurse is instructing the parents on subcutaneous insulin injection techniques. For each technique, click to specify if it represents correct or incorrect technique.","fullStemZh":"护士正在指导家长皮下注射胰岛素的技术。对于每项技术，点击以指定它是代表正确的还是错误的技术。","terminalSentenceEn":"For each technique, click to specify if it represents correct or incorrect technique.","terminalSentenceZh":"对于每项技术，点击以指定它是代表正确的还是错误的技术。","penultimateSentenceEn":"The nurse is instructing the parents on subcutaneous insulin injection techniques.","penultimateSentenceZh":"护士正在指导家长皮下注射胰岛素的技术。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Rotate insulin injection sites within one anatomical region (e.g., abdomen)","zh":"在同一解剖区域（如腹部）内轮换胰岛素注射部位"},{"id":"r2","en":"Aspirate for blood return before injecting the insulin","zh":"注射胰岛素前抽吸有无回血"},{"id":"r3","en":"Pinch the skin and inject at a 45-degree or 90-degree angle based on subcutaneous tissue thickness","zh":"根据皮下组织厚度捏起皮肤并以45度或90度角注射"}],"columns":[{"id":"c2","en":"Incorrect technique","zh":"错误的操作技术"},{"id":"c1","en":"Correct technique","zh":"正确的操作技术"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]}]},"rationaleCorrectEn":"Rotating sites within one anatomical region (such as using different spots on the abdomen) maintains consistent insulin absorption rates while preventing lipodystrophy. Subcutaneous injections do not require aspiration for blood, as major vessels are not targeted and aspiration increases tissue bruising. Pinching the skin and inserting the needle at 45 to 90 degrees ensures the medication is delivered into the subcutaneous space.","rationaleCorrectZh":"在同一解剖区域内轮换部位（例如使用腹部不同的点）可保持胰岛素吸收率一致，同时预防脂肪营养不良。皮下注射不需要抽吸回血，因为注射靶点不是主要血管，且抽吸会增加组织淤青。捏起皮肤并以 45 至 90 度角刺入针头可确保药物输送到皮下空间。","testTakingStrategyEn":"Use clinical standards for subcutaneous injections. Reject aspiration, and support site rotation and proper angle adjustments.","testTakingStrategyZh":"使用皮下注射的临床标准。拒绝抽吸，支持部位轮换和适当的角度调整。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1085,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_pediatric_diabetes_03","embeddedQuestionId":"gemini_gap_case_pediatric_diabetes_03_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.816.caseStudy.questions.3","itemType":"dropdown_cloze","category":"Physiological Adaptation","topic":"Endocrine & Neurological Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.816.caseStudy.questions.3.stem.en","stemPathZh":"questions.816.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[70,164],"terminalOffsetsZh":[19,40],"fullStemEn":"The nurse is reviewing the exercise and school plan with the parents. Select the appropriate options from the dropdown menus to complete the educational guidelines.","fullStemZh":"护士正在与家长一起审查运动和学校计划。从下拉菜单中选择合适的选项以完成教育指南。","terminalSentenceEn":"Select the appropriate options from the dropdown menus to complete the educational guidelines.","terminalSentenceZh":"从下拉菜单中选择合适的选项以完成教育指南。","penultimateSentenceEn":"The nurse is reviewing the exercise and school plan with the parents.","penultimateSentenceZh":"护士正在与家长一起审查运动和学校计划。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"To manage soccer practice safely, the child should check his blood glucose prior to playing, and if it is under 100 mg/dL, he should {{1}}. The parents should also avoid injecting insulin into the {{2}} before soccer practice.","zh":"为了安全地进行足球训练，孩子应该在运动前检查血糖，如果低于 100 mg/dL，他应该 {{1}}。家长还应避免在足球训练前将胰岛素注射到 {{2}} 中。"},"dropdowns":[{"id":"1","options":[{"id":"o3","en":"cancel his soccer practice for the day","zh":"取消当天的足球训练"},{"id":"o2","en":"administer an extra unit of regular insulin","zh":"加用一个单位的普通胰岛素"},{"id":"o1","en":"eat a 15-gram carbohydrate snack","zh":"吃一份含15克碳水化合物的点心"}],"correct":"o1"},{"id":"2","options":[{"id":"o3","en":"upper arm","zh":"上臂"},{"id":"o2","en":"abdomen","zh":"腹部"},{"id":"o1","en":"thigh","zh":"大腿"}],"correct":"o1"}]},"rationaleCorrectEn":"Exercise increases insulin sensitivity and muscle glucose uptake, causing risk of hypoglycemia. If blood glucose is <100 mg/dL before exercise, a 15g carbohydrate snack must be consumed. Injecting insulin into the subcutaneous tissue of an active limb (the thigh, in a soccer player) increases systemic absorption speed due to increased localized blood flow, triggering rapid-onset hypoglycemia. Abdomen is the preferred site.","rationaleCorrectZh":"运动会增加胰岛素敏感性和肌肉对葡萄糖的吸收，从而导致低血糖的风险。如果运动前血糖 <100 mg/dL，必须吃一份 15 克的碳水化合物零食。将胰岛素注射到活跃肢体的皮下组织中（足球运动员的大腿）会因局部血流增加而加快全身吸收，引发快速起效的低血糖。腹部是首选部位。","testTakingStrategyEn":"Consider the physiologic effects of exercise on insulin absorption. Identify that active limbs absorb insulin faster, and low pre-exercise glucose requires pre-carbohydrate coverage.","testTakingStrategyZh":"考虑运动对胰岛素吸收的生理效应。确定运动的肢体吸收胰岛素更快，且运动前低血糖需要提前补充碳水化合物。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1086,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_cirrhosis_homecare_04","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.817","itemType":"case_study","category":"Physiological Adaptation","topic":"Renal & Gastrointestinal Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.817.stem.en","stemPathZh":"questions.817.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[211,243],"terminalOffsetsZh":[54,61],"fullStemEn":"Unfolding Case: Outpatient Cirrhosis and Ascites Management A 62-year-old male with chronic decompensated cirrhosis secondary to alcoholic hepatitis is seen in the outpatient liver clinic for routine follow-up. He is accompanied by his spouse.","fullStemZh":"展开式案例：门诊肝硬化和腹水管理 一名因酒精性肝炎继发慢性失代偿性肝硬化的62岁男性在肝病门诊接受常规随访。他由配偶陪同。","terminalSentenceEn":"He is accompanied by his spouse.","terminalSentenceZh":"他由配偶陪同。","penultimateSentenceEn":"Unfolding Case: Outpatient Cirrhosis and Ascites Management A 62-year-old male with chronic decompensated cirrhosis secondary to alcoholic hepatitis is seen in the outpatient liver clinic for routine follow-up.","penultimateSentenceZh":"展开式案例：门诊肝硬化和腹水管理 一名因酒精性肝炎继发慢性失代偿性肝硬化的62岁男性在肝病门诊接受常规随访。","responseContext":{},"rationaleCorrectEn":"This case study focuses on outpatient liver cirrhosis care, assessing knowledge of lactulose mechanism of action, home care titration of lactulose, contraindicated pain medications (NSAIDs), and evaluating diuretic (spironolactone) efficacy and potassium safety.","rationaleCorrectZh":"该案例研究重点关注门诊肝硬化护理，评估对乳果糖作用机制、乳果糖的家庭护理剂量调整、禁忌止痛药 (NSAID) 的知识，以及评估利尿剂（螺内酯）效果和钾安全性。","testTakingStrategyEn":"Focus on liver disease complications and safe home-care drug titration and diet restrictions.","testTakingStrategyZh":"重点关注肝脏疾病并发症以及安全居家护理药物剂量调整和饮食限制。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1087,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_cirrhosis_homecare_04","embeddedQuestionId":"gemini_gap_case_cirrhosis_homecare_04_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.817.caseStudy.questions.0","itemType":"multiple_choice","category":"Physiological Adaptation","topic":"Renal & Gastrointestinal Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.817.caseStudy.questions.0.stem.en","stemPathZh":"questions.817.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[64,134],"terminalOffsetsZh":[15,33],"fullStemEn":"The nurse discusses lactulose therapy with the client's spouse. Which statement correctly identifies the primary goal of this therapy?","fullStemZh":"护士与患者配偶讨论乳果糖治疗。哪项陈述正确阐明了该治疗的主要目标？","terminalSentenceEn":"Which statement correctly identifies the primary goal of this therapy?","terminalSentenceZh":"哪项陈述正确阐明了该治疗的主要目标？","penultimateSentenceEn":"The nurse discusses lactulose therapy with the client's spouse.","penultimateSentenceZh":"护士与患者配偶讨论乳果糖治疗。","responseContext":{"type":"multiple_choice","options":[{"id":"B","en":"Eliminate the moderate ascites and reduce abdominal distension","zh":"消除中度腹水并减轻腹胀"},{"id":"C","en":"Provide nutritional carbohydrate supplementation for liver regeneration","zh":"为肝脏再生提供营养性碳水化合物补充"},{"id":"A","en":"Promote ammonia excretion in the stool to prevent encephalopathy","zh":"促进粪便中氨的排出以预防脑病"},{"id":"D","en":"Promote soft stools to prevent bleeding from hemorrhoids","zh":"促进排出软便以预防痔疮出血"}],"correct":["A"]},"rationaleCorrectEn":"The primary therapeutic purpose of lactulose in clients with liver cirrhosis is to prevent or treat hepatic encephalopathy. Lactulose acidifies the colon, converting ammonia (NH3) to ammonium (NH4+), which is trapped in the bowel and excreted in the stool. While it acts as a soft laxative, stool softeners are not the primary goal, and it does not affect ascites (which is managed with diuretics and sodium restriction). It is not given as nutritional supplement.","rationaleCorrectZh":"乳果糖治疗肝硬化患者的首要治疗目的是预防或治疗肝性脑病。乳果糖使结肠酸化，将氨 (NH3) 转化为铵 (NH4+)，后者被滞留在肠道中并通过粪便排出。虽然它具有导泻作用，但软化大便并非首要目标，且它不影响腹水（腹水通过利尿剂和限钠管理）。它不作为营养补充剂给予。","testTakingStrategyEn":"Focus on the specific therapeutic indication for liver cirrhosis. Relate lactulose to ammonia binding and encephalopathy prevention, not general constipation relief.","testTakingStrategyZh":"关注肝硬化的特异性治疗指征。将乳果糖与氨结合和脑病预防联系起来，而不是普通便秘的缓解。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1088,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_cirrhosis_homecare_04","embeddedQuestionId":"gemini_gap_case_cirrhosis_homecare_04_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.817.caseStudy.questions.1","itemType":"dropdown_cloze","category":"Physiological Adaptation","topic":"Renal & Gastrointestinal Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.817.caseStudy.questions.1.stem.en","stemPathZh":"questions.817.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[70,160],"terminalOffsetsZh":[19,40],"fullStemEn":"The nurse responds to the telehealth update from the client's spouse. Select the appropriate options from the dropdown menus to complete the nursing directions.","fullStemZh":"护士对患者配偶的电话随访更新做出回应。从下拉菜单中选择合适的选项以完成护理指导。","terminalSentenceEn":"Select the appropriate options from the dropdown menus to complete the nursing directions.","terminalSentenceZh":"从下拉菜单中选择合适的选项以完成护理指导。","penultimateSentenceEn":"The nurse responds to the telehealth update from the client's spouse.","penultimateSentenceZh":"护士对患者配偶的电话随访更新做出回应。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"In response to the spouse's report during the telehealth call, the nurse should instruct the spouse to {{1}} and monitor the client closely for {{2}}.","zh":"针对电话随访中配偶的报告，护士应指导配偶 {{1}} 并密切监测患者是否出现 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o2","en":"stop the lactulose completely until the cramping resolves","zh":"完全停用乳果糖直至绞痛缓解"},{"id":"o1","en":"contact the provider or follow prescribed titration parameters to reduce lactulose to the goal of 2 to 3 soft stools per day","zh":"联系医生或按照医嘱的滴定参数减少乳果糖，以达到每天排2至3次软便的目标"},{"id":"o3","en":"double the lactulose dose to ensure all ammonia is excreted","zh":"将乳果糖剂量加倍以确保所有氨排出"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"constipation and bowel obstruction","zh":"便秘和肠梗阻"},{"id":"o3","en":"fluid volume overload and peripheral edema","zh":"体液量超负荷和周围性水肿"},{"id":"o1","en":"dehydration and hypokalemia","zh":"脱水和低钾血症"}],"correct":"o1"}]},"rationaleCorrectEn":"Lactulose dosage should be adjusted (titrated) to achieve 2 to 3 soft, formed stools per day. Having 5 to 6 watery stools per day represents excessive dosing/diarrhea, which can lead to severe dehydration and hypokalemia (exacerbated by concurrently taking spironolactone). The medication must not be stopped completely because ammonia levels will quickly rebound, risking hepatic coma. Doubling the dose would worsen the diarrhea.","rationaleCorrectZh":"乳果糖剂量应进行调整（滴定），以达到每天排出2至3次松软、成形大便。每天排便5至6次水样便代表给药过量/腹泻，这可能导致严重的脱水和低钾血症（同时服用螺内酯会加剧这一情况）。绝不能完全停用该药，因为血氨水平会迅速反弹，存在发生肝昏迷的风险。剂量加倍会加重腹泻。","testTakingStrategyEn":"Analyze the dosing rules for lactulose: the target is 2-3 soft stools per day. Watery diarrhea requires dose reduction (not drug cessation) to prevent dehydration while maintaining ammonia clearance.","testTakingStrategyZh":"分析乳果糖的给药规则：目标是每天2-3次软便。水样腹泻需要减少剂量（而不是停药），以防脱水同时维持氨清除。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1089,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_cirrhosis_homecare_04","embeddedQuestionId":"gemini_gap_case_cirrhosis_homecare_04_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.817.caseStudy.questions.2","itemType":"select_all","category":"Physiological Adaptation","topic":"Renal & Gastrointestinal Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.817.caseStudy.questions.2.stem.en","stemPathZh":"questions.817.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[132,154],"terminalOffsetsZh":[33,41],"fullStemEn":"The nurse is providing dietary and lifestyle teaching to the client and his spouse. Which recommendations should the nurse include? Select all that apply.","fullStemZh":"护士正在向患者及其配偶提供饮食和生活方式指导。护士应包括哪些建议？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which recommendations should the nurse include?","penultimateSentenceZh":"护士应包括哪些建议？","responseContext":{"type":"select_all","options":[{"id":"C","en":"Use ibuprofen as needed for abdominal or back discomfort.","zh":"必要时使用布洛芬缓解腹部或背部不适。"},{"id":"A","en":"Restrict dietary sodium intake to less than 2,000 mg daily.","zh":"将膳食钠摄入量限制在每天少于2,000毫克。"},{"id":"B","en":"Weigh daily at the same time and report a gain of >3 lbs (1.4 kg) in a day.","zh":"每天在同一时间称体重，并报告一天内体重增加超过3磅 (1.4 kg)。"},{"id":"E","en":"Sleep with the head of the bed elevated (semi-Fowler's position).","zh":"睡觉时抬高床头（半卧位）。"},{"id":"D","en":"Completely avoid alcohol intake.","zh":"完全避免饮酒。"}],"correct":["A","B","D","E"]},"rationaleCorrectEn":"Sodium restriction (<2g daily) and daily weights are critical for managing fluid retention (ascites and edema). Absolute alcohol avoidance is mandatory to prevent further liver insult. Semi-Fowler's position relieves diaphragm pressure caused by moderate ascites, improving breathing comfort. NSAIDs like ibuprofen must be completely avoided in cirrhosis clients because they increase bleeding risk (due to underlying coagulopathy/varices) and can precipitate acute kidney injury (hepatorenal syndrome) via renal vasoconstriction.","rationaleCorrectZh":"限制钠盐（每天 <2克）和每日称体重对于管理液体潴留（腹水和水肿）至关重要。必须绝对避免饮酒，以防进一步损伤肝脏。半卧位可以减轻由中度腹水引起的膈肌受压，提高呼吸舒适度。肝硬化患者必须完全避免使用布洛芬等非甾体抗炎药 (NSAID)，因为它们会增加出血风险（由于潜在的凝血功能障碍/静脉曲张），并可能通过肾脏血管收缩促发急性肾损伤（肝肾综合征）。","testTakingStrategyEn":"Recall safety contraindications in liver disease. Recognize that NSAIDs (such as ibuprofen) pose severe renal and bleeding hazards in cirrhosis, and select fluid-management and hepatic safety options.","testTakingStrategyZh":"回忆肝脏疾病的安全禁忌证。认识到非甾体抗炎药（如布洛芬）在肝硬化中会带来严重的肾脏和出血危险，选择液体管理和肝脏安全选项。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1090,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_cirrhosis_homecare_04","embeddedQuestionId":"gemini_gap_case_cirrhosis_homecare_04_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.817.caseStudy.questions.3","itemType":"matrix","category":"Physiological Adaptation","topic":"Renal & Gastrointestinal Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.817.caseStudy.questions.3.stem.en","stemPathZh":"questions.817.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[97,209],"terminalOffsetsZh":[23,56],"fullStemEn":"The nurse is evaluating the clinical efficacy and safety of the client's spironolactone therapy. For each finding, click to specify if it is an expected outcome of the therapy or an unexpected/adverse outcome.","fullStemZh":"护士正在评估患者螺内酯治疗的临床疗效和安全性。对于每个发现，点击以指定它是该治疗的预期结果还是非预期/不良结果。","terminalSentenceEn":"For each finding, click to specify if it is an expected outcome of the therapy or an unexpected/adverse outcome.","terminalSentenceZh":"对于每个发现，点击以指定它是该治疗的预期结果还是非预期/不良结果。","penultimateSentenceEn":"The nurse is evaluating the clinical efficacy and safety of the client's spironolactone therapy.","penultimateSentenceZh":"护士正在评估患者螺内酯治疗的临床疗效和安全性。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Decreased abdominal girth and decreased ankle edema","zh":"腹围减少且踝部水肿减轻"},{"id":"r2","en":"Serum potassium level of 2.9 mEq/L","zh":"血清钾水平为 2.9 mEq/L"},{"id":"r3","en":"Daily weight loss of 0.5 to 1.0 lb (0.23 to 0.45 kg)","zh":"每日体重减轻 0.5至1.0磅 (0.23至0.45 kg)"}],"columns":[{"id":"c1","en":"Expected outcome of spironolactone therapy","zh":"螺内酯治疗的预期结果"},{"id":"c2","en":"Unexpected/adverse outcome","zh":"非预期/不良结果"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]}]},"rationaleCorrectEn":"Spironolactone is a potassium-sparing aldosterone antagonist used as a primary diuretic for ascites. Expected therapeutic outcomes include decreased abdominal girth, reduced peripheral edema, and a gradual weight loss (0.5 to 1.0 lb daily to prevent intravascular depletion). A potassium level of 2.9 mEq/L represents severe hypokalemia, which is an unexpected adverse event because spironolactone spares potassium (hyperkalemia is the typical drug risk, although concurrent lactulose diarrhea could cause hypokalemia, it remains an adverse finding requiring correction).","rationaleCorrectZh":"螺内酯是一种保钾型醛固酮拮抗剂，用作腹水的主要利尿剂。预期的治疗结果包括腹围减少、外周水肿减轻以及逐渐的体重减轻（每天减轻0.5至1.0磅，以防止血管内液体耗竭）。钾水平为 2.9 mEq/L 代表严重的低钾血症，这是一项非预期的不良事件，因为螺内酯是保钾的（高钾血症是典型的药物风险，尽管同时发生乳果糖引起的腹泻可能导致低钾血症，但它仍属需要纠正的不良发现）。","testTakingStrategyEn":"Understand the pharmacology of potassium-sparing diuretics. Spironolactone spares potassium and excretes sodium and water. Expect weight loss and decreased edema, while flagging hypokalemia as an abnormal adverse finding.","testTakingStrategyZh":"理解保钾利尿剂的药理学。螺内酯保钾并排钠排水。预期体重减轻和水肿减轻，同时将低钾血症标记为异常不良发现。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1091,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_chronic_hf_05","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.818","itemType":"case_study","category":"Physiological Adaptation","topic":"Cardiovascular Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.818.stem.en","stemPathZh":"questions.818.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,220],"terminalOffsetsZh":[0,64],"fullStemEn":"Unfolding Case: Outpatient Congestive Heart Failure Management A 68-year-old female with a history of chronic heart failure with reduced ejection fraction (HFrEF) is seen in the cardiology clinic for a routine follow-up.","fullStemZh":"展开式案例：门诊充血性心力衰竭管理 一名有射血分数降低的慢性心力衰竭 (HFrEF) 病史的68岁女性在心内科诊所接受常规随访。","terminalSentenceEn":"Unfolding Case: Outpatient Congestive Heart Failure Management A 68-year-old female with a history of chronic heart failure with reduced ejection fraction (HFrEF) is seen in the cardiology clinic for a routine follow-up.","terminalSentenceZh":"展开式案例：门诊充血性心力衰竭管理 一名有射血分数降低的慢性心力衰竭 (HFrEF) 病史的68岁女性在心内科诊所接受常规随访。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This unfolding case study reviews outpatient heart failure care, testing the sensitivity of weight monitoring, terminology of orthopnea and diuretic dosing, contraindications of NSAIDs in heart failure, and discharge guidelines on when to report worsening symptoms.","rationaleCorrectZh":"该展开式案例研究审查了门诊心力衰竭护理，测试了体重监测的敏感性、端坐呼吸的术语和利尿剂给药、非甾体抗炎药在心衰中的禁忌证，以及关于何时报告症状恶化的出院指导。","testTakingStrategyEn":"Focus on heart failure safety monitoring, loop-diuretic mechanisms, and NSAID contraindications.","testTakingStrategyZh":"重点关注心力衰竭安全监测、袢利尿剂机制以及非甾体抗炎药禁忌证。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1092,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_chronic_hf_05","embeddedQuestionId":"gemini_gap_case_chronic_hf_05_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.818.caseStudy.questions.0","itemType":"multiple_choice","category":"Physiological Adaptation","topic":"Cardiovascular Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.818.caseStudy.questions.0.stem.en","stemPathZh":"questions.818.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,106],"terminalOffsetsZh":[0,26],"fullStemEn":"Which finding from the telehealth call is the most sensitive indicator of worsening fluid volume overload?","fullStemZh":"电话随访中的哪项发现是体液量超负荷加重的最敏感指标？","terminalSentenceEn":"Which finding from the telehealth call is the most sensitive indicator of worsening fluid volume overload?","terminalSentenceZh":"电话随访中的哪项发现是体液量超负荷加重的最敏感指标？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"B","en":"Shortness of breath when walking around the house","zh":"在屋里走动时呼吸困难"},{"id":"A","en":"Weight gain of 4.5 lbs (2.0 kg) over 2 days","zh":"2天内体重增加4.5磅 (2.0 kg)"},{"id":"D","en":"Absence of chest pain","zh":"无胸痛"},{"id":"C","en":"Having to sleep on 3 pillows (orthopnea)","zh":"不得不垫3个枕头睡觉（端坐呼吸）"}],"correct":["A"]},"rationaleCorrectEn":"Daily weight tracking is the most sensitive and objective clinical indicator of fluid volume status in heart failure. A weight gain of >3 lbs (1.4 kg) in 2-5 days or >2 lbs (0.9 kg) in 24 hours indicates fluid accumulation and congestion before major symptoms (like severe dyspnea or peripheral edema) become overt. Dyspnea and orthopnea are symptoms of this accumulation, but weight gain is the most sensitive indicator.","rationaleCorrectZh":"每日体重追踪是心力衰竭患者体液量状态最敏感和客观的临床指标。在2-5天内体重增加 >3磅 (1.4 kg) 或在24小时内增加 >2磅 (0.9 kg) 提示在主要症状（如严重呼吸困难或外周水肿）变得明显之前就存在液体积聚和淤血。呼吸困难和端坐呼吸是这种积聚的症状，但体重增加是最敏感的指标。","testTakingStrategyEn":"Look for objective, quantifiable metrics for fluid monitoring. Weight is the most sensitive and earliest detector of fluid balance changes compared to subjective breathing complaints.","testTakingStrategyZh":"寻找用于液体监测的客观、可量化的指标。与主观呼吸诉求相比，体重是液体平衡变化最敏感和最早的检测指标。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1093,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_chronic_hf_05","embeddedQuestionId":"gemini_gap_case_chronic_hf_05_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.818.caseStudy.questions.1","itemType":"dropdown_cloze","category":"Physiological Adaptation","topic":"Cardiovascular Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.818.caseStudy.questions.1.stem.en","stemPathZh":"questions.818.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[93,194],"terminalOffsetsZh":[20,44],"fullStemEn":"The nurse is evaluating the symptoms reported by the client during the telehealth encounter. Select the appropriate options from the dropdown menus to complete the clinical summary and planning.","fullStemZh":"护士正在评估患者在电话随访中报告的症状。从下拉菜单中选择合适的选项以完成临床总结和计划。","terminalSentenceEn":"Select the appropriate options from the dropdown menus to complete the clinical summary and planning.","terminalSentenceZh":"从下拉菜单中选择合适的选项以完成临床总结和计划。","penultimateSentenceEn":"The nurse is evaluating the symptoms reported by the client during the telehealth encounter.","penultimateSentenceZh":"护士正在评估患者在电话随访中报告的症状。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The client is experiencing a heart failure exacerbation characterized by pulmonary congestion, which has led to {{1}}. The nurse should anticipate an order to {{2}}.","zh":"该患者正在经历以肺淤血为特征的心力衰竭恶化，这导致了 {{1}}。护士应预料到会有 {{2}} 的医嘱。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"orthopnea","zh":"端坐呼吸"},{"id":"o3","en":"bronchospasm","zh":"支气管痉挛"},{"id":"o2","en":"hyperventilation syndrome","zh":"过度通气综合征"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"discontinue lisinopril therapy","zh":"停用赖诺普利治疗"},{"id":"o3","en":"administer a beta-blocker bolus","zh":"给予β受体阻滞剂静脉推注"},{"id":"o1","en":"increase the furosemide dosage","zh":"增加呋塞米的剂量"}],"correct":"o1"}]},"rationaleCorrectEn":"Sleeping on multiple pillows due to dyspnea when lying flat is orthopnea, caused by increased venous return to the heart in a recumbent position, worsening pulmonary congestion. The standard intervention for fluid overload exacerbation is increasing loop diuretic (furosemide) dosing to promote fluid clearance. Discontinuing lisinopril would increase afterload and worsen HF. Beta-blockers must not be bolused during acute decompensation as they decrease myocardial contractility.","rationaleCorrectZh":"由于平卧时呼吸困难而需要垫多个枕头睡觉称为端坐呼吸，这是由于卧位时回心静脉血量增加，加重了肺淤血。针对体液超负荷恶化的标准干预措施是增加袢利尿剂（呋塞米）的剂量以促进液体排出。停用赖诺普利会增加后负荷并加重心力衰竭。在急性失代偿期间禁止静脉推注β受体阻滞剂，因为它们会降低心肌收缩力。","testTakingStrategyEn":"Define clinical terms. Connect breathing difficulty when lying flat to orthopnea, and select loop diuretics to clear excess fluid.","testTakingStrategyZh":"定义临床术语。将平卧时呼吸困难与端坐呼吸联系起来，并选择袢利尿剂以清除多余的液体。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1094,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_chronic_hf_05","embeddedQuestionId":"gemini_gap_case_chronic_hf_05_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.818.caseStudy.questions.2","itemType":"matrix","category":"Physiological Adaptation","topic":"Cardiovascular Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.818.caseStudy.questions.2.stem.en","stemPathZh":"questions.818.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[57,161],"terminalOffsetsZh":[18,48],"fullStemEn":"The nurse is planning care and teaching for this client. For each intervention, click to specify if it is appropriate/indicated or inappropriate/contraindicated.","fullStemZh":"护士正在为该患者制定护理和指导计划。对于每项干预措施，点击以指定它是合适/适用还是不合适/禁用。","terminalSentenceEn":"For each intervention, click to specify if it is appropriate/indicated or inappropriate/contraindicated.","terminalSentenceZh":"对于每项干预措施，点击以指定它是合适/适用还是不合适/禁用。","penultimateSentenceEn":"The nurse is planning care and teaching for this client.","penultimateSentenceZh":"护士正在为该患者制定护理和指导计划。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Initiate daily weight monitoring using the same scale and same clothing type","zh":"开始每日体重监测，使用相同的体重秤和相同类型的衣服"},{"id":"r2","en":"Administer ibuprofen 400 mg orally as needed for chronic joint pain","zh":"必要时口服布洛芬 400 mg 治疗慢性关节痛"},{"id":"r3","en":"Adhere to a low-sodium diet (<2,000 mg/day)","zh":"坚持低钠饮食（<2,000 毫克/天）"}],"columns":[{"id":"c1","en":"Appropriate/indicated","zh":"合适/适用"},{"id":"c2","en":"Inappropriate/contraindicated","zh":"不合适/禁用"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]}]},"rationaleCorrectEn":"Daily weight tracking and maintaining low sodium intake are fundamental indicated components of heart failure self-management. NSAIDs like ibuprofen are strictly contraindicated in heart failure patients because they inhibit prostaglandin synthesis, leading to renal vasoconstriction, sodium and water retention, and worsening of heart failure decompensation. Acetaminophen is a safer alternative.","rationaleCorrectZh":"每日体重追踪和保持低钠摄入是心力衰竭自我管理的基本适用部分。非甾体抗炎药（如布洛芬）在心力衰竭患者中属于绝对禁忌，因为它们会抑制前列腺素合成，导致肾血管收缩、水钠潴留并加重心力衰竭失代偿。对乙酰氨基酚是更安全的替代药物。","testTakingStrategyEn":"Recall the class-specific drug contraindications for heart failure. Recognize that NSAIDs pose renal-compromise and fluid-retention risks, and classify them as contraindicated.","testTakingStrategyZh":"回忆心力衰竭的类特异性药物禁忌证。认识到非甾体抗炎药存在肾功能受损和水钠潴留风险，并将其分类为禁用。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1095,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_case_chronic_hf_05","embeddedQuestionId":"gemini_gap_case_chronic_hf_05_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.818.caseStudy.questions.3","itemType":"select_all","category":"Physiological Adaptation","topic":"Cardiovascular Disorders","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.818.caseStudy.questions.3.stem.en","stemPathZh":"questions.818.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[149,171],"terminalOffsetsZh":[38,46],"fullStemEn":"The nurse is providing discharge teaching to the client. Which instructions should the nurse include regarding when to call the healthcare provider? Select all that apply.","fullStemZh":"护士正在向患者提供出院指导。关于何时致电医疗保健提供者，护士应包括哪些说明？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which instructions should the nurse include regarding when to call the healthcare provider?","penultimateSentenceZh":"关于何时致电医疗保健提供者，护士应包括哪些说明？","responseContext":{"type":"select_all","options":[{"id":"D","en":"Frequent dizziness or lightheadedness when standing up.","zh":"起立时经常感到头晕或头轻。"},{"id":"A","en":"Weight gain of 3 lbs (1.4 kg) in a single day or 5 lbs (2.3 kg) in a week.","zh":"单天体重增加 3 磅 (1.4 kg) 或一周内增加 5 磅 (2.3 kg)。"},{"id":"B","en":"Development of dry, hacking cough that is new and persistent.","zh":"新出现且持续的干咳、无痰咳嗽。"},{"id":"C","en":"Increased swelling of the ankles, feet, or abdomen.","zh":"踝部、足部或腹部肿胀加重。"},{"id":"E","en":"Expectation of mild, occasional muscle cramps in the calves.","zh":"出现轻度、偶尔的小腿肌肉痉挛。"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"Warning signs of worsening HF requiring provider notification include rapid weight gain (fluid retention), dry hacking cough (suggests pulmonary congestion or side effect of Lisinopril), worsening peripheral edema or ascites, and orthostatic dizziness (suggesting hypotension or dehydration from excessive diuretics). Calf muscle cramps are a non-specific symptom, although sometimes related to hypokalemia from loop diuretics, they are not a primary scheduled notification parameter compared to the major signs of cardiovascular collapse or lisinopril cough.","rationaleCorrectZh":"心力衰竭加重需要通知医生的警示体征包括体重快速增加（水钠潴留）、干咳无痰（提示肺淤血或赖诺普利的副作用）、外周水肿或腹水加重以及直立性头晕（提示低血压或利尿剂过量导致的脱水）。小腿肌肉痉挛是非特异性症状，虽然有时与袢利尿剂引起的低钾血症有关，但与心血管崩溃的主要征象或赖诺普利引起的咳嗽相比，它不是首要的必须通知参数。","testTakingStrategyEn":"Select parameters that directly monitor fluid overload status (weight, edema, cough indicating pulmonary congestion) or drug side effects (dizziness, cough). Exclude minor symptoms like calf cramps.","testTakingStrategyZh":"选择直接监测液体超负荷状态（体重、水肿、提示肺淤血的咳嗽）或药物副作用（头晕、咳嗽）的参数。排除小腿痉挛等次要症状。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1096,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_hl_pancreatitis_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.819","itemType":"highlight","category":"Physiological Adaptation","topic":"Renal & Gastrointestinal Disorders","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.819.stem.en","stemPathZh":"questions.819.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,93],"terminalOffsetsZh":[0,19],"fullStemEn":"Highlight the findings in the admission record that require immediate follow-up by the nurse.","fullStemZh":"标出入院记录中需要护士立即跟进的发现。","terminalSentenceEn":"Highlight the findings in the admission record that require immediate follow-up by the nurse.","terminalSentenceZh":"标出入院记录中需要护士立即跟进的发现。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"Admission Note: A 42-year-old male presents with severe, boring epigastric pain radiating to his back.","zh":"入院记录：一名42岁男性出现严重的、穿透样上腹部疼痛，放射至背部。"},{"id":"s2","en":"Blood pressure is 88/54 mmHg,","zh":"血压为 88/54 mmHg，","selectable":true},{"id":"s3","en":"heart rate is 124 bpm,","zh":"心率为 124次/分，","selectable":true},{"id":"s4","en":"temperature is 99.0 °F (37.2 °C),","zh":"体温为 99.0 °F (37.2 °C)，","selectable":true},{"id":"s5","en":"and urine output is 15 mL over the past 2 hours.","zh":"且过去2小时的尿量为15毫升。","selectable":true},{"id":"s6","en":"He has a history of alcohol use disorder. On physical examination, the nurse notes","zh":"他有酒精使用障碍史。体格检查中，护士注意到"},{"id":"s7","en":"hypoactive bowel sounds in all quadrants.","zh":"所有象限肠鸣音减弱。","selectable":true}],"correct":["s2","s3","s5"]}},"rationaleCorrectEn":"The client is showing signs of hypovolemic shock (hypotension, tachycardia) and acute kidney injury / hypoperfusion (oliguria, defined as <0.5 mL/kg/hr or <30 mL/hr) secondary to third-spacing of fluids in acute pancreatitis. These hemodynamic parameters require immediate aggressive fluid resuscitation. Mild temperature elevation (99.0 °F (37.2 °C)) is expected due to the systemic inflammatory response in pancreatitis and does not require immediate intervention. Hypoactive bowel sounds are also common and expected in acute pancreatitis due to localized paralytic ileus secondary to abdominal inflammation, and are not an emergency priority compared to cardiovascular collapse.","rationaleCorrectZh":"患者表现出继发于急性胰腺炎液体第三间隙积聚的低血容量性休克（低血压、心动过速）和急性肾损伤/灌注不足（少尿，定义为 <0.5 mL/kg/h 或 <30 mL/h）体征。这些血流动力学指标需要立即进行积极的液体复苏。由于胰腺炎的全身炎症反应，体温轻度升高 (99.0 °F (37.2 °C)) 是预料之中的，不需要立即干预。由于继发于腹部炎症的局限性麻痹性肠梗阻，肠鸣音减弱在急性胰腺炎中也很常见且符合预期，与心血管崩溃相比，这不是紧急优先事项。","testTakingStrategyEn":"Prioritize ABCs (Airway, Breathing, and Circulation). Look for indications of hypovolemia and shock (hypotension, tachycardia, oliguria) in patients with acute pancreatitis, distinguishing them from expected inflammatory findings (mild fever, hypoactive bowel sounds).","testTakingStrategyZh":"优先考虑ABCs（气道、呼吸和循环）。在急性胰腺炎患者中寻找血容量不足和休克的迹象（低血压、心动过速、少尿），并与预期的炎症表现（轻度发热、肠鸣音减弱）进行区分。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1097,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_hl_myasthenia_crisis_02","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.820","itemType":"highlight","category":"Physiological Adaptation","topic":"Endocrine & Neurological Disorders","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.820.stem.en","stemPathZh":"questions.820.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,149],"terminalOffsetsZh":[0,33],"fullStemEn":"Highlight the findings in the nursing assessment that indicate the client is developing a myasthenic crisis and requires immediate airway protection.","fullStemZh":"标出护理评估中表明患者正在发生肌无力危象并需要立即气道保护的发现。","terminalSentenceEn":"Highlight the findings in the nursing assessment that indicate the client is developing a myasthenic crisis and requires immediate airway protection.","terminalSentenceZh":"标出护理评估中表明患者正在发生肌无力危象并需要立即气道保护的发现。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"Nursing Assessment: The client is a 45-year-old female with a history of myasthenia gravis.","zh":"护理评估：患者为45岁女性，有重症肌无力病史。"},{"id":"s2","en":"She presents with bilateral ptosis and facial muscle weakness.","zh":"她表现出双侧眼睑下垂和面部肌肉无力。","selectable":true},{"id":"s3","en":"She has a weak cough effort and is unable to clear her secretions.","zh":"她的咳嗽无力，无法排出分泌物。","selectable":true},{"id":"s4","en":"Her oxygen saturation is 88% on room air,","zh":"她在室内空气下的血氧饱和度为88%，","selectable":true},{"id":"s5","en":"and her respirations are shallow with accessory muscle use.","zh":"且她的呼吸浅快，伴有辅助呼吸肌的使用。","selectable":true},{"id":"s6","en":"She reports having","zh":"她报告有"},{"id":"s7","en":"generalized muscle weakness that worsens in the evening.","zh":"在傍晚加重的全身肌肉无力。","selectable":true}],"correct":["s3","s4","s5"]}},"rationaleCorrectEn":"Myasthenic crisis is a life-threatening complication of myasthenia gravis characterized by severe respiratory muscle weakness. Indicative findings include a weak cough and inability to clear secretions (bulbar weakness, risking aspiration and airway obstruction), low oxygen saturation (88%), and shallow breathing with accessory muscle use (signs of impending respiratory failure). Ptosis and generalized weakness that worsens in the evening are classic, baseline findings of myasthenia gravis and do not indicate acute respiratory crisis requiring immediate intubation or airway protection.","rationaleCorrectZh":"肌无力危象是重症肌无力的一种危及生命的并发症，以严重的呼吸肌无力为特征。提示性的发现包括咳嗽无力和无法清除分泌物（延髓无力，存在误吸和气道阻塞的风险）、血氧饱和度低 (88%) 以及伴有辅助呼吸肌使用的浅慢呼吸（呼吸衰竭先兆体征）。眼睑下垂和在傍晚加重的全身无力是重症肌无力的经典、基线表现，并不提示需要立即插管或气道保护的急性呼吸危象。","testTakingStrategyEn":"Differentiate between chronic baseline symptoms of a neurological disorder (such as ptosis and fluctuating weakness in myasthenia gravis) and acute, life-threatening complications affecting the airway and ventilation (such as weak cough, hypoxia, and respiratory accessory muscle use).","testTakingStrategyZh":"区分神经系统疾病的慢性基线症状（如重症肌无力的眼睑下垂和波动性无力）与影响气道和通气的急性、危及生命的并发症（如咳嗽无力、缺氧和呼吸辅助肌使用）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1098,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_hl_pulmonary_embolism_03","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.821","itemType":"highlight","category":"Physiological Adaptation","topic":"Respiratory & Infectious Disorders","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.821.stem.en","stemPathZh":"questions.821.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,140],"terminalOffsetsZh":[0,27],"fullStemEn":"Highlight the findings in the emergency department note that indicate a high risk for pulmonary embolism and require immediate intervention.","fullStemZh":"标出急诊科记录中提示肺栓塞高风险并需要立即干预的发现。","terminalSentenceEn":"Highlight the findings in the emergency department note that indicate a high risk for pulmonary embolism and require immediate intervention.","terminalSentenceZh":"标出急诊科记录中提示肺栓塞高风险并需要立即干预的发现。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"ED Record: A 64-year-old female presents with acute onset of shortness of breath.","zh":"急诊记录：一名64岁女性出现急性起病的呼吸困难。"},{"id":"s2","en":"She reports sharp chest pain that worsens on deep inspiration.","zh":"她报告尖锐的胸痛，深吸气时加重。","selectable":true},{"id":"s3","en":"She underwent a total hip arthroplasty 10 days ago.","zh":"她于10天前接受了全髋关节置换术。","selectable":true},{"id":"s4","en":"She reports having a dry cough for the last two days.","zh":"她报告过去两天有干咳。","selectable":true},{"id":"s5","en":"On examination, she has unilateral left calf swelling and warmth.","zh":"体格检查发现她有单侧左小腿肿胀和发热。","selectable":true},{"id":"s6","en":"Her vitals are: blood pressure 118/74 mmHg, heart rate 98 bpm,","zh":"她的生命体征为：血压 118/74 mmHg，心率 98次/分，"},{"id":"s7","en":"and temperature 98.9 °F (37.2 °C).","zh":"体温为 98.9 °F (37.2 °C)。","selectable":true}],"correct":["s2","s3","s5"]}},"rationaleCorrectEn":"The client is demonstrating critical risk factors and symptoms of a pulmonary embolism (PE). Recent major orthopedic surgery (total hip arthroplasty) is a major risk factor due to immobility and blood vessel trauma. Pleuritic chest pain (sharp pain worsening on inspiration) is a classic symptom of PE. Unilateral calf swelling and warmth suggest a deep vein thrombosis (DVT), which is the primary source of PE. Dry cough and a normal/slightly high temperature (98.9 °F (37.2 °C)) are non-specific findings that do not carry the same immediate diagnostic or safety weight for pulmonary embolism.","rationaleCorrectZh":"患者表现出肺栓塞 (PE) 的关键风险因素和症状。由于活动受限和血管创伤，近期的重大骨科手术（全髋关节置换术）是一个主要的风险因素。胸膜炎性胸痛（深吸气时加重的剧烈疼痛）是肺栓塞的典型症状。单侧小腿肿胀和发热提示深静脉血栓形成 (DVT)，这是肺栓塞的主要来源。干咳和正常/稍高体温 (98.9 °F (37.2 °C)) 是非特异性发现，不具有用于判断肺栓塞的同样紧迫的诊断或安全意义。","testTakingStrategyEn":"Connect orthopedic surgery history with Virchow's triad (venous stasis, hypercoagulability, endothelial injury). Select the risk factors and specific findings that point to DVT/PE (pleuritic chest pain, orthopedic surgery history, unilateral calf swelling).","testTakingStrategyZh":"将骨科手术史与维尔肖三联征（静脉血流滞缓、高凝状态、血管内皮损伤）联系起来。选择指向DVT/PE的风险因素和特异性发现（胸膜炎性胸痛、骨科手术史、单侧小腿肿胀）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1099,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_hl_cardiac_tamponade_04","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.822","itemType":"highlight","category":"Physiological Adaptation","topic":"Cardiovascular Disorders","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.822.stem.en","stemPathZh":"questions.822.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,108],"terminalOffsetsZh":[0,23],"fullStemEn":"Highlight the findings in the post-pericardiocentesis note that suggest the recurrence of cardiac tamponade.","fullStemZh":"标出心包穿刺术后记录中提示心包填塞复发的发现。","terminalSentenceEn":"Highlight the findings in the post-pericardiocentesis note that suggest the recurrence of cardiac tamponade.","terminalSentenceZh":"标出心包穿刺术后记录中提示心包填塞复发的发现。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"Post-Procedure Note: The client is 12 hours post-pericardiocentesis for pericardial effusion. On assessment, the nurse notes:","zh":"术后记录：患者心包积液心包穿刺术后12小时。评估时，护士注意到："},{"id":"s2","en":"Blood pressure is 90/60 mmHg (down from 122/80 mmHg),","zh":"血压为 90/60 mmHg（自 122/80 mmHg 下降），","selectable":true},{"id":"s3","en":"distended jugular veins are visible at 45 degrees elevation,","zh":"抬高45度时可见颈静脉怒张，","selectable":true},{"id":"s4","en":"heart sounds are muffled and distant on auscultation,","zh":"听诊心音遥远且低钝，","selectable":true},{"id":"s5","en":"heart rate is 92 bpm (up from 88 bpm),","zh":"心率为 92次/分（自 88次/分上升），","selectable":true},{"id":"s6","en":"and the client reports","zh":"且患者报告"},{"id":"s7","en":"mild localized pain at the needle insertion site graded 3/10.","zh":"针刺部位有轻度局限性疼痛，评分 3/10。","selectable":true}],"correct":["s2","s3","s4"]}},"rationaleCorrectEn":"The three correct findings (hypotension, jugular venous distention, and muffled heart sounds) constitute Beck's triad, which is the classic sign of cardiac tamponade recurrence. Accumulating fluid in the pericardial sac compresses the heart, preventing venous return (causing jugular venous distention) and ventricular filling (causing hypotension/decreased cardiac output), while the fluid insulates the heart sounds (making them muffled). Heart rate of 92 bpm and mild insertion site pain of 3/10 are normal and expected post-procedural findings that do not suggest tamponade recurrence.","rationaleCorrectZh":"这三个正确的发现（低血压、颈静脉怒张和心音遥远）构成了贝克三联征，这是心包填塞复发的典型体征。心包腔内积聚的液体压迫心脏，阻止静脉回流（引起颈静脉怒张）和心室充盈（引起低血压/心输出量减少），同时液体阻隔了心音（使心音遥远低钝）。心率92次/分和穿刺部位3/10的轻度疼痛是正常的术后预期表现，并不提示填塞复发。","testTakingStrategyEn":"Recall Beck's triad of cardiac tamponade: hypotension, jugular venous distention, and muffled heart sounds. Select these three findings from the assessment list while excluding expected, non-specific findings (such as mild site pain and borderline normal heart rate).","testTakingStrategyZh":"回想心包填塞的贝克三联征：低血压、颈静脉怒张和心音遥远低钝。从评估列表中选择这三个发现，同时排除预期的非特异性发现（如轻微部位疼痛和边界线正常的心率）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1100,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gap_hl_hypocalcemia_05","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.823","itemType":"highlight","category":"Physiological Adaptation","topic":"Electrolyte Imbalances","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.823.stem.en","stemPathZh":"questions.823.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,103],"terminalOffsetsZh":[0,23],"fullStemEn":"Highlight the findings in the postoperative record that indicate the client is developing hypocalcemia.","fullStemZh":"标出术后记录中提示患者正在发生低钙血症的发现。","terminalSentenceEn":"Highlight the findings in the postoperative record that indicate the client is developing hypocalcemia.","terminalSentenceZh":"标出术后记录中提示患者正在发生低钙血症的发现。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"Postoperative Day 1: The client is 24 hours post-total thyroidectomy. The nurse performs an assessment.","zh":"术后第1天：患者全甲状腺切除术后24小时。护士进行评估。"},{"id":"s2","en":"The client is awake, oriented, and breathing without stridor.","zh":"患者清醒、定向力正常，呼吸时无喘鸣。"},{"id":"s3","en":"The client has a positive Trousseau's sign upon cuff inflation,","zh":"充气袖带时患者特鲁索征阳性，","selectable":true},{"id":"s4","en":"exhibits hyperactive deep tendon reflexes (4+),","zh":"表现出深腱反射亢进 (4+)，","selectable":true},{"id":"s5","en":"and reports tingling and numbness around the mouth.","zh":"且主诉口周有针刺和麻木感。","selectable":true},{"id":"s6","en":"The nurse notes the client has a hoarse voice when speaking.","zh":"护士注意到患者说话时声音嘶哑。","selectable":true},{"id":"s7","en":"The client reports pain at the neck incision site graded 4 out of 10.","zh":"患者报告颈部切口处疼痛评分为 4/10。","selectable":true}],"correct":["s3","s4","s5"]}},"rationaleCorrectEn":"Tingling/numbness around the mouth (perioral paresthesia), positive Trousseau's sign (carpopedal spasm induced by ischemia), and hyperactive deep tendon reflexes (neuromuscular excitability) are classic signs of hypocalcemia. This is a common risk after total thyroidectomy due to accidental damage or removal of the parathyroid glands. A hoarse voice post-thyroidectomy can suggest recurrent laryngeal nerve irritation or injury and requires close assessment, but it is not a cue for hypocalcemia. Neck incision pain of 4/10 is expected after a surgical procedure and does not represent an electrolyte imbalance.","rationaleCorrectZh":"口周针刺感/麻木（口周感觉异常）、特鲁索征阳性（缺血引起的手足抽搐）和深腱反射亢进（神经肌肉兴奋性增高）是低钙血症的典型体征。由于手术中无意损伤或切除了甲状旁腺，这是全甲状腺切除术后常见的风险。甲状腺切除术后声音嘶哑可能提示喉返神经刺激或损伤，需要密切评估，但它并不是低钙血症的征兆。颈部切口疼痛 4/10 是手术后的预期表现，不代表电解质紊乱。","testTakingStrategyEn":"Link the surgical procedure (total thyroidectomy) with its high-risk complication (accidental parathyroidectomy and hypocalcemia). Recognize neuromuscular hyper-excitability cues (Trousseau's sign, hyperreflexia, paresthesias) as indicators of hypocalcemia, while excluding mechanical/nerve complications like hoarseness.","testTakingStrategyZh":"将手术过程（全甲状腺切除术）与其高风险并发症（无意切除甲状旁腺和低钙血症）联系起来。将神经肌肉兴奋性增高特征（特鲁索征、反射亢进、感觉异常）识别为低钙血症的指标，同时排除声嘶等机械/神经并发症。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1101,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hpm_ngn_2026_06_22_q1","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.824","itemType":"bowtie","category":"Health Promotion and Maintenance","topic":"Maternal-Newborn Care & Teaching","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.824.stem.en","stemPathZh":"questions.824.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[134,276],"terminalOffsetsZh":[32,71],"fullStemEn":"A postpartum client who is 3 days post-delivery reports bilateral breast engorgement, pain, and difficulty with the newborn latching. Select the most likely condition the client is experiencing, two priority nursing actions, and two clinical parameters to monitor or evaluate.","fullStemZh":"一名产后 3 天的产妇主诉双侧乳房胀痛、疼痛，且新生儿难以含接。请选择该患者最可能经历的病情、两项优先护理措施以及两个要监测或评估的临床参数。","terminalSentenceEn":"Select the most likely condition the client is experiencing, two priority nursing actions, and two clinical parameters to monitor or evaluate.","terminalSentenceZh":"请选择该患者最可能经历的病情、两项优先护理措施以及两个要监测或评估的临床参数。","penultimateSentenceEn":"A postpartum client who is 3 days post-delivery reports bilateral breast engorgement, pain, and difficulty with the newborn latching.","penultimateSentenceZh":"一名产后 3 天的产妇主诉双侧乳房胀痛、疼痛，且新生儿难以含接。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Most likely condition","zh":"最可能的病情"},"tokens":[{"id":"cond_mastitis","en":"Mastitis","zh":"乳腺炎"},{"id":"cond_engorgement","en":"Breast engorgement","zh":"乳房胀痛"},{"id":"cond_insufficient","en":"Insufficient milk supply","zh":"乳汁不足"}],"correct":"cond_engorgement"},"actions":{"prompt":{"en":"Actions to take","zh":"应采取的措施"},"tokens":[{"id":"act_give_formula","en":"Give newborn formula supplement to allow breast rest","zh":"给予配方奶辅助喂养以让乳房休息"},{"id":"act_continuous_heat","en":"Apply constant heat between feedings to relieve pain","zh":"哺乳间歇期持续热敷以缓解疼痛"},{"id":"act_warm_compress","en":"Apply warm compresses briefly before feedings to facilitate letdown","zh":"哺乳前短时间热敷以促进排乳"},{"id":"act_cold_cabbage","en":"Apply cold cabbage leaves or ice packs between feedings to reduce swelling","zh":"哺乳间歇期冷敷卷心菜叶或冰袋以减轻肿胀"}],"correct":["act_warm_compress","act_cold_cabbage"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"应监测的指标"},"tokens":[{"id":"param_latch","en":"Newborn latch and sucking pattern","zh":"新生儿含接和吸吮模式"},{"id":"param_prolactin","en":"Maternal serum prolactin level","zh":"产妇血清催乳素水平"},{"id":"param_comfort","en":"Maternal comfort and pain level","zh":"产妇的舒适度和疼痛程度"},{"id":"param_gravity","en":"Newborn urine specific gravity","zh":"新生儿尿比重"}],"correct":["param_latch","param_comfort"]}}},"rationaleCorrectEn":"The client's presentation of bilateral breast engorgement and pain on day 3 postpartum is consistent with physiological breast engorgement due to increased milk volume and vascular congestion. Warm compresses briefly before feeding facilitate the letdown reflex and milk flow, making latching easier. Cold cabbage leaves or ice packs between feedings constrict blood vessels and reduce swelling and discomfort. Constant heat between feedings increases congestion. Giving formula supplement reduces breast stimulation and can decrease milk production. The nurse must monitor the newborn's latch and sucking pattern to ensure effective emptying of the breasts, and evaluate maternal comfort and pain level.","rationaleCorrectZh":"该产妇在产后第 3 天出现双侧乳房胀痛和疼痛，与乳汁量增加和血管充血导致的生理性乳房胀痛相符。哺乳前短时间热敷有助于促进排乳反射和乳汁流动，使婴儿更易含接。哺乳间歇期冷敷卷心菜叶或冰袋可收缩血管，减轻肿胀和不适。哺乳间歇期持续热敷会增加充血。给予配方奶辅助喂养会减少乳房刺激，从而降低乳汁分泌。护士必须监测新生儿的含接和吸吮模式以确保乳房有效排空，并评估产妇的舒适度和疼痛程度。","testTakingStrategyEn":"Differentiate between the therapeutic uses of heat (for flow/letdown before feeding) and cold (for swelling reduction between feedings) in lactation management.","testTakingStrategyZh":"区分哺乳管理中热敷（哺乳前用于促进乳汁流动/排乳）和冷敷（哺乳间歇期用于减轻肿胀）的治疗性用途。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1102,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hpm_ngn_2026_06_22_q2","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.825","itemType":"highlight","category":"Health Promotion and Maintenance","topic":"Pediatric & Adolescent Health","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.825.stem.en","stemPathZh":"questions.825.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[96,186],"terminalOffsetsZh":[29,50],"fullStemEn":"A nurse in a pediatric clinic is performing a developmental screening on a 12-month-old infant. Highlight the developmental findings that indicate a need for further clinical assessment.","fullStemZh":"护士正在小儿科诊所对一名 12 个月大的婴儿进行发育筛查。标出提示需要进行进一步临床评估的发育发现。","terminalSentenceEn":"Highlight the developmental findings that indicate a need for further clinical assessment.","terminalSentenceZh":"标出提示需要进行进一步临床评估的发育发现。","penultimateSentenceEn":"A nurse in a pediatric clinic is performing a developmental screening on a 12-month-old infant.","penultimateSentenceZh":"护士正在小儿科诊所对一名 12 个月大的婴儿进行发育筛查。","responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"During the developmental assessment of the 12-month-old infant:","zh":"在对 12 个月大婴儿的发育评估期间："},{"id":"s2","en":"The infant is able to sit up unsupported and crawls on hands and knees.","zh":"婴儿能够独立坐起，并用手和膝盖爬行。","selectable":true},{"id":"s3","en":"The infant pulls to a standing position but cannot walk independently.","zh":"婴儿能够扶着站立，但无法独立行走。","selectable":true},{"id":"s4","en":"The parent reports that the infant does not babble or use simple gestures like waving goodbye.","zh":"家长报告称婴儿不会咿呀学语，也不会使用挥手再见等简单手势。","selectable":true},{"id":"s5","en":"The infant does not make eye contact when spoken to and shows no interest in playing peek-a-boo.","zh":"在与婴儿交谈时，婴儿不进行眼神接触，且对玩躲猫猫游戏不感兴趣。","selectable":true},{"id":"s6","en":"The infant can hold a cup with two hands and attempts to drink from it.","zh":"婴儿能用双手拿杯子并尝试喝水。","selectable":true}],"correct":["s4","s5"]}},"rationaleCorrectEn":"By 12 months of age, infants should babble and use simple gestures like waving goodbye or pointing. A lack of babbling or simple gestures at 12 months requires further evaluation for developmental or hearing delays. Additionally, a lack of eye contact and lack of interest in interactive social games (like peek-a-boo) are warning signs for social-emotional or autism spectrum disorders. Sitting unsupported and crawling are normal motor milestones achieved before or by 12 months. Pulling to a standing position is expected at 12 months; independent walking is not universally expected until 15-18 months. Holding a cup with two hands is an appropriate fine motor finding at this age.","rationaleCorrectZh":"到 12 个月大时，婴儿应会咿呀学语，并能使用简单的手势，如挥手再见或用手指点。在 12 个月时缺乏咿呀学语或简单手势需要对发育或听力迟缓进行进一步评估。此外，缺乏眼神接触和对互动性社交游戏（如躲猫猫）不感兴趣是社交情感或自闭症谱系障碍的警示信号。独立坐起和爬行是 12 个月前或 12 个月时达到的正常运动里程碑。12 个月时扶着站立是预期表现；直到 15-18 个月才普遍预期能够独立行走。用双手端杯子是该年龄段适当的精细运动表现。","testTakingStrategyEn":"Distinguish between expected developmental variations (like walking at 12 months) and significant language/social-emotional red flags that warrant referral.","testTakingStrategyZh":"区分预期的发育差异（例如 12 个月大时会行走）与需要转诊的重大语言/社交情感警示信号。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1103,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hpm_ngn_2026_06_22_q3","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.826","itemType":"dropdown_cloze","category":"Health Promotion and Maintenance","topic":"Pediatric & Toddler Safety","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.826.stem.en","stemPathZh":"questions.826.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[255,404],"terminalOffsetsZh":[83,138],"fullStemEn":"A nurse is providing discharge education to a parent regarding car seat safety for their 18-month-old toddler. The nurse teaches that the toddler must be secured in a {{seat_type}} car seat until they reach the maximum height or weight limit of the seat. The harness straps should be positioned {{strap_level}} the child's shoulders, and the chest clip must be secured at the level of the {{clip_level}}.","fullStemZh":"护士正在向家长提供关于 18 个月大幼儿汽车安全座椅出院指导。护士指导称，幼儿必须固定在{{seat_type}}汽车安全座椅中，直到达到该座椅的最大身高或体重限制。安全带肩带应定位在孩子肩膀的{{strap_level}}，胸夹必须固定在{{clip_level}}的水平。","terminalSentenceEn":"The harness straps should be positioned {{strap_level}} the child's shoulders, and the chest clip must be secured at the level of the {{clip_level}}.","terminalSentenceZh":"安全带肩带应定位在孩子肩膀的{{strap_level}}，胸夹必须固定在{{clip_level}}的水平。","penultimateSentenceEn":"The nurse teaches that the toddler must be secured in a {{seat_type}} car seat until they reach the maximum height or weight limit of the seat.","penultimateSentenceZh":"护士指导称，幼儿必须固定在{{seat_type}}汽车安全座椅中，直到达到该座椅的最大身高或体重限制。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"A nurse is providing discharge education to a parent regarding car seat safety for their 18-month-old toddler. The nurse teaches that the toddler must be secured in a {{seat_type}} car seat until they reach the maximum height or weight limit of the seat. The harness straps should be positioned {{strap_level}} the child's shoulders, and the chest clip must be secured at the level of the {{clip_level}}.","zh":"护士正在向家长提供关于 18 个月大幼儿汽车安全座椅出院指导。护士指导称，幼儿必须固定在{{seat_type}}汽车安全座椅中，直到达到该座椅的最大身高或体重限制。安全带肩带应定位在孩子肩膀的{{strap_level}}，胸夹必须固定在{{clip_level}}的水平。"},"dropdowns":[{"id":"seat_type","options":[{"id":"forward_facing","en":"forward-facing","zh":"前向式"},{"id":"booster","en":"booster seat","zh":"增高垫"},{"id":"rear_facing","en":"rear-facing","zh":"后向式"}],"correct":"rear_facing"},{"id":"strap_level","options":[{"id":"at_or_below","en":"at or below","zh":"处或下方"},{"id":"significantly_above","en":"significantly above","zh":"明显上方"},{"id":"at_or_above","en":"at or above","zh":"处或上方"}],"correct":"at_or_below"},{"id":"clip_level","options":[{"id":"abdomen","en":"abdomen (belly button)","zh":"腹部（肚脐）"},{"id":"collarbone","en":"collarbone","zh":"锁骨"},{"id":"armpits","en":"armpits (nipple line)","zh":"腋窝（乳头线）"}],"correct":"armpits"}]},"rationaleCorrectEn":"The American Academy of Pediatrics (AAP) recommends that infants and toddlers ride in a rear-facing car seat as long as possible, until they reach the highest weight or height allowed by their safety seat manufacturer. An 18-month-old toddler should remain rear-facing. For rear-facing seats, the harness straps should be at or below the shoulders to prevent the child from sliding up in a crash. The chest clip must always be positioned at the level of the armpits (nipple line) to keep the harness straps positioned correctly on the shoulders and prevent ejection.","rationaleCorrectZh":"美国儿科学会（AAP）建议，婴儿和幼儿应尽可能长时间地乘坐后向式安全座椅，直到达到其座椅制造商允许的最大体重或身高。18 个月大的幼儿应保持后向式坐姿。对于后向式座椅，安全带肩带应位于肩膀水平或下方，以防在发生碰撞时儿童向上滑动。胸夹必须始终定位在腋窝（乳头线）水平，以保持肩带在肩膀上的正确位置，防止抛出。","testTakingStrategyEn":"Use the guidelines from major pediatric associations. Match seat type (rear-facing) with appropriate strap positioning rules (at or below shoulders) and standard chest clip placement (armpits).","testTakingStrategyZh":"利用主要儿科协会的指南。将安全座椅类型（后向式）与相应的安全带定位规则（肩膀水平或下方）及标准的胸夹位置（腋窝）进行匹配。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":true,"terminalContainsRawPlaceholder":true,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":true,"clozeStemContainedInStem":true,"exactEnglishTerminalRepeatedElsewhereInItem":true},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1104,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hpm_ngn_2026_06_22_q4","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.827","itemType":"matrix","category":"Health Promotion and Maintenance","topic":"Reproductive & Endocrine Health","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.827.stem.en","stemPathZh":"questions.827.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[79,222],"terminalOffsetsZh":[25,63],"fullStemEn":"A client is seeking a prescription for combination oral contraceptives (COCs). For each client finding, select whether the finding is a contraindication or not a concern for the safe use of combination oral contraceptives.","fullStemZh":"一名患者希望开具复方口服避孕药（COCs）的处方。针对每个患者发现，请选择该发现是复方口服避孕药安全使用的禁忌证还是无需担心。","terminalSentenceEn":"For each client finding, select whether the finding is a contraindication or not a concern for the safe use of combination oral contraceptives.","terminalSentenceZh":"针对每个患者发现，请选择该发现是复方口服避孕药安全使用的禁忌证还是无需担心。","penultimateSentenceEn":"A client is seeking a prescription for combination oral contraceptives (COCs).","penultimateSentenceZh":"一名患者希望开具复方口服避孕药（COCs）的处方。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Migraine with aura","zh":"伴有先兆的偏头痛"},{"id":"r2","en":"Uncontrolled stage 2 hypertension (BP 165/105 mmHg)","zh":"未控制的 2 期高血压（血压 165/105 mmHg）"},{"id":"r3","en":"History of gestational diabetes with normal current blood glucose","zh":"有妊娠期糖尿病病史且目前血糖正常"},{"id":"r4","en":"Mild varicose veins in bilateral lower extremities","zh":"双下肢轻度静脉曲张"}],"columns":[{"id":"col_contraindication","en":"Contraindication","zh":"禁忌证"},{"id":"col_no_concern","en":"Not a Concern","zh":"无需担心"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["col_contraindication"]},{"rowId":"r2","columnIds":["col_contraindication"]},{"rowId":"r3","columnIds":["col_no_concern"]},{"rowId":"r4","columnIds":["col_no_concern"]}]},"rationaleCorrectEn":"Combination oral contraceptives contain estrogen, which increases the risk of cardiovascular events, stroke, and thromboembolism. A migraine with aura significantly increases stroke risk, making COCs absolutely contraindicated. Uncontrolled stage 2 hypertension also increases stroke risk and is a contraindication. A history of gestational diabetes with currently normal blood glucose is not a contraindication, though blood glucose should be monitored. Mild varicose veins are not a contraindication; only active deep vein thrombosis (DVT) or history of DVT is a contraindication.","rationaleCorrectZh":"复方口服避孕药含有雌激素，这会增加心血管事件、脑卒中和血栓栓塞的风险。伴有先兆的偏头痛会明显增加脑卒中风险，使得复方口服避孕药属于绝对禁忌证。未控制的 2 期高血压也会增加脑卒中风险，同样是禁忌证。虽需监测血糖，但有妊娠期糖尿病病史且目前血糖正常并不是禁忌证。轻度静脉曲张不是禁忌证；只有活动性深静脉血栓（DVT）或 DVT 病史才是禁忌证。","testTakingStrategyEn":"Recall the major cardiovascular and neurological contraindications to estrogen-containing therapy (e.g., thromboembolic risks, stroke risks, liver disease, active breast cancer).","testTakingStrategyZh":"熟记含雌激素疗法的主要心血管和神经系统禁忌证（例如血栓栓塞风险、脑卒中风险、肝脏疾病、活动性乳腺癌）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1105,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hpm_ngn_2026_06_22_q5","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.828","itemType":"select_all","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.828.stem.en","stemPathZh":"questions.828.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[214,238],"terminalOffsetsZh":[51,60],"fullStemEn":"A nurse in an outpatient clinic is reviewing screening recommendations with several adult clients. Which client descriptions correctly represent individuals meeting the criteria for the specified cancer screening? (Select all that apply.)","fullStemZh":"门诊诊所的护士正在与几位成年患者一起审查筛查建议。哪些患者描述正确代表了符合指定癌症筛查标准的人群？（选择所有适用项。）","terminalSentenceEn":"(Select all that apply.)","terminalSentenceZh":"选择所有适用项。）","penultimateSentenceEn":"Which client descriptions correctly represent individuals meeting the criteria for the specified cancer screening?","penultimateSentenceZh":"哪些患者描述正确代表了符合指定癌症筛查标准的人群？（","responseContext":{"type":"select_all","options":[{"id":"D","en":"A 30-year-old client with average risk requesting a biennial Pap smear combined with HPV cotesting.","zh":"一名 30 岁、具有平均风险的患者请求进行每两年一次的巴氏涂片结合 HPV 联合检测。"},{"id":"B","en":"A 21-year-old client scheduled for their first Pap smear (cervical cancer screening).","zh":"一名 21 岁的患者计划进行首次巴氏涂片检查（宫颈癌筛查）。"},{"id":"A","en":"A 45-year-old client with average risk scheduled for a screening colonoscopy.","zh":"一名 45 岁、具有平均风险的患者计划进行结肠镜筛查。"},{"id":"E","en":"A 55-year-old client who has a 10 pack-year smoking history requesting a screening low-dose chest CT scan.","zh":"一名有 10 包-年吸烟史的 55 岁患者请求进行低剂量胸部 CT 筛查。"},{"id":"C","en":"A 40-year-old female with average risk starting biennial screening mammograms.","zh":"一名 40 岁、具有平均风险的女性开始每两年一次的乳房透视筛查。"}],"correct":["A","B","C"]},"rationaleCorrectEn":"According to the U.S. Preventive Services Task Force (USPSTF) guidelines: (1) Colorectal cancer screening for average-risk individuals should begin at age 45. (2) Cervical cancer screening with Pap smear alone should begin at age 21 and repeat every 3 years. (3) The updated 2024 USPSTF breast cancer screening guidelines recommend that females at average risk begin biennial screening mammograms at age 40. HPV cotesting is recommended every 5 years for women aged 30-65, not every 2 years. Screening for lung cancer with low-dose CT is recommended for adults aged 50 to 80 with a 20 pack-year smoking history who currently smoke or quit within 15 years; a 10 pack-year history does not meet the screening threshold.","rationaleCorrectZh":"根据美国预防服务工作组（USPSTF）的指南：(1) 平均风险人群的结直肠癌筛查应在 45 岁开始。(2) 仅使用巴氏涂片进行宫颈癌筛查应在 21 岁开始，并每 3 年重复一次。(3) 2024 年更新的 USPSTF 乳腺癌筛查指南建议具有平均风险的女性在 40 岁时开始每两年一次的乳腺透视检查。对于 30-65 岁的女性，建议每 5 年进行一次 HPV 联合检测，而不是每 2 年一次。建议年龄在 50 至 80 岁、有 20 包-年吸烟史且目前仍在吸烟或在 15 年内戒烟的成年人进行低剂量 CT 肺癌筛查；10 包-年的吸烟史不符合该筛查阈值。","testTakingStrategyEn":"Recall the current screening schedules recommended by major guidelines (USPSTF). Pay close attention to age thresholds and smoking history metrics.","testTakingStrategyZh":"熟记主要指南 (USPSTF) 建议的当前筛查时间表。密切注意年龄阈值和吸烟史指标。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1106,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hpm_ngn_2026_06_22_q6","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.829","itemType":"multiple_choice","category":"Health Promotion and Maintenance","topic":"Pediatric & Toddler Safety","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.829.stem.en","stemPathZh":"questions.829.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[92,194],"terminalOffsetsZh":[34,61],"fullStemEn":"A nurse is teaching a parent of a 10-month-old infant about introducing solid finger foods. Which food selection should the nurse teach the parent to avoid to prevent a potential choking hazard?","fullStemZh":"护士正在指导一名 10 个月大婴儿的家长关于引入固体手指食物的事宜。护士应指导家长避免选择哪种食物以防发生潜在的窒息危险？","terminalSentenceEn":"Which food selection should the nurse teach the parent to avoid to prevent a potential choking hazard?","terminalSentenceZh":"护士应指导家长避免选择哪种食物以防发生潜在的窒息危险？","penultimateSentenceEn":"A nurse is teaching a parent of a 10-month-old infant about introducing solid finger foods.","penultimateSentenceZh":"护士正在指导一名 10 个月大婴儿的家长关于引入固体手指食物的事宜。","responseContext":{"type":"multiple_choice","options":[{"id":"B","en":"Whole blueberries that have been mashed","zh":"压碎的整颗蓝莓"},{"id":"C","en":"Whole cherry tomatoes","zh":"整颗圣女果"},{"id":"A","en":"Whole grapes cut into quarters","zh":"切成四分之一大的整颗葡萄"},{"id":"D","en":"Soft, well-cooked carrot sticks cut into small pieces","zh":"切成小块的煮得很软的胡萝卜条"}],"correct":["C"]},"rationaleCorrectEn":"Whole cherry tomatoes are round, smooth, and firm, which can easily slide into the trachea and completely block the airway, posing a high risk of choking in infants. Fruits and vegetables with a circular shape should be mashed or cut into small, non-round pieces before feeding. Grapes cut into quarters are safe. Mashed blueberries do not pose a round-airway obstruction risk. Soft-cooked, finely chopped carrot pieces are easily manageable for an infant.","rationaleCorrectZh":"整颗圣女果呈圆形、光滑且质地较硬，极易滑入气管并完全阻塞气道，给婴儿带来很高的窒息风险。圆形的水果和蔬菜在喂食前应压碎或切成非圆形的小块。切成四分之一大小的葡萄是安全的。压碎的蓝莓不会带来圆形气道阻塞的风险。煮得很软、切得很细的胡萝卜块对婴儿来说很容易处理。","testTakingStrategyEn":"Identify the structural characteristics of foods that cause choking (firm, round, slippery, or hard objects that can plug the airway).","testTakingStrategyZh":"识别导致窒息的食物结构特征（可堵塞气道的坚硬、圆形、光滑或坚硬的物体）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1107,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hpm_ngn_2026_06_22_q7","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.830","itemType":"ordered_response","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.830.stem.en","stemPathZh":"questions.830.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[129,230],"terminalOffsetsZh":[35,60],"fullStemEn":"A nurse is using the '5 As' behavior change model to assist a client who smokes cigarettes to initiate a smoking cessation plan. Place the nursing actions in the correct sequential order from first to last according to this model.","fullStemZh":"护士正在使用“5 As”行为改变模型来协助一名吸烟的患者启动戒烟计划。根据该模型，请将护理措施按从前到后的正确顺序排列。","terminalSentenceEn":"Place the nursing actions in the correct sequential order from first to last according to this model.","terminalSentenceZh":"根据该模型，请将护理措施按从前到后的正确顺序排列。","penultimateSentenceEn":"A nurse is using the '5 As' behavior change model to assist a client who smokes cigarettes to initiate a smoking cessation plan.","penultimateSentenceZh":"护士正在使用“5 As”行为改变模型来协助一名吸烟的患者启动戒烟计划。","responseContext":{"type":"ordered_response","options":[{"id":"B","en":"Advise the client to quit smoking with a clear, strong, personalized message.","zh":"通过清晰、强烈、个性化的信息建议患者戒烟。"},{"id":"C","en":"Assess the client's readiness and willingness to make a quit attempt.","zh":"评估患者对尝试戒烟的准备情况和意愿。"},{"id":"D","en":"Assist the client in developing a quit plan, including setting a date and identifying support.","zh":"帮助患者制定戒烟计划，包括确定日期并寻找支持。"},{"id":"E","en":"Arrange a follow-up contact, such as a phone call or visit, within the first week after the quit date.","zh":"在戒烟日期后第一周内安排随访联系，例如电话或就诊。"},{"id":"A","en":"Ask the client about their current tobacco use status at every visit.","zh":"在每次就诊时询问患者当前的烟草使用情况。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"The '5 As' model for smoking cessation consists of five sequential steps: (1) Ask: identify and document tobacco use status for every client at every visit. (2) Advise: urge every tobacco user to quit in a clear, strong, and personalized manner. (3) Assess: determine the client's willingness to make a quit attempt at this time. (4) Assist: aid the client in creating a quit plan, offering counseling and pharmacotherapy. (5) Arrange: schedule follow-up contact, typically within the first week after the designated quit date, to support compliance and prevent relapse.","rationaleCorrectZh":"戒烟的“5 As”模型由五个顺序步骤组成：(1) Ask（询问）：在每次就诊时识别并记录每位患者的烟草使用情况。(2) Advise（建议）：以清晰、强烈和个性化的方式敦促每位吸烟者戒烟。(3) Assess（评估）：确定患者此时是否愿意尝试戒烟。(4) Assist（帮助）：帮助患者制定戒烟计划，提供咨询和药物治疗。(5) Arrange（安排）：在指定的戒烟日期后第一周内安排随访联系，以支持依从性并防止复发。","testTakingStrategyEn":"Recognize the progression of the '5 As' framework alphabetically: Ask, Advise, Assess, Assist, Arrange.","testTakingStrategyZh":"按照字母顺序识别“5 As”框架的进展：Ask（询问）、Advise（建议）、Assess（评估）、Assist（帮助）、Arrange（安排）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1108,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hpm_ngn_2026_06_22_q8","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.831","itemType":"dropdown_cloze","category":"Health Promotion and Maintenance","topic":"Maternal-Newborn Care & Teaching","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.831.stem.en","stemPathZh":"questions.831.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[220,299],"terminalOffsetsZh":[66,102],"fullStemEn":"A nurse is teaching a new mother about safe sleep guidelines to reduce the risk of Sudden Infant Death Syndrome (SIDS). The nurse instructs that the infant should always be placed in the {{position}} position for sleep. The sleeping surface must be a {{surface}} mattress with {{items}} in the crib.","fullStemZh":"护士正在指导新手妈妈关于降低婴儿猝死综合征（SIDS）风险的安全睡眠指南。护士指导称，婴儿睡眠时应始终处于{{position}}。睡眠表面必须是{{surface}}床垫，且婴儿床内{{items}}。","terminalSentenceEn":"The sleeping surface must be a {{surface}} mattress with {{items}} in the crib.","terminalSentenceZh":"睡眠表面必须是{{surface}}床垫，且婴儿床内{{items}}。","penultimateSentenceEn":"The nurse instructs that the infant should always be placed in the {{position}} position for sleep.","penultimateSentenceZh":"护士指导称，婴儿睡眠时应始终处于{{position}}。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"A nurse is teaching a new mother about safe sleep guidelines to reduce the risk of Sudden Infant Death Syndrome (SIDS). The nurse instructs that the infant should always be placed in the {{position}} position for sleep. The sleeping surface must be a {{surface}} mattress with {{items}} in the crib.","zh":"护士正在指导新手妈妈关于降低婴儿猝死综合征（SIDS）风险的安全睡眠指南。护士指导称，婴儿睡眠时应始终处于{{position}}。睡眠表面必须是{{surface}}床垫，且婴儿床内{{items}}。"},"dropdowns":[{"id":"position","options":[{"id":"prone","en":"prone (on the stomach)","zh":"俯卧位（腹部贴床）"},{"id":"lateral","en":"lateral (on the side)","zh":"侧卧位"},{"id":"supine","en":"supine (on the back)","zh":"仰卧位（背部贴床）"}],"correct":"supine"},{"id":"surface","options":[{"id":"memory_foam","en":"memory foam","zh":"记忆棉"},{"id":"firm","en":"firm","zh":"结实的"},{"id":"soft","en":"soft","zh":"柔软的"}],"correct":"firm"},{"id":"items","options":[{"id":"loose_blankets","en":"loose blankets to maintain warmth","zh":"宽松毯子以保暖"},{"id":"only_soft","en":"only a soft pillow and bumper pads","zh":"仅软枕头和防撞垫"},{"id":"no_other","en":"no pillows, blankets, or bumper pads","zh":"无枕头、毯子或防撞垫"}],"correct":"no_other"}]},"rationaleCorrectEn":"To reduce the risk of Sudden Infant Death Syndrome (SIDS), the American Academy of Pediatrics (AAP) recommends: (1) Placing infants on their back (supine position) for every sleep. Prone and lateral positions are unsafe as they increase the risk of rebreathing expired carbon dioxide or airway obstruction. (2) Placing infants on a firm sleep surface. Soft surfaces or memory foam can mold to the infant's face and cause suffocation. (3) Keeping the crib free of loose items such as pillows, quilts, blankets, bumper pads, and stuffed toys, which present entrapment, suffocation, or choking hazards.","rationaleCorrectZh":"为降低婴儿猝死综合征（SIDS）的风险，美国儿科学会（AAP）建议：(1) 婴儿每次睡眠时都应采取仰卧位（背部贴床）。俯卧位和侧卧位是不安全的，因为它们会增加重新吸入呼出的二氧化碳或气道阻塞的风险。(2) 将婴儿放置在结实的睡眠表面上。柔软的表面或记忆棉会贴合婴儿的面部并导致窒息。(3) 婴儿床内不能有枕头、被子、毯子、防撞垫和毛绒玩具等松散物品，因为这些物品会带来夹伤、窒息或卡喉的危险。","testTakingStrategyEn":"Recall the simple rules of newborn safe sleep: back to sleep, firm surface, empty crib.","testTakingStrategyZh":"牢记新生儿安全睡眠的简单规则：仰卧睡眠、表面结实、空婴儿床。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":true,"terminalContainsRawPlaceholder":true,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":true,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":true,"clozeStemContainedInStem":true,"exactEnglishTerminalRepeatedElsewhereInItem":true},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1109,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hpm_ngn_2026_06_22_q9","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.832","itemType":"highlight","category":"Health Promotion and Maintenance","topic":"Reproductive & Endocrine Health","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.832.stem.en","stemPathZh":"questions.832.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[98,225],"terminalOffsetsZh":[33,64],"fullStemEn":"A nurse is providing health teaching to a 52-year-old female client transitioning into menopause. Highlight the statements made by the client that indicate a correct understanding of menopause and health promotion strategies.","fullStemZh":"护士正在对一名处于更年期过渡阶段的 52 岁女性患者进行健康指导。标出该患者所做的提示其对更年期和健康促进策略有正确理解的陈述。","terminalSentenceEn":"Highlight the statements made by the client that indicate a correct understanding of menopause and health promotion strategies.","terminalSentenceZh":"标出该患者所做的提示其对更年期和健康促进策略有正确理解的陈述。","penultimateSentenceEn":"A nurse is providing health teaching to a 52-year-old female client transitioning into menopause.","penultimateSentenceZh":"护士正在对一名处于更年期过渡阶段的 52 岁女性患者进行健康指导。","responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"During the teaching session on menopause, the client states:","zh":"在关于更年期的指导会期间，患者陈述称："},{"id":"s2","en":"I will increase my intake of calcium and vitamin D to protect my bones.","zh":"我会增加钙和维生素 D 的摄入量以保护骨骼。","selectable":true},{"id":"s3","en":"I should start performing weight-bearing exercises regularly, like walking.","zh":"我应该开始定期进行负重运动，比如散步。","selectable":true},{"id":"s4","en":"Since I still have my uterus, taking estrogen-only hormone therapy is the safest option for hot flashes.","zh":"因为我还有子宫，所以仅使用雌激素的激素疗法是缓解潮热最安全的选择。","selectable":true},{"id":"s5","en":"I will follow recommended breast cancer screening, including mammograms every 2 years.","zh":"我会遵循推荐的乳腺癌筛查，包括每 2 年进行一次乳腺X线摄影筛查。","selectable":true},{"id":"s6","en":"I will stop using contraception immediately since my periods have been irregular for two months.","zh":"我将立即停止避孕，因为我的月经已经不规律两个月了。","selectable":true}],"correct":["s2","s3","s5"]}},"rationaleCorrectEn":"During menopause, estrogen levels drop, increasing the risk of osteoporosis. Increasing calcium and vitamin D intake and regularly performing weight-bearing exercises (such as walking) are key strategies to preserve bone density. Women with average breast cancer risk should follow recommended breast cancer screening, including biennial screening mammograms beginning at age 40. Women with an intact uterus must not take estrogen-only hormone therapy, as unopposed estrogen causes endometrial hyperplasia and significantly increases the risk of endometrial cancer; they require combined estrogen-progestin therapy. Contraception is required until a woman has experienced 12 consecutive months of amenorrhea, as pregnancy can still occur during perimenopause.","rationaleCorrectZh":"更年期期间雌激素水平下降，会增加骨质疏松的风险。增加钙和维生素 D 的摄入量并定期进行负重运动（如散步）是保持骨密度的关键策略。具有平均乳腺癌风险的女性应遵循推荐的乳腺癌筛查，包括从 40 岁开始每两年进行一次乳腺X线摄影筛查。子宫完整的女性绝不能接受仅使用雌激素的激素治疗，因为未受孕激素拮抗的雌激素会导致子宫内膜增生，并显著增加子宫内膜癌的风险；她们需要联合使用雌孕激素治疗。避孕措施需要持续到女性连续 12 个月无月经，因为在围绝经期仍可能怀孕。","testTakingStrategyEn":"Identify clinical facts about menopausal changes: osteoporosis prevention (calcium/exercise), breast cancer screening, hormone therapy constraints (estrogen-progestin safety rule), and the definition of menopause (12 months of amenorrhea).","testTakingStrategyZh":"识别有关更年期变化的临床事实：骨质疏松症预防（钙/运动）、乳腺癌筛查、激素疗法限制（雌孕激素安全规则）以及更年期的定义（闭经 12 个月）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1110,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_hpm_ngn_2026_06_22_q10","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.833","itemType":"bowtie","category":"Health Promotion and Maintenance","topic":"Pediatric & Adolescent Health","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.833.stem.en","stemPathZh":"questions.833.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[271,413],"terminalOffsetsZh":[82,121],"fullStemEn":"A nurse is performing a health assessment on a 15-year-old female client accompanied by her parent. The client has experienced a 15% weight loss over the past 3 months, has amenorrhea, expresses an intense fear of gaining weight, and has a heart rate of 48 beats/minute. Select the most likely condition the client is experiencing, two priority nursing actions, and two clinical parameters to monitor or evaluate.","fullStemZh":"护士正在对一名由家长陪同的 15 岁女性患者进行健康评估。该患者在过去 3 个月内体重减轻了 15%，伴有闭经，表现出对体重增加的强烈恐惧，且心率为 48 次/分。请选择该患者最可能经历的病情、两项优先护理措施以及两个要监测或评估的临床参数。","terminalSentenceEn":"Select the most likely condition the client is experiencing, two priority nursing actions, and two clinical parameters to monitor or evaluate.","terminalSentenceZh":"请选择该患者最可能经历的病情、两项优先护理措施以及两个要监测或评估的临床参数。","penultimateSentenceEn":"The client has experienced a 15% weight loss over the past 3 months, has amenorrhea, expresses an intense fear of gaining weight, and has a heart rate of 48 beats/minute.","penultimateSentenceZh":"该患者在过去 3 个月内体重减轻了 15%，伴有闭经，表现出对体重增加的强烈恐惧，且心率为 48 次/分。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Most likely condition","zh":"最可能的病情"},"tokens":[{"id":"cond_bulimia","en":"Bulimia nervosa","zh":"暴食症"},{"id":"cond_hypothyroidism","en":"Hypothyroidism","zh":"甲状腺功能减退症"},{"id":"cond_anorexia","en":"Anorexia nervosa","zh":"厌食症"}],"correct":"cond_anorexia"},"actions":{"prompt":{"en":"Actions to take","zh":"应采取的措施"},"tokens":[{"id":"act_structured_meal","en":"Implement a structured, supervised meal schedule","zh":"实施结构化、受监督的用餐时间表"},{"id":"act_encourage_aerobics","en":"Encourage vigorous aerobic exercise to boost mood","zh":"鼓励剧烈的有氧运动以提升情绪"},{"id":"act_private_eating","en":"Allow the client to eat in private to reduce anxiety","zh":"允许患者私下用餐以减轻焦虑"},{"id":"act_obtain_ecg","en":"Obtain a 12-lead electrocardiogram (ECG)","zh":"获取 12 导联心电图 (ECG)"}],"correct":["act_structured_meal","act_obtain_ecg"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"应监测的指标"},"tokens":[{"id":"param_tsh_hourly","en":"Thyroid-stimulating hormone (TSH) hourly","zh":"每小时促甲状腺激素 (TSH)"},{"id":"param_bun_bihourly","en":"Serum blood urea nitrogen (BUN) every 2 hours","zh":"每 2 小时血清尿素氮 (BUN)"},{"id":"param_daily_weight","en":"Daily weight under standardized conditions","zh":"标准化条件下的每日体重"},{"id":"param_electrolytes","en":"Serum electrolytes and fluid status","zh":"血清电解质和液体状态"}],"correct":["param_electrolytes","param_daily_weight"]}}},"rationaleCorrectEn":"The client's clinical presentation of significant weight loss (15%), amenorrhea, severe bradycardia (HR 48 bpm), and cognitive distortions regarding weight is consistent with anorexia nervosa. Patients with anorexia nervosa are at extreme risk for life-threatening arrhythmias due to electrolyte imbalances and starvation-induced myocardial atrophy; obtaining a 12-lead ECG is a priority to assess for prolonged QT interval or other cardiac issues. Implementing a structured, supervised meal schedule ensures adequate caloric intake and prevents food hiding or purging. Eating in private should be forbidden. Exercise should be restricted. Monitoring serum electrolytes is vital to detect imbalances (e.g., hypokalemia) and refeeding syndrome risks. Daily weights under standardized conditions (e.g., waking, empty bladder, same gown) are required to monitor nutritional rehabilitation. Hourly TSH or bihourly BUN are clinically unnecessary.","rationaleCorrectZh":"该患者体重显著减轻（15%）、闭经、严重心动过缓（心率 48 次/分）以及对体重的认知偏差，与厌食症相符。厌食症患者由于电解质紊乱和饥饿导致的心肌萎缩，处于危及生命的心律失常的极高风险中；获取 12 导联心电图（ECG）是评估 QT 间期延长或其他心脏问题的首要措施。实施结构化、受监督的用餐时间表可确保充足的热量摄入，并防止藏匿食物或催吐。应禁止私下用餐。应限制运动。监测血清电解质对于发现紊乱（例如低钾血症）和再喂养综合征风险至关重要。需要在标准化条件下（例如起床后、排空膀胱、穿相同的病服）进行每日体重监测，以观察营养恢复情况。每小时 TSH 或每 2 小时 BUN 在临床上没有必要。","testTakingStrategyEn":"Recognize the severe physiological consequences of anorexia nervosa (cardiac risk due to bradycardia and electrolyte disturbances) and prioritize assessments and safety measures.","testTakingStrategyZh":"识别厌食症的严重生理后果（因心动过缓和电解质紊乱导致的心脏风险），并优先考虑评估和安全措施。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1111,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_ppt_ngn_2026_06_22_q1","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.834","itemType":"highlight","category":"Pharmacological and Parenteral Therapies","topic":"Anticoagulant Therapy","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.834.stem.en","stemPathZh":"questions.834.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[117,252],"terminalOffsetsZh":[33,65],"fullStemEn":"A nurse is caring for a client receiving a continuous intravenous heparin infusion for a deep vein thrombosis (DVT). Highlight the clinical findings or laboratory values that represent immediate indicators of bleeding complications or heparin toxicity.","fullStemZh":"护士正在护理因深静脉血栓（DVT）接受持续静脉注射肝素输注的患者。标出代表出血并发症或肝素中毒的即时指标的临床发现或实验室检查值。","terminalSentenceEn":"Highlight the clinical findings or laboratory values that represent immediate indicators of bleeding complications or heparin toxicity.","terminalSentenceZh":"标出代表出血并发症或肝素中毒的即时指标的临床发现或实验室检查值。","penultimateSentenceEn":"A nurse is caring for a client receiving a continuous intravenous heparin infusion for a deep vein thrombosis (DVT).","penultimateSentenceZh":"护士正在护理因深静脉血栓（DVT）接受持续静脉注射肝素输注的患者。","responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"1400 clinical note:","zh":"1400 临床记录："},{"id":"s2","en":"The client reports a mild headache and has a blood pressure of 130/80 mmHg.","zh":"患者诉轻微头痛，血压为 130/80 mmHg。","selectable":true},{"id":"s3","en":"The nurse notes active bleeding from the client's gums after oral care.","zh":"护士注意到患者进行口腔护理后牙龈有活动性出血。","selectable":true},{"id":"s4","en":"The client's urine in the bedside drainage bag appears dark red.","zh":"患者床旁引流袋中的尿液呈深红色。","selectable":true},{"id":"s5","en":"The activated partial thromboplastin time (aPTT) is 95 seconds (therapeutic range: 46-70 seconds).","zh":"活化部分凝血活酶时间（aPTT）为 95 秒（治疗范围：46-70 秒）。","selectable":true},{"id":"s6","en":"The platelet count is 160 ×10³/µL (reference range: 150-400 ×10³/µL).","zh":"血小板计数为 160 ×10³/µL（参考范围：150-400 ×10³/µL）。","selectable":true}],"correct":["s3","s4","s5"]}},"rationaleCorrectEn":"Active gum bleeding and dark red urine (hematuria) are direct indicators of bleeding complications. An aPTT of 95 seconds is significantly above the therapeutic range (typically 1.5 to 2.5 times the control, or 46-70 seconds), indicating over-anticoagulation and a high risk of hemorrhage. A mild headache with normal blood pressure is non-specific and not an immediate toxicity sign. A platelet count of 160 ×10³/µL is within the normal range, indicating no active heparin-induced thrombocytopenia (HIT).","rationaleCorrectZh":"牙龈活动性出血和尿液呈深红色（血尿）是出血并发症的直接指标。aPTT 为 95 秒明显高于治疗范围（通常为对照值的 1.5 至 2.5 倍，即 46-70 秒），表明过度抗凝且出血风险高。血压正常的轻微头痛是非特异性的，不是即时中毒迹象。血小板计数为 160 ×10³/µL 在正常范围内，表明未发生肝素诱导的血小板减少症（HIT）。","testTakingStrategyEn":"Focus on signs of active bleeding and lab values that exceed safe therapeutic ranges for anticoagulants.","testTakingStrategyZh":"关注活动性出血的迹象以及超出抗凝剂安全治疗范围的化验值。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"A nurse is caring for a client receiving a continuous intravenous heparin infusion for a deep vein thrombosis (DVT).","controlSentenceZh":"护士正在护理因深静脉血栓（DVT）接受持续静脉注射肝素输注的患者。"}
{"queueIndex":1112,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_ppt_ngn_2026_06_22_q2","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.835","itemType":"bowtie","category":"Pharmacological and Parenteral Therapies","topic":"Medication Safety & Admin","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.835.stem.en","stemPathZh":"questions.835.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[220,354],"terminalOffsetsZh":[77,118],"fullStemEn":"A client with severe hypokalemia is prescribed intravenous potassium chloride 40 mEq in 250 mL of normal saline to be administered via a central venous catheter using an infusion pump with continuous cardiac monitoring. Select the primary safety concern, two priority nursing actions, and two clinical parameters to monitor to ensure safe administration.","fullStemZh":"一名患者因严重低钾血症被开具了静脉输注氯化钾 40 mEq（加入 250 mL 生理盐水）的医嘱，要求通过中心静脉导管、使用输液泵并在连续心电监护下给药。请选择首要的安全关注点、两项优先护理措施以及两个要监测的临床参数，以确保安全给药。","terminalSentenceEn":"Select the primary safety concern, two priority nursing actions, and two clinical parameters to monitor to ensure safe administration.","terminalSentenceZh":"请选择首要的安全关注点、两项优先护理措施以及两个要监测的临床参数，以确保安全给药。","penultimateSentenceEn":"A client with severe hypokalemia is prescribed intravenous potassium chloride 40 mEq in 250 mL of normal saline to be administered via a central venous catheter using an infusion pump with continuous cardiac monitoring.","penultimateSentenceZh":"一名患者因严重低钾血症被开具了静脉输注氯化钾 40 mEq（加入 250 mL 生理盐水）的医嘱，要求通过中心静脉导管、使用输液泵并在连续心电监护下给药。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Primary safety concern","zh":"首要的安全关注点"},"tokens":[{"id":"cond_extravasation","en":"Extravasation and severe local tissue necrosis.","zh":"药液外渗和严重的局部组织坏死。"},{"id":"cond_fluid","en":"Fluid overload from the rapid saline infusion.","zh":"因生理盐水快速输注引起的液体负荷过重。"},{"id":"cond_embolism","en":"Pulmonary embolism due to rapid precipitate formation.","zh":"由于迅速形成沉淀而导致肺栓塞。"}],"correct":"cond_extravasation"},"actions":{"prompt":{"en":"Priority nursing actions","zh":"优先护理措施"},"tokens":[{"id":"act_verify_patency","en":"Verify central venous catheter patency before starting the infusion.","zh":"在开始输注前核实中心静脉导管通畅。"},{"id":"act_filter","en":"Use a 0.22-micron filter for all potassium infusions.","zh":"对所有钾输注使用 0.22 微米过滤器。"},{"id":"act_pump","en":"Administer the infusion via an electronic infusion pump.","zh":"通过电子输液泵进行输注给药。"},{"id":"act_push","en":"Give the potassium as a rapid bolus to restore cardiac levels.","zh":"快速静脉推注钾以恢复心脏电生理水平。"}],"correct":["act_pump","act_verify_patency"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"需要监测的参数"},"tokens":[{"id":"param_bowel","en":"Bowel sounds and abdominal distension.","zh":"肠鸣音和腹胀。"},{"id":"param_site","en":"Central-line insertion site and tubing for pain, swelling, redness, or leakage.","zh":"中心静脉导管穿刺部位和输液管路是否有疼痛、肿胀、发红或渗漏。"},{"id":"param_temp","en":"Hourly core body temperature.","zh":"每小时核心体温。"},{"id":"param_ecg","en":"Cardiac rhythm via continuous ECG monitoring.","zh":"通过连续心电图监测心律。"}],"correct":["param_site","param_ecg"]}}},"rationaleCorrectEn":"Intravenous potassium chloride is a high-alert, vein-irritating medication that can cause severe tissue injury if extravasation occurs and life-threatening dysrhythmias if infused too rapidly. It must never be administered by IV push. A concentrated 40 mEq/250 mL infusion should be administered through a central venous catheter using an infusion pump with continuous cardiac monitoring. The nurse verifies central-line patency, monitors the insertion site and tubing for leakage or local injury, and monitors ECG rhythm for potassium-related dysrhythmias. Filter needles/line filters are not required for potassium. Fluid overload is not the primary safety concern for this 250 mL infusion.","rationaleCorrectZh":"静脉输注氯化钾是一种高危、强烈刺激静脉的药物；若发生外渗可造成严重组织损伤，若输注过快可导致危及生命的心律失常。绝不能通过静脉推注给药。40 mEq/250 mL 的高浓度输注应通过中心静脉导管、使用输液泵并在连续心电监护下进行。护士需核实中心静脉导管通畅，监测穿刺部位和管路是否有渗漏或局部损伤，并通过心电图监测与血钾相关的心律失常。输钾不需要过滤针或管路过滤器。对于这 250 mL 的输注，液体负荷过重不是首要安全问题。","testTakingStrategyEn":"Focus on high-alert medication rules. Potassium must always be diluted, given via pump, and never pushed. Prioritize cardiac and local tissue safety.","testTakingStrategyZh":"专注于高危药物规则。钾必须始终稀释、通过输液泵输注，且绝不能推注。优先考虑心脏和局部组织的安全。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1113,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_ppt_ngn_2026_06_22_q3","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.836","itemType":"dropdown_cloze","category":"Pharmacological and Parenteral Therapies","topic":"Psychotropic Medications","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.836.stem.en","stemPathZh":"questions.836.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[64,115],"terminalOffsetsZh":[20,34],"fullStemEn":"A client with bipolar disorder is prescribed lithium carbonate. The nurse is providing dietary and safety teaching.","fullStemZh":"一名双相情感障碍患者开具了碳酸锂的医嘱。护士正在提供饮食和安全指导。","terminalSentenceEn":"The nurse is providing dietary and safety teaching.","terminalSentenceZh":"护士正在提供饮食和安全指导。","penultimateSentenceEn":"A client with bipolar disorder is prescribed lithium carbonate.","penultimateSentenceZh":"一名双相情感障碍患者开具了碳酸锂的医嘱。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The client is most at risk for lithium toxicity if they experience {{1}} because a low sodium level causes the kidneys to {{2}}.","zh":"如果患者发生 {{1}}，其发生锂中毒的风险最高，因为低钠水平会导致肾脏 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"dehydration or sodium depletion","zh":"脱水或钠流失"},{"id":"o2","en":"excessive fluid intake","zh":"液体摄入过多"},{"id":"o3","en":"a high-sodium diet","zh":"高钠饮食"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"excrete lithium more rapidly","zh":"更迅速地排泄锂"},{"id":"o3","en":"convert lithium into inactive metabolites","zh":"将锂转化为非活性代谢物"},{"id":"o1","en":"retain lithium and increase blood levels","zh":"滞留锂并增加其血药浓度"}],"correct":"o1"}]},"rationaleCorrectEn":"Lithium is a salt that is handled by the kidneys in a manner similar to sodium. If a client becomes dehydrated or has sodium depletion (due to sweating, vomiting, diarrhea, or low sodium intake), the kidneys attempt to conserve sodium. In doing so, they also retain lithium, which leads to increased lithium levels in the blood and toxicity. Clients must maintain consistent sodium and fluid intake.","rationaleCorrectZh":"锂是一种盐，肾脏处理锂的方式与钠相似。如果患者因出汗、呕吐、腹泻或低钠摄入而脱水或钠流失，肾脏会试图保留钠。在这个过程中，肾脏也会滞留锂，从而导致血液中锂浓度升高并产生毒性。患者必须保持稳定的钠和液体摄入。","testTakingStrategyEn":"Understand the reciprocal relationship between sodium and lithium in the kidneys. Low sodium equals high lithium retention.","testTakingStrategyZh":"理解肾脏中钠和锂的相互关系。低钠等于高锂滞留。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1114,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_ppt_ngn_2026_06_22_q4","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.837","itemType":"select_all","category":"Pharmacological and Parenteral Therapies","topic":"Parenteral Nutrition","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.837.stem.en","stemPathZh":"questions.837.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[152,174],"terminalOffsetsZh":[42,50],"fullStemEn":"A nurse is preparing to administer total parenteral nutrition (TPN) via a central venous catheter to a client. Which nursing interventions are correct? Select all that apply.","fullStemZh":"护士正准备通过中心静脉导管为患者输注全静脉营养（TPN）。哪些护理干预措施是正确的？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which nursing interventions are correct?","penultimateSentenceZh":"哪些护理干预措施是正确的？","responseContext":{"type":"select_all","options":[{"id":"D","en":"Change the TPN infusion bag and tubing every 24 hours.","zh":"每 24 小时更换一次 TPN 输液袋和管路。"},{"id":"F","en":"Check the client's blood glucose level every 4 to 6 hours.","zh":"每 4 至 6 小时监测一次患者的血糖水平。"},{"id":"C","en":"Infuse the TPN via a peripheral intravenous line if the central catheter is obstructed.","zh":"如果中心静脉导管阻塞，可通过外周静脉通路输注 TPN。"},{"id":"E","en":"Speed up the infusion rate if the schedule falls behind to catch up.","zh":"如果输液进度落后，应加快输注速度以赶上进度。"},{"id":"A","en":"Verify the TPN bag ingredients against the provider's prescription with a second registered nurse.","zh":"与第二名注册护士一起，核对 TPN 袋中的成分与医生的处方。"},{"id":"B","en":"Use an in-line 1.2-micron filter on the administration tubing.","zh":"在输液管路上使用 1.2 微米的管路过滤器。"}],"correct":["A","B","D","F"]},"rationaleCorrectEn":"TPN administration requires strict safety measures. The TPN bag must be verified against the prescription by two RNs. A 1.2-micron filter is required for TPN (especially containing lipids) to prevent particulates or emboli from entering the circulation. Tubing and bags must be changed every 24 hours to prevent bacterial growth in the nutrient-rich fluid. Blood glucose must be monitored frequently (every 4-6 hours) due to the high dextrose content. TPN is highly hypertonic and cannot be run through a peripheral line due to phlebitis risk; 10% dextrose (D10W) is infused if TPN is temporarily unavailable. The rate should never be increased to 'catch up' as it causes severe hyperglycemia.","rationaleCorrectZh":"TPN 输注要求采取严格的安全措施。TPN 输液袋必须由两名注册护士与处方核对。TPN（尤其是含有脂肪乳的制剂）需要使用 1.2 微米过滤器，以防微粒或栓子进入血液循环。输液袋和管路必须每 24 小时更换一次，以防止富含营养的液体中细菌滋生。由于葡萄糖含量高，必须密切监测血糖（每 4-6 小时一次）。TPN 是高渗性的，因存在静脉炎风险，不能通过外周静脉输注；如果 TPN 暂时不可用，可输注 10% 葡萄糖（D10W）。绝不能为了“赶进度”而调快输注速度，因为这会导致严重的高血糖。","testTakingStrategyEn":"TPN is high-dextrose and high-osmolarity. Remember rules: central line only, check sugar, change bag/tubing daily, use a filter, and never catch up on missed flow rates.","testTakingStrategyZh":"TPN 具有高糖和高渗透压的特点。记住规则：仅限中心静脉、监测血糖、每日更换输液袋/管路、使用过滤器，且绝不能补追落后的输液速度。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1115,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_ppt_ngn_2026_06_22_q5","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.838","itemType":"highlight","category":"Pharmacological and Parenteral Therapies","topic":"Cardiovascular & Endocrine Medications","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.838.stem.en","stemPathZh":"questions.838.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[103,196],"terminalOffsetsZh":[36,56],"fullStemEn":"A nurse is evaluating a client diagnosed with heart failure who has been taking digoxin 0.25 mg daily. Highlight the findings in the assessment that are manifestations of current digoxin toxicity.","fullStemZh":"护士正在评估一名诊断为心力衰竭且每日服用地高辛 0.25 mg 的患者。标出评估中属于当前地高辛中毒表现的发现。","terminalSentenceEn":"Highlight the findings in the assessment that are manifestations of current digoxin toxicity.","terminalSentenceZh":"标出评估中属于当前地高辛中毒表现的发现。","penultimateSentenceEn":"A nurse is evaluating a client diagnosed with heart failure who has been taking digoxin 0.25 mg daily.","penultimateSentenceZh":"护士正在评估一名诊断为心力衰竭且每日服用地高辛 0.25 mg 的患者。","responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"0900 nursing assessment:","zh":"0900 护理评估："},{"id":"s2","en":"The client reports a new onset of nausea, loss of appetite, and abdominal discomfort.","zh":"患者诉新出现恶心、食欲丧失和腹部不适。","selectable":true},{"id":"s3","en":"The client describes seeing unusual yellow-green halos around the lights in the room.","zh":"患者描述看到房间里的灯光周围有异常的黄绿色光晕。","selectable":true},{"id":"s4","en":"The client's apical heart rate is 52 beats/minute.","zh":"患者的心尖心率为 52 次/分钟。","selectable":true},{"id":"s5","en":"The client's blood pressure is 112/68 mmHg.","zh":"患者的血压为 112/68 mmHg。","selectable":true},{"id":"s6","en":"The serum potassium level is reported as 3.2 mEq/L (reference range: 3.5-5.0 mEq/L).","zh":"报告血清钾水平为 3.2 mEq/L（参考范围：3.5-5.0 mEq/L）。","selectable":true}],"correct":["s2","s3","s4"]}},"rationaleCorrectEn":"Digoxin toxicity is characterized by gastrointestinal symptoms (nausea, anorexia, abdominal pain - s2), visual disturbances (yellow-green halos, blurred vision - s3), and cardiac dysrhythmias, most commonly bradycardia (apical heart rate < 60/min - s4). Hypokalemia (3.2 mEq/L - s6) is not a symptom/indicator of toxicity itself, but rather a predisposing factor that increases the risk of developing digoxin toxicity. Blood pressure (s5) is stable and not a primary indicator of digoxin toxicity.","rationaleCorrectZh":"地高辛中毒的特点是胃肠道症状（恶心、食欲减退、腹痛 - s2）、视觉障碍（黄绿色光晕、视物模糊 - s3）以及心脏心律失常，最常见的是心动过缓（心尖心率 < 60 次/分钟 - s4）。低钾血症（3.2 mEq/L - s6）本身不是地高辛中毒的症状/指标，而是一个诱发因素，会增加发生地高辛中毒的风险。血压（s5）稳定，不是地高辛中毒的首要指标。","testTakingStrategyEn":"Differentiate between the symptoms of toxicity (nausea, halos, bradycardia) and the clinical risk factors (hypokalemia) that potentiate toxicity.","testTakingStrategyZh":"区分中毒的症状（恶心、光晕、心动过缓）与诱发中毒的临床风险因素（低钾血症）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1116,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_ppt_ngn_2026_06_22_q6","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.839","itemType":"bowtie","category":"Pharmacological and Parenteral Therapies","topic":"Medication Safety & Admin","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.839.stem.en","stemPathZh":"questions.839.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[262,398],"terminalOffsetsZh":[96,136],"fullStemEn":"A client is prescribed intravenous vancomycin 1,500 mg to be infused over 60 minutes for a severe MRSA infection. During the first 15 minutes of the infusion, the client develops intense flushing, pruritus, and a red rash across the face, neck, and upper torso. Select the primary clinical complication, two priority nursing actions, and two clinical parameters to monitor to manage this situation.","fullStemZh":"一患者因严重 MRSA 感染被开具静脉注射万古霉素 1,500 mg、要求输注时间超过 60 分钟的医嘱。在输注开始的前 15 分钟内，患者的面部、颈部和上躯干出现强烈的潮红、瘙痒和红色皮疹。请选择首要的临床并发症、两项优先护理措施以及两个要监测的临床参数来处理这种情况。","terminalSentenceEn":"Select the primary clinical complication, two priority nursing actions, and two clinical parameters to monitor to manage this situation.","terminalSentenceZh":"请选择首要的临床并发症、两项优先护理措施以及两个要监测的临床参数来处理这种情况。","penultimateSentenceEn":"During the first 15 minutes of the infusion, the client develops intense flushing, pruritus, and a red rash across the face, neck, and upper torso.","penultimateSentenceZh":"在输注开始的前 15 分钟内，患者的面部、颈部和上躯干出现强烈的潮红、瘙痒和红色皮疹。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Primary clinical complication","zh":"首要的临床并发症"},"tokens":[{"id":"cond_steven","en":"Stevens-Johnson syndrome onset.","zh":"史蒂文斯-约翰逊综合征急性发作。"},{"id":"cond_redman","en":"Vancomycin Flushing Syndrome (Red Man Syndrome) from rapid infusion.","zh":"因输注速度过快引起的万古霉素潮红综合征（红人综合征）。"},{"id":"cond_anaphylaxis","en":"Type 1 IgE-mediated anaphylactic reaction.","zh":"1 型 IgE 介导的过敏性反应。"}],"correct":"cond_redman"},"actions":{"prompt":{"en":"Priority nursing actions","zh":"优先护理措施"},"tokens":[{"id":"act_epinephrine","en":"Administer intramuscular epinephrine immediately.","zh":"立即肌肉注射肾上腺素。"},{"id":"act_stop_slow","en":"Stop the infusion temporarily and resume at a slower rate.","zh":"暂时停止输注，并以更慢的速度重新开始。"},{"id":"act_antihistamine","en":"Administer the prescribed diphenhydramine (antihistamine) as ordered.","zh":"按医嘱给予开具的苯海拉明（抗组胺药）。"},{"id":"act_increase","en":"Increase the infusion rate to clear the medication quickly.","zh":"调快输注速度以快速输完药物。"}],"correct":["act_stop_slow","act_antihistamine"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"需要监测的参数"},"tokens":[{"id":"param_liver","en":"Liver enzyme levels (AST and ALT).","zh":"肝酶水平（AST 和 ALT）。"},{"id":"param_skin","en":"Progression of the rash and resolution of flushing.","zh":"皮疹的进展和潮红的消退情况。"},{"id":"param_bp","en":"Blood pressure and hemodynamic stability.","zh":"血压和血流动力学稳定性。"},{"id":"param_calcium","en":"Serum ionized calcium levels.","zh":"血清游离钙水平。"}],"correct":["param_bp","param_skin"]}}},"rationaleCorrectEn":"Vancomycin Flushing Syndrome (Red Man Syndrome) is a rate-dependent infusion reaction, not a true allergy, caused by rapid infusion of vancomycin which triggers histamine release. It presents as flushing, itching, and a red rash on the upper body. The nurse should stop the infusion, administer an antihistamine (diphenhydramine), and resume the infusion at a slower rate (usually over 2 hours). True anaphylaxis requires epinephrine, which is not indicated here unless wheezing, airway compromise, or shock occurs. The nurse must monitor blood pressure (as rapid infusion can cause hypotension) and the skin rash progression.","rationaleCorrectZh":"万古霉素潮红综合征（红人综合征）是一种与滴速相关的输注反应，并非真正的过敏反应，由万古霉素输注过快触发组胺释放引起。表现为上半身潮红、瘙痒和红色皮疹。护士应暂停输注，给予抗组胺药（苯海拉明），然后以较慢的速度（通常输注 2 小时以上）重新开始。真正的过敏性休克需要肾上腺素，此处无此指征，除非出现喘鸣、气道受损或休克。护士必须监测血压（因为快速输注会导致低血压）和皮疹进展。","testTakingStrategyEn":"Recognize that 'Red Man Syndrome' is managed by slowing the infusion rate and giving antihistamines, unlike anaphylaxis which requires epinephrine and permanent discontinuation.","testTakingStrategyZh":"认识到“红人综合征”是通过减慢输注速度和给予抗组胺药来处理的，这与需要使用肾上腺素并永久停药的过敏性休克不同。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1117,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_ppt_ngn_2026_06_22_q7","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.840","itemType":"dropdown_cloze","category":"Pharmacological and Parenteral Therapies","topic":"Medication Safety & Admin","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.840.stem.en","stemPathZh":"questions.840.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[100,186],"terminalOffsetsZh":[33,53],"fullStemEn":"A client with persistent asthma is prescribed fluticasone propionate by metered-dose inhaler daily. The nurse is teaching the client about self-administration and side effect prevention.","fullStemZh":"一名持续性哮喘患者开具了每日使用定量吸入器吸入丙酸氟替卡松的医嘱。护士正在指导患者自我给药以及预防副作用。","terminalSentenceEn":"The nurse is teaching the client about self-administration and side effect prevention.","terminalSentenceZh":"护士正在指导患者自我给药以及预防副作用。","penultimateSentenceEn":"A client with persistent asthma is prescribed fluticasone propionate by metered-dose inhaler daily.","penultimateSentenceZh":"一名持续性哮喘患者开具了每日使用定量吸入器吸入丙酸氟替卡松的医嘱。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"To prevent {{1}}, the nurse should instruct the client to {{2}} after each use of the inhaler.","zh":"为预防 {{1}}，护士应指导患者在每次使用吸入器后 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"oral candidiasis (thrush)","zh":"口腔念珠菌病（鹅口疮）"},{"id":"o2","en":"rebound bronchospasm","zh":"反跳性支气管痉挛"},{"id":"o3","en":"systemic hypertension","zh":"全身性高血压"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"use a spacer and swallow the remaining particles","zh":"使用储雾罐并吞下残留微粒"},{"id":"o3","en":"avoid eating or drinking for 2 hours","zh":"在 2 小时内避免进食或饮水"},{"id":"o1","en":"rinse the mouth with water and spit it out","zh":"用水漱口并吐出来"}],"correct":"o1"}]},"rationaleCorrectEn":"Fluticasone is an inhaled corticosteroid. Local deposition of the steroid in the oral cavity can suppress local immunity, leading to the overgrowth of Candida albicans (oral thrush). Rinsing the mouth thoroughly with water and spitting it out after each use removes residual medication from the oral mucosa, preventing thrush. Swallowing the water or remaining particles increases systemic absorption and side effects. Eating/drinking restrictions are not required.","rationaleCorrectZh":"氟替卡松是一种吸入性皮质类固醇。类固醇在口腔内的局部沉积会抑制局部免疫，导致白色念珠菌过度生长（鹅口疮）。每次使用后用水彻底漱口并吐出，可以清除口腔粘膜上残留的药物，从而预防鹅口疮。吞下水或残留颗粒会增加全身吸收和副作用。不需要限制进食/饮水。","testTakingStrategyEn":"Connect inhaled corticosteroids with the risk of thrush (fungal infection) and the mandatory intervention of rinsing and spitting.","testTakingStrategyZh":"将吸入性皮质类固醇与鹅口疮（真菌感染）的风险以及漱口并吐出的强制性干预措施联系起来。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1118,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_ppt_ngn_2026_06_22_q8","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.841","itemType":"select_all","category":"Pharmacological and Parenteral Therapies","topic":"Anticoagulant Therapy","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.841.stem.en","stemPathZh":"questions.841.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[174,196],"terminalOffsetsZh":[40,48],"fullStemEn":"A client is being discharged home with a new prescription for warfarin sodium after experiencing a pulmonary embolism. Which discharge instructions should the nurse include? Select all that apply.","fullStemZh":"一名发生肺栓塞的患者在出院时开具了新的口服华法林钠处方。护士应包括哪些出院指导？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which discharge instructions should the nurse include?","penultimateSentenceZh":"护士应包括哪些出院指导？","responseContext":{"type":"select_all","options":[{"id":"E","en":"Avoid all intake of alcohol as it can alter warfarin metabolism.","zh":"避免所有酒精摄入，因为酒精会改变华法林的代谢。"},{"id":"A","en":"Keep intake of green leafy vegetables containing vitamin K consistent.","zh":"保持含有维生素 K 的绿叶蔬菜的摄入量稳定。"},{"id":"D","en":"Report any dark, tarry stools or unexplained bruising immediately.","zh":"立即汇报任何黑色柏油样便或不明原因的瘀斑。"},{"id":"C","en":"Take aspirin or ibuprofen for mild headache or joint pain.","zh":"出现轻度头痛或关节痛时可服用阿司匹林或布洛芬。"},{"id":"F","en":"Stop taking the warfarin if any bleeding occurs and resume when it resolves.","zh":"如果发生任何出血，应停止服用华法林，并在出血解决后恢复。"},{"id":"B","en":"Use a soft-bristled toothbrush to prevent bleeding gums.","zh":"使用软毛牙刷以防止牙龈出血。"}],"correct":["A","B","D","E"]},"rationaleCorrectEn":"Warfarin discharge teaching must emphasize bleeding precautions, dietary consistency, drug-drug interactions, and laboratory monitoring. Vitamin K is the antidote; a sudden change in vitamin K intake alters warfarin's effectiveness, so intake must remain consistent. Soft toothbrushes prevent gum trauma. Unexplained bruising or black tarry stools (melena) indicate internal hemorrhage and must be reported. Alcohol affects warfarin metabolism and increases bleeding risk, so it should be avoided. Aspirin and ibuprofen (NSAIDs) increase bleeding risk and are contraindicated. The client should never stop warfarin without consulting the provider.","rationaleCorrectZh":"华法林出院指导必须强调出血预防措施、饮食一致性、药物相互作用和实验室监测。维生素 K 是解毒剂；维生素 K 摄入量的突然改变会改变华法林的疗效，因此摄入量必须保持稳定。软毛牙刷可防止牙龈外伤。不明原因的瘀斑或黑色柏油样便（黑便）提示内部出血，必须报告。酒精会影响华法林代谢并增加出血风险，因此应避免。阿司匹林和布洛芬（NSAIDs）会增加出血风险，属于禁忌。患者在没有咨询医生的情况下绝不能自行停用华法林。","testTakingStrategyEn":"Remember the dietary rule for warfarin: 'consistency' of Vitamin K, not elimination. Avoid NSAIDs/aspirin, and look for signs of abnormal bleeding.","testTakingStrategyZh":"记住华法林的饮食规则：维生素 K 的“摄入量一致”，而非完全不吃。避免 NSAIDs/阿司匹林，并寻找异常出血的迹象。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1119,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_ppt_ngn_2026_06_22_q9","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.842","itemType":"bowtie","category":"Pharmacological and Parenteral Therapies","topic":"Psychotropic Medications","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.842.stem.en","stemPathZh":"questions.842.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[117,228],"terminalOffsetsZh":[39,73],"fullStemEn":"A client is prescribed phenelzine sulfate, a monoamine oxidase inhibitor (MAOI), for treatment-resistant depression. Select the primary clinical complication, two priority nursing actions, and two clinical parameters to monitor.","fullStemZh":"一名难治性抑郁症患者开具了硫酸苯乙肼（一种单胺氧化酶抑制剂，MAOI）的医嘱。请选择首要的临床并发症、两项优先护理措施以及两个需要监测的临床参数。","terminalSentenceEn":"Select the primary clinical complication, two priority nursing actions, and two clinical parameters to monitor.","terminalSentenceZh":"请选择首要的临床并发症、两项优先护理措施以及两个需要监测的临床参数。","penultimateSentenceEn":"A client is prescribed phenelzine sulfate, a monoamine oxidase inhibitor (MAOI), for treatment-resistant depression.","penultimateSentenceZh":"一名难治性抑郁症患者开具了硫酸苯乙肼（一种单胺氧化酶抑制剂，MAOI）的医嘱。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Primary clinical complication","zh":"首要的临床并发症"},"tokens":[{"id":"cond_serotonin","en":"Serotonin syndrome from dietary phenylalanine.","zh":"饮食中苯丙氨酸引起的 5-羟色胺综合征。"},{"id":"cond_hypertensive","en":"Hypertensive crisis due to tyramine ingestion.","zh":"因摄入酪胺引起的高血压危象。"},{"id":"cond_tardive","en":"Tardive dyskinesia from receptor blockade.","zh":"受体阻滞引起的迟发性运动障碍。"}],"correct":"cond_hypertensive"},"actions":{"prompt":{"en":"Priority actions to take","zh":"应采取的优先措施"},"tokens":[{"id":"act_restrict_water","en":"Restrict daily fluid intake to 1,000 mL to prevent hyponatremia.","zh":"限制每日液体摄入量在 1,000 mL 内以预防低钠血症。"},{"id":"act_avoid_tyramine","en":"Instruct the client to avoid aged cheese, cured meats, and draft beer.","zh":"指导患者避免食用陈年奶酪、腌制肉类和生啤酒。"},{"id":"act_give_tyramine","en":"Encourage eating foods high in tyramine to maintain enzymatic balance.","zh":"鼓励食用高酪胺食品以维持酶的平衡。"},{"id":"act_check_otc","en":"Teach the client to consult the pharmacist before taking any OTC cold medications.","zh":"指导患者在服用任何非处方（OTC）感冒药前咨询药剂师。"}],"correct":["act_avoid_tyramine","act_check_otc"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"需要监测的参数"},"tokens":[{"id":"param_renal","en":"Creatinine and glomerular filtration rate.","zh":"肌酐和肾小球滤过率。"},{"id":"param_bp","en":"Blood pressure and presence of severe headaches.","zh":"血压以及是否出现严重头痛。"},{"id":"param_vision","en":"Visual acuity and pupil responses.","zh":"视力和瞳孔反应。"},{"id":"param_liver","en":"Serum transaminases (AST/ALT) periodically.","zh":"定期监测血清转氨酶（AST/ALT）。"}],"correct":["param_bp","param_liver"]}}},"rationaleCorrectEn":"MAOIs like phenelzine prevent the breakdown of tyramine. Ingestion of tyramine-rich foods (aged cheese, cured/aged meats, red wine, draft beer) can lead to severe vasoconstriction and a life-threatening hypertensive crisis. Many OTC cold/cough medications contain sympathomimetics (like pseudoephedrine) that act synergistically to cause severe hypertension, so they must be checked. The nurse must monitor blood pressure and report severe headaches (a primary symptom of hypertensive crisis). Periodic liver enzyme monitoring (AST/ALT) is also required as MAOIs carry risks of hepatotoxicity. Renal function and vision are not primary parameters.","rationaleCorrectZh":"像苯乙肼这样的 MAOIs 会阻止酪胺的分解。摄入富含酪胺的食物（陈年奶酪、肉类、红葡萄酒、生啤酒）会导致严重的血管收缩和危及生命的高血压危象。许多非处方（OTC）感冒/咳嗽药含有拟交感神经药（如伪麻黄碱），会产生协同作用导致严重高血压，因此必须核对。护士必须监测血压并汇报严重头痛（高血压危象的首要症状）。由于 MAOIs 具有肝毒性风险，还需要定期监测肝功能酶（AST/ALT）。肾功能和视力不是首要的监测参数。","testTakingStrategyEn":"Associate MAOIs (phenelzine, tranylcypromine, isocarboxazid) with the strict low-tyramine diet (avoid aged cheese, cured meats) and pseudoephedrine interactions to prevent hypertensive crisis.","testTakingStrategyZh":"将 MAOIs（苯乙肼、反苯环丙胺、异卡波肼）与严格的低酪胺饮食（避免陈年奶酪、熏肉）和伪麻黄碱相互作用联系起来，以预防高血压危象。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1120,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_ppt_ngn_2026_06_22_q10","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.843","itemType":"highlight","category":"Pharmacological and Parenteral Therapies","topic":"Medication Safety & Admin","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.843.stem.en","stemPathZh":"questions.843.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[74,195],"terminalOffsetsZh":[21,46],"fullStemEn":"A nurse is preparing and administering insulin to a client with diabetes. Highlight the actions or decisions by the nurse that violate safety guidelines for insulin preparation or administration.","fullStemZh":"护士正在为一名糖尿病患者配制和注射胰岛素。标出护士违反胰岛素配制或注射安全规范的行为或决定。","terminalSentenceEn":"Highlight the actions or decisions by the nurse that violate safety guidelines for insulin preparation or administration.","terminalSentenceZh":"标出护士违反胰岛素配制或注射安全规范的行为或决定。","penultimateSentenceEn":"A nurse is preparing and administering insulin to a client with diabetes.","penultimateSentenceZh":"护士正在为一名糖尿病患者配制和注射胰岛素。","responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"1630 insulin preparation note:","zh":"1630 胰岛素配制记录："},{"id":"s2","en":"The nurse draws up 6 units of regular insulin and 12 units of NPH insulin in a single syringe, drawing the NPH insulin first.","zh":"护士在单支注射器中抽取 6 单位常规胰岛素（普通胰岛素）和 12 单位 NPH 胰岛素，先抽取 NPH 胰岛素。","selectable":true},{"id":"s3","en":"The nurse mixes insulin glargine and insulin lispro in the same syringe to reduce the number of injections.","zh":"护士将甘精胰岛素和赖脯胰岛素混合在同一注射器中，以减少注射次数。","selectable":true},{"id":"s4","en":"The nurse asks a second registered nurse to independently verify the insulin types and doses drawn in the syringe.","zh":"护士请第二名注册护士独立核对注射器中抽取的胰岛素类型和剂量。","selectable":true},{"id":"s5","en":"The nurse selects the abdomen for the subcutaneous injection site.","zh":"护士选择腹部作为皮下注射部位。","selectable":true},{"id":"s6","en":"The nurse vigorously rubs the injection site with an alcohol swab immediately after injecting the insulin.","zh":"注射胰岛素后，护士立即用酒精棉签用力按揉注射部位。","selectable":true}],"correct":["s2","s3","s6"]}},"rationaleCorrectEn":"Violations of insulin safety guidelines include: 1) Drawing NPH insulin before regular insulin; the correct sequence is 'clear before cloudy' (regular before NPH) to prevent contaminating the regular vial with NPH. 2) Mixing insulin glargine (Lantus - a long-acting insulin) with any other insulin in the same syringe; glargine is acidic and must never be mixed. 3) Vigorously rubbing the injection site after administration; rubbing increases the absorption rate of the insulin unpredictably, leading to hypoglycemia. Second nurse verification and using the abdomen for subcutaneous injection are correct safety practices.","rationaleCorrectZh":"违反胰岛素安全指南的行为包括：1) 先抽取 NPH 胰岛素再抽取常规胰岛素；正确的顺序是“先清后浊”（常规先于 NPH），以防 NPH 污染常规胰岛素小瓶。2) 将甘精胰岛素（Lantus - 一种长效胰岛素）与任何其他胰岛素混合在同一注射器中；甘精胰岛素是酸性的，绝不能与其他胰岛素混合。3) 注射后用力按揉注射部位；按揉会不可预测地加快胰岛素的吸收速度，导致低血糖。双人核对和选择腹部进行皮下注射是正确的安全做法。","testTakingStrategyEn":"Remember: draw 'clear before cloudy' (Regular before NPH), never mix long-acting glargine/detemir with any other insulin, and never rub the site after injection.","testTakingStrategyZh":"记住：抽取时“先清后浊”（常规先于 NPH），绝不能将长效甘精/地特胰岛素与任何其他胰岛素混合，且注射后绝不能按揉部位。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1121,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_moc_ngn_2026_06_22_q1","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.844","itemType":"highlight","category":"Management of Care","topic":"Prioritization & Delegation","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.844.stem.en","stemPathZh":"questions.844.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[52,168],"terminalOffsetsZh":[15,44],"fullStemEn":"A nurse receives the shift report for four clients. Highlight the clinical findings or client descriptions that represent the highest priority for immediate assessment.","fullStemZh":"护士收到了四名患者的班次报告。标出代表需要立即进行评估的最高优先级的临床发现或患者描述。","terminalSentenceEn":"Highlight the clinical findings or client descriptions that represent the highest priority for immediate assessment.","terminalSentenceZh":"标出代表需要立即进行评估的最高优先级的临床发现或患者描述。","penultimateSentenceEn":"A nurse receives the shift report for four clients.","penultimateSentenceZh":"护士收到了四名患者的班次报告。","responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"0700 shift report:","zh":"0700 班次报告："},{"id":"s2","en":"A 45-year-old client who is 2 hours post-operative thyroidectomy and reports a feeling of tightness in the throat.","zh":"一名甲状腺切除术后 2 小时的 45 岁患者，主诉喉部有紧缩感。","selectable":true},{"id":"s3","en":"A 62-year-old client with chronic obstructive pulmonary disease (COPD) whose oxygen saturation is 89% on room air.","zh":"一名 62 岁慢性阻塞性肺疾病（COPD）患者，在未吸氧（吸入空气）时的血氧饱和度为 89%。","selectable":true},{"id":"s4","en":"A 35-year-old client with type 1 diabetes who has a pre-meal blood glucose level of 140 mg/dL.","zh":"一名 35 岁 1 型糖尿病患者，餐前血糖水平为 140 mg/dL。","selectable":true},{"id":"s5","en":"A 78-year-old client with a history of dementia who is awake, alert, and demanding to be discharged immediately.","zh":"一名有痴呆史的 78 岁患者，神志清醒，注意力集中，并要求立即出院。","selectable":true}],"correct":["s2"]}},"rationaleCorrectEn":"Tightness in the throat after a thyroidectomy is a critical indicator of potential airway obstruction caused by hemorrhage or laryngeal edema. This is a life-threatening airway concern (ABC priority) that requires immediate intervention. A COPD client's oxygen saturation of 88-92% is expected and stable. A blood glucose of 140 mg/dL is slightly elevated but not an emergency. A dementia client demanding discharge is a common behavioral finding that does not take priority over a compromised airway.","rationaleCorrectZh":"甲状腺切除术后出现喉部紧缩感是因出血或喉头水肿导致潜在气道阻塞的关键指标。这是一个危及生命的气道问题（ABC 优先顺序），需要立即干预。COPD 患者在吸入空气时的血氧饱和度为 88-92% 是预期内的且稳定的。140 mg/dL 的血糖水平略有升高，但不是紧急情况。痴呆患者要求出院是常见的行为表现，其优先级低于气道受损。","testTakingStrategyEn":"Apply the ABCs (Airway, Breathing, Circulation) framework. Airway obstruction is always the highest priority.","testTakingStrategyZh":"应用 ABC（气道、呼吸、循环）框架。气道阻塞始终是最高优先级的指标。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1122,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_moc_ngn_2026_06_22_q2","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.845","itemType":"bowtie","category":"Management of Care","topic":"Legal & Ethical Principles","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.845.stem.en","stemPathZh":"questions.845.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[238,418],"terminalOffsetsZh":[65,114],"fullStemEn":"A client scheduled for an elective laparoscopic cholecystectomy is in the pre-operative holding area. The nurse notes that the client received a dose of pre-operative midazolam 30 minutes ago, but the surgical consent form is not signed. Select the most appropriate legal action for the nurse to perform, two priority actions the nurse must take, and two clinical parameters/actions the nurse should monitor or verify.","fullStemZh":"一名计划进行择期腹腔镜胆囊切除术的患者正在术前等待区。护士注意到患者在 30 分钟前接受了一剂术前咪达唑仑，但手术同意书尚未签署。请选择护士应执行的最佳法定应对，两项护士必须采取的优先措施，以及两个应监测或核实的临床参数或措施。","terminalSentenceEn":"Select the most appropriate legal action for the nurse to perform, two priority actions the nurse must take, and two clinical parameters/actions the nurse should monitor or verify.","terminalSentenceZh":"请选择护士应执行的最佳法定应对，两项护士必须采取的优先措施，以及两个应监测或核实的临床参数或措施。","penultimateSentenceEn":"The nurse notes that the client received a dose of pre-operative midazolam 30 minutes ago, but the surgical consent form is not signed.","penultimateSentenceZh":"护士注意到患者在 30 分钟前接受了一剂术前咪达唑仑，但手术同意书尚未签署。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Most appropriate legal action","zh":"最合适的法定应对"},"tokens":[{"id":"cond_dpoa","en":"Have the client's spouse sign the consent form under emergency guidelines.","zh":"根据紧急指南让患者配偶签署同意书。"},{"id":"cond_cancel","en":"Notify the surgeon that the consent cannot be legally obtained at this time.","zh":"通知外科医生，此时在法律上无法获得签字同意。"},{"id":"cond_sign_now","en":"Obtain the client's signature immediately before the sedative effect peaks.","zh":"在镇静作用达到顶峰前立即获取患者的签字。"}],"correct":"cond_cancel"},"actions":{"prompt":{"en":"Priority actions to take","zh":"应采取的优先措施"},"tokens":[{"id":"act_document_med","en":"Document the administration of midazolam and the unsigned consent in the chart.","zh":"在病历中记录咪达唑仑的给药情况及未签字的同意书。"},{"id":"act_notify_charge","en":"Inform the charge nurse and the surgical coordinator of the delay.","zh":"将此次手术延误通知值班护士和手术协调员。"},{"id":"act_ask_surgeon","en":"Instruct the surgeon to explain the procedure to the spouse for telephone consent.","zh":"指导外科医生向配偶解释手术过程，以获取电话同意。"},{"id":"act_witness_anyway","en":"Witness the consent form signature if the client states they feel alert.","zh":"如果患者表示感觉清醒，依然为同意书签字作证。"}],"correct":["act_notify_charge","act_document_med"]},"parameters":{"prompt":{"en":"Parameters to monitor or verify","zh":"需监测或核实的参数"},"tokens":[{"id":"param_insurance","en":"Client's pre-authorization status for the surgical procedure.","zh":"患者该手术的预先授权状态。"},{"id":"param_time","en":"Time elapsed since the midazolam administration.","zh":"咪达唑仑给药后过去的时间。"},{"id":"param_type","en":"The specific surgical equipment settings for the cholecystectomy.","zh":"胆囊切除术的具体手术设备设置。"},{"id":"param_level","en":"Client's level of consciousness and sedation score.","zh":"患者的意识水平和镇静评分。"}],"correct":["param_level","param_time"]}}},"rationaleCorrectEn":"Informed consent is not legally valid if obtained after a client has received sedatives or cognitive-altering medications (like midazolam). The nurse must notify the surgeon because consent cannot be legally signed by the client under sedation. Priority nursing actions include informing the chain of command (charge nurse) and documenting the clinical facts. The nurse should monitor the client's level of consciousness and sedation score, as well as tracking the time elapsed to determine when the sedative will wear off so consent can be properly obtained later. The spouse cannot sign unless the client lacks decision-making capacity and the spouse is the designated DPOA, which is not indicated for an elective procedure. The nurse cannot witness the signature of a sedated client.","rationaleCorrectZh":"如果患者在接受镇静剂或影响认知的药物（如咪达唑仑）后签署知情同意书，在法律上是无效的。护士必须通知外科医生，因为处于镇静状态下的患者无法合法签署同意书。护士的优先措施包括通知链条（值班护士）并在病历中记录临床事实。护士应监测患者的意识水平和镇静评分，并追踪给药后过去的时间，以确定镇静药物何时代谢完毕，以便随后正确获取同意。配偶不能直接代签，除非患者丧失决策能力且配偶是指定的医疗代理人（DPOA），而该患者是择期手术。护士不能为镇静患者的签字作证。","testTakingStrategyEn":"Remember that client safety and legal validity dictate that informed consent must be signed prior to receiving any mind-altering medications.","testTakingStrategyZh":"记住，患者安全和法律有效性规定，知情同意书必须在接受任何改变心智意识的药物之前签署。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1123,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_moc_ngn_2026_06_22_q3","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.846","itemType":"dropdown_cloze","category":"Management of Care","topic":"Confidentiality & HIPAA","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.846.stem.en","stemPathZh":"questions.846.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,187],"terminalOffsetsZh":[0,60],"fullStemEn":"A nurse takes a photograph of a client's unusual surgical wound healing process on a personal mobile device and shares it in a private professional chat group without patient identifiers.","fullStemZh":"护士用个人手机拍摄了患者不寻常的手术伤口愈合过程照片，并在不包含患者身份信息的情况下，将其分享在一个私密的专业聊天群中。","terminalSentenceEn":"A nurse takes a photograph of a client's unusual surgical wound healing process on a personal mobile device and shares it in a private professional chat group without patient identifiers.","terminalSentenceZh":"护士用个人手机拍摄了患者不寻常的手术伤口愈合过程照片，并在不包含患者身份信息的情况下，将其分享在一个私密的专业聊天群中。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"This action constitutes a violation of {{1}} because the nurse used {{2}}.","zh":"此行为构成了对 {{1}} 的违反，因为护士使用了 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"HIPAA confidentiality regulations","zh":"HIPAA 保密规定"},{"id":"o3","en":"professional practice boundaries","zh":"专业执业边界"},{"id":"o2","en":"informed consent guidelines","zh":"知情同意指南"}],"correct":"o1"},{"id":"2","options":[{"id":"o3","en":"the hospital's secure network connection","zh":"医院的安全网络连接"},{"id":"o1","en":"a personal electronic device without written authorization","zh":"未经书面授权的个人电子设备"},{"id":"o2","en":"a professional clinical photo application","zh":"专业的临床照片应用程序"}],"correct":"o1"}]},"rationaleCorrectEn":"Under HIPAA regulations, capturing patient clinical photos on a personal device without explicit, written institutional and client authorization is a strict violation of confidentiality. Even if direct patient identifiers (like name or medical record number) are omitted, the wound image itself can be considered identifying, and transmission over personal networks is insecure. Using a personal electronic device violates policy.","rationaleCorrectZh":"根据 HIPAA 规定，在没有机构和患者明确书面授权的情况下，用个人设备拍摄患者的临床照片属于严重的违反保密规定行为。即使省去了直接的患者身份信息（如姓名或病历号），伤口图像本身也可能被视为识别特征，且通过个人网络传输是不安全的。使用个人电子设备违反了管理规定。","testTakingStrategyEn":"Recognize that patient privacy is absolute. Any clinical photo taken on a personal device is a violation of HIPAA, regardless of whether identifiers are removed or if the group is private.","testTakingStrategyZh":"认识到患者隐私是绝对的。任何在个人设备上拍摄的临床照片均违反 HIPAA 规定，无论是否去除了身份标识或该群组是否私密。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1124,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_moc_ngn_2026_06_22_q4","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.847","itemType":"select_all","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.847.stem.en","stemPathZh":"questions.847.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[166,188],"terminalOffsetsZh":[46,54],"fullStemEn":"The nurse is preparing to transfer a client to a long-term care facility. Which components must the nurse include in the handoff report to ensure continuity of care? Select all that apply.","fullStemZh":"护士正准备将患者转运至长期照护机构。为了确保照护的连续性，护士在交接报告中必须包括哪些内容？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which components must the nurse include in the handoff report to ensure continuity of care?","penultimateSentenceZh":"为了确保照护的连续性，护士在交接报告中必须包括哪些内容？","responseContext":{"type":"select_all","options":[{"id":"C","en":"The client's complete financial and billing history.","zh":"患者完整的财务和账单历史。"},{"id":"A","en":"The client's current vital signs and mental status.","zh":"患者当前的生命体征和精神状态。"},{"id":"D","en":"A list of recently administered medications and the last dose times.","zh":"最近给予的药物清单及最后一次给药时间。"},{"id":"B","en":"The date of the client's next scheduled physical therapy session.","zh":"患者下一次安排的物理治疗日期。"},{"id":"F","en":"The nurse's personal opinions about the client's family dynamics.","zh":"护士对患者家庭关系的个人看法。"},{"id":"E","en":"The client's primary medical diagnoses and allergy profile.","zh":"患者的主要医学诊断和过敏史。"}],"correct":["A","D","E"]},"rationaleCorrectEn":"A safe handoff report must focus on objective clinical data to ensure continuity of care. This includes current clinical status (vital signs, mental status), current treatments (recent medications and timing), and background medical history (diagnoses, allergies). Date of physical therapy sessions at the new facility is scheduled by that facility, billing history is administrative and not clinical handoff, and personal opinions about family dynamics are non-objective and inappropriate for handoff.","rationaleCorrectZh":"安全的交接报告必须侧重于客观临床数据，以确保照护的连续性。这包括当前的临床状态（生命体征、精神状态）、当前的治疗情况（最近给予的药物及时间）和背景医疗史（诊断、过敏）。在新机构进行物理治疗的日期由该机构自行安排，账单历史属于行政管理事务而非临床交接内容，而对家庭关系的个人主观意见是不客观的，且不适合用于交接报告。","testTakingStrategyEn":"Differentiate between objective clinical information (vitals, diagnoses, medication times) and administrative data or subjective personal remarks.","testTakingStrategyZh":"区分客观临床信息（生命体征、诊断、给药时间）与行政管理数据或主观个人言论。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1125,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_moc_ngn_2026_06_22_q5","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.848","itemType":"highlight","category":"Management of Care","topic":"Client Advocacy","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.848.stem.en","stemPathZh":"questions.848.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[118,225],"terminalOffsetsZh":[34,57],"fullStemEn":"A nurse is caring for an 84-year-old client with moderate dementia who is refusing a planned urinary catheterization. Highlight the actions by the nurse that demonstrate correct ethical advocacy and respect for client rights.","fullStemZh":"护士正在护理一名患有中度痴呆且拒绝接受计划内导尿术的 84 岁患者。标出护士体现正确伦理倡导并尊重患者权利的行为。","terminalSentenceEn":"Highlight the actions by the nurse that demonstrate correct ethical advocacy and respect for client rights.","terminalSentenceZh":"标出护士体现正确伦理倡导并尊重患者权利的行为。","penultimateSentenceEn":"A nurse is caring for an 84-year-old client with moderate dementia who is refusing a planned urinary catheterization.","penultimateSentenceZh":"护士正在护理一名患有中度痴呆且拒绝接受计划内导尿术的 84 岁患者。","responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"The nurse assesses the client who is resisting the insertion of the catheter.","zh":"护士评估了阻挠插入导尿管的患者。"},{"id":"s2","en":"The nurse immediately stops the procedure to respect the client's verbal refusal.","zh":"护士立即停止操作，以尊重患者的口头拒绝。","selectable":true},{"id":"s3","en":"The nurse proceeds to insert the catheter while another staff member holds the client's legs still.","zh":"当另一名工作人员固定住患者双腿使其保持静止时，护士继续插入导尿管。","selectable":true},{"id":"s4","en":"The nurse reviews the chart to verify the designated Durable Power of Attorney (DPOA) for healthcare.","zh":"护士查看病历，以核实指定的医疗事务持久授权书（DPOA）代理人。","selectable":true},{"id":"s5","en":"The nurse contacts the designated healthcare surrogate to discuss the client's refusal and clinical needs.","zh":"护士联系了指定的医疗代理人，以讨论患者的拒绝和临床需求。","selectable":true},{"id":"s6","en":"The nurse documents that the client is non-compliant and requests an order for restraints.","zh":"护士记录下患者不配合，并申请身体约束的医嘱。","selectable":true}],"correct":["s2","s4","s5"]}},"rationaleCorrectEn":"Ethical advocacy requires the nurse to protect the client's autonomy and physical safety. When a client refuses a procedure, even one with cognitive impairment, the nurse must immediately stop the procedure to prevent battery. The nurse should then verify if a healthcare surrogate or DPOA is active, and collaborate with them to make clinical decisions when the client lacks capacity. Forcing the catheterization or applying restraints without attempts to resolve the issue with the surrogate violates patient rights.","rationaleCorrectZh":"伦理倡导要求护士保护患者的自主权和人身安全。当患者拒绝某项操作时，即使其有认知功能受损，护士也必须立即停止操作以防发生人身侵犯（殴击伤）。随后，护士应核实医疗代理人或 DPOA 是否有效，并在患者丧失决策能力时与其合作做出临床决策。强行进行导尿或在未尝试与代理人沟通解决的情况下申请约束，均违反了患者的权利。","testTakingStrategyEn":"Look for actions that honor autonomy (stopping the procedure) and leverage correct legal resources (DPOA/surrogate) to resolve the conflict. Avoid options showing physical force.","testTakingStrategyZh":"寻找尊重自主权（停止操作）并利用正确法律资源（DPOA/代理人）来解决冲突的行为。避免显示使用身体强力的选项。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"A nurse is caring for an 84-year-old client with moderate dementia who is refusing a planned urinary catheterization.","controlSentenceZh":"护士正在护理一名患有中度痴呆且拒绝接受计划内导尿术的 84 岁患者。"}
{"queueIndex":1126,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_moc_ngn_2026_06_22_q6","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.849","itemType":"bowtie","category":"Management of Care","topic":"Prioritization & Delegation","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.849.stem.en","stemPathZh":"questions.849.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[317,479],"terminalOffsetsZh":[104,149],"fullStemEn":"A nurse is monitoring a client who is 4 hours post-operative coronary artery bypass graft (CABG). The nurse observes the chest tube drainage has increased to 150 mL/hour for the last 2 hours. The nurse contacts the resident on call, who instructs the nurse to 'continue to monitor' without prescribing interventions. Select the primary professional concern, two priority actions the nurse must take, and two clinical parameters the nurse should monitor to evaluate the situation.","fullStemZh":"护士正在监测一名冠状动脉旁路移植术（CABG）术后 4 小时的患者。护士观察到胸腔引流量在过去 2 小时内增加到 150 mL/小时。护士联系了值班住院医生，住院医生指示护士“继续监测”，未开具任何干预医嘱。请选择首要的专业关注点、两项护士必须采取的优先措施，以及应监测的两个临床参数以评估该情况。","terminalSentenceEn":"Select the primary professional concern, two priority actions the nurse must take, and two clinical parameters the nurse should monitor to evaluate the situation.","terminalSentenceZh":"请选择首要的专业关注点、两项护士必须采取的优先措施，以及应监测的两个临床参数以评估该情况。","penultimateSentenceEn":"The nurse contacts the resident on call, who instructs the nurse to 'continue to monitor' without prescribing interventions.","penultimateSentenceZh":"护士联系了值班住院医生，住院医生指示护士“继续监测”，未开具任何干预医嘱。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Primary professional concern","zh":"首要的专业关注点"},"tokens":[{"id":"cond_chain","en":"Inadequate clinical response requiring chain of command escalation.","zh":"临床处置不足，需要通过组织链条进行上报。"},{"id":"cond_scope","en":"Practicing medicine beyond the nurse's legal scope of practice.","zh":"超出了护士的法定执业范围行医。"},{"id":"cond_negligence","en":"Documenting medical errors to establish provider negligence.","zh":"记录医疗错误以确立医生的过失。"}],"correct":"cond_chain"},"actions":{"prompt":{"en":"Priority actions to take","zh":"应采取的优先措施"},"tokens":[{"id":"act_notify_charge","en":"Notify the ICU charge nurse of the provider's response and client status.","zh":"向 ICU 值班护士汇报医生的答复和患者的状况。"},{"id":"act_clamp_tube","en":"Clamp the chest tube to prevent further blood loss.","zh":"夹闭胸管以防止进一步失血。"},{"id":"act_give_fluid","en":"Increase the maintenance IV fluid rate without a prescription.","zh":"在没有医嘱的情况下调快维持静脉补液的速度。"},{"id":"act_call_fellow","en":"Contact the attending cardiothoracic surgeon.","zh":"联系胸外科主治医生。"}],"correct":["act_call_fellow","act_notify_charge"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"需要监测的参数"},"tokens":[{"id":"param_weight","en":"The client's daily morning weight trends.","zh":"患者每日清晨体重趋势。"},{"id":"param_bp","en":"Blood pressure and heart rate for signs of hypovolemic shock.","zh":"监测血压和心率是否存在低血容量性休克的迹象。"},{"id":"param_coag","en":"Coagulation profile (PT, INR, aPTT) and hemoglobin levels.","zh":"凝血功能（PT、INR、aPTT）和血红蛋白水平。"},{"id":"param_vent","en":"The ventilator oxygen concentration settings.","zh":"呼吸机氧浓度设置。"}],"correct":["param_coag","param_bp"]}}},"rationaleCorrectEn":"Chest tube drainage > 100 mL/hour post-CABG is a clinical red flag indicating potential active hemorrhage. If the resident fails to prescribe appropriate interventions, the nurse has a professional obligation to escalate the concern up the chain of command (notifying the attending surgeon and the charge nurse). The primary concern is an inadequate response requiring escalation. Safe actions include contacting the attending and notifying the charge nurse. Clamping the chest tube is contraindicated as it can cause cardiac tamponade. The nurse cannot adjust fluids without an order. Parameters to monitor include coagulation studies and vital signs for shock.","rationaleCorrectZh":"CABG 术后胸腔引流量 > 100 mL/小时是一个临床危险信号，提示可能存在活动性出血。如果住院医生未能开具适当的干预措施，护士有专业义务将该疑虑上报至组织链条（通知主治医生和值班护士）。首要关注点是处置不足，需要上报。安全的行动包括联系主治医生和通知值班护士。夹闭胸管是禁忌的，因为这会导致心脏压塞。护士在无医嘱的情况下不能调整补液速度。应监测的参数包括凝血功能和低血容量性休克的生命体征。","testTakingStrategyEn":"When clinical interventions are insufficient and client safety is at risk, escalate through the chain of command. Never perform unsafe independent actions like clamping tubes.","testTakingStrategyZh":"当临床干预不足且患者安全受到威胁时，应通过组织链条向上汇报。绝不能执行像夹闭引流管这样不安全的独立操作。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1127,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_moc_ngn_2026_06_22_q7","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.850","itemType":"dropdown_cloze","category":"Management of Care","topic":"Conflict Resolution","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.850.stem.en","stemPathZh":"questions.850.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,205],"terminalOffsetsZh":[0,67],"fullStemEn":"During a shift, a preceptor repeatedly criticizes a newly licensed nurse's performance in public areas, calls them incompetent in front of peers, and assigns them the most unstable clients without support.","fullStemZh":"在一个班次期间，带教老师在公共区域反复批评一名新入职护士的表现，在同行面前称其无能，并在没有提供支持的情况下为其分配了最不稳定的患者。","terminalSentenceEn":"During a shift, a preceptor repeatedly criticizes a newly licensed nurse's performance in public areas, calls them incompetent in front of peers, and assigns them the most unstable clients without support.","terminalSentenceZh":"在一个班次期间，带教老师在公共区域反复批评一名新入职护士的表现，在同行面前称其无能，并在没有提供支持的情况下为其分配了最不稳定的患者。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"This behavior is characterized as {{1}}. The newly licensed nurse's first response should be to {{2}}.","zh":"这种行为被定性为 {{1}}。新入职护士的首要应对应该是 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o2","en":"role conflict and mismatch","zh":"角色冲突与错位"},{"id":"o3","en":"constructive clinical feedback","zh":"建设性的临床反馈"},{"id":"o1","en":"lateral violence (horizontal bullying)","zh":"横向暴力（同僚欺凌）"}],"correct":"o1"},{"id":"2","options":[{"id":"o3","en":"request an immediate transfer to a different nursing unit","zh":"立即申请转科到另一个病房"},{"id":"o1","en":"address the preceptor directly in a professional, private setting","zh":"在专业的私下场合直接与带教老师进行沟通解决"},{"id":"o2","en":"report the incidents immediately to the state board of nursing","zh":"立即将这些事件报告给州护理局"}],"correct":"o1"}]},"rationaleCorrectEn":"Horizontal/lateral violence refers to bullying or aggressive behavior between peers or colleagues at the same or adjacent professional levels. Public humiliation and unfair task assignment are classic signs. The initial step in conflict resolution is to address the individual directly in a private, professional manner, expressing how the behavior affects practice and requesting it to stop. If this fails, the nurse should then escalate to the unit manager.","rationaleCorrectZh":"横向/同僚暴力是指在相同或相邻专业水平的同行或同事之间的欺凌或侵略性行为。公开羞辱和不公平的任务分配是其经典迹象。冲突解决的第一步是以私下、专业的方式直接与当事人进行沟通，表达该行为如何影响执业，并要求其停止。如果此方法无效，护士随后应上报至病房经理。","testTakingStrategyEn":"Choose the option that represents direct, professional communication as the first line of conflict resolution before jumping to administrative escalation.","testTakingStrategyZh":"选择代表将直接、专业的沟通作为冲突解决第一线的选项，然后再考虑行政层面的上报。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1128,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_moc_ngn_2026_06_22_q8","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.851","itemType":"select_all","category":"Management of Care","topic":"Prioritization & Delegation","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.851.stem.en","stemPathZh":"questions.851.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[177,199],"terminalOffsetsZh":[53,61],"fullStemEn":"The nurse is planning care for a client who is 1 day post-operative total hip arthroplasty. Which tasks are appropriate to delegate to the unlicensed assistive personnel (UAP)? Select all that apply.","fullStemZh":"护士正在为一名全髋关节置换术后 1 天的患者制定护理计划。以下哪些任务适合委派给无执照辅助人员（UAP）？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which tasks are appropriate to delegate to the unlicensed assistive personnel (UAP)?","penultimateSentenceZh":"以下哪些任务适合委派给无执照辅助人员（UAP）？","responseContext":{"type":"select_all","options":[{"id":"D","en":"Measure the client's vital signs and report them to the nurse.","zh":"测量患者的生命体征并向护士汇报。"},{"id":"F","en":"Administer the first dose of oral prophylactic anticoagulant.","zh":"给予第一剂口服预防性抗凝剂。"},{"id":"C","en":"Assist the client with transferring from the bed to a chair using an abduction pillow.","zh":"使用外展枕协助患者从病床转移到椅子上。"},{"id":"B","en":"Check the surgical incision site for signs of infection.","zh":"检查手术切口部位是否有感染迹象。"},{"id":"E","en":"Provide instructions on precautions to prevent hip dislocation.","zh":"提供预防髋关节脱位的注意事项指导。"},{"id":"A","en":"Record the client's liquid intake and output values.","zh":"记录患者的液体入量和出量值。"}],"correct":["A","C","D"]},"rationaleCorrectEn":"Delegation to UAP is restricted to tasks that are routine, standardized, and do not require clinical judgment, assessment, teaching, or medication administration. Appropriate tasks include recording intake/output, assisting with mobilization/transfers (using standard precautions like an abduction pillow), and measuring vital signs. Assessing the incision site, teaching precautions, and administering medications (including oral) require licensed nursing judgment and cannot be delegated.","rationaleCorrectZh":"委派给 UAP 的工作仅限于常规的、标准化的，且不需要临床判断、评估、教学或给药的任务。合适的任务包括记录出入量、协助活动/转移（使用外展枕等标准辅助工具）以及测量生命体征。评估切口部位、传授注意事项和给药（包括口服药）需要有执照护士的专业判断，不能委派。","testTakingStrategyEn":"Use the 'TAPE' mnemonic to identify what cannot be delegated to UAPs: Teaching, Assessment, Planning, and Evaluation. Eliminate any choices involving these skills.","testTakingStrategyZh":"使用 “TAPE” 记忆法来识别哪些不能委派给 UAP：教学（Teaching）、评估（Assessment）、计划（Planning）和评价（Evaluation）。排除任何涉及这些技能的选项。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1129,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_moc_ngn_2026_06_22_q9","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.852","itemType":"bowtie","category":"Management of Care","topic":"Legal & Ethical Principles","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.852.stem.en","stemPathZh":"questions.852.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[161,292],"terminalOffsetsZh":[50,92],"fullStemEn":"A competent adult client admitted with acute pancreatitis decides to leave the hospital Against Medical Advice (AMA) because they want to attend a family event. Select the primary legal framework, two priority actions the nurse must take, and two parameters the nurse must verify or document.","fullStemZh":"一名因急性胰腺炎入院且具有决策能力的成年患者决定违背医嘱出院（AMA），因为他想去参加一次家庭活动。请选择首要的法律框架、两项护士必须采取的优先措施，以及护士必须核实或记录的两个参数。","terminalSentenceEn":"Select the primary legal framework, two priority actions the nurse must take, and two parameters the nurse must verify or document.","terminalSentenceZh":"请选择首要的法律框架、两项护士必须采取的优先措施，以及护士必须核实或记录的两个参数。","penultimateSentenceEn":"A competent adult client admitted with acute pancreatitis decides to leave the hospital Against Medical Advice (AMA) because they want to attend a family event.","penultimateSentenceZh":"一名因急性胰腺炎入院且具有决策能力的成年患者决定违背医嘱出院（AMA），因为他想去参加一次家庭活动。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Primary legal framework","zh":"首要的法律框架"},"tokens":[{"id":"cond_autonomy","en":"Client's right to self-determination and autonomy.","zh":"患者的自决权和自主权。"},{"id":"cond_paternal","en":"Beneficence-based clinical paternalism by the provider.","zh":"医生基于行善原则的临床家长式管治。"},{"id":"cond_implied","en":"Implied consent protocol under emergency conditions.","zh":"紧急情况下的推定同意方案。"}],"correct":"cond_autonomy"},"actions":{"prompt":{"en":"Priority actions to take","zh":"应采取的优先措施"},"tokens":[{"id":"act_call_police","en":"Contact law enforcement to report an unauthorized patient departure.","zh":"联系执法部门汇报患者擅自离院。"},{"id":"act_offer_ama","en":"Provide the Against Medical Advice (AMA) form for signature.","zh":"提供违背医嘱离院（AMA）同意书供签署。"},{"id":"act_prevent_exit","en":"Restrain the client physically until security arrives to secure the IV line.","zh":"在保安到达固定静脉通路之前，对患者实施身体限制以防其离开。"},{"id":"act_explain_risk","en":"Explain the specific risks of leaving, including infection and organ failure.","zh":"解释离院的具体风险，包括感染和器官衰竭。"}],"correct":["act_explain_risk","act_offer_ama"]},"parameters":{"prompt":{"en":"Parameters to verify or document","zh":"需核实或记录的参数"},"tokens":[{"id":"param_diagnostics","en":"The completed laboratory schedules for the upcoming week.","zh":"未来一周已完成的实验室检查时间表。"},{"id":"param_finances","en":"The client's personal financial payment arrangements.","zh":"患者的个人财务支付安排。"},{"id":"param_capacity","en":"Client's cognitive capacity and understanding of consequences.","zh":"患者的认知能力以及对后果的理解程度。"},{"id":"param_safety","en":"Removal of the intravenous catheter before departure.","zh":"离院前静脉留置针的拔除情况。"}],"correct":["param_capacity","param_safety"]}}},"rationaleCorrectEn":"Competent adult clients have the ethical and legal right to self-determination and autonomy, which allows them to refuse treatment and leave the hospital AMA. The nurse's role is to ensure the client is fully informed of the risks (like hemorrhage, worsening pancreatitis, organ failure) and to offer the AMA form. The nurse must verify that the client has cognitive capacity to make this decision, and must document the removal of invasive devices (such as IV lines) before departure to prevent safety hazards outside. Restraining a competent client constitutes false imprisonment.","rationaleCorrectZh":"有决策能力的成年患者在伦理和法律上享有自决权和自主权，这允许他们拒绝治疗并违背医嘱出院（AMA）。护士的作用是确信患者完全知晓相关风险（如出血、胰腺炎恶化、器官衰竭）并提供 AMA 同意书。护士必须核实患者具有做出此决定的认知能力，且必须记录离院前侵入性设备（如静脉留置针）的拔除情况，以防在外发生安全隐患。限制有决策能力的患者构成非法拘禁。","testTakingStrategyEn":"Respect client autonomy for competent adults. Never select actions that restrict their movement or involve police/security unless they are incapacitated or a danger to others.","testTakingStrategyZh":"尊重有决策能力的成年患者的自主权。绝不要选择限制其活动或拉入警察/保安的措施，除非他们丧失行为能力或对他人构成危险。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1130,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_moc_ngn_2026_06_22_q10","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.853","itemType":"highlight","category":"Management of Care","topic":"Confidentiality & HIPAA","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.853.stem.en","stemPathZh":"questions.853.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[51,188],"terminalOffsetsZh":[13,46],"fullStemEn":"A nurse is working in a busy emergency department. Highlight the actions or decisions by the nurse that violate client confidentiality or electronic health record (EHR) security protocols.","fullStemZh":"护士正在繁忙的急诊科工作。标出护士违反患者保密协定或电子病历（EHR）安全规范的行为或决定。","terminalSentenceEn":"Highlight the actions or decisions by the nurse that violate client confidentiality or electronic health record (EHR) security protocols.","terminalSentenceZh":"标出护士违反患者保密协定或电子病历（EHR）安全规范的行为或决定。","penultimateSentenceEn":"A nurse is working in a busy emergency department.","penultimateSentenceZh":"护士正在繁忙的急诊科工作。","responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"The nurse logs into the computer terminal using a unique fingerprint scanner.","zh":"护士使用独特的指纹扫描仪登录电脑终端。"},{"id":"s2","en":"The nurse leaves the computer terminal logged in and walks away to help a colleague transfer a client.","zh":"护士在电脑终端保持登录状态下离开，前去协助同事转移患者。","selectable":true},{"id":"s3","en":"The nurse shares their temporary password with a student nurse to speed up documentation.","zh":"护士将自己的临时密码分享给一名实习护士，以加快病历记录的速度。","selectable":true},{"id":"s4","en":"The nurse logs off the workstation prior to entering a client's room.","zh":"护士在进入患者病房前注销了工作站账号。","selectable":true},{"id":"s5","en":"The nurse discusses a client's laboratory results in a low voice at the bedside with the client's family members present, after obtaining the client's verbal consent.","zh":"在获得患者口头同意后，护士在床旁低声与在场的患者家属讨论其化验结果。","selectable":true},{"id":"s6","en":"The nurse prints a lab report containing patient identifiers and leaves it on the counter of a central nursing desk.","zh":"护士打印了一份包含患者身份信息的化验报告，并将其留在中央护士站的柜台上。","selectable":true}],"correct":["s2","s3","s6"]}},"rationaleCorrectEn":"Violations of client confidentiality and EHR protocols in this scenario include: 1) Leaving a computer terminal logged in and unattended, which allows unauthorized access to patient records. 2) Sharing passwords, which compromises audit trails and security. 3) Leaving printed patient records with identifiers on a counter where visitors or other patients can see them. Logging off when leaving, using secure logins, and bedside discussion with family after client consent are appropriate actions.","rationaleCorrectZh":"在这种情况下，违反患者保密协定和 EHR 规范的行为包括：1) 在电脑终端保持登录且无人看管的情况下离开，这允许未经授权的人员访问患者病历。2) 分享密码，这损害了审计追踪和安全性。3) 将包含身份信息的打印患者病历留在柜台上，导致访客或其他患者可能会看到。离开时注销登录、使用安全登录以及在获得患者同意后与家属在床旁讨论是正确的操作。","testTakingStrategyEn":"Identify actions that allow unauthorized individuals to access confidential client records (unlocked terminals, shared passwords, exposed printouts).","testTakingStrategyZh":"识别允许未经授权的人员访问机密患者病历的行为（未锁定的终端、共享密码、裸露的打印件）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1131,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q1","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.854","itemType":"ordered_response","category":"Safety and Infection Prevention and Control","topic":"PPE & Sterile Technique","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.854.stem.en","stemPathZh":"questions.854.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[130,226],"terminalOffsetsZh":[35,68],"fullStemEn":"The nurse has completed caring for a client in airborne precautions for suspected tuberculosis and is preparing to exit the room. Order the steps of personal protective equipment (PPE) removal and room exit from first to last.","fullStemZh":"护士完成了对疑似结核病采取空气传播预防隔离患者的护理，正准备离开病房。请按从先到后的顺序排列拆除个人防护装备（PPE）和离开病房的步骤。","terminalSentenceEn":"Order the steps of personal protective equipment (PPE) removal and room exit from first to last.","terminalSentenceZh":"请按从先到后的顺序排列拆除个人防护装备（PPE）和离开病房的步骤。","penultimateSentenceEn":"The nurse has completed caring for a client in airborne precautions for suspected tuberculosis and is preparing to exit the room.","penultimateSentenceZh":"护士完成了对疑似结核病采取空气传播预防隔离患者的护理，正准备离开病房。","responseContext":{"type":"ordered_response","options":[{"id":"C","en":"Exit the client's room and close the door tightly.","zh":"离开患者病房并紧紧关闭房门。"},{"id":"E","en":"Perform hand hygiene immediately after respirator removal.","zh":"脱下呼吸器后立即进行手部卫生。"},{"id":"A","en":"Remove gloves and gown inside the client's room.","zh":"在患者病房内脱下手套和隔离衣。"},{"id":"D","en":"Remove the N95 respirator mask outside the client's room.","zh":"在患者病房外脱下 N95 呼吸器。"},{"id":"B","en":"Remove goggles or face shield inside the client's room.","zh":"在患者病房内脱下护目镜或面罩。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"According to standard CDC guidelines for airborne precautions (such as tuberculosis), PPE must be removed in a sequence that prevents self-contamination and release of airborne pathogens. Gloves and gown (highly contaminated) are removed first inside the room, followed by goggles/face shield. The nurse must then exit the room and close the door tightly to maintain negative pressure before removing the N95 respirator outside the room, because removing it inside would expose the nurse's airway to suspended microdroplets. Hand hygiene is performed immediately after.","rationaleCorrectZh":"根据 CDC 关于空气传播隔离（如结核病）的标准指南，必须按能够防止自我污染和防止空气传播病原体释放的顺序移除 PPE。首先在病房内脱下手套和隔离衣（高度污染），然后脱下护目镜/面罩。接着，护士必须离开病房并紧紧关闭病房门以维持负压，然后才能在病房外脱下 N95 呼吸器，因为在病房内脱下会使护士的呼吸道暴露于悬浮的微滴中。之后立即进行手部卫生。","testTakingStrategyEn":"Remember the critical airborne exception: all PPE is removed inside the room except for the respiratory protection (N95 or PAPR), which must be removed outside the closed room.","testTakingStrategyZh":"记住空气传播隔离的关键例外：除呼吸防护装备（N95 或 PAPR）必须在关闭的病房外脱下之外，所有其他 PPE 均在病房内脱下。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":true,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1132,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q2","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.855","itemType":"multiple_choice","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.855.stem.en","stemPathZh":"questions.855.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[93,160],"terminalOffsetsZh":[22,41],"fullStemEn":"The nurse is providing discharge teaching to a client who will be using home oxygen therapy. Which instruction should the nurse include to prevent fire hazards?","fullStemZh":"护士正在为将使用家庭氧疗的患者提供出院指导。护士应包括以下哪项指导以预防火灾隐患？","terminalSentenceEn":"Which instruction should the nurse include to prevent fire hazards?","terminalSentenceZh":"护士应包括以下哪项指导以预防火灾隐患？","penultimateSentenceEn":"The nurse is providing discharge teaching to a client who will be using home oxygen therapy.","penultimateSentenceZh":"护士正在为将使用家庭氧疗的患者提供出院指导。","responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Apply petroleum jelly to the nostrils to relieve dryness.","zh":"在鼻孔涂抹凡士林以缓解干燥。"},{"id":"B","en":"Use water-based lubricants on the nose and lips.","zh":"在鼻子和嘴唇上使用水性润滑剂。"},{"id":"D","en":"Adjust the oxygen flow rate upward if shortness of breath increases.","zh":"如果呼吸急促增加，可调高氧气流量。"},{"id":"C","en":"Cover the client with a synthetic fleece blanket to keep warm.","zh":"用合成羊毛毯子盖在患者身上以保暖。"}],"correct":["B"]},"rationaleCorrectEn":"Water-based lubricants are non-flammable and safe to use on the nose and lips during oxygen therapy. Petroleum-based products (like petroleum jelly) are highly flammable and must not be used near oxygen sources.","rationaleCorrectZh":"水性润滑剂是不易燃的，在氧疗期间可以安全地涂抹在鼻子和嘴唇上。石油基产品（如凡士林）高度易燃，绝不能在氧源附近使用。","testTakingStrategyEn":"Focus on the keyword 'fire hazards.' Select the option that directly addresses the elimination of flammable materials or ignition sources in the presence of oxygen.","testTakingStrategyZh":"关注关键词“火灾隐患”。选择能够直接解决在氧气存在下消除易燃材料或引燃源的选项。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1133,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q3","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.856","itemType":"select_all","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.856.stem.en","stemPathZh":"questions.856.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[194,216],"terminalOffsetsZh":[52,60],"fullStemEn":"The nurse is preparing a hospital room for a client who is being admitted with new-onset generalized tonic-clonic seizures. Which actions should the nurse take to establish seizure precautions? Select all that apply.","fullStemZh":"护士正在为一名因新发全身性强直-阵挛性癫痫发作入院的患者准备病房。护士应采取哪些措施来建立癫痫预防措施？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which actions should the nurse take to establish seizure precautions?","penultimateSentenceZh":"护士应采取哪些措施来建立癫痫预防措施？","responseContext":{"type":"select_all","options":[{"id":"A","en":"Pad the side rails of the bed.","zh":"对床栏加垫防护。"},{"id":"D","en":"Ensure oxygen equipment is available and functioning.","zh":"确保吸氧设备可用且功能完好。"},{"id":"F","en":"Apply soft wrist restraints to prevent falls from bed.","zh":"使用软性手腕约束带以防止跌倒坠床。"},{"id":"B","en":"Keep a padded tongue blade at the head of the bed.","zh":"在床头放置一个加垫的压舌板。"},{"id":"E","en":"Keep the bed in the lowest position.","zh":"将床头/床身降至最低位置。"},{"id":"C","en":"Set up working suction equipment at the bedside.","zh":"在床旁安装工作正常的吸引设备。"}],"correct":["A","C","D","E"]},"rationaleCorrectEn":"Seizure precautions are aimed at protecting the client from injury and maintaining airway patency. Safe interventions include padding the side rails, setting up suction equipment for postictal secretions, ensuring oxygen is ready, and keeping the bed in its lowest position. Placing objects like tongue blades in the mouth is dangerous, and restraints must never be used to control seizure movements.","rationaleCorrectZh":"癫痫预防措施旨在保护患者免受伤害并保持气道通畅。安全的干预措施包括对床栏加垫、安装吸引设备以清除发作后分泌物、确保吸氧设备就绪，以及将床降至最低位置。将压舌板等物体放入患者口中是危险的，绝不能使用约束带控制癫痫发作时的肢体运动。","testTakingStrategyEn":"Prioritize client safety and airway protection. Eliminate any options recommending placing objects in the client's mouth or using physical restraints to restrict movement during a seizure.","testTakingStrategyZh":"优先考虑患者安全和气道保护。排除任何建议将物品放入患者口中，或在癫痫发作期间使用身体约束限制其活动的选项。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1134,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q4","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.857","itemType":"select_all","category":"Safety and Infection Prevention and Control","topic":"Standard Precautions & Hygiene","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.857.stem.en","stemPathZh":"questions.857.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[174,196],"terminalOffsetsZh":[54,62],"fullStemEn":"A nurse experiences an accidental needlestick injury with a syringe contaminated with blood from a client who has hepatitis B. Which immediate actions should the nurse take? Select all that apply.","fullStemZh":"护士在操作过程中，不慎被注射器针头刺伤，该注射器被一名患有乙型肝炎患者的血液所污染。护士应立即采取哪些措施？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which immediate actions should the nurse take?","penultimateSentenceZh":"护士应立即采取哪些措施？","responseContext":{"type":"select_all","options":[{"id":"B","en":"Wash the puncture wound thoroughly with soap and water.","zh":"用肥皂和水彻底清洗穿刺伤口。"},{"id":"A","en":"Vigorously squeeze and pinch the puncture site to express blood.","zh":"用力挤压和捏夹穿刺部位以排出血液。"},{"id":"D","en":"Report the exposure incident to the nursing supervisor or charge nurse immediately.","zh":"立即向护理主管或值班护士汇报此次暴露事件。"},{"id":"C","en":"Pour household bleach over the wound to disinfect the area.","zh":"在伤口上浇家用漂白水以对该区域进行消毒。"},{"id":"E","en":"Seek immediate medical evaluation from employee health or the emergency department.","zh":"立即向员工健康管理部门或急诊科寻求医疗评估。"}],"correct":["B","D","E"]},"rationaleCorrectEn":"According to CDC guidelines, the immediate response to a needlestick injury is to wash the wound thoroughly with soap and water. Antiseptics can be used, but harsh chemicals like bleach are contraindicated because they cause tissue damage. Squeezing or pinching the wound has not been shown to reduce infection transmission. The nurse must immediately report the exposure to initiate the occupational protocol (e.g., testing the nurse and the source client, administering hepatitis B post-exposure prophylaxis if indicated).","rationaleCorrectZh":"根据 CDC 指南，被针头刺伤后的立即处理是用肥皂和水彻底清洗伤口。可以使用防腐消毒剂，但禁用家用漂白水等强刺激性化学物质，因为它们会造成组织损伤。目前没有证据表明挤压或捏夹伤口可以减少感染传播。护士必须立即报告该暴露事件，以启动职业暴露流程（如对护士和源患者进行检测、必要时给予乙肝暴露后预防治疗）。","testTakingStrategyEn":"Follow the sequence of clinical priority: clean the wound first with gentle, non-damaging agents (soap/water), then report and seek medical care. Eliminate options that suggest aggressive wound manipulation or harsh chemical applications.","testTakingStrategyZh":"遵循临床优先顺序：首先用温和、不伤组织的物质（肥皂/水）清洁伤口，然后报告并寻求医疗救治。排除建议对伤口进行剧烈操作或使用强刺激性/强腐蚀性化学物质的选项。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1135,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q5","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.858","itemType":"highlight","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.858.stem.en","stemPathZh":"questions.858.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,159],"terminalOffsetsZh":[0,34],"fullStemEn":"Highlight the environmental factors or clinical observations in the passage that represent immediate safety hazards or violations of fall prevention protocols.","fullStemZh":"标出文章中代表即时安全隐患或违反防跌倒规范的环境因素或临床观察结果。","terminalSentenceEn":"Highlight the environmental factors or clinical observations in the passage that represent immediate safety hazards or violations of fall prevention protocols.","terminalSentenceZh":"标出文章中代表即时安全隐患或违反防跌倒规范的环境因素或临床观察结果。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"The nurse performs a safety round for a 78-year-old client who is recovering from major abdominal surgery.","zh":"护士对一名接受完腹部大手术恢复中的 78 岁患者进行安全巡视。"},{"id":"s2","en":"The client is sitting on the edge of the bed wearing standard cotton socks without slip-resistant soles.","zh":"患者坐在床边，穿着没有防滑底的普通棉袜。","selectable":true},{"id":"s3","en":"The hospital bed is elevated to the level of the nurse's waist.","zh":"医院病床升高至护士腰部的高度。","selectable":true},{"id":"s4","en":"The two upper side rails are raised, while the two lower side rails are lowered.","zh":"床头侧的两个上床栏已升起，而床尾侧的两个下床栏已降下。","selectable":true},{"id":"s5","en":"The client's call light is placed on the bedside table, which is pushed against the far wall.","zh":"患者的呼叫铃放在床旁桌上，而桌子被推到了远端的墙边。","selectable":true},{"id":"s6","en":"A small nightlight is illuminated in the client's bathroom.","zh":"患者洗手间内开着一盏小夜灯。","selectable":true}],"correct":["s2","s3","s5"]}},"rationaleCorrectEn":"Standard cotton socks without non-slip treads create a slipping hazard on smooth hospital floors. Keeping the bed at waist height increases the severity of injury if the client attempts to get out of bed and falls; the bed should be kept in the lowest position. Placing the call light out of reach (pushed against the far wall) forces the client to lean or get up without assistance, directly increasing fall risk. Raising only the upper side rails is standard practice to help the client reposition; raising all four side rails is considered an unauthorized restraint. A nightlight in the bathroom is a positive safety measure.","rationaleCorrectZh":"没有防滑底纹的普通棉袜在光滑的医院地板上会造成滑倒危险。将病床保持在腰部高度会增加患者试图起床跌倒时的受伤严重程度；床应该保持在最低位置。将呼叫器放在拿不到的地方（推到远端墙边）会迫使患者在没有帮助的情况下倾斜身体或起床，这直接增加了跌倒的风险。仅抬起上部床栏是标准操作，可帮助患者调整体位；抬起全部四个床栏被视为未经许可的身体约束。洗手间安装夜灯是一项良好的安全措施。","testTakingStrategyEn":"Look for violations of basic safety principles: traction for mobility, bed in the lowest position, and easy access to the nurse (call light). Recognize that partial side rail usage is appropriate, not a hazard.","testTakingStrategyZh":"寻找违反基本安全原则的行为：移动时的抓地防滑、病床处于最低位置，以及能轻易联系护士（呼叫铃）。认识到部分床栏使用是合适的，而不是隐患。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1136,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q6","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.859","itemType":"highlight","category":"Safety and Infection Prevention and Control","topic":"Transmission-Based Precautions","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.859.stem.en","stemPathZh":"questions.859.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,111],"terminalOffsetsZh":[0,23],"fullStemEn":"Highlight the actions or decisions by the nurse that violate airborne transmission-based precaution guidelines.","fullStemZh":"标出护士违反空气传播预防隔离指南的行为或决定。","terminalSentenceEn":"Highlight the actions or decisions by the nurse that violate airborne transmission-based precaution guidelines.","terminalSentenceZh":"标出护士违反空气传播预防隔离指南的行为或决定。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"A nurse is planning care for a client admitted with a productive cough, night sweats, and suspected active pulmonary tuberculosis.","zh":"护士正在为一名因咳嗽咳痰、盗汗且疑似活动性肺结核入院的患者制定护理计划。"},{"id":"s2","en":"The client is placed in a private room with negative pressure ventilation that vents directly to the outside.","zh":"患者被安置在带有负压通风且直接向室外排气的单人病房中。","selectable":true},{"id":"s3","en":"The nurse performs hand hygiene and dons a standard surgical mask before entering the room.","zh":"进入病房前，护士进行手部卫生并戴上标准外科口罩。","selectable":true},{"id":"s4","en":"The nurse leaves the patient's room door open to allow easy visualization from the hallway.","zh":"护士将患者的房门打开，以便从走廊上容易观察。","selectable":true},{"id":"s5","en":"The nurse instructs the client to wear a standard surgical mask if transport to radiology is required.","zh":"护士指导患者，如果需要去放射科检查，应佩戴标准外科口罩。","selectable":true}],"correct":["s3","s4"]}},"rationaleCorrectEn":"Suspected or confirmed active pulmonary tuberculosis (TB) requires airborne precautions. Violations in this scenario are: 1) Wearing a standard surgical mask instead of a fit-tested N95 respirator (or PAPR) before entering, as surgical masks do not filter out small airborne particles. 2) Leaving the room door open, which allows infectious microdroplets to escape into the general hallway corridor; the door must remain closed. Negative pressure rooms and having the client wear a surgical mask during transport are correct, standard interventions.","rationaleCorrectZh":"疑似或确诊的活动性肺结核（TB）需要空气传播预防措施。该场景中的违规行为包括：1) 进入前佩戴标准外科口罩而不是经过密合度测试的 N95 呼吸器（或 PAPR），因为外科口罩无法过滤空气中的微小悬浮颗粒。2) 将病房门打开，这会导致传染性微滴逸入走廊公共区域；门必须保持关闭。负压病房和在转运期间让患者戴上外科口罩是正确的标准干预措施。","testTakingStrategyEn":"Recall that active pulmonary tuberculosis requires airborne precautions. Contrast the requirements of airborne precautions (N95 mask, closed doors, negative pressure) with droplet precautions (surgical mask, doors can be open) to identify the errors.","testTakingStrategyZh":"牢记活动性肺结核需要空气传播预防措施。对比空气隔离（N95 口罩、关门、负压）与飞沫隔离（外科口罩、可以开门）的要求来识别错误。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1137,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q7","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.860","itemType":"highlight","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.860.stem.en","stemPathZh":"questions.860.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,125],"terminalOffsetsZh":[0,26],"fullStemEn":"Highlight the actions or decisions by the nurse that violate safety guidelines or clinical protocols for physical restraints.","fullStemZh":"标出护士违反身体约束安全指南或临床规范的行为或决定。","terminalSentenceEn":"Highlight the actions or decisions by the nurse that violate safety guidelines or clinical protocols for physical restraints.","terminalSentenceZh":"标出护士违反身体约束安全指南或临床规范的行为或决定。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"The nurse is caring for a confused client with a severe urinary tract infection who has pulled out an intravenous catheter twice.","zh":"护士正在护理一名患有严重尿路感染的谵妄患者，该患者已两次拔掉静脉导管。"},{"id":"s2","en":"The nurse immediately applies bilateral soft wrist restraints without first trying less restrictive interventions such as a bed alarm or redirection.","zh":"护士立即对患者实施了双侧软性手腕约束，而没有先尝试限制较少的干预措施，如加床栏警报器或引导注意力。","selectable":true},{"id":"s3","en":"The nurse secures the restraint straps to the movable side rails of the hospital bed.","zh":"护士将约束带固定在医院病床的活动侧床栏上。","selectable":true},{"id":"s4","en":"The nurse uses a quick-release knot to tie the straps in place.","zh":"护士使用活结（快速释放结）将约束带绑好固定。","selectable":true},{"id":"s5","en":"The nurse contacts the healthcare provider and secures a verbal prescription for the restraints within 30 minutes of application.","zh":"护士在实施约束后 30 分钟内联系了医生，并获得了约束的口头医嘱。","selectable":true},{"id":"s6","en":"The nurse documents a plan to perform skin, circulation, and range-of-motion assessments every 4 hours.","zh":"护士记录了一项计划，准备每 4 小时进行一次皮肤、循环和关节活动度（ROM）评估。","selectable":true}],"correct":["s2","s3","s6"]}},"rationaleCorrectEn":"Guidelines for physical restraints state that: 1) Less restrictive alternatives (like redirection, room observation, or alarms) must be tried and fail before restraints are applied. 2) Restraints must be tied to the bed frame, not movable side rails, because moving the side rails can pull the restraints tight and cause injury or dislocation. 3) Under typical protocols and guidelines, restrained clients require assessment of skin integrity, circulation, and range of motion at least every 2 hours, rather than every 4 hours. Using a quick-release knot is correct. Obtaining a prescription within 1 hour of emergency application is correct.","rationaleCorrectZh":"身体约束指南指出：1) 在使用约束之前，必须尝试限制较少的替代措施（如引导注意力、病房观察或警报器）且确认无效。2) 约束带必须系在床架上，而不是活动的侧栏上，因为移动床栏可能会拉紧约束带并导致受伤或脱位。3) 根据常规规范与指南，接受约束的患者通常需要至少每 2 小时进行一次皮肤完整性、循环和关节活动度评估，而不是每 4 小时一次。使用活结（快速释放结）是正确的。在紧急使用后 1 小时内获得医嘱是正确的。","testTakingStrategyEn":"Focus on standard restraint safety rules: restraints are last resort, tie to the bed frame (not rails), use quick-release knots, and perform assessments at least every 2 hours.","testTakingStrategyZh":"关注标准的约束安全规则：约束是最后的手段、系在床架上（而非床栏）、使用活结，且至少每 2 小时进行一次评估。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1138,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q8","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.861","itemType":"matrix","category":"Safety and Infection Prevention and Control","topic":"Transmission-Based Precautions","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.861.stem.en","stemPathZh":"questions.861.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[82,159],"terminalOffsetsZh":[27,49],"fullStemEn":"The nurse is assigning transmission-based precautions for newly admitted clients. For each client description, select the primary precaution category required.","fullStemZh":"护士正在为新入院的患者分配基于传播途径的隔离预防措施。对于每位患者描述，请选择所需的最佳隔离类别。","terminalSentenceEn":"For each client description, select the primary precaution category required.","terminalSentenceZh":"对于每位患者描述，请选择所需的最佳隔离类别。","penultimateSentenceEn":"The nurse is assigning transmission-based precautions for newly admitted clients.","penultimateSentenceZh":"护士正在为新入院的患者分配基于传播途径的隔离预防措施。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"A client with active pulmonary tuberculosis who has a productive cough","zh":"一名有咳嗽咳痰的活动性肺结核患者"},{"id":"r2","en":"A client with seasonal influenza who is sneezing and coughing","zh":"一名有打喷嚏和咳嗽的季节性流感患者"},{"id":"r3","en":"A client with Clostridioides difficile colitis who has watery diarrhea","zh":"一名患有艰难梭菌结肠炎且有水样泻的患者"},{"id":"r4","en":"An immunocompetent client with localized herpes zoster (shingles) whose lesions are fully covered","zh":"一名免疫功能正常、皮损完全覆盖的局限性带状疱疹患者"}],"columns":[{"id":"c3","en":"Airborne Precautions","zh":"空气传播预防措施"},{"id":"c1","en":"Contact Precautions","zh":"接触预防措施"},{"id":"c4","en":"Standard Precautions","zh":"标准预防措施"},{"id":"c2","en":"Droplet Precautions","zh":"飞沫预防措施"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c3"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c4"]}]},"rationaleCorrectEn":"1) Pulmonary tuberculosis is caused by Mycobacterium tuberculosis, which is transmitted via tiny droplet nuclei that remain suspended in the air, requiring Airborne Precautions (AIIR and N95). 2) Influenza is transmitted by large-particle droplets generated during coughing or sneezing, requiring Droplet Precautions (surgical mask). 3) Clostridioides difficile is transmitted via direct or indirect contact with bacterial spores in feces, requiring Contact Precautions (gown, gloves, and washing hands with soap and water). 4) Localized herpes zoster (shingles) in an immunocompetent individual with fully covered lesions requires only Standard Precautions (though healthcare workers who are not immune should avoid caring for them).","rationaleCorrectZh":"1) 肺结核由结核分枝杆菌引起，通过悬浮在空气中的微小飞沫核传播，需要空气传播预防措施（AIIR 和 N95）。2) 流感通过咳嗽或打喷嚏产生的大颗粒飞沫传播，需要飞沫预防措施（外科口罩）。3) 艰难梭菌通过直接或间接接触粪便中的细菌孢子传播，需要接触预防措施（隔离衣、手套，并用肥皂和水洗手）。4) 对于免疫功能正常且皮损完全覆盖的局限性带状疱疹患者，仅需要标准预防措施（尽管没有免疫力的医护人员应避免护理此类患者）。","testTakingStrategyEn":"Classify infectious agents by their mode of transmission. Pay close attention to qualifiers like 'immunocompetent' and 'localized/covered lesions' which reduce the transmission risk for shingles compared to disseminated shingles.","testTakingStrategyZh":"根据传播途径对传染性病原体进行分类。密切注意“免疫功能正常”和“局限性/皮损已覆盖”等限定词，这些限定词使带状疱疹的传播风险低于播散性带状疱疹。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"The nurse is assigning transmission-based precautions for newly admitted clients.","controlSentenceZh":"护士正在为新入院的患者分配基于传播途径的隔离预防措施。"}
{"queueIndex":1139,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q9","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.862","itemType":"bowtie","category":"Safety and Infection Prevention and Control","topic":"Transmission-Based Precautions","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.862.stem.en","stemPathZh":"questions.862.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[177,364],"terminalOffsetsZh":[44,95],"fullStemEn":"A nurse is preparing to provide isolation instructions to the family members of a client with a surgical wound infected with methicillin-resistant Staphylococcus aureus (MRSA). Select the primary educational focus, two priority actions the family must perform, and two parameters the nurse should monitor to evaluate the family's understanding of the instructions.","fullStemZh":"护士准备为一名手术伤口感染耐甲氧西林金黄色葡萄球菌（MRSA）的患者的家属提供隔离指导。请选择主要的教学重点、家属必须执行的两项优先措施，以及护士应监测的两个参数以评估家属对指导内容的理解。","terminalSentenceEn":"Select the primary educational focus, two priority actions the family must perform, and two parameters the nurse should monitor to evaluate the family's understanding of the instructions.","terminalSentenceZh":"请选择主要的教学重点、家属必须执行的两项优先措施，以及护士应监测的两个参数以评估家属对指导内容的理解。","penultimateSentenceEn":"A nurse is preparing to provide isolation instructions to the family members of a client with a surgical wound infected with methicillin-resistant Staphylococcus aureus (MRSA).","penultimateSentenceZh":"护士准备为一名手术伤口感染耐甲氧西林金黄色葡萄球菌（MRSA）的患者的家属提供隔离指导。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Primary educational focus","zh":"主要教学重点"},"tokens":[{"id":"cond_airborne","en":"Negative-airflow room isolation guidelines","zh":"负压空气隔离室隔离规范"},{"id":"cond_contact","en":"Wound-infection contact precaution guidelines","zh":"伤口感染接触预防隔离规范"},{"id":"cond_droplet","en":"Respiratory-droplet precaution guidelines","zh":"呼吸道飞沫预防隔离规范"}],"correct":"cond_contact"},"actions":{"prompt":{"en":"Priority actions to teach family","zh":"教授给家属的优先措施"},"tokens":[{"id":"act_ppe","en":"Don a clean gown and gloves when participating in direct client care.","zh":"参与直接患者护理时穿戴清洁的隔离衣和手套。"},{"id":"act_hygiene","en":"Perform hand hygiene before entering and after leaving the room.","zh":"进入病房前和离开病房后进行手部卫生。"},{"id":"act_n95","en":"Wear an N95 respirator mask at all times when inside the room.","zh":"在病房内始终佩戴 N95 呼吸器口罩。"},{"id":"act_door","en":"Ensure the client's door remains closed to prevent air dispersion.","zh":"确保患者的房门保持关闭以防止空气扩散。"}],"correct":["act_hygiene","act_ppe"]},"parameters":{"prompt":{"en":"Parameters to monitor for understanding","zh":"用于评估理解情况的监测参数"},"tokens":[{"id":"param_n95","en":"Proper fitting and seal-check of the family's N95 respirator.","zh":"家属 N95 呼吸器的正确贴合并进行密合度检查。"},{"id":"param_door","en":"The family's compliance with keeping the room door tightly closed.","zh":"家属保持病房门紧闭的合规情况。"},{"id":"param_ppe","en":"Correct donning and doffing sequence of gown and gloves by the family.","zh":"家属穿戴和脱卸隔离衣及手套的顺序正确性。"},{"id":"param_hygiene","en":"Family member's hand hygiene technique during entry and exit.","zh":"家属进出时的手卫生操作规范度。"}],"correct":["param_hygiene","param_ppe"]}}},"rationaleCorrectEn":"MRSA in a wound infection is transmitted via direct or indirect contact, requiring contact precautions. The educational focus is wound-infection contact precaution guidelines. Actions to teach the family include performing hand hygiene on entry and exit, and donning a clean gown and gloves when assisting with direct client care. The parameters to monitor to verify family understanding are their hand hygiene technique and their correct gown/glove donning/doffing sequence. Airborne precautions (N95 masks, keeping the room door closed) are not indicated for MRSA wound infections.","rationaleCorrectZh":"伤口感染中的 MRSA 通过直接或间接接触传播，需要接触预防措施。教学重点是伤口感染接触预防隔离规范。向家属教授的措施包括在进入和离开病房时进行手部卫生，以及在协助直接患者护理时穿戴清洁的隔离衣和手套。监测以验证家属理解的参数是他们的手部卫生技术和正确的隔离衣/手套穿脱顺序。MRSA 伤口感染不需要空气隔离措施（N95 口罩、保持病房门关闭）。","testTakingStrategyEn":"Identify the mode of transmission for MRSA (contact). Select the condition, actions, and monitoring parameters that align with contact precautions, and discard those related to airborne transmission.","testTakingStrategyZh":"确定 MRSA 的传播方式（接触）。选择符合接触隔离要求的病情、措施和监测参数，并排除与空气传播相关的项。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"A nurse is preparing to provide isolation instructions to the family members of a client with a surgical wound infected with methicillin-resistant Staphylococcus aureus (MRSA).","controlSentenceZh":"护士准备为一名手术伤口感染耐甲氧西林金黄色葡萄球菌（MRSA）的患者的家属提供隔离指导。"}
{"queueIndex":1140,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q10","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.863","itemType":"bowtie","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.863.stem.en","stemPathZh":"questions.863.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[216,417],"terminalOffsetsZh":[55,111],"fullStemEn":"A nurse is administering intravenous fluids to a client when the infusion pump displays a 'Malfunction Error: E04' and the client reports feeling a mild tingling sensation in the arm when touching the metal IV pole. Select the primary clinical hazard, two priority actions the nurse should take immediately, and two parameters the nurse should monitor or verify to ensure client safety and resolution of the incident.","fullStemZh":"护士正在给患者输注静脉液体，此时输液泵显示“故障错误：E04”，患者报告在触碰金属输液架时手臂有轻微的刺痛感。请选择首要的临床危害、护士应立即采取的两项优先措施，以及护士应监测或核实的两个参数，以确保患者安全并解决该事件。","terminalSentenceEn":"Select the primary clinical hazard, two priority actions the nurse should take immediately, and two parameters the nurse should monitor or verify to ensure client safety and resolution of the incident.","terminalSentenceZh":"请选择首要的临床危害、护士应立即采取的两项优先措施，以及护士应监测或核实的两个参数，以确保患者安全并解决该事件。","penultimateSentenceEn":"A nurse is administering intravenous fluids to a client when the infusion pump displays a 'Malfunction Error: E04' and the client reports feeling a mild tingling sensation in the arm when touching the metal IV pole.","penultimateSentenceZh":"护士正在给患者输注静脉液体，此时输液泵显示“故障错误：E04”，患者报告在触碰金属输液架时手臂有轻微的刺痛感。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Primary clinical hazard","zh":"首要临床危害"},"tokens":[{"id":"cond_electrical","en":"Malfunctioning electrical equipment hazard","zh":"故障电气设备隐患"},{"id":"cond_infiltration","en":"Infiltration of intravenous access","zh":"静脉通路渗漏"},{"id":"cond_chemical","en":"Chemical exposure hazard","zh":"化学品暴露危害"}],"correct":"cond_electrical"},"actions":{"prompt":{"en":"Priority immediate actions","zh":"立即采取的优先措施"},"tokens":[{"id":"act_remove","en":"Unplug the pump and remove it from the clinical area immediately.","zh":"立即拔掉泵的电源并将其移出临床区域。"},{"id":"act_reset","en":"Reset the pump and try using a different wall outlet.","zh":"重置泵并尝试使用不同的墙壁插座。"},{"id":"act_tag","en":"Place a clearly visible 'Out of Service' tag on the pump.","zh":"在泵上贴上清晰可见的“停止使用”标签。"},{"id":"act_call","en":"Call the manufacturer's customer service helpline directly.","zh":"直接拨打制造商的客服求助热线。"}],"correct":["act_remove","act_tag"]},"parameters":{"prompt":{"en":"Parameters to monitor or verify","zh":"需监测或核实的参数"},"tokens":[{"id":"param_patency","en":"The patency and flow rate of the intravenous line.","zh":"静脉管路的通畅度和流速。"},{"id":"param_skin","en":"Client's skin integrity and sensation at the site of contact.","zh":"患者接触部位的皮肤完整性和感觉情况。"},{"id":"param_io","en":"The client's daily fluid intake and output records.","zh":"患者的每日液体出入量记录。"},{"id":"param_biomed","en":"Biomedical engineering department's inspection of the device.","zh":"生物医学工程部门对该设备的检测结果。"}],"correct":["param_skin","param_biomed"]}}},"rationaleCorrectEn":"The clinical hazard is malfunctioning electrical equipment, which poses an electrical shock or equipment malfunction hazard to the client. Immediate nurse actions are to unplug the device and remove it from the client's room, and tag it clearly with an 'Out of Service / Do Not Use' label to prevent reuse by others. The nurse must assess the client's skin and local neurovascular/circulatory status at the point of contact, and report the device to biomedical engineering for inspection and repair. Attempting to reset or reuse malfunctioning electrical equipment is unsafe. The nurse should report through facility channels (biomedical engineering) rather than contacting the manufacturer directly.","rationaleCorrectZh":"临床危害是故障电气设备，这会对患者造成电击和设备故障危险。护士的即时措施是拔掉设备电源并将其移出患者病房，并贴上清晰的“停止服务/禁用”标签，以防止他人再次使用。护士必须评估患者在接触部位的皮肤和局部神经血管/循环状态，并将该设备报告给生物医学工程部门以进行检测和维修。尝试重置或重复使用有故障的电气设备是不安全的。护士应通过医院机构渠道（生物医学工程科）报告，而不是直接联系制造商。","testTakingStrategyEn":"Focus on the client's report of a 'tingling sensation' to identify the electrical hazard. Apply safety concepts for broken equipment: remove from service, label/tag, and assess the client for injury.","testTakingStrategyZh":"关注患者关于“刺痛感”的报告，以识别电气危险。应用损坏设备的安全概念：停止使用、贴上标签/标记，并评估患者是否受伤。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1141,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q11","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.864","itemType":"ordered_response","category":"Safety and Infection Prevention and Control","topic":"PPE & Sterile Technique","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.864.stem.en","stemPathZh":"questions.864.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[91,145],"terminalOffsetsZh":[19,39],"fullStemEn":"The nurse is preparing to perform a sterile dressing change and is donning sterile gloves. Order the steps of sterile gloving from first to last.","fullStemZh":"护士准备进行无菌换药，正在戴无菌手套。请按从先到后的顺序排列戴无菌手套的步骤。","terminalSentenceEn":"Order the steps of sterile gloving from first to last.","terminalSentenceZh":"请按从先到后的顺序排列戴无菌手套的步骤。","penultimateSentenceEn":"The nurse is preparing to perform a sterile dressing change and is donning sterile gloves.","penultimateSentenceZh":"护士准备进行无菌换药，正在戴无菌手套。","responseContext":{"type":"ordered_response","options":[{"id":"D","en":"Insert the gloved dominant hand's fingers under the outer cuff of the second glove.","zh":"将戴好手套的优势手手指插入第二只手套的折边外侧下面。"},{"id":"E","en":"Pull the second glove onto the non-dominant hand, keeping the gloved dominant thumb abducted.","zh":"将第二只手套拉到非优势手上，保持戴好手套的优势手拇指外展。"},{"id":"B","en":"Use the non-dominant hand to pinch the inner folded cuff of the dominant hand's glove.","zh":"用非优势手捏住优势手手套的内折叠袖口。"},{"id":"A","en":"Open the outer wrapper of the glove package and place the inner package on a clean, dry surface.","zh":"打开手套包装的外层，将内包装放在清洁、干燥的表面上。"},{"id":"C","en":"Slip the dominant hand into the glove, leaving the cuff folded.","zh":"将优势手伸入手套中，保持袖口折叠状态。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"The proper sterile gloving sequence ensures that the sterile outer surface of the gloves is not contaminated by bare skin. First, the package is opened. The cuff of the first glove is touched only by the bare fingers of the non-dominant hand (touching the inside surface). The second glove is handled by sliding the gloved fingers of the dominant hand under the sterile folded cuff (touching only the sterile outside surface). The second glove is pulled on while keeping the dominant thumb abducted to prevent accidental contamination from touching bare skin.","rationaleCorrectZh":"正确的无菌手套佩戴顺序可确保手套的无菌外表面不会被裸露的皮肤污染。首先打开包装。第一只手套的袖口只能由非优势手裸手手指触摸（触摸内表面）。第二只手套的取戴则是通过将已戴手套的优势手手指滑入无菌折叠袖口下方（仅触摸无菌外表面）。拉上第二只手套时保持优势手拇指外展，以防止因接触裸露皮肤而造成意外污染。","testTakingStrategyEn":"Differentiate between the surfaces that are sterile (outside of the glove) and non-sterile (inside of the glove touching the skin) to determine where hands can touch.","testTakingStrategyZh":"区分无菌表面（手套外侧）和非无菌表面（接触皮肤的手套内侧），以确定手可以接触的部位。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"The nurse is preparing to perform a sterile dressing change and is donning sterile gloves.","controlSentenceZh":"护士准备进行无菌换药，正在戴无菌手套。"}
{"queueIndex":1142,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q12","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.865","itemType":"multiple_choice","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.865.stem.en","stemPathZh":"questions.865.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[103,149],"terminalOffsetsZh":[25,41],"fullStemEn":"The nurse is preparing to transfer a client who has right-sided weakness from the bed to a wheelchair. Which action is the priority to ensure safety?","fullStemZh":"护士正准备将一名右侧无力的患者从病床转移到轮椅上。为了确保安全，首要的措施是哪项？","terminalSentenceEn":"Which action is the priority to ensure safety?","terminalSentenceZh":"为了确保安全，首要的措施是哪项？","penultimateSentenceEn":"The nurse is preparing to transfer a client who has right-sided weakness from the bed to a wheelchair.","penultimateSentenceZh":"护士正准备将一名右侧无力的患者从病床转移到轮椅上。","responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Lock the brakes on both the bed and the wheelchair.","zh":"锁定病床和轮椅两者的刹车。"},{"id":"B","en":"Support the client under the axillae to assist them to a standing position.","zh":"在双侧腋下支撑患者，协助其站立。"},{"id":"C","en":"Position the wheelchair at a 90-degree angle to the client's bed.","zh":"将轮椅放置在与患者病床呈 90 度角的位置。"},{"id":"D","en":"Have the client place both arms around the nurse's neck for stability.","zh":"让患者用双手搂住护士的脖子以求稳定。"}],"correct":["A"]},"rationaleCorrectEn":"Locking the brakes on both the bed and the wheelchair is the highest priority safety action. It prevents the equipment from rolling or sliding away during the transfer, which could cause a fall and serious injury.","rationaleCorrectZh":"锁定病床和轮椅两者的刹车是最高优先级的安全措施。它可以防止设备在转移过程中滚动或滑开，从而导致跌倒和严重伤害。","testTakingStrategyEn":"Focus on safety principles. Lock equipment first before any physical movement begins to eliminate instability.","testTakingStrategyZh":"专注于安全原则。在开始任何身体移动之前先锁定设备，以消除不稳定性。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1143,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q13","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.866","itemType":"dropdown_cloze","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.866.stem.en","stemPathZh":"questions.866.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,116],"terminalOffsetsZh":[0,30],"fullStemEn":"The nurse is providing discharge instructions to a client with left-sided weakness who will be using a cane at home.","fullStemZh":"护士正在向一名左侧无力且将在家中使用手杖的患者提供出院指导。","terminalSentenceEn":"The nurse is providing discharge instructions to a client with left-sided weakness who will be using a cane at home.","terminalSentenceZh":"护士正在向一名左侧无力且将在家中使用手杖的患者提供出院指导。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The client should hold the cane on the {{1}} side. When walking, the client should advance the cane first, followed by the {{2}} leg.","zh":"患者应在 {{1}} 侧扶手杖。行走时，患者应先将手杖迈出，随后迈出 {{2}} 侧腿。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"right (unaffected)","zh":"右（健）"},{"id":"o2","en":"left (affected)","zh":"左（患）"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"left (weak)","zh":"左（弱）"},{"id":"o2","en":"right (strong)","zh":"右（强）"}],"correct":"o1"}]},"rationaleCorrectEn":"A cane should always be held on the unaffected (stronger) side to provide balance and redistribute weight away from the affected limb. In this client, that is the right hand. When walking, the sequence is: advance the cane first, then advance the weaker leg (left) to the level of the cane, and finally step past with the stronger leg (right).","rationaleCorrectZh":"手杖应始终持在未受累（较强健）的一侧，以提供平衡并分担患侧肢体的重量。对于该患者，即右手。行走时，顺序为：先迈手杖，再将较弱的腿（左腿）迈至手杖水平，最后将健侧的腿（右腿）迈过手杖。","testTakingStrategyEn":"Use the mnemonic 'COAL' (Cane Opposite Affected Limb) to remember which hand holds the cane.","testTakingStrategyZh":"使用记忆法“手杖持于患侧对侧”来记住哪只手拿手杖。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1144,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q14","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.867","itemType":"dropdown_cloze","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.867.stem.en","stemPathZh":"questions.867.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,112],"terminalOffsetsZh":[0,35],"fullStemEn":"A nurse enters a room and finds an adult client actively experiencing a generalized tonic-clonic seizure in bed.","fullStemZh":"护士进入病房，发现一名成年患者正在床上发生全身性强直-阵挛性癫痫发作。","terminalSentenceEn":"A nurse enters a room and finds an adult client actively experiencing a generalized tonic-clonic seizure in bed.","terminalSentenceZh":"护士进入病房，发现一名成年患者正在床上发生全身性强直-阵挛性癫痫发作。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse's priority action is to {{1}}. After the seizure activity ends, the nurse should place the client in a {{2}} position.","zh":"护士的首要措施是 {{1}}。癫痫发作停止后，护士应将患者置于 {{2}} 体位。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"turn the client onto their side","zh":"将患者转到侧卧位"},{"id":"o2","en":"insert an oral airway","zh":"插入人工气道"},{"id":"o3","en":"hold the client's limbs to restrict movement","zh":"按住患者肢体以限制活动"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"high-Fowler's","zh":"高半坐卧位"},{"id":"o1","en":"side-lying","zh":"侧卧位"},{"id":"o3","en":"supine","zh":"仰卧位"}],"correct":"o1"}]},"rationaleCorrectEn":"During an active seizure, turning the client onto their side is the priority to keep the airway clear of saliva or vomitus, preventing aspiration. Restraining limbs or inserting items into the mouth is contraindicated due to injury risk. Once the seizure ends (postictal phase), placing the client in a side-lying recovery position keeps the tongue from obstructing the airway and allows secretions to drain.","rationaleCorrectZh":"在癫痫发作期间，将患者转向侧卧位是首要措施，以保持气道内无唾液或呕吐物，防止误吸。由于存在受伤风险，禁止约束肢体或向口中插入物品。发作结束（发作后期）后，将患者置于侧卧恢复体位，可防止舌后坠阻塞气道并便于分泌物排出。","testTakingStrategyEn":"Remember that airway protection is the primary goal in seizure management. Side-lying positions prevent aspiration during and after the event.","testTakingStrategyZh":"记住气道保护是癫痫发作护理的首要目标。侧卧位可以预防发作中和发作后的误吸。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1145,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q15","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.868","itemType":"select_all","category":"Safety and Infection Prevention and Control","topic":"Transmission-Based Precautions","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.868.stem.en","stemPathZh":"questions.868.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[117,139],"terminalOffsetsZh":[39,47],"fullStemEn":"The nurse is reviewing transmission-based precaution guidelines. Which client diagnoses require Droplet Precautions? Select all that apply.","fullStemZh":"护士正在复习基于传播途径的隔离指南。以下哪些患者诊断需要采取飞沫隔离预防措施？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which client diagnoses require Droplet Precautions?","penultimateSentenceZh":"以下哪些患者诊断需要采取飞沫隔离预防措施？","responseContext":{"type":"select_all","options":[{"id":"B","en":"Mycobacterium tuberculosis pulmonary infection","zh":"结核分枝杆菌肺部感染"},{"id":"C","en":"Pertussis (whooping cough)","zh":"百日咳"},{"id":"A","en":"Neisseria meningitidis meningitis","zh":"脑膜炎奈瑟菌脑膜炎"},{"id":"D","en":"Haemophilus influenzae type B epiglottitis","zh":"乙型流感嗜血杆菌会厌炎"},{"id":"F","en":"Mycoplasma pneumoniae pneumonia","zh":"肺炎支原体肺炎"},{"id":"E","en":"Varicella (chickenpox) with open lesions","zh":"水痘伴开放性皮损"}],"correct":["A","C","D","F"]},"rationaleCorrectEn":"Droplet precautions are indicated for pathogens transmitted by large respiratory droplets that travel short distances (typically 3 to 6 feet). Examples include Neisseria meningitidis, Pertussis, Haemophilus influenzae type B, and Mycoplasma pneumoniae. Pulmonary tuberculosis and varicella (chickenpox) require Airborne Precautions because they spread via tiny droplet nuclei that remain suspended in the air.","rationaleCorrectZh":"飞沫隔离预防措施适用于通过近距离（通常为 3 至 6 英尺）传播的大颗粒呼吸道飞沫传播的病原体。例如：脑膜炎奈瑟菌、百日咳、乙型流感嗜血杆菌和肺炎支原体。肺结核和水痘需要空气传播隔离措施，因为它们通过悬浮在空气中的微小飞沫核传播。","testTakingStrategyEn":"Group common pediatric and respiratory bacterial infections under droplet transmission, and reserve airborne precautions for the 'Airborne' trio: Measles, Tuberculosis, and Varicella (chickenpox).","testTakingStrategyZh":"将常见的儿童和呼吸道细菌感染归为飞沫传播，而将空气隔离措施保留给空气传播“三剑客”：麻疹、结核病和水痘。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1146,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q16","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.869","itemType":"select_all","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.869.stem.en","stemPathZh":"questions.869.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[207,229],"terminalOffsetsZh":[60,68],"fullStemEn":"A confused, older adult client is repeatedly attempting to pull out their peripherally inserted central catheter (PICC) line. Which nursing interventions are appropriate alternatives to physical restraints? Select all that apply.","fullStemZh":"一名认知混乱的老年患者反复尝试拔除其经外周穿刺的中心静脉导管（PICC）。以下哪些护理干预措施是身体约束的合适替代方法？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which nursing interventions are appropriate alternatives to physical restraints?","penultimateSentenceZh":"以下哪些护理干预措施是身体约束的合适替代方法？","responseContext":{"type":"select_all","options":[{"id":"E","en":"Request a prescription for scheduled haloperidol to calm the client's agitation.","zh":"申请定期使用氟哌啶醇的医嘱，以缓解患者的烦躁情绪。"},{"id":"F","en":"Raise all four side rails of the bed to restrict the client's reach.","zh":"抬起病床的全部四个床栏以限制患者触及导管。"},{"id":"B","en":"Use a bed alarm to monitor the client's attempts to exit the bed.","zh":"使用床栏/床面警报器来监测患者起床下地的尝试。"},{"id":"C","en":"Cover the PICC line site with a stretchable stockingnet sleeve wrap.","zh":"用有弹性的网状套袖包扎覆盖 PICC 导管部位。"},{"id":"D","en":"Provide quiet, structured diversional activities such as folding towels.","zh":"提供安静、有条理的消遣活动，例如折叠毛巾。"},{"id":"A","en":"Place the client in a room close to the nurses' station.","zh":"将患者安置在靠近护士站的病房内。"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"Restraint alternatives are non-restrictive interventions designed to promote safety and redirection without restricting movement. Safe alternatives include proximity to the nurses' station for frequent observation, alarms to monitor safety, concealing medical lines with clothing or sleeves, and using redirection or diversional tasks. Using sedatives as a scheduled chemical restraint or raising all four side rails (a physical restraint) are not appropriate alternatives.","rationaleCorrectZh":"约束替代方法是旨在促进安全和引导注意力而不限制活动的非限制性干预措施。安全的替代方法包括靠近护士站以便频繁观察、报警器监测安全、用衣物或套袖遮盖医疗管路，以及使用注意力引导或消遣任务。使用镇静剂作为定期化学约束，或抬起所有四个床栏（属于身体约束），都不是合适的替代方法。","testTakingStrategyEn":"Differentiate between interventions that facilitate redirection and safety (alternatives) versus those that physically or chemically restrict movement (restraints).","testTakingStrategyZh":"区分有助于引导注意力和保障安全（替代方法）的干预措施与通过物理或化学方式限制活动（约束）的措施。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1147,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q17","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.870","itemType":"highlight","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.870.stem.en","stemPathZh":"questions.870.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,105],"terminalOffsetsZh":[0,22],"fullStemEn":"Highlight the actions in the nurse's response that represent correct steps in the fire response protocol.","fullStemZh":"标出护士在火灾应急响应中代表正确步骤的行为。","terminalSentenceEn":"Highlight the actions in the nurse's response that represent correct steps in the fire response protocol.","terminalSentenceZh":"标出护士在火灾应急响应中代表正确步骤的行为。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"A nurse discovers a small fire igniting in a client's wastebasket.","zh":"护士发现患者的废纸篓里燃起了小火。"},{"id":"s2","en":"The nurse immediately carries the burning wastebasket out into the hallway to prevent room damage.","zh":"护士立即将着火的废纸篓拿到走廊上，以防止房间受损。","selectable":true},{"id":"s3","en":"The nurse assists the client out of the room and into the hallway.","zh":"护士协助患者离开房间进入走廊。","selectable":true},{"id":"s4","en":"The nurse pulls the fire alarm pull-station and calls the emergency operator.","zh":"护士拉响火灾报警器并致电应急操作员。","selectable":true},{"id":"s5","en":"The nurse closes the door to the client's room tightly.","zh":"护士紧紧关闭患者病房的门。","selectable":true},{"id":"s6","en":"The nurse uses a water extinguisher to try to put out a fire on an electrical bedside monitor.","zh":"护士使用水性灭火器试图扑灭床旁电子监护仪上的火。","selectable":true}],"correct":["s3","s4","s5"]}},"rationaleCorrectEn":"The correct protocol for hospital fire response follows the RACE acronym: Rescue (assist the client to safety), Alarm (activate the fire alarm), Contain (close doors to prevent fire and smoke spread), and Extinguish/Evacuate. Moving a burning object down a hallway is dangerous and violates safety protocols. Using a water extinguisher on an electrical fire is incorrect because water conducts electricity, posing a severe shock hazard; a Class C (dry chemical or carbon dioxide) extinguisher must be used.","rationaleCorrectZh":"医院火灾应急的正确步骤遵循 RACE 首字母缩写：Rescue 救援（协助患者安全撤离）、Alarm 报警（激活火灾报警器）、Contain 隔离（关闭房门以防火灾和浓烟扩散）以及 Extinguish/Evacuate 灭火/疏散。将燃烧的物体拿到走廊上是危险的，违反了安全规范。在电气火灾上使用水性灭火器是错误的，因为水导电，会产生严重的电击危险；必须使用 C 类（干粉或二氧化碳）灭火器。","testTakingStrategyEn":"Apply the RACE framework. Remember that client safety (Rescue) is always first, and water must never be used on electrical equipment.","testTakingStrategyZh":"应用 RACE 框架。记住患者安全（Rescue）始终是第一位的，并且绝对不能在电气设备上用水。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1148,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q18","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.871","itemType":"highlight","category":"Safety and Infection Prevention and Control","topic":"Standard Precautions & Hygiene","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.871.stem.en","stemPathZh":"questions.871.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,109],"terminalOffsetsZh":[0,25],"fullStemEn":"Highlight the actions or decisions in the passage that violate standard sharps safety or disposal guidelines.","fullStemZh":"标出文章中违反标准锐器安全或处置规范的行为或决定。","terminalSentenceEn":"Highlight the actions or decisions in the passage that violate standard sharps safety or disposal guidelines.","terminalSentenceZh":"标出文章中违反标准锐器安全或处置规范的行为或决定。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"highlight","highlight":{"segments":[{"id":"s1","en":"The nurse is preparing to administer an intramuscular injection to a client.","zh":"护士正准备给患者进行肌肉注射。"},{"id":"s2","en":"Immediately after withdrawing the syringe, the nurse uses a two-handed technique to recap the dirty needle.","zh":"拔出注射器后，护士立即使用双手操作技术为用过的针头戴上针帽。","selectable":true},{"id":"s3","en":"The nurse walks down the hallway holding the uncapped syringe to find a disposal container.","zh":"护士拿着未戴帽的注射器走下走廊，寻找处置容器。","selectable":true},{"id":"s4","en":"The nurse discards the syringe into a sharps container located in the client's room that is filled to about half capacity.","zh":"护士将注射器丢入位于该患者病房内的、装了大约一半容量的锐器盒中。","selectable":true},{"id":"s5","en":"The nurse uses a finger to push down a protruding needle to make room in the container.","zh":"护士用手指按下锐器盒中一根突出的针头以腾出空间。","selectable":true}],"correct":["s2","s3","s5"]}},"rationaleCorrectEn":"Sharps safety guidelines strictly prohibit two-handed recapping of contaminated needles to prevent needlestick injuries. Carrying exposed uncapped needles through public hallways is a safety risk; sharps must be disposed of immediately at the point of use. Never place hands or fingers inside a sharps container or push down on needles to make room. Discarding the syringe into a half-full container at the point of use (client's room) is a correct, safe action.","rationaleCorrectZh":"锐器安全指南严格禁止用双手对受污染的针头进行回套，以防针刺伤。将裸露未戴帽的针头带到公共走廊是一项安全隐患；锐器必须在现场（使用点）立即处置。绝对不能将手或手指伸入锐器盒中，也不能向下按压针头以腾出空间。在现场（患者病房内）将注射器丢入半满的容器中是正确的安全操作。","testTakingStrategyEn":"Recall OSHA and CDC sharps safety guidelines. Safety shields are activated immediately at the bedside, and needles are never carried exposed or forced into containers.","testTakingStrategyZh":"回想 OSHA 和 CDC 锐器安全指南。防护安全锁在床旁立即激活，并且绝对不能携带裸露的针头行走或强行按压容器中的针头。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1149,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q19","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.872","itemType":"bowtie","category":"Safety and Infection Prevention and Control","topic":"Transmission-Based Precautions","difficulty":"easy","ngnSkill":null,"stemPathEn":"questions.872.stem.en","stemPathZh":"questions.872.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[174,380],"terminalOffsetsZh":[39,97],"fullStemEn":"A nurse is preparing to provide isolation instructions to the family members of a client admitted with disseminated herpes zoster (shingles) with open, weeping skin lesions. Select the primary infection control precautions category, two priority actions the family must perform, and two parameters the nurse should monitor or verify to evaluate the family's compliance and safety.","fullStemZh":"护士正准备为一名因播散性带状疱疹（皮损开放渗液）入院的患者的家属提供隔离指导。请选择主要的感染控制隔离类别、家属必须执行的两项优先措施，以及护士应监测或核实的两个参数以评估家属的合规性与安全性。","terminalSentenceEn":"Select the primary infection control precautions category, two priority actions the family must perform, and two parameters the nurse should monitor or verify to evaluate the family's compliance and safety.","terminalSentenceZh":"请选择主要的感染控制隔离类别、家属必须执行的两项优先措施，以及护士应监测或核实的两个参数以评估家属的合规性与安全性。","penultimateSentenceEn":"A nurse is preparing to provide isolation instructions to the family members of a client admitted with disseminated herpes zoster (shingles) with open, weeping skin lesions.","penultimateSentenceZh":"护士正准备为一名因播散性带状疱疹（皮损开放渗液）入院的患者的家属提供隔离指导。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Isolation precautions category","zh":"隔离预防措施类别"},"tokens":[{"id":"cond_air_contact","en":"Airborne and Contact Precautions","zh":"空气传播和接触预防措施"},{"id":"cond_standard","en":"Standard Precautions only","zh":"仅标准预防措施"},{"id":"cond_droplet","en":"Droplet Precautions guidelines","zh":"飞沫预防措施规范"}],"correct":"cond_air_contact"},"actions":{"prompt":{"en":"Priority actions to teach family","zh":"教授给家属的优先措施"},"tokens":[{"id":"act_n95","en":"Wear an N95 respirator if approved to enter; family members without immunity to varicella must not enter the room.","zh":"获得批准进入时佩戴 N95 呼吸器；对水痘无免疫力的家属绝不能进入病房。"},{"id":"act_surgical","en":"Wear a standard surgical mask only and no gown.","zh":"仅佩戴标准外科口罩，无需穿隔离衣。"},{"id":"act_gown_gloves","en":"Don a clean gown and gloves for all entries into the room.","zh":"所有进入病房的情况都要穿戴清洁的隔离衣和手套。"},{"id":"act_no_gloves","en":"Touch the client's intact skin without wearing gloves.","zh":"在不戴手套的情况下接触患者未破损的皮肤。"}],"correct":["act_n95","act_gown_gloves"]},"parameters":{"prompt":{"en":"Parameters to monitor or verify","zh":"需监测或核实的参数"},"tokens":[{"id":"param_compliance","en":"Family's compliance with hand hygiene and PPE sequence.","zh":"家属对手部卫生和 PPE 穿脱顺序的合规性。"},{"id":"param_immunity","en":"Varicella immunity status of family members visiting.","zh":"来访家属的水痘免疫状态。"},{"id":"param_caloric","en":"The client's daily caloric intake.","zh":"患者的每日热量摄入。"},{"id":"param_urine","en":"The client's hourly urine output.","zh":"患者的每小时尿量。"}],"correct":["param_immunity","param_compliance"]}}},"rationaleCorrectEn":"Disseminated herpes zoster (shingles) requires both Airborne and Contact Precautions. This is because the virus can be transmitted through droplet nuclei suspended in the air and through direct contact with fluid from the lesions. Approved visitors who enter the room must follow facility airborne/contact PPE policy, including wearing an N95 respirator mask, a clean gown, and gloves. Non-immune family members/visitors should not enter the room. The nurse should verify the varicella (chickenpox) immunity status of family members and monitor compliance with hand hygiene and PPE donning/doffing sequence.","rationaleCorrectZh":"播散性带状疱疹需要同时采取空气传播和接触预防隔离措施。这是因为该病毒可以通过悬浮在空气中的飞沫核传播，也可以通过直接接触皮损渗液传播。进入病房的获批访客必须遵守机构的空气传播和接触预防 PPE 政策，包括佩戴 N95 呼吸器口罩、穿戴清洁的隔离衣和手套。无免疫力的家属/访客不应进入病房。护士应核查来访家属的水痘免疫状态，并监测他们对手部卫生和 PPE 穿脱顺序的合规性。","testTakingStrategyEn":"Differentiate localized shingles (standard precautions if covered) from disseminated shingles (airborne and contact precautions). Identify that varicella virus exposure causes chickenpox in non-immune individuals.","testTakingStrategyZh":"区分局限性带状疱疹（皮损已覆盖时采用标准预防）与播散性带状疱疹（空气和接触隔离）。明确水痘病毒接触会在非免疫个体中引起水痘。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1150,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_sic_ngn_2026_06_21_q20","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.873","itemType":"bowtie","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.873.stem.en","stemPathZh":"questions.873.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[129,308],"terminalOffsetsZh":[45,96],"fullStemEn":"A client is admitted to a private room for internal radiation therapy (brachytherapy) using a sealed temporary cervical implant. Select the primary safety precautions category, two priority actions the nurse must take, and two parameters the nurse should monitor to ensure environmental and radiation safety.","fullStemZh":"一名患者因使用密封性临时子宫颈植入物进行体内放射治疗（后装放疗/近距离治疗）入住单人病房。请选择主要的安全防护类别、护士必须采取的两项优先措施，以及护士应监测的两个参数，以确保环境和辐射安全。","terminalSentenceEn":"Select the primary safety precautions category, two priority actions the nurse must take, and two parameters the nurse should monitor to ensure environmental and radiation safety.","terminalSentenceZh":"请选择主要的安全防护类别、护士必须采取的两项优先措施，以及护士应监测的两个参数，以确保环境和辐射安全。","penultimateSentenceEn":"A client is admitted to a private room for internal radiation therapy (brachytherapy) using a sealed temporary cervical implant.","penultimateSentenceZh":"一名患者因使用密封性临时子宫颈植入物进行体内放射治疗（后装放疗/近距离治疗）入住单人病房。","responseContext":{"type":"bowtie","bowtie":{"condition":{"prompt":{"en":"Radiation safety precautions category","zh":"放射安全防护类别"},"tokens":[{"id":"cond_unsealed","en":"Unsealed source radiation precautions","zh":"非密封源放射安全防护规范"},{"id":"cond_sealed","en":"Sealed source radiation safety precautions","zh":"密封源放射安全防护规范"},{"id":"cond_standard","en":"Standard contact precautions only","zh":"仅标准接触预防措施"}],"correct":"cond_sealed"},"actions":{"prompt":{"en":"Priority nursing actions","zh":"优先护理措施"},"tokens":[{"id":"act_ambulate","en":"Encourage frequent ambulation in the hallway to prevent DVT.","zh":"鼓励经常在走廊活动以预防深静脉血栓。"},{"id":"act_fluids","en":"Save all linens and body fluid waste in lead-lined bags.","zh":"将所有床单和体液废弃物存放在铅衬袋中。"},{"id":"act_limit","en":"Limit visitors to 30 minutes per day and maintain a 6-foot distance.","zh":"限制访客每天最多 30 分钟，并保持 6 英尺距离。"},{"id":"act_forceps","en":"Keep a lead container and long-handled forceps in the room.","zh":"在病房内备好铅罐和长柄镊子。"}],"correct":["act_forceps","act_limit"]},"parameters":{"prompt":{"en":"Parameters to monitor","zh":"需要监测的参数"},"tokens":[{"id":"param_vitals","en":"Continuous vital signs and blood pressure.","zh":"连续生命体征和血压。"},{"id":"param_bedrest","en":"Client's strict bed rest compliance and implant position.","zh":"患者绝对卧床合规性及植入物位置。"},{"id":"param_dosimeter","en":"Radiation exposure on the nurse's dosimeter badge.","zh":"护士剂量计袖章上的辐射暴露量。"},{"id":"param_cognition","en":"Client's orientation and cognitive status.","zh":"患者的定向力和认知状态。"}],"correct":["param_dosimeter","param_bedrest"]}}},"rationaleCorrectEn":"Sealed source internal radiation therapy requires sealed source radiation safety precautions (Time, Distance, Shielding). Priority nursing actions include: 1) Keeping a lead container and long-handled forceps in the client's room in case the implant becomes dislodged (never touch a dislodged source with bare hands). 2) Limiting visitor time to a maximum of 30 minutes per day and maintaining a minimum distance of 6 feet. Parameters to monitor include the cumulative radiation exposure of the nurse using a film badge (dosimeter) and the client's compliance with strict bed rest (as movement can dislodge the implant). Pregnant staff/visitors and children must not enter.","rationaleCorrectZh":"密封源体内放射治疗需要密封源放射安全防护规范（时间、距离、屏蔽）。优先的护理措施包括：1) 在患者病房内放置一个铅罐和长柄镊子，以防植入物脱落（绝不能用裸手触摸脱落的放射源）。2) 限制访客时间为每天最多 30 分钟，并保持至少 6 英尺的距离。需要监测的参数包括使用胶片袖章（剂量计）监测护士的累积辐射暴露量，以及患者对绝对卧床休息的合规性（因为活动可能会使植入物脱位）。怀孕的工作人员/访客和儿童绝不能进入。","testTakingStrategyEn":"Remember the three pillars of radiation safety: Time (minimize), Distance (maximize to 6 feet), and Shielding (lead shields). Keep forceps and a lead container in the room.","testTakingStrategyZh":"记住辐射安全的三大支柱：时间（最小化）、距离（最大化至 6 英尺）和屏蔽（铅屏障）。在病房内备好长镊和铅罐。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1151,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"mc_delegation_uap_vitals_001","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.0","itemType":"multiple_choice","category":"Management of Care","topic":"Prioritization & Delegation","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.0.stem.en","stemPathZh":"questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[65,148],"terminalOffsetsZh":[16,39],"fullStemEn":"The nurse is caring for four clients on a medical-surgical unit. Which task is most appropriate to delegate to unlicensed assistive personnel (UAP)?","fullStemZh":"护士正在内外科病房照护四位患者。哪项工作最适合委派给无执照辅助人员（UAP）？","terminalSentenceEn":"Which task is most appropriate to delegate to unlicensed assistive personnel (UAP)?","terminalSentenceZh":"哪项工作最适合委派给无执照辅助人员（UAP）？","penultimateSentenceEn":"The nurse is caring for four clients on a medical-surgical unit.","penultimateSentenceZh":"护士正在内外科病房照护四位患者。","responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Obtain a routine blood pressure on a stable client before breakfast.","zh":"在早餐前为一位病情稳定的患者测量常规血压。"},{"id":"B","en":"Teach a client newly diagnosed with heart failure how to restrict sodium.","zh":"教一位新诊断为心力衰竭的患者如何限制钠摄入。"},{"id":"C","en":"Assess the pain level of a client who returned from surgery 30 minutes ago.","zh":"评估一位术后返回病房30分钟患者的疼痛程度。"},{"id":"D","en":"Evaluate a client's understanding of discharge medications.","zh":"评价患者对出院用药的理解程度。"}],"correct":["A"]},"rationaleCorrectEn":"Routine vital signs on a stable client are predictable and may be delegated to UAP. The nurse remains responsible for interpreting abnormal findings.","rationaleCorrectZh":"为病情稳定的患者测量常规生命体征属于可预期的任务，可以委派给UAP。护士仍需负责解释异常结果。","testTakingStrategyEn":"Delegate tasks that are stable, routine, and have a predictable outcome; keep assessment, teaching, and evaluation with the RN.","testTakingStrategyZh":"委派稳定、常规、结果可预期的任务；评估、教育和评价应由注册护士负责。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1152,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"sata_prioritize_change_condition_002","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.1","itemType":"select_all","category":"Management of Care","topic":"Prioritization & Delegation","difficulty":"medium","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.1.stem.en","stemPathZh":"questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[60,82],"terminalOffsetsZh":[15,23],"fullStemEn":"Which client findings require the nurse to follow up first? Select all that apply.","fullStemZh":"哪些患者发现需要护士优先跟进？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which client findings require the nurse to follow up first?","penultimateSentenceZh":"哪些患者发现需要护士优先跟进？","responseContext":{"type":"select_all","options":[{"id":"A","en":"A client with pneumonia has new confusion and oxygen saturation of 88%.","zh":"肺炎患者出现新的意识混乱，血氧饱和度为88%。"},{"id":"D","en":"A client awaiting discharge asks when the ride should arrive.","zh":"等待出院的患者询问接送车辆何时到达。"},{"id":"E","en":"A client after thyroidectomy has stridor and increasing neck swelling.","zh":"甲状腺切除术后患者出现喘鸣和颈部肿胀加重。"},{"id":"B","en":"A client with chronic arthritis reports pain of 4 out of 10 before morning medication.","zh":"慢性关节炎患者在晨间用药前报告疼痛4/10。"},{"id":"C","en":"A client receiving heparin has black, tarry stool.","zh":"正在接受肝素治疗的患者出现黑色柏油样大便。"}],"correct":["A","C","E"]},"rationaleCorrectEn":"New hypoxia with confusion, signs of gastrointestinal bleeding while on heparin, and airway compromise after thyroidectomy are urgent changes in condition.","rationaleCorrectZh":"新的低氧伴意识混乱、使用肝素期间出现胃肠道出血迹象，以及甲状腺术后气道受压，都是需要紧急处理的病情变化。","testTakingStrategyEn":"Use ABCs and acute change in condition before stable chronic needs.","testTakingStrategyZh":"先考虑气道、呼吸、循环和急性病情变化，再处理稳定的慢性需求。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1153,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"mc_informed_consent_signature_003","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.2","itemType":"multiple_choice","category":"Management of Care","topic":"Legal & Ethical Principles","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.2.stem.en","stemPathZh":"questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[118,150],"terminalOffsetsZh":[34,44],"fullStemEn":"A client scheduled for surgery says, \"I signed the form, but I still do not understand what the surgeon will remove.\" What is the nurse's best action?","fullStemZh":"一位计划手术的患者说：“我签了表，但还是不明白外科医生要切除什么。”护士最佳行动是什么？","terminalSentenceEn":"What is the nurse's best action?","terminalSentenceZh":"护士最佳行动是什么？","penultimateSentenceEn":"A client scheduled for surgery says, \"I signed the form, but I still do not understand what the surgeon will remove.\"","penultimateSentenceZh":"一位计划手术的患者说：“我签了表，但还是不明白外科医生要切除什么。”","responseContext":{"type":"multiple_choice","options":[{"id":"C","en":"Notify the surgeon that the client has questions before surgery.","zh":"通知外科医生患者在手术前仍有疑问。"},{"id":"B","en":"Document that the client signed the consent voluntarily.","zh":"记录患者自愿签署了同意书。"},{"id":"D","en":"Ask the family member to explain the procedure again.","zh":"请家属再次解释手术过程。"},{"id":"A","en":"Explain the surgical procedure using the consent form.","zh":"根据同意书向患者解释手术过程。"}],"correct":["C"]},"rationaleCorrectEn":"The provider performing the procedure is responsible for explaining risks, benefits, and alternatives. The nurse witnesses consent and advocates when understanding is unclear.","rationaleCorrectZh":"执行手术的医护提供者负责解释风险、获益和替代方案。护士见证签署并在患者理解不清时维护患者权益。","testTakingStrategyEn":"When understanding is missing, stop and involve the provider before the procedure.","testTakingStrategyZh":"如果患者缺乏理解，应暂停流程并在操作前联系医护提供者。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1154,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"mc_airborne_tb_precautions_004","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.3","itemType":"multiple_choice","category":"Safety and Infection Prevention and Control","topic":"Transmission-Based Precautions","difficulty":"easy","ngnSkill":"take_action","stemPathEn":"questions.3.stem.en","stemPathZh":"questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[60,101],"terminalOffsetsZh":[12,24],"fullStemEn":"A client with suspected pulmonary tuberculosis is admitted. Which action should the nurse take first?","fullStemZh":"一位疑似肺结核患者入院。护士首先应采取哪项措施？","terminalSentenceEn":"Which action should the nurse take first?","terminalSentenceZh":"护士首先应采取哪项措施？","penultimateSentenceEn":"A client with suspected pulmonary tuberculosis is admitted.","penultimateSentenceZh":"一位疑似肺结核患者入院。","responseContext":{"type":"multiple_choice","options":[{"id":"C","en":"Use contact precautions for all care.","zh":"所有护理均采用接触隔离。"},{"id":"D","en":"Apply a surgical mask before entering the room.","zh":"进入病房前佩戴外科口罩。"},{"id":"B","en":"Keep the room door open to improve air circulation.","zh":"保持病房门打开以改善空气流通。"},{"id":"A","en":"Place the client in a private negative-pressure room.","zh":"将患者安置在单人负压病房。"}],"correct":["A"]},"rationaleCorrectEn":"Suspected tuberculosis requires airborne precautions, including a negative-pressure room and N95 respirator use by staff.","rationaleCorrectZh":"疑似肺结核需要空气传播隔离，包括负压病房以及工作人员使用N95呼吸防护口罩。","testTakingStrategyEn":"Match the organism to the transmission route; tuberculosis is airborne.","testTakingStrategyZh":"将病原体与传播途径对应；肺结核属于空气传播。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"A client with suspected pulmonary tuberculosis is admitted.","controlSentenceZh":"一位疑似肺结核患者入院。"}
{"queueIndex":1155,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"sata_fall_risk_interventions_005","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.4","itemType":"select_all","category":"Safety and Infection Prevention and Control","topic":"Standard Precautions & Hygiene","difficulty":"easy","ngnSkill":"generate_solutions","stemPathEn":"questions.4.stem.en","stemPathZh":"questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[91,113],"terminalOffsetsZh":[34,42],"fullStemEn":"Which interventions reduce fall risk for an older adult who is weak and taking a diuretic? Select all that apply.","fullStemZh":"对于一位身体虚弱并正在服用利尿剂的老年患者，哪些措施可降低跌倒风险？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which interventions reduce fall risk for an older adult who is weak and taking a diuretic?","penultimateSentenceZh":"对于一位身体虚弱并正在服用利尿剂的老年患者，哪些措施可降低跌倒风险？","responseContext":{"type":"select_all","options":[{"id":"E","en":"Offer toileting on a regular schedule.","zh":"按固定时间协助如厕。"},{"id":"C","en":"Encourage the client to walk to the bathroom alone to build independence.","zh":"鼓励患者独自步行去厕所，以增强独立性。"},{"id":"D","en":"Provide nonskid footwear when out of bed.","zh":"下床时提供防滑鞋袜。"},{"id":"B","en":"Place the call light within reach.","zh":"将呼叫铃放在患者可触及处。"},{"id":"A","en":"Keep the bed in the lowest position.","zh":"保持床位在最低位置。"}],"correct":["A","B","D","E"]},"rationaleCorrectEn":"Low bed position, call light access, nonskid footwear, and scheduled toileting address weakness and diuretic-related urgency.","rationaleCorrectZh":"低床位、可触及呼叫铃、防滑鞋袜和定时如厕可应对虚弱以及利尿剂引起的尿急。","testTakingStrategyEn":"For safety questions, choose interventions that reduce predictable hazards without limiting mobility unnecessarily.","testTakingStrategyZh":"安全题应选择能减少可预见危险且不过度限制活动的措施。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1156,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"mc_needlestick_first_action_006","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.5","itemType":"multiple_choice","category":"Safety and Infection Prevention and Control","topic":"Standard Precautions & Hygiene","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.5.stem.en","stemPathZh":"questions.5.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[67,98],"terminalOffsetsZh":[12,21],"fullStemEn":"The nurse sustains a needlestick injury after giving an injection. What should the nurse do first?","fullStemZh":"护士在注射后发生针刺伤。护士首先应做什么？","terminalSentenceEn":"What should the nurse do first?","terminalSentenceZh":"护士首先应做什么？","penultimateSentenceEn":"The nurse sustains a needlestick injury after giving an injection.","penultimateSentenceZh":"护士在注射后发生针刺伤。","responseContext":{"type":"multiple_choice","options":[{"id":"C","en":"Call employee health for follow-up testing.","zh":"联系员工健康部门进行后续检测。"},{"id":"B","en":"Ask the client about HIV risk factors.","zh":"询问患者是否有HIV危险因素。"},{"id":"D","en":"Wash the puncture site with soap and water.","zh":"用肥皂和清水清洗针刺部位。"},{"id":"A","en":"Complete an incident report.","zh":"填写事件报告。"}],"correct":["D"]},"rationaleCorrectEn":"Immediate cleansing of the site is the first action after exposure. Reporting and follow-up testing occur after first aid.","rationaleCorrectZh":"暴露后首先应立即清洗伤口。报告和后续检测应在急救处理之后进行。","testTakingStrategyEn":"When an exposure occurs, perform immediate first aid before paperwork or follow-up.","testTakingStrategyZh":"发生职业暴露时，应先立即急救，再处理文书和随访。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1157,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"mc_pregnancy_folic_acid_007","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.6","itemType":"multiple_choice","category":"Health Promotion and Maintenance","topic":"Maternal-Newborn Care & Teaching","difficulty":"easy","ngnSkill":"generate_solutions","stemPathEn":"questions.6.stem.en","stemPathZh":"questions.6.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[90,133],"terminalOffsetsZh":[25,35],"fullStemEn":"A client who plans to become pregnant asks how to reduce the risk of neural tube defects. Which instruction should the nurse include?","fullStemZh":"一位计划怀孕的患者询问如何降低胎儿神经管缺陷风险。护士应包括哪项指导？","terminalSentenceEn":"Which instruction should the nurse include?","terminalSentenceZh":"护士应包括哪项指导？","penultimateSentenceEn":"A client who plans to become pregnant asks how to reduce the risk of neural tube defects.","penultimateSentenceZh":"一位计划怀孕的患者询问如何降低胎儿神经管缺陷风险。","responseContext":{"type":"multiple_choice","options":[{"id":"B","en":"Begin prenatal care after fetal movement is felt.","zh":"感觉到胎动后再开始产前护理。"},{"id":"C","en":"Take folic acid daily before conception and during early pregnancy.","zh":"受孕前及孕早期每日服用叶酸。"},{"id":"D","en":"Avoid all dairy products during the first trimester.","zh":"孕早期避免所有乳制品。"},{"id":"A","en":"Limit fluid intake to prevent ankle swelling.","zh":"限制液体摄入以预防踝部水肿。"}],"correct":["C"]},"rationaleCorrectEn":"Folic acid taken before conception and in early pregnancy helps reduce neural tube defect risk.","rationaleCorrectZh":"受孕前和孕早期服用叶酸有助于降低神经管缺陷风险。","testTakingStrategyEn":"Health promotion questions often ask for prevention before disease or complications occur.","testTakingStrategyZh":"健康促进题常考在疾病或并发症发生前进行预防。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1158,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"sata_newborn_safety_teaching_008","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.7","itemType":"select_all","category":"Health Promotion and Maintenance","topic":"Maternal-Newborn Care & Teaching","difficulty":"easy","ngnSkill":"generate_solutions","stemPathEn":"questions.7.stem.en","stemPathZh":"questions.7.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[71,93],"terminalOffsetsZh":[22,30],"fullStemEn":"Which teaching points should the nurse include for safe newborn sleep? Select all that apply.","fullStemZh":"关于新生儿安全睡眠，护士应包括哪些教育要点？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which teaching points should the nurse include for safe newborn sleep?","penultimateSentenceZh":"关于新生儿安全睡眠，护士应包括哪些教育要点？","responseContext":{"type":"select_all","options":[{"id":"A","en":"Place the newborn on the back for sleep.","zh":"让新生儿仰卧睡觉。"},{"id":"C","en":"Keep pillows and loose blankets out of the crib.","zh":"婴儿床内不要放枕头和松散毯子。"},{"id":"B","en":"Use a firm sleep surface.","zh":"使用坚实的睡眠表面。"},{"id":"D","en":"Place the newborn prone after each feeding for sleep.","zh":"每次喂奶后让新生儿俯卧睡觉。"},{"id":"E","en":"Share a bed with the newborn to monitor breathing closely.","zh":"与新生儿同床睡以便密切观察呼吸。"}],"correct":["A","B","C"]},"rationaleCorrectEn":"Safe sleep includes supine positioning, a firm surface, and no loose bedding or soft objects in the crib.","rationaleCorrectZh":"安全睡眠包括仰卧、使用坚实表面，并避免婴儿床内有松散床品或软物。","testTakingStrategyEn":"For infant safety, choose actions that protect the airway and reduce suffocation risk.","testTakingStrategyZh":"婴儿安全题应选择保护气道并降低窒息风险的措施。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1159,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"mc_colonoscopy_screening_009","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.8","itemType":"multiple_choice","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.8.stem.en","stemPathZh":"questions.8.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[88,136],"terminalOffsetsZh":[26,36],"fullStemEn":"A 52-year-old client with no colorectal cancer screening history asks about prevention. Which recommendation should the nurse reinforce?","fullStemZh":"一位52岁、从未做过结直肠癌筛查的患者询问预防措施。护士应强化哪项建议？","terminalSentenceEn":"Which recommendation should the nurse reinforce?","terminalSentenceZh":"护士应强化哪项建议？","penultimateSentenceEn":"A 52-year-old client with no colorectal cancer screening history asks about prevention.","penultimateSentenceZh":"一位52岁、从未做过结直肠癌筛查的患者询问预防措施。","responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Use a home pregnancy test before screening.","zh":"筛查前使用家庭妊娠试验。"},{"id":"D","en":"Discuss colorectal cancer screening options with the health care provider.","zh":"与医疗提供者讨论结直肠癌筛查选择。"},{"id":"B","en":"Delay screening until abdominal pain occurs.","zh":"等出现腹痛后再进行筛查。"},{"id":"C","en":"Screening is unnecessary without a family history.","zh":"没有家族史就不需要筛查。"}],"correct":["D"]},"rationaleCorrectEn":"Adults in this age group should discuss recommended colorectal cancer screening options even without symptoms or family history.","rationaleCorrectZh":"此年龄段成人即使没有症状或家族史，也应讨论推荐的结直肠癌筛查选择。","testTakingStrategyEn":"Screening questions are about early detection in people who may feel well.","testTakingStrategyZh":"筛查题关注的是在感觉健康的人群中早期发现问题。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1160,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"mc_suicide_precautions_010","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.9","itemType":"multiple_choice","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.9.stem.en","stemPathZh":"questions.9.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[66,103],"terminalOffsetsZh":[20,31],"fullStemEn":"A client tells the nurse, \"I have a plan to kill myself tonight.\" Which action is the nurse's priority?","fullStemZh":"一位患者告诉护士：“我今晚有自杀计划。”护士的优先行动是什么？","terminalSentenceEn":"Which action is the nurse's priority?","terminalSentenceZh":"护士的优先行动是什么？","penultimateSentenceEn":"A client tells the nurse, \"I have a plan to kill myself tonight.\"","penultimateSentenceZh":"一位患者告诉护士：“我今晚有自杀计划。”","responseContext":{"type":"multiple_choice","options":[{"id":"C","en":"Tell the client to focus on positive thoughts.","zh":"告诉患者专注于积极想法。"},{"id":"B","en":"Schedule a counseling appointment for next week.","zh":"安排下周的心理咨询预约。"},{"id":"D","en":"Stay with the client and initiate suicide precautions.","zh":"留在患者身边并启动自杀预防措施。"},{"id":"A","en":"Ask the client to promise not to self-harm.","zh":"要求患者承诺不会自伤。"}],"correct":["D"]},"rationaleCorrectEn":"A specific suicide plan is an immediate safety risk. The nurse should maintain safety, stay with the client, and activate precautions.","rationaleCorrectZh":"具体自杀计划代表立即安全风险。护士应确保安全，留在患者身边，并启动预防措施。","testTakingStrategyEn":"When there is a stated plan and timing, choose immediate safety and direct supervision.","testTakingStrategyZh":"当患者说出具体计划和时间时，应选择立即安全措施和直接监督。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1161,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"sata_therapeutic_communication_anxiety_011","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.10","itemType":"select_all","category":"Psychosocial Integrity","topic":"Therapeutic Communication","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.10.stem.en","stemPathZh":"questions.10.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[99,121],"terminalOffsetsZh":[32,40],"fullStemEn":"A client awaiting a biopsy says, \"I am terrified this is cancer.\" Which responses are therapeutic? Select all that apply.","fullStemZh":"一位等待活检的患者说：“我很害怕这是癌症。”哪些回应具有治疗性？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which responses are therapeutic?","penultimateSentenceZh":"哪些回应具有治疗性？","responseContext":{"type":"select_all","options":[{"id":"C","en":"\"Waiting for results can feel frightening. I can sit with you for a few minutes.\"","zh":"“等待结果可能让人害怕。我可以陪你坐几分钟。”"},{"id":"B","en":"\"You should not worry until the results come back.\"","zh":"“结果出来前你不应该担心。”"},{"id":"A","en":"\"Tell me what worries you most right now.\"","zh":"“告诉我你现在最担心什么。”"},{"id":"D","en":"\"My aunt had cancer and did fine, so you will too.\"","zh":"“我阿姨得过癌症也没事，所以你也会没事。”"},{"id":"E","en":"\"What have you been told about the biopsy so far?\"","zh":"“到目前为止，关于活检你听到了哪些说明？”"}],"correct":["A","C","E"]},"rationaleCorrectEn":"Therapeutic responses invite expression, acknowledge feelings, offer presence, and assess understanding.","rationaleCorrectZh":"治疗性沟通会鼓励表达、承认感受、提供陪伴并评估理解。","testTakingStrategyEn":"Choose responses that explore feelings and avoid false reassurance or advice-giving.","testTakingStrategyZh":"选择探索感受的回应，避免虚假保证或直接给建议。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1162,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"mc_alcohol_withdrawal_cues_012","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.11","itemType":"multiple_choice","category":"Psychosocial Integrity","topic":"Substance Use & Withdrawal","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.11.stem.en","stemPathZh":"questions.11.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[64,120],"terminalOffsetsZh":[21,35],"fullStemEn":"A client admitted 12 hours ago reports heavy daily alcohol use. Which finding is most concerning for alcohol withdrawal?","fullStemZh":"一位12小时前入院的患者报告长期大量饮酒。哪项发现最令人担心酒精戒断？","terminalSentenceEn":"Which finding is most concerning for alcohol withdrawal?","terminalSentenceZh":"哪项发现最令人担心酒精戒断？","penultimateSentenceEn":"A client admitted 12 hours ago reports heavy daily alcohol use.","penultimateSentenceZh":"一位12小时前入院的患者报告长期大量饮酒。","responseContext":{"type":"multiple_choice","options":[{"id":"C","en":"Reports sleeping well overnight.","zh":"报告夜间睡眠良好。"},{"id":"A","en":"Dry skin and slow pulse.","zh":"皮肤干燥和脉搏缓慢。"},{"id":"B","en":"Tremors, sweating, and increasing heart rate.","zh":"震颤、出汗和心率升高。"},{"id":"D","en":"Mild hunger before dinner.","zh":"晚餐前轻度饥饿。"}],"correct":["B"]},"rationaleCorrectEn":"Autonomic hyperactivity such as tremors, diaphoresis, tachycardia, and agitation can signal alcohol withdrawal and risk for seizures or delirium tremens.","rationaleCorrectZh":"震颤、出汗、心动过速和激越等自主神经过度活动可提示酒精戒断，并有癫痫或震颤谵妄风险。","testTakingStrategyEn":"Look for clusters of cues; withdrawal often presents with sympathetic overactivity.","testTakingStrategyZh":"注意成组线索；戒断常表现为交感神经过度活跃。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1163,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"mc_dysphagia_positioning_013","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.12","itemType":"multiple_choice","category":"Basic Care and Comfort","topic":"Elimination & Comfort","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.12.stem.en","stemPathZh":"questions.12.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[61,102],"terminalOffsetsZh":[16,28],"fullStemEn":"A client who had a stroke coughs when drinking thin liquids. Which action should the nurse take first?","fullStemZh":"一位中风患者饮用稀薄液体时咳嗽。护士首先应采取哪项行动？","terminalSentenceEn":"Which action should the nurse take first?","terminalSentenceZh":"护士首先应采取哪项行动？","penultimateSentenceEn":"A client who had a stroke coughs when drinking thin liquids.","penultimateSentenceZh":"一位中风患者饮用稀薄液体时咳嗽。","responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Place the client flat after drinking.","zh":"饮水后让患者平躺。"},{"id":"C","en":"Encourage the client to drink faster to finish before coughing.","zh":"鼓励患者喝快一点，以便在咳嗽前喝完。"},{"id":"D","en":"Stop oral intake and notify the provider or speech therapist for swallowing evaluation.","zh":"停止经口进食并通知医疗提供者或言语治疗师进行吞咽评估。"},{"id":"B","en":"Offer a straw with each meal.","zh":"每餐提供吸管。"}],"correct":["D"]},"rationaleCorrectEn":"Coughing with thin liquids suggests aspiration risk. The nurse should stop oral intake until swallowing safety is evaluated.","rationaleCorrectZh":"饮用稀薄液体时咳嗽提示误吸风险。护士应停止经口进食，直到评估吞咽安全。","testTakingStrategyEn":"When swallowing is unsafe, protect the airway before offering more food or fluids.","testTakingStrategyZh":"吞咽不安全时，应先保护气道，再考虑继续进食或饮水。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1164,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"sata_pressure_injury_prevention_014","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.13","itemType":"select_all","category":"Basic Care and Comfort","topic":"Elimination & Comfort","difficulty":"easy","ngnSkill":"generate_solutions","stemPathEn":"questions.13.stem.en","stemPathZh":"questions.13.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[76,98],"terminalOffsetsZh":[23,31],"fullStemEn":"Which nursing actions help prevent pressure injuries in an immobile client? Select all that apply.","fullStemZh":"哪些护理措施有助于预防卧床患者发生压力性损伤？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which nursing actions help prevent pressure injuries in an immobile client?","penultimateSentenceZh":"哪些护理措施有助于预防卧床患者发生压力性损伤？","responseContext":{"type":"select_all","options":[{"id":"A","en":"Reposition the client on a regular schedule.","zh":"按固定时间为患者翻身。"},{"id":"D","en":"Use pressure-reducing surfaces as indicated.","zh":"按需使用减压表面。"},{"id":"C","en":"Massage reddened bony prominences vigorously.","zh":"用力按摩发红的骨隆突部位。"},{"id":"B","en":"Keep skin clean and dry.","zh":"保持皮肤清洁干燥。"},{"id":"E","en":"Assess nutrition and hydration status.","zh":"评估营养和水分状态。"}],"correct":["A","B","D","E"]},"rationaleCorrectEn":"Turning, moisture control, pressure reduction, and nutrition support reduce pressure injury risk.","rationaleCorrectZh":"翻身、控制潮湿、减压和营养支持可降低压力性损伤风险。","testTakingStrategyEn":"Prevent skin breakdown by reducing pressure, moisture, friction, and poor tissue repair.","testTakingStrategyZh":"通过减少压力、潮湿、摩擦和组织修复不良来预防皮肤破损。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1165,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"mc_constipation_postop_ambulation_015","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.14","itemType":"multiple_choice","category":"Basic Care and Comfort","topic":"Elimination & Comfort","difficulty":"easy","ngnSkill":"generate_solutions","stemPathEn":"questions.14.stem.en","stemPathZh":"questions.14.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[75,144],"terminalOffsetsZh":[20,36],"fullStemEn":"A postoperative client taking opioid pain medication reports constipation. Which intervention should the nurse encourage if not contraindicated?","fullStemZh":"一位术后使用阿片类止痛药的患者报告便秘。如果无禁忌，护士应鼓励哪项措施？","terminalSentenceEn":"Which intervention should the nurse encourage if not contraindicated?","terminalSentenceZh":"如果无禁忌，护士应鼓励哪项措施？","penultimateSentenceEn":"A postoperative client taking opioid pain medication reports constipation.","penultimateSentenceZh":"一位术后使用阿片类止痛药的患者报告便秘。","responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Ignore the problem because opioids always cause constipation.","zh":"忽略这个问题，因为阿片类药物总会导致便秘。"},{"id":"B","en":"Increase ambulation and fluid intake.","zh":"增加下床活动和液体摄入。"},{"id":"D","en":"Avoid all fiber-containing foods.","zh":"避免所有含纤维食物。"},{"id":"C","en":"Remain on bed rest until bowel function returns.","zh":"卧床休息直到肠功能恢复。"}],"correct":["B"]},"rationaleCorrectEn":"Activity, fluids, and appropriate fiber support bowel motility and help counter opioid-induced constipation.","rationaleCorrectZh":"活动、液体和适当纤维可促进肠蠕动，有助于缓解阿片类药物引起的便秘。","testTakingStrategyEn":"For comfort problems, choose safe nonpharmacologic measures unless the stem gives a contraindication.","testTakingStrategyZh":"舒适护理题若题干无禁忌，应选择安全的非药物措施。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1166,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"mc_digoxin_apical_pulse_016","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.15","itemType":"multiple_choice","category":"Pharmacological and Parenteral Therapies","topic":"Medication Safety & Admin","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.15.stem.en","stemPathZh":"questions.15.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[87,112],"terminalOffsetsZh":[26,33],"fullStemEn":"Before giving digoxin to an adult client, the nurse obtains an apical pulse of 52/min. What should the nurse do?","fullStemZh":"给成人患者使用地高辛前，护士测得心尖脉搏52次/分。护士应怎么做？","terminalSentenceEn":"What should the nurse do?","terminalSentenceZh":"护士应怎么做？","penultimateSentenceEn":"Before giving digoxin to an adult client, the nurse obtains an apical pulse of 52/min.","penultimateSentenceZh":"给成人患者使用地高辛前，护士测得心尖脉搏52次/分。","responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Give the medication as prescribed.","zh":"按医嘱给药。"},{"id":"B","en":"Give twice the dose at the next scheduled time.","zh":"下次给药时给予双倍剂量。"},{"id":"D","en":"Hold the medication and notify the health care provider.","zh":"暂停给药并通知医疗提供者。"},{"id":"C","en":"Check the radial pulse for 15 seconds and administer if regular.","zh":"测量桡动脉脉搏15秒，如规则则给药。"}],"correct":["D"]},"rationaleCorrectEn":"Digoxin can worsen bradycardia. An adult apical pulse below typical hold parameters should prompt holding the dose and notifying the provider.","rationaleCorrectZh":"地高辛可加重心动过缓。成人心尖脉搏低于常用停药参数时，应暂停给药并通知医疗提供者。","testTakingStrategyEn":"For cardiac medications, check the relevant vital sign and hold when safety parameters are not met.","testTakingStrategyZh":"心脏药物给药前应检查相关生命体征，未达到安全参数时暂停给药。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1167,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"sata_hypoglycemia_actions_017","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.16","itemType":"select_all","category":"Pharmacological and Parenteral Therapies","topic":"Medication Safety & Admin","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.16.stem.en","stemPathZh":"questions.16.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[125,147],"terminalOffsetsZh":[40,48],"fullStemEn":"A conscious client with diabetes is shaky, sweaty, and has a blood glucose of 54 mg/dL. Which actions should the nurse take? Select all that apply.","fullStemZh":"一位清醒的糖尿病患者出现发抖、出汗，血糖为54 mg/dL。护士应采取哪些措施？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which actions should the nurse take?","penultimateSentenceZh":"护士应采取哪些措施？","responseContext":{"type":"select_all","options":[{"id":"D","en":"Once improved, provide a snack or meal if the next meal is not soon.","zh":"症状改善后，如下一餐还早，提供点心或正餐。"},{"id":"A","en":"Give 15 grams of fast-acting carbohydrate.","zh":"给予15克快速起效碳水化合物。"},{"id":"B","en":"Recheck blood glucose after about 15 minutes.","zh":"约15分钟后复测血糖。"},{"id":"C","en":"Administer the scheduled rapid-acting insulin immediately.","zh":"立即给予计划中的速效胰岛素。"},{"id":"E","en":"Leave the client alone to rest quietly.","zh":"让患者独自安静休息。"}],"correct":["A","B","D"]},"rationaleCorrectEn":"For a conscious client with hypoglycemia, give rapid carbohydrate, reassess, and follow with longer-acting carbohydrate/protein when appropriate.","rationaleCorrectZh":"对于清醒的低血糖患者，应给予快速碳水、复测，并在适当时补充较持久的碳水/蛋白质。","testTakingStrategyEn":"Treat low glucose first, then reassess; do not give more insulin to a hypoglycemic client.","testTakingStrategyZh":"先处理低血糖，再复测；不要给低血糖患者追加胰岛素。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1168,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"mc_warfarin_bleeding_teaching_018","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.17","itemType":"multiple_choice","category":"Pharmacological and Parenteral Therapies","topic":"Anticoagulant Therapy","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.17.stem.en","stemPathZh":"questions.17.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,76],"terminalOffsetsZh":[0,21],"fullStemEn":"Which client statement indicates correct understanding of warfarin teaching?","fullStemZh":"哪位患者的陈述表明正确理解华法林用药教育？","terminalSentenceEn":"Which client statement indicates correct understanding of warfarin teaching?","terminalSentenceZh":"哪位患者的陈述表明正确理解华法林用药教育？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"D","en":"\"I will use an electric razor and report unusual bleeding.\"","zh":"“我会使用电动剃须刀，并报告异常出血。”"},{"id":"B","en":"\"I can start any herbal supplement without checking first.\"","zh":"“我可以不先询问就开始服用任何草药补充剂。”"},{"id":"A","en":"\"I should double the dose if I miss one tablet.\"","zh":"“如果漏服一片，我应该加倍剂量。”"},{"id":"C","en":"\"Green vegetables must be completely avoided.\"","zh":"“必须完全避免绿色蔬菜。”"}],"correct":["D"]},"rationaleCorrectEn":"Warfarin increases bleeding risk. Clients should use bleeding precautions and report bleeding; vitamin K intake should be consistent, not necessarily eliminated.","rationaleCorrectZh":"华法林会增加出血风险。患者应采取出血预防措施并报告出血；维生素K摄入应保持稳定，而非一定完全避免。","testTakingStrategyEn":"For anticoagulants, think bleeding precautions, interaction checks, and consistent diet patterns.","testTakingStrategyZh":"抗凝药题应想到出血预防、相互作用检查和饮食稳定。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1169,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"mc_transfusion_reaction_first_019","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.18","itemType":"multiple_choice","category":"Reduction of Risk Potential","topic":"Procedural Complications & Dialysis","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.18.stem.en","stemPathZh":"questions.18.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[115,146],"terminalOffsetsZh":[26,35],"fullStemEn":"Fifteen minutes after a blood transfusion begins, the client develops chills, flank pain, and shortness of breath. What should the nurse do first?","fullStemZh":"输血开始15分钟后，患者出现寒战、腰背痛和呼吸急促。护士首先应做什么？","terminalSentenceEn":"What should the nurse do first?","terminalSentenceZh":"护士首先应做什么？","penultimateSentenceEn":"Fifteen minutes after a blood transfusion begins, the client develops chills, flank pain, and shortness of breath.","penultimateSentenceZh":"输血开始15分钟后，患者出现寒战、腰背痛和呼吸急促。","responseContext":{"type":"multiple_choice","options":[{"id":"D","en":"Stop the transfusion.","zh":"停止输血。"},{"id":"A","en":"Slow the transfusion rate.","zh":"减慢输血速度。"},{"id":"C","en":"Flush the blood tubing with dextrose solution.","zh":"用葡萄糖溶液冲洗输血管路。"},{"id":"B","en":"Give acetaminophen and continue monitoring.","zh":"给予对乙酰氨基酚并继续观察。"}],"correct":["D"]},"rationaleCorrectEn":"These findings suggest an acute transfusion reaction. The first action is to stop the transfusion to prevent more incompatible blood from entering.","rationaleCorrectZh":"这些表现提示急性输血反应。首要行动是停止输血，防止更多不相容血液进入体内。","testTakingStrategyEn":"When a therapy is causing harm, stop the therapy first.","testTakingStrategyZh":"当治疗本身造成伤害时，应首先停止该治疗。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1170,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"sata_postop_hemorrhage_cues_020","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.19","itemType":"select_all","category":"Reduction of Risk Potential","topic":"Perioperative Care","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.19.stem.en","stemPathZh":"questions.19.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[58,80],"terminalOffsetsZh":[13,21],"fullStemEn":"Which postoperative findings suggest possible hemorrhage? Select all that apply.","fullStemZh":"哪些术后发现提示可能出血？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which postoperative findings suggest possible hemorrhage?","penultimateSentenceZh":"哪些术后发现提示可能出血？","responseContext":{"type":"select_all","options":[{"id":"A","en":"Increasing heart rate.","zh":"心率逐渐升高。"},{"id":"D","en":"Warm, dry skin with stable vital signs.","zh":"皮肤温暖干燥且生命体征稳定。"},{"id":"E","en":"Restlessness and anxiety.","zh":"烦躁不安和焦虑。"},{"id":"C","en":"Urine output less than 30 mL/hr.","zh":"尿量少于30 mL/小时。"},{"id":"B","en":"Blood pressure trending downward.","zh":"血压呈下降趋势。"}],"correct":["A","B","C","E"]},"rationaleCorrectEn":"Tachycardia, falling blood pressure, low urine output, and restlessness can be early or worsening signs of blood loss and shock.","rationaleCorrectZh":"心动过速、血压下降、尿量减少和烦躁不安可能是失血和休克的早期或加重迹象。","testTakingStrategyEn":"Trend vital signs and perfusion markers; early shock may look like anxiety and tachycardia before severe hypotension.","testTakingStrategyZh":"关注生命体征和灌注指标趋势；早期休克在严重低血压前可能表现为焦虑和心动过速。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"Which postoperative findings suggest possible hemorrhage?","controlSentenceZh":"哪些术后发现提示可能出血？"}
{"queueIndex":1171,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"mc_potassium_preop_notify_021","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.20","itemType":"multiple_choice","category":"Reduction of Risk Potential","topic":"Maternal-Newborn Care & Teaching","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.20.stem.en","stemPathZh":"questions.20.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[51,122],"terminalOffsetsZh":[12,26],"fullStemEn":"The nurse reviews preoperative laboratory results. Which result should the nurse report before the client goes to surgery?","fullStemZh":"护士查看术前实验室结果。哪项结果应在患者手术前报告？","terminalSentenceEn":"Which result should the nurse report before the client goes to surgery?","terminalSentenceZh":"哪项结果应在患者手术前报告？","penultimateSentenceEn":"The nurse reviews preoperative laboratory results.","penultimateSentenceZh":"护士查看术前实验室结果。","responseContext":{"type":"multiple_choice","options":[{"id":"B","en":"Sodium 139 mEq/L.","zh":"钠 139 mEq/L。"},{"id":"D","en":"Potassium 2.9 mEq/L.","zh":"钾 2.9 mEq/L。"},{"id":"C","en":"Hemoglobin 14 g/dL.","zh":"血红蛋白 14 g/dL。"},{"id":"A","en":"Platelets 250 ×10³/µL.","zh":"血小板 250 ×10³/µL。"}],"correct":["D"]},"rationaleCorrectEn":"A potassium of 2.9 mEq/L is low and increases risk for dysrhythmias, especially with anesthesia and surgery.","rationaleCorrectZh":"钾2.9 mEq/L偏低，会增加心律失常风险，尤其在麻醉和手术期间。","testTakingStrategyEn":"Preoperative electrolyte abnormalities matter because anesthesia can magnify cardiac risk.","testTakingStrategyZh":"术前电解质异常很重要，因为麻醉会放大心脏风险。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1172,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"mc_heart_failure_fluid_overload_022","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.21","itemType":"multiple_choice","category":"Physiological Adaptation","topic":"Cardiovascular Disorders","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.21.stem.en","stemPathZh":"questions.21.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[101,130],"terminalOffsetsZh":[34,44],"fullStemEn":"A client with heart failure has new crackles, shortness of breath, and a 2 kg weight gain in 2 days. Which problem is most likely?","fullStemZh":"一位心力衰竭患者出现新的湿啰音、呼吸急促，并在2天内体重增加2公斤。最可能的问题是什么？","terminalSentenceEn":"Which problem is most likely?","terminalSentenceZh":"最可能的问题是什么？","penultimateSentenceEn":"A client with heart failure has new crackles, shortness of breath, and a 2 kg weight gain in 2 days.","penultimateSentenceZh":"一位心力衰竭患者出现新的湿啰音、呼吸急促，并在2天内体重增加2公斤。","responseContext":{"type":"multiple_choice","options":[{"id":"B","en":"Fluid volume excess.","zh":"体液容量过多。"},{"id":"D","en":"Hypovolemia.","zh":"低血容量。"},{"id":"C","en":"Improved cardiac output.","zh":"心输出量改善。"},{"id":"A","en":"Resolved pulmonary congestion.","zh":"肺淤血已缓解。"}],"correct":["B"]},"rationaleCorrectEn":"Rapid weight gain, crackles, and dyspnea indicate fluid retention and pulmonary congestion in heart failure.","rationaleCorrectZh":"快速体重增加、湿啰音和呼吸困难提示心衰中的液体潴留和肺淤血。","testTakingStrategyEn":"In heart failure, daily weight is a sensitive cue for fluid changes.","testTakingStrategyZh":"在心衰中，每日体重是反映液体变化的敏感线索。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1173,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"sata_copd_exacerbation_interventions_023","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.22","itemType":"select_all","category":"Physiological Adaptation","topic":"Respiratory & Infectious Disorders","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.22.stem.en","stemPathZh":"questions.22.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[106,128],"terminalOffsetsZh":[30,38],"fullStemEn":"A client with COPD is short of breath and using accessory muscles. Which nursing actions are appropriate? Select all that apply.","fullStemZh":"一位COPD患者呼吸急促并使用辅助呼吸肌。哪些护理措施合适？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which nursing actions are appropriate?","penultimateSentenceZh":"哪些护理措施合适？","responseContext":{"type":"select_all","options":[{"id":"D","en":"Have the client lie flat to rest respiratory muscles.","zh":"让患者平躺以休息呼吸肌。"},{"id":"C","en":"Apply oxygen as prescribed and monitor response.","zh":"按医嘱给氧并监测反应。"},{"id":"A","en":"Place the client in high-Fowler position.","zh":"让患者采取高半坐卧位。"},{"id":"B","en":"Encourage pursed-lip breathing.","zh":"鼓励缩唇呼吸。"},{"id":"E","en":"Cluster all morning care immediately without rest periods.","zh":"立即集中完成所有晨间护理且不安排休息。"}],"correct":["A","B","C"]},"rationaleCorrectEn":"Upright positioning, pursed-lip breathing, and prescribed oxygen support ventilation and reduce work of breathing.","rationaleCorrectZh":"直立体位、缩唇呼吸和按医嘱给氧可支持通气并减少呼吸做功。","testTakingStrategyEn":"For respiratory distress, choose positioning and breathing techniques that reduce work of breathing.","testTakingStrategyZh":"呼吸困难题应选择能减少呼吸做功的体位和呼吸技巧。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"Which nursing actions are appropriate?","controlSentenceZh":"哪些护理措施合适？"}
{"queueIndex":1174,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"mc_dka_priority_fluid_024","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.23","itemType":"multiple_choice","category":"Physiological Adaptation","topic":"Diabetic Ketoacidosis (DKA)","difficulty":"hard","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.23.stem.en","stemPathZh":"questions.23.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[132,209],"terminalOffsetsZh":[41,58],"fullStemEn":"A client with diabetic ketoacidosis is confused, has dry mucous membranes, blood glucose of 520 mg/dL, and deep rapid respirations. Which provider prescription should the nurse anticipate as an early priority?","fullStemZh":"一位糖尿病酮症酸中毒患者意识混乱、黏膜干燥、血糖520 mg/dL，并有深快呼吸。护士应预期哪项医嘱是早期优先事项？","terminalSentenceEn":"Which provider prescription should the nurse anticipate as an early priority?","terminalSentenceZh":"护士应预期哪项医嘱是早期优先事项？","penultimateSentenceEn":"A client with diabetic ketoacidosis is confused, has dry mucous membranes, blood glucose of 520 mg/dL, and deep rapid respirations.","penultimateSentenceZh":"一位糖尿病酮症酸中毒患者意识混乱、黏膜干燥、血糖520 mg/dL，并有深快呼吸。","responseContext":{"type":"multiple_choice","options":[{"id":"C","en":"Begin isotonic IV fluid replacement.","zh":"开始等渗静脉补液。"},{"id":"B","en":"Administer long-acting insulin only and discharge.","zh":"只给予长效胰岛素并出院。"},{"id":"D","en":"Give a bedtime snack.","zh":"给予睡前点心。"},{"id":"A","en":"Restrict fluids until glucose is normal.","zh":"限制液体直到血糖正常。"}],"correct":["C"]},"rationaleCorrectEn":"DKA causes severe dehydration from osmotic diuresis. Early treatment includes isotonic fluids, followed by insulin and electrolyte management per protocol.","rationaleCorrectZh":"DKA因渗透性利尿导致严重脱水。早期治疗包括等渗补液，随后按方案使用胰岛素并管理电解质。","testTakingStrategyEn":"In DKA, think dehydration, acidosis, insulin deficit, and potassium risk; early fluids protect circulation.","testTakingStrategyZh":"遇到DKA要想到脱水、酸中毒、胰岛素不足和钾风险；早期补液保护循环。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1175,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"sata_stroke_warning_signs_025","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.24","itemType":"select_all","category":"Physiological Adaptation","topic":"Cardiovascular Disorders","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.24.stem.en","stemPathZh":"questions.24.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[55,77],"terminalOffsetsZh":[15,23],"fullStemEn":"Which findings are warning signs of a possible stroke? Select all that apply.","fullStemZh":"哪些发现是可能中风的警示信号？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which findings are warning signs of a possible stroke?","penultimateSentenceZh":"哪些发现是可能中风的警示信号？","responseContext":{"type":"select_all","options":[{"id":"D","en":"Gradual hair thinning over several years.","zh":"多年逐渐头发变稀。"},{"id":"B","en":"Sudden difficulty speaking or understanding speech.","zh":"突然说话困难或理解语言困难。"},{"id":"A","en":"Sudden facial drooping on one side.","zh":"一侧面部突然下垂。"},{"id":"E","en":"Sudden severe headache with no known cause.","zh":"无已知原因的突发剧烈头痛。"},{"id":"C","en":"Sudden weakness of one arm.","zh":"一侧手臂突然无力。"}],"correct":["A","B","C","E"]},"rationaleCorrectEn":"Sudden unilateral facial droop, speech difficulty, arm weakness, and severe unexplained headache are concerning stroke warning signs.","rationaleCorrectZh":"突发单侧面瘫、语言困难、手臂无力和无明显原因的剧烈头痛都是中风警示信号。","testTakingStrategyEn":"Stroke cues are usually sudden and neurologic; time-sensitive recognition matters.","testTakingStrategyZh":"中风线索通常是突发的神经系统表现；及时识别非常重要。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1176,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"or_hypoglycemia_actions_026","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.25","itemType":"ordered_response","category":"Pharmacological and Parenteral Therapies","topic":"Medication Safety & Admin","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.25.stem.en","stemPathZh":"questions.25.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[82,129],"terminalOffsetsZh":[24,38],"fullStemEn":"A conscious client with diabetes is shaky, diaphoretic, and reports feeling weak. Place the nurse's actions in the correct order.","fullStemZh":"一位清醒的糖尿病患者发抖、出汗，并表示感觉虚弱。请将护士行动按正确顺序排列。","terminalSentenceEn":"Place the nurse's actions in the correct order.","terminalSentenceZh":"请将护士行动按正确顺序排列。","penultimateSentenceEn":"A conscious client with diabetes is shaky, diaphoretic, and reports feeling weak.","penultimateSentenceZh":"一位清醒的糖尿病患者发抖、出汗，并表示感觉虚弱。","responseContext":{"type":"ordered_response","options":[{"id":"E","en":"Provide a snack or meal when glucose improves.","zh":"血糖改善后提供点心或正餐。"},{"id":"A","en":"Notify the provider if symptoms or low glucose persist.","zh":"如果症状或低血糖持续存在，通知医护提供者。"},{"id":"C","en":"Give 15 g of a fast-acting carbohydrate.","zh":"给予15克速效碳水化合物。"},{"id":"D","en":"Recheck the blood glucose in 15 minutes.","zh":"15分钟后复查血糖。"},{"id":"B","en":"Check the capillary blood glucose level.","zh":"检测指尖血糖。"}],"correct":["B","C","D","E","A"]},"rationaleCorrectEn":"For suspected hypoglycemia in a conscious client, confirm the glucose, give 15 g fast carbohydrate, recheck in 15 minutes, follow with longer-acting food when improved, and escalate if it does not resolve.","rationaleCorrectZh":"对清醒患者疑似低血糖时，应先确认血糖，给予15克速效碳水，15分钟后复查，改善后补充较持久的食物；若未缓解则升级处理。","testTakingStrategyEn":"For ordered response, stabilize immediate risk first, then reassess, then prevent recurrence and escalate if needed.","testTakingStrategyZh":"排序题先处理即时风险，再重新评估，然后预防复发，必要时升级处理。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1177,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"fib_acetaminophen_tablets_027","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.26","itemType":"fill_in_blank","category":"Pharmacological and Parenteral Therapies","topic":"Dosage Calculations","difficulty":"easy","ngnSkill":"take_action","stemPathEn":"questions.26.stem.en","stemPathZh":"questions.26.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[113,158],"terminalOffsetsZh":[42,51],"fullStemEn":"The provider prescribes acetaminophen 650 mg by mouth. The medication available is acetaminophen 325 mg tablets. How many tablets should the nurse administer?","fullStemZh":"医护提供者开具对乙酰氨基酚650 mg口服。现有药物为对乙酰氨基酚325 mg片剂。护士应给予多少片？","terminalSentenceEn":"How many tablets should the nurse administer?","terminalSentenceZh":"护士应给予多少片？","penultimateSentenceEn":"The medication available is acetaminophen 325 mg tablets.","penultimateSentenceZh":"现有药物为对乙酰氨基酚325 mg片剂。","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"Enter the number of tablets.","zh":"输入片数。"},"acceptable":["2","2 tablets"],"numeric":{"value":2,"tolerance":0,"unit":"tablets"}}]},"rationaleCorrectEn":"Divide the prescribed dose by the dose available: 650 mg / 325 mg per tablet = 2 tablets.","rationaleCorrectZh":"用医嘱剂量除以每片剂量：650 mg / 每片325 mg = 2片。","testTakingStrategyEn":"Use ordered dose divided by available dose, then check that the result is clinically reasonable.","testTakingStrategyZh":"使用医嘱剂量除以现有剂量，然后确认结果在临床上合理。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1178,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"matrix_postop_findings_028","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.27","itemType":"matrix","category":"Reduction of Risk Potential","topic":"Perioperative Care","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.27.stem.en","stemPathZh":"questions.27.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,90],"terminalOffsetsZh":[0,27],"fullStemEn":"For each postoperative finding, select whether it is expected or requires nurse follow-up.","fullStemZh":"针对每项术后发现，选择其属于预期表现还是需要护士跟进。","terminalSentenceEn":"For each postoperative finding, select whether it is expected or requires nurse follow-up.","terminalSentenceZh":"针对每项术后发现，选择其属于预期表现还是需要护士跟进。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Incisional pain rated 4 out of 10 after coughing.","zh":"咳嗽后切口疼痛评分4/10。"},{"id":"r2","en":"Urine output of 20 mL/hr for the past 2 hours.","zh":"过去2小时尿量为20 mL/小时。"},{"id":"r3","en":"Serosanguineous drainage on the first dressing.","zh":"首次敷料上有浆液血性渗出。"},{"id":"r4","en":"New calf pain with unilateral leg swelling.","zh":"新出现小腿疼痛并伴单侧腿部肿胀。"}],"columns":[{"id":"c1","en":"Expected","zh":"预期表现"},{"id":"c2","en":"Requires follow-up","zh":"需要跟进"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c2"]}]},"rationaleCorrectEn":"Moderate incisional pain after coughing and small early serosanguineous drainage can be expected. Low urine output and unilateral calf pain with swelling require follow-up for perfusion or thromboembolism concerns.","rationaleCorrectZh":"咳嗽后中度切口痛和早期少量浆液血性渗出可属预期。尿量低以及单侧小腿疼痛伴肿胀需要跟进，考虑灌注不足或血栓栓塞风险。","testTakingStrategyEn":"Separate expected postoperative discomfort from findings suggesting impaired perfusion, bleeding, infection, or clotting.","testTakingStrategyZh":"区分预期术后不适与提示灌注受损、出血、感染或血栓的发现。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1179,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"cloze_hyperkalemia_ecg_029","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.28","itemType":"dropdown_cloze","category":"Physiological Adaptation","topic":"Cardiovascular Disorders","difficulty":"hard","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.28.stem.en","stemPathZh":"questions.28.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,72],"terminalOffsetsZh":[0,18],"fullStemEn":"Complete the clinical judgment statement for a client with hyperkalemia.","fullStemZh":"完成关于高钾血症患者的临床判断陈述。","terminalSentenceEn":"Complete the clinical judgment statement for a client with hyperkalemia.","terminalSentenceZh":"完成关于高钾血症患者的临床判断陈述。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"A client with chronic kidney disease has potassium 6.2 mEq/L and peaked T waves. The nurse should anticipate {{1}} and place the client on {{2}} because the priority risk is {{3}}.","zh":"一位慢性肾病患者钾为6.2 mEq/L并出现高尖T波。护士应预期{{1}}并将患者置于{{2}}，因为首要风险是{{3}}。"},"dropdowns":[{"id":"1","options":[{"id":"o3","en":"a high-potassium diet","zh":"高钾饮食"},{"id":"o1","en":"regular insulin with dextrose","zh":"普通胰岛素联合葡萄糖"},{"id":"o2","en":"oral potassium replacement","zh":"口服补钾"}],"correct":"o1"},{"id":"2","options":[{"id":"o3","en":"neutropenic precautions","zh":"中性粒细胞减少隔离"},{"id":"o2","en":"airborne isolation","zh":"空气隔离"},{"id":"o1","en":"cardiac monitoring","zh":"心电监护"}],"correct":"o1"},{"id":"3","options":[{"id":"o1","en":"life-threatening dysrhythmia","zh":"危及生命的心律失常"},{"id":"o3","en":"airway swelling","zh":"气道肿胀"},{"id":"o2","en":"fluid volume deficit","zh":"体液容量不足"}],"correct":"o1"}]},"rationaleCorrectEn":"Severe hyperkalemia with ECG changes is an emergency because potassium disturbances can trigger lethal dysrhythmias. Insulin with dextrose shifts potassium into cells, and cardiac monitoring tracks rhythm changes.","rationaleCorrectZh":"严重高钾血症伴心电图改变属于急症，因为钾异常可引发致命性心律失常。胰岛素联合葡萄糖可促使钾转入细胞，心电监护用于观察节律变化。","testTakingStrategyEn":"Link abnormal potassium plus ECG changes to cardiac rhythm risk and immediate potassium-shifting treatment.","testTakingStrategyZh":"将钾异常加心电图改变与心律风险和立即促钾转移治疗联系起来。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1180,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_mc_hallucinations_030","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.29","itemType":"multiple_choice","category":"Psychosocial Integrity","topic":"Mental Health Disorders","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.29.stem.en","stemPathZh":"questions.29.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[85,133],"terminalOffsetsZh":[27,39],"fullStemEn":"A client with schizophrenia tells the nurse, \"The voices are saying I am worthless.\" Which response by the nurse is most therapeutic?","fullStemZh":"一位精神分裂症患者告诉护士：“那些声音说我一文不值。”护士哪种回应最具治疗性？","terminalSentenceEn":"Which response by the nurse is most therapeutic?","terminalSentenceZh":"护士哪种回应最具治疗性？","penultimateSentenceEn":"A client with schizophrenia tells the nurse, \"The voices are saying I am worthless.\"","penultimateSentenceZh":"一位精神分裂症患者告诉护士：“那些声音说我一文不值。”","responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"You need to stop thinking about negative things.","zh":"你需要停止想负面的事情。"},{"id":"B","en":"The voices are not real, so you should ignore them.","zh":"这些声音不是真的，所以你应该忽略它们。"},{"id":"C","en":"I do not hear the voices, but I can see this is frightening for you.","zh":"我没有听到这些声音，但我看得出这让你很害怕。"},{"id":"D","en":"Tell me exactly what the voices sound like for the next hour.","zh":"接下来一小时请详细告诉我这些声音听起来是什么样。"}],"correct":["C"]},"rationaleCorrectEn":"The nurse acknowledges the client's experience and feelings without validating the hallucination as real. This supports reality orientation while maintaining trust.","rationaleCorrectZh":"护士承认患者的体验和感受，但不确认幻听是真实的。这既支持现实定向，又能维持信任关系。","testTakingStrategyEn":"With hallucinations, acknowledge feelings, present reality without arguing, assess safety, and redirect to coping.","testTakingStrategyZh":"遇到幻觉题，应承认感受、不争辩地呈现现实、评估安全，并引导应对方式。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1181,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_sata_preeclampsia_031","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.30","itemType":"select_all","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.30.stem.en","stemPathZh":"questions.30.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[134,156],"terminalOffsetsZh":[32,40],"fullStemEn":"A pregnant client at 32 weeks' gestation calls the clinic. Which findings should the nurse instruct the client to report immediately? Select all that apply.","fullStemZh":"一位妊娠32周的孕妇打电话到门诊。护士应指导她立即报告哪些发现？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which findings should the nurse instruct the client to report immediately?","penultimateSentenceZh":"护士应指导她立即报告哪些发现？","responseContext":{"type":"select_all","options":[{"id":"B","en":"Blurred vision or seeing spots.","zh":"视物模糊或眼前出现斑点。"},{"id":"F","en":"Occasional heartburn after a large meal.","zh":"大餐后偶尔胃灼热。"},{"id":"E","en":"Decreased fetal movement.","zh":"胎动减少。"},{"id":"C","en":"Mild ankle swelling at the end of the day.","zh":"一天结束时轻度踝部水肿。"},{"id":"A","en":"A severe headache that does not improve with rest.","zh":"休息后仍不缓解的剧烈头痛。"},{"id":"D","en":"Right upper quadrant abdominal pain.","zh":"右上腹疼痛。"}],"correct":["A","B","D","E"]},"rationaleCorrectEn":"Severe headache, visual changes, right upper quadrant pain, and decreased fetal movement are warning findings that require immediate evaluation in pregnancy.","rationaleCorrectZh":"剧烈头痛、视觉改变、右上腹痛和胎动减少都是妊娠期需要立即评估的警示表现。","testTakingStrategyEn":"In pregnancy, neurologic symptoms, severe abdominal pain, and decreased fetal movement are not routine discomforts.","testTakingStrategyZh":"妊娠题中，神经系统症状、严重腹痛和胎动减少不属于普通不适。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1182,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_or_seizure_safety_032","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.31","itemType":"ordered_response","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.31.stem.en","stemPathZh":"questions.31.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[72,119],"terminalOffsetsZh":[23,37],"fullStemEn":"A client begins having a generalized tonic-clonic seizure while in bed. Place the nurse's actions in the correct order.","fullStemZh":"一位卧床患者开始发生全身强直-阵挛性癫痫发作。请将护士行动按正确顺序排列。","terminalSentenceEn":"Place the nurse's actions in the correct order.","terminalSentenceZh":"请将护士行动按正确顺序排列。","penultimateSentenceEn":"A client begins having a generalized tonic-clonic seizure while in bed.","penultimateSentenceZh":"一位卧床患者开始发生全身强直-阵挛性癫痫发作。","responseContext":{"type":"ordered_response","options":[{"id":"A","en":"Turn the client onto the side if possible.","zh":"如果可能，将患者转为侧卧。"},{"id":"D","en":"Assess airway and level of consciousness after movements stop.","zh":"抽动停止后评估气道和意识水平。"},{"id":"B","en":"Protect the head and remove nearby hazards.","zh":"保护头部并移开周围危险物。"},{"id":"E","en":"Document the characteristics and duration of the seizure.","zh":"记录癫痫发作的特征和持续时间。"},{"id":"C","en":"Note the time the seizure begins.","zh":"记录癫痫发作开始时间。"}],"correct":["C","B","A","D","E"]},"rationaleCorrectEn":"The nurse first notes the start time, then protects the client from injury, positions for secretion drainage when possible, assesses airway and consciousness after the seizure, and documents findings.","rationaleCorrectZh":"护士首先记录开始时间，然后保护患者免受伤害，可能时采取有利于分泌物引流的体位，发作后评估气道和意识，最后记录发现。","testTakingStrategyEn":"During a seizure, do not restrain or place anything in the mouth; protect from injury, time the event, then reassess airway.","testTakingStrategyZh":"癫痫发作时不要约束患者或向口中放物；应防止受伤、计时，然后重新评估气道。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1183,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_fib_heparin_rate_033","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.32","itemType":"fill_in_blank","category":"Pharmacological and Parenteral Therapies","topic":"Dosage Calculations","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.32.stem.en","stemPathZh":"questions.32.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[130,187],"terminalOffsetsZh":[54,71],"fullStemEn":"The provider prescribes heparin 1,200 units/hr by continuous IV infusion. The IV bag contains heparin 25,000 units in 500 mL D5W. At how many mL/hr should the nurse set the infusion pump?","fullStemZh":"医护提供者开具肝素持续静脉输注1,200单位/小时。输液袋含肝素25,000单位，溶于500 mL D5W。护士应将输液泵设为多少mL/小时？","terminalSentenceEn":"At how many mL/hr should the nurse set the infusion pump?","terminalSentenceZh":"护士应将输液泵设为多少mL/小时？","penultimateSentenceEn":"The IV bag contains heparin 25,000 units in 500 mL D5W.","penultimateSentenceZh":"输液袋含肝素25,000单位，溶于500 mL D5W。","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"Enter mL/hr.","zh":"输入mL/小时。"},"acceptable":["24","24 mL/hr"],"numeric":{"value":24,"tolerance":0,"unit":"mL/hr"}}]},"rationaleCorrectEn":"The concentration is 25,000 units / 500 mL = 50 units/mL. The rate is 1,200 units/hr / 50 units/mL = 24 mL/hr.","rationaleCorrectZh":"浓度为25,000单位 / 500 mL = 50单位/mL。速度为1,200单位/小时 / 50单位/mL = 24 mL/小时。","testTakingStrategyEn":"For infusion calculations, find concentration first, then divide ordered dose per hour by dose per mL.","testTakingStrategyZh":"输注计算先求浓度，再用每小时医嘱剂量除以每毫升剂量。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1184,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_matrix_lithium_034","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.33","itemType":"matrix","category":"Pharmacological and Parenteral Therapies","topic":"Cardiovascular & Endocrine Medications","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.33.stem.en","stemPathZh":"questions.33.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,126],"terminalOffsetsZh":[0,37],"fullStemEn":"For each finding in a client taking lithium, select whether it is expected teaching reinforcement or requires nurse follow-up.","fullStemZh":"针对服用锂盐患者的每项发现，选择其属于预期的教育强化内容还是需要护士跟进。","terminalSentenceEn":"For each finding in a client taking lithium, select whether it is expected teaching reinforcement or requires nurse follow-up.","terminalSentenceZh":"针对服用锂盐患者的每项发现，选择其属于预期的教育强化内容还是需要护士跟进。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Fine hand tremor shortly after starting therapy.","zh":"开始治疗后不久出现细微手颤。"},{"id":"r2","en":"Vomiting, severe diarrhea, and ataxia.","zh":"呕吐、严重腹泻和共济失调。"},{"id":"r3","en":"Client says, \"I drink water regularly and keep my salt intake consistent.\"","zh":"患者说：“我规律喝水，并保持盐摄入稳定。”"},{"id":"r4","en":"Client started taking ibuprofen daily for back pain.","zh":"患者开始每天服用布洛芬治疗背痛。"}],"columns":[{"id":"c1","en":"Expected or reinforce teaching","zh":"预期或强化教育"},{"id":"c2","en":"Requires follow-up","zh":"需要跟进"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c2"]}]},"rationaleCorrectEn":"Fine tremor can occur early with lithium, and consistent fluid/sodium intake is appropriate teaching. Gastrointestinal symptoms with ataxia suggest toxicity, and daily NSAID use can increase lithium levels.","rationaleCorrectZh":"锂盐治疗早期可出现细微震颤，保持液体和钠摄入稳定是正确教育。胃肠道症状伴共济失调提示中毒，每日使用NSAID可升高锂水平。","testTakingStrategyEn":"For narrow-therapeutic-index drugs, connect dehydration, renal function, and interacting medications to toxicity.","testTakingStrategyZh":"对于治疗窗窄的药物，要把脱水、肾功能和相互作用药物与中毒风险联系起来。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1185,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_cloze_sepsis_035","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.34","itemType":"dropdown_cloze","category":"Physiological Adaptation","topic":"Sepsis & Septic Shock","difficulty":"hard","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.34.stem.en","stemPathZh":"questions.34.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,76],"terminalOffsetsZh":[0,19],"fullStemEn":"Complete the clinical judgment statement for a client with suspected sepsis.","fullStemZh":"完成关于疑似脓毒症患者的临床判断陈述。","terminalSentenceEn":"Complete the clinical judgment statement for a client with suspected sepsis.","terminalSentenceZh":"完成关于疑似脓毒症患者的临床判断陈述。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"A client with pneumonia has temperature 102.6 °F (39.2 °C), heart rate 124/min, blood pressure 86/48 mm Hg, and new confusion. The nurse should recognize possible {{1}}, prioritize {{2}}, and anticipate {{3}}.","zh":"一位肺炎患者体温102.6 °F (39.2 °C)、心率124次/分、血压86/48 mm Hg，并出现新的意识混乱。护士应识别可能的{{1}}，优先{{2}}，并预期{{3}}。"},"dropdowns":[{"id":"1","options":[{"id":"o2","en":"stable expected pneumonia recovery","zh":"稳定的肺炎预期恢复过程"},{"id":"o3","en":"isolated anxiety","zh":"单纯焦虑"},{"id":"o1","en":"sepsis with poor perfusion","zh":"伴灌注不足的脓毒症"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"rapid assessment and provider notification","zh":"快速评估并通知医护提供者"},{"id":"o2","en":"routine discharge teaching","zh":"常规出院教育"},{"id":"o3","en":"limiting oral fluids for the shift","zh":"本班限制口服液体"}],"correct":"o1"},{"id":"3","options":[{"id":"o2","en":"a low-sodium diet prescription","zh":"低钠饮食医嘱"},{"id":"o1","en":"blood cultures and broad-spectrum antibiotics","zh":"血培养和广谱抗生素"},{"id":"o3","en":"airborne isolation for tuberculosis","zh":"结核病空气隔离"}],"correct":"o1"}]},"rationaleCorrectEn":"Fever, tachycardia, hypotension, infection, and new confusion suggest sepsis with impaired perfusion. Early escalation, cultures, fluids as prescribed, and antibiotics are time-sensitive.","rationaleCorrectZh":"发热、心动过速、低血压、感染和新发意识混乱提示伴灌注受损的脓毒症。早期升级处理、培养、按医嘱补液和抗生素具有时间敏感性。","testTakingStrategyEn":"In infection questions, pair fever with perfusion signs such as hypotension and confusion to recognize sepsis.","testTakingStrategyZh":"感染题中，将发热与低血压、意识混乱等灌注表现结合，可识别脓毒症。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1186,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_mc_cane_ambulation_036","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.35","itemType":"multiple_choice","category":"Basic Care and Comfort","topic":"Mobility & Immobility","difficulty":"easy","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.35.stem.en","stemPathZh":"questions.35.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[77,129],"terminalOffsetsZh":[19,32],"fullStemEn":"The nurse teaches a client with left-sided weakness to ambulate with a cane. Which client action indicates correct understanding?","fullStemZh":"护士教一位左侧无力的患者使用手杖行走。患者哪项动作表明理解正确？","terminalSentenceEn":"Which client action indicates correct understanding?","terminalSentenceZh":"患者哪项动作表明理解正确？","penultimateSentenceEn":"The nurse teaches a client with left-sided weakness to ambulate with a cane.","penultimateSentenceZh":"护士教一位左侧无力的患者使用手杖行走。","responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Holds the cane in the left hand and moves it after the right leg.","zh":"左手持杖，并在右腿之后移动。"},{"id":"C","en":"Uses the cane only when climbing stairs, not on level ground.","zh":"只在上楼梯时使用手杖，在平地不用。"},{"id":"D","en":"Places the cane far ahead and leans the chest forward.","zh":"将手杖放得很远，并让胸部前倾。"},{"id":"B","en":"Holds the cane in the right hand and moves it forward with the left leg.","zh":"右手持杖，并与左腿一起向前移动。"}],"correct":["B"]},"rationaleCorrectEn":"The cane is held on the stronger side. It moves with the weaker leg to widen the base of support and improve stability.","rationaleCorrectZh":"手杖应握在较强的一侧，并与较弱的腿一起移动，以扩大支撑面并提高稳定性。","testTakingStrategyEn":"For cane questions, remember: cane on the strong side, moves with the weak leg.","testTakingStrategyZh":"手杖题记住：手杖在强侧，随弱侧腿移动。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1187,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_sata_disaster_triage_037","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.36","itemType":"select_all","category":"Management of Care","topic":"Prioritization & Delegation","difficulty":"hard","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.36.stem.en","stemPathZh":"questions.36.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[108,130],"terminalOffsetsZh":[29,37],"fullStemEn":"After a mass-casualty incident, which clients should the triage nurse assign to the immediate/red category? Select all that apply.","fullStemZh":"大规模伤亡事件后，分诊护士应将哪些患者归为立即/红色类别？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"After a mass-casualty incident, which clients should the triage nurse assign to the immediate/red category?","penultimateSentenceZh":"大规模伤亡事件后，分诊护士应将哪些患者归为立即/红色类别？","responseContext":{"type":"select_all","options":[{"id":"E","en":"A client with signs of tension pneumothorax and severe respiratory distress.","zh":"一位有张力性气胸迹象并严重呼吸窘迫的患者。"},{"id":"C","en":"A client with uncontrolled arterial bleeding from the thigh.","zh":"一位大腿动脉出血无法控制的患者。"},{"id":"F","en":"A client crying with superficial abrasions who asks to call family.","zh":"一位哭泣、有表浅擦伤并要求给家人打电话的患者。"},{"id":"B","en":"A client with a closed forearm fracture who can walk.","zh":"一位闭合性前臂骨折且能行走的患者。"},{"id":"A","en":"A client with noisy respirations and a weak carotid pulse.","zh":"一位呼吸有杂音且颈动脉搏动微弱的患者。"},{"id":"D","en":"A client with full-thickness burns over most of the body and no spontaneous respirations after airway repositioning.","zh":"一位大面积全层烧伤患者，重新摆正气道后仍无自主呼吸。"}],"correct":["A","C","E"]},"rationaleCorrectEn":"Immediate/red clients have life-threatening problems that are likely survivable with rapid intervention, such as airway compromise, major bleeding, or severe respiratory distress.","rationaleCorrectZh":"立即/红色类别患者存在危及生命但快速干预后可能存活的问题，如气道受损、大出血或严重呼吸窘迫。","testTakingStrategyEn":"Disaster triage prioritizes the greatest good for the greatest number: immediate care goes to life threats likely to survive with rapid intervention.","testTakingStrategyZh":"灾难分诊强调最大多数人的最大利益：立即处理给那些有生命威胁且快速干预后可能存活者。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1188,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_cloze_neutropenia_038","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.37","itemType":"dropdown_cloze","category":"Safety and Infection Prevention and Control","topic":"Transmission-Based Precautions","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.37.stem.en","stemPathZh":"questions.37.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[77,112],"terminalOffsetsZh":[28,37],"fullStemEn":"A client receiving chemotherapy has an absolute neutrophil count of 400/mm3. Complete the priority nursing plan.","fullStemZh":"一位接受化疗的患者绝对中性粒细胞计数为 400/mm3。完成优先护理计划。","terminalSentenceEn":"Complete the priority nursing plan.","terminalSentenceZh":"完成优先护理计划。","penultimateSentenceEn":"A client receiving chemotherapy has an absolute neutrophil count of 400/mm3.","penultimateSentenceZh":"一位接受化疗的患者绝对中性粒细胞计数为 400/mm3。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse should use {{1}} and avoid {{2}}.","zh":"护士应采取 {{1}}，并避免 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o2","en":"a negative-pressure room","zh":"负压病房"},{"id":"o3","en":"a room with contact precautions only","zh":"仅采取接触隔离的病房"},{"id":"o1","en":"Standard Precautions with strict hand hygiene","zh":"标准预防措施并严格执行手卫生"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"sick visitors and unwashed produce","zh":"生病的访客和未清洗的农产品"},{"id":"o2","en":"bottled water and cooked foods","zh":"瓶装水和熟食"},{"id":"o3","en":"a mask during transport","zh":"转运时戴口罩"}],"correct":"o1"}]},"rationaleCorrectEn":"An ANC of 400/mm3 indicates severe neutropenia and increased infection risk. Use Standard Precautions with strict hand hygiene, avoid sick contacts, and follow food-safety guidance. Neutropenia alone does not require a formal Protective Environment, and raw produce may be eaten when it is washed well or peeled according to the care plan.","rationaleCorrectZh":"绝对中性粒细胞计数为 400/mm3 表示严重中性粒细胞减少，感染风险升高。应采取标准预防措施并严格执行手卫生，避免接触生病的人，并遵循食品安全指导。仅凭中性粒细胞减少并不需要正式的保护性环境；按照护理计划充分清洗或削皮后，可以食用生鲜农产品。","testTakingStrategyEn":"For neutropenia, prioritize hand hygiene, avoiding sick contacts, and safe food handling. Do not assume that every low ANC requires a formal Protective Environment or a blanket ban on raw produce.","testTakingStrategyZh":"遇到中性粒细胞减少，应优先考虑手卫生、避免接触生病的人和安全处理食物。不要假设每个低 ANC 患者都需要正式的保护性环境或一律禁止生鲜农产品。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1189,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_fib_pediatric_acetaminophen_039","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.38","itemType":"fill_in_blank","category":"Pharmacological and Parenteral Therapies","topic":"Dosage Calculations","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.38.stem.en","stemPathZh":"questions.38.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[159,186],"terminalOffsetsZh":[65,74],"fullStemEn":"A child weighs 18 kg. The provider prescribes acetaminophen 15 mg/kg PO once. The medication label reads 160 mg/5 mL. How many mL should the nurse administer? Round to the nearest tenth.","fullStemZh":"一名儿童体重 18 kg。医嘱为对乙酰氨基酚 15 mg/kg 口服一次。药物标签为 160 mg/5 mL。护士应给多少 mL？四舍五入到十分位。","terminalSentenceEn":"Round to the nearest tenth.","terminalSentenceZh":"四舍五入到十分位。","penultimateSentenceEn":"How many mL should the nurse administer?","penultimateSentenceZh":"护士应给多少 mL？","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"mL to administer","zh":"应给药的毫升数"},"acceptable":["8.4","8.4 mL"],"numeric":{"value":8.4,"tolerance":0.1,"unit":"mL"}}]},"rationaleCorrectEn":"The dose is 18 kg x 15 mg/kg = 270 mg. The concentration is 160 mg/5 mL, or 32 mg/mL. 270 mg divided by 32 mg/mL = 8.4375 mL, rounded to 8.4 mL.","rationaleCorrectZh":"剂量为 18 kg x 15 mg/kg = 270 mg。浓度为 160 mg/5 mL，即 32 mg/mL。270 mg 除以 32 mg/mL = 8.4375 mL，四舍五入为 8.4 mL。","testTakingStrategyEn":"For pediatric liquid medication math, write the ordered mg dose before converting to mL.","testTakingStrategyZh":"儿童液体药物计算时，先写出医嘱所需的 mg 剂量，再换算成 mL。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1190,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_matrix_pressure_injury_040","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.39","itemType":"matrix","category":"Basic Care and Comfort","topic":"Elimination & Comfort","difficulty":"easy","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.39.stem.en","stemPathZh":"questions.39.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,108],"terminalOffsetsZh":[0,38],"fullStemEn":"For each nursing action for a bedbound client, select whether it helps prevent pressure injury or is unsafe.","fullStemZh":"针对卧床患者的每项护理措施，选择其是否有助于预防压力性损伤或属于不安全做法。","terminalSentenceEn":"For each nursing action for a bedbound client, select whether it helps prevent pressure injury or is unsafe.","terminalSentenceZh":"针对卧床患者的每项护理措施，选择其是否有助于预防压力性损伤或属于不安全做法。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Reposition the client at least every 2 hours.","zh":"至少每 2 小时为患者翻身一次。"},{"id":"r2","en":"Massage a reddened bony prominence.","zh":"按摩发红的骨突部位。"},{"id":"r3","en":"Keep the head of bed at the lowest safe angle.","zh":"在安全范围内尽量降低床头角度。"},{"id":"r4","en":"Use a donut-shaped cushion under the sacrum.","zh":"在骶骨下使用甜甜圈形垫圈。"}],"columns":[{"id":"c2","en":"Unsafe","zh":"不安全"},{"id":"c1","en":"Prevents injury","zh":"预防损伤"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c2"]}]},"rationaleCorrectEn":"Frequent repositioning and minimizing shear help prevent pressure injury. Massage over reddened areas and donut cushions can worsen tissue injury or pressure.","rationaleCorrectZh":"定期翻身和减少剪切力有助于预防压力性损伤。按摩发红区域和使用环形垫可能加重组织损伤或压力。","testTakingStrategyEn":"Pressure injury prevention focuses on pressure relief, moisture control, nutrition, and avoiding shear.","testTakingStrategyZh":"预防压力性损伤重点是减压、控制潮湿、营养支持和避免剪切力。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1191,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_or_fire_response_041","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.40","itemType":"ordered_response","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.40.stem.en","stemPathZh":"questions.40.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[40,87],"terminalOffsetsZh":[13,27],"fullStemEn":"A small fire starts in a client's room. Place the nurse's actions in the correct order.","fullStemZh":"一位患者病房内发生小火灾。请按正确顺序排列护士的行动。","terminalSentenceEn":"Place the nurse's actions in the correct order.","terminalSentenceZh":"请按正确顺序排列护士的行动。","penultimateSentenceEn":"A small fire starts in a client's room.","penultimateSentenceZh":"一位患者病房内发生小火灾。","responseContext":{"type":"ordered_response","options":[{"id":"D","en":"Extinguish the fire if it is safe to do so.","zh":"若安全可行，尝试灭火。"},{"id":"C","en":"Close the room door to contain the fire.","zh":"关闭房门以控制火势蔓延。"},{"id":"B","en":"Move the client away from immediate danger.","zh":"将患者移离直接危险。"},{"id":"A","en":"Pull the fire alarm and call for help.","zh":"拉响火警并呼叫帮助。"}],"correct":["B","A","C","D"]},"rationaleCorrectEn":"The RACE sequence is Rescue, Alarm, Contain, Extinguish/Evacuate. Protect the client first, then activate the emergency response.","rationaleCorrectZh":"RACE 顺序为救人、报警、控制、灭火/疏散。先保护患者，再启动应急响应。","testTakingStrategyEn":"Use RACE for fire questions: Rescue, Alarm, Contain, Extinguish or Evacuate.","testTakingStrategyZh":"火灾题使用 RACE：救人、报警、控制、灭火或疏散。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"A small fire starts in a client's room.","controlSentenceZh":"一位患者病房内发生小火灾。"}
{"queueIndex":1192,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_sata_suicide_precautions_042","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.41","itemType":"select_all","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.41.stem.en","stemPathZh":"questions.41.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[94,116],"terminalOffsetsZh":[28,36],"fullStemEn":"A client says, \"I have a plan to kill myself tonight.\" Which nursing actions are appropriate? Select all that apply.","fullStemZh":"一位患者说：“我今晚有自杀计划。”哪些护理措施是适当的？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which nursing actions are appropriate?","penultimateSentenceZh":"哪些护理措施是适当的？","responseContext":{"type":"select_all","options":[{"id":"B","en":"Remove belts, cords, sharp objects, and unnecessary equipment from the room.","zh":"从房间移除腰带、绳索、锐器和不必要设备。"},{"id":"A","en":"Initiate continuous one-to-one observation according to policy.","zh":"按政策启动连续一对一观察。"},{"id":"E","en":"Rely on a written promise that the client will not self-harm.","zh":"依赖患者书面承诺不会自伤。"},{"id":"D","en":"Assign the client to a private room at the end of the hallway for quiet.","zh":"为安静起见，将患者安排在走廊尽头的单人房。"},{"id":"F","en":"Notify the provider and document the assessment and safety interventions.","zh":"通知医疗提供者，并记录评估和安全干预。"},{"id":"C","en":"Ask directly about access to the planned means.","zh":"直接询问患者是否能取得计划使用的手段。"}],"correct":["A","B","C","F"]},"rationaleCorrectEn":"An active suicidal plan requires immediate safety measures, direct assessment, close observation, provider notification, and clear documentation.","rationaleCorrectZh":"存在明确自杀计划时，需要立即采取安全措施、直接评估、密切观察、通知医疗提供者并清楚记录。","testTakingStrategyEn":"With suicidal intent and a plan, choose immediate safety and direct assessment over reassurance.","testTakingStrategyZh":"遇到有自杀意图和计划者，选择立即安全措施和直接评估，而不是单纯安慰。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1193,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_mc_advance_directives_043","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.42","itemType":"multiple_choice","category":"Management of Care","topic":"Legal & Ethical Principles","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.42.stem.en","stemPathZh":"questions.42.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[166,200],"terminalOffsetsZh":[42,52],"fullStemEn":"A client with decision-making capacity has an advance directive refusing long-term tube feeding. The family asks the nurse to \"do everything\" and start tube feeding. What is the nurse's best response?","fullStemZh":"一位有决策能力的患者在预先指示中拒绝长期管饲。家属要求护士“尽一切努力”并开始管饲。护士最佳回应是什么？","terminalSentenceEn":"What is the nurse's best response?","terminalSentenceZh":"护士最佳回应是什么？","penultimateSentenceEn":"The family asks the nurse to \"do everything\" and start tube feeding.","penultimateSentenceZh":"家属要求护士“尽一切努力”并开始管饲。","responseContext":{"type":"multiple_choice","options":[{"id":"C","en":"Tell the family the nurse cannot discuss advance directives.","zh":"告诉家属护士不能讨论预先指示。"},{"id":"A","en":"Begin tube feeding because the family is requesting treatment.","zh":"因为家属要求治疗，所以开始管饲。"},{"id":"D","en":"Ask the family to sign a consent form overriding the directive.","zh":"请家属签署同意书以推翻预先指示。"},{"id":"B","en":"Explain that the client's documented wishes guide care and notify the provider.","zh":"解释患者记录在案的意愿指导护理，并通知医疗提供者。"}],"correct":["B"]},"rationaleCorrectEn":"A competent client's wishes and valid advance directive guide care. The nurse advocates for the client and involves the provider or ethics resources as needed.","rationaleCorrectZh":"有决策能力患者的意愿和有效预先指示指导护理。护士应维护患者权益，并按需联系医疗提供者或伦理资源。","testTakingStrategyEn":"Ethics questions often hinge on autonomy: honor the competent client's informed wishes.","testTakingStrategyZh":"伦理题常围绕自主权：尊重有决策能力患者的知情意愿。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1194,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_cloze_postpartum_hemorrhage_044","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.43","itemType":"dropdown_cloze","category":"Reduction of Risk Potential","topic":"Maternal-Newborn Care & Teaching","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.43.stem.en","stemPathZh":"questions.43.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[73,117],"terminalOffsetsZh":[27,37],"fullStemEn":"One hour after birth, a postpartum client saturates a pad in 15 minutes. The uterus is boggy and above the umbilicus.","fullStemZh":"分娩后一小时，一位产后患者 15 分钟内浸透一片产垫。子宫松软且位于脐上。","terminalSentenceEn":"The uterus is boggy and above the umbilicus.","terminalSentenceZh":"子宫松软且位于脐上。","penultimateSentenceEn":"One hour after birth, a postpartum client saturates a pad in 15 minutes.","penultimateSentenceZh":"分娩后一小时，一位产后患者 15 分钟内浸透一片产垫。","responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse should first {{1}} and then anticipate {{2}}.","zh":"护士应首先 {{1}}，然后预期 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"massage the uterine fundus","zh":"按摩子宫底"},{"id":"o3","en":"remove the perineal pad and wait 30 minutes","zh":"移除产垫并等待 30 分钟"},{"id":"o2","en":"place the client in Trendelenburg position","zh":"让患者采取头低脚高位"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"oral fluid restriction","zh":"限制口服液体"},{"id":"o3","en":"application of a heating pad","zh":"使用热敷垫"},{"id":"o1","en":"administration of oxytocin as prescribed","zh":"按医嘱给予缩宫素"}],"correct":"o1"}]},"rationaleCorrectEn":"A boggy uterus with heavy bleeding suggests uterine atony. Fundal massage is the immediate nursing action; uterotonic medication such as oxytocin may be prescribed.","rationaleCorrectZh":"子宫松软并大量出血提示子宫乏力。立即护理措施是按摩子宫底；可能按医嘱给予缩宫药物如缩宫素。","testTakingStrategyEn":"For postpartum bleeding, assess uterine tone. Boggy fundus points to massage first.","testTakingStrategyZh":"产后出血题先评估子宫张力。子宫底松软提示首先按摩。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1195,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_matrix_newborn_findings_045","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.44","itemType":"matrix","category":"Health Promotion and Maintenance","topic":"Maternal-Newborn Care & Teaching","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.44.stem.en","stemPathZh":"questions.44.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,78],"terminalOffsetsZh":[0,26],"fullStemEn":"For each newborn finding, select whether it is expected or requires follow-up.","fullStemZh":"针对每项新生儿表现，选择其属于预期表现还是需要跟进。","terminalSentenceEn":"For each newborn finding, select whether it is expected or requires follow-up.","terminalSentenceZh":"针对每项新生儿表现，选择其属于预期表现还是需要跟进。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Acrocyanosis of hands and feet during the first day.","zh":"出生第一天手足末端发绀。"},{"id":"r2","en":"Nasal flaring and grunting respirations.","zh":"鼻翼扇动并伴呻吟样呼吸。"},{"id":"r3","en":"Heart rate 130/min while quiet.","zh":"安静时心率 130 次/分。"},{"id":"r4","en":"Axillary temperature 96.8 °F (36.0 °C).","zh":"腋温 36.0 C（96.8 F）。"},{"id":"r5","en":"Small white papules across the nose.","zh":"鼻部有小白色丘疹。"}],"columns":[{"id":"c2","en":"Requires follow-up","zh":"需要跟进"},{"id":"c1","en":"Expected","zh":"预期表现"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c2"]},{"rowId":"r5","columnIds":["c1"]}]},"rationaleCorrectEn":"Acrocyanosis, heart rate around 130/min, and milia can be normal newborn findings. Nasal flaring, grunting, and low temperature require prompt follow-up.","rationaleCorrectZh":"手足末端发绀、心率约 130 次/分和粟粒疹可为新生儿正常表现。鼻翼扇动、呻吟样呼吸和低体温需要及时跟进。","testTakingStrategyEn":"In newborn questions, separate benign transition findings from respiratory distress and temperature instability.","testTakingStrategyZh":"新生儿题要区分良性适应表现与呼吸窘迫、体温不稳定。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1196,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_or_enteral_feeding_046","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.45","itemType":"ordered_response","category":"Basic Care and Comfort","topic":"Nutritional & Fluid Support","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.45.stem.en","stemPathZh":"questions.45.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[97,136],"terminalOffsetsZh":[21,34],"fullStemEn":"The nurse is preparing to start an intermittent feeding through a newly placed nasogastric tube. Place the actions in the correct order.","fullStemZh":"护士准备通过新置入的鼻胃管开始间歇性喂养。请按正确顺序排列护理措施。","terminalSentenceEn":"Place the actions in the correct order.","terminalSentenceZh":"请按正确顺序排列护理措施。","penultimateSentenceEn":"The nurse is preparing to start an intermittent feeding through a newly placed nasogastric tube.","penultimateSentenceZh":"护士准备通过新置入的鼻胃管开始间歇性喂养。","responseContext":{"type":"ordered_response","options":[{"id":"C","en":"Confirm the prescribed formula and feeding amount.","zh":"确认医嘱配方和喂养量。"},{"id":"B","en":"Elevate the head of bed at least 30 degrees.","zh":"将床头抬高至少 30 度。"},{"id":"D","en":"Begin the feeding at the prescribed rate.","zh":"按医嘱速度开始喂养。"},{"id":"A","en":"Verify tube placement according to facility policy.","zh":"按机构政策确认管道位置。"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"Placement must be verified before using a newly placed tube. Head elevation reduces aspiration risk, and the nurse confirms the order before starting the feeding.","rationaleCorrectZh":"使用新置入管道前必须确认位置。抬高床头可降低误吸风险，开始喂养前护士需确认医嘱。","testTakingStrategyEn":"Before putting anything into a tube, verify placement and reduce aspiration risk.","testTakingStrategyZh":"向管道内注入任何物质前，先确认位置并降低误吸风险。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":true,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1197,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_sata_alcohol_withdrawal_047","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.46","itemType":"select_all","category":"Psychosocial Integrity","topic":"Substance Use & Withdrawal","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.46.stem.en","stemPathZh":"questions.46.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[141,163],"terminalOffsetsZh":[41,49],"fullStemEn":"A client was admitted 36 hours after the last alcohol intake. Which findings suggest worsening withdrawal that requires prompt intervention? Select all that apply.","fullStemZh":"一位患者在最后一次饮酒后 36 小时入院。哪些表现提示戒酒反应加重并需要及时干预？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which findings suggest worsening withdrawal that requires prompt intervention?","penultimateSentenceZh":"哪些表现提示戒酒反应加重并需要及时干预？","responseContext":{"type":"select_all","options":[{"id":"F","en":"Disorientation and severe agitation.","zh":"定向力障碍并严重躁动。"},{"id":"D","en":"Asks for help sleeping because the unit is noisy.","zh":"因病区嘈杂而请求帮助入睡。"},{"id":"C","en":"Blood pressure 184/106 mm Hg and heart rate 128/min.","zh":"血压 184/106 mm Hg，心率 128 次/分。"},{"id":"E","en":"New generalized tonic-clonic seizure.","zh":"新发全身强直-阵挛性发作。"},{"id":"A","en":"Fine tremor of the hands with mild anxiety.","zh":"手部细微震颤并轻度焦虑。"},{"id":"B","en":"Visual hallucinations of insects on the wall.","zh":"看见墙上有昆虫的幻视。"}],"correct":["B","C","E","F"]},"rationaleCorrectEn":"Hallucinations, severe autonomic instability, seizures, disorientation, and severe agitation can indicate severe withdrawal or delirium tremens.","rationaleCorrectZh":"幻觉、严重自主神经不稳定、癫痫发作、定向力障碍和严重躁动可能提示严重戒断或震颤谵妄。","testTakingStrategyEn":"In withdrawal, escalating vital signs, hallucinations, seizures, or delirium cues outrank mild tremor or insomnia.","testTakingStrategyZh":"戒断题中，生命体征恶化、幻觉、癫痫或谵妄线索优先于轻微震颤或失眠。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1198,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_mc_sterile_field_048","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.47","itemType":"multiple_choice","category":"Safety and Infection Prevention and Control","topic":"PPE & Sterile Technique","difficulty":"easy","ngnSkill":"take_action","stemPathEn":"questions.47.stem.en","stemPathZh":"questions.47.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[80,110],"terminalOffsetsZh":[16,26],"fullStemEn":"While setting up a sterile field, the nurse turns away to this option question. What should the nurse do next?","fullStemZh":"护士在准备无菌区时转身回答问题。护士下一步应怎么做？","terminalSentenceEn":"What should the nurse do next?","terminalSentenceZh":"护士下一步应怎么做？","penultimateSentenceEn":"While setting up a sterile field, the nurse turns away to this option question.","penultimateSentenceZh":"护士在准备无菌区时转身回答问题。","responseContext":{"type":"multiple_choice","options":[{"id":"A","en":"Cover the field with a clean towel and proceed.","zh":"用清洁毛巾覆盖无菌区并继续。"},{"id":"D","en":"Spray the field with antiseptic solution.","zh":"用消毒液喷洒无菌区。"},{"id":"C","en":"Continue because no item visibly touched the field.","zh":"继续操作，因为没有物品明显接触无菌区。"},{"id":"B","en":"Discard the field and set up a new sterile field.","zh":"丢弃该无菌区并重新建立新的无菌区。"}],"correct":["B"]},"rationaleCorrectEn":"A sterile field must remain in view. If the nurse turns away, the field is considered contaminated and should be replaced.","rationaleCorrectZh":"无菌区必须始终在视线内。若护士转身离开视线，应视为污染并重新建立。","testTakingStrategyEn":"Sterile fields are contaminated if out of sight, below the waist, wet, or touched by nonsterile items.","testTakingStrategyZh":"无菌区若离开视线、低于腰部、潮湿或被非无菌物品接触，即视为污染。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1199,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_fib_pediatric_urine_output_049","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.48","itemType":"fill_in_blank","category":"Reduction of Risk Potential","topic":"Laboratory & Diagnostic Tests","difficulty":"easy","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.48.stem.en","stemPathZh":"questions.48.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[88,143],"terminalOffsetsZh":[36,51],"fullStemEn":"A child weighs 20 kg. The nurse is monitoring for a minimum urine output of 1 mL/kg/hr. What is the minimum expected urine output over 4 hours?","fullStemZh":"一名儿童体重 20 kg。护士监测最低尿量标准为 1 mL/kg/hr。4 小时内最低预期尿量是多少？","terminalSentenceEn":"What is the minimum expected urine output over 4 hours?","terminalSentenceZh":"4 小时内最低预期尿量是多少？","penultimateSentenceEn":"The nurse is monitoring for a minimum urine output of 1 mL/kg/hr.","penultimateSentenceZh":"护士监测最低尿量标准为 1 mL/kg/hr。","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"minimum urine output in 4 hours","zh":"4 小时最低尿量"},"acceptable":["80","80 mL"],"numeric":{"value":80,"tolerance":0,"unit":"mL"}}]},"rationaleCorrectEn":"Minimum output is 1 mL x 20 kg x 4 hr = 80 mL.","rationaleCorrectZh":"最低尿量为 1 mL x 20 kg x 4 hr = 80 mL。","testTakingStrategyEn":"Track the units: mL/kg/hr x kg x hr leaves mL.","testTakingStrategyZh":"注意单位：mL/kg/hr x kg x hr 最终单位为 mL。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1200,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_canonical_matrix_scope_assignment_050","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.49","itemType":"matrix","category":"Management of Care","topic":"Legal & Ethical Principles","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.49.stem.en","stemPathZh":"questions.49.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[37,86],"terminalOffsetsZh":[11,26],"fullStemEn":"The charge nurse is assigning tasks. Select the appropriate team member for each task.","fullStemZh":"责任护士正在分配任务。为每项任务选择合适的团队成员。","terminalSentenceEn":"Select the appropriate team member for each task.","terminalSentenceZh":"为每项任务选择合适的团队成员。","penultimateSentenceEn":"The charge nurse is assigning tasks.","penultimateSentenceZh":"责任护士正在分配任务。","responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Initial assessment of a newly admitted client with chest pain.","zh":"对新入院胸痛患者进行初始评估。"},{"id":"r2","en":"Administer oral antibiotics to a stable client.","zh":"为病情稳定的患者给予口服抗生素。"},{"id":"r3","en":"Ambulate a stable postoperative client who has already been assessed.","zh":"协助已评估且病情稳定的术后患者下床行走。"},{"id":"r4","en":"Teach a client how to self-administer insulin before discharge.","zh":"出院前教患者如何自行注射胰岛素。"}],"columns":[{"id":"c2","en":"LPN/VN","zh":"执业护士/职业护士"},{"id":"c3","en":"UAP","zh":"无执照辅助人员"},{"id":"c1","en":"RN","zh":"注册护士"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c3"]},{"rowId":"r4","columnIds":["c1"]}]},"rationaleCorrectEn":"RNs handle assessment, teaching, and unstable or new conditions. LPN/VNs can give routine medications to stable clients. UAP can perform delegated basic tasks for stable clients.","rationaleCorrectZh":"注册护士负责评估、教学和不稳定或新情况。执业护士/职业护士可为稳定患者给予常规药物。无执照辅助人员可为稳定患者执行被委派的基础任务。","testTakingStrategyEn":"Do not delegate assessment, teaching, evaluation, or unstable clients.","testTakingStrategyZh":"不要委派评估、教学、评价或不稳定患者的护理。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
