insRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":2308,"bankPath":"banks/hard-cases-canonical.json","bankSha256":"438c176897a41d3b7f212435e5945bd524c3f0ba5a62931eb5e85843c93d8730","topLevelQuestionId":"sa_acid_base_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.14","itemType":"dropdown_cloze","category":"Reduction of Risk Potential","topic":"ABG & Acid-Base Interpretation","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.14.stem.en","stemPathZh":"questions.14.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,51],"terminalOffsetsZh":[0,45],"fullStemEn":"ABG results: pH 7.36, PaCO2 55 mmHg, HCO3 30 mEq/L.","fullStemZh":"动脉血气结果：pH 7.36, PaCO2 55 mmHg, HCO3 30 mEq/L。","terminalSentenceEn":"ABG results: pH 7.36, PaCO2 55 mmHg, HCO3 30 mEq/L.","terminalSentenceZh":"动脉血气结果：pH 7.36, PaCO2 55 mmHg, HCO3 30 mEq/L。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"This interpretation is {{1}} and the compensatory mechanism is {{2}}.","zh":"此解释为 {{1}}，代偿机制为 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"Fully compensated respiratory acidosis","zh":"完全代偿性呼吸性酸中毒"},{"id":"o2","en":"Partially compensated metabolic alkalosis","zh":"部分代偿性代谢性碱中毒"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"Hyperventilation","zh":"过度通气"},{"id":"o1","en":"Renal retention of bicarbonate","zh":"肾脏保留重碳酸盐"}],"correct":"o1"}]},"rationaleCorrectEn":"pH is normal but on the acidic side (7.36), PaCO2 is high (acidosis), and HCO3 is high (compensation). This is fully compensated respiratory acidosis.","rationaleCorrectZh":"pH 正常但偏向酸性 (7.36)，PaCO2 升高（酸中毒），HCO3 升高（代偿）。这是完全代偿性呼吸性酸中毒。","testTakingStrategyEn":"Check pH first to determine if it is compensated or uncompensated.","testTakingStrategyZh":"先检查 pH 值以确定是代偿性的还是失代偿性的。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsT