{"queueIndex":2311,"bankPath":"banks/hard-cases-canonical.json","bankSha256":"438c176897a41d3b7f212435e5945bd524c3f0ba5a62931eb5e85843c93d8730","topLevelQuestionId":"sa_parkland_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.17","itemType":"fill_in_blank","category":"Pharmacological and Parenteral Therapies","topic":"Burn Management","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.17.stem.en","stemPathZh":"questions.17.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[73,185],"terminalOffsetsZh":[30,79],"fullStemEn":"A 70 kg client has sustained partial-thickness burns to 30% of the body. Using the Parkland formula (4 mL/kg/%TBSA), calculate the total fluid volume to be infused in the first 8 hours.","fullStemZh":"一名体重 70 kg 的患者全身 30% 面积发生二度烧伤。使用 Parkland 公式 (4 mL/kg/%TBSA)，计算前 8 小时内应输注的总液体量。","terminalSentenceEn":"Using the Parkland formula (4 mL/kg/%TBSA), calculate the total fluid volume to be infused in the first 8 hours.","terminalSentenceZh":"使用 Parkland 公式 (4 mL/kg/%TBSA)，计算前 8 小时内应输注的总液体量。","penultimateSentenceEn":"A 70 kg client has sustained partial-thickness burns to 30% of the body.","penultimateSentenceZh":"一名体重 70 kg 的患者全身 30% 面积发生二度烧伤。","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"mL","zh":"毫升"},"acceptable":["4200","4200 mL"],"numeric":{"value":4200,"tolerance":0,"unit":"mL"}}]},"rationaleCorrectEn":"Total (24h) = 4 mL * 70 kg * 30 = 8,400 mL. First 8 hours = 50% of total = 4,200 mL.","rationaleCorrectZh":"总量 (24h) = 4 mL * 70 kg * 30 = 8,400 mL。前 8 小时 = 总量的 50% = 4,200 mL。","testTakingStrategyEn":"Don't forget to divide by 2 for the first 8-hour requirement.","testTakingStrategyZh":"别忘了将前 8 小时的需求量除以 2。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
