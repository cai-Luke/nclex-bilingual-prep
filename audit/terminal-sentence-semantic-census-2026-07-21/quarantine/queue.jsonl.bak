gyEn":"Avoid ideal plans that ignore the client's life; sustainable beats perfect.","testTakingStrategyZh":"避免忽视患者生活的理想化计划；可持续比完美更重要。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
