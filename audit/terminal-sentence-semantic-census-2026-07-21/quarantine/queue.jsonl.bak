后续任务分配。","testTakingStrategyEn":"Order family meetings by urgency: safety, client voice, family capacity, resources, accountability.","testTakingStrategyZh":"家庭会议按紧急程度排序：安全、患者声音、家庭能力、资源、责任落实。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
