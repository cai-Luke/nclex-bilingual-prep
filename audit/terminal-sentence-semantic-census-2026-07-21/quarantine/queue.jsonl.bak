d be avoided.","rationaleCorrectZh":"骶尾部发现和不能移动需要减压和定时变换体位，摄入差需要营养支持。应避免按摩发红的骨突部位。","testTakingStrategyEn":"Match each intervention to the risk factor: pressure requires offloading; poor tissue tolerance requires nutrition support.","testTakingStrategyZh":"将干预与风险因素配对：受压需要减压；组织耐受性差需要营养支持。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
