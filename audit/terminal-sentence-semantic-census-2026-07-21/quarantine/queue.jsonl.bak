{"queueIndex":1306,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_2026_06_10_case03_chronic_self_management","embeddedQuestionId":"gpt_case_premium_2026_06_10_case03_matrix_selfmgmt_01","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.144.caseStudy.questions.0","itemType":"matrix","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.144.caseStudy.questions.0.stem.en","stemPathZh":"questions.144.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,93],"terminalOffsetsZh":[0,22],"fullStemEn":"For each cue, identify whether it is a self-management barrier or a self-management strength.","fullStemZh":"判断每项线索是自我管理障碍还是自我管理优势。","terminalSentenceEn":"For each cue, identify whether it is a self-management barrier or a self-management strength.","terminalSentenceZh":"判断每项线索是自我管理障碍还是自我管理优势。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Works night shift and eats one large meal after work","zh":"上夜班并在下班后吃一顿大餐"},{"id":"r2","en":"Says the plan never fits daily life","zh":"表示计划从来不适合日常生活"},{"id":"r3","en":"Asks to include daughter in education by video","zh":"要求女儿通过视频参加教育"},{"id":"r4","en":"Has decreased sensation in both feet","zh":"双足感觉减退"},{"id":"r5","en":"Has no open foot wounds today","zh":"今天足部无开放性伤口"}],"columns":[{"id":"c1","en":"Barrier or risk needing planning","zh":"需要计划处理的障碍或风险"},{"id":"c2","en":"Strength to build on","zh":"可利用的优势"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c1"]},{"rowId":"r5","columnIds":["c2"]}]},"rationaleCorrectEn":"Work schedule, poor fit, and decreased sensation create barriers or risks. Family involvement and intact skin are strengths for planning.","rationaleCorrectZh":"工作时间、计划不适配和感觉减退构成障碍或风险。家庭参与和皮肤完整是可用于计划的优势。","testTakingStrategyEn":"In chronic illness questions, look for modifiable barriers and existing strengths; both guide the plan.","testTakingStrategyZh":"慢性病题目中，要寻找可改变的障碍和已有优势；两者都指导计划。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
