{"queueIndex":2305,"bankPath":"banks/hard-cases-canonical.json","bankSha256":"438c176897a41d3b7f212435e5945bd524c3f0ba5a62931eb5e85843c93d8730","topLevelQuestionId":"sa_blood_transfusion_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.11","itemType":"ordered_response","category":"Pharmacological and Parenteral Therapies","topic":"Medication Safety & Admin","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.11.stem.en","stemPathZh":"questions.11.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[79,130],"terminalOffsetsZh":[23,36],"fullStemEn":"The nurse is preparing to administer a unit of packed red blood cells (PRBCs). Place the steps in the correct chronological order.","fullStemZh":"护士准备输注一单位浓缩红细胞 (PRBCs)。按正确的先后顺序排列步骤。","terminalSentenceEn":"Place the steps in the correct chronological order.","terminalSentenceZh":"按正确的先后顺序排列步骤。","penultimateSentenceEn":"The nurse is preparing to administer a unit of packed red blood cells (PRBCs).","penultimateSentenceZh":"护士准备输注一单位浓缩红细胞 (PRBCs)。","responseContext":{"type":"ordered_response","options":[{"id":"A","en":"Verify the blood product with another RN","zh":"与另一名注册护士核对血液制品"},{"id":"B","en":"Obtain baseline vital signs","zh":"获取基础生命体征"},{"id":"C","en":"Spike the blood bag with Y-tubing and NS","zh":"用 Y 型输血器和生理盐水插入血袋"},{"id":"D","en":"Stay with the client for the first 15 minutes","zh":"在最初的 15 分钟内留在患者身边"}],"correct":["B","A","C","D"]},"rationaleCorrectEn":"Baseline vitals must be taken before verification or spiking. Verification is done before starting the infusion.","rationaleCorrectZh":"在核对或插入血袋之前必须先测量基础生命体征。核对在开始输注之前完成。","testTakingStrategyEn":"Assess (vitals) before acting (administering).","testTakingStrategyZh":"在行动（给药）之前先评估（生命体征）。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":2306,"bankPath":"banks/hard-cases-canonical.json","bankSha256":"438c176897a41d3b7f212435e5945bd524c3f0ba5a62931eb5e85843c93d8730","topLevelQuestionId":"sa_dopamine_calc_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.12","itemType":"fill_in_blank","category":"Pharmacological and Parenteral Therapies","topic":"Dosage Calculations","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.12.stem.en","stemPathZh":"questions.12.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[121,157],"terminalOffsetsZh":[71,83],"fullStemEn":"Order: Dopamine 5 mcg/kg/min. Client weight: 80 kg. Solution: 400 mg in 250 mL NS. Calculate the infusion rate in mL/hr. (Round to the nearest whole number).","fullStemZh":"医嘱：多巴胺 5 mcg/kg/min。患者体重：80 kg。溶液：400 mg 溶于 250 mL 生理盐水。计算输注速率（mL/hr）。（四舍五入到最近的整数）。","terminalSentenceEn":"(Round to the nearest whole number).","terminalSentenceZh":"四舍五入到最近的整数）。","penultimateSentenceEn":"Calculate the infusion rate in mL/hr.","penultimateSentenceZh":"计算输注速率（mL/hr）。（","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"mL/hr","zh":"毫升/小时"},"acceptable":["15","15 mL/hr"],"numeric":{"value":15,"tolerance":0.5,"unit":"mL/hr"}}]},"rationaleCorrectEn":"1. 5 mcg * 80 kg * 60 min = 24,000 mcg/hr = 24 mg/hr. 2. (24 mg / 400 mg) * 250 mL = 15 mL/hr.","rationaleCorrectZh":"1. 5 mcg * 80 kg * 60 min = 24,000 mcg/hr = 24 mg/hr。 2. (24 mg / 400 mg) * 250 mL = 15 mL/hr。","testTakingStrategyEn":"Convert mcg to mg and minutes to hours before solving for volume.","testTakingStrategyZh":"在求解容量之前，先将 mcg 转换为 mg，将分钟转换为小时。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":true,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
