nalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1344,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_chronic_self_management_07","embeddedQuestionId":"gpt_case_gap_2026_06_11_self_management_part_1_matrix_cues","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.159.caseStudy.questions.0","itemType":"matrix","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.159.caseStudy.questions.0.stem.en","stemPathZh":"questions.159.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,74],"terminalOffsetsZh":[0,21],"fullStemEn":"Classify each finding using the follow-up call and discharge instructions.","fullStemZh":"根据随访电话和出院指导对每项发现进行分类。","terminalSentenceEn":"Classify each finding using the follow-up call and discharge instructions.","terminalSentenceZh":"根据随访电话和出院指导对每项发现进行分类。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Weight log: 182 lb Monday to 187 lb Thursday","zh":"体重记录：周一182磅，周四187磅"},{"id":"r2","en":"Client says, “I do not know what numbers matter.”","zh":"患者说：“我不知道哪些数字重要。”"},{"id":"r3","en":"Client buys canned soups because they are inexpensive.","zh":"患者因为便宜而购买罐头汤。"},{"id":"r4","en":"Working scale and clinic number are in the home.","zh":"家中有可用体重秤和诊所电话。"},{"id":"r5","en":"New ankle swelling and sleeping on 3 pillows last night","zh":"新出现踝部肿胀，昨晚睡觉用了3个枕头"}],"columns":[{"id":"c2","en":"Self-management barrier","zh":"自我管理障碍"},{"id":"c1","en":"Same-day clinic follow-up cue","zh":"当天联系诊所的线索"},{"id":"c3","en":"Self-management support","zh":"自我管理支持"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c3"]},{"rowId":"r5","columnIds":["c1"]}]},"rationaleCorrectEn":"The weight gain, new swelling, and need for more pillows match the same-day call instructions. Difficulty identifying meaningful numbers and reliance on canned soups are self-management barriers. Having a working scale and clinic number supports self-management.","rationaleCorrectZh":"体重增加、新出现肿胀和需要更多枕头符合当天联系诊所的指导。无法识别重要数字以及依赖罐头汤是自我管理障碍。家中有可用体重秤和诊所电话则支持自我管理。","testTakingStrategyEn":"Use the written instructions in the exhibit as the scoring rule before applying general disease knowledge.","testTakingStrategyZh":"先把资料中的书面指导作为判断规则，再应用一般疾病知识。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1345,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_chronic_self_management_07","embeddedQuestionId":"gpt_case_gap_2026_06_11_self_management_part_2_fib_weight_gain","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.159.caseStudy.questions.1","itemType":"fill_in_blank","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.159.caseStudy.questions.1.stem.en","stemPathZh":"questions.159.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,80],"terminalOffsetsZh":[0,20],"fullStemEn":"Using the weight log, enter the number of pounds gained from Monday to Thursday.","fullStemZh":"根据体重记录，填写周一到周四增加的磅数。","terminalSentenceEn":"Using the weight log, enter the number of pounds gained from Monday to Thursday.","terminalSentenceZh":"根据体重记录，填写周一到周四增加的磅数。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"lb gained","zh":"增加的磅数"},"acceptable":["5","5 lb","5 pounds"],"numeric":{"value":5,"tolerance":0,"unit":"lb"}}]},"rationaleCorrectEn":"The client weighed 182 lb Monday and 187 lb Thursday, so the gain is 5 lb. The discharge instructions identify a 5-lb weekly gain as a reason to call the clinic the same day.","rationaleCorrectZh":"患者周一体重182磅，周四187磅，因此增加5磅。出院指导说明1周内增加5磅应当天联系诊所。","testTakingStrategyEn":"For numeric exhibit questions, identify the exact two values requested before deciding what the number means clinically.","testTakingStrategyZh":"数字资料题中，先找出题目要求比较的两个具体数值，再判断其临床意义。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1346,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_chronic_self_management_07","embeddedQuestionId":"gpt_case_gap_2026_06_11_self_management_part_3_cloze_escalation","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.159.caseStudy.questions.2","itemType":"dropdown_cloze","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"hard","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.159.caseStudy.questions.2.stem.en","stemPathZh":"questions.159.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,43],"terminalOffsetsZh":[0,8],"fullStemEn":"Complete the teaching-evaluation statement.","fullStemZh":"完成教学评估句。","terminalSentenceEn":"Complete the teaching-evaluation statement.","terminalSentenceZh":"完成教学评估句。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse should instruct the client to {{1}} because the exhibit shows {{2}}.","zh":"护士应指导患者 {{1}}，因为资料显示 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o3","en":"seek emergency care for chest pain","zh":"因胸痛寻求急诊护理"},{"id":"o1","en":"call the clinic today","zh":"今天联系诊所"},{"id":"o2","en":"wait until the scheduled appointment","zh":"等到预约复诊时再处理"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"a 5-lb gain with new swelling and need for more pillows","zh":"增加5磅，并有新发肿胀和需要更多枕头"},{"id":"o3","en":"stable weight and no symptoms","zh":"体重稳定且无症状"},{"id":"o2","en":"severe shortness of breath at rest and confusion","zh":"静息时严重气短和意识混乱"}],"correct":"o1"}]},"rationaleCorrectEn":"The exhibit supports same-day clinic contact, not emergency care, because the client has reached the written weight-gain threshold and has new swelling/orthopnea symptoms but denies severe emergency symptoms.","rationaleCorrectZh":"资料支持当天联系诊所，而不是急诊处理，因为患者达到书面体重增加阈值，并有新发肿胀和端坐呼吸相关症状，但否认严重急诊症状。","testTakingStrategyEn":"Do not escalate beyond the evidence; choose the safest level of follow-up supported by the exhibit.","testTakingStrategyZh":"不要超出证据过度升级；选择资料支持的最安全随访层级。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1347,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_chronic_self_management_07","embeddedQuestionId":"gpt_case_gap_2026_06_11_self_management_part_4_sata_teachback","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.159.caseStudy.questions.3","itemType":"select_all","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.159.caseStudy.questions.3.stem.en","stemPathZh":"questions.159.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[73,95],"terminalOffsetsZh":[16,24],"fullStemEn":"Which nursing actions should be included in the follow-up teaching plan? Select all that apply.","fullStemZh":"随访教学计划应包括哪些护理措施？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which nursing actions should be included in the follow-up teaching plan?","penultimateSentenceZh":"随访教学计划应包括哪些护理措施？","responseContext":{"type":"select_all","options":[{"id":"C","en":"Use teach-back: “Tell me what you will do if your weight reaches 187 lb again.”","zh":"使用回授法：“如果体重又到187磅，你会怎么做？”"},{"id":"A","en":"Rewrite the call instructions using large print and plain words such as “Call today if your weight goes up 5 pounds.”","zh":"用大字和通俗语言重写联系说明，例如“体重增加5磅当天打电话”。"},{"id":"B","en":"Ask the client to show how and when the morning weight will be recorded.","zh":"请患者演示何时以及如何记录早晨体重。"},{"id":"F","en":"Instruct the client to weigh each evening after dinner.","zh":"指导患者每天晚饭后称体重。"},{"id":"D","en":"Explore affordable lower-sodium food choices and referral options.","zh":"探讨可负担的低钠食物选择和转介资源。"},{"id":"E","en":"Tell the client to drink only small sips of fluid until the next appointment.","zh":"告诉患者在下次预约前只能小口喝水。"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"The plan should use plain language, teach-back, demonstration, resource-sensitive nutrition counseling, and clear escalation instructions. Unsafe fluid restriction and evening weighing conflict with individualized instructions and accurate tracking.","rationaleCorrectZh":"计划应使用通俗语言、回授法、演示、考虑资源限制的营养指导和清晰的升级处理说明。自行严格限水和晚间称重与个体化医嘱和准确追踪相冲突。","testTakingStrategyEn":"Select interventions that remove the documented barrier and preserve safety.","testTakingStrategyZh":"选择能消除资料中已记录障碍并保持安全的措施。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1348,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_family_coping_chronic_diagnosis_08","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.160","itemType":"case_study","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"hard","ngnSkill":"generate_solutions","stemPathEn":"questions.160.stem.en","stemPathZh":"questions.160.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[158,233],"terminalOffsetsZh":[40,61],"fullStemEn":"Case study: family coping after a new chronic kidney disease diagnosis A client and spouse attend nephrology education after a new chronic illness diagnosis. The nurse assesses coping, learning needs, autonomy, and resource barriers.","fullStemZh":"病例：新诊断慢性肾病后的家庭应对 一名患者和配偶在新诊断慢性病后参加肾脏科教育。护士评估应对、学习需求、自主权和资源障碍。","terminalSentenceEn":"The nurse assesses coping, learning needs, autonomy, and resource barriers.","terminalSentenceZh":"护士评估应对、学习需求、自主权和资源障碍。","penultimateSentenceEn":"Case study: family coping after a new chronic kidney disease diagnosis A client and spouse attend nephrology education after a new chronic illness diagnosis.","penultimateSentenceZh":"病例：新诊断慢性肾病后的家庭应对 一名患者和配偶在新诊断慢性病后参加肾脏科教育。","responseContext":{},"rationaleCorrectEn":"This case uses exhibit data to guide nursing judgment for family coping after new chronic illness diagnosis, with emphasis on safe assessment, teaching, and follow-up planning.","rationaleCorrectZh":"本病例使用资料中的线索来指导与“Family coping after new chronic illness diagnosis”相关的护理判断，重点是安全评估、教学和随访计划。","testTakingStrategyEn":"In case studies, match each action to the specific cue in the exhibit rather than relying on a generic care plan.","testTakingStrategyZh":"病例题中，应把每项护理措施与资料中的具体线索相匹配，而不是套用笼统护理计划。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1349,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_family_coping_chronic_diagnosis_08","embeddedQuestionId":"gpt_case_gap_2026_06_11_family_coping_part_1_mc_response","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.160.caseStudy.questions.0","itemType":"multiple_choice","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.160.caseStudy.questions.0.stem.en","stemPathZh":"questions.160.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[112,137],"terminalOffsetsZh":[17,41],"fullStemEn":"Which response by the nurse is most therapeutic after the client says, “I heard dialysis and stopped listening. I think my life is over”?","fullStemZh":"患者说“我一听到透析就听不进去了。我觉得我的人生完了”后，护士哪项回应最具治疗性？","terminalSentenceEn":"I think my life is over”?","terminalSentenceZh":"我觉得我的人生完了”后，护士哪项回应最具治疗性？","penultimateSentenceEn":"Which response by the nurse is most therapeutic after the client says, “I heard dialysis and stopped listening.","penultimateSentenceZh":"患者说“我一听到透析就听不进去了。","responseContext":{"type":"multiple_choice","options":[{"id":"D","en":"“Your spouse can make the decisions until you feel ready.”","zh":"“在您准备好之前，可以由您的配偶做决定。”"},{"id":"A","en":"“Hearing that word felt overwhelming. Tell me what dialysis means to you right now.”","zh":"“听到这个词让您很难承受。请告诉我，透析现在对您意味着什么。”"},{"id":"C","en":"“Let me explain the entire dialysis schedule so you can stop worrying.”","zh":"“我来把整个透析安排解释清楚，这样您就不会担心了。”"},{"id":"B","en":"“Many people do fine on dialysis, so try not to think about the worst.”","zh":"“很多人透析后都还不错，所以不要总想最坏的情况。”"}],"correct":["A"]},"rationaleCorrectEn":"The best response acknowledges the emotion, invites the client to explain their understanding, and keeps the client involved in decisions. It does not minimize the feeling, overload the client with details, or transfer decision-making to the spouse.","rationaleCorrectZh":"最佳回应承认情绪，邀请患者说明自己的理解，并让患者继续参与决策。它不会淡化感受、用细节压倒患者，也不会把决策权转给配偶。","testTakingStrategyEn":"When a client expresses despair, first acknowledge and explore; do not jump to information dumping.","testTakingStrategyZh":"当患者表达绝望时，先承认并探索，不要急于灌输信息。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1350,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_family_coping_chronic_diagnosis_08","embeddedQuestionId":"gpt_case_gap_2026_06_11_family_coping_part_2_matrix_cues","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.160.caseStudy.questions.1","itemType":"matrix","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.160.caseStudy.questions.1.stem.en","stemPathZh":"questions.160.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,48],"terminalOffsetsZh":[0,16],"fullStemEn":"Classify the family coping cues from the record.","fullStemZh":"对病历中的家庭应对线索进行分类。","terminalSentenceEn":"Classify the family coping cues from the record.","terminalSentenceZh":"对病历中的家庭应对线索进行分类。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Client states, “I think my life is over.”","zh":"患者说：“我觉得我的人生完了。”"},{"id":"r2","en":"Spouse says, “I will handle all the decisions.”","zh":"配偶说：“我来做所有决定。”"},{"id":"r3","en":"Family has difficulty paying for fresh foods.","zh":"家庭难以负担新鲜食物。"},{"id":"r4","en":"Client denies thoughts of self-harm.","zh":"患者否认自伤想法。"},{"id":"r5","en":"Client prefers information in small sections.","zh":"患者希望信息分小段提供。"}],"columns":[{"id":"c1","en":"Coping concern","zh":"应对问题"},{"id":"c3","en":"Protective factor or preference","zh":"保护因素或偏好"},{"id":"c2","en":"Learning/resource need","zh":"学习/资源需求"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c3"]},{"rowId":"r5","columnIds":["c3"]}]},"rationaleCorrectEn":"The client’s catastrophic statement and the spouse’s plan to hide information suggest strained coping patterns. The diet and cost statements are learning/resource needs. Denial of self-harm and willingness to attend with the spouse are protective factors, while still requiring ongoing assessment.","rationaleCorrectZh":"患者灾难化表达和配偶隐藏信息的计划提示应对受压。饮食和费用陈述是学习/资源需求。否认自伤和愿意与配偶来诊是保护性因素，但仍需持续评估。","testTakingStrategyEn":"Do not treat a protective factor as “no problem”; it lowers risk but does not remove the need for assessment.","testTakingStrategyZh":"不要把保护因素等同于“没有问题”；它能降低风险，但不能取消评估需要。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1351,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_family_coping_chronic_diagnosis_08","embeddedQuestionId":"gpt_case_gap_2026_06_11_family_coping_part_3_sata_plan","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.160.caseStudy.questions.2","itemType":"select_all","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"hard","ngnSkill":"generate_solutions","stemPathEn":"questions.160.caseStudy.questions.2.stem.en","stemPathZh":"questions.160.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[73,95],"terminalOffsetsZh":[22,30],"fullStemEn":"Which nursing actions support family coping and realistic care planning? Select all that apply.","fullStemZh":"哪些护理措施能支持家庭应对和现实的照护计划？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which nursing actions support family coping and realistic care planning?","penultimateSentenceZh":"哪些护理措施能支持家庭应对和现实的照护计划？","responseContext":{"type":"select_all","options":[{"id":"E","en":"Tell the spouse to keep the diagnosis from the teenagers until the nurse decides they are ready.","zh":"告诉配偶在护士认为孩子准备好之前先隐瞒诊断。"},{"id":"D","en":"Coordinate renal dietitian and social-work referrals for food, insurance, and work concerns.","zh":"协调肾病营养师和社工转介，处理食物、保险和工作问题。"},{"id":"B","en":"Assess depression, anxiety, hopelessness, and safety in private and with support as appropriate.","zh":"在适当支持下并可私下评估抑郁、焦虑、绝望和安全情况。"},{"id":"F","en":"Delay education about treatment options until dialysis must begin immediately.","zh":"把治疗选择教育推迟到必须立即开始透析时。"},{"id":"C","en":"Teach one priority topic at a time and ask the client to explain it back.","zh":"一次只教一个重点主题，并请患者用自己的话说明。"},{"id":"A","en":"Ask the client whom they want included before discussing treatment options.","zh":"在讨论治疗选择前，询问患者希望谁参与。"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"Appropriate nursing actions preserve client autonomy, assess mood and safety, use the client’s preferred learning style, and connect the family with dietitian and social-work supports. Avoid secrecy, takeover decision-making, or delaying education until crisis.","rationaleCorrectZh":"适当护理措施应维护患者自主权，评估情绪和安全，使用患者偏好的学习方式，并连接营养师和社工支持。应避免保密式隐瞒、接管决策或把教育拖到危机时才做。","testTakingStrategyEn":"Select actions that increase capacity and choice; avoid actions that remove the client’s voice.","testTakingStrategyZh":"选择能增加能力和选择权的措施；避免剥夺患者声音的措施。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1352,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_family_coping_chronic_diagnosis_08","embeddedQuestionId":"gpt_case_gap_2026_06_11_family_coping_part_4_order_visit","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.160.caseStudy.questions.3","itemType":"ordered_response","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.160.caseStudy.questions.3.stem.en","stemPathZh":"questions.160.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,71],"terminalOffsetsZh":[0,23],"fullStemEn":"Place the nurse’s actions for this education visit in the safest order.","fullStemZh":"将护士在本次教育访视中的措施按最安全顺序排列。","terminalSentenceEn":"Place the nurse’s actions for this education visit in the safest order.","terminalSentenceZh":"将护士在本次教育访视中的措施按最安全顺序排列。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"ordered_response","options":[{"id":"A","en":"Ask the client what they understand about the diagnosis and what worries them most today.","zh":"询问患者对诊断的理解，以及今天最担心什么。"},{"id":"B","en":"Ask whom the client wants included before discussing treatment options.","zh":"在讨论治疗选择前，询问患者希望谁参与。"},{"id":"C","en":"Coordinate dietitian and social-work referrals for the stated food, work, and insurance concerns.","zh":"针对食物、工作和保险问题协调营养师和社工转介。"},{"id":"D","en":"Use teach-back to confirm the client can state the next appointment, one diet priority, and whom to call with questions.","zh":"使用回授法确认患者能说出下次预约、一个饮食重点和有疑问时联系谁。"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"The nurse first assesses what the client understands and feels, then clarifies desired family involvement, then addresses the most urgent barriers with referrals, and finally verifies the next steps using teach-back.","rationaleCorrectZh":"护士先评估患者理解和感受，再明确希望哪些家属参与，然后通过转介处理最紧迫障碍，最后用回授法确认下一步。","testTakingStrategyEn":"In psychosocial ordering items, assessment and consent usually come before education and referrals.","testTakingStrategyZh":"心理社会排序题中，评估和同意通常先于教育和转介。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1353,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_community_resource_discharge_05","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.161","itemType":"case_study","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"hard","ngnSkill":"generate_solutions","stemPathEn":"questions.161.stem.en","stemPathZh":"questions.161.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,199],"terminalOffsetsZh":[0,49],"fullStemEn":"Case study: community resources and safe discharge A client is medically ready for discharge, but the nurse identifies resource barriers that could prevent the client from following the plan at home.","fullStemZh":"病例：社区资源与安全出院 一名患者医学上已可出院，但护士发现资源障碍可能阻止患者在家执行护理计划。","terminalSentenceEn":"Case study: community resources and safe discharge A client is medically ready for discharge, but the nurse identifies resource barriers that could prevent the client from following the plan at home.","terminalSentenceZh":"病例：社区资源与安全出院 一名患者医学上已可出院，但护士发现资源障碍可能阻止患者在家执行护理计划。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This case focuses on nursing coordination for safe discharge: identifying resource barriers, matching referrals to needs, confirming services, and using teach-back so the plan can be carried out.","rationaleCorrectZh":"本病例关注安全出院中的护理协调：识别资源障碍，将转介匹配到需求，确认服务，并使用回授法确保计划可执行。","testTakingStrategyEn":"A discharge plan is only safe if the client can realistically carry it out after leaving.","testTakingStrategyZh":"只有患者离院后现实中能执行，出院计划才是安全的。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1354,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_community_resource_discharge_05","embeddedQuestionId":"gpt_case_gap_2026_06_11_community_resources_part_1_mc_priority","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.161.caseStudy.questions.0","itemType":"multiple_choice","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"hard","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.161.caseStudy.questions.0.stem.en","stemPathZh":"questions.161.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,60],"terminalOffsetsZh":[0,15],"fullStemEn":"Which issue is the priority barrier to safe discharge today?","fullStemZh":"今天安全出院的首要障碍是什么？","terminalSentenceEn":"Which issue is the priority barrier to safe discharge today?","terminalSentenceZh":"今天安全出院的首要障碍是什么？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"C","en":"The client has a longer medication list than before admission.","zh":"患者的用药清单比入院前更长。"},{"id":"A","en":"The client lacks reliable access to food, prescriptions, and transportation for follow-up.","zh":"患者缺乏可靠的食物、处方药和复诊交通。"},{"id":"D","en":"The follow-up appointment is scheduled for next week.","zh":"复诊预约安排在下周。"},{"id":"B","en":"The client prefers to live alone rather than move in with family.","zh":"患者更愿意独居，而不是搬去和家人住。"}],"correct":["A"]},"rationaleCorrectEn":"The priority barrier is that the client cannot reliably obtain food, prescriptions, and transportation for follow-up after discharge. These barriers directly threaten the discharge plan and require interdisciplinary coordination before discharge.","rationaleCorrectZh":"首要障碍是患者出院后无法可靠获得食物、处方药和复诊交通。这些障碍直接威胁出院计划，需要出院前跨专业协调。","testTakingStrategyEn":"A discharge is unsafe when the client cannot obtain the resources needed to follow the plan.","testTakingStrategyZh":"当患者无法获得执行计划所需资源时，出院就是不安全的。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1355,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_community_resource_discharge_05","embeddedQuestionId":"gpt_case_gap_2026_06_11_community_resources_part_2_matrix_referrals","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.161.caseStudy.questions.1","itemType":"matrix","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.161.caseStudy.questions.1.stem.en","stemPathZh":"questions.161.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,60],"terminalOffsetsZh":[0,18],"fullStemEn":"Match each barrier with the best referral or nursing action.","fullStemZh":"将每个障碍与最佳转介或护理措施匹配。","terminalSentenceEn":"Match each barrier with the best referral or nursing action.","terminalSentenceZh":"将每个障碍与最佳转介或护理措施匹配。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Refrigerator is nearly empty; client says food runs out near the end of each month.","zh":"冰箱几乎空了；患者说每到月底食物就不够。"},{"id":"r2","en":"Client has not picked up two prescriptions because the copay is unaffordable.","zh":"因自付费用负担不起，患者尚未领取两种处方药。"},{"id":"r3","en":"Client needs wound checks and reinforcement of walker safety at home.","zh":"患者回家后需要伤口检查并强化助行器安全。"},{"id":"r4","en":"Client missed a prior appointment because the bus route changed.","zh":"患者曾因公交路线改变而错过预约。"}],"columns":[{"id":"c1","en":"Food resource referral","zh":"食物资源转介"},{"id":"c2","en":"Pharmacy/financial assistance","zh":"药房/经济援助"},{"id":"c3","en":"Home-health referral","zh":"居家护理转介"},{"id":"c4","en":"Transportation coordination","zh":"交通协调"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c3"]},{"rowId":"r4","columnIds":["c4"]}]},"rationaleCorrectEn":"Food insecurity is addressed through food resources; inability to obtain prescriptions through pharmacy/financial assistance; mobility and wound-care needs through home health; transportation barriers through case management/social work. The nurse coordinates rather than trying to personally solve every resource gap alone.","rationaleCorrectZh":"食物不安全通过食物资源处理；无法取得处方药通过药房/经济援助处理；活动和伤口护理需求通过居家护理处理；交通障碍通过个案管理/社工处理。护士负责协调，而不是独自亲自解决每个资源缺口。","testTakingStrategyEn":"Match the service to the barrier shown in the exhibit.","testTakingStrategyZh":"将服务与记录中显示的障碍相匹配。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1356,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_community_resource_discharge_05","embeddedQuestionId":"gpt_case_gap_2026_06_11_community_resources_part_3_sata_actions","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.161.caseStudy.questions.2","itemType":"select_all","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.161.caseStudy.questions.2.stem.en","stemPathZh":"questions.161.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[54,76],"terminalOffsetsZh":[13,21],"fullStemEn":"Which actions should the nurse take before discharge? Select all that apply.","fullStemZh":"出院前护士应采取哪些措施？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which actions should the nurse take before discharge?","penultimateSentenceZh":"出院前护士应采取哪些措施？","responseContext":{"type":"select_all","options":[{"id":"B","en":"Confirm how the client will obtain prescribed medications today.","zh":"确认患者今天如何获得处方药。"},{"id":"F","en":"Arrange services without discussing them because the client may feel embarrassed.","zh":"因为患者可能尴尬，所以不讨论就直接安排服务。"},{"id":"E","en":"Discharge the client with a list of food pantries and advise the client to call when convenient.","zh":"给患者一份食物银行清单，并建议方便时自行致电。"},{"id":"A","en":"Request case-management/social-work involvement before discharge.","zh":"出院前请求个案管理/社工参与。"},{"id":"D","en":"Verify home-health referral acceptance and the expected first visit date.","zh":"确认居家护理转介已被接受，并了解预计首次访视日期。"},{"id":"C","en":"Use teach-back to review follow-up appointments, transportation, and when to call for help.","zh":"用回授法复习复诊、交通安排以及何时求助。"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"Safe discharge requires confirming concrete services, involving case management/social work, using teach-back, and checking that the client can obtain medications and attend follow-up. It is inappropriate to discharge with vague advice or to arrange services without client consent.","rationaleCorrectZh":"安全出院需要确认具体服务，邀请个案管理/社工参与，使用回授法，并检查患者能否获得药物和参加复诊。仅给笼统建议就出院或未经同意安排服务都不合适。","testTakingStrategyEn":"Concrete discharge safety means knowing who will do what, when, and how the client will access it.","testTakingStrategyZh":"具体的出院安全意味着明确谁做什么、什么时候做、患者如何获得。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1357,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_community_resource_discharge_05","embeddedQuestionId":"gpt_case_gap_2026_06_11_community_resources_part_4_order_discharge","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.161.caseStudy.questions.3","itemType":"ordered_response","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.161.caseStudy.questions.3.stem.en","stemPathZh":"questions.161.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,55],"terminalOffsetsZh":[0,15],"fullStemEn":"Place the discharge-planning actions in the best order.","fullStemZh":"将出院计划措施按最佳顺序排列。","terminalSentenceEn":"Place the discharge-planning actions in the best order.","terminalSentenceZh":"将出院计划措施按最佳顺序排列。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"ordered_response","options":[{"id":"B","en":"Notify case management/social work and the provider about barriers affecting discharge safety.","zh":"通知个案管理/社工和医护团队这些影响出院安全的障碍。"},{"id":"A","en":"Ask the client to describe food, transportation, medication, and home-support barriers and priorities.","zh":"请患者描述食物、交通、用药和居家支持方面的障碍及优先事项。"},{"id":"D","en":"Ask the client to explain the plan, warning signs, and whom to call if a service does not occur.","zh":"请患者说明计划、警示信号，以及若服务未落实应联系谁。"},{"id":"C","en":"Confirm medication access, transportation plan, food-resource connection, and home-health acceptance.","zh":"确认用药获得、交通计划、食物资源连接和居家护理接受情况。"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"The nurse first assesses the client's priorities and barriers, then involves the interprofessional team, confirms services and medication access, and finally verifies understanding with teach-back. This sequence avoids making assumptions or discharging before resources are real.","rationaleCorrectZh":"护士先评估患者的优先事项和障碍，然后让跨专业团队参与，确认服务和用药获得，最后用回授法确认理解。这个顺序避免假设，也避免在资源尚未落实前出院。","testTakingStrategyEn":"Do not teach a plan that has not been arranged yet; first make the plan real, then verify understanding.","testTakingStrategyZh":"不要教学尚未安排好的计划；先让计划落实，再确认理解。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1358,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_preventive_screening_navigation_06","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.162","itemType":"case_study","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"hard","ngnSkill":"generate_solutions","stemPathEn":"questions.162.stem.en","stemPathZh":"questions.162.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,190],"terminalOffsetsZh":[0,49],"fullStemEn":"Case study: adult preventive screening follow-up navigation A primary care clinic nurse reviews abnormal preventive screening results and identifies a client who has not completed follow-up.","fullStemZh":"病例：成人预防性筛查随访导航 初级保健门诊护士查看异常预防性筛查结果，并发现一名患者尚未完成随访。","terminalSentenceEn":"Case study: adult preventive screening follow-up navigation A primary care clinic nurse reviews abnormal preventive screening results and identifies a client who has not completed follow-up.","terminalSentenceZh":"病例：成人预防性筛查随访导航 初级保健门诊护士查看异常预防性筛查结果，并发现一名患者尚未完成随访。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This case emphasizes health-promotion nursing after an abnormal screening result: recognizing follow-up barriers, using language access and teach-back, engaging supports with permission, and confirming the next diagnostic step.","rationaleCorrectZh":"本病例强调异常筛查结果后的健康促进护理：识别随访障碍，使用语言服务和回授法，在取得同意后动员支持，并确认下一步诊断性处理。","testTakingStrategyEn":"For preventive screening, the nursing priority often begins after the result: making sure the client can complete appropriate follow-up.","testTakingStrategyZh":"对于预防性筛查，护理重点常常从结果出来后开始：确保患者能完成适当随访。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1359,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_preventive_screening_navigation_06","embeddedQuestionId":"gpt_case_gap_2026_06_11_screening_navigation_part_1_cloze_followup","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.162.caseStudy.questions.0","itemType":"dropdown_cloze","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.162.caseStudy.questions.0.stem.en","stemPathZh":"questions.162.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,48],"terminalOffsetsZh":[0,11],"fullStemEn":"Use the clinic record to complete the statement.","fullStemZh":"根据门诊记录完成句子。","terminalSentenceEn":"Use the clinic record to complete the statement.","terminalSentenceZh":"根据门诊记录完成句子。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse should prioritize {{1}} because the exhibit shows {{2}}.","zh":"护士应优先 {{1}}，因为记录显示 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"arranging diagnostic follow-up","zh":"安排诊断性随访"},{"id":"o3","en":"documenting refusal without further assessment","zh":"不再评估而记录拒绝"},{"id":"o2","en":"mailing another home stool test","zh":"再邮寄一个居家粪便测试"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"navigation barriers after an abnormal screening result","zh":"异常筛查结果后的就医导航障碍"},{"id":"o2","en":"complete understanding of the follow-up plan","zh":"已完全理解随访计划"},{"id":"o3","en":"no need for additional communication","zh":"不需要进一步沟通"}],"correct":"o1"}]},"rationaleCorrectEn":"A positive stool-based screening test is not treated by repeating the same home test; it requires diagnostic follow-up. The nurse should focus on navigation barriers such as scheduling, transportation, language access, and fear.","rationaleCorrectZh":"粪便筛查阳性不能通过重复同一居家测试来处理；需要诊断性随访。护士应关注预约、交通、语言服务和恐惧等导航障碍。","testTakingStrategyEn":"Screening questions often test follow-up systems, not just whether a test was ordered.","testTakingStrategyZh":"筛查题常考随访系统，而不只是是否开了检查。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1360,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_preventive_screening_navigation_06","embeddedQuestionId":"gpt_case_gap_2026_06_11_screening_navigation_part_2_matrix_barriers","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.162.caseStudy.questions.1","itemType":"matrix","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.162.caseStudy.questions.1.stem.en","stemPathZh":"questions.162.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,34],"terminalOffsetsZh":[0,14],"fullStemEn":"Classify each item from the chart.","fullStemZh":"对病历中的每项内容进行分类。","terminalSentenceEn":"Classify each item from the chart.","terminalSentenceZh":"对病历中的每项内容进行分类。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Home stool-based screening test returned positive.","zh":"居家粪便筛查结果阳性。"},{"id":"r2","en":"Client did not answer two unknown phone numbers from the clinic.","zh":"患者没有接听门诊两个陌生来电。"},{"id":"r3","en":"Client reads short English phrases but prefers health information in Spanish.","zh":"患者能阅读短英文短语，但更希望使用西班牙语获得健康信息。"},{"id":"r4","en":"Daughter can attend appointments if the client gives permission.","zh":"如果患者同意，女儿可以陪同就诊。"},{"id":"r5","en":"Client says, “I heard the follow-up test is painful, and I am scared.”","zh":"患者说：“我听说后续检查会痛，我很害怕。”"}],"columns":[{"id":"c1","en":"Abnormal result","zh":"异常结果"},{"id":"c3","en":"Potential support","zh":"潜在支持"},{"id":"c2","en":"Barrier to follow-up","zh":"随访障碍"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c3"]},{"rowId":"r5","columnIds":["c2"]}]},"rationaleCorrectEn":"A completed positive screening test is an abnormal result needing follow-up. Missed calls, limited English, transportation difficulty, and fear are barriers. A preference for the daughter to help can be a support if the client agrees.","rationaleCorrectZh":"已完成且阳性的筛查是需要随访的异常结果。错过电话、英语有限、交通困难和害怕是障碍。若患者同意，让女儿协助可成为支持。","testTakingStrategyEn":"Classify chart cues by whether they are the abnormal result, a barrier, or a support.","testTakingStrategyZh":"按异常结果、障碍或支持来分类病历线索。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1361,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_preventive_screening_navigation_06","embeddedQuestionId":"gpt_case_gap_2026_06_11_screening_navigation_part_3_fib_days","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.162.caseStudy.questions.2","itemType":"fill_in_blank","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.162.caseStudy.questions.2.stem.en","stemPathZh":"questions.162.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[173,195],"terminalOffsetsZh":[43,49],"fullStemEn":"The abnormal screening result was released on May 3. The diagnostic follow-up appointment is scheduled for May 20. How many days are between the result and the appointment? Enter the number only.","fullStemZh":"异常筛查结果于5月3日发布。诊断性随访预约在5月20日。结果发布与预约之间相隔多少天？只输入数字。","terminalSentenceEn":"Enter the number only.","terminalSentenceZh":"只输入数字。","penultimateSentenceEn":"How many days are between the result and the appointment?","penultimateSentenceZh":"结果发布与预约之间相隔多少天？","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"days","zh":"天"},"acceptable":["17","17 days"],"numeric":{"value":17,"tolerance":0,"unit":"days"}}]},"rationaleCorrectEn":"May 20 minus May 3 equals 17 days. Tracking the interval helps the clinic evaluate whether abnormal screening results receive timely follow-up.","rationaleCorrectZh":"5月20日减去5月3日等于17天。追踪这个间隔有助于门诊评估异常筛查结果是否得到及时随访。","testTakingStrategyEn":"For simple date-interval items, count elapsed days from the result date to the scheduled follow-up date.","testTakingStrategyZh":"简单日期间隔题中，从结果日期数到安排随访日期，计算经过的天数。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1362,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_preventive_screening_navigation_06","embeddedQuestionId":"gpt_case_gap_2026_06_11_screening_navigation_part_4_sata_navigation","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.162.caseStudy.questions.3","itemType":"select_all","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"hard","ngnSkill":"generate_solutions","stemPathEn":"questions.162.caseStudy.questions.3.stem.en","stemPathZh":"questions.162.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[60,82],"terminalOffsetsZh":[15,23],"fullStemEn":"Which nursing actions best support completion of follow-up? Select all that apply.","fullStemZh":"哪些护理措施最能支持完成随访？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which nursing actions best support completion of follow-up?","penultimateSentenceZh":"哪些护理措施最能支持完成随访？","responseContext":{"type":"select_all","options":[{"id":"A","en":"Explain in plain language that an abnormal screening result needs diagnostic follow-up.","zh":"用通俗语言解释异常筛查结果需要诊断性随访。"},{"id":"E","en":"Send another home stool test first because the client is afraid.","zh":"因为患者害怕，先再寄一个居家粪便测试。"},{"id":"D","en":"Ask the client whether the daughter may help with scheduling and transportation.","zh":"询问患者是否允许女儿协助预约和交通。"},{"id":"F","en":"Confirm the appointment date, transportation plan, and a number to call if the ride falls through.","zh":"确认预约日期、交通计划，以及交通无法落实时可拨打的电话。"},{"id":"B","en":"Offer qualified interpreter services for health information and scheduling.","zh":"为健康信息和预约安排提供合格口译服务。"},{"id":"C","en":"Ask what the client has heard about the test and what worries them most.","zh":"询问患者听说过哪些关于检查的信息，以及最担心什么。"}],"correct":["A","B","C","D","F"]},"rationaleCorrectEn":"The nurse should explain the abnormal result in plain language, use qualified interpreter services if needed, assess concerns, obtain permission before involving family, confirm scheduling and transportation, and provide clear call-back instructions. Repeating the screening test, using family as an interpreter by default, or documenting refusal without assessment undermines follow-up.","rationaleCorrectZh":"护士应使用通俗语言解释异常结果，必要时使用合格口译服务，评估顾虑，在家属参与前取得同意，确认预约和交通，并提供清楚的回电说明。重复筛查、默认让家属当口译或不评估就记录拒绝都会削弱随访。","testTakingStrategyEn":"Navigation actions remove barriers between an abnormal result and the next appropriate step.","testTakingStrategyZh":"导航措施的作用是消除异常结果和下一步适当处理之间的障碍。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1363,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_rehab_mobility_falls_03","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.163","itemType":"case_study","category":"Basic Care and Comfort","topic":"Mobility & Immobility","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.163.stem.en","stemPathZh":"questions.163.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[153,212],"terminalOffsetsZh":[36,51],"fullStemEn":"Case study: rehabilitation mobility progression after hip fracture An older adult is on an inpatient rehabilitation unit after repair of a hip fracture. The focus is safe mobility progression and fall prevention.","fullStemZh":"病例：髋部骨折后康复活动进展 一名老年患者髋部骨折修复后在住院康复病区。重点是安全活动进展和跌倒预防。","terminalSentenceEn":"The focus is safe mobility progression and fall prevention.","terminalSentenceZh":"重点是安全活动进展和跌倒预防。","penultimateSentenceEn":"Case study: rehabilitation mobility progression after hip fracture An older adult is on an inpatient rehabilitation unit after repair of a hip fracture.","penultimateSentenceZh":"病例：髋部骨折后康复活动进展 一名老年患者髋部骨折修复后在住院康复病区。","responseContext":{},"rationaleCorrectEn":"This case tests safe mobility sequencing, fall-risk cue recognition, realistic rehabilitation progression, and teaching that preserves mobility instead of using immobilization as fall prevention.","rationaleCorrectZh":"本病例考查安全活动顺序、跌倒风险线索识别、现实可行的康复进展，以及保留活动能力的跌倒预防教学，而不是用不活动来预防跌倒。","testTakingStrategyEn":"In rehab cases, the safest answer usually supports graded mobility with assistance, not bedrest.","testTakingStrategyZh":"康复病例中，最安全答案通常是有协助的分级活动，而不是卧床。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1364,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_rehab_mobility_falls_03","embeddedQuestionId":"gpt_case_gap_2026_06_11_rehab_fall_part_1_order_mobility","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.163.caseStudy.questions.0","itemType":"ordered_response","category":"Basic Care and Comfort","topic":"Mobility & Immobility","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.163.caseStudy.questions.0.stem.en","stemPathZh":"questions.163.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,84],"terminalOffsetsZh":[0,24],"fullStemEn":"Place the nursing actions in the safest order for the first assisted transfer today.","fullStemZh":"将今天首次协助转移时的护理措施按最安全顺序排列。","terminalSentenceEn":"Place the nursing actions in the safest order for the first assisted transfer today.","terminalSentenceZh":"将今天首次协助转移时的护理措施按最安全顺序排列。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"ordered_response","options":[{"id":"D","en":"Apply the gait belt snugly over clothing while the client is sitting upright.","zh":"患者坐直后，在衣服外贴合地系好步态带。"},{"id":"B","en":"Clear the path, lock the bed and wheelchair, place nonskid footwear, and position the walker.","zh":"清理通道，锁定床和轮椅，穿防滑鞋，并放好助行器。"},{"id":"E","en":"Use the gait belt and walker to assist the client to stand and pivot to the chair.","zh":"使用步态带和助行器，协助患者站立并转身坐到椅子上。"},{"id":"A","en":"Review the activity order, pain level, recent analgesic timing, and dizziness history.","zh":"查看活动医嘱、疼痛程度、近期镇痛药时间和头晕史。"},{"id":"C","en":"Assist the client to sit at the bedside and assess dizziness before standing.","zh":"协助患者坐在床边，并在站立前评估是否头晕。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"Before mobility, the nurse reviews activity orders and pain/orthostatic risk, prepares the environment and assistive devices, has the client sit and assess dizziness, then applies the gait belt and transfers with assistance.","rationaleCorrectZh":"活动前护士应先查看活动医嘱并评估疼痛/体位性风险，准备环境和辅助器具，让患者坐起并评估头晕，然后使用步态带并在协助下转移。","testTakingStrategyEn":"For transfer sequences, assess and prepare first; do not pull a weak client upright before checking dizziness and safety equipment.","testTakingStrategyZh":"转移排序题中先评估和准备；不要在评估头晕和安全设备前把虚弱患者拉起。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1365,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_rehab_mobility_falls_03","embeddedQuestionId":"gpt_case_gap_2026_06_11_rehab_fall_part_2_matrix_plan","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.163.caseStudy.questions.1","itemType":"matrix","category":"Basic Care and Comfort","topic":"Sleep & Rest","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.163.caseStudy.questions.1.stem.en","stemPathZh":"questions.163.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,87],"terminalOffsetsZh":[0,25],"fullStemEn":"For each proposed care-plan item, select whether it supports safe mobility progression.","fullStemZh":"针对每项拟定护理计划，选择其是否支持安全活动进展。","terminalSentenceEn":"For each proposed care-plan item, select whether it supports safe mobility progression.","terminalSentenceZh":"针对每项拟定护理计划，选择其是否支持安全活动进展。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Ambulate with walker and one-person assist before meals and at bedtime as tolerated.","zh":"耐受情况下，餐前和睡前使用助行器并由一人协助步行。"},{"id":"r2","en":"Keep the client in bed except for therapy sessions to avoid falls.","zh":"除治疗时段外让患者留在床上，以避免跌倒。"},{"id":"r3","en":"Coordinate pain medication so the client can participate in therapy while monitoring sedation.","zh":"协调疼痛用药，使患者能参与治疗，同时监测镇静。"},{"id":"r4","en":"Use a bedside commode with staff assist overnight because urgency occurs after diuretic use.","zh":"因使用利尿剂后出现尿急，夜间在工作人员协助下使用床旁便器。"},{"id":"r5","en":"Raise all four side rails whenever the client is alone.","zh":"患者独处时始终升起四侧床栏。"}],"columns":[{"id":"c1","en":"Supports safe progression","zh":"支持安全进展"},{"id":"c2","en":"Revise plan","zh":"需修改计划"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c1"]},{"rowId":"r5","columnIds":["c2"]}]},"rationaleCorrectEn":"Safe progression uses scheduled assistance, pain control, proper assistive devices, and call-light reinforcement. Restraint-like strategies and avoidance of all mobility increase harm.","rationaleCorrectZh":"安全进展包括安排协助、疼痛控制、正确使用辅助器具和强化呼叫铃。类似约束的做法以及完全避免活动会增加伤害。","testTakingStrategyEn":"Fall prevention should preserve mobility while reducing risk; immobilizing the client is not rehabilitation.","testTakingStrategyZh":"跌倒预防应在降低风险的同时保留活动能力；让患者不动不是康复。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1366,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_rehab_mobility_falls_03","embeddedQuestionId":"gpt_case_gap_2026_06_11_rehab_fall_part_3_cloze_risk","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.163.caseStudy.questions.2","itemType":"dropdown_cloze","category":"Basic Care and Comfort","topic":"Mobility & Immobility","difficulty":"hard","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.163.caseStudy.questions.2.stem.en","stemPathZh":"questions.163.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,56],"terminalOffsetsZh":[0,11],"fullStemEn":"Use the rehabilitation record to complete the statement.","fullStemZh":"根据康复记录完成句子。","terminalSentenceEn":"Use the rehabilitation record to complete the statement.","terminalSentenceZh":"根据康复记录完成句子。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The client is at highest risk for {{1}} related to {{2}}.","zh":"患者最高风险是 {{1}}，与 {{2}} 有关。"},"dropdowns":[{"id":"1","options":[{"id":"o3","en":"infection transmission","zh":"感染传播"},{"id":"o2","en":"social isolation","zh":"社会隔离"},{"id":"o1","en":"fall injury","zh":"跌倒伤害"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"refusal to eat breakfast","zh":"拒绝吃早餐"},{"id":"o3","en":"lack of family visits during therapy","zh":"治疗期间家属未探视"},{"id":"o1","en":"unassisted toileting after urgency","zh":"尿急后无人协助如厕"}],"correct":"o1"}]},"rationaleCorrectEn":"The client is most at risk for a fall during unassisted toileting because the record shows urgency after diuretic use, attempts to stand without calling, dizziness, and weak gait.","rationaleCorrectZh":"患者最容易在无人协助如厕时跌倒，因为记录显示利尿剂后尿急、试图不呼叫就站起、头晕和步态无力。","testTakingStrategyEn":"For risk statements, match the outcome to the strongest pattern of cues, not to a diagnosis label alone.","testTakingStrategyZh":"完成风险句时，将结局与最强线索模式匹配，而不是只看诊断标签。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1367,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_rehab_mobility_falls_03","embeddedQuestionId":"gpt_case_gap_2026_06_11_rehab_fall_part_4_sata_teaching","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.163.caseStudy.questions.3","itemType":"select_all","category":"Basic Care and Comfort","topic":"Mobility & Immobility","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.163.caseStudy.questions.3.stem.en","stemPathZh":"questions.163.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[83,105],"terminalOffsetsZh":[16,24],"fullStemEn":"Which statements by the client indicate understanding of fall-prevention teaching? Select all that apply.","fullStemZh":"患者哪些话表明理解跌倒预防教学？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which statements by the client indicate understanding of fall-prevention teaching?","penultimateSentenceZh":"患者哪些话表明理解跌倒预防教学？","responseContext":{"type":"select_all","options":[{"id":"E","en":"“At home, I can hold on to furniture instead of using the walker.”","zh":"“回家后我可以扶家具，不一定要用助行器。”"},{"id":"D","en":"“I will sit at the bedside and tell staff if I feel dizzy before walking.”","zh":"“走路前我会坐在床边，如果头晕会告诉工作人员。”"},{"id":"C","en":"“I should wear the nonskid socks and use the walker every time I get up.”","zh":"“每次起身都应穿防滑袜并使用助行器。”"},{"id":"A","en":"“I will press the call light before I stand, even if I only need the bathroom.”","zh":"“即使只是要上厕所，我站起来前也会按呼叫铃。”"},{"id":"F","en":"“I will keep my phone, water, and call light where I can reach them.”","zh":"“我会把手机、水和呼叫铃放在伸手可及的地方。”"},{"id":"B","en":"“If I feel embarrassed asking for help, I will move quickly so I do not bother anyone.”","zh":"“如果我不好意思求助，我会快点走，免得麻烦别人。”"}],"correct":["A","C","D","F"]},"rationaleCorrectEn":"Effective teaching includes calling before standing, using nonskid footwear and the walker, pausing for dizziness, and keeping needed items within reach. Rushing to the bathroom or using furniture instead of the walker is unsafe.","rationaleCorrectZh":"有效教学包括站起前呼叫、使用防滑鞋和助行器、头晕时暂停，以及把需要物品放在伸手可及处。急着去厕所或扶家具代替助行器是不安全的。","testTakingStrategyEn":"Look for teaching statements that change the exact unsafe behavior shown in the exhibit.","testTakingStrategyZh":"寻找能改变记录中具体不安全行为的教学表述。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1368,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_pressure_injury_ltc_04","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.164","itemType":"case_study","category":"Safety and Infection Prevention and Control","topic":"Skin & Wound Care","difficulty":"hard","ngnSkill":"generate_solutions","stemPathEn":"questions.164.stem.en","stemPathZh":"questions.164.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[129,192],"terminalOffsetsZh":[39,58],"fullStemEn":"Case study: pressure injury prevention in long-term care A resident in long-term care has multiple pressure-injury risk factors. The nurse updates the prevention plan after a skin-risk huddle.","fullStemZh":"病例：长期照护中的压力性损伤预防 一名长期照护住民存在多项压力性损伤风险因素。护士在皮肤风险小组讨论后更新预防计划。","terminalSentenceEn":"The nurse updates the prevention plan after a skin-risk huddle.","terminalSentenceZh":"护士在皮肤风险小组讨论后更新预防计划。","penultimateSentenceEn":"Case study: pressure injury prevention in long-term care A resident in long-term care has multiple pressure-injury risk factors.","penultimateSentenceZh":"病例：长期照护中的压力性损伤预防 一名长期照护住民存在多项压力性损伤风险因素。","responseContext":{},"rationaleCorrectEn":"This case emphasizes pressure-injury prevention by connecting risk cues to individualized pressure relief, moisture management, nutrition support, delegation boundaries, and outcome evaluation.","rationaleCorrectZh":"本病例强调通过将风险线索与个体化减压、潮湿管理、营养支持、委托边界和结果评估相连接来预防压力性损伤。","testTakingStrategyEn":"Pressure-injury questions are usually safer when you target risk drivers rather than memorize one turning interval for every client.","testTakingStrategyZh":"压力性损伤题通常应针对风险来源，而不是死记每位患者都用同一个翻身间隔。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1369,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_pressure_injury_ltc_04","embeddedQuestionId":"gpt_case_gap_2026_06_11_pressure_ltc_part_1_matrix_risk","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.164.caseStudy.questions.0","itemType":"matrix","category":"Safety and Infection Prevention and Control","topic":"Skin & Wound Care","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.164.caseStudy.questions.0.stem.en","stemPathZh":"questions.164.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,74],"terminalOffsetsZh":[0,22],"fullStemEn":"For each finding, select the prevention concern it most directly supports.","fullStemZh":"针对每项发现，选择其最直接支持的预防关注点。","terminalSentenceEn":"For each finding, select the prevention concern it most directly supports.","terminalSentenceZh":"针对每项发现，选择其最直接支持的预防关注点。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Resident cannot reposition independently in bed.","zh":"住民不能在床上独立变换体位。"},{"id":"r2","en":"Brief is wet; loose stool noted near sacrum.","zh":"尿布潮湿；骶尾部附近有稀便。"},{"id":"r3","en":"Ate 25% of meals yesterday and drank little fluid.","zh":"昨日进食约25%，饮水少。"},{"id":"r4","en":"Both heels rest directly on the mattress.","zh":"双足跟直接压在床垫上。"},{"id":"r5","en":"Sacral redness blanches when gently pressed.","zh":"轻压骶尾部发红处可褪色。"}],"columns":[{"id":"c3","en":"Nutrition/hydration","zh":"营养/水分"},{"id":"c2","en":"Moisture/skin protection","zh":"潮湿/皮肤保护"},{"id":"c1","en":"Pressure/mobility","zh":"压力/活动能力"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c3"]},{"rowId":"r4","columnIds":["c1"]},{"rowId":"r5","columnIds":["c1"]}]},"rationaleCorrectEn":"Immobility and heel pressure require offloading and repositioning; moisture requires incontinence care and barrier protection; low intake requires nutrition/hydration support; blanchable redness requires pressure relief and monitoring, not staging as an open injury.","rationaleCorrectZh":"活动受限和足跟受压需要减压和重新摆位；潮湿需要失禁护理和屏障保护；摄入不足需要营养/水分支持；可褪色红斑需要减压和监测，不应分期为开放性损伤。","testTakingStrategyEn":"Pressure-injury prevention starts by naming the risk driver: pressure, shear, moisture, nutrition, or mobility.","testTakingStrategyZh":"压力性损伤预防要先说清风险来源：压力、剪切力、潮湿、营养或活动能力。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1370,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_pressure_injury_ltc_04","embeddedQuestionId":"gpt_case_gap_2026_06_11_pressure_ltc_part_2_sata_plan","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.164.caseStudy.questions.1","itemType":"select_all","category":"Safety and Infection Prevention and Control","topic":"Skin & Wound Care","difficulty":"hard","ngnSkill":"generate_solutions","stemPathEn":"questions.164.caseStudy.questions.1.stem.en","stemPathZh":"questions.164.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[69,91],"terminalOffsetsZh":[15,23],"fullStemEn":"Which interventions should the nurse include in the prevention plan? Select all that apply.","fullStemZh":"护士应将哪些干预纳入预防计划？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which interventions should the nurse include in the prevention plan?","penultimateSentenceZh":"护士应将哪些干预纳入预防计划？","responseContext":{"type":"select_all","options":[{"id":"F","en":"Consult the dietitian for poor intake and protein/calorie needs.","zh":"因摄入不足和蛋白质/热量需求咨询营养师。"},{"id":"C","en":"Provide prompt incontinence care and apply moisture-barrier product as ordered or per protocol.","zh":"及时进行失禁护理，并按医嘱或流程使用皮肤屏障产品。"},{"id":"E","en":"Massage reddened areas over bony prominences each shift.","zh":"每班按摩骨突处发红区域。"},{"id":"B","en":"Offload the heels so they do not rest directly on the mattress.","zh":"足跟减压，使其不直接压在床垫上。"},{"id":"D","en":"Request evaluation for a pressure-redistribution mattress or overlay.","zh":"申请评估是否需要减压床垫或床垫覆盖层。"},{"id":"A","en":"Create an individualized repositioning schedule based on skin tolerance, support surface, and mobility.","zh":"根据皮肤耐受性、支撑面和活动能力制定个体化重新摆位计划。"}],"correct":["A","B","C","D","F"]},"rationaleCorrectEn":"The plan should individualize repositioning, offload heels, manage moisture promptly, use a pressure-redistribution surface as indicated, and consult dietary support. Massage, donut cushions, and delaying incontinence care increase harm.","rationaleCorrectZh":"计划应个体化重新摆位、足跟减压、及时管理潮湿、按需使用减压支撑面并咨询营养支持。按摩、甜甜圈坐垫和延迟失禁护理会增加伤害。","testTakingStrategyEn":"Choose interventions that reduce pressure, shear, moisture, and nutrition risk without damaging tissue.","testTakingStrategyZh":"选择能降低压力、剪切力、潮湿和营养风险且不会损伤组织的干预。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1371,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_pressure_injury_ltc_04","embeddedQuestionId":"gpt_case_gap_2026_06_11_pressure_ltc_part_3_mc_delegate","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.164.caseStudy.questions.2","itemType":"multiple_choice","category":"Safety and Infection Prevention and Control","topic":"Skin & Wound Care","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.164.caseStudy.questions.2.stem.en","stemPathZh":"questions.164.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,93],"terminalOffsetsZh":[0,24],"fullStemEn":"Which task is appropriate for the nurse to delegate to assistive personnel for this resident?","fullStemZh":"对于该住民，护士可将哪项任务适当委托给辅助人员？","terminalSentenceEn":"Which task is appropriate for the nurse to delegate to assistive personnel for this resident?","terminalSentenceZh":"对于该住民，护士可将哪项任务适当委托给辅助人员？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"D","en":"Choose which pressure-redistribution surface the resident should receive.","zh":"决定住民应使用哪种减压支撑面。"},{"id":"C","en":"Revise the repositioning frequency based on the resident's skin assessment.","zh":"根据住民皮肤评估修改重新摆位频率。"},{"id":"B","en":"Determine whether the sacral redness is a stage 1 pressure injury.","zh":"判断骶尾部发红是否为1期压力性损伤。"},{"id":"A","en":"Reposition the resident according to the posted plan and report any new redness or pain.","zh":"按张贴的计划帮助住民重新摆位，并报告任何新的发红或疼痛。"}],"correct":["A"]},"rationaleCorrectEn":"Assistive personnel can perform routine repositioning and report skin changes after the nurse establishes the plan. The nurse retains responsibility for assessment, staging, care-plan revision, and clinical referrals.","rationaleCorrectZh":"在护士制定计划后，辅助人员可执行常规重新摆位并报告皮肤变化。护士仍负责评估、分期、修改护理计划和临床转介。","testTakingStrategyEn":"Delegate tasks, not assessment or care-plan judgment.","testTakingStrategyZh":"委托的是任务，而不是评估或护理计划判断。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1372,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_pressure_injury_ltc_04","embeddedQuestionId":"gpt_case_gap_2026_06_11_pressure_ltc_part_4_cloze_outcome","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.164.caseStudy.questions.3","itemType":"dropdown_cloze","category":"Safety and Infection Prevention and Control","topic":"Skin & Wound Care","difficulty":"hard","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.164.caseStudy.questions.3.stem.en","stemPathZh":"questions.164.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,44],"terminalOffsetsZh":[0,13],"fullStemEn":"Use the 48-hour update to evaluate the plan.","fullStemZh":"根据48小时更新评估计划。","terminalSentenceEn":"Use the 48-hour update to evaluate the plan.","terminalSentenceZh":"根据48小时更新评估计划。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The 48-hour update suggests {{1}}, so the nurse should {{2}}.","zh":"48小时更新提示 {{1}}，因此护士应 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o3","en":"need for strict bedrest","zh":"需要严格卧床"},{"id":"o2","en":"confirmed wound infection","zh":"已确认伤口感染"},{"id":"o1","en":"improving skin tolerance","zh":"皮肤耐受性改善"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"continue the prevention plan and reassess skin each shift","zh":"继续预防计划并每班重新评估皮肤"},{"id":"o2","en":"stop repositioning because redness has improved","zh":"因发红改善而停止重新摆位"},{"id":"o3","en":"massage the sacrum to increase circulation","zh":"按摩骶尾部以增加循环"}],"correct":"o1"}]},"rationaleCorrectEn":"Less moisture exposure and redness that resolves after pressure relief suggest the prevention plan is improving skin tolerance. Nonblanchable redness, open skin, or worsening pain would require prompt reassessment.","rationaleCorrectZh":"潮湿暴露减少且减压后红斑消退，提示预防计划改善了皮肤耐受性。不可褪色红斑、皮肤破损或疼痛加重则需要及时重新评估。","testTakingStrategyEn":"Evaluate outcomes by comparing the newest skin findings with the original risk cues.","testTakingStrategyZh":"评估结果时，将最新皮肤发现与原始风险线索比较。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1373,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_10_b_or_interpreter_discharge_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.165","itemType":"ordered_response","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.165.stem.en","stemPathZh":"questions.165.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[127,171],"terminalOffsetsZh":[37,51],"fullStemEn":"A nurse is preparing discharge teaching for a client who speaks limited English and will manage a new low-sodium diet at home. Place the nursing actions in the best order.","fullStemZh":"护士准备为一名英语能力有限、出院后需要在家执行低钠饮食的患者进行出院宣教。请将护理措施按最佳顺序排列。","terminalSentenceEn":"Place the nursing actions in the best order.","terminalSentenceZh":"请将护理措施按最佳顺序排列。","penultimateSentenceEn":"A nurse is preparing discharge teaching for a client who speaks limited English and will manage a new low-sodium diet at home.","penultimateSentenceZh":"护士准备为一名英语能力有限、出院后需要在家执行低钠饮食的患者进行出院宣教。","responseContext":{"type":"ordered_response","options":[{"id":"C","en":"Use plain-language instructions and show the client how to read sodium amounts on a food label.","zh":"使用通俗语言说明，并示范如何查看食品标签上的钠含量。"},{"id":"B","en":"Arrange for a qualified medical interpreter before giving diet instructions.","zh":"在进行饮食指导前安排合格的医疗口译员。"},{"id":"E","en":"Document the teaching method, interpreter use, and any remaining learning needs.","zh":"记录宣教方法、口译员使用情况以及仍需学习的内容。"},{"id":"D","en":"Ask the client to explain in their own words how they will choose lower-sodium foods at home.","zh":"请患者用自己的话说明在家如何选择低钠食物。"},{"id":"A","en":"Determine the client's preferred language and ask what written format is easiest to use.","zh":"确认患者偏好的语言，并询问哪种书面格式最容易使用。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"The nurse first assesses language and literacy needs, then uses a qualified interpreter, teaches with plain language and demonstration, verifies understanding with teach-back, and documents the outcome and remaining needs.","rationaleCorrectZh":"护士应先评估语言与读写需求，然后使用合格口译员，以通俗语言和示范进行宣教，再用回授法确认理解，最后记录结果和仍需学习的内容。","testTakingStrategyEn":"For discharge-teaching sequences, use the nursing process: assess, support communication, teach, evaluate understanding, then document.","testTakingStrategyZh":"遇到出院宣教排序题，按护理程序思考：先评估，再支持沟通，然后宣教、评价理解，最后记录。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1374,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_10_b_or_dementia_caregiver_strain_02","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.166","itemType":"ordered_response","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"medium","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.166.stem.en","stemPathZh":"questions.166.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[190,236],"terminalOffsetsZh":[55,70],"fullStemEn":"A spouse caring for a client with dementia says, \"I have not slept more than 3 hours a night, and yesterday I yelled because I could not take it anymore.\" The client is clean and uninjured. Place the nurse's responses in the best order.","fullStemZh":"一名照护失智症患者的配偶说：\"我每晚睡不到3小时，昨天我忍不住大吼，因为真的撑不下去了。\"患者清洁且没有受伤。请将护士的回应按最佳顺序排列。","terminalSentenceEn":"Place the nurse's responses in the best order.","terminalSentenceZh":"请将护士的回应按最佳顺序排列。","penultimateSentenceEn":"The client is clean and uninjured.","penultimateSentenceZh":"患者清洁且没有受伤。","responseContext":{"type":"ordered_response","options":[{"id":"B","en":"Acknowledge the caregiver's exhaustion without judgment.","zh":"不带评判地肯定照护者的疲惫感。"},{"id":"E","en":"Create a written crisis plan with contacts to use if the caregiver feels unsafe or unable to continue care.","zh":"制定书面的危机计划，列出照护者感到不安全或无法继续照护时可联系的对象。"},{"id":"D","en":"Collaborate with the case manager or social worker to arrange respite and dementia-care resources.","zh":"与个案管理师或社工合作，安排喘息服务和失智照护资源。"},{"id":"A","en":"Assess immediate safety, including whether the caregiver fears harming self or the client.","zh":"评估当前安全，包括照护者是否担心会伤害自己或患者。"},{"id":"C","en":"Ask what support the family currently has and what tasks feel most overwhelming.","zh":"询问家庭目前有哪些支持，以及哪些照护任务最让人难以承受。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"Safety is assessed first because caregiver exhaustion can escalate to harm. The nurse then validates feelings, gathers more data about supports and burdens, activates resources, and leaves the family with a concrete crisis plan.","rationaleCorrectZh":"由于照护者过度疲惫可能升级为伤害风险，首先评估安全。随后护士应接纳其感受，进一步了解支持和负担，启动资源，并为家庭留下具体危机计划。","testTakingStrategyEn":"When emotional distress includes possible loss of control, assess safety before offering reassurance or routine referrals.","testTakingStrategyZh":"当情绪困扰伴随可能失控时，应先评估安全，再提供安慰或常规转介。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1375,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_10_b_or_wheelchair_transfer_03","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.167","itemType":"ordered_response","category":"Basic Care and Comfort","topic":"Sleep & Rest","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.167.stem.en","stemPathZh":"questions.167.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[146,192],"terminalOffsetsZh":[36,51],"fullStemEn":"A client in rehabilitation can bear partial weight on the right leg and is ready to transfer from a wheelchair to the bed with one-person assist. Place the nursing actions in the safest order.","fullStemZh":"一名康复期患者右腿可部分负重，准备在一名工作人员协助下从轮椅转移到床上。请将护理措施按最安全顺序排列。","terminalSentenceEn":"Place the nursing actions in the safest order.","terminalSentenceZh":"请将护理措施按最安全顺序排列。","penultimateSentenceEn":"A client in rehabilitation can bear partial weight on the right leg and is ready to transfer from a wheelchair to the bed with one-person assist.","penultimateSentenceZh":"一名康复期患者右腿可部分负重，准备在一名工作人员协助下从轮椅转移到床上。","responseContext":{"type":"ordered_response","options":[{"id":"B","en":"Lock the wheelchair brakes, move footrests out of the way, and ensure the client is wearing nonskid footwear.","zh":"锁定轮椅刹车，移开脚踏板，并确认患者穿防滑鞋。"},{"id":"D","en":"Ask the client to push from the wheelchair armrests while the nurse stabilizes the gait belt.","zh":"请患者从轮椅扶手用力撑起，同时护士稳定步态带。"},{"id":"C","en":"Apply the gait belt snugly around the client's waist while the client is sitting upright.","zh":"在患者坐直时，将步态带贴合地系在腰部。"},{"id":"E","en":"Pivot toward the bed, help the client sit, and check alignment before removing the gait belt.","zh":"向床的方向转身，协助患者坐下，并在取下步态带前检查身体对齐。"},{"id":"A","en":"Position the wheelchair at a slight angle next to the bed on the client's stronger side.","zh":"将轮椅以轻微角度放在床旁、靠近患者较有力的一侧。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"Safe transfer begins with positioning equipment, then securing the environment and footwear. The gait belt is applied while the client is sitting upright, the client pushes from the armrests rather than pulling on the nurse, and the nurse assists the pivot and sitting alignment before removing support.","rationaleCorrectZh":"安全转移先从设备摆位开始，再固定环境并确保防滑鞋。步态带应在患者坐直时系好，患者应从扶手撑起而不是拉护士，护士协助转身和坐下对齐后再取下支撑。","testTakingStrategyEn":"For transfer questions, secure the environment before the client stands and remove support only after the client is safely positioned.","testTakingStrategyZh":"遇到转移题，先固定环境再让患者站立；只有患者安全就位后才移除支撑。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1376,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_10_b_or_moisture_pressure_prevention_04","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.168","itemType":"ordered_response","category":"Safety and Infection Prevention and Control","topic":"Skin & Wound Care","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.168.stem.en","stemPathZh":"questions.168.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[155,225],"terminalOffsetsZh":[40,60],"fullStemEn":"An older adult in a rehabilitation facility is incontinent of urine, spends most of the day in bed, and has intact but reddened sacral skin that blanches. Place the nurse's preventive actions in the best order for this shift.","fullStemZh":"一名康复机构中的老年患者有尿失禁，大部分时间卧床，骶尾部皮肤完整但发红且可褪色。请将本班次护士的预防措施按最佳顺序排列。","terminalSentenceEn":"Place the nurse's preventive actions in the best order for this shift.","terminalSentenceZh":"请将本班次护士的预防措施按最佳顺序排列。","penultimateSentenceEn":"An older adult in a rehabilitation facility is incontinent of urine, spends most of the day in bed, and has intact but reddened sacral skin that blanches.","penultimateSentenceZh":"一名康复机构中的老年患者有尿失禁，大部分时间卧床，骶尾部皮肤完整但发红且可褪色。","responseContext":{"type":"ordered_response","options":[{"id":"E","en":"Update the care plan with the turning schedule and skin findings to report.","zh":"更新护理计划，写明翻身时间表和需要报告的皮肤发现。"},{"id":"A","en":"Assess the sacrum, heels, and skin folds and note whether redness blanches.","zh":"评估骶尾部、足跟和皮肤皱褶处，并记录红斑是否可褪色。"},{"id":"B","en":"Cleanse the skin promptly after incontinence using a gentle cleanser.","zh":"失禁后立即使用温和清洁剂清洁皮肤。"},{"id":"D","en":"Reposition using pillows or wedges to offload the sacrum and heels.","zh":"使用枕头或楔形垫重新摆位，以减轻骶尾部和足跟受压。"},{"id":"C","en":"Apply a moisture-barrier product to areas exposed to urine.","zh":"在暴露于尿液的部位涂抹防潮屏障产品。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"The nurse assesses first, then removes moisture and protects skin, then offloads pressure, and finally updates the care plan so prevention is consistent across caregivers and shifts.","rationaleCorrectZh":"护士先评估，然后清除潮湿并保护皮肤，再减轻压力，最后更新护理计划，使不同照护者和班次都能持续预防。","testTakingStrategyEn":"For skin-prevention sequences, assess first, remove the cause of irritation, protect the skin, reduce pressure, and communicate the plan.","testTakingStrategyZh":"皮肤预防排序题可按：先评估、去除刺激原因、保护皮肤、减轻压力、沟通计划。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1377,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_10_b_or_transport_food_resources_05","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.169","itemType":"ordered_response","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.169.stem.en","stemPathZh":"questions.169.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[184,228],"terminalOffsetsZh":[50,65],"fullStemEn":"A client with limited income is being discharged after rehabilitation. The client says, \"I missed therapy appointments before because I had no ride, and some weeks I run out of food.\" Place the nurse's actions in the best order.","fullStemZh":"一名收入有限的患者康复后准备出院。患者说：\"我以前因为没有车去而错过治疗预约，有些星期还会没饭吃。\"请将护士的措施按最佳顺序排列。","terminalSentenceEn":"Place the nurse's actions in the best order.","terminalSentenceZh":"请将护士的措施按最佳顺序排列。","penultimateSentenceEn":"The client says, \"I missed therapy appointments before because I had no ride, and some weeks I run out of food.\"","penultimateSentenceZh":"患者说：\"我以前因为没有车去而错过治疗预约，有些星期还会没饭吃。\"","responseContext":{"type":"ordered_response","options":[{"id":"E","en":"Ask the client to state the first contact they will use if transportation or food access fails.","zh":"请患者说出如果交通或食物获取再次出现问题时首先联系谁。"},{"id":"C","en":"Collaborate to arrange referrals for transportation assistance and food support programs.","zh":"合作安排交通协助和食物支持项目的转介。"},{"id":"A","en":"Assess the client's transportation, food access, insurance, and preferred contact method.","zh":"评估患者的交通、食物获取、保险情况和偏好的联系方式。"},{"id":"B","en":"Ask permission to share the client's needs with the discharge planner or social worker.","zh":"征得患者同意，将其需求告知出院计划人员或社工。"},{"id":"D","en":"Schedule or confirm follow-up appointments at times the client can realistically attend.","zh":"安排或确认患者实际能够参加的随访预约时间。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"The nurse first completes a focused social-needs assessment, obtains permission to involve the appropriate team member, arranges targeted resources, confirms realistic follow-up, and uses teach-back to verify the client knows what to do if barriers recur.","rationaleCorrectZh":"护士应先进行针对性的社会需求评估，征得同意后联系合适团队成员，安排相应资源，确认实际可行的随访，并用回授法确认患者知道障碍再次出现时该怎么做。","testTakingStrategyEn":"For discharge barriers, assess the exact need, protect privacy, involve the correct resource, then verify the plan is usable.","testTakingStrategyZh":"遇到出院障碍题，先评估具体需求，保护隐私，联系正确资源，再确认计划可实际执行。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1378,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_10_b_fib_mammography_screening_06","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.170","itemType":"fill_in_blank","category":"Health Promotion and Maintenance","topic":"Pediatric & Adolescent Health","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.170.stem.en","stemPathZh":"questions.170.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[153,185],"terminalOffsetsZh":[46,54],"fullStemEn":"A 41-year-old client at average risk for breast cancer asks when routine screening mammograms should begin and how often they are generally recommended. Complete the teaching statement.","fullStemZh":"一名41岁、乳腺癌平均风险的患者询问常规筛查乳房X线摄影应从何时开始，以及通常建议多久一次。请完成宣教语句。","terminalSentenceEn":"Complete the teaching statement.","terminalSentenceZh":"请完成宣教语句。","penultimateSentenceEn":"A 41-year-old client at average risk for breast cancer asks when routine screening mammograms should begin and how often they are generally recommended.","penultimateSentenceZh":"一名41岁、乳腺癌平均风险的患者询问常规筛查乳房X线摄影应从何时开始，以及通常建议多久一次。","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"Begin routine screening mammograms at age ___ years.","zh":"常规筛查乳房X线摄影从 ___ 岁开始。"},"acceptable":["40","age 40","40 years"],"numeric":{"value":40,"tolerance":0,"unit":"years"}},{"prompt":{"en":"For average-risk adults in the recommended age range, screening is generally every ___ years.","zh":"对于推荐年龄范围内的平均风险成人，通常每 ___ 年筛查一次。"},"acceptable":["2","two","every 2 years","biennial"],"numeric":{"value":2,"tolerance":0,"unit":"years"}}]},"rationaleCorrectEn":"For average-risk women, current USPSTF guidance recommends screening mammography beginning at age 40 and continuing every 2 years through age 74. Individual risk factors may require provider-specific recommendations.","rationaleCorrectZh":"对于平均风险女性，当前USPSTF建议从40岁开始进行筛查乳房X线摄影，并至74岁每2年一次。若有个体风险因素，可能需要根据医嘱调整。","testTakingStrategyEn":"In screening questions, identify whether the client is average risk or high risk before applying routine age-based recommendations.","testTakingStrategyZh":"筛查题要先判断患者是平均风险还是高风险，再套用常规按年龄的建议。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1379,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_10_b_fib_lung_screening_07","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.171","itemType":"fill_in_blank","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.171.stem.en","stemPathZh":"questions.171.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[98,176],"terminalOffsetsZh":[23,45],"fullStemEn":"The nurse is reviewing lung cancer screening eligibility with an adult who smoked for many years. Complete the eligibility teaching statement for routine low-dose CT screening.","fullStemZh":"护士正在与一名多年吸烟史成人复习肺癌筛查资格。请完成关于常规低剂量CT筛查资格的宣教语句。","terminalSentenceEn":"Complete the eligibility teaching statement for routine low-dose CT screening.","terminalSentenceZh":"请完成关于常规低剂量CT筛查资格的宣教语句。","penultimateSentenceEn":"The nurse is reviewing lung cancer screening eligibility with an adult who smoked for many years.","penultimateSentenceZh":"护士正在与一名多年吸烟史成人复习肺癌筛查资格。","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"Eligible adults are generally ages ___ to 80 years.","zh":"通常符合条件的成人年龄为 ___ 至80岁。"},"acceptable":["50","age 50","50 years"],"numeric":{"value":50,"tolerance":0,"unit":"years"}},{"prompt":{"en":"They have at least ___ pack-years of smoking history.","zh":"其吸烟史至少为 ___ 包年。"},"acceptable":["20","20 pack-years","twenty"],"numeric":{"value":20,"tolerance":0,"unit":"pack-years"}},{"prompt":{"en":"If no longer smoking, they quit within the past ___ years.","zh":"如果已戒烟，应是在过去 ___ 年内戒烟。"},"acceptable":["15","15 years","fifteen"],"numeric":{"value":15,"tolerance":0,"unit":"years"}}]},"rationaleCorrectEn":"Routine annual low-dose CT screening is recommended for adults ages 50 to 80 who have a 20 pack-year smoking history and currently smoke or quit within the past 15 years. Screening decisions should also consider health status and ability to undergo curative treatment.","rationaleCorrectZh":"常规每年低剂量CT筛查建议用于50至80岁、有20包年吸烟史且目前仍吸烟或过去15年内戒烟的成人。筛查决定还应考虑健康状况和是否能接受根治性治疗。","testTakingStrategyEn":"For screening eligibility, look for all required criteria; one missing criterion can make the routine recommendation inapplicable.","testTakingStrategyZh":"筛查资格题要找齐所有必要条件；缺少一个条件，常规建议可能就不适用。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1380,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_10_b_fib_bed_repositioning_08","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.172","itemType":"fill_in_blank","category":"Basic Care and Comfort","topic":"Skin & Wound Care","difficulty":"easy","ngnSkill":"take_action","stemPathEn":"questions.172.stem.en","stemPathZh":"questions.172.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[205,262],"terminalOffsetsZh":[54,69],"fullStemEn":"A bedbound client is at risk for pressure injury. The facility care plan states the client should be turned at least every 2 hours while in bed unless an individualized plan requires a different interval. Complete the teaching statement for the family caregiver.","fullStemZh":"一名卧床患者有压力性损伤风险。机构护理计划规定，除非个体化计划要求不同间隔，患者卧床时至少每2小时翻身一次。请完成给家庭照护者的宣教语句。","terminalSentenceEn":"Complete the teaching statement for the family caregiver.","terminalSentenceZh":"请完成给家庭照护者的宣教语句。","penultimateSentenceEn":"The facility care plan states the client should be turned at least every 2 hours while in bed unless an individualized plan requires a different interval.","penultimateSentenceZh":"机构护理计划规定，除非个体化计划要求不同间隔，患者卧床时至少每2小时翻身一次。","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"Reposition the client at least every ___ hours while in bed, following the care plan.","zh":"按照护理计划，患者卧床时至少每 ___ 小时重新摆位一次。"},"acceptable":["2","two","2 hours","q2h"],"numeric":{"value":2,"tolerance":0,"unit":"hours"}}]},"rationaleCorrectEn":"The care plan specifies repositioning at least every 2 hours while the client is in bed. The nurse should also teach that the schedule may be individualized based on skin tolerance, support surfaces, comfort, and clinical condition.","rationaleCorrectZh":"护理计划规定患者卧床时至少每2小时重新摆位一次。护士还应说明，翻身时间表可根据皮肤耐受性、支撑面、舒适度和临床状况进行个体化调整。","testTakingStrategyEn":"When a stem gives a facility plan or provider order, answer from that plan unless the action is unsafe.","testTakingStrategyZh":"当题干给出机构计划或医嘱时，除非该措施不安全，应按该计划作答。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1381,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_10_b_fib_diabetes_foot_self_management_09","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.173","itemType":"fill_in_blank","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"easy","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.173.stem.en","stemPathZh":"questions.173.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[86,162],"terminalOffsetsZh":[26,45],"fullStemEn":"A client with diabetes and decreased foot sensation is learning home self-management. Complete the statement that shows the client understands foot-care teaching.","fullStemZh":"一名糖尿病且足部感觉减退的患者正在学习居家自我管理。请完成显示患者理解足部护理宣教的语句。","terminalSentenceEn":"Complete the statement that shows the client understands foot-care teaching.","terminalSentenceZh":"请完成显示患者理解足部护理宣教的语句。","penultimateSentenceEn":"A client with diabetes and decreased foot sensation is learning home self-management.","penultimateSentenceZh":"一名糖尿病且足部感觉减退的患者正在学习居家自我管理。","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"I will inspect my feet ___.","zh":"我会 ___ 检查我的双脚。"},"acceptable":["daily","every day","once daily","each day","每天","每日"]}]},"rationaleCorrectEn":"Decreased sensation can prevent the client from noticing injury. Daily foot inspection helps identify redness, blisters, cuts, or pressure areas early so the client can seek care before complications develop.","rationaleCorrectZh":"感觉减退会使患者不易发现损伤。每日检查足部有助于早期发现发红、水疱、割伤或受压部位，以便并发症发生前及时求医。","testTakingStrategyEn":"For chronic illness self-management, choose actions that let the client detect problems early and act before complications worsen.","testTakingStrategyZh":"慢性病自我管理题应选择能让患者早期发现问题并在并发症恶化前采取行动的措施。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"A client with diabetes and decreased foot sensation is learning home self-management.","controlSentenceZh":"一名糖尿病且足部感觉减退的患者正在学习居家自我管理。"}
{"queueIndex":1382,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_gap_2026_06_10_b_fib_area_agency_aging_10","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_SCORED_LEAF","questionPath":"questions.174","itemType":"fill_in_blank","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.174.stem.en","stemPathZh":"questions.174.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[144,184],"terminalOffsetsZh":[38,49],"fullStemEn":"An older adult is being discharged home and needs help finding local meal delivery, caregiver support, transportation, and benefits counseling. Complete the nurse's referral statement.","fullStemZh":"一名老年患者即将出院回家，需要帮助寻找当地送餐、照护者支持、交通和福利咨询。请完成护士的转介说明。","terminalSentenceEn":"Complete the nurse's referral statement.","terminalSentenceZh":"请完成护士的转介说明。","penultimateSentenceEn":"An older adult is being discharged home and needs help finding local meal delivery, caregiver support, transportation, and benefits counseling.","penultimateSentenceZh":"一名老年患者即将出院回家，需要帮助寻找当地送餐、照护者支持、交通和福利咨询。","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"I will ask the case manager to connect you with the local ___.","zh":"我会请个案管理师帮您联系当地的 ___。"},"acceptable":["Area Agency on Aging","area agency on aging","AAA","local Area Agency on Aging","the Area Agency on Aging"]}]},"rationaleCorrectEn":"An Area Agency on Aging is an appropriate community resource for older adults and caregivers who need help locating services such as meals, transportation, caregiver support, and benefits counseling. The nurse should involve case management or social work for referral coordination.","rationaleCorrectZh":"老龄事务地区机构是适合老年人和照护者的社区资源，可帮助寻找送餐、交通、照护者支持和福利咨询等服务。护士应让个案管理或社工协助转介协调。","testTakingStrategyEn":"When needs are nonmedical but affect safe discharge, think case management, social work, and community agencies rather than adding more bedside teaching alone.","testTakingStrategyZh":"当需求不是单纯医疗问题但影响安全出院时，应想到个案管理、社工和社区机构，而不是只增加床旁宣教。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1383,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_dementia_caregiver_burden_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.175","itemType":"case_study","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.175.stem.en","stemPathZh":"questions.175.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[145,208],"terminalOffsetsZh":[41,59],"fullStemEn":"Case study: dementia discharge and caregiver burden An older adult with dementia was discharged home with the daughter as the primary caregiver. The home-health nurse makes the first follow-up call and visit.","fullStemZh":"病例：痴呆出院后的照护者负担 一名患有痴呆的老年人出院回家，由女儿担任主要照护者。居家护理护士进行首次随访电话和家访。","terminalSentenceEn":"The home-health nurse makes the first follow-up call and visit.","terminalSentenceZh":"居家护理护士进行首次随访电话和家访。","penultimateSentenceEn":"Case study: dementia discharge and caregiver burden An older adult with dementia was discharged home with the daughter as the primary caregiver.","penultimateSentenceZh":"病例：痴呆出院后的照护者负担 一名患有痴呆的老年人出院回家，由女儿担任主要照护者。","responseContext":{},"rationaleCorrectEn":"This case centers on recognizing caregiver role strain and dementia-related home-safety risks, using therapeutic communication, and planning interdisciplinary community supports before unsafe caregiving patterns worsen.","rationaleCorrectZh":"本病例重点是识别照护者角色压力和痴呆相关居家安全风险，使用治疗性沟通，并在不安全照护模式恶化前规划跨专业社区支持。","testTakingStrategyEn":"When the family caregiver is the safety system, the nurse must assess the caregiver's capacity as carefully as the client's symptoms.","testTakingStrategyZh":"当家庭照护者就是安全系统时，护士必须像评估患者症状一样仔细评估照护者能力。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1384,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_dementia_caregiver_burden_01","embeddedQuestionId":"gpt_case_gap_2026_06_11_dementia_burden_part_1_matrix_cues","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.175.caseStudy.questions.0","itemType":"matrix","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.175.caseStudy.questions.0.stem.en","stemPathZh":"questions.175.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,34],"terminalOffsetsZh":[0,14],"fullStemEn":"Classify each cue from the record.","fullStemZh":"对病历中的每条线索进行分类。","terminalSentenceEn":"Classify each cue from the record.","terminalSentenceZh":"对病历中的每条线索进行分类。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Daughter reports sleeping 3 hours most nights since discharge.","zh":"女儿说出院后多数夜晚只睡3小时。"},{"id":"r2","en":"Client left the stove on while the daughter was showering.","zh":"女儿洗澡时，患者把炉灶开着未关。"},{"id":"r3","en":"Memory clinic follow-up is scheduled in 2 weeks.","zh":"已预约2周后记忆门诊复诊。"},{"id":"r4","en":"Two morning medication doses were found in a coffee cup.","zh":"在咖啡杯中发现两次早晨药物未服。"},{"id":"r5","en":"Daughter says, “I do not know how much longer I can do this.”","zh":"女儿说：“我不知道自己还能这样撑多久。”"}],"columns":[{"id":"c1","en":"Caregiver strain cue","zh":"照护者压力线索"},{"id":"c3","en":"Protective factor","zh":"保护性因素"},{"id":"c2","en":"Immediate safety risk","zh":"即时安全风险"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c3"]},{"rowId":"r4","columnIds":["c2"]},{"rowId":"r5","columnIds":["c1"]}]},"rationaleCorrectEn":"Missed caregiver sleep, medication confusion, wandering, and the caregiver's tearful statement are not normal adjustment alone; they show escalating strain and safety risk. The intact follow-up appointment is a protective factor.","rationaleCorrectZh":"照护者睡眠不足、用药混乱、走失以及照护者流泪的表达，并不只是普通适应过程；这些提示照护压力加重和安全风险。后续门诊预约已安排是保护性因素。","testTakingStrategyEn":"First separate protective factors from risk cues, then decide which risks threaten immediate safety or caregiver capacity.","testTakingStrategyZh":"先把保护性因素和风险线索分开，再判断哪些风险威胁即时安全或照护能力。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1385,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_dementia_caregiver_burden_01","embeddedQuestionId":"gpt_case_gap_2026_06_11_dementia_burden_part_2_mc_response","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.175.caseStudy.questions.1","itemType":"multiple_choice","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.175.caseStudy.questions.1.stem.en","stemPathZh":"questions.175.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[107,155],"terminalOffsetsZh":[34,47],"fullStemEn":"The daughter begins crying and says, “I promised I would never put Mom in a facility, but I am exhausted.” Which response by the nurse is most therapeutic?","fullStemZh":"女儿开始哭泣并说：“我答应过永远不把妈妈送进机构，但我真的太累了。”护士哪项回应最具有治疗性？","terminalSentenceEn":"Which response by the nurse is most therapeutic?","terminalSentenceZh":"护士哪项回应最具有治疗性？","penultimateSentenceEn":"The daughter begins crying and says, “I promised I would never put Mom in a facility, but I am exhausted.”","penultimateSentenceZh":"女儿开始哭泣并说：“我答应过永远不把妈妈送进机构，但我真的太累了。”","responseContext":{"type":"multiple_choice","options":[{"id":"B","en":"“You are doing the right thing by keeping her at home, so try to take it one day at a time.”","zh":"“您让她留在家里是正确的，所以尽量一天一天来。”"},{"id":"A","en":"“You sound overwhelmed. Tell me what has been hardest since your mother came home.”","zh":"“听起来您已经非常疲惫。能告诉我母亲回家后最困难的是什么吗？”"},{"id":"C","en":"“A facility placement would break your promise, so we should avoid discussing that today.”","zh":"“送机构会违背您的承诺，所以我们今天不谈这个。”"},{"id":"D","en":"“I will give you a list of agencies, and you can decide which one to call later.”","zh":"“我给您一份机构清单，您之后自己决定打给哪家。”"}],"correct":["A"]},"rationaleCorrectEn":"The best response validates the caregiver's distress and invites further assessment without judgment. It opens the door to discussing safety, respite, and realistic supports.","rationaleCorrectZh":"最佳回应认可照护者的痛苦，并以不评判的方式进一步评估。这有助于讨论安全、喘息服务和现实可行的支持。","testTakingStrategyEn":"For psychosocial items, choose the response that validates feelings, avoids judgment, and keeps assessment open.","testTakingStrategyZh":"心理社会题优先选择能认可感受、避免评判并继续评估的回应。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1386,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_dementia_caregiver_burden_01","embeddedQuestionId":"gpt_case_gap_2026_06_11_dementia_burden_part_3_sata_resources","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.175.caseStudy.questions.2","itemType":"select_all","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"hard","ngnSkill":"generate_solutions","stemPathEn":"questions.175.caseStudy.questions.2.stem.en","stemPathZh":"questions.175.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[72,94],"terminalOffsetsZh":[18,26],"fullStemEn":"Which actions should the nurse include in the discharge follow-up plan? Select all that apply.","fullStemZh":"护士应将哪些措施纳入出院后随访计划？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which actions should the nurse include in the discharge follow-up plan?","penultimateSentenceZh":"护士应将哪些措施纳入出院后随访计划？","responseContext":{"type":"select_all","options":[{"id":"B","en":"Screen the caregiver for depression, hopelessness, and immediate safety concerns.","zh":"筛查照护者是否有抑郁、绝望和即时安全问题。"},{"id":"F","en":"Ask the daughter to promise that she will supervise the client continuously.","zh":"要求女儿承诺持续不断地看护患者。"},{"id":"C","en":"Arrange medication-management teaching and tools before the next refill.","zh":"在下次续药前安排用药管理教学和工具。"},{"id":"E","en":"Advise the daughter to wait 1 month before changing the plan because adjustment takes time.","zh":"建议女儿先等1个月再改变计划，因为适应需要时间。"},{"id":"D","en":"Discuss stove safety, door alerts, and a wandering-response plan.","zh":"讨论炉灶安全、门磁报警和走失应对计划。"},{"id":"A","en":"Request social work or case-management referral for respite and adult day services.","zh":"申请社工或个案管理转介，评估喘息服务和成人日间照护。"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"The plan should reduce immediate hazards, assess caregiver safety and coping, connect the family with respite and community supports, and simplify medication management. Telling the caregiver to wait or to promise constant supervision is unsafe and unrealistic.","rationaleCorrectZh":"计划应减少即时危险，评估照护者安全和应对能力，连接喘息与社区资源，并简化用药管理。让照护者等待或承诺持续看护既不安全也不现实。","testTakingStrategyEn":"Safe discharge planning matches each identified barrier with a realistic support, not a promise of perfect family supervision.","testTakingStrategyZh":"安全出院计划应为每个障碍匹配现实可行的支持，而不是依赖家庭完美监督的承诺。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"Which actions should the nurse include in the discharge follow-up plan?","controlSentenceZh":"护士应将哪些措施纳入出院后随访计划？"}
{"queueIndex":1387,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_dementia_caregiver_burden_01","embeddedQuestionId":"gpt_case_gap_2026_06_11_dementia_burden_part_4_order_plan","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.175.caseStudy.questions.3","itemType":"ordered_response","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.175.caseStudy.questions.3.stem.en","stemPathZh":"questions.175.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,56],"terminalOffsetsZh":[0,18],"fullStemEn":"Place the nurse's follow-up actions in the safest order.","fullStemZh":"将护士的随访措施按最安全的顺序排列。","terminalSentenceEn":"Place the nurse's follow-up actions in the safest order.","terminalSentenceZh":"将护士的随访措施按最安全的顺序排列。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"ordered_response","options":[{"id":"A","en":"Assess for immediate danger, caregiver thoughts of self-harm, and whether the client can be safely supervised tonight.","zh":"评估即时危险、照护者是否有自伤想法，以及今晚患者能否被安全看护。"},{"id":"D","en":"Use teach-back to confirm the daughter knows the warning signs and resource contacts.","zh":"使用回授法确认女儿知道警示信号和资源联系方式。"},{"id":"C","en":"Contact case management/social work for respite, home-health, and community dementia resources.","zh":"联系个案管理/社工，安排喘息、居家护理和社区痴呆资源。"},{"id":"B","en":"Identify specific home-safety and medication-management changes needed before the next night.","zh":"确定下一个夜晚前需要落实的居家安全和用药管理改变。"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"The nurse first assesses immediate danger, then addresses modifiable hazards and medication problems, then activates interdisciplinary support, and finally verifies the caregiver can explain the plan.","rationaleCorrectZh":"护士应先评估即时危险，再处理可改变的环境危险和用药问题，然后启动跨专业支持，最后确认照护者能说明计划。","testTakingStrategyEn":"In ordering questions, immediate safety and assessment come before education, referrals, and routine follow-up.","testTakingStrategyZh":"排序题中，即时安全和评估先于教育、转介和常规随访。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1388,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_ostomy_health_literacy_02","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.176","itemType":"case_study","category":"Basic Care and Comfort","topic":"Elimination & Comfort","difficulty":"hard","ngnSkill":"generate_solutions","stemPathEn":"questions.176.stem.en","stemPathZh":"questions.176.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[110,184],"terminalOffsetsZh":[28,49],"fullStemEn":"Case study: new ostomy teaching and health literacy A client with a new colostomy is preparing for discharge. The nurse notices signs that standard written instructions are not enough.","fullStemZh":"病例：新造口教学与健康素养 一名新结肠造口患者即将出院。护士注意到标准书面说明不足以满足患者需要。","terminalSentenceEn":"The nurse notices signs that standard written instructions are not enough.","terminalSentenceZh":"护士注意到标准书面说明不足以满足患者需要。","penultimateSentenceEn":"Case study: new ostomy teaching and health literacy A client with a new colostomy is preparing for discharge.","penultimateSentenceZh":"病例：新造口教学与健康素养 一名新结肠造口患者即将出院。","responseContext":{},"rationaleCorrectEn":"This case emphasizes adapting ostomy discharge teaching to health literacy needs, confirming skill performance, protecting dignity, and ensuring supplies and escalation instructions are in place.","rationaleCorrectZh":"本病例强调根据健康素养需求调整造口出院教学，确认操作技能，维护尊严，并确保用品和升级处理指示落实。","testTakingStrategyEn":"When teaching fails, simplify the teaching method and ask the client to show understanding; do not label the client as noncompliant.","testTakingStrategyZh":"当教学无效时，应简化教学方法并请患者展示理解，不要把患者贴上“不依从”的标签。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1389,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_ostomy_health_literacy_02","embeddedQuestionId":"gpt_case_gap_2026_06_11_ostomy_literacy_part_1_cloze_teachback","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.176.caseStudy.questions.0","itemType":"dropdown_cloze","category":"Basic Care and Comfort","topic":"Elimination & Comfort","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.176.caseStudy.questions.0.stem.en","stemPathZh":"questions.176.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,72],"terminalOffsetsZh":[0,16],"fullStemEn":"Use the nurse note and discharge instructions to complete the statement.","fullStemZh":"根据护士记录和出院指导完成句子。","terminalSentenceEn":"Use the nurse note and discharge instructions to complete the statement.","terminalSentenceZh":"根据护士记录和出院指导完成句子。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The priority teaching problem is {{1}}, so the nurse should next use {{2}}.","zh":"优先的教学问题是 {{1}}，因此护士下一步应使用 {{2}}。"},"dropdowns":[{"id":"1","options":[{"id":"o3","en":"normal independence after surgery","zh":"术后正常独立表现"},{"id":"o1","en":"a health literacy barrier","zh":"健康素养障碍"},{"id":"o2","en":"intentional refusal of care","zh":"故意拒绝护理"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"teach-back with return demonstration","zh":"回授法并进行回示范"},{"id":"o3","en":"family teaching without the client present","zh":"让患者不在场时只教家属"},{"id":"o2","en":"a longer written booklet","zh":"更长的书面手册"}],"correct":"o1"}]},"rationaleCorrectEn":"The exhibit shows the client is nodding but cannot describe the steps and is worried about reading. The nurse should use teach-back with plain language and demonstration rather than simply giving more written material.","rationaleCorrectZh":"记录显示患者点头但不能说出步骤，并担心阅读能力。护士应使用通俗语言和示范的回授法，而不是只给更多书面材料。","testTakingStrategyEn":"When a client says they understand but cannot explain or demonstrate care, treat it as a teaching-method problem, not a motivation problem.","testTakingStrategyZh":"当患者说懂了却不能解释或示范护理时，应把它视为教学方法问题，而不是动机问题。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1390,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_ostomy_health_literacy_02","embeddedQuestionId":"gpt_case_gap_2026_06_11_ostomy_literacy_part_2_matrix_findings","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.176.caseStudy.questions.1","itemType":"matrix","category":"Basic Care and Comfort","topic":"Elimination & Comfort","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.176.caseStudy.questions.1.stem.en","stemPathZh":"questions.176.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,62],"terminalOffsetsZh":[0,16],"fullStemEn":"For each statement or finding, select the best interpretation.","fullStemZh":"针对每句话或发现，选择最佳解释。","terminalSentenceEn":"For each statement or finding, select the best interpretation.","terminalSentenceZh":"针对每句话或发现，选择最佳解释。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Stoma is moist and beefy red.","zh":"造口湿润，呈鲜红色。"},{"id":"r2","en":"Client says, “If the stoma turns dark purple or black, I will wait until the clinic visit.”","zh":"患者说：“如果造口变成深紫色或黑色，我会等到门诊再说。”"},{"id":"r3","en":"Pouch leaked twice overnight and the skin feels like it is burning.","zh":"造口袋夜间漏了两次，皮肤感觉灼痛。"},{"id":"r4","en":"Client says, “I feel embarrassed when I look at the pouch.”","zh":"患者说：“我看到造口袋会觉得尴尬。”"},{"id":"r5","en":"Client cannot state when to empty the pouch.","zh":"患者说不出什么时候应排空造口袋。"}],"columns":[{"id":"c2","en":"Requires follow-up before discharge","zh":"出院前需要跟进"},{"id":"c1","en":"Expected/therapeutic support","zh":"预期/需支持"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c1"]},{"rowId":"r5","columnIds":["c2"]}]},"rationaleCorrectEn":"A moist red stoma is expected early after surgery. A dusky stoma, repeated leakage with skin burning, and inability to explain pouch emptying need follow-up. Embarrassment requires supportive communication but is not the same as a physiologic complication.","rationaleCorrectZh":"术后早期造口湿润呈红色是预期表现。造口发暗、反复漏袋伴皮肤灼痛，以及无法说明排空方法均需要跟进。尴尬需要支持性沟通，但不等同于生理并发症。","testTakingStrategyEn":"Separate expected stoma findings from urgent circulation changes, skin-protection problems, and teaching gaps.","testTakingStrategyZh":"将预期造口表现与紧急血运改变、皮肤保护问题和教学缺口区分开。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1391,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_ostomy_health_literacy_02","embeddedQuestionId":"gpt_case_gap_2026_06_11_ostomy_literacy_part_3_mc_instruction","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.176.caseStudy.questions.2","itemType":"multiple_choice","category":"Basic Care and Comfort","topic":"Elimination & Comfort","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.176.caseStudy.questions.2.stem.en","stemPathZh":"questions.176.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,92],"terminalOffsetsZh":[0,22],"fullStemEn":"Which client statement indicates that discharge teaching about pouch emptying was effective?","fullStemZh":"患者哪句话表明关于排空造口袋的出院教学有效？","terminalSentenceEn":"Which client statement indicates that discharge teaching about pouch emptying was effective?","terminalSentenceZh":"患者哪句话表明关于排空造口袋的出院教学有效？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"B","en":"“I will wait until the pouch is completely full so I do not waste supplies.”","zh":"“我会等到造口袋完全满再排空，这样不浪费用品。”"},{"id":"A","en":"“I will empty the pouch when it is about one-third to one-half full.”","zh":"“造口袋大约三分之一到二分之一满时，我就会排空。”"},{"id":"D","en":"“I should scrub the stoma if it looks red and moist.”","zh":"“如果造口看起来红而湿，我应该用力刷洗。”"},{"id":"C","en":"“I only need to empty the pouch once each morning.”","zh":"“我只需要每天早上排空一次。”"}],"correct":["A"]},"rationaleCorrectEn":"The correct statement reflects practical pouch management: emptying before the pouch becomes heavy helps prevent leakage and skin injury. The other statements delay care or show misunderstanding of normal care.","rationaleCorrectZh":"正确陈述体现实际造口袋管理：在袋子过重前排空有助于预防漏袋和皮肤损伤。其他说法会延误处理或显示对正常护理理解错误。","testTakingStrategyEn":"Evaluate teaching by looking for a statement that is specific, safe, and doable at home.","testTakingStrategyZh":"评估教学效果时，寻找具体、安全且在家可执行的表述。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1392,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_ostomy_health_literacy_02","embeddedQuestionId":"gpt_case_gap_2026_06_11_ostomy_literacy_part_4_sata_discharge","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.176.caseStudy.questions.3","itemType":"select_all","category":"Basic Care and Comfort","topic":"Elimination & Comfort","difficulty":"hard","ngnSkill":"generate_solutions","stemPathEn":"questions.176.caseStudy.questions.3.stem.en","stemPathZh":"questions.176.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[54,76],"terminalOffsetsZh":[13,21],"fullStemEn":"Which actions should the nurse take before discharge? Select all that apply.","fullStemZh":"出院前护士应采取哪些措施？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which actions should the nurse take before discharge?","penultimateSentenceZh":"出院前护士应采取哪些措施？","responseContext":{"type":"select_all","options":[{"id":"C","en":"Ask permission to include a chosen support person in teaching.","zh":"征得同意后让患者选择的支持者参与教学。"},{"id":"E","en":"Teach the adult child outside the room because the client is embarrassed.","zh":"因为患者尴尬，就在病房外只教成年子女。"},{"id":"B","en":"Ask the client to demonstrate emptying and securing the pouch before leaving.","zh":"请患者离院前示范排空并固定造口袋。"},{"id":"F","en":"Show severe skin-breakdown photos to make the client take pouching seriously.","zh":"展示严重皮肤破损照片，让患者重视造口袋护理。"},{"id":"A","en":"Replace dense written instructions with plain-language steps and pictures.","zh":"用通俗语言步骤和图片替代密集书面说明。"},{"id":"D","en":"Confirm the client has starter supplies, delivery arrangements, and a number to call for leakage or skin breakdown.","zh":"确认患者有初始用品、配送安排，以及漏袋或皮肤破损时可拨打的电话。"}],"correct":["A","B","C","D"]},"rationaleCorrectEn":"Teaching should be adapted to the client's literacy needs, privacy preferences, and actual ability to perform care. The nurse should verify supply access and escalation instructions. Avoid excluding the client or relying on shame-based teaching.","rationaleCorrectZh":"教学应适应患者健康素养需求、隐私偏好和实际操作能力。护士应确认用品获得途径和升级处理指示。应避免排除患者或采用羞辱式教学。","testTakingStrategyEn":"Health-literacy interventions make information easier to use and verify understanding without blaming the learner.","testTakingStrategyZh":"健康素养干预应让信息更容易使用，并在不责备学习者的情况下确认理解。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1393,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_health_literacy_diabetes_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.177","itemType":"case_study","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.177.stem.en","stemPathZh":"questions.177.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,160],"terminalOffsetsZh":[0,47],"fullStemEn":"Diabetes Self-Management Visit The client has recently had medication changes, inconsistent meals, and increasing dependence on a spouse for daily health tasks.","fullStemZh":"糖尿病自我管理门诊 该患者近期调整了用药、进餐不规律，并且越来越依赖配偶完成日常健康管理任务。","terminalSentenceEn":"Diabetes Self-Management Visit The client has recently had medication changes, inconsistent meals, and increasing dependence on a spouse for daily health tasks.","terminalSentenceZh":"糖尿病自我管理门诊 该患者近期调整了用药、进餐不规律，并且越来越依赖配偶完成日常健康管理任务。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This case emphasizes prevention, health literacy, medication safety, caregiver support, and coordinated chronic illness self-management.","rationaleCorrectZh":"本病例强调预防、健康素养、用药安全、照护者支持以及慢性病自我管理的协调。","testTakingStrategyEn":"In ambulatory chronic illness cases, prioritize safety risks, assess the client's actual routine, and use teach-back to verify learning.","testTakingStrategyZh":"在门诊慢性病病例中，优先处理安全风险，评估患者真实日常做法，并用回授法确认学习效果。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1394,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_health_literacy_diabetes_01","embeddedQuestionId":"gpt_case_premium_next_case_health_literacy_diabetes_01_matrix_cues","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.177.caseStudy.questions.0","itemType":"matrix","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.177.caseStudy.questions.0.stem.en","stemPathZh":"questions.177.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,108],"terminalOffsetsZh":[0,38],"fullStemEn":"For each finding, select whether it is expected, needs focused teaching, or needs prompt provider follow-up.","fullStemZh":"对每项发现，选择其属于预期情况、需要重点宣教，还是需要及时联系医务人员跟进。","terminalSentenceEn":"For each finding, select whether it is expected, needs focused teaching, or needs prompt provider follow-up.","terminalSentenceZh":"对每项发现，选择其属于预期情况、需要重点宣教，还是需要及时联系医务人员跟进。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"The client takes glipizide when feeling shaky.","zh":"患者发抖时服用格列吡嗪。"},{"id":"r2","en":"The client skips breakfast on workdays.","zh":"患者工作日不吃早餐。"},{"id":"r3","en":"Fasting blood glucose readings include 64 and 69 mg/dL.","zh":"空腹血糖记录包括64和69 mg/dL。"},{"id":"r4","en":"Skin on both feet is intact.","zh":"双足皮肤完整。"},{"id":"r5","en":"The client prefers pictures with short instructions.","zh":"患者偏好配图和简短说明。"}],"columns":[{"id":"c2","en":"Needs focused teaching","zh":"需要重点宣教"},{"id":"c1","en":"Expected or reassuring","zh":"预期或令人放心"},{"id":"c3","en":"Needs prompt provider follow-up","zh":"需要及时医务人员跟进"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c2"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c3"]},{"rowId":"r4","columnIds":["c1"]},{"rowId":"r5","columnIds":["c1"]}]},"rationaleCorrectEn":"Misusing glipizide and skipping meals require focused safety teaching. Recurrent fasting readings below 70 mg/dL require prompt provider follow-up because the medication plan may need adjustment. Intact foot skin and a stated learning preference are useful baseline findings.","rationaleCorrectZh":"错误使用格列吡嗪和漏餐需要重点安全宣教。反复空腹血糖低于70 mg/dL需要及时联系医务人员，因为用药计划可能需要调整。足部皮肤完整和明确的学习偏好是有用的基线资料。","testTakingStrategyEn":"Separate cues that require teaching from cues that suggest the current treatment plan may be unsafe and needs provider review.","testTakingStrategyZh":"区分需要宣教的线索和提示当前治疗计划可能不安全、需要医务人员复核的线索。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1395,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_health_literacy_diabetes_01","embeddedQuestionId":"gpt_case_premium_next_case_health_literacy_diabetes_01_cloze_priority","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.177.caseStudy.questions.1","itemType":"dropdown_cloze","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.177.caseStudy.questions.1.stem.en","stemPathZh":"questions.177.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,56],"terminalOffsetsZh":[0,14],"fullStemEn":"Complete the statement about the priority teaching need.","fullStemZh":"完成关于优先宣教需求的陈述。","terminalSentenceEn":"Complete the statement about the priority teaching need.","terminalSentenceZh":"完成关于优先宣教需求的陈述。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The nurse should first teach the client to treat symptoms of {{1}} with {{2}}.","zh":"护士应首先教患者在出现 {{1}} 症状时使用 {{2}} 处理。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"hypoglycemia","zh":"低血糖"},{"id":"o2","en":"hyperglycemia","zh":"高血糖"},{"id":"o3","en":"hypertension","zh":"高血压"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"an extra dose of glipizide","zh":"额外一剂格列吡嗪"},{"id":"o3","en":"a high-fat snack","zh":"高脂肪点心"},{"id":"o1","en":"fast-acting carbohydrate","zh":"快速作用的碳水化合物"}],"correct":"o1"}]},"rationaleCorrectEn":"Shakiness with low fasting readings indicates hypoglycemia risk. The immediate teaching priority is to use fast-acting carbohydrate rather than taking more glucose-lowering medication.","rationaleCorrectZh":"发抖且空腹血糖偏低提示低血糖风险。最优先的宣教是使用快速作用的碳水化合物，而不是再服降糖药。","testTakingStrategyEn":"When a client describes symptoms after a medication change, connect the symptom pattern to the most immediate safety risk before choosing teaching content.","testTakingStrategyZh":"当患者在用药调整后描述症状时，先把症状模式与最紧迫的安全风险联系起来，再选择宣教内容。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1396,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_health_literacy_diabetes_01","embeddedQuestionId":"gpt_case_premium_next_case_health_literacy_diabetes_01_or_teachback","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.177.caseStudy.questions.2","itemType":"ordered_response","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.177.caseStudy.questions.2.stem.en","stemPathZh":"questions.177.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,53],"terminalOffsetsZh":[0,16],"fullStemEn":"Place the nurse's teaching actions in the best order.","fullStemZh":"将护士的宣教措施按最佳顺序排列。","terminalSentenceEn":"Place the nurse's teaching actions in the best order.","terminalSentenceZh":"将护士的宣教措施按最佳顺序排列。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"ordered_response","options":[{"id":"C","en":"Ask the client to teach back the low-blood-glucose action plan using the labeled pillbox and picture sheet.","zh":"让患者借助贴好标签的药盒和图片单，复述低血糖处理计划。"},{"id":"B","en":"Use plain language and pictures to explain when to take glipizide and what to do if a meal is skipped.","zh":"用通俗语言和图片说明格列吡嗪何时服用，以及漏餐时应如何处理。"},{"id":"A","en":"Ask the client to show how each medication is taken on a usual workday.","zh":"请患者演示平常工作日每种药物如何服用。"},{"id":"E","en":"Clarify which self-management task the client most wants to handle without the spouse's help.","zh":"明确患者最希望不依赖配偶而自己完成的自我管理任务。"},{"id":"D","en":"Document the client's remaining barriers and arrange follow-up with the diabetes educator and dietitian.","zh":"记录患者仍存在的障碍，并安排糖尿病教育护士和营养师随访。"}],"correct":["A","E","B","C","D"]},"rationaleCorrectEn":"The nurse first assesses the client's actual routine, then identifies a patient-centered goal, teaches using appropriate literacy supports, verifies understanding with teach-back, and finally documents barriers and coordinates follow-up.","rationaleCorrectZh":"护士先评估患者真实的日常做法，再确定以患者为中心的目标，用适合其健康素养的方式宣教，使用回授法确认理解，最后记录障碍并协调随访。","testTakingStrategyEn":"For ordered teaching items, use the nursing process: assess, individualize, teach, evaluate, and coordinate follow-up.","testTakingStrategyZh":"处理宣教排序题时，按护理程序思考：评估、个体化、宣教、评价、协调随访。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1397,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_health_literacy_diabetes_01","embeddedQuestionId":"gpt_case_premium_next_case_health_literacy_diabetes_01_sata_referrals","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.177.caseStudy.questions.3","itemType":"select_all","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.177.caseStudy.questions.3.stem.en","stemPathZh":"questions.177.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[70,92],"terminalOffsetsZh":[18,26],"fullStemEn":"Which actions should the nurse include in the care coordination plan? Select all that apply.","fullStemZh":"护士应在护理协调计划中包括哪些措施？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which actions should the nurse include in the care coordination plan?","penultimateSentenceZh":"护士应在护理协调计划中包括哪些措施？","responseContext":{"type":"select_all","options":[{"id":"C","en":"Tell the spouse to continue managing all medications because the client has low health literacy.","zh":"告诉配偶继续管理所有药物，因为患者健康素养低。"},{"id":"D","en":"Request a dietitian consult for a simple workday breakfast and snack plan.","zh":"申请营养师会诊，制定简单的工作日早餐和点心计划。"},{"id":"B","en":"Ask the provider whether recurrent low fasting readings require a medication-plan review.","zh":"询问医务人员反复空腹低血糖是否需要复核用药计划。"},{"id":"A","en":"Refer the client to the diabetes educator for medication and glucose-monitoring skills.","zh":"转介患者至糖尿病教育护士，学习用药和血糖监测技能。"},{"id":"E","en":"Offer social work support for caregiver strain and access to medication-labeling resources.","zh":"提供社工支持，以处理照护者压力并获取药物标签辅助资源。"}],"correct":["A","B","D","E"]},"rationaleCorrectEn":"The plan should build self-management skills, address recurrent low readings with the provider, support practical meal planning, and respond to caregiver strain. The nurse should not reinforce total dependence on the spouse or rely only on written instructions.","rationaleCorrectZh":"计划应培养自我管理技能，联系医务人员处理反复低血糖，支持实际可行的进餐计划，并回应照护者压力。护士不应强化患者完全依赖配偶，也不应只依赖书面说明。","testTakingStrategyEn":"Choose coordination actions that reduce risk while increasing the client's ability to participate safely in care.","testTakingStrategyZh":"选择既能降低风险、又能提高患者安全参与护理能力的协调措施。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1398,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_health_literacy_diabetes_01","embeddedQuestionId":"gpt_case_premium_next_case_health_literacy_diabetes_01_fib_activity","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.177.caseStudy.questions.4","itemType":"fill_in_blank","category":"Health Promotion and Maintenance","topic":"Chronic Disease Management & Lifestyle","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.177.caseStudy.questions.4.stem.en","stemPathZh":"questions.177.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[155,175],"terminalOffsetsZh":[40,46],"fullStemEn":"The client chooses a goal of walking 30 minutes per day on 5 days each week. How many minutes of walking per week should the nurse document for this goal? Enter a number only.","fullStemZh":"患者选择的目标是每周5天、每天步行30分钟。护士应记录该目标为每周步行多少分钟？只输入数字。","terminalSentenceEn":"Enter a number only.","terminalSentenceZh":"只输入数字。","penultimateSentenceEn":"How many minutes of walking per week should the nurse document for this goal?","penultimateSentenceZh":"护士应记录该目标为每周步行多少分钟？","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"minutes per week","zh":"分钟/周"},"acceptable":["150"],"numeric":{"value":150,"tolerance":0,"unit":"minutes/week"}}]},"rationaleCorrectEn":"Thirty minutes per day multiplied by 5 days per week equals 150 minutes per week, a clear measurable self-management goal.","rationaleCorrectZh":"每天30分钟乘以每周5天等于每周150分钟，这是明确可衡量的自我管理目标。","testTakingStrategyEn":"For numeric goal-setting questions, identify the unit requested before multiplying or converting.","testTakingStrategyZh":"处理数字目标设定题时，先确认题目要求的单位，再进行乘法或换算。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1399,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_rehab_pressure_bowel_02","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.178","itemType":"case_study","category":"Basic Care and Comfort","topic":"Skin & Wound Care","difficulty":"hard","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.178.stem.en","stemPathZh":"questions.178.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,175],"terminalOffsetsZh":[0,41],"fullStemEn":"Rehabilitation Care Planning The client has limited mobility, intermittent urinary incontinence, constipation, sleep disruption, and family concerns about discharge readiness.","fullStemZh":"康复护理计划 患者活动受限，间歇性尿失禁，便秘，睡眠受干扰，家属担心出院准备不足。","terminalSentenceEn":"Rehabilitation Care Planning The client has limited mobility, intermittent urinary incontinence, constipation, sleep disruption, and family concerns about discharge readiness.","terminalSentenceZh":"康复护理计划 患者活动受限，间歇性尿失禁，便秘，睡眠受干扰，家属担心出院准备不足。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This case emphasizes rehabilitation nursing, pressure injury prevention, bowel and bladder management, sleep promotion, fall prevention, delegation, and discharge planning.","rationaleCorrectZh":"本病例强调康复护理、压力性损伤预防、肠膀胱管理、促进睡眠、预防跌倒、委派和出院计划。","testTakingStrategyEn":"In rehabilitation cases, prioritize prevention, functional safety, comfort, and coordinated discharge resources.","testTakingStrategyZh":"在康复病例中，优先考虑预防、功能安全、舒适以及协调出院资源。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1400,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_rehab_pressure_bowel_02","embeddedQuestionId":"gpt_case_premium_next_case_rehab_pressure_bowel_02_matrix_risk","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.178.caseStudy.questions.0","itemType":"matrix","category":"Basic Care and Comfort","topic":"Mobility & Immobility","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.178.caseStudy.questions.0.stem.en","stemPathZh":"questions.178.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,58],"terminalOffsetsZh":[0,17],"fullStemEn":"Classify each finding based on the nurse's interpretation.","fullStemZh":"根据护士的判断对每项发现进行分类。","terminalSentenceEn":"Classify each finding based on the nurse's interpretation.","terminalSentenceZh":"根据护士的判断对每项发现进行分类。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Sacrum is pink and blanches slowly.","zh":"骶尾部发粉红色，按压后褪色缓慢。"},{"id":"r2","en":"The client avoids fluids to prevent urinary leakage.","zh":"患者为避免尿液渗漏而限制饮水。"},{"id":"r3","en":"Last bowel movement was 4 days ago.","zh":"上次排便为4天前。"},{"id":"r4","en":"The client can stand with assistance and a walker.","zh":"患者可在协助下使用助行器站立。"},{"id":"r5","en":"The daughter works nights and fears the client will fall at home.","zh":"女儿上夜班，并担心患者在家跌倒。"}],"columns":[{"id":"c1","en":"Pressure injury risk","zh":"压力性损伤风险"},{"id":"c3","en":"Discharge planning concern","zh":"出院计划问题"},{"id":"c2","en":"Bowel or bladder management concern","zh":"肠道或膀胱管理问题"}],"selectionMode":"multiple_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1","c2"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c1","c3"]},{"rowId":"r5","columnIds":["c3"]}]},"rationaleCorrectEn":"Slow blanching over the sacrum, moisture, immobility, constipation, limited endurance, and family schedule barriers all affect the rehabilitation plan. Some findings fit more than one concern.","rationaleCorrectZh":"骶尾部褪色缓慢、潮湿、活动受限、便秘、耐力不足以及家属时间安排障碍都会影响康复计划。有些发现同时属于多个问题。","testTakingStrategyEn":"In rehabilitation cases, connect mobility, moisture, elimination, and caregiver availability rather than treating them as separate problems.","testTakingStrategyZh":"在康复病例中，要把活动能力、潮湿、排泄和照护者可用性联系起来，而不是割裂看待。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1401,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_rehab_pressure_bowel_02","embeddedQuestionId":"gpt_case_premium_next_case_rehab_pressure_bowel_02_or_transfer","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.178.caseStudy.questions.1","itemType":"ordered_response","category":"Safety and Infection Prevention and Control","topic":"Patient & Environment Safety","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.178.caseStudy.questions.1.stem.en","stemPathZh":"questions.178.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[64,108],"terminalOffsetsZh":[17,30],"fullStemEn":"The client needs to transfer from bed to a chair with a walker. Place the nursing actions in the best order.","fullStemZh":"患者需要使用助行器从床转移到椅子。将护理措施按最佳顺序排列。","terminalSentenceEn":"Place the nursing actions in the best order.","terminalSentenceZh":"将护理措施按最佳顺序排列。","penultimateSentenceEn":"The client needs to transfer from bed to a chair with a walker.","penultimateSentenceZh":"患者需要使用助行器从床转移到椅子。","responseContext":{"type":"ordered_response","options":[{"id":"A","en":"Apply nonskid footwear and a gait belt.","zh":"穿防滑鞋并系好步态带。"},{"id":"C","en":"Assist the client to sit at the bedside and assess dizziness before standing.","zh":"协助患者坐在床边，并在站立前评估是否头晕。"},{"id":"E","en":"Ensure the call light and needed items are within reach after the client sits.","zh":"患者坐下后确认呼叫铃和所需物品在可及范围内。"},{"id":"B","en":"Confirm the chair is locked, close to the bed, and positioned on the client's stronger side when possible.","zh":"确认椅子已锁定、靠近床边，并尽可能放在患者较有力的一侧。"},{"id":"D","en":"Cue the client to push from the bed, stand, grasp the walker, and pivot toward the chair.","zh":"提示患者从床面推起站立，握住助行器，并转身朝向椅子。"}],"correct":["B","A","C","D","E"]},"rationaleCorrectEn":"The nurse first prepares the environment, then prepares the client, assesses tolerance in sitting, assists the stand-pivot transfer safely, and finally restores access to the call light and needed items.","rationaleCorrectZh":"护士先准备环境，再准备患者，坐起后评估耐受性，安全协助站立转移，最后确保呼叫铃和所需物品可及。","testTakingStrategyEn":"For mobility sequences, prepare the environment before moving the client and reassess safety after the move.","testTakingStrategyZh":"处理活动转移排序题时，先准备环境再移动患者，移动后重新评估安全。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1402,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_rehab_pressure_bowel_02","embeddedQuestionId":"gpt_case_premium_next_case_rehab_pressure_bowel_02_cloze_skin","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.178.caseStudy.questions.2","itemType":"dropdown_cloze","category":"Basic Care and Comfort","topic":"Sleep & Rest","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.178.caseStudy.questions.2.stem.en","stemPathZh":"questions.178.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,39],"terminalOffsetsZh":[0,9],"fullStemEn":"Complete the prevention plan statement.","fullStemZh":"完成预防计划陈述。","terminalSentenceEn":"Complete the prevention plan statement.","terminalSentenceZh":"完成预防计划陈述。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The client is at increased risk for {{1}} because of {{2}}; the nurse should prioritize {{3}}.","zh":"由于 {{2}}，患者发生 {{1}} 的风险增加；护士应优先采取 {{3}}。"},"dropdowns":[{"id":"1","options":[{"id":"o2","en":"fluid overload","zh":"液体过多"},{"id":"o1","en":"pressure injury","zh":"压力性损伤"},{"id":"o3","en":"airborne infection","zh":"空气传播感染"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"night-shift work by the daughter","zh":"女儿上夜班"},{"id":"o3","en":"the prescribed stool softener","zh":"已开立软便剂"},{"id":"o1","en":"limited mobility and moisture from urinary leakage","zh":"活动受限和尿液渗漏造成潮湿"}],"correct":"o1"},{"id":"3","options":[{"id":"o3","en":"keeping the head of bed elevated at all times","zh":"始终保持床头抬高"},{"id":"o2","en":"limiting oral fluids until urinary leakage stops","zh":"在尿液渗漏停止前限制口服液体"},{"id":"o1","en":"scheduled repositioning, moisture management, and pressure redistribution","zh":"定时变换体位、管理潮湿并分散压力"}],"correct":"o1"}]},"rationaleCorrectEn":"Limited mobility, moisture, and early sacral color changes place the client at risk for pressure injury. Prevention should combine repositioning, moisture control, and pressure redistribution rather than fluid restriction or constant head elevation.","rationaleCorrectZh":"活动受限、潮湿以及骶尾部早期颜色改变使患者有压力性损伤风险。预防应结合变换体位、控制潮湿和分散压力，而不是限制饮水或始终抬高床头。","testTakingStrategyEn":"For prevention questions, choose interventions that address the cause of risk rather than a symptom in isolation.","testTakingStrategyZh":"处理预防题时，选择针对风险原因的措施，而不是孤立处理某个症状。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1403,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_rehab_pressure_bowel_02","embeddedQuestionId":"gpt_case_premium_next_case_rehab_pressure_bowel_02_fib_intake","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.178.caseStudy.questions.3","itemType":"fill_in_blank","category":"Basic Care and Comfort","topic":"Nutritional & Fluid Support","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.178.caseStudy.questions.3.stem.en","stemPathZh":"questions.178.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[165,185],"terminalOffsetsZh":[60,66],"fullStemEn":"During the day shift, the client drinks 600 mL of water, 8 oz of milk, and 0.5 L of soup. Using 1 oz = 30 mL, how many total mL of intake should the nurse document? Enter a number only.","fullStemZh":"白班期间，患者饮水600 mL、牛奶8 oz、汤0.5 L。按1 oz = 30 mL计算，护士应记录总摄入量多少mL？只输入数字。","terminalSentenceEn":"Enter a number only.","terminalSentenceZh":"只输入数字。","penultimateSentenceEn":"Using 1 oz = 30 mL, how many total mL of intake should the nurse document?","penultimateSentenceZh":"按1 oz = 30 mL计算，护士应记录总摄入量多少mL？","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"mL","zh":"毫升"},"acceptable":["1340"],"numeric":{"value":1340,"tolerance":0,"unit":"mL"}}]},"rationaleCorrectEn":"Eight ounces equals 240 mL, and 0.5 L equals 500 mL. Total intake is 600 + 240 + 500 = 1340 mL.","rationaleCorrectZh":"8盎司等于240 mL，0.5 L等于500 mL。总摄入量为600 + 240 + 500 = 1340 mL。","testTakingStrategyEn":"Convert each intake amount to the same unit before adding; do not mix ounces, liters, and milliliters.","testTakingStrategyZh":"先把每一项摄入量换算为同一单位再相加；不要混用盎司、升和毫升。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"Using 1 oz = 30 mL, how many total mL of intake should the nurse document?","controlSentenceZh":"按1 oz = 30 mL计算，护士应记录总摄入量多少mL？"}
{"queueIndex":1404,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_rehab_pressure_bowel_02","embeddedQuestionId":"gpt_case_premium_next_case_rehab_pressure_bowel_02_matrix_delegation","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.178.caseStudy.questions.4","itemType":"matrix","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.178.caseStudy.questions.4.stem.en","stemPathZh":"questions.178.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,72],"terminalOffsetsZh":[0,22],"fullStemEn":"For each care activity, select the most appropriate team member or role.","fullStemZh":"对每项护理活动，选择最合适的团队成员或角色。","terminalSentenceEn":"For each care activity, select the most appropriate team member or role.","terminalSentenceZh":"对每项护理活动，选择最合适的团队成员或角色。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Assist the client to the toilet using the established transfer plan.","zh":"按已建立的转移计划协助患者如厕。"},{"id":"r2","en":"Evaluate whether the client's sacral skin changes are worsening.","zh":"评估患者骶尾部皮肤改变是否加重。"},{"id":"r3","en":"Teach the daughter how to set up a raised toilet seat and remove trip hazards.","zh":"教女儿如何安装加高马桶座并清除绊倒隐患。"},{"id":"r4","en":"Assess gait endurance and update the walker-distance goal.","zh":"评估步态耐力并更新助行距离目标。"},{"id":"r5","en":"Review bowel pattern, fluid intake, and response to the prescribed bowel regimen.","zh":"复核排便模式、液体摄入量以及对医嘱排便方案的反应。"}],"columns":[{"id":"c1","en":"Assistive personnel","zh":"辅助护理人员"},{"id":"c4","en":"Occupational therapy","zh":"作业治疗"},{"id":"c2","en":"RN","zh":"注册护士"},{"id":"c3","en":"Physical therapy","zh":"物理治疗"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c4"]},{"rowId":"r4","columnIds":["c3"]},{"rowId":"r5","columnIds":["c2"]}]},"rationaleCorrectEn":"Assistive personnel may perform established, routine mobility assistance. The RN assesses skin and bowel response. Physical therapy evaluates gait endurance, while occupational therapy focuses on equipment and safe performance of activities of daily living.","rationaleCorrectZh":"辅助护理人员可执行已建立的常规活动协助。注册护士评估皮肤和肠道反应。物理治疗评估步态耐力，作业治疗侧重设备使用和日常生活活动安全。","testTakingStrategyEn":"Delegate routine, predictable tasks; keep assessment, evaluation, and care-plan revision with licensed professionals.","testTakingStrategyZh":"可委派常规且可预测的任务；评估、评价和护理计划修订应由有执照专业人员负责。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1405,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_caregiver_adaptation_dementia_03","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.179","itemType":"case_study","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"hard","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.179.stem.en","stemPathZh":"questions.179.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,181],"terminalOffsetsZh":[0,49],"fullStemEn":"Caregiver Strain Home Visit The client has progressive cognitive impairment, nighttime wandering, missed medications, and a spouse who reports exhaustion and fear of losing control.","fullStemZh":"照护者压力家庭访视 患者认知功能逐渐下降，夜间徘徊，漏服药物；配偶报告精疲力竭，并担心自己会失控。","terminalSentenceEn":"Caregiver Strain Home Visit The client has progressive cognitive impairment, nighttime wandering, missed medications, and a spouse who reports exhaustion and fear of losing control.","terminalSentenceZh":"照护者压力家庭访视 患者认知功能逐渐下降，夜间徘徊，漏服药物；配偶报告精疲力竭，并担心自己会失控。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This case emphasizes caregiver burden, therapeutic communication, environmental safety, nonjudgmental risk assessment, and coordinated family/community support.","rationaleCorrectZh":"本病例强调照护者负担、治疗性沟通、环境安全、非评判性风险评估，以及家庭和社区支持的协调。","testTakingStrategyEn":"When caregiver strain appears with safety concerns, prioritize immediate safety while preserving trust and mobilizing support.","testTakingStrategyZh":"当照护者压力伴随安全问题时，应优先处理即时安全，同时维持信任并调动支持。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1406,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_caregiver_adaptation_dementia_03","embeddedQuestionId":"gpt_case_premium_next_case_caregiver_adaptation_dementia_03_matrix_cues","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.179.caseStudy.questions.0","itemType":"matrix","category":"Psychosocial Integrity","topic":"Caregiver Role Strain & Family Coping","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.179.caseStudy.questions.0.stem.en","stemPathZh":"questions.179.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,56],"terminalOffsetsZh":[0,16],"fullStemEn":"For each finding, select all interpretations that apply.","fullStemZh":"对每项发现，选择所有适用的判断。","terminalSentenceEn":"For each finding, select all interpretations that apply.","terminalSentenceZh":"对每项发现，选择所有适用的判断。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"The spouse reports yelling and holding the client's wrists to stop wandering.","zh":"配偶报告曾大喊并抓住患者手腕以阻止徘徊。"},{"id":"r2","en":"The smoke alarm in the hallway is disabled.","zh":"走廊烟雾报警器被关闭。"},{"id":"r3","en":"The spouse sleeps 3 to 4 hours per night.","zh":"配偶每晚睡眠3到4小时。"},{"id":"r4","en":"Two morning doses of antihypertensive medication were missed.","zh":"降压药有两次早晨剂量漏服。"},{"id":"r5","en":"No bruising or injury is observed on the client's wrists.","zh":"患者手腕未见瘀伤或损伤。"}],"columns":[{"id":"c4","en":"Reassuring finding","zh":"令人放心的发现"},{"id":"c3","en":"Care coordination need","zh":"护理协调需求"},{"id":"c1","en":"Caregiver strain cue","zh":"照护者压力线索"},{"id":"c2","en":"Immediate safety concern","zh":"即时安全问题"}],"selectionMode":"multiple_per_row"},"correct":[{"rowId":"r1","columnIds":["c1","c2","c3"]},{"rowId":"r2","columnIds":["c2","c3"]},{"rowId":"r3","columnIds":["c1","c3"]},{"rowId":"r4","columnIds":["c3"]},{"rowId":"r5","columnIds":["c4"]}]},"rationaleCorrectEn":"The spouse's exhaustion and physical blocking of wandering raise caregiver strain and safety concerns. Disabled alarms, missed medications, and sleep deprivation require coordinated supports. Absence of wrist injury is reassuring but does not eliminate the need to address safety and strain.","rationaleCorrectZh":"配偶精疲力竭并用身体方式阻止徘徊，提示照护者压力和安全问题。报警器关闭、漏服药物和睡眠不足都需要协调支持。手腕无损伤是令人放心的，但不能排除处理安全和压力问题的必要性。","testTakingStrategyEn":"In caregiver cases, treat exhaustion, unsafe coping, and environmental hazards as linked safety cues rather than isolated social details.","testTakingStrategyZh":"在照护者相关病例中，应把疲惫、不安全应对和环境危险视为相互关联的安全线索，而不是孤立的社会信息。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1407,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_caregiver_adaptation_dementia_03","embeddedQuestionId":"gpt_case_premium_next_case_caregiver_adaptation_dementia_03_mc_response","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.179.caseStudy.questions.1","itemType":"multiple_choice","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.179.caseStudy.questions.1.stem.en","stemPathZh":"questions.179.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[76,112],"terminalOffsetsZh":[27,36],"fullStemEn":"The spouse says, \"I feel like a terrible person. I cannot keep doing this.\" Which response by the nurse is best?","fullStemZh":"配偶说：“我觉得自己是个糟糕的人。我真的撑不下去了。”护士哪项回应最佳？","terminalSentenceEn":"Which response by the nurse is best?","terminalSentenceZh":"护士哪项回应最佳？","penultimateSentenceEn":"I cannot keep doing this.\"","penultimateSentenceZh":"我真的撑不下去了。”","responseContext":{"type":"multiple_choice","options":[{"id":"C","en":"\"Most families go through this, so try not to feel guilty.\"","zh":"“大多数家庭都会经历这个，所以尽量不要内疚。”"},{"id":"A","en":"\"You are exhausted and trying to keep him safe. Let's talk about what happened and what support is needed today.\"","zh":"“您已经非常疲惫，也是在努力保护他的安全。我们谈谈发生了什么，以及今天需要哪些支持。”"},{"id":"B","en":"\"You must promise that you will never grab him again, or he may need to be placed immediately.\"","zh":"“您必须保证再也不抓他，否则他可能需要立刻被安置到机构。”"},{"id":"D","en":"\"Because there are no bruises, we can focus on medication reminders instead.\"","zh":"“因为没有瘀伤，我们可以先关注用药提醒。”"}],"correct":["A"]},"rationaleCorrectEn":"The best response validates distress without excusing unsafe behavior, invites assessment, and moves toward immediate support and safety planning.","rationaleCorrectZh":"最佳回应既认可其痛苦，又不为不安全行为开脱，同时引导评估并推进即时支持和安全计划。","testTakingStrategyEn":"Therapeutic communication should validate feelings, avoid judgment, and gather safety information when risk is present.","testTakingStrategyZh":"治疗性沟通应认可感受、避免评判，并在存在风险时收集安全信息。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1408,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_caregiver_adaptation_dementia_03","embeddedQuestionId":"gpt_case_premium_next_case_caregiver_adaptation_dementia_03_or_plan","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.179.caseStudy.questions.2","itemType":"ordered_response","category":"Management of Care","topic":"Caregiver Role Strain & Family Coping","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.179.caseStudy.questions.2.stem.en","stemPathZh":"questions.179.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,62],"terminalOffsetsZh":[0,20],"fullStemEn":"Place the nurse's actions in the best order for today's visit.","fullStemZh":"将护士在今天访视中的措施按最佳顺序排列。","terminalSentenceEn":"Place the nurse's actions in the best order for today's visit.","terminalSentenceZh":"将护士在今天访视中的措施按最佳顺序排列。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"ordered_response","options":[{"id":"A","en":"Assess whether the client and spouse are safe to remain at home today.","zh":"评估患者和配偶今天是否能安全留在家中。"},{"id":"D","en":"Request provider follow-up for nighttime agitation, sleep disruption, and missed medication doses.","zh":"请求医务人员跟进夜间躁动、睡眠受扰和漏服药物情况。"},{"id":"C","en":"Ask permission to involve the adult son and social worker in a same-week support plan.","zh":"征得同意后，让成年儿子和社工参与本周内的支持计划。"},{"id":"E","en":"Teach a written and picture-based wandering response plan, including whom to call during escalation.","zh":"使用文字和图片讲解徘徊应对计划，包括情况升级时联系谁。"},{"id":"B","en":"Re-enable or replace the smoke alarm and remove obvious tripping hazards with the spouse's permission.","zh":"在配偶同意下重新启用或更换烟雾报警器，并清除明显绊倒隐患。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"The nurse first determines immediate safety, then addresses obvious hazards, mobilizes supports, requests clinical follow-up, and teaches the practical plan for continuity.","rationaleCorrectZh":"护士先判断即时安全，再处理明显危险，调动支持资源，请求临床跟进，并讲解实际计划以保证连续性。","testTakingStrategyEn":"For care-transition sequences, protect safety first, then coordinate supports, teach, and document.","testTakingStrategyZh":"处理护理过渡排序题时，先保护安全，再协调支持、宣教并记录。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1409,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_caregiver_adaptation_dementia_03","embeddedQuestionId":"gpt_case_premium_next_case_caregiver_adaptation_dementia_03_cloze_risk","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.179.caseStudy.questions.3","itemType":"dropdown_cloze","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.179.caseStudy.questions.3.stem.en","stemPathZh":"questions.179.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,41],"terminalOffsetsZh":[0,9],"fullStemEn":"Complete the clinical judgment statement.","fullStemZh":"完成临床判断陈述。","terminalSentenceEn":"Complete the clinical judgment statement.","terminalSentenceZh":"完成临床判断陈述。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The spouse's report most strongly indicates {{1}} related to {{2}}, so the nurse should prioritize {{3}}.","zh":"配偶的报告最强烈提示 {{1}}，与 {{2}} 有关，因此护士应优先 {{3}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"caregiver role strain","zh":"照护者角色压力"},{"id":"o2","en":"ineffective denial","zh":"无效否认"},{"id":"o3","en":"decisional conflict about surgery","zh":"关于手术的决策冲突"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"sleep deprivation and escalating wandering behavior","zh":"睡眠剥夺和逐渐升级的徘徊行为"},{"id":"o2","en":"lack of interest in the client's diagnosis","zh":"对患者诊断缺乏兴趣"},{"id":"o3","en":"refusal of all community resources","zh":"拒绝所有社区资源"}],"correct":"o1"},{"id":"3","options":[{"id":"o1","en":"same-week respite and safety planning","zh":"本周内安排喘息照护和安全计划"},{"id":"o2","en":"teaching the spouse to physically block exits","zh":"教配偶用身体阻挡出口"},{"id":"o3","en":"delaying referrals until bruising is observed","zh":"等出现瘀伤后再转介"}],"correct":"o1"}]},"rationaleCorrectEn":"The spouse describes exhaustion, fear of losing control, and unsafe escalation while managing nighttime wandering. Respite and safety planning are the priority because they address both caregiver strain and immediate risk.","rationaleCorrectZh":"配偶描述了疲惫、害怕失控，以及在处理夜间徘徊时出现不安全升级。喘息照护和安全计划是优先事项，因为它们同时处理照护者压力和即时风险。","testTakingStrategyEn":"When psychosocial distress includes possible harm, choose the answer that both validates distress and creates a concrete safety plan.","testTakingStrategyZh":"当心理社会痛苦伴随潜在伤害时，应选择既认可痛苦又制定具体安全计划的答案。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1410,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_caregiver_adaptation_dementia_03","embeddedQuestionId":"gpt_case_premium_next_case_caregiver_adaptation_dementia_03_fib_respite","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.179.caseStudy.questions.4","itemType":"fill_in_blank","category":"Management of Care","topic":"Caregiver Role Strain & Family Coping","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.179.caseStudy.questions.4.stem.en","stemPathZh":"questions.179.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[180,200],"terminalOffsetsZh":[53,59],"fullStemEn":"The plan includes adult day care for 6 hours per day on 3 days each week and a respite aide for 4 hours each week. How many total hours of caregiver respite are planned each week? Enter a number only.","fullStemZh":"计划包括成人日间照护每周3天、每天6小时，以及每周4小时喘息照护员服务。每周计划的照护者喘息总时数是多少？只输入数字。","terminalSentenceEn":"Enter a number only.","terminalSentenceZh":"只输入数字。","penultimateSentenceEn":"How many total hours of caregiver respite are planned each week?","penultimateSentenceZh":"每周计划的照护者喘息总时数是多少？","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"hours per week","zh":"小时/周"},"acceptable":["22"],"numeric":{"value":22,"tolerance":0,"unit":"hours/week"}}]},"rationaleCorrectEn":"Adult day care provides 6 × 3 = 18 hours per week. Adding 4 respite-aide hours gives 22 total hours per week.","rationaleCorrectZh":"成人日间照护提供6 × 3 = 每周18小时。再加上4小时喘息照护员服务，总计每周22小时。","testTakingStrategyEn":"For resource-management calculations, compute each service separately before adding totals.","testTakingStrategyZh":"处理资源管理计算题时，先分别计算每项服务，再相加得到总数。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"How many total hours of caregiver respite are planned each week?","controlSentenceZh":"每周计划的照护者喘息总时数是多少？"}
{"queueIndex":1411,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_occupational_exposure_vaccine_04","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.180","itemType":"case_study","category":"Safety and Infection Prevention and Control","topic":"Standard Precautions & Hygiene","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.180.stem.en","stemPathZh":"questions.180.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,176],"terminalOffsetsZh":[0,49],"fullStemEn":"Sharps Injury at a Vaccination Clinic During a high-volume vaccination clinic, a nurse sustains a needlestick and identifies several workflow hazards at the injection stations.","fullStemZh":"疫苗接种诊所锐器伤 在高流量疫苗接种诊所中，一名护士发生针刺伤，并发现注射工作站存在多个流程隐患。","terminalSentenceEn":"Sharps Injury at a Vaccination Clinic During a high-volume vaccination clinic, a nurse sustains a needlestick and identifies several workflow hazards at the injection stations.","terminalSentenceZh":"疫苗接种诊所锐器伤 在高流量疫苗接种诊所中，一名护士发生针刺伤，并发现注射工作站存在多个流程隐患。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This case emphasizes occupational exposure response, sharps safety, privacy-conscious source follow-up, employee-health coordination, quality improvement, and resource planning.","rationaleCorrectZh":"本病例强调职业暴露处理、锐器安全、保护隐私的源患者随访、员工健康协调、质量改进和资源计划。","testTakingStrategyEn":"For infection-prevention cases, act immediately on exposure safety, then correct the workflow that allowed the exposure to occur.","testTakingStrategyZh":"在感染预防病例中，应立即处理暴露安全问题，然后纠正导致暴露发生的流程。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1412,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_occupational_exposure_vaccine_04","embeddedQuestionId":"gpt_case_premium_next_case_occupational_exposure_vaccine_04_or_initial","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.180.caseStudy.questions.0","itemType":"ordered_response","category":"Safety and Infection Prevention and Control","topic":"Standard Precautions & Hygiene","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.180.caseStudy.questions.0.stem.en","stemPathZh":"questions.180.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,73],"terminalOffsetsZh":[0,21],"fullStemEn":"Place the nurse's actions in the best order after the needlestick injury.","fullStemZh":"针刺伤发生后，将护士的措施按最佳顺序排列。","terminalSentenceEn":"Place the nurse's actions in the best order after the needlestick injury.","terminalSentenceZh":"针刺伤发生后，将护士的措施按最佳顺序排列。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"ordered_response","options":[{"id":"D","en":"Identify the source client's information according to clinic privacy policy.","zh":"按诊所隐私政策确认源患者信息。"},{"id":"C","en":"Report the exposure to the charge nurse or supervisor immediately.","zh":"立即向负责护士或主管报告暴露。"},{"id":"B","en":"Arrange for another qualified staff member to continue vaccinating clients.","zh":"安排另一名合格工作人员继续为患者接种。"},{"id":"A","en":"Wash the puncture site with soap and water.","zh":"用肥皂和清水清洗穿刺部位。"},{"id":"E","en":"Contact employee health for exposure risk assessment and postexposure recommendations.","zh":"联系员工健康部门进行暴露风险评估和暴露后建议。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"The nurse first performs immediate first aid, ensures client care continues safely, reports the exposure without delay, preserves source-client follow-up, and obtains employee-health guidance.","rationaleCorrectZh":"护士首先进行即时急救，确保患者护理安全继续，立即报告暴露，保留源患者随访信息，并获得员工健康指导。","testTakingStrategyEn":"For exposure sequences, do first aid first, then activate reporting and follow-up systems; paperwork follows urgent safety actions.","testTakingStrategyZh":"处理暴露排序题时，先做急救，再启动报告和随访系统；文书记录应在紧急安全措施之后。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1413,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_occupational_exposure_vaccine_04","embeddedQuestionId":"gpt_case_premium_next_case_occupational_exposure_vaccine_04_matrix_practices","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.180.caseStudy.questions.1","itemType":"matrix","category":"Safety and Infection Prevention and Control","topic":"PPE & Sterile Technique","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.180.caseStudy.questions.1.stem.en","stemPathZh":"questions.180.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,45],"terminalOffsetsZh":[0,16],"fullStemEn":"Classify each finding from the clinic review.","fullStemZh":"对诊所复核中的每项发现进行分类。","terminalSentenceEn":"Classify each finding from the clinic review.","terminalSentenceZh":"对诊所复核中的每项发现进行分类。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"The used needle's safety device had not been activated.","zh":"使用过的针头安全装置未被启动。"},{"id":"r2","en":"The sharps container is above the fill line.","zh":"锐器盒已超过装填线。"},{"id":"r3","en":"The source client left but contact information is available through registration.","zh":"源患者已离开，但登记处有联系方式。"},{"id":"r4","en":"Some needles are recapped when the safety device is hard to activate quickly.","zh":"当安全装置难以快速启动时，有些针头会被重新套帽。"},{"id":"r5","en":"The exposed nurse completed a hepatitis B vaccine series but does not know whether a titer was documented.","zh":"受伤护士完成过乙肝疫苗系列接种，但不知道是否有抗体滴度记录。"}],"columns":[{"id":"c2","en":"Exposure follow-up need","zh":"暴露随访需求"},{"id":"c1","en":"Unsafe sharps practice","zh":"不安全锐器操作"},{"id":"c3","en":"No action needed","zh":"无需处理"}],"selectionMode":"multiple_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c1"]},{"rowId":"r5","columnIds":["c2"]}]},"rationaleCorrectEn":"Failure to activate safety devices, overfilled sharps containers, and recapping are unsafe sharps practices. Available source-client contact information and uncertain hepatitis B immunity documentation require exposure follow-up.","rationaleCorrectZh":"未启动安全装置、锐器盒过满和重新套帽都是不安全锐器操作。源患者联系方式可用以及乙肝免疫记录不确定，都需要暴露随访。","testTakingStrategyEn":"Distinguish unsafe workflow causes from follow-up tasks needed because an exposure already occurred.","testTakingStrategyZh":"区分导致不安全流程的原因，以及因暴露已经发生而需要的随访任务。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1414,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_occupational_exposure_vaccine_04","embeddedQuestionId":"gpt_case_premium_next_case_occupational_exposure_vaccine_04_sata_qi","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.180.caseStudy.questions.2","itemType":"select_all","category":"Safety and Infection Prevention and Control","topic":"Standard Precautions & Hygiene","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.180.caseStudy.questions.2.stem.en","stemPathZh":"questions.180.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[62,84],"terminalOffsetsZh":[14,22],"fullStemEn":"Which changes should the quality-improvement nurse recommend? Select all that apply.","fullStemZh":"质量改进护士应建议哪些改变？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which changes should the quality-improvement nurse recommend?","penultimateSentenceZh":"质量改进护士应建议哪些改变？","responseContext":{"type":"select_all","options":[{"id":"A","en":"Place an approved sharps container at each injection station.","zh":"在每个注射工作站放置合规锐器盒。"},{"id":"B","en":"Replace sharps containers before they exceed the fill line.","zh":"在锐器盒超过装填线前更换。"},{"id":"D","en":"Require staff to recap needles before carrying them to the shared container.","zh":"要求工作人员在把针头拿到共用锐器盒前重新套帽。"},{"id":"C","en":"Teach staff to activate the safety device immediately after use as designed.","zh":"教导工作人员按设计在使用后立即启动安全装置。"},{"id":"E","en":"Use nonpunitive reporting to identify workflow barriers and near misses.","zh":"使用非惩罚性报告来识别流程障碍和险些发生的事件。"}],"correct":["A","B","C","E"]},"rationaleCorrectEn":"Point-of-use disposal, timely replacement of full containers, correct safety-device activation, and nonpunitive reporting address system causes of sharps injuries. Recapping and storing used syringes on trays increase risk.","rationaleCorrectZh":"就近丢弃、及时更换已满锐器盒、正确启动安全装置以及非惩罚性报告可处理锐器伤的系统性原因。重新套帽和把用过的注射器放在托盘上会增加风险。","testTakingStrategyEn":"For quality-improvement items, choose system fixes that make the safe action easy and the unsafe action unnecessary.","testTakingStrategyZh":"处理质量改进题时，选择能让安全行为更容易、让不安全行为没有必要的系统性改进。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"Which changes should the quality-improvement nurse recommend?","controlSentenceZh":"质量改进护士应建议哪些改变？"}
{"queueIndex":1415,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_occupational_exposure_vaccine_04","embeddedQuestionId":"gpt_case_premium_next_case_occupational_exposure_vaccine_04_cloze_exposure","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.180.caseStudy.questions.3","itemType":"dropdown_cloze","category":"Safety and Infection Prevention and Control","topic":"Standard Precautions & Hygiene","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.180.caseStudy.questions.3.stem.en","stemPathZh":"questions.180.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,43],"terminalOffsetsZh":[0,9],"fullStemEn":"Complete the exposure-management statement.","fullStemZh":"完成暴露处理陈述。","terminalSentenceEn":"Complete the exposure-management statement.","terminalSentenceZh":"完成暴露处理陈述。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"This event is a {{1}} exposure; the nurse should first {{2}} and then {{3}}.","zh":"该事件属于 {{1}} 暴露；护士应先 {{2}}，然后 {{3}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"percutaneous","zh":"经皮"},{"id":"o3","en":"foodborne","zh":"食源性"},{"id":"o2","en":"airborne","zh":"空气传播"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"wash the puncture site with soap and water","zh":"用肥皂和清水清洗穿刺部位"},{"id":"o2","en":"squeeze the finger until bleeding stops","zh":"挤压手指直到出血停止"},{"id":"o3","en":"finish vaccinating the waiting clients","zh":"先完成等待患者的接种"}],"correct":"o1"},{"id":"3","options":[{"id":"o1","en":"contact employee health for risk assessment","zh":"联系员工健康部门进行风险评估"},{"id":"o2","en":"discard all documentation to protect the source client's privacy","zh":"丢弃所有记录以保护源患者隐私"},{"id":"o3","en":"wait until symptoms develop before reporting","zh":"等出现症状后再报告"}],"correct":"o1"}]},"rationaleCorrectEn":"A needlestick is a percutaneous exposure. The nurse should perform immediate wound care and promptly contact employee health for risk assessment and recommendations.","rationaleCorrectZh":"针刺伤属于经皮暴露。护士应立即处理伤口，并及时联系员工健康部门进行风险评估和建议。","testTakingStrategyEn":"Match the route of exposure to the immediate action; needlestick injuries require prompt first aid and occupational-health follow-up.","testTakingStrategyZh":"将暴露途径与即时措施相匹配；针刺伤需要及时急救和职业健康随访。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1416,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_occupational_exposure_vaccine_04","embeddedQuestionId":"gpt_case_premium_next_case_occupational_exposure_vaccine_04_fib_supplies","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.180.caseStudy.questions.4","itemType":"fill_in_blank","category":"Management of Care","topic":"Prioritization & Delegation","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.180.caseStudy.questions.4.stem.en","stemPathZh":"questions.180.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[150,170],"terminalOffsetsZh":[36,42],"fullStemEn":"The next clinic is expected to administer 118 vaccines. Safety syringes are supplied in boxes of 50. What is the minimum number of full boxes needed? Enter a number only.","fullStemZh":"下一次诊所预计接种118剂疫苗。安全注射器每盒50支。至少需要多少整盒？只输入数字。","terminalSentenceEn":"Enter a number only.","terminalSentenceZh":"只输入数字。","penultimateSentenceEn":"What is the minimum number of full boxes needed?","penultimateSentenceZh":"至少需要多少整盒？","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"boxes","zh":"盒"},"acceptable":["3"],"numeric":{"value":3,"tolerance":0,"unit":"boxes"}}]},"rationaleCorrectEn":"Two boxes provide only 100 syringes, which is not enough for 118 vaccines. Three boxes provide 150 syringes, so 3 full boxes are needed.","rationaleCorrectZh":"两盒只有100支注射器，不足以接种118剂。三盒有150支，因此需要3整盒。","testTakingStrategyEn":"When supplies come only in whole packages, round up to ensure the clinic has enough materials.","testTakingStrategyZh":"当物资只能按整包装提供时，应向上取整以确保诊所材料充足。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"What is the minimum number of full boxes needed?","controlSentenceZh":"至少需要多少整盒？"}
{"queueIndex":1417,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_preventive_screening_vaccine_05","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.181","itemType":"case_study","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"hard","ngnSkill":"generate_solutions","stemPathEn":"questions.181.stem.en","stemPathZh":"questions.181.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,207],"terminalOffsetsZh":[0,52],"fullStemEn":"Preventive Care Catch-Up Visit The client wants to address only what is necessary for a volunteer clearance form but has several overdue preventive-care needs and concerns about screening tests and vaccines.","fullStemZh":"预防保健补做门诊 患者只想完成志愿者审核表所需项目，但存在多项逾期的预防保健需求，并对筛查和疫苗有顾虑。","terminalSentenceEn":"Preventive Care Catch-Up Visit The client wants to address only what is necessary for a volunteer clearance form but has several overdue preventive-care needs and concerns about screening tests and vaccines.","terminalSentenceZh":"预防保健补做门诊 患者只想完成志愿者审核表所需项目，但存在多项逾期的预防保健需求，并对筛查和疫苗有顾虑。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This case emphasizes adult preventive screening, vaccination counseling, health literacy, shared decision-making, and care coordination.","rationaleCorrectZh":"本病例强调成人预防筛查、疫苗宣教、健康素养、共同决策和护理协调。","testTakingStrategyEn":"In preventive-care cases, identify overdue services, reduce access barriers, and verify that the client can complete the chosen plan.","testTakingStrategyZh":"在预防保健病例中，要识别逾期服务，减少可及性障碍，并确认患者能完成所选计划。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1418,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_preventive_screening_vaccine_05","embeddedQuestionId":"gpt_case_premium_next_case_preventive_screening_vaccine_05_matrix_needs","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.181.caseStudy.questions.0","itemType":"matrix","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.181.caseStudy.questions.0.stem.en","stemPathZh":"questions.181.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,69],"terminalOffsetsZh":[0,17],"fullStemEn":"For each finding, select the most appropriate nursing interpretation.","fullStemZh":"对每项发现，选择最合适的护理判断。","terminalSentenceEn":"For each finding, select the most appropriate nursing interpretation.","terminalSentenceZh":"对每项发现，选择最合适的护理判断。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"No colorectal cancer screening at age 52","zh":"52岁从未接受结直肠癌筛查"},{"id":"r2","en":"No mammogram in 8 years","zh":"8年未做乳腺X线筛查"},{"id":"r3","en":"No shingles vaccine at age 52","zh":"52岁未接种带状疱疹疫苗"},{"id":"r4","en":"Last tetanus booster more than 10 years ago","zh":"最后一次破伤风加强针已超过10年"},{"id":"r5","en":"Blood pressure 136/84 mm Hg without symptoms","zh":"无症状血压136/84 mm Hg"}],"columns":[{"id":"c2","en":"Needs vaccination counseling","zh":"需要疫苗宣教"},{"id":"c1","en":"Needs screening or referral","zh":"需要筛查或转介"},{"id":"c3","en":"Needs routine follow-up, not urgent care","zh":"需要常规随访，而非紧急处理"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c2"]},{"rowId":"r5","columnIds":["c3"]}]},"rationaleCorrectEn":"The client has overdue cancer screening and overdue adult immunization needs. The blood pressure finding warrants primary care follow-up and lifestyle counseling but does not require emergency care in the absence of symptoms.","rationaleCorrectZh":"患者存在逾期的癌症筛查和成人免疫接种需求。该血压值需要初级保健随访和生活方式宣教，但在无症状情况下不需要急诊处理。","testTakingStrategyEn":"Preventive-care questions often ask you to separate overdue screening or immunization from findings that need routine monitoring rather than urgent action.","testTakingStrategyZh":"预防保健题常要求区分逾期筛查或免疫接种与只需常规监测、无需紧急处理的发现。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1419,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_preventive_screening_vaccine_05","embeddedQuestionId":"gpt_case_premium_next_case_preventive_screening_vaccine_05_cloze_crc","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.181.caseStudy.questions.1","itemType":"dropdown_cloze","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.181.caseStudy.questions.1.stem.en","stemPathZh":"questions.181.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,66],"terminalOffsetsZh":[0,16],"fullStemEn":"Complete the statement about colorectal cancer screening teaching.","fullStemZh":"完成关于结直肠癌筛查宣教的陈述。","terminalSentenceEn":"Complete the statement about colorectal cancer screening teaching.","terminalSentenceZh":"完成关于结直肠癌筛查宣教的陈述。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"Because the client is {{1}} and has not been screened, the nurse should explain that {{2}} is an acceptable initial option if the client cannot miss work for colonoscopy, and any positive result requires {{3}}.","zh":"由于患者 {{1}} 且从未筛查，护士应说明：如果患者无法请假做肠镜，{{2}} 可作为可接受的初始选择；任何阳性结果都需要 {{3}}。"},"dropdowns":[{"id":"1","options":[{"id":"o3","en":"eligible only if symptoms develop","zh":"只有出现症状后才符合筛查条件"},{"id":"o1","en":"within the routine adult screening age range","zh":"处于成人常规筛查年龄范围内"},{"id":"o2","en":"too young for any colorectal cancer screening","zh":"年龄太小，不需要任何结直肠癌筛查"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"a stool-based screening test","zh":"粪便筛查试验"},{"id":"o2","en":"waiting until abdominal pain occurs","zh":"等到出现腹痛再处理"},{"id":"o3","en":"a home blood pressure log","zh":"家庭血压记录"}],"correct":"o1"},{"id":"3","options":[{"id":"o2","en":"a tetanus booster only","zh":"只需破伤风加强针"},{"id":"o1","en":"colonoscopy follow-up","zh":"肠镜随访检查"},{"id":"o3","en":"no additional testing","zh":"无需进一步检查"}],"correct":"o1"}]},"rationaleCorrectEn":"A 52-year-old adult who has not been screened should be offered colorectal cancer screening. Stool-based testing may reduce access barriers, but a positive stool-based result needs colonoscopy follow-up.","rationaleCorrectZh":"52岁且从未筛查的成人应接受结直肠癌筛查。粪便筛查可降低就医障碍，但粪便试验阳性需要肠镜随访。","testTakingStrategyEn":"When a client refuses or cannot access the most familiar screening test, look for another recommended option rather than abandoning screening.","testTakingStrategyZh":"当患者拒绝或无法获得最熟悉的筛查方式时，应寻找其他推荐选择，而不是放弃筛查。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1420,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_preventive_screening_vaccine_05","embeddedQuestionId":"gpt_case_premium_next_case_preventive_screening_vaccine_05_or_teaching","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.181.caseStudy.questions.2","itemType":"ordered_response","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.181.caseStudy.questions.2.stem.en","stemPathZh":"questions.181.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,87],"terminalOffsetsZh":[0,26],"fullStemEn":"Place the nurse's actions in the best order to support preventive-care decision-making.","fullStemZh":"将护士支持患者进行预防保健决策的措施按最佳顺序排列。","terminalSentenceEn":"Place the nurse's actions in the best order to support preventive-care decision-making.","terminalSentenceZh":"将护士支持患者进行预防保健决策的措施按最佳顺序排列。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"ordered_response","options":[{"id":"A","en":"Ask what the client already knows and what worries the client most about screening and vaccines.","zh":"询问患者已经了解什么，以及对筛查和疫苗最担心什么。"},{"id":"E","en":"Schedule referrals or appointments and document barriers that still need follow-up.","zh":"安排转介或预约，并记录仍需跟进的障碍。"},{"id":"B","en":"Prioritize one or two overdue preventive actions that the client is willing to complete first.","zh":"优先选择一到两项患者愿意先完成的逾期预防措施。"},{"id":"D","en":"Ask the client to teach back the selected plan, including when and where each step will happen.","zh":"请患者用自己的话复述所选计划，包括每一步何时何地进行。"},{"id":"C","en":"Use large-print, plain-language materials to explain options, benefits, and next steps.","zh":"使用大号字体、通俗语言材料解释选择、益处和后续步骤。"}],"correct":["A","C","B","D","E"]},"rationaleCorrectEn":"The nurse first assesses understanding and concerns, then gives accessible information, helps the client choose a realistic starting plan, verifies understanding with teach-back, and finally schedules and documents follow-up needs.","rationaleCorrectZh":"护士先评估患者理解和顾虑，再提供易懂信息，帮助患者选择现实可行的起始计划，用回授法确认理解，最后安排并记录随访需求。","testTakingStrategyEn":"For counseling sequences, avoid jumping straight to instructions; assess concerns, tailor teaching, then confirm understanding.","testTakingStrategyZh":"处理咨询排序题时，不要直接给指令；先评估顾虑，个体化宣教，再确认理解。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1421,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_preventive_screening_vaccine_05","embeddedQuestionId":"gpt_case_premium_next_case_preventive_screening_vaccine_05_sata_plan","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.181.caseStudy.questions.3","itemType":"select_all","category":"Management of Care","topic":"Discharge Planning & Handoff","difficulty":"medium","ngnSkill":"generate_solutions","stemPathEn":"questions.181.caseStudy.questions.3.stem.en","stemPathZh":"questions.181.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[60,82],"terminalOffsetsZh":[16,24],"fullStemEn":"Which actions should the nurse include in the plan of care? Select all that apply.","fullStemZh":"护士应在护理计划中包括哪些措施？选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"选择所有适用项。","penultimateSentenceEn":"Which actions should the nurse include in the plan of care?","penultimateSentenceZh":"护士应在护理计划中包括哪些措施？","responseContext":{"type":"select_all","options":[{"id":"E","en":"Use teach-back to confirm how the client will complete the selected screening steps.","zh":"使用回授法确认患者将如何完成所选筛查步骤。"},{"id":"A","en":"Offer a stool-based colorectal cancer screening kit with picture-based instructions.","zh":"提供粪便结直肠癌筛查试剂盒及图示说明。"},{"id":"D","en":"Review expected vaccine effects and timing options to reduce work-schedule barriers.","zh":"说明疫苗常见反应和时间安排选择，以减少工作时间障碍。"},{"id":"C","en":"Tell the client that colonoscopy is the only acceptable screening method.","zh":"告诉患者肠镜是唯一可接受的筛查方法。"},{"id":"B","en":"Schedule mammography at a location the client can reach by public transportation.","zh":"安排患者可乘公共交通到达地点的乳腺X线检查。"}],"correct":["A","B","D","E"]},"rationaleCorrectEn":"The nurse should reduce access and literacy barriers, coordinate reachable screening, address vaccine concerns, and confirm understanding. Screening options should not be falsely limited, and vaccines do not need to wait for completion of cancer screening.","rationaleCorrectZh":"护士应减少可及性和健康素养障碍，协调可到达的筛查，处理疫苗顾虑，并确认理解。不应错误限制筛查选择，疫苗也不需要等所有癌症筛查完成后再接种。","testTakingStrategyEn":"Select actions that remove barriers and preserve valid choices; reject absolute statements that unnecessarily delay prevention.","testTakingStrategyZh":"选择能减少障碍并保留合理选择的措施；排除不必要延迟预防的绝对化说法。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1422,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_preventive_screening_vaccine_05","embeddedQuestionId":"gpt_case_premium_next_case_preventive_screening_vaccine_05_fib_activity","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.181.caseStudy.questions.4","itemType":"fill_in_blank","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.181.caseStudy.questions.4.stem.en","stemPathZh":"questions.181.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[151,171],"terminalOffsetsZh":[39,45],"fullStemEn":"The client chooses a first activity goal of brisk walking 25 minutes per day on 6 days each week. How many minutes per week should the nurse document? Enter a number only.","fullStemZh":"患者选择的首个活动目标是每周6天、每天快走25分钟。护士应记录为每周多少分钟？只输入数字。","terminalSentenceEn":"Enter a number only.","terminalSentenceZh":"只输入数字。","penultimateSentenceEn":"How many minutes per week should the nurse document?","penultimateSentenceZh":"护士应记录为每周多少分钟？","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"minutes per week","zh":"分钟/周"},"acceptable":["150"],"numeric":{"value":150,"tolerance":0,"unit":"minutes/week"}}]},"rationaleCorrectEn":"Twenty-five minutes per day multiplied by 6 days per week equals 150 minutes per week.","rationaleCorrectZh":"每天25分钟乘以每周6天，等于每周150分钟。","testTakingStrategyEn":"For goal calculations, multiply the amount per day by the number of days and verify the requested unit.","testTakingStrategyZh":"计算目标时，用每天的量乘以天数，并确认题目要求的单位。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1423,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_ipv_safety_planning_06","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.182","itemType":"case_study","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"hard","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.182.stem.en","stemPathZh":"questions.182.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,183],"terminalOffsetsZh":[0,49],"fullStemEn":"Private Screening and Safety Planning The client presents with an injury, a controlling partner, and concerns about privacy, safe communication, and leaving with resources discreetly.","fullStemZh":"私下筛查与安全计划 患者因受伤就诊，同时伴有控制型伴侣，并担心隐私、安全沟通以及如何低调带走资源。","terminalSentenceEn":"Private Screening and Safety Planning The client presents with an injury, a controlling partner, and concerns about privacy, safe communication, and leaving with resources discreetly.","terminalSentenceZh":"私下筛查与安全计划 患者因受伤就诊，同时伴有控制型伴侣，并担心隐私、安全沟通以及如何低调带走资源。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This case emphasizes psychosocial safety, therapeutic communication, private screening, confidentiality, safety planning, and interprofessional support.","rationaleCorrectZh":"本病例强调心理社会安全、治疗性沟通、私下筛查、保密、安全计划和跨专业支持。","testTakingStrategyEn":"In IPV cases, protect privacy, assess immediate danger, validate the client, and offer resources without forcing decisions.","testTakingStrategyZh":"在亲密伴侣暴力病例中，要保护隐私，评估即时危险，肯定患者，并在不强迫决定的情况下提供资源。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1424,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_ipv_safety_planning_06","embeddedQuestionId":"gpt_case_premium_next_case_ipv_safety_planning_06_matrix_cues","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.182.caseStudy.questions.0","itemType":"matrix","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.182.caseStudy.questions.0.stem.en","stemPathZh":"questions.182.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,56],"terminalOffsetsZh":[0,16],"fullStemEn":"For each finding, select all interpretations that apply.","fullStemZh":"对每项发现，选择所有适用的判断。","terminalSentenceEn":"For each finding, select all interpretations that apply.","terminalSentenceZh":"对每项发现，选择所有适用的判断。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Partner answers most questions and keeps a hand on the client's shoulder.","zh":"伴侣代答大多数问题，并一直把手放在患者肩上。"},{"id":"r2","en":"Bruising is present in different stages of healing.","zh":"存在不同愈合阶段的瘀伤。"},{"id":"r3","en":"The client says the phone and online portal are checked.","zh":"患者说手机和线上门户会被检查。"},{"id":"r4","en":"The client is not ready to leave the relationship today.","zh":"患者今天还没有准备好离开这段关系。"},{"id":"r5","en":"The client denies suicidal thoughts and reports no weapons in the home.","zh":"患者否认自杀想法，并报告家中没有武器。"}],"columns":[{"id":"c2","en":"Affects confidentiality or safety planning","zh":"影响保密或安全计划"},{"id":"c1","en":"Supports concern for abuse or control","zh":"支持虐待或控制担忧"},{"id":"c3","en":"Protective or reassuring cue, but continue assessment","zh":"保护性或令人放心的线索，但仍需继续评估"}],"selectionMode":"multiple_per_row"},"correct":[{"rowId":"r1","columnIds":["c1","c2"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c1","c2"]},{"rowId":"r4","columnIds":["c2"]},{"rowId":"r5","columnIds":["c3"]}]},"rationaleCorrectEn":"The partner's control, repeated bruising, monitored communication, and the client's readiness all shape safety planning. Denial of suicidal thoughts and no weapons are reassuring but do not rule out danger or the need for support.","rationaleCorrectZh":"伴侣控制、反复瘀伤、通信被监控以及患者的准备程度都会影响安全计划。否认自杀想法和家中无武器令人相对放心，但不能排除危险或支持需求。","testTakingStrategyEn":"In IPV questions, look for control and privacy risks, not only visible injuries or whether the client is ready to leave.","testTakingStrategyZh":"处理亲密伴侣暴力题时，要关注控制和隐私风险，不只看可见伤害或患者是否准备离开。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1425,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_ipv_safety_planning_06","embeddedQuestionId":"gpt_case_premium_next_case_ipv_safety_planning_06_mc_communication","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.182.caseStudy.questions.1","itemType":"multiple_choice","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.182.caseStudy.questions.1.stem.en","stemPathZh":"questions.182.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,96],"terminalOffsetsZh":[0,27],"fullStemEn":"Which response by the nurse is most therapeutic after the client says, \"I'm not ready to leave\"?","fullStemZh":"患者说“我还没准备好离开”后，护士哪项回应最具治疗性？","terminalSentenceEn":"Which response by the nurse is most therapeutic after the client says, \"I'm not ready to leave\"?","terminalSentenceZh":"患者说“我还没准备好离开”后，护士哪项回应最具治疗性？","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"multiple_choice","options":[{"id":"C","en":"\"I will bring your partner in so we can hear both sides of the story.\"","zh":"“我会把你的伴侣叫进来，这样我们能听听双方说法。”"},{"id":"A","en":"\"You are the expert on your safety. I am concerned about what happened, and we can talk about options that do not require you to decide today.\"","zh":"“你最了解自己的安全状况。我担心发生的事，我们可以谈谈不需要你今天就做决定的选择。”"},{"id":"D","en":"\"You should promise me you will call the police as soon as you get home.\"","zh":"“你应该向我保证一回家就报警。”"},{"id":"B","en":"\"If you do not leave now, there is nothing useful we can do for you today.\"","zh":"“如果你现在不离开，我们今天就没有什么能帮你的了。”"}],"correct":["A"]},"rationaleCorrectEn":"The therapeutic response validates autonomy, expresses concern, and offers options without pressuring the client to leave immediately. Pressuring, blaming, or involving the partner can increase danger and reduce trust.","rationaleCorrectZh":"治疗性回应应尊重自主，表达关切，并在不强迫患者立即离开的情况下提供选择。施压、责备或让伴侣参与可能增加危险并降低信任。","testTakingStrategyEn":"Therapeutic IPV responses validate, support autonomy, and avoid pressuring the client into a single action.","testTakingStrategyZh":"亲密伴侣暴力情境中的治疗性回应应肯定、支持自主，并避免强迫患者采取单一行动。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1426,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_ipv_safety_planning_06","embeddedQuestionId":"gpt_case_premium_next_case_ipv_safety_planning_06_or_actions","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.182.caseStudy.questions.2","itemType":"ordered_response","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.182.caseStudy.questions.2.stem.en","stemPathZh":"questions.182.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,108],"terminalOffsetsZh":[0,26],"fullStemEn":"Place the nurse's actions in the best order after the client discloses the injury was caused by the partner.","fullStemZh":"患者透露伤害由伴侣造成后，将护士措施按最佳顺序排列。","terminalSentenceEn":"Place the nurse's actions in the best order after the client discloses the injury was caused by the partner.","terminalSentenceZh":"患者透露伤害由伴侣造成后，将护士措施按最佳顺序排列。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"ordered_response","options":[{"id":"B","en":"Assess immediate danger, suicidal thoughts, weapons, and whether the client has a safe place or contact.","zh":"评估即时危险、自杀想法、武器情况，以及患者是否有安全地点或联系人。"},{"id":"A","en":"Maintain privacy and ensure the partner does not re-enter the room during the conversation.","zh":"保持隐私，确保谈话期间伴侣不再进入房间。"},{"id":"D","en":"Offer private access to the social worker or domestic violence advocate.","zh":"提供与社工或家庭暴力倡导员私下接触的机会。"},{"id":"C","en":"Validate the disclosure and tell the client the abuse is not the client's fault.","zh":"肯定患者的透露，并告诉患者虐待不是患者的错。"},{"id":"E","en":"Create a discreet discharge and follow-up plan that avoids unsafe portal messages or obvious printed materials.","zh":"制定低调的出院和随访计划，避免不安全的门户信息或明显纸质材料。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"The nurse first preserves privacy, then assesses immediate safety risks, validates the client, offers specialized support, and creates a discreet follow-up plan that does not increase danger after discharge.","rationaleCorrectZh":"护士先保护隐私，再评估即时安全风险，肯定患者，提供专业支持，并制定不会在出院后增加危险的低调随访计划。","testTakingStrategyEn":"For IPV sequences, protect privacy first, assess immediate danger, then offer resources and plan safe communication.","testTakingStrategyZh":"处理亲密伴侣暴力排序题时，先保护隐私，评估即时危险，再提供资源并规划安全沟通。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1427,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_ipv_safety_planning_06","embeddedQuestionId":"gpt_case_premium_next_case_ipv_safety_planning_06_cloze_privacy","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.182.caseStudy.questions.3","itemType":"dropdown_cloze","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"hard","ngnSkill":"generate_solutions","stemPathEn":"questions.182.caseStudy.questions.3.stem.en","stemPathZh":"questions.182.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,58],"terminalOffsetsZh":[0,14],"fullStemEn":"Complete the statement about safe discharge communication.","fullStemZh":"完成关于安全出院沟通的陈述。","terminalSentenceEn":"Complete the statement about safe discharge communication.","terminalSentenceZh":"完成关于安全出院沟通的陈述。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"Because the client's {{1}} is monitored, the nurse should avoid {{2}} and instead offer {{3}} if the client agrees.","zh":"由于患者的 {{1}} 被监控，护士应避免 {{2}}，若患者同意，可改为提供 {{3}}。"},"dropdowns":[{"id":"1","options":[{"id":"o3","en":"wrist range of motion","zh":"腕部活动范围"},{"id":"o2","en":"distal pulse","zh":"远端脉搏"},{"id":"o1","en":"phone and online portal","zh":"手机和线上门户"}],"correct":"o1"},{"id":"2","options":[{"id":"o2","en":"objective documentation of the injury assessment","zh":"客观记录伤情评估"},{"id":"o3","en":"asking whether the client has a safe contact","zh":"询问患者是否有安全联系人"},{"id":"o1","en":"sending domestic violence resources through the portal or printing obvious instructions","zh":"通过门户发送家庭暴力资源或打印明显说明"}],"correct":"o1"},{"id":"3","options":[{"id":"o1","en":"a discreet safety card and neutral follow-up wording","zh":"低调的安全卡和中性随访措辞"},{"id":"o2","en":"a voicemail on the shared phone","zh":"在共用手机上留下语音信息"},{"id":"o3","en":"a confrontation with the partner before discharge","zh":"出院前与伴侣当面对质"}],"correct":"o1"}]},"rationaleCorrectEn":"When communication is monitored, routine electronic messages or obvious printed resources can increase danger. A discreet resource and neutral follow-up plan better protect confidentiality while preserving access to help.","rationaleCorrectZh":"当通信被监控时，常规电子信息或明显纸质资源可能增加危险。低调资源和中性随访计划能更好保护保密性，同时保留获得帮助的途径。","testTakingStrategyEn":"Confidentiality is part of safety; reject actions that create a digital or paper trail an abusive partner may find.","testTakingStrategyZh":"保密是安全的一部分；排除可能被施暴伴侣发现的电子或纸质痕迹。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1428,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_premium_next_case_ipv_safety_planning_06","embeddedQuestionId":"gpt_case_premium_next_case_ipv_safety_planning_06_fib_gobag","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.182.caseStudy.questions.4","itemType":"fill_in_blank","category":"Psychosocial Integrity","topic":"Suicide & Crisis Intervention","difficulty":"medium","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.182.caseStudy.questions.4.stem.en","stemPathZh":"questions.182.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[168,188],"terminalOffsetsZh":[46,52],"fullStemEn":"The client wants to place a 7-day supply of two once-daily prescribed medications in a safe bag, using correctly labeled containers. How many total tablets are needed? Enter a number only.","fullStemZh":"患者希望在安全包中放入两种每日一次处方药的7天用量，并使用正确标签的容器。总共需要多少片药？只输入数字。","terminalSentenceEn":"Enter a number only.","terminalSentenceZh":"只输入数字。","penultimateSentenceEn":"How many total tablets are needed?","penultimateSentenceZh":"总共需要多少片药？","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"tablets","zh":"片"},"acceptable":["14"],"numeric":{"value":14,"tolerance":0,"unit":"tablets"}}]},"rationaleCorrectEn":"Two once-daily medications require 2 tablets per day. For 7 days, 2 × 7 = 14 tablets total.","rationaleCorrectZh":"两种每日一次药物每天共需2片。7天为2 × 7 = 14片。","testTakingStrategyEn":"For simple medication-supply calculations, identify tablets per day first, then multiply by the number of days requested.","testTakingStrategyZh":"计算简单备药量时，先确定每日片数，再乘以所需天数。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1429,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_tls_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.183","itemType":"case_study","category":"Reduction of Risk Potential","topic":"Oncology & Immunotherapy Complications","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.183.stem.en","stemPathZh":"questions.183.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[205,402],"terminalOffsetsZh":[60,125],"fullStemEn":"Tumor lysis syndrome after chemotherapy for high-burden lymphoma A client with newly diagnosed Burkitt lymphoma and bulky abdominal disease begins chemotherapy after hydration and rasburicase prophylaxis. Over the next 24 hours, the nurse must recognize evolving tumor lysis syndrome, prioritize life-threatening hyperkalemia, implement ordered emergency interventions, and evaluate treatment response.","fullStemZh":"高肿瘤负荷淋巴瘤化疗后的肿瘤溶解综合征 一名新诊断伯基特淋巴瘤并伴有巨大腹部肿块的患者，在补液和拉布立酶预防后开始化疗。接下来的 24 小时内，护士必须识别进展中的肿瘤溶解综合征，优先处理危及生命的高钾血症，执行已开立的紧急处理措施，并评价治疗反应。","terminalSentenceEn":"Over the next 24 hours, the nurse must recognize evolving tumor lysis syndrome, prioritize life-threatening hyperkalemia, implement ordered emergency interventions, and evaluate treatment response.","terminalSentenceZh":"接下来的 24 小时内，护士必须识别进展中的肿瘤溶解综合征，优先处理危及生命的高钾血症，执行已开立的紧急处理措施，并评价治疗反应。","penultimateSentenceEn":"Tumor lysis syndrome after chemotherapy for high-burden lymphoma A client with newly diagnosed Burkitt lymphoma and bulky abdominal disease begins chemotherapy after hydration and rasburicase prophylaxis.","penultimateSentenceZh":"高肿瘤负荷淋巴瘤化疗后的肿瘤溶解综合征 一名新诊断伯基特淋巴瘤并伴有巨大腹部肿块的患者，在补液和拉布立酶预防后开始化疗。","responseContext":{},"rationaleCorrectEn":"This unfolding case tests recognition of TLS, prioritization of severe hyperkalemia with ECG changes, ordered emergency management, urine-output interpretation, and evaluation of treatment response.","rationaleCorrectZh":"本展开病例考查肿瘤溶解综合征识别、严重高钾血症伴心电图改变的优先处理、紧急处理医嘱的执行顺序、尿量解读以及治疗反应评价。","testTakingStrategyEn":"Follow the unfolding data. In TLS, the most dangerous cue is often not the most dramatic lab name but the abnormality creating immediate cardiac or renal threat.","testTakingStrategyZh":"跟随展开数据推理。在肿瘤溶解综合征中，最危险的线索不一定是名称最显眼的实验室项目，而是立即造成心脏或肾脏威胁的异常。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"Tumor lysis syndrome after chemotherapy for high-burden lymphoma A client with newly diagnosed Burkitt lymphoma and bulky abdominal disease begins chemotherapy after hydration and rasburicase prophylaxis.","controlSentenceZh":"高肿瘤负荷淋巴瘤化疗后的肿瘤溶解综合征 一名新诊断伯基特淋巴瘤并伴有巨大腹部肿块的患者，在补液和拉布立酶预防后开始化疗。"}
{"queueIndex":1430,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_tls_01","embeddedQuestionId":"gpt_case_gap_2026_06_11_case_tls_01_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.183.caseStudy.questions.0","itemType":"matrix","category":"Reduction of Risk Potential","topic":"Laboratory & Diagnostic Tests","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.183.caseStudy.questions.0.stem.en","stemPathZh":"questions.183.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,46],"terminalOffsetsZh":[0,20],"fullStemEn":"Using the Stage 1 data, classify each finding.","fullStemZh":"根据阶段 1 资料，对每项发现进行分类。","terminalSentenceEn":"Using the Stage 1 data, classify each finding.","terminalSentenceZh":"根据阶段 1 资料，对每项发现进行分类。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Potassium 7.1 mEq/L with peaked T waves and widening QRS","zh":"钾 7.1 mEq/L，伴高尖 T 波和 QRS 增宽"},{"id":"r2","en":"Phosphorus 8.4 mg/dL with calcium 6.8 mg/dL and fingertip tingling","zh":"磷 8.4 mg/dL，钙 6.8 mg/dL，并有指尖麻木"},{"id":"r3","en":"Creatinine increased from 1.1 to 2.4 mg/dL with 80 mL urine output in 4 hours","zh":"肌酐从 1.1 升至 2.4 mg/dL，4 小时尿量 80 mL"},{"id":"r4","en":"Uric acid decreased from 9.2 to 4.1 mg/dL after rasburicase","zh":"使用拉布立酶后，尿酸从 9.2 降至 4.1 mg/dL"},{"id":"r5","en":"Temperature 99.3 °F (37.4 °C)","zh":"体温 99.3 °F (37.4 °C)"},{"id":"r6","en":"LDH increased from 1,450 to 3,200 U/L","zh":"LDH 从 1,450 升至 3,200 U/L"}],"columns":[{"id":"c2","en":"Expected treatment effect","zh":"预期治疗效果"},{"id":"c1","en":"Danger cue consistent with TLS","zh":"符合肿瘤溶解综合征的危险线索"},{"id":"c3","en":"Not a priority TLS cue","zh":"不是优先的肿瘤溶解综合征线索"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c1"]},{"rowId":"r4","columnIds":["c2"]},{"rowId":"r5","columnIds":["c3"]},{"rowId":"r6","columnIds":["c1"]}]},"rationaleCorrectEn":"TLS causes rapid release of intracellular potassium and phosphate, secondary hypocalcemia, kidney injury, and high cell-turnover markers. The falling uric acid is expected after rasburicase and should not reassure the nurse when the client has dangerous hyperkalemia and oliguria. A temperature of 99.3 °F (37.4 °C) is not the priority cue in this pattern.","rationaleCorrectZh":"肿瘤溶解综合征会导致细胞内钾和磷迅速释放、继发性低钙血症、肾损伤以及细胞周转标志物升高。尿酸下降是拉布立酶后的预期效果；当患者同时存在危险性高钾血症和少尿时，不能因此放松警惕。99.3 °F (37.4 °C) 的体温不是此模式中的优先线索。","testTakingStrategyEn":"In an unfolding case, separate disease progression from treatment effects. A lab moving in the desired direction may still coexist with a life-threatening abnormality elsewhere.","testTakingStrategyZh":"在展开病例中，要区分疾病进展和治疗效果。某项实验室数值朝预期方向变化时，仍可能同时存在其他危及生命的异常。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1431,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_tls_01","embeddedQuestionId":"gpt_case_gap_2026_06_11_case_tls_01_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.183.caseStudy.questions.1","itemType":"dropdown_cloze","category":"Physiological Adaptation","topic":"Oncology & Immunotherapy Complications","difficulty":"hard","ngnSkill":"prioritize_hypotheses","stemPathEn":"questions.183.caseStudy.questions.1.stem.en","stemPathZh":"questions.183.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,77],"terminalOffsetsZh":[0,25],"fullStemEn":"Complete the clinical reasoning statement using the Stage 1 and Stage 2 data.","fullStemZh":"根据阶段 1 和阶段 2 资料，完成临床推理陈述。","terminalSentenceEn":"Complete the clinical reasoning statement using the Stage 1 and Stage 2 data.","terminalSentenceZh":"根据阶段 1 和阶段 2 资料，完成临床推理陈述。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The most immediate life-threatening problem is {{1}} because {{2}}. The falling uric acid level should be interpreted as {{3}}.","zh":"最立即危及生命的问题是 {{1}}，因为 {{2}}。尿酸下降应解释为 {{3}}。"},"dropdowns":[{"id":"1","options":[{"id":"o1","en":"hyperkalemia with ECG changes","zh":"高钾血症伴心电图改变"},{"id":"o4","en":"rising creatinine alone","zh":"单纯肌酐升高"},{"id":"o2","en":"hypocalcemia with fingertip tingling","zh":"低钙血症伴指尖麻木"},{"id":"o3","en":"elevated LDH after chemotherapy","zh":"化疗后 LDH 升高"}],"correct":"o1"},{"id":"2","options":[{"id":"o1","en":"it creates immediate risk for ventricular dysrhythmia and cardiac arrest","zh":"它会立即造成室性心律失常和心脏骤停风险"},{"id":"o3","en":"it confirms that chemotherapy should be continued without interruption","zh":"它证实化疗应不间断继续"},{"id":"o4","en":"it means the client is no longer at risk for kidney injury","zh":"它表示患者不再有肾损伤风险"},{"id":"o2","en":"it indicates the client has developed an infectious emergency","zh":"它表明患者发生感染性急症"}],"correct":"o1"},{"id":"3","options":[{"id":"o2","en":"evidence that the ECG changes are unrelated to TLS","zh":"证明心电图改变与肿瘤溶解综合征无关"},{"id":"o4","en":"a sign that dialysis is no longer needed regardless of potassium","zh":"表示无论钾水平如何，都不再需要透析"},{"id":"o1","en":"an expected effect of rasburicase, not resolution of the emergency","zh":"拉布立酶的预期效果，而不是急症已经解除"},{"id":"o3","en":"a reason to restart allopurinol immediately","zh":"应立即重新启用别嘌醇的理由"}],"correct":"o1"}]},"rationaleCorrectEn":"The priority is hyperkalemia with ECG changes because it threatens circulation immediately. Hypocalcemia, hyperphosphatemia, and kidney injury are serious, but the widened QRS and loss of P waves point to imminent dysrhythmia. Rasburicase can lower uric acid even while other TLS derangements worsen.","rationaleCorrectZh":"优先问题是高钾血症伴心电图改变，因为它立即威胁循环。低钙血症、高磷血症和肾损伤都很严重，但 QRS 增宽和 P 波消失提示即将发生心律失常。即使其他肿瘤溶解综合征异常正在恶化，拉布立酶也可以使尿酸下降。","testTakingStrategyEn":"When several abnormal labs appear together, ask which one can kill the client first. ECG changes make hyperkalemia the immediate priority.","testTakingStrategyZh":"当多项实验室异常同时出现时，先判断哪一项最先危及生命。出现心电图改变时，高钾血症就是立即优先事项。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1432,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_tls_01","embeddedQuestionId":"gpt_case_gap_2026_06_11_case_tls_01_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.183.caseStudy.questions.2","itemType":"ordered_response","category":"Physiological Adaptation","topic":"Electrolyte Imbalances","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.183.caseStudy.questions.2.stem.en","stemPathZh":"questions.183.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[100,155],"terminalOffsetsZh":[28,46],"fullStemEn":"The provider enters emergency hyperkalemia protocol orders while dialysis access is being arranged. Place the nursing actions in the safest priority order.","fullStemZh":"在安排透析通路的同时，医师开立紧急高钾血症处理流程医嘱。请将护理措施按最安全的优先顺序排列。","terminalSentenceEn":"Place the nursing actions in the safest priority order.","terminalSentenceZh":"请将护理措施按最安全的优先顺序排列。","penultimateSentenceEn":"The provider enters emergency hyperkalemia protocol orders while dialysis access is being arranged.","penultimateSentenceZh":"在安排透析通路的同时，医师开立紧急高钾血症处理流程医嘱。","responseContext":{"type":"ordered_response","options":[{"id":"A","en":"Verify continuous cardiac monitoring and obtain/print the current ECG tracing.","zh":"确认持续心电监护，并获取/打印当前心电图记录。"},{"id":"D","en":"Prepare the client for temporary dialysis catheter placement and emergent hemodialysis.","zh":"准备患者接受临时透析导管置入和紧急血液透析。"},{"id":"B","en":"Administer IV calcium gluconate as prescribed to stabilize the myocardium.","zh":"按医嘱给予 IV 葡萄糖酸钙以稳定心肌。"},{"id":"C","en":"Administer regular insulin with dextrose as prescribed to shift potassium into cells.","zh":"按医嘱给予普通胰岛素加葡萄糖，使钾转入细胞内。"},{"id":"E","en":"Monitor blood glucose, repeat potassium results, ECG pattern, and strict intake/output after interventions begin.","zh":"干预开始后监测血糖、复查血钾、心电图形态以及严格出入量。"}],"correct":["A","B","C","D","E"]},"rationaleCorrectEn":"With severe hyperkalemia and ECG changes, the nurse first ensures continuous ECG surveillance, then administers prescribed calcium to stabilize the myocardium, then prescribed insulin/dextrose to shift potassium intracellularly. Dialysis preparation follows because dialysis removes potassium definitively. Ongoing monitoring evaluates safety and response, including hypoglycemia after insulin.","rationaleCorrectZh":"严重高钾血症伴心电图改变时，护士首先确保持续心电监测，然后按医嘱给予钙剂稳定心肌，再按医嘱给予胰岛素/葡萄糖使钾转入细胞内。随后准备透析，因为透析可最终清除钾。持续监测用于评价安全性和疗效，包括胰岛素后的低血糖风险。","testTakingStrategyEn":"For severe hyperkalemia with ECG changes, think stabilize the heart, shift potassium, remove potassium, and monitor response.","testTakingStrategyZh":"遇到严重高钾血症伴心电图改变时，思路是稳定心脏、转移钾、清除钾、监测反应。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":true,"controlSentenceEn":"The provider enters emergency hyperkalemia protocol orders while dialysis access is being arranged.","controlSentenceZh":"在安排透析通路的同时，医师开立紧急高钾血症处理流程医嘱。"}
{"queueIndex":1433,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_tls_01","embeddedQuestionId":"gpt_case_gap_2026_06_11_case_tls_01_q4","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.183.caseStudy.questions.3","itemType":"fill_in_blank","category":"Physiological Adaptation","topic":"Renal & Gastrointestinal Disorders","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.183.caseStudy.questions.3.stem.en","stemPathZh":"questions.183.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[121,142],"terminalOffsetsZh":[39,45],"fullStemEn":"At Stage 1, the client's urine output is 80 mL total over the past 4 hours. Calculate the average urine output in mL/hr. Enter a whole number.","fullStemZh":"阶段 1，患者过去 4 小时总尿量为 80 mL。计算平均尿量（mL/hr）。请输入整数。","terminalSentenceEn":"Enter a whole number.","terminalSentenceZh":"请输入整数。","penultimateSentenceEn":"Calculate the average urine output in mL/hr.","penultimateSentenceZh":"计算平均尿量（mL/hr）。","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"mL/hr","zh":"毫升/小时"},"acceptable":["20","20 mL/hr","20 mL per hour"],"numeric":{"value":20,"tolerance":0,"unit":"mL/hr"}}]},"rationaleCorrectEn":"Eighty mL divided by 4 hours equals 20 mL/hr. This is below the common adult minimum benchmark of about 30 mL/hr and supports oliguria in the setting of TLS-associated kidney injury.","rationaleCorrectZh":"80 mL 除以 4 小时等于 20 mL/hr。此数值低于成人常用最低参考值约 30 mL/hr，支持在肿瘤溶解综合征相关肾损伤背景下出现少尿。","testTakingStrategyEn":"For intake/output calculations, divide the total amount by the elapsed time before interpreting whether the value is adequate.","testTakingStrategyZh":"进行出入量计算时，先用总量除以经过的时间，再判断数值是否足够。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":true,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1434,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_tls_01","embeddedQuestionId":"gpt_case_gap_2026_06_11_case_tls_01_q5","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.183.caseStudy.questions.4","itemType":"matrix","category":"Physiological Adaptation","topic":"Oncology & Immunotherapy Complications","difficulty":"hard","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.183.caseStudy.questions.4.stem.en","stemPathZh":"questions.183.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,143],"terminalOffsetsZh":[0,42],"fullStemEn":"Using the Stage 3 data, identify whether each finding shows improvement, requires continued close monitoring, or requires immediate escalation.","fullStemZh":"根据阶段 3 资料，判断每项发现是显示改善、需要继续密切监测，还是需要立即升级处理。","terminalSentenceEn":"Using the Stage 3 data, identify whether each finding shows improvement, requires continued close monitoring, or requires immediate escalation.","terminalSentenceZh":"根据阶段 3 资料，判断每项发现是显示改善、需要继续密切监测，还是需要立即升级处理。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"QRS complexes are narrowing and T waves are less prominent","zh":"QRS 波变窄，T 波高尖程度减轻"},{"id":"r2","en":"Potassium decreased from 7.1 to 5.4 mEq/L","zh":"钾从 7.1 降至 5.4 mEq/L"},{"id":"r3","en":"Calcium remains low at 7.5 mg/dL","zh":"钙仍低，为 7.5 mg/dL"},{"id":"r4","en":"Creatinine remains elevated at 2.0 mg/dL","zh":"肌酐仍升高，为 2.0 mg/dL"},{"id":"r5","en":"Urine output is 110 mL over the past 4 hours","zh":"过去 4 小时尿量 110 mL"},{"id":"r6","en":"Uric acid is 2.8 mg/dL after rasburicase","zh":"使用拉布立酶后尿酸为 2.8 mg/dL"}],"columns":[{"id":"c3","en":"Immediate escalation","zh":"立即升级处理"},{"id":"c1","en":"Improving response","zh":"治疗反应改善"},{"id":"c2","en":"Continue close monitoring","zh":"继续密切监测"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c2"]},{"rowId":"r5","columnIds":["c2"]},{"rowId":"r6","columnIds":["c1"]}]},"rationaleCorrectEn":"The ECG pattern and potassium are improving, and uric acid remains controlled after rasburicase. However, calcium, creatinine, and urine output have not normalized, so the nurse should continue close monitoring and report worsening trends. None of the Stage 3 findings listed requires immediate escalation because the immediate arrhythmia markers are improving.","rationaleCorrectZh":"心电图形态和血钾正在改善，拉布立酶后尿酸仍得到控制。但是钙、肌酐和尿量尚未恢复正常，因此护士应继续密切监测并报告恶化趋势。所列阶段 3 发现中没有需要立即升级处理的项目，因为立即性心律失常指标正在改善。","testTakingStrategyEn":"Evaluate outcomes by matching each marker to the original emergency. Improvement in the rhythm and potassium matters first, but kidney and calcium trends still need surveillance.","testTakingStrategyZh":"评价治疗结果时，要把每个指标与原来的急症对应。心律和血钾改善最重要，但肾功能和钙趋势仍需监测。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1435,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_adhf_01","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.184","itemType":"case_study","category":"Physiological Adaptation","topic":"Cardiovascular Disorders","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.184.stem.en","stemPathZh":"questions.184.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,196],"terminalOffsetsZh":[0,50],"fullStemEn":"Acute decompensated heart failure with pulmonary edema Older adult with missed diuretic doses develops escalating hypoxemia and pulmonary edema requiring urgent nursing recognition and escalation.","fullStemZh":"急性失代偿性心力衰竭伴肺水肿 老年患者漏服利尿剂后出现低氧加重和肺水肿，需要护士迅速识别并升级处理。","terminalSentenceEn":"Acute decompensated heart failure with pulmonary edema Older adult with missed diuretic doses develops escalating hypoxemia and pulmonary edema requiring urgent nursing recognition and escalation.","terminalSentenceZh":"急性失代偿性心力衰竭伴肺水肿 老年患者漏服利尿剂后出现低氧加重和肺水肿，需要护士迅速识别并升级处理。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This case study requires recognizing deterioration across serial assessment data and choosing nursing actions that reduce risk.","rationaleCorrectZh":"本病例要求根据连续评估资料识别病情恶化，并选择降低风险的护理措施。","testTakingStrategyEn":"In an unfolding case, compare the newest data with baseline and act first on unstable airway, breathing, circulation, perfusion, and safety cues.","testTakingStrategyZh":"处理展开式病例时，先把最新资料与基线比较，并优先处理气道、呼吸、循环、灌注和安全方面的不稳定线索。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1436,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_adhf_01","embeddedQuestionId":"gpt_case_gap_2026_06_11_adhf_matrix_01","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.184.caseStudy.questions.0","itemType":"matrix","category":"Reduction of Risk Potential","topic":"Laboratory & Diagnostic Tests","difficulty":"hard","ngnSkill":"recognize_cues","stemPathEn":"questions.184.caseStudy.questions.0.stem.en","stemPathZh":"questions.184.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,160],"terminalOffsetsZh":[0,39],"fullStemEn":"For each finding, indicate whether it is most consistent with worsening acute decompensated heart failure or less directly related to the current deterioration.","fullStemZh":"对于每项发现，判断其是否最符合急性失代偿性心力衰竭恶化，或与当前恶化关系较小。","terminalSentenceEn":"For each finding, indicate whether it is most consistent with worsening acute decompensated heart failure or less directly related to the current deterioration.","terminalSentenceZh":"对于每项发现，判断其是否最符合急性失代偿性心力衰竭恶化，或与当前恶化关系较小。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"SpO2 89% on room air","zh":"室内空气SpO2 89%"},{"id":"r2","en":"Bibasilar crackles and orthopnea","zh":"双肺底湿啰音和端坐呼吸"},{"id":"r3","en":"Troponin not elevated","zh":"肌钙蛋白未升高"},{"id":"r4","en":"Weight increased 3.2 kg in one week","zh":"一周内体重增加3.2 kg"},{"id":"r5","en":"Potassium 3.7 mEq/L","zh":"钾3.7 mEq/L"}],"columns":[{"id":"c2","en":"Less directly related","zh":"关系较小"},{"id":"c1","en":"Worsening ADHF cue","zh":"ADHF恶化线索"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c1"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c1"]},{"rowId":"r5","columnIds":["c2"]}]},"rationaleCorrectEn":"Hypoxemia, crackles, orthopnea, and rapid weight gain cluster as pulmonary and systemic fluid overload. A normal potassium and non-elevated troponin do not explain the acute respiratory deterioration.","rationaleCorrectZh":"低氧、湿啰音、端坐呼吸和快速体重增加共同提示肺部及全身液体超负荷。钾正常和肌钙蛋白未升高不能解释急性呼吸恶化。","testTakingStrategyEn":"Cluster cues instead of treating each value alone; respiratory distress plus fluid-overload signs points to ADHF deterioration.","testTakingStrategyZh":"要把线索组合起来看，而不是孤立看数值；呼吸窘迫加液体超负荷体征指向ADHF恶化。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1437,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_adhf_01","embeddedQuestionId":"gpt_case_gap_2026_06_11_adhf_cloze_02","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.184.caseStudy.questions.1","itemType":"dropdown_cloze","category":"Physiological Adaptation","topic":"Cardiovascular Disorders","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.184.caseStudy.questions.1.stem.en","stemPathZh":"questions.184.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,75],"terminalOffsetsZh":[0,17],"fullStemEn":"Complete the clinical judgment statement using the updated assessment data.","fullStemZh":"根据最新评估资料完成临床判断陈述。","terminalSentenceEn":"Complete the clinical judgment statement using the updated assessment data.","terminalSentenceZh":"根据最新评估资料完成临床判断陈述。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"dropdown_cloze","clozeStem":{"en":"The client is now at greatest immediate risk for {{1}} because the assessment shows {{2}}.","zh":"由于评估显示{{2}}，该患者当前最直接面临{{1}}的风险。"},"dropdowns":[{"id":"1","options":[{"id":"o3","en":"isolated medication nonadherence without instability","zh":"单纯用药不依从且无不稳定"},{"id":"o2","en":"stable chronic fluid retention","zh":"稳定的慢性液体潴留"},{"id":"o1","en":"acute pulmonary edema with respiratory failure","zh":"急性肺水肿伴呼吸衰竭"}],"correct":"o1"},{"id":"2","options":[{"id":"o3","en":"ankle edema without a respiratory change","zh":"踝部水肿但无呼吸改变"},{"id":"o2","en":"a normal potassium and a non-elevated troponin","zh":"钾正常和肌钙蛋白未升高"},{"id":"o1","en":"pink frothy sputum, worsening hypoxemia, and crackles extending upward","zh":"粉红色泡沫痰、低氧加重及湿啰音向上扩展"}],"correct":"o1"}]},"rationaleCorrectEn":"Pink frothy sputum, rapidly worsening hypoxemia, restlessness, and diffuse crackles indicate acute pulmonary edema that can progress to respiratory failure.","rationaleCorrectZh":"粉红色泡沫痰、快速加重的低氧、烦躁和弥漫湿啰音提示急性肺水肿，可进展为呼吸衰竭。","testTakingStrategyEn":"When the client can barely speak, prioritize the complication that threatens oxygenation within minutes.","testTakingStrategyZh":"当患者几乎无法说话时，优先考虑数分钟内威胁氧合的并发症。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1438,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_adhf_01","embeddedQuestionId":"gpt_case_gap_2026_06_11_adhf_or_03","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.184.caseStudy.questions.2","itemType":"ordered_response","category":"Management of Care","topic":"Prioritization & Delegation","difficulty":"hard","ngnSkill":"take_action","stemPathEn":"questions.184.caseStudy.questions.2.stem.en","stemPathZh":"questions.184.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,87],"terminalOffsetsZh":[0,23],"fullStemEn":"Place the nursing actions in the order they should be performed for this deterioration.","fullStemZh":"将针对该恶化情况的护理措施按应执行的顺序排列。","terminalSentenceEn":"Place the nursing actions in the order they should be performed for this deterioration.","terminalSentenceZh":"将针对该恶化情况的护理措施按应执行的顺序排列。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"ordered_response","options":[{"id":"B","en":"Increase oxygen support per emergency protocol and apply continuous pulse oximetry.","zh":"按急救流程提高氧疗支持并持续监测脉搏血氧。"},{"id":"D","en":"Activate the rapid response/provider notification pathway for acute respiratory decompensation.","zh":"因急性呼吸失代偿启动快速反应/通知医嘱提供者流程。"},{"id":"C","en":"Rapidly reassess airway, breathing, vital signs, lung sounds, and level of consciousness.","zh":"快速复评气道、呼吸、生命体征、肺音和意识水平。"},{"id":"E","en":"Administer the prescribed IV loop diuretic and monitor urine output and blood pressure.","zh":"遵医嘱给予静脉袢利尿剂，并监测尿量和血压。"},{"id":"A","en":"Position the client upright with legs dependent if tolerated.","zh":"在能耐受的情况下让患者直坐并双腿下垂。"}],"correct":["C","A","B","D","E"]},"rationaleCorrectEn":"The nurse first verifies the acute ABC status, immediately reduces venous return with upright positioning, supports oxygenation, escalates for urgent orders/team response, then gives prescribed therapy and monitors response.","rationaleCorrectZh":"护士先确认急性ABC状态，立即通过直坐位减少静脉回流，支持氧合，升级呼叫团队/医嘱，然后实施已开立治疗并监测反应。","testTakingStrategyEn":"For ordered responses, do immediate assessment, independent stabilization, escalation, then prescribed treatment and evaluation.","testTakingStrategyZh":"排序题可按：立即评估、独立稳定措施、升级求助、执行医嘱治疗并评价。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1439,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_adhf_01","embeddedQuestionId":"gpt_case_gap_2026_06_11_adhf_fib_04","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.184.caseStudy.questions.3","itemType":"fill_in_blank","category":"Physiological Adaptation","topic":"Cardiovascular Disorders","difficulty":"hard","ngnSkill":"evaluate_outcomes","stemPathEn":"questions.184.caseStudy.questions.3.stem.en","stemPathZh":"questions.184.caseStudy.questions.3.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[62,101],"terminalOffsetsZh":[20,29],"fullStemEn":"Calculate the client's net fluid balance since arrival in mL. Enter a negative number for a net loss.","fullStemZh":"计算患者到院以来的净液体平衡量（mL）。净丢失请输入负数。","terminalSentenceEn":"Enter a negative number for a net loss.","terminalSentenceZh":"净丢失请输入负数。","penultimateSentenceEn":"Calculate the client's net fluid balance since arrival in mL.","penultimateSentenceZh":"计算患者到院以来的净液体平衡量（mL）。","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"Net fluid balance in mL","zh":"净液体平衡量，mL"},"acceptable":["-1180","-1180 mL"],"numeric":{"value":-1180,"tolerance":0,"unit":"mL"}}]},"rationaleCorrectEn":"Net balance is intake minus output: 920 mL - 2,100 mL = -1,180 mL. The negative balance supports an initial diuretic response, but oxygenation and perfusion still require reassessment.","rationaleCorrectZh":"净平衡=摄入量-排出量：920 mL - 2,100 mL = -1,180 mL。负平衡支持已有初步利尿反应，但仍需复评氧合和灌注。","testTakingStrategyEn":"Outcome evaluation often requires a trend plus a calculation; improvement in one metric does not end monitoring.","testTakingStrategyZh":"评价疗效常需要趋势和计算；一个指标改善并不代表可以停止监测。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":true,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":1440,"bankPath":"banks/gpt-canonical.json","bankSha256":"61664a6bef854ec8d7a3a0113779a4773135724aabfdec65b970b7ac6464c5d2","topLevelQuestionId":"gpt_case_gap_2026_06_11_case_aki_02","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.185","itemType":"case_study","category":"Physiological Adaptation","topic":"Renal & Gastrointestinal Disorders","difficulty":"hard","ngnSkill":"analyze_cues","stemPathEn":"questions.185.stem.en","stemPathZh":"questions.185.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,135],"terminalOffsetsZh":[0,38],"fullStemEn":"Acute kidney injury with hyperkalemia Volume depletion and nephrotoxic exposure progress to oliguria and hyperkalemia with ECG changes.","fullStemZh":"急性肾损伤伴高钾血症 容量不足和肾毒性暴露进展为少尿及伴心电改变的高钾血症。","terminalSentenceEn":"Acute kidney injury with hyperkalemia Volume depletion and nephrotoxic exposure progress to oliguria and hyperkalemia with ECG changes.","terminalSentenceZh":"急性肾损伤伴高钾血症 容量不足和肾毒性暴露进展为少尿及伴心电改变的高钾血症。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"This case study requires recognizing deterioration across serial assessment data and choosing nursing actions that reduce risk.","rationaleCorrectZh":"本病例要求根据连续评估资料识别病情恶化，并选择降低风险的护理措施。","testTakingStrategyEn":"In an unfolding case, compare the newest data with baseline and act first on unstable airway, breathing, circulation, perfusion, and safety cues.","testTakingStrategyZh":"处理展开式病例时，先把最新资料与基线比较，并优先处理气道、呼吸、循环、灌注和安全方面的不稳定线索。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
