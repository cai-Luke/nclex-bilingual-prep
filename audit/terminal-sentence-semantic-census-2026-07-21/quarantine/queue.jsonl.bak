ainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"normalizedTerminalEqualsClozeStem":false,"normalizedTerminalContainedInClozeStem":false,"clozeStemContainedInStem":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":954,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_osteo_02","embeddedQuestionId":null,"recordKind":"TOP_LEVEL_CASE_CONTAINER","questionPath":"questions.759","itemType":"case_study","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"medium","ngnSkill":null,"stemPathEn":"questions.759.stem.en","stemPathZh":"questions.759.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,80],"terminalOffsetsZh":[0,23],"fullStemEn":"Ambulatory Care Visit A 68-year-old female presents for a routine wellness exam.","fullStemZh":"门诊随访 一名68岁女性来到诊所进行常规体检。","terminalSentenceEn":"Ambulatory Care Visit A 68-year-old female presents for a routine wellness exam.","terminalSentenceZh":"门诊随访 一名68岁女性来到诊所进行常规体检。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{},"rationaleCorrectEn":"Osteopenia requires lifestyle modifications to prevent progression to osteoporosis, including smoking cessation, weight-bearing exercise, and calcium/Vitamin D intake.","rationaleCorrectZh":"骨质减少需要改变生活方式以防止发展为骨质疏松症，包括戒烟、负重运动以及补充钙和维生素D。","testTakingStrategyEn":"Focus on primary and secondary prevention of bone loss.","testTakingStrategyZh":"关注骨质流失的初级和二级预防。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":955,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_osteo_02","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_osteo_02_q1","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.759.caseStudy.questions.0","itemType":"select_all","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"medium","ngnSkill":"recognize_cues","stemPathEn":"questions.759.caseStudy.questions.0.stem.en","stemPathZh":"questions.759.caseStudy.questions.0.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[74,96],"terminalOffsetsZh":[23,32],"fullStemEn":"Which findings in the client's history are risk factors for osteoporosis? Select all that apply.","fullStemZh":"该患者病史中的哪些发现是骨质疏松症的危险因素？请选择所有适用项。","terminalSentenceEn":"Select all that apply.","terminalSentenceZh":"请选择所有适用项。","penultimateSentenceEn":"Which findings in the client's history are risk factors for osteoporosis?","penultimateSentenceZh":"该患者病史中的哪些发现是骨质疏松症的危险因素？","responseContext":{"type":"select_all","options":[{"id":"o4","en":"Low body mass index (BMI)","zh":"低体重指数 (BMI)"},{"id":"o2","en":"Sedentary lifestyle","zh":"久坐的生活方式"},{"id":"o1","en":"Postmenopausal status","zh":"绝经后状态"},{"id":"o5","en":"Family history of hip fracture","zh":"髋部骨折家族史"},{"id":"o3","en":"Smoking history","zh":"吸烟史"}],"correct":["o1","o2","o3","o4","o5"]},"rationaleCorrectEn":"All of these are well-established risk factors for osteoporosis and bone loss.","rationaleCorrectZh":"所有这些都是公认的骨质疏松症和骨质流失的危险因素。","testTakingStrategyEn":"Identify modifiable and non-modifiable factors that decrease bone density.","testTakingStrategyZh":"识别降低骨密度的可改变和不可改变的因素。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":956,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_osteo_02","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_osteo_02_q2","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.759.caseStudy.questions.1","itemType":"multiple_choice","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"medium","ngnSkill":"analyze_cues","stemPathEn":"questions.759.caseStudy.questions.1.stem.en","stemPathZh":"questions.759.caseStudy.questions.1.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[48,82],"terminalOffsetsZh":[16,27],"fullStemEn":"The client asks what the T-score of -1.8 means. What is the nurse's best response?","fullStemZh":"患者询问T值-1.8是什么意思。护士的最佳回答是什么？","terminalSentenceEn":"What is the nurse's best response?","terminalSentenceZh":"护士的最佳回答是什么？","penultimateSentenceEn":"The client asks what the T-score of -1.8 means.","penultimateSentenceZh":"患者询问T值-1.8是什么意思。","responseContext":{"type":"multiple_choice","options":[{"id":"o4","en":"'It shows you are losing calcium from your blood very quickly.'","zh":"“这表明您血液中的钙流失非常快。”"},{"id":"o3","en":"'It indicates severe osteoporosis and a high immediate risk of fracture.'","zh":"“这表明您患有严重的骨质疏松症，且有很高的近期骨折风险。”"},{"id":"o1","en":"'It means you have normal bone density for your age.'","zh":"“这意味着您的骨密度在您这个年龄段是正常的。”"},{"id":"o2","en":"'It means you have osteopenia, which is low bone mass, but not yet osteoporosis.'","zh":"“这意味着您患有骨质减少，即骨量偏低，但还不是骨质疏松症。”"}],"correct":["o2"]},"rationaleCorrectEn":"A T-score between -1.0 and -2.5 indicates osteopenia (low bone mass). A score of -2.5 or lower indicates osteoporosis.","rationaleCorrectZh":"T值在-1.0到-2.5之间表示骨质减少（骨量偏低）。T值小于或等于-2.5表示骨质疏松症。","testTakingStrategyEn":"Recall the World Health Organization (WHO) T-score classifications.","testTakingStrategyZh":"回想世界卫生组织(WHO)的T值分类。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":957,"bankPath":"banks/gemini-canonical.json","bankSha256":"8259ffb6b12c5b3ba267566b8247207ec4fc573d536d9f78fafd5d18655b63c3","topLevelQuestionId":"gemini_gapfill_case_2026_06_10_case_osteo_02","embeddedQuestionId":"gemini_gapfill_case_2026_06_10_case_osteo_02_q3","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.759.caseStudy.questions.2","itemType":"matrix","category":"Health Promotion and Maintenance","topic":"Adult Health & Wellness","difficulty":"medium","ngnSkill":"take_action","stemPathEn":"questions.759.caseStudy.questions.2.stem.en","stemPathZh":"questions.759.caseStudy.questions.2.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[0,103],"terminalOffsetsZh":[0,25],"fullStemEn":"Click to specify whether each activity is recommended or not recommended for this client's bone health.","fullStemZh":"点击指出以下各项活动是否推荐用于该患者的骨骼健康。","terminalSentenceEn":"Click to specify whether each activity is recommended or not recommended for this client's bone health.","terminalSentenceZh":"点击指出以下各项活动是否推荐用于该患者的骨骼健康。","penultimateSentenceEn":null,"penultimateSentenceZh":null,"responseContext":{"type":"matrix","matrix":{"rows":[{"id":"r1","en":"Walking 30 minutes daily","zh":"每天步行30分钟"},{"id":"r2","en":"High-impact aerobics","zh":"高冲击力有氧运动"},{"id":"r3","en":"Swimming","zh":"游泳"},{"id":"r4","en":"Light weight training","zh":"轻量级举重训练"}],"columns":[{"id":"c2","en":"Does not directly build bone density","zh":"不能直接增加骨密度"},{"id":"c1","en":"Primarily bone-building (recommended for bone health)","zh":"主要有助于骨骼建造（推荐用于骨骼健康）"}],"selectionMode":"single_per_row"},"correct":[{"rowId":"r1","columnIds":["c1"]},{"rowId":"r2","columnIds":["c2"]},{"rowId":"r3","columnIds":["c2"]},{"rowId":"r4","columnIds":["c1"]}]},"rationaleCorrectEn":"Weight-bearing and resistance exercises (walking, light weights) stimulate bone remodeling and directly build bone density. Swimming provides cardiovascular benefit but is non-weight-bearing and does not build bone. High-impact aerobics are not recommended for bone health in this client due to fracture risk with osteopenia.","rationaleCorrectZh":"负重和抗阻运动（步行、轻量级举重）能刺激骨骼重塑并直接提高骨密度。游泳有益于心血管健康，但属于非负重运动，不能增加骨量。对于有骨质减少的患者，高冲击力有氧运动因存在骨折风险而不推荐用于骨骼健康。","testTakingStrategyEn":"Distinguish exercises that directly build bone density (weight-bearing, resistance) from those that do not; non-weight-bearing activities like swimming still support overall health.","testTakingStrategyZh":"区分能直接增加骨密度的运动（负重、抗阻）与不能增加骨密度的运动；游泳等非负重运动仍对整体健康有益。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
