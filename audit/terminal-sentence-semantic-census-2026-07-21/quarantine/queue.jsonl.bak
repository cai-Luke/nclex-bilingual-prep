terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
{"queueIndex":2296,"bankPath":"banks/hard-cases-canonical.json","bankSha256":"438c176897a41d3b7f212435e5945bd524c3f0ba5a62931eb5e85843c93d8730","topLevelQuestionId":"case_dka_01","embeddedQuestionId":"case_dka_01_q5","recordKind":"EMBEDDED_SCORED_LEAF","questionPath":"questions.7.caseStudy.questions.4","itemType":"fill_in_blank","category":"Pharmacological and Parenteral Therapies","topic":"Dosage Calculations","difficulty":"hard","ngnSkill":null,"stemPathEn":"questions.7.caseStudy.questions.4.stem.en","stemPathZh":"questions.7.caseStudy.questions.4.stem.zh","segmentationMethod":"Intl.Segmenter","segmentationConfidence":"HIGH","terminalOffsetsEn":[191,233],"terminalOffsetsZh":[75,94],"fullStemEn":"After potassium has been corrected to a safe level, the client weighs 60 kg. The provider orders a regular insulin bolus of 0.1 units/kg followed by a continuous infusion of 0.1 units/kg/hr. Calculate the initial bolus dose in units.","fullStemZh":"在血钾已纠正至安全水平后，患者体重 60 kg。医生开具常规胰岛素冲击量 0.1 units/kg，随后以 0.1 units/kg/hr 持续输注。计算初始冲击剂量（单位：units）。","terminalSentenceEn":"Calculate the initial bolus dose in units.","terminalSentenceZh":"计算初始冲击剂量（单位：units）。","penultimateSentenceEn":"The provider orders a regular insulin bolus of 0.1 units/kg followed by a continuous infusion of 0.1 units/kg/hr.","penultimateSentenceZh":"医生开具常规胰岛素冲击量 0.1 units/kg，随后以 0.1 units/kg/hr 持续输注。","responseContext":{"type":"fill_in_blank","blanks":[{"prompt":{"en":"units","zh":"单位"},"acceptable":["6","6 units"],"numeric":{"value":6,"tolerance":0,"unit":"units"}}]},"rationaleCorrectEn":"60 kg * 0.1 units/kg = 6 units.","rationaleCorrectZh":"60 kg * 0.1 单位/kg = 6 单位。","testTakingStrategyEn":"Multiply weight in kg by the dose per kg.","testTakingStrategyZh":"将以 kg 为单位的体重乘以每 kg 的剂量。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
