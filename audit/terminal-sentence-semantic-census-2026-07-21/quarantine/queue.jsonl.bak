,"rationaleCorrectZh":"不规律服药、标签文字密集和语言不匹配是障碍。患者选择的帮助者和可用电话可支持提醒与续药。","testTakingStrategyEn":"Classify cues by how they affect the plan: barrier, support, or both.","testTakingStrategyZh":"按线索如何影响计划来分类：障碍、支持，或两者皆有。","sourceMetadata":null,"mechanicalSignals":{"rawPlaceholderInStem":false,"terminalContainsRawPlaceholder":false,"terminalBeginsThisItemOrQuestion":false,"terminalMentionsLearnerExpectation":false,"terminalFollowsExplicitResponseDemand":false,"exactEnglishTerminalRepeatedElsewhereInItem":false},"controlSelected":false,"controlSentenceEn":null,"controlSentenceZh":null}
