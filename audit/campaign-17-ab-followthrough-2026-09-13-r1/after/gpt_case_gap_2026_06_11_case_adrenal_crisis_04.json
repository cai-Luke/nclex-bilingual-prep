    "questions": [
      {
        "id": "gpt_case_gap_2026_06_11_adrenal_matrix_01",
        "itemType": "matrix",
        "category": "Reduction of Risk Potential",
        "topic": "Laboratory & Diagnostic Tests",
        "difficulty": "hard",
        "ngnSkill": "recognize_cues",
        "stem": {
          "en": "For each finding, indicate whether it supports adrenal crisis requiring immediate follow-up or is less urgent in this context.",
          "zh": "对于每项发现，判断其是否支持需要立即跟进的肾上腺危象，或在此情境下较不紧急。"
        },
        "matrix": {
          "rows": [
            {
              "id": "r1",
              "en": "Could not keep hydrocortisone down for two days",
              "zh": "两天无法保留口服氢化可的松"
            },
            {
              "id": "r2",
              "en": "BP 84/46 mm Hg with mottled skin",
              "zh": "BP 84/46 mm Hg伴皮肤花斑"
            },
            {
              "id": "r3",
              "en": "Glucose 52 mg/dL",
              "zh": "血糖52 mg/dL"
            },
            {
              "id": "r4",
              "en": "Potassium 5.9 mEq/L and sodium 126 mEq/L",
              "zh": "钾5.9 mEq/L且钠126 mEq/L"
            },
            {
              "id": "r5",
              "en": "Abdominal pain after gastroenteritis",
              "zh": "胃肠炎后腹痛"
            }
          ],
          "columns": [
            {
              "id": "c1",
              "en": "Adrenal crisis cue",
              "zh": "肾上腺危象线索"
            },
            {
              "id": "c2",
              "en": "Less urgent/less specific",
              "zh": "较不紧急/较不特异"
            }
          ],
          "selectionMode": "single_per_row"
        },
        "correct": [
          {
            "rowId": "r1",
            "columnIds": [
              "c1"
            ]
          },
          {
            "rowId": "r2",
            "columnIds": [
              "c1"
            ]
          },
          {
            "rowId": "r3",
            "columnIds": [
              "c1"
            ]
          },
          {
            "rowId": "r4",
            "columnIds": [
              "c1"
            ]
          },
          {
            "rowId": "r5",
            "columnIds": [
              "c2"
            ]
          }
        ],
        "rationale": {
          "correct": {
            "en": "Missed steroid replacement during illness plus shock, hypoglycemia, hyponatremia, and hyperkalemia strongly supports adrenal crisis. Abdominal pain can occur but is less specific than the instability cues.",
            "zh": "疾病期间未能补充激素，加上休克、低血糖、低钠和高钾，强烈支持肾上腺危象。腹痛可出现，但不如不稳定线索特异。"
          },
          "byChoice": [
            {
              "refId": "r1",
              "en": "In adrenal insufficiency, inability to take steroids during illness removes needed stress-dose coverage.",
              "zh": "肾上腺功能不全患者患病时无法服用激素，会失去所需应激剂量覆盖。"
            },
            {
              "refId": "r2",
              "en": "Hypotension with poor perfusion is a crisis-level circulation cue.",
              "zh": "低血压伴灌注差是危象级循环线索。"
            },
            {
              "refId": "r3",
              "en": "Cortisol deficiency can cause hypoglycemia, especially during acute illness.",
              "zh": "皮质醇不足可导致低血糖，尤其在急病期间。"
            },
            {
              "refId": "r4",
              "en": "Low aldosterone effect contributes to sodium loss and potassium retention.",
              "zh": "醛固酮作用不足会导致钠丢失和钾潴留。"
            },
            {
              "refId": "r5",
              "en": "Abdominal pain is compatible with the illness but alone is not the most urgent crisis cue.",
              "zh": "腹痛与疾病相符，但单独看不是最紧急的危象线索。"
            }
          ]
        },
        "testTakingStrategy": {
          "en": "In endocrine emergencies, connect the missing hormone to the vital-sign and lab pattern.",
          "zh": "处理内分泌急症时，把缺失激素与生命体征和实验室模式联系起来。"
        },
        "glossary": [
          {
            "termEn": "Adrenal crisis",
            "termZh": "肾上腺危象",
            "defZh": "皮质醇严重不足导致低血压、低血糖、电解质紊乱和休克风险。"
          },
          {
            "termEn": "Glucocorticoid",
            "termZh": "糖皮质激素",
            "defZh": "参与应激反应、血糖和血压维持的激素或药物。"
          },
          {
            "termEn": "Hyperkalemia",
            "termZh": "高钾血症",
            "defZh": "血钾升高，可见于醛固酮不足并可能导致心律失常。"
          }
        ],
        "answerableAfterStageId": {
          "kind": "baseline"
        }
      },
      {
        "id": "gpt_case_gap_2026_06_11_adrenal_cloze_02",
        "itemType": "dropdown_cloze",
        "category": "Reduction of Risk Potential",
        "topic": "Laboratory & Diagnostic Tests",
        "difficulty": "hard",
        "ngnSkill": "analyze_cues",
        "stageId": "adrenal_stage2",
        "stem": {
          "en": "Complete the priority statement.",
          "zh": "完成优先判断陈述。"
        },
        "clozeStem": {
          "en": "The client is at highest risk for {{1}} because of {{2}}.",
          "zh": "由于{{2}}，该患者最高风险是{{1}}。"
        },
        "dropdowns": [
          {
            "id": "1",
            "options": [
              {
                "id": "o2",
                "en": "fluid overload from excessive steroids",
                "zh": "激素过量导致容量过负荷"
              },
              {
                "id": "o1",
                "en": "circulatory collapse with neuroglycopenia",
                "zh": "循环衰竭伴脑部低糖供能不足"
              },
              {
                "id": "o3",
                "en": "stable viral illness without endocrine emergency",
                "zh": "无内分泌急症的稳定病毒感染"
              }
            ],
            "correct": "o1"
          },
          {
            "id": "2",
            "options": [
              {
                "id": "o1",
                "en": "refractory hypotension, altered arousal, and glucose 48 mg/dL",
                "zh": "持续低血压、觉醒度改变和血糖48 mg/dL"
              },
              {
                "id": "o3",
                "en": "sodium 126 mEq/L alone",
                "zh": "单纯钠126 mEq/L"
              },
              {
                "id": "o2",
                "en": "mild abdominal pain with normal perfusion",
                "zh": "轻度腹痛且灌注正常"
              }
            ],
            "correct": "o1"
          }
        ],
        "rationale": {
          "correct": {
            "en": "The combination of shock-level hypotension and severe hypoglycemia threatens both perfusion and brain glucose delivery.",
            "zh": "休克水平低血压和严重低血糖同时威胁灌注和脑部葡萄糖供应。"
          },
          "byChoice": [
            {
              "refId": "1",
              "en": "The immediate problem is not just low cortisol but the life-threatening effect on circulation and brain function.",
              "zh": "即时问题不只是皮质醇低，而是其对循环和脑功能的危及生命影响。"
            },
            {
              "refId": "2",
              "en": "The selected cluster explains why treatment cannot be delayed.",
              "zh": "所选线索组合说明治疗不能延迟。"
            }
          ]
        },
        "testTakingStrategy": {
          "en": "When hypotension and altered mental status occur with low glucose, treat the situation as unstable even before all endocrine labs return.",
          "zh": "低血压和意识改变伴低血糖时，即使内分泌化验未全回报，也应按不稳定处理。"
        },
        "glossary": [
          {
            "termEn": "Adrenal crisis",
            "termZh": "肾上腺危象",
            "defZh": "皮质醇严重不足导致低血压、低血糖、电解质紊乱和休克风险。"
          },
          {
            "termEn": "Glucocorticoid",
            "termZh": "糖皮质激素",
            "defZh": "参与应激反应、血糖和血压维持的激素或药物。"
          },
          {
            "termEn": "Hyperkalemia",
            "termZh": "高钾血症",
            "defZh": "血钾升高，可见于醛固酮不足并可能导致心律失常。"
          }
        ],
        "answerableAfterStageId": "adrenal_stage2"
      },
      {
        "id": "gpt_case_gap_2026_06_11_adrenal_or_03",
        "itemType": "ordered_response",
        "category": "Management of Care",
        "topic": "Prioritization & Delegation",
        "difficulty": "hard",
        "ngnSkill": "take_action",
        "stageId": "adrenal_stage2",
        "stem": {
          "en": "Place the emergency nursing actions in order.",
          "zh": "将急救护理措施按顺序排列。"
        },
        "options": [
          {
            "id": "C",
            "en": "Activate rapid response/provider notification for suspected adrenal crisis with shock.",
            "zh": "因疑似肾上腺危象伴休克启动快速反应/通知医嘱提供者。"
          },
          {
            "id": "D",
            "en": "Administer prescribed IV hydrocortisone, isotonic saline, and dextrose without delaying for cortisol results.",
            "zh": "遵医嘱给予静脉氢化可的松、等渗盐水和葡萄糖，不因等待皮质醇结果而延误。"
          },
          {
            "id": "A",
            "en": "Assess airway, breathing, circulation, mental status, and bedside glucose.",
            "zh": "评估气道、呼吸、循环、意识状态和床旁血糖。"
          },
          {
            "id": "B",
            "en": "Maintain IV access, apply cardiac monitoring, and place the client supine with legs elevated if tolerated.",
            "zh": "维持静脉通路，应用心电监护，并在可耐受时让患者仰卧抬腿。"
          },
          {
            "id": "E",
            "en": "Reassess blood pressure, mental status, glucose, potassium, sodium, and urine output.",
            "zh": "复评血压、意识状态、血糖、钾、钠和尿量。"
          }
        ],
        "correct": [
          "A",
          "B",
          "C",
          "D",
          "E"
        ],
        "rationale": {
          "correct": {
            "en": "Immediate assessment identifies shock and hypoglycemia, supportive measures reduce collapse risk, urgent escalation obtains emergency therapy, and treatment should not wait for confirmatory cortisol testing when crisis is suspected.",
            "zh": "立即评估可识别休克和低血糖，支持措施降低循环衰竭风险，紧急升级以获得急救治疗；疑似危象时不应等待皮质醇确证结果才治疗。"
          },
          "byChoice": [
            {
              "refId": "A",
              "en": "ABCs, perfusion, mental status, and glucose define the immediate threats.",
              "zh": "ABC、灌注、意识和血糖决定即时威胁。"
            },
            {
              "refId": "D",
              "en": "Steroid replacement, volume, and glucose address the core physiologic deficits.",
              "zh": "补充激素、容量和葡萄糖处理核心生理缺陷。"
            },
            {
              "refId": "E",
              "en": "Reassessment determines whether perfusion and metabolic abnormalities are correcting.",
              "zh": "复评判断灌注和代谢异常是否纠正。"
            },
            {
              "refId": "B",
              "en": "Monitoring and positioning support circulation while emergency help is mobilized.",
              "zh": "监测和体位在调动急救资源时支持循环。"
            },
            {
              "refId": "C",
              "en": "Adrenal crisis with shock is time-sensitive and requires urgent orders/team response.",
              "zh": "肾上腺危象伴休克具有时间敏感性，需要紧急医嘱/团队响应。"
            }
